          <Item class="ModuleScript" referent="3569">
            <Properties>
              <string name="Name">VerifyGroupController</string>
              <string name="Source"><![CDATA[--!strict

local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local SoundService = require(ReplicatedStorage.Modules.SoundService)
local VisualFunctions = require(ReplicatedStorage.Modules.UI.VisualFunctions)

local VerifyGroupController = {}
VerifyGroupController.__index = VerifyGroupController

type MaidLike = {
	GiveTask: (self: MaidLike, taskValue: any) -> any,
}

type ControllerOptions = {
	player: Player,
	groupId: number,
	remotes: Instance,
	sessionMaid: MaidLike,
	spawnSessionTask: (callback: () -> ()) -> thread,
	showNotification: (message: string, textColor: Color3?, gradientBottomColor: Color3?) -> (),
}

type Controller = typeof(setmetatable({} :: {
	player: Player,
	groupId: number,
	remotes: Instance,
	sessionMaid: MaidLike,
	spawnSessionTask: (callback: () -> ()) -> thread,
	showNotification: (message: string, textColor: Color3?, gradientBottomColor: Color3?) -> (),
	membership: boolean?,
	membershipCheckInFlight: boolean,
	requestInFlight: boolean,
	destroyed: boolean,
	buttons: { [GuiButton]: boolean },
}, VerifyGroupController))

local function getButtonTextTarget(button: GuiButton): TextButton?
	if button:IsA("TextButton") then
		return button
	end

	local textButton = button:FindFirstChildWhichIsA("TextButton", true)
	return textButton
end

function VerifyGroupController.new(options: ControllerOptions): Controller
	local self = setmetatable({
		player = options.player,
		groupId = options.groupId,
		remotes = options.remotes,
		sessionMaid = options.sessionMaid,
		spawnSessionTask = options.spawnSessionTask,
		showNotification = options.showNotification,
		membership = nil,
		membershipCheckInFlight = false,
		requestInFlight = false,
		destroyed = false,
		buttons = {},
	}, VerifyGroupController)

	return self
end

function VerifyGroupController:UpdateButtonText()
	local text = if self.membership == true
		then "Claim"
		elseif self.membership == false then "Verify & Claim"
		else "Checking..."

	for button in pairs(self.buttons) do
		if button.Parent == nil then
			self.buttons[button] = nil
		else
			local textButton = getButtonTextTarget(button)
			if textButton then
				textButton.Text = text
			end
		end
	end
end

function VerifyGroupController:BindButton(button: GuiButton)
	if self.destroyed or self.buttons[button] then
		return
	end

	self.buttons[button] = true
	self:UpdateButtonText()
	self.sessionMaid:GiveTask(button.Activated:Connect(function()
		self:HandleButtonPressed()
	end))
end

function VerifyGroupController:BindAll(root: Instance)
	for _, descendant in ipairs(root:GetDescendants()) do
		if descendant.Name == "VerifyButton" then
			local button = if descendant:IsA("GuiButton")
				then descendant
				else descendant:FindFirstChildWhichIsA("GuiButton", true)
			if button then
				self:BindButton(button)
			end
		end
	end
end

function VerifyGroupController:RefreshMembership()
	if self.destroyed
		or self.membership ~= nil
		or self.membershipCheckInFlight
		or self.player:GetAttribute("Data_Loaded") ~= true
	then
		return
	end

	self.membershipCheckInFlight = true
	self:UpdateButtonText()
	self.spawnSessionTask(function()
		local success, result = pcall(function()
			return self.player:IsInGroupAsync(self.groupId)
		end)
		if self.destroyed then
			return
		end

		self.membershipCheckInFlight = false
		if success and typeof(result) == "boolean" then
			self.membership = result
			self:UpdateButtonText()
			return
		end

		self.membership = nil
		self:UpdateButtonText()
		DebugModule.debugWarn(
			"Group membership refresh failed: " .. tostring(result),
			"VerifyGroupController"
		)
	end)
end

function VerifyGroupController:GetVerifyRemote(): RemoteEvent?
	local remote = self.remotes:FindFirstChild("VerifyRewardRequest")
	return if remote and remote:IsA("RemoteEvent") then remote else nil
end

function VerifyGroupController:HandleButtonPressed()
	if self.destroyed or self.requestInFlight then
		return
	end

	SoundService.PlayGuiSound("Click")
	self.requestInFlight = true
	self.spawnSessionTask(function()
		local isInGroup = self.membership
		if isInGroup == nil then
			local membershipOk, membershipResult = pcall(function()
				return self.player:IsInGroupAsync(self.groupId)
			end)
			if not membershipOk or typeof(membershipResult) ~= "boolean" then
				self.requestInFlight = false
				DebugModule.debugWarn(
					"Group membership check failed: " .. tostring(membershipResult),
					"VerifyGroupController"
				)
				return
			end

			isInGroup = membershipResult
			self.membership = membershipResult
			self:UpdateButtonText()
		end

		if isInGroup then
			local verifyRemote = self:GetVerifyRemote()
			if verifyRemote then
				verifyRemote:FireServer()
			end
			self.requestInFlight = false
			return
		end

		local promptOk, promptResult = pcall(function()
			return GroupService:PromptJoinAsync(self.groupId)
		end)
		if not promptOk then
			self.requestInFlight = false
			DebugModule.debugWarn(
				"Group prompt failed: " .. tostring(promptResult),
				"VerifyGroupController"
			)
			return
		end

		local status = promptResult :: Enum.GroupMembershipStatus
		if
			status == Enum.GroupMembershipStatus.Joined
			or status == Enum.GroupMembershipStatus.AlreadyMember
		then
			self.membership = true
			self:UpdateButtonText()
			local verifyRemote = self:GetVerifyRemote()
			if verifyRemote then
				verifyRemote:FireServer()
			end
		elseif status == Enum.GroupMembershipStatus.JoinRequestPending then
			local theme = VisualFunctions.NotificationThemes.Gold
			self.showNotification("GROUP REQUEST PENDING", theme.textColor, theme.gradientBottomColor)
		elseif status == Enum.GroupMembershipStatus.None then
			local theme = VisualFunctions.NotificationThemes.Red
			self.showNotification("GROUP JOIN CANCELED", theme.textColor, theme.gradientBottomColor)
		end

		self.requestInFlight = false
	end)
end

function VerifyGroupController:Destroy()
	if self.destroyed then
		return
	end

	self.destroyed = true
	self.membership = nil
	self.membershipCheckInFlight = false
	self.requestInFlight = false
	table.clear(self.buttons)
end

return VerifyGroupController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3570">
            <Properties>
              <string name="Name">WinDisplayController</string>
              <string name="Source"><![CDATA[local WinDisplayController = {}
WinDisplayController.__index = WinDisplayController

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)

type ControllerOptions = {
	player: Player,
	visualFunctions: any,
	spawnSessionTask: (callback: () -> ()) -> thread,
	playRewardCelebration: (playHorn: boolean?) -> (),
	playWinSound: () -> (),
	refreshTrailShop: () -> (),
	refreshAffordableTrailBadge: () -> (),
	onTutorialProgressChanged: () -> (),
}

type Controller = {
	player: Player,
	visualFunctions: any,
	spawnSessionTask: (callback: () -> ()) -> thread,
	playRewardCelebration: (playHorn: boolean?) -> (),
	playWinSound: () -> (),
	refreshTrailShop: () -> (),
	refreshAffordableTrailBadge: () -> (),
	onTutorialProgressChanged: () -> (),
	displayedWinCount: number,
	winAnimationSession: number,
	pendingWinCount: number?,
	eventMappingWarningShown: boolean,
	alive: boolean,
}

local function distributeValue(totalValue: number, count: number): { number }
	local distributed = {}
	local currentSum = 0
	for i = 1, count do
		local nextSum = math.round(totalValue * (i / count))
		table.insert(distributed, nextSum - currentSum)
		currentSum = nextSum
	end

	return distributed
end

function WinDisplayController.new(options: ControllerOptions): Controller
	return setmetatable({
		player = options.player,
		visualFunctions = options.visualFunctions,
		spawnSessionTask = options.spawnSessionTask,
		playRewardCelebration = options.playRewardCelebration,
		playWinSound = options.playWinSound,
		refreshTrailShop = options.refreshTrailShop,
		refreshAffordableTrailBadge = options.refreshAffordableTrailBadge,
		onTutorialProgressChanged = options.onTutorialProgressChanged,
		displayedWinCount = options.player:GetAttribute("WinCount") or 0,
		winAnimationSession = 0,
		pendingWinCount = nil,
		eventMappingWarningShown = false,
		alive = true,
	}, WinDisplayController) :: Controller
end

function WinDisplayController:SetDisplayedWinCount(value: number)
	self.displayedWinCount = value
	self.visualFunctions.UpdateWinLabel(value)
end

function WinDisplayController:UpdateWinDisplay()
	local currentWins = self.player:GetAttribute("WinCount") or 0
	if self.winAnimationSession > 0 then
		self.pendingWinCount = currentWins
	else
		self:SetDisplayedWinCount(currentWins)
	end

	self.refreshTrailShop()
	self.refreshAffordableTrailBadge()
	self.onTutorialProgressChanged()
end

local function parseHexColor(value: unknown): Color3?
	if typeof(value) ~= "string" then
		return nil
	end

	local redHex, greenHex, blueHex = string.match(value, "^#?(%x%x)(%x%x)(%x%x)$")
	if not redHex or not greenHex or not blueHex then
		return nil
	end

	local red = tonumber(redHex, 16)
	local green = tonumber(greenHex, 16)
	local blue = tonumber(blueHex, 16)
	if red == nil or green == nil or blue == nil then
		return nil
	end

	return Color3.fromRGB(red, green, blue)
end

local function getEventVisuals(eventName: string): (Color3?, Color3?, string?)
	local stateFolder = ReplicatedStorage:FindFirstChild("LiveEventState")
	if not stateFolder or not stateFolder:IsA("Folder") then
		return nil, nil, nil
	end

	local encodedEvents = stateFolder:GetAttribute("ActiveEvents")
	if typeof(encodedEvents) ~= "string" then
		return nil, nil, nil
	end

	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, encodedEvents)
	if not ok or typeof(decoded) ~= "table" then
		return nil, nil, nil
	end

	for _, eventEntry in ipairs(decoded) do
		if typeof(eventEntry) == "table" and eventEntry.id == eventName then
			local displayColor = parseHexColor(eventEntry.displayColor)
			local progressUi = eventEntry.progressUi
			local gradientColor = if typeof(progressUi) == "table"
				then parseHexColor(progressUi.gradientColor)
				else nil
			local imageAssetId = if typeof(eventEntry.winPopupImageAssetId) == "string"
				and eventEntry.winPopupImageAssetId ~= ""
				then eventEntry.winPopupImageAssetId
				else nil
			return displayColor, gradientColor, imageAssetId
		end
	end

	return nil, nil, nil
end

function WinDisplayController:OnEventWinAwarded(eventName: string, amount: number)
	if amount <= 0 then
		return
	end

	local hud = self.visualFunctions.HUD
	local template = hud.Float_CurrentBloodMoonWinFrame
	local target = hud.EventCurrentWinsTarget
	if not template or not target then
		if not self.eventMappingWarningShown then
			self.eventMappingWarningShown = true
			DebugModule.debugWarn(
				string.format(
					"Event win popup mapping incomplete | event=%s | template=%s | target=%s",
					eventName,
					tostring(template ~= nil),
					tostring(target ~= nil)
				),
				"WinDisplayController"
			)
		end
		return
	end

	local eventColor, gradientColor, imageAssetId = getEventVisuals(eventName)
	self.visualFunctions.CreateFloatingText(template, amount, 1, {
		TargetFrame = target,
		IntegerOnly = true,
		PlayPopSound = false,
		TextColor = eventColor,
		GradientBottomColor = gradientColor,
		ImageColor = eventColor,
		ImageAssetId = imageAssetId,
	})
end

function WinDisplayController:OnWinAwarded(amount: number, source: string?)
	local splitCount = 1
	local absoluteAmount = math.abs(math.floor(amount))
	if amount > 0 then
		self.playRewardCelebration(false)
		if source == "WinButton" or source == "MinigameRace" then
			self.playWinSound()
		end
	end

	if absoluteAmount >= 10000 then
		splitCount = 5
	elseif absoluteAmount >= 100 then
		splitCount = 3
	end

	local attributeWinCount = self.player:GetAttribute("WinCount")
	local targetWins = if typeof(attributeWinCount) == "number"
		then attributeWinCount
		else self.displayedWinCount + amount
	local startWins = targetWins - amount
	local distributed = distributeValue(amount, splitCount)
	local lifetime = 2

	self.winAnimationSession += 1
	local currentSession = self.winAnimationSession
	self.pendingWinCount = targetWins
	self:SetDisplayedWinCount(startWins)

	self.visualFunctions.CreateFloatingText(self.visualFunctions.HUD.Float_CurrentWinFrame, amount, splitCount, {
		Lifetime = lifetime,
		TargetFrame = self.visualFunctions.HUD.WinCountFrame,
	})

	self.spawnSessionTask(function()
		local runningTotal = startWins
		task.wait(lifetime * 0.6)

		for i, value in ipairs(distributed) do
			if not self.alive or currentSession ~= self.winAnimationSession then
				return
			end

			runningTotal += value
			self:SetDisplayedWinCount(runningTotal)

			if i < #distributed then
				task.wait(0.05)
			end
		end

		if self.alive and currentSession == self.winAnimationSession then
			self.winAnimationSession = 0
			self:SetDisplayedWinCount(self.pendingWinCount or runningTotal)
			self.pendingWinCount = nil
		end
	end)
end

function WinDisplayController:GetUpdateHandler(): () -> ()
	return function()
		self:UpdateWinDisplay()
	end
end

function WinDisplayController:GetWinAwardedHandler(): (number, string?) -> ()
	return function(amount: number, source: string?)
		self:OnWinAwarded(amount, source)
	end
end

function WinDisplayController:GetEventWinAwardedHandler(): (string, number) -> ()
	return function(eventName: string, amount: number)
		self:OnEventWinAwarded(eventName, amount)
	end
end

function WinDisplayController:Destroy()
	if not self.alive then
		return
	end

	self.alive = false
	self.winAnimationSession += 1
	self.pendingWinCount = nil
end

return WinDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3571">
            <Properties>
              <string name="Name">WinStreakUI</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local DebugModule = require(ReplicatedStorage.Modules:WaitForChild("DebugModule"))
local Maid = require(ReplicatedStorage.Modules:WaitForChild("Maid"))
local TweenConfig = require(ReplicatedStorage.Modules.UI:WaitForChild("TweenConfig"))

local WinStreakUI = {}
WinStreakUI.__index = WinStreakUI

local MODULE_NAME = "WinStreakUI"
local STREAK_MULTIPLIER_ATTRIBUTE = "WinStreakMultiplier"
local BASE_MULTIPLIER = 1
local HOVER_ROTATION = 4
local HOVER_SCALE = 1.05
local FINISH_SHAKE_ROTATIONS = { 10, -7, 4, -2, 0 }

export type Controller = {
	Destroy: (self: Controller) -> (),
	PlayFinishShake: (self: Controller) -> (),
}

type ControllerState = Controller & {
	player: Player,
	label: TextLabel?,
	maid: any,
	originalPosition: UDim2?,
	originalRotation: number,
	scale: UIScale?,
	originalScale: number,
	hoverRotationTween: Tween?,
	hoverScaleTween: Tween?,
	resetPositionTween: Tween?,
	resetRotationTween: Tween?,
	resetScaleTween: Tween?,
	finishTween: Tween?,
	finishScaleTween: Tween?,
	animationToken: number,
	lastMultiplier: number,
	isHovering: boolean,
	isDestroyed: boolean,
}

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function normalizeMultiplier(value: any): number
	if not isFiniteNumber(value) then
		return BASE_MULTIPLIER
	end

	return math.max(BASE_MULTIPLIER, value)
end

local function formatMultiplier(value: number): string
	local formatted = string.format("%.2f", normalizeMultiplier(value))
	formatted = formatted:gsub("0+$", ""):gsub("%.$", "")
	return ("Win Streak %sx"):format(formatted)
end

local function cancelTween(tween: Tween?): Tween?
	if tween then
		tween:Cancel()
		tween:Destroy()
	end
	return nil
end

local function cancelAnimations(self: ControllerState)
	self.animationToken += 1
	self.hoverRotationTween = cancelTween(self.hoverRotationTween)
	self.hoverScaleTween = cancelTween(self.hoverScaleTween)
	self.resetPositionTween = cancelTween(self.resetPositionTween)
	self.resetRotationTween = cancelTween(self.resetRotationTween)
	self.resetScaleTween = cancelTween(self.resetScaleTween)
	self.finishTween = cancelTween(self.finishTween)
	self.finishScaleTween = cancelTween(self.finishScaleTween)
end

local function resetToOriginal(self: ControllerState)
	local label = self.label
	local originalPosition = self.originalPosition
	if not label or not originalPosition then
		return
	end

	local resetPositionTween = TweenService:Create(label, TweenConfig.WinStreakReset, {
		Position = originalPosition,
	})
	local resetRotationTween = TweenService:Create(label, TweenConfig.WinStreakReset, {
		Rotation = self.originalRotation,
	})
	local resetScaleTween = if self.scale
		then TweenService:Create(self.scale, TweenConfig.WinStreakReset, { Scale = self.originalScale })
		else nil
	self.resetPositionTween = resetPositionTween
	self.resetRotationTween = resetRotationTween
	self.resetScaleTween = resetScaleTween
	resetPositionTween.Completed:Once(function()
		resetPositionTween:Destroy()
		if self.resetPositionTween == resetPositionTween then
			self.resetPositionTween = nil
		end
	end)
	resetRotationTween.Completed:Once(function()
		resetRotationTween:Destroy()
		if self.resetRotationTween == resetRotationTween then
			self.resetRotationTween = nil
		end
	end)
	resetPositionTween:Play()
	resetRotationTween:Play()
	if resetScaleTween then
		resetScaleTween.Completed:Once(function()
			resetScaleTween:Destroy()
			if self.resetScaleTween == resetScaleTween then
				self.resetScaleTween = nil
			end
		end)
		resetScaleTween:Play()
	end
end

local function startHoverAnimation(self: ControllerState)
	local label = self.label
	if self.isDestroyed or not label then
		return
	end

	cancelAnimations(self)
	label.Rotation = self.originalRotation - HOVER_ROTATION
	local hoverRotationTween = TweenService:Create(label, TweenConfig.WinStreakHoverSwing, {
		Rotation = self.originalRotation + HOVER_ROTATION,
	})
	local hoverScaleTween = if self.scale
		then TweenService:Create(self.scale, TweenConfig.WinStreakHoverScale, {
			Scale = self.originalScale * HOVER_SCALE,
		})
		else nil
	self.hoverRotationTween = hoverRotationTween
	self.hoverScaleTween = hoverScaleTween
	hoverRotationTween:Play()
	if hoverScaleTween then
		hoverScaleTween:Play()
	end
end

function WinStreakUI.new(root: Instance, player: Player): Controller
	local self = setmetatable({
		player = player,
		label = nil :: TextLabel?,
		maid = Maid.new(),
		originalPosition = nil :: UDim2?,
		originalRotation = 0,
		scale = nil :: UIScale?,
		originalScale = 1,
		hoverRotationTween = nil :: Tween?,
		hoverScaleTween = nil :: Tween?,
		resetPositionTween = nil :: Tween?,
		resetRotationTween = nil :: Tween?,
		resetScaleTween = nil :: Tween?,
		finishTween = nil :: Tween?,
		finishScaleTween = nil :: Tween?,
		animationToken = 0,
		lastMultiplier = BASE_MULTIPLIER,
		isHovering = false,
		isDestroyed = false,
	}, WinStreakUI) :: ControllerState

	local label = root:FindFirstChild("WinStreak", true)
	if not label or not label:IsA("TextLabel") then
		DebugModule.debugWarn("WinStreak TextLabel was not found", MODULE_NAME)
		return self
	end

	self.label = label
	self.originalPosition = label.Position
	self.originalRotation = label.Rotation
	local scale = label:FindFirstChildOfClass("UIScale")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "WinStreakScale"
		scale.Scale = 1
		scale.Parent = label
		self.maid:GiveTask(scale)
	end
	self.scale = scale
	self.originalScale = scale.Scale
	label.Active = true
	label.Interactable = true
	label.Text = formatMultiplier(player:GetAttribute(STREAK_MULTIPLIER_ATTRIBUTE))
	self.lastMultiplier = normalizeMultiplier(player:GetAttribute(STREAK_MULTIPLIER_ATTRIBUTE))

	self.maid:GiveTask(player:GetAttributeChangedSignal(STREAK_MULTIPLIER_ATTRIBUTE):Connect(function()
		if self.isDestroyed or not self.label then
			return
		end

		local nextMultiplier = normalizeMultiplier(player:GetAttribute(STREAK_MULTIPLIER_ATTRIBUTE))
		self.label.Text = formatMultiplier(nextMultiplier)
		local shouldShake = nextMultiplier > self.lastMultiplier
		self.lastMultiplier = nextMultiplier
		if shouldShake then
			self:PlayFinishShake()
		end
	end))

	self.maid:GiveTask(label.MouseEnter:Connect(function()
		if self.isDestroyed or not self.originalPosition then
			return
		end

		self.isHovering = true
		startHoverAnimation(self)
	end))

	self.maid:GiveTask(label.MouseLeave:Connect(function()
		if self.isDestroyed then
			return
		end

		self.isHovering = false
		cancelAnimations(self)
		resetToOriginal(self)
	end))

	self.maid:GiveTask(label.Destroying:Connect(function()
		self:Destroy()
	end))

	return self
end

local function startFinishScalePulse(self: ControllerState, animationToken: number)
	local scale = self.scale
	if not scale or self.isDestroyed then
		return
	end

	scale.Scale = self.originalScale
	local scaleUpTween = TweenService:Create(scale, TweenConfig.WinStreakFinishScaleUp, {
		Scale = self.originalScale * 2,
	})
	self.finishScaleTween = scaleUpTween
	scaleUpTween.Completed:Once(function(playbackState: Enum.PlaybackState)
		scaleUpTween:Destroy()
		if self.finishScaleTween == scaleUpTween then
			self.finishScaleTween = nil
		end
		if
			playbackState ~= Enum.PlaybackState.Completed
			or self.isDestroyed
			or self.animationToken ~= animationToken
		then
			return
		end

		local scaleDownTween = TweenService:Create(scale, TweenConfig.WinStreakFinishScaleDown, {
			Scale = self.originalScale,
		})
		self.finishScaleTween = scaleDownTween
		scaleDownTween.Completed:Once(function()
			scaleDownTween:Destroy()
			if self.finishScaleTween == scaleDownTween then
				self.finishScaleTween = nil
			end
		end)
		scaleDownTween:Play()
	end)
	scaleUpTween:Play()
end

function WinStreakUI.PlayFinishShake(self: ControllerState)
	local label = self.label
	local originalPosition = self.originalPosition
	if self.isDestroyed or not label or not originalPosition then
		return
	end

	cancelAnimations(self)
	local animationToken = self.animationToken
	startFinishScalePulse(self, animationToken)
	local stepIndex = 1

	local function playNextStep()
		if self.isDestroyed or self.animationToken ~= animationToken then
			return
		end

		local targetRotation = FINISH_SHAKE_ROTATIONS[stepIndex]
		if targetRotation == nil then
			if self.isHovering then
				startHoverAnimation(self)
			else
				resetToOriginal(self)
			end
			return
		end

		local tween = TweenService:Create(label, TweenConfig.WinStreakFinishShake, {
			Rotation = self.originalRotation + targetRotation,
		})
		self.finishTween = tween
		tween.Completed:Once(function(playbackState: Enum.PlaybackState)
			tween:Destroy()
			if self.finishTween == tween then
				self.finishTween = nil
			end
			if playbackState ~= Enum.PlaybackState.Completed then
				return
			end

			stepIndex += 1
			playNextStep()
		end)
		tween:Play()
	end

	playNextStep()
end

function WinStreakUI:Destroy()
	if self.isDestroyed then
		return
	end

	self.isDestroyed = true
	cancelAnimations(self)
	self.maid:DoCleaning()
	if self.label and self.originalPosition then
		self.label.Position = self.originalPosition
		self.label.Rotation = self.originalRotation
	end
	self.label = nil
end

return WinStreakUI
]]></string>
            </Properties>
          </Item>
