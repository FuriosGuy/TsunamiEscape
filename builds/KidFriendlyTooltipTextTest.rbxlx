      <Item class="ModuleScript" referent="3504">
        <Properties>
          <string name="Name">BloodmoonParticleService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local ClientDeviceProfile = require(ReplicatedStorage.Modules.ClientDeviceProfile)
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)

type ParticleConfig = {
	enabled: boolean,
	size: number,
	verticalOffset: number,
	positionUpdateFps: number,
	positionMovementThreshold: number,
	rotationThresholdDegrees: number,
	groundRaycastInterval: number,
	mobileRateMultiplier: number,
}

type ParticleDefinition = {
	templateName: string,
	instanceName: string,
	placementMode: "Ground" | "AbovePlayer",
	verticalOffset: number?,
}

type BloodmoonParticleController = {
	player: Player,
	config: ParticleConfig,
	maid: any,
	stateMaid: any?,
	characterMaid: any?,
	visualMaid: any?,
	raycastParams: RaycastParams,
	visualGeneration: number,
	lastRootPosition: Vector3?,
	lastRootLookVector: Vector3?,
	lastGrounded: boolean?,
	groundRaycastAccumulator: number,
	lastGroundY: number?,
	stateFolder: Folder?,
	character: Model?,
	humanoid: Humanoid?,
	rootPart: BasePart?,
	visual: BasePart?,
	visualTemplateName: string?,
	visualPlacementMode: ("Ground" | "AbovePlayer")?,
	visualVerticalOffset: number?,
	started: boolean,
	destroyed: boolean,
	templateWarningShown: boolean,
}

local BloodmoonParticleService = {}
BloodmoonParticleService.__index = BloodmoonParticleService

local MODULE_NAME = "BloodmoonParticleService"
local TRANSITION_COMPLETE_ATTRIBUTE = "EnvironmentTransitionComplete"
local PARTICLE_DEFINITIONS: { [string]: ParticleDefinition } = {
	Bloodmoon = {
		templateName = "BloodmoonParticle",
		instanceName = "BloodmoonParticle_Local",
		placementMode = "Ground",
	},
	NeonRush = {
		templateName = "NeonrushParticle",
		instanceName = "NeonrushParticle_Local",
		placementMode = "Ground",
	},
	FrostbiteRally = {
		templateName = "FrostbiteRallyParticle",
		instanceName = "FrostbiteRallyParticle_Local",
		placementMode = "AbovePlayer",
		verticalOffset = 64,
	},
}

local function getConfig(): ParticleConfig
	local rawConfig = CoreConfig.bloodmoonParticle
	if typeof(rawConfig) ~= "table" then
		return {
			enabled = true,
			size = 128,
			verticalOffset = -5,
			positionUpdateFps = 15,
			positionMovementThreshold = 2,
			rotationThresholdDegrees = 20,
			groundRaycastInterval = 0.25,
			mobileRateMultiplier = 0.55,
		}
	end

	local size = if typeof(rawConfig.size) == "number" then math.clamp(rawConfig.size, 1, 512) else 128
	local verticalOffset = if typeof(rawConfig.verticalOffset) == "number" then rawConfig.verticalOffset else -5
	local positionUpdateFps = if typeof(rawConfig.positionUpdateFps) == "number"
		then math.clamp(rawConfig.positionUpdateFps, 1, 60)
		else 15
	local positionMovementThreshold = if typeof(rawConfig.positionMovementThreshold) == "number"
		then math.clamp(rawConfig.positionMovementThreshold, 0, 10)
		else 2
	local rotationThresholdDegrees = if typeof(rawConfig.rotationThresholdDegrees) == "number"
		then math.clamp(rawConfig.rotationThresholdDegrees, 0, 45)
		else 20
	local groundRaycastInterval = if typeof(rawConfig.groundRaycastInterval) == "number"
		then math.clamp(rawConfig.groundRaycastInterval, 0.1, 2)
		else 0.25
	local mobileRateMultiplier = if typeof(rawConfig.mobileRateMultiplier) == "number"
		then math.clamp(rawConfig.mobileRateMultiplier, 0.5, 1)
		else 0.55
	return {
		enabled = rawConfig.enabled ~= false,
		size = size,
		verticalOffset = verticalOffset,
		positionUpdateFps = positionUpdateFps,
		positionMovementThreshold = positionMovementThreshold,
		rotationThresholdDegrees = rotationThresholdDegrees,
		groundRaycastInterval = groundRaycastInterval,
		mobileRateMultiplier = mobileRateMultiplier,
	}
end

local function isGrounded(humanoid: Humanoid): boolean
	if humanoid.Health <= 0 or humanoid.FloorMaterial == Enum.Material.Air then
		return false
	end

	local state = humanoid:GetState()
	return state ~= Enum.HumanoidStateType.Freefall
		and state ~= Enum.HumanoidStateType.Jumping
		and state ~= Enum.HumanoidStateType.FallingDown
		and state ~= Enum.HumanoidStateType.Flying
		and state ~= Enum.HumanoidStateType.Swimming
		and state ~= Enum.HumanoidStateType.Climbing
		and state ~= Enum.HumanoidStateType.Dead
end

local function getRootPart(character: Model): BasePart?
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	return if rootPart and rootPart:IsA("BasePart") then rootPart else nil
end

local function getGroundResult(controller: BloodmoonParticleController, rootPart: BasePart): RaycastResult?
	local rayDepth = math.max(8, math.abs(controller.config.verticalOffset) + 3)
	return Workspace:Raycast(rootPart.Position, Vector3.new(0, -rayDepth, 0), controller.raycastParams)
end

local function getGroundCFrame(rootPart: BasePart, groundY: number, height: number): CFrame
	local _, yaw, _ = rootPart.CFrame:ToOrientation()
	return CFrame.new(rootPart.Position.X, groundY + height * 0.5, rootPart.Position.Z) * CFrame.Angles(0, yaw, 0)
end

local function getAbovePlayerCFrame(rootPart: BasePart, verticalOffset: number): CFrame
	local _, yaw, _ = rootPart.CFrame:ToOrientation()
	return CFrame.new(rootPart.Position + Vector3.new(0, verticalOffset, 0)) * CFrame.Angles(0, yaw, 0)
end

local function normalizeParticleRates(
	visual: BasePart,
	sourceSize: Vector3,
	targetSize: number,
	rateMultiplier: number
)
	local sourceArea = math.max(math.abs(sourceSize.X * sourceSize.Z), 0.01)
	local targetArea = math.max(targetSize * targetSize, 0.01)
	-- Scale emission with area so the larger ground effect keeps the same density.
	local rateScale = (targetArea / sourceArea) * rateMultiplier
	if rateScale == 1 then
		return
	end

	for _, descendant in ipairs(visual:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			descendant.Rate *= rateScale
		end
	end
end

function BloodmoonParticleService.new(player: Player): BloodmoonParticleController
	return setmetatable({
		player = player,
		config = getConfig(),
		maid = Maid.new(),
		stateMaid = nil,
		characterMaid = nil,
		visualMaid = nil,
		visualGeneration = 0,
		lastRootPosition = nil,
		lastRootLookVector = nil,
		lastGrounded = nil,
		groundRaycastAccumulator = 0,
		lastGroundY = nil,
		raycastParams = (function(): RaycastParams
			local params = RaycastParams.new()
			params.FilterType = Enum.RaycastFilterType.Exclude
			params.IgnoreWater = true
			params.RespectCanCollide = true
			return params
		end)(),
		stateFolder = nil,
		character = nil,
		humanoid = nil,
		rootPart = nil,
		visual = nil,
		visualTemplateName = nil,
		visualPlacementMode = nil,
		visualVerticalOffset = nil,
		started = false,
		destroyed = false,
		templateWarningShown = false,
	}, BloodmoonParticleService) :: BloodmoonParticleController
end

function BloodmoonParticleService:_getActiveParticleDefinition(): ParticleDefinition?
	local stateFolder = self.stateFolder
	if not stateFolder then
		return nil
	end

	local environmentName = stateFolder:GetAttribute("EnvironmentName")
	if typeof(environmentName) ~= "string" then
		return nil
	end

	local definition = PARTICLE_DEFINITIONS[environmentName]
	if not definition or stateFolder:GetAttribute(TRANSITION_COMPLETE_ATTRIBUTE) ~= true then
		return nil
	end

	return definition
end

function BloodmoonParticleService:_cleanupVisual()
	if self.visualMaid then
		self.visualMaid:DoCleaning()
		self.visualMaid = nil
	end

	self.visual = nil
	self.visualTemplateName = nil
	self.visualPlacementMode = nil
	self.visualVerticalOffset = nil
	self.visualGeneration += 1
	self.lastRootPosition = nil
	self.lastRootLookVector = nil
	self.lastGrounded = nil
	self.groundRaycastAccumulator = 0
	self.lastGroundY = nil
end

function BloodmoonParticleService:_updateVisual(forceUpdate: boolean?)
	if self.destroyed then
		return
	end

	local visual = self.visual
	local character = self.character
	local humanoid = self.humanoid
	local rootPart = self.rootPart
	if not visual or not character or not humanoid or not rootPart then
		return
	end
	if visual.Parent == nil or rootPart.Parent ~= character or humanoid.Parent ~= character then
		self:_cleanupVisual()
		return
	end

	if self.visualPlacementMode == "AbovePlayer" then
		local rootPosition = rootPart.Position
		local rootLookVector = rootPart.CFrame.LookVector
		local minimumMovement = self.config.positionMovementThreshold
		local rotationThreshold = math.cos(math.rad(self.config.rotationThresholdDegrees))
		local movedEnough = self.lastRootPosition == nil
			or (rootPosition - self.lastRootPosition).Magnitude >= minimumMovement
		local rotatedEnough = self.lastRootLookVector == nil
			or self.lastRootLookVector:Dot(rootLookVector) < rotationThreshold
		if forceUpdate or movedEnough or rotatedEnough then
			visual.CFrame = getAbovePlayerCFrame(rootPart, self.visualVerticalOffset or 64)
			self.lastRootPosition = rootPosition
			self.lastRootLookVector = rootLookVector
		end
		return
	end

	-- Leave the effect at its last ground position while the character is airborne.
	local grounded = isGrounded(humanoid)
	self.lastGrounded = grounded
	if not grounded then
		return
	end

	local updateInterval = 1 / self.config.positionUpdateFps
	self.groundRaycastAccumulator += updateInterval

	local rootPosition = rootPart.Position
	local rootLookVector = rootPart.CFrame.LookVector
	local minimumMovement = self.config.positionMovementThreshold
	local rotationThreshold = math.cos(math.rad(self.config.rotationThresholdDegrees))
	local movedEnough = self.lastRootPosition == nil
		or (rootPosition - self.lastRootPosition).Magnitude >= minimumMovement
	local rotatedEnough = self.lastRootLookVector == nil
		or self.lastRootLookVector:Dot(rootLookVector) < rotationThreshold
	if not forceUpdate and not movedEnough and not rotatedEnough and self.lastGroundY ~= nil then
		return
	end

	local groundRefreshDue = self.lastGroundY == nil
		or self.groundRaycastAccumulator >= self.config.groundRaycastInterval
	if forceUpdate or groundRefreshDue or self.lastGroundY == nil then
		local groundResult = getGroundResult(self, rootPart)
		if not groundResult then
			self.lastGroundY = nil
			return
		end

		self.lastGroundY = groundResult.Position.Y
		self.groundRaycastAccumulator = 0
	end

	local groundY = self.lastGroundY
	if groundY == nil then
		return
	end

	visual.CFrame = getGroundCFrame(rootPart, groundY, visual.Size.Y)
	self.lastRootPosition = rootPosition
	self.lastRootLookVector = rootLookVector
end

function BloodmoonParticleService:_createVisual()
	local definition = self:_getActiveParticleDefinition()
	if self.visual or not self.config.enabled or not definition then
		return
	end

	local character = self.character
	local humanoid = self.humanoid
	local rootPart = self.rootPart
	if not character or not humanoid or not rootPart then
		return
	end

	local groundY: number? = nil
	if definition.placementMode == "Ground" then
		if not isGrounded(humanoid) then
			return
		end
		local groundResult = getGroundResult(self, rootPart)
		if not groundResult then
			return
		end
		groundY = groundResult.Position.Y
	end

	local particlesFolder = ReplicatedStorage:FindFirstChild("Particles")
	local template = particlesFolder and particlesFolder:FindFirstChild(definition.templateName)
	if not template or not template:IsA("BasePart") then
		if not self.templateWarningShown then
			self.templateWarningShown = true
			DebugModule.debugWarn(
				"ReplicatedStorage.Particles."
					.. definition.templateName
					.. " is missing or is not a BasePart",
				MODULE_NAME
			)
		end
		return
	end

	local visual = template:Clone()
	visual.Name = definition.instanceName
	visual.Size = Vector3.new(self.config.size, math.max(visual.Size.Y, 0.1), self.config.size)
	visual.Anchored = true
	visual.CanCollide = false
	visual.CanTouch = false
	visual.CanQuery = false
	visual.CastShadow = false
	visual:SetAttribute("DisableClientCulling", true)
	if definition.placementMode == "AbovePlayer" then
		visual.CFrame = getAbovePlayerCFrame(rootPart, definition.verticalOffset or 64)
	else
		visual.CFrame = getGroundCFrame(rootPart, groundY :: number, visual.Size.Y)
	end
	local mobileRateMultiplier = if ClientDeviceProfile.IsMobile() then self.config.mobileRateMultiplier else 1
	normalizeParticleRates(visual, template.Size, self.config.size, mobileRateMultiplier)

	for _, descendant in ipairs(visual:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.CastShadow = false
		end
	end

	local visualMaid = Maid.new()
	visualMaid:GiveTask(visual)
	self.visualMaid = visualMaid
	self.visual = visual
	self.visualTemplateName = definition.templateName
	self.visualPlacementMode = definition.placementMode
	self.visualVerticalOffset = definition.verticalOffset
	self.lastGrounded = if definition.placementMode == "Ground" then true else nil
	self.lastGroundY = groundY
	self.lastRootPosition = rootPart.Position
	self.lastRootLookVector = rootPart.CFrame.LookVector
	self.visualGeneration += 1
	local visualGeneration = self.visualGeneration
	visual.Parent = Workspace

	-- A lifetime-guarded loop avoids waking on every rendered frame just to throttle work.
	task.spawn(function()
		while not self.destroyed and self.visual == visual and self.visualGeneration == visualGeneration do
			self:_updateVisual()
			task.wait(1 / self.config.positionUpdateFps)
		end
	end)
end

function BloodmoonParticleService:_refreshVisual(forcePositionUpdate: boolean?)
	local definition = self:_getActiveParticleDefinition()
	if self.destroyed or not definition then
		self:_cleanupVisual()
		return
	end

	if not self.character or not self.humanoid or not self.rootPart then
		self:_cleanupVisual()
		return
	end

	if self.visual
		and (self.visualTemplateName ~= definition.templateName or self.visualPlacementMode ~= definition.placementMode)
	then
		self:_cleanupVisual()
	end

	if not self.visual then
		self:_createVisual()
	elseif forcePositionUpdate then
		self:_updateVisual(true)
	end
end

function BloodmoonParticleService:_clearCharacter(character: Model?)
	if character and self.character ~= character then
		return
	end

	self:_cleanupVisual()
	if self.characterMaid then
		self.characterMaid:DoCleaning()
		self.characterMaid = nil
	end

	self.character = nil
	self.humanoid = nil
	self.rootPart = nil
end

function BloodmoonParticleService:_bindCharacterReferences(character: Model, characterMaid: any)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid ~= self.humanoid then
		self.humanoid = humanoid
		characterMaid.HumanoidDied = if humanoid
			then humanoid.Died:Connect(function()
				self:_cleanupVisual()
			end)
			else nil
		characterMaid.FloorMaterial = if humanoid
			then humanoid:GetPropertyChangedSignal("FloorMaterial"):Connect(function()
				local grounded = isGrounded(humanoid)
				local landed = grounded and self.lastGrounded ~= true
				self.lastGrounded = grounded
				self:_refreshVisual(landed)
			end)
			else nil
		characterMaid.HumanoidState = if humanoid
			then humanoid.StateChanged:Connect(function()
				local grounded = isGrounded(humanoid)
				local landed = grounded and self.lastGrounded ~= true
				self.lastGrounded = grounded
				self:_refreshVisual(landed)
			end)
			else nil
	end

	local rootPart = getRootPart(character)
	if rootPart ~= self.rootPart then
		self:_cleanupVisual()
		self.rootPart = rootPart
		self.raycastParams.FilterDescendantsInstances = { character }
		characterMaid.RootAncestry = if rootPart
			then rootPart.AncestryChanged:Connect(function(_, parent: Instance?)
				if parent == nil and self.character == character then
					self.rootPart = nil
					self:_cleanupVisual()
				end
			end)
			else nil
	end

	self:_refreshVisual()
end

function BloodmoonParticleService:_bindCharacter(character: Model)
	self:_clearCharacter()
	self.character = character

	local characterMaid = Maid.new()
	self.characterMaid = characterMaid
	characterMaid.DescendantAdded = character.DescendantAdded:Connect(function()
		if self.character == character then
			self:_bindCharacterReferences(character, characterMaid)
		end
	end)
	characterMaid.Ancestry = character.AncestryChanged:Connect(function(_, parent: Instance?)
		if parent == nil then
			self:_clearCharacter(character)
		end
	end)

	self:_bindCharacterReferences(character, characterMaid)
end

function BloodmoonParticleService:_unbindState()
	if self.stateMaid then
		self.stateMaid:DoCleaning()
		self.stateMaid = nil
	end
	self.stateFolder = nil
end

function BloodmoonParticleService:_bindState(folder: Folder)
	self.maid.StateAdded = nil
	self:_unbindState()
	self.stateFolder = folder

	local stateMaid = Maid.new()
	self.stateMaid = stateMaid
	local refresh = function()
		self:_refreshVisual()
	end
	stateMaid.EnvironmentName = folder:GetAttributeChangedSignal("EnvironmentName"):Connect(refresh)
	stateMaid.ActiveEventIds = folder:GetAttributeChangedSignal("ActiveEventIds"):Connect(refresh)
	stateMaid.TransitionComplete = folder:GetAttributeChangedSignal(TRANSITION_COMPLETE_ATTRIBUTE):Connect(refresh)
	stateMaid.Ancestry = folder.AncestryChanged:Connect(function(_, parent: Instance?)
		if parent == nil and self.stateFolder == folder then
			self:_unbindState()
			self:_watchForState()
		end
	end)

	self:_refreshVisual()
end

function BloodmoonParticleService:_watchForState()
	if self.destroyed or self.stateFolder then
		return
	end

	local existingState = ReplicatedStorage:FindFirstChild("LiveEventState")
	if existingState and existingState:IsA("Folder") then
		self:_bindState(existingState)
		return
	end

	self.maid.StateAdded = ReplicatedStorage.ChildAdded:Connect(function(child: Instance)
		if child.Name == "LiveEventState" and child:IsA("Folder") then
			self:_bindState(child)
		end
	end)
end

function BloodmoonParticleService:Start()
	if self.started or self.destroyed then
		return
	end
	self.started = true

	self.maid.CharacterAdded = self.player.CharacterAdded:Connect(function(character: Model)
		self:_bindCharacter(character)
	end)
	self.maid.CharacterRemoving = self.player.CharacterRemoving:Connect(function(character: Model)
		self:_clearCharacter(character)
	end)
	self.maid.PlayerRemoving = Players.PlayerRemoving:Connect(function(player: Player)
		if player == self.player then
			self:Destroy()
		end
	end)

	self:_watchForState()
	if self.player.Character then
		self:_bindCharacter(self.player.Character)
	end
	self:_refreshVisual()
end

function BloodmoonParticleService:Destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	self:_cleanupVisual()
	self:_clearCharacter()
	self:_unbindState()
	self.maid:DoCleaning()
	self.started = false
end

return BloodmoonParticleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3505">
        <Properties>
          <string name="Name">ClientCullingService</string>
          <string name="Source"><![CDATA[local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local ClientDeviceProfile = require(ReplicatedStorage.Modules.ClientDeviceProfile)
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)

type SupportedCullInstance = Instance

type CullState = {
	wasCulled: boolean,
	previousEnabled: boolean?,
	previousLocalTransparencyModifier: number?,
	previousCastShadow: boolean?,
	previousRate: number?,
	wasRateReduced: boolean,
}

type CullConfig = {
	enabled: boolean,
	updateInterval: number,
	mobileDistanceMultiplier: number,
	mobileParticleDistanceMultiplier: number,
	mobileParticleReducedRateMultiplier: number,
	autoTagBillboards: boolean,
	autoTagSurfaceGuis: boolean,
	autoTagDecorativeEffects: boolean,
	autoTagDecorativeTextures: boolean,
	billboardDistance: number,
	surfaceGuiDistance: number,
	particleDistance: number,
	particleReducedDistance: number,
	particleReducedRateMultiplier: number,
	cullHysteresisDistance: number,
	lightDistance: number,
	beamDistance: number,
	trailDistance: number,
	textureDistance: number,
	autoCullDecorativeShadows: boolean,
	shadowDistance: number,
}

local ClientCullingService = {}

ClientCullingService.Tags = table.freeze({
	Billboard = "ClientCullableBillboard",
	SurfaceGui = "ClientCullableSurfaceGui",
	Particle = "ClientCullableParticle",
	Light = "ClientCullableLight",
	Beam = "ClientCullableBeam",
	Trail = "ClientCullableTrail",
	Texture = "ClientCullableTexture",
	Decal = "ClientCullableDecal",
	Shadow = "ClientCullableShadow",
})

local DEFAULT_CONFIG: CullConfig = {
	enabled = true,
	updateInterval = 0.25,
	mobileDistanceMultiplier = 0.65,
	mobileParticleDistanceMultiplier = 0.5,
	mobileParticleReducedRateMultiplier = 0.4,
	autoTagBillboards = true,
	autoTagSurfaceGuis = true,
	autoTagDecorativeEffects = true,
	autoTagDecorativeTextures = true,
	billboardDistance = 300,
	surfaceGuiDistance = 300,
	particleDistance = 180,
	particleReducedDistance = 120,
	particleReducedRateMultiplier = 0.55,
	cullHysteresisDistance = 20,
	lightDistance = 220,
	beamDistance = 250,
	trailDistance = 200,
	textureDistance = 600,
	autoCullDecorativeShadows = true,
	shadowDistance = 400,
}

local serviceMaid = Maid.new()
local instanceStates: { [Instance]: CullState } = {}
local taggedInstances: { [string]: { [Instance]: boolean } } = {}
local localShadowLights: { [Light]: boolean } = {}
local localShadowLightConnections: { [Light]: RBXScriptConnection } = {}
local localShadowLightCount = 0
local shadowCullingActive = false
local heartbeatConnection: RBXScriptConnection? = nil
local updateAccumulator = 0
local isRunning = false

local function readNumber(value: any, fallback: number): number
	if typeof(value) ~= "number" then
		return fallback
	end

	return math.max(0, value)
end

local function readBoolean(value: any, fallback: boolean): boolean
	if typeof(value) ~= "boolean" then
		return fallback
	end

	return value
end

local function getConfig(): CullConfig
	local rawConfig = CoreConfig.clientCulling
	if typeof(rawConfig) ~= "table" then
		return table.clone(DEFAULT_CONFIG)
	end

	return {
		enabled = readBoolean(rawConfig.enabled, DEFAULT_CONFIG.enabled),
		updateInterval = math.max(0.05, readNumber(rawConfig.updateInterval, DEFAULT_CONFIG.updateInterval)),
		mobileDistanceMultiplier = math.clamp(
			readNumber(rawConfig.mobileDistanceMultiplier, DEFAULT_CONFIG.mobileDistanceMultiplier),
			0.1,
			1
		),
		mobileParticleDistanceMultiplier = math.clamp(
			readNumber(
				rawConfig.mobileParticleDistanceMultiplier,
				DEFAULT_CONFIG.mobileParticleDistanceMultiplier
			),
			0.1,
			1
		),
		mobileParticleReducedRateMultiplier = math.clamp(
			readNumber(
				rawConfig.mobileParticleReducedRateMultiplier,
				DEFAULT_CONFIG.mobileParticleReducedRateMultiplier
			),
			0.1,
			1
		),
		autoTagBillboards = readBoolean(rawConfig.autoTagBillboards, DEFAULT_CONFIG.autoTagBillboards),
		autoTagSurfaceGuis = readBoolean(rawConfig.autoTagSurfaceGuis, DEFAULT_CONFIG.autoTagSurfaceGuis),
		autoTagDecorativeEffects = readBoolean(
			rawConfig.autoTagDecorativeEffects,
			DEFAULT_CONFIG.autoTagDecorativeEffects
		),
		autoTagDecorativeTextures = readBoolean(
			rawConfig.autoTagDecorativeTextures,
			DEFAULT_CONFIG.autoTagDecorativeTextures
		),
		billboardDistance = readNumber(rawConfig.billboardDistance, DEFAULT_CONFIG.billboardDistance),
		surfaceGuiDistance = readNumber(rawConfig.surfaceGuiDistance, DEFAULT_CONFIG.surfaceGuiDistance),
		particleDistance = readNumber(rawConfig.particleDistance, DEFAULT_CONFIG.particleDistance),
		particleReducedDistance = readNumber(rawConfig.particleReducedDistance, DEFAULT_CONFIG.particleReducedDistance),
		particleReducedRateMultiplier = math.clamp(
			readNumber(rawConfig.particleReducedRateMultiplier, DEFAULT_CONFIG.particleReducedRateMultiplier),
			0.1,
			1
		),
		cullHysteresisDistance = readNumber(rawConfig.cullHysteresisDistance, DEFAULT_CONFIG.cullHysteresisDistance),
		lightDistance = readNumber(rawConfig.lightDistance, DEFAULT_CONFIG.lightDistance),
		beamDistance = readNumber(rawConfig.beamDistance, DEFAULT_CONFIG.beamDistance),
		trailDistance = readNumber(rawConfig.trailDistance, DEFAULT_CONFIG.trailDistance),
		textureDistance = readNumber(rawConfig.textureDistance, DEFAULT_CONFIG.textureDistance),
		autoCullDecorativeShadows = readBoolean(
			rawConfig.autoCullDecorativeShadows,
			DEFAULT_CONFIG.autoCullDecorativeShadows
		),
		shadowDistance = readNumber(rawConfig.shadowDistance, DEFAULT_CONFIG.shadowDistance),
	}
end

local function getDistanceMultiplier(config: CullConfig, isParticle: boolean): number
	if not ClientDeviceProfile.IsMobile() then
		return 1
	end

	return if isParticle then config.mobileParticleDistanceMultiplier else config.mobileDistanceMultiplier
end

local function getParticleReducedRateMultiplier(config: CullConfig): number
	return if ClientDeviceProfile.IsMobile()
		then config.mobileParticleReducedRateMultiplier
		else config.particleReducedRateMultiplier
end

local function refreshLocalShadowLight(light: Light)
	local shouldTrack = light.Shadows
	local wasTracked = localShadowLights[light] == true
	if shouldTrack and not wasTracked then
		localShadowLights[light] = true
		localShadowLightCount += 1
	elseif not shouldTrack and wasTracked then
		localShadowLights[light] = nil
		localShadowLightCount = math.max(localShadowLightCount - 1, 0)
	end
end

local function untrackLocalShadowLight(light: Light)
	if localShadowLights[light] then
		localShadowLights[light] = nil
		localShadowLightCount = math.max(localShadowLightCount - 1, 0)
	end

	local connection = localShadowLightConnections[light]
	if connection then
		connection:Disconnect()
		localShadowLightConnections[light] = nil
	end
end

local function trackLocalShadowLight(light: Light)
	if localShadowLightConnections[light] then
		refreshLocalShadowLight(light)
		return
	end

	localShadowLightConnections[light] = light:GetPropertyChangedSignal("Shadows"):Connect(function()
		refreshLocalShadowLight(light)
	end)
	refreshLocalShadowLight(light)
end

local function bindLocalShadowLightTracking()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("Light") then
			trackLocalShadowLight(descendant)
		end
	end

	serviceMaid:GiveTask(Workspace.DescendantAdded:Connect(function(instance)
		if instance:IsA("Light") then
			trackLocalShadowLight(instance)
		end
	end))
	serviceMaid:GiveTask(Workspace.DescendantRemoving:Connect(function(instance)
		if instance:IsA("Light") then
			untrackLocalShadowLight(instance)
		end
	end))
	serviceMaid:GiveTask(function()
		for light in pairs(localShadowLightConnections) do
			untrackLocalShadowLight(light)
		end
		localShadowLightCount = 0
	end)
end

local function shouldCullDecorativeShadows(config: CullConfig): boolean
	return config.autoCullDecorativeShadows and (Lighting.GlobalShadows or localShadowLightCount > 0)
end

local function getBasePartPosition(instance: Instance): Vector3?
	if instance:IsA("BasePart") then
		return instance.Position
	end

	if instance:IsA("Attachment") then
		return instance.WorldPosition
	end

	local ancestorPart = instance:FindFirstAncestorWhichIsA("BasePart")
	if ancestorPart and ancestorPart:IsA("BasePart") then
		return ancestorPart.Position
	end

	return nil
end

local function getModelPosition(model: Model): Vector3?
	local ok, pivot = pcall(function()
		return model:GetPivot()
	end)
	if ok then
		return pivot.Position
	end

	return nil
end

local function getInstanceOrAncestorPosition(instance: Instance): Vector3?
	local directPosition = getBasePartPosition(instance)
	if directPosition then
		return directPosition
	end

	if instance:IsA("Model") then
		return getModelPosition(instance)
	end

	local parent = instance.Parent
	if parent then
		local parentPosition = getBasePartPosition(parent)
		if parentPosition then
			return parentPosition
		end
		if parent:IsA("Model") then
			return getModelPosition(parent)
		end
	end

	local ancestorModel = instance:FindFirstAncestorWhichIsA("Model")
	if ancestorModel then
		return getModelPosition(ancestorModel)
	end

	return nil
end

local function getBillboardPosition(billboardGui: BillboardGui): Vector3?
	local adornee = billboardGui.Adornee
	if adornee then
		return getInstanceOrAncestorPosition(adornee)
	end

	return getInstanceOrAncestorPosition(billboardGui)
end

local function getSurfaceGuiPosition(surfaceGui: SurfaceGui): Vector3?
	local adornee = surfaceGui.Adornee
	if adornee then
		return getInstanceOrAncestorPosition(adornee)
	end

	return getInstanceOrAncestorPosition(surfaceGui)
end

local function getBeamPosition(beam: Beam): Vector3?
	local attachment0 = beam.Attachment0
	local attachment1 = beam.Attachment1
	if attachment0 and attachment1 then
		return (attachment0.WorldPosition + attachment1.WorldPosition) * 0.5
	end
	if attachment0 then
		return attachment0.WorldPosition
	end
	if attachment1 then
		return attachment1.WorldPosition
	end

	return getBasePartPosition(beam)
end

local function isSupportedForTag(tag: string, instance: Instance): boolean
	if tag == ClientCullingService.Tags.Billboard then
		return instance:IsA("BillboardGui")
	elseif tag == ClientCullingService.Tags.SurfaceGui then
		return instance:IsA("SurfaceGui")
	elseif tag == ClientCullingService.Tags.Particle then
		return instance:IsA("ParticleEmitter")
	elseif tag == ClientCullingService.Tags.Light then
		return instance:IsA("Light")
	elseif tag == ClientCullingService.Tags.Beam then
		return instance:IsA("Beam")
	elseif tag == ClientCullingService.Tags.Trail then
		return instance:IsA("Trail")
	elseif tag == ClientCullingService.Tags.Texture then
		return instance:IsA("Texture")
	elseif tag == ClientCullingService.Tags.Decal then
		return instance:IsA("Decal")
	elseif tag == ClientCullingService.Tags.Shadow then
		return instance:IsA("BasePart")
	end

	return false
end

local function getInstancePositionForTag(tag: string, instance: Instance): Vector3?
	if tag == ClientCullingService.Tags.Billboard and instance:IsA("BillboardGui") then
		return getBillboardPosition(instance)
	elseif tag == ClientCullingService.Tags.SurfaceGui and instance:IsA("SurfaceGui") then
		return getSurfaceGuiPosition(instance)
	elseif tag == ClientCullingService.Tags.Beam and instance:IsA("Beam") then
		return getBeamPosition(instance)
	elseif tag == ClientCullingService.Tags.Shadow and instance:IsA("BasePart") then
		return instance.Position
	end

	local parent = instance.Parent
	if parent then
		return getInstanceOrAncestorPosition(parent)
	end

	return nil
end

local function getCullDistanceForTag(tag: string, config: CullConfig): number
	if tag == ClientCullingService.Tags.Billboard then
		return config.billboardDistance
	elseif tag == ClientCullingService.Tags.SurfaceGui then
		return config.surfaceGuiDistance
	elseif tag == ClientCullingService.Tags.Particle then
		return config.particleDistance
	elseif tag == ClientCullingService.Tags.Light then
		return config.lightDistance
	elseif tag == ClientCullingService.Tags.Beam then
		return config.beamDistance
	elseif tag == ClientCullingService.Tags.Trail then
		return config.trailDistance
	elseif tag == ClientCullingService.Tags.Texture or tag == ClientCullingService.Tags.Decal then
		return config.textureDistance
	elseif tag == ClientCullingService.Tags.Shadow then
		return config.shadowDistance
	end

	return 0
end

local function isTransparencyCullable(instance: SupportedCullInstance): boolean
	return instance:IsA("Texture") or instance:IsA("Decal")
end

local function isShadowCullable(instance: SupportedCullInstance): boolean
	return instance:IsA("BasePart")
end

local function getEnabled(instance: SupportedCullInstance): boolean
	return (instance :: any).Enabled == true
end

local function setEnabled(instance: SupportedCullInstance, enabled: boolean)
	(instance :: any).Enabled = enabled
end

local function restoreInstance(instance: Instance)
	local state = instanceStates[instance]
	if not state then
		return
	end

	if state.wasCulled and instance.Parent ~= nil then
		if isTransparencyCullable(instance :: SupportedCullInstance) then
			local previousTransparency = state.previousLocalTransparencyModifier
			if previousTransparency ~= nil and (instance:IsA("Texture") or instance:IsA("Decal")) then
				instance.LocalTransparencyModifier = previousTransparency
			end
		elseif isShadowCullable(instance :: SupportedCullInstance) then
			local previousCastShadow = state.previousCastShadow
			if previousCastShadow ~= nil and instance:IsA("BasePart") then
				instance.CastShadow = previousCastShadow
			end
		elseif state.previousEnabled ~= nil then
			setEnabled(instance :: SupportedCullInstance, state.previousEnabled)
		end
	end

	if state.wasRateReduced and state.previousRate ~= nil and instance:IsA("ParticleEmitter") then
		instance.Rate = state.previousRate
	end

	instanceStates[instance] = nil
end

local function applyCullState(instance: SupportedCullInstance, shouldCull: boolean, particleRateMultiplier: number?)
	local state = instanceStates[instance]
	if not state then
		state = {
			wasCulled = false,
			previousEnabled = nil,
			previousLocalTransparencyModifier = nil,
			previousCastShadow = nil,
			previousRate = nil,
			wasRateReduced = false,
		}
		instanceStates[instance] = state
	end

	if shouldCull then
		if not state.wasCulled then
			if instance:IsA("Texture") or instance:IsA("Decal") then
				state.previousLocalTransparencyModifier = instance.LocalTransparencyModifier
			elseif instance:IsA("BasePart") then
				state.previousCastShadow = instance.CastShadow
			else
				state.previousEnabled = getEnabled(instance)
			end
			state.wasCulled = true
		end

		if state.wasRateReduced and state.previousRate ~= nil and instance:IsA("ParticleEmitter") then
			instance.Rate = state.previousRate
			state.previousRate = nil
			state.wasRateReduced = false
		end
		if instance:IsA("Texture") or instance:IsA("Decal") then
			instance.LocalTransparencyModifier = 1
		elseif instance:IsA("BasePart") then
			instance.CastShadow = false
		else
			setEnabled(instance, false)
		end
		return
	end

	if state.wasCulled then
		if (instance:IsA("Texture") or instance:IsA("Decal")) and state.previousLocalTransparencyModifier ~= nil then
			instance.LocalTransparencyModifier = state.previousLocalTransparencyModifier
			state.previousLocalTransparencyModifier = nil
		elseif instance:IsA("BasePart") and state.previousCastShadow ~= nil then
			instance.CastShadow = state.previousCastShadow
			state.previousCastShadow = nil
		elseif state.previousEnabled ~= nil then
			setEnabled(instance, state.previousEnabled)
			state.previousEnabled = nil
		end
		state.wasCulled = false
		state.previousEnabled = nil
		state.previousLocalTransparencyModifier = nil
		state.previousCastShadow = nil
	end

	if instance:IsA("ParticleEmitter") then
		if particleRateMultiplier ~= nil and particleRateMultiplier < 1 then
			if not state.wasRateReduced then
				state.previousRate = instance.Rate
				state.wasRateReduced = true
			end
			instance.Rate = (state.previousRate or instance.Rate) * particleRateMultiplier
		elseif state.wasRateReduced and state.previousRate ~= nil then
			instance.Rate = state.previousRate
			state.previousRate = nil
			state.wasRateReduced = false
		end
	end
end

local function isSupportedInstance(instance: Instance): boolean
	return instance:IsA("BillboardGui")
		or instance:IsA("SurfaceGui")
		or instance:IsA("ParticleEmitter")
		or instance:IsA("Light")
		or instance:IsA("Beam")
		or instance:IsA("Trail")
		or instance:IsA("Texture")
		or instance:IsA("Decal")
		or instance:IsA("BasePart")
end

local function hasAncestorNamed(instance: Instance, names: { [string]: boolean }): boolean
	local current: Instance? = instance
	while current do
		if names[current.Name] == true then
			return true
		end
		current = current.Parent
	end

	return false
end

local function hasAncestorNamePrefix(instance: Instance, prefixes: { string }): boolean
	local current: Instance? = instance
	while current do
		for _, prefix in ipairs(prefixes) do
			if string.sub(current.Name, 1, #prefix) == prefix then
				return true
			end
		end
		current = current.Parent
	end

	return false
end

local function hasDisableClientCullingAttribute(instance: Instance): boolean
	local current: Instance? = instance
	while current do
		if current:GetAttribute("DisableClientCulling") == true then
			return true
		end
		current = current.Parent
	end

	return false
end

local function hasPlayerCharacterAncestor(instance: Instance): boolean
	local current: Instance? = instance
	while current do
		if current:IsA("Model") and Players:GetPlayerFromCharacter(current) ~= nil then
			return true
		end
		current = current.Parent
	end

	return false
end

local function shouldSkipGuiAutoTag(instance: LayerCollector): boolean
	if instance:IsDescendantOf(Players.LocalPlayer:WaitForChild("PlayerGui")) then
		return true
	end

	return hasDisableClientCullingAttribute(instance)
end

local SKIPPED_DECORATIVE_ANCESTOR_NAMES = table.freeze({
	EquippedKarts = true,
	EquippedKart = true,
	ClientTsunamiVisuals = true,
	TutorialNotificationSystem = true,
})

local PROTECTED_DECORATIVE_ANCESTOR_NAMES = table.freeze({
	EventBoard = true,
	KartButtons = true,
	Treadmills = true,
	SpawnLocation = true,
	Roads = true,
	Road = true,
	StartLine = true,
	OutsideLine1 = true,
	OutsideLine2 = true,
})

local DECORATIVE_CULL_CANDIDATE_ANCESTOR_NAMES = table.freeze({
	Terrain = true,
	Decorations = true,
	VIPRooms = true,
})

local SKIPPED_DECORATIVE_NAME_PREFIXES = table.freeze({
	"Tutorial",
	"ClientKartSmoke_",
	"ClientTrailVisual_",
})

local function shouldSkipDecorativeAutoTag(instance: Instance): boolean
	if hasDisableClientCullingAttribute(instance) then
		return true
	end
	if hasPlayerCharacterAncestor(instance) then
		return true
	end
	if hasAncestorNamed(instance, SKIPPED_DECORATIVE_ANCESTOR_NAMES) then
		return true
	end
	if hasAncestorNamePrefix(instance, SKIPPED_DECORATIVE_NAME_PREFIXES) then
		return true
	end

	return false
end

local function shouldSkipDecorativeSpatialAutoTag(instance: Instance): boolean
	if hasDisableClientCullingAttribute(instance) then
		return true
	end
	if hasPlayerCharacterAncestor(instance) then
		return true
	end
	if hasAncestorNamed(instance, PROTECTED_DECORATIVE_ANCESTOR_NAMES) then
		return true
	end

	return not hasAncestorNamed(instance, DECORATIVE_CULL_CANDIDATE_ANCESTOR_NAMES)
end

local function getAutoTagForInstance(instance: Instance, config: CullConfig): string?
	local tag: string? = nil
	if instance:IsA("BillboardGui") then
		if not config.autoTagBillboards then
			return nil
		end
		tag = ClientCullingService.Tags.Billboard
	elseif instance:IsA("SurfaceGui") then
		if not config.autoTagSurfaceGuis then
			return nil
		end
		tag = ClientCullingService.Tags.SurfaceGui
	elseif instance:IsA("ParticleEmitter") then
		if not config.autoTagDecorativeEffects then
			return nil
		end
		tag = ClientCullingService.Tags.Particle
	elseif instance:IsA("Light") then
		if not config.autoTagDecorativeEffects then
			return nil
		end
		tag = ClientCullingService.Tags.Light
	elseif instance:IsA("Beam") then
		if not config.autoTagDecorativeEffects then
			return nil
		end
		tag = ClientCullingService.Tags.Beam
	elseif instance:IsA("Trail") then
		if not config.autoTagDecorativeEffects then
			return nil
		end
		tag = ClientCullingService.Tags.Trail
	elseif instance:IsA("Texture") then
		if not config.autoTagDecorativeTextures then
			return nil
		end
		tag = ClientCullingService.Tags.Texture
	elseif instance:IsA("Decal") then
		if not config.autoTagDecorativeTextures then
			return nil
		end
		tag = ClientCullingService.Tags.Decal
	elseif instance:IsA("BasePart") then
		if not shouldCullDecorativeShadows(config) then
			return nil
		end
		tag = ClientCullingService.Tags.Shadow
	else
		return nil
	end

	return tag
end

local function autoTagInstance(instance: Instance, config: CullConfig)
	local tag = getAutoTagForInstance(instance, config)
	if not tag then
		return
	end

	if instance:IsA("BillboardGui") or instance:IsA("SurfaceGui") then
		if shouldSkipGuiAutoTag(instance) then
			return
		end
	elseif instance:IsA("Texture") or instance:IsA("Decal") or instance:IsA("BasePart") then
		if shouldSkipDecorativeSpatialAutoTag(instance) then
			return
		end
	elseif shouldSkipDecorativeAutoTag(instance) then
		return
	end

	if tag and not CollectionService:HasTag(instance, tag) then
		CollectionService:AddTag(instance, tag)
	end
end

local function autoTagExistingCullables()
	local config = getConfig()
	for _, descendant in ipairs(Workspace:GetDescendants()) do
		autoTagInstance(descendant, config)
	end
end

local function updateTaggedSet(
	tag: string,
	config: CullConfig,
	cameraPosition: Vector3,
	distanceMultiplier: number,
	particleReducedRateMultiplier: number?
)
	local instances = taggedInstances[tag]
	if not instances then
		return
	end

	local maxDistance = getCullDistanceForTag(tag, config) * distanceMultiplier
	local maxDistanceSquared = maxDistance * maxDistance
	local releaseDistance = math.max(maxDistance - config.cullHysteresisDistance, 0)
	local releaseDistanceSquared = releaseDistance * releaseDistance
	local particleReducedDistance = config.particleReducedDistance * distanceMultiplier
	local particleReducedDistanceSquared = particleReducedDistance * particleReducedDistance

	for instance in pairs(instances) do
		if not instance.Parent then
			instances[instance] = nil
			restoreInstance(instance)
			continue
		end

		if not isSupportedForTag(tag, instance) then
			continue
		end

		local supportedInstance = instance :: SupportedCullInstance
		local position = getInstancePositionForTag(tag, supportedInstance)
		if not position then
			applyCullState(supportedInstance, false)
			continue
		end

		local offset = position - cameraPosition
		local distanceSquared = offset:Dot(offset)
		local state = instanceStates[supportedInstance]
		local shouldCull = if state and state.wasCulled
			then distanceSquared > releaseDistanceSquared
			else distanceSquared > maxDistanceSquared
		local particleRateMultiplier: number? = nil
		if
			tag == ClientCullingService.Tags.Particle
			and not shouldCull
			and distanceSquared > particleReducedDistanceSquared
		then
			particleRateMultiplier = particleReducedRateMultiplier or config.particleReducedRateMultiplier
		end
		applyCullState(supportedInstance, shouldCull, particleRateMultiplier)
	end
end

local function updateCulling()
	local config = getConfig()
	if not config.enabled then
		for instance in pairs(instanceStates) do
			restoreInstance(instance)
		end
		return
	end

	local currentCamera = Workspace.CurrentCamera
	if not currentCamera then
		return
	end

	local cameraPosition = currentCamera.CFrame.Position
	local distanceMultiplier = getDistanceMultiplier(config, false)
	local particleDistanceMultiplier = getDistanceMultiplier(config, true)
	local particleReducedRateMultiplier = getParticleReducedRateMultiplier(config)
	updateTaggedSet(ClientCullingService.Tags.Billboard, config, cameraPosition, distanceMultiplier)
	updateTaggedSet(ClientCullingService.Tags.SurfaceGui, config, cameraPosition, distanceMultiplier)
	updateTaggedSet(
		ClientCullingService.Tags.Particle,
		config,
		cameraPosition,
		particleDistanceMultiplier,
		particleReducedRateMultiplier
	)
	updateTaggedSet(ClientCullingService.Tags.Light, config, cameraPosition, distanceMultiplier)
	updateTaggedSet(ClientCullingService.Tags.Beam, config, cameraPosition, distanceMultiplier)
	updateTaggedSet(ClientCullingService.Tags.Trail, config, cameraPosition, distanceMultiplier)
	updateTaggedSet(ClientCullingService.Tags.Texture, config, cameraPosition, distanceMultiplier)
	updateTaggedSet(ClientCullingService.Tags.Decal, config, cameraPosition, distanceMultiplier)

	local shouldCullShadows = shouldCullDecorativeShadows(config)
	if shouldCullShadows then
		shadowCullingActive = true
		updateTaggedSet(ClientCullingService.Tags.Shadow, config, cameraPosition, distanceMultiplier)
	elseif shadowCullingActive then
		local shadowInstances = taggedInstances[ClientCullingService.Tags.Shadow]
		if shadowInstances then
			for instance in pairs(shadowInstances) do
				restoreInstance(instance)
			end
		end
		shadowCullingActive = false
	end
end

local function bindTagTracking(tag: string)
	local instances = taggedInstances[tag]
	if not instances then
		instances = {}
		taggedInstances[tag] = instances
	else
		table.clear(instances)
	end

	for _, instance in ipairs(CollectionService:GetTagged(tag)) do
		instances[instance] = true
	end

	serviceMaid:GiveTask(CollectionService:GetInstanceAddedSignal(tag):Connect(function(instance)
		instances[instance] = true
	end))
	serviceMaid:GiveTask(CollectionService:GetInstanceRemovedSignal(tag):Connect(function(instance)
		instances[instance] = nil
		restoreInstance(instance)
	end))
end

function ClientCullingService.Start()
	if isRunning then
		return
	end
	if not RunService:IsClient() then
		return
	end

	local config = getConfig()
	if not config.enabled then
		return
	end

	isRunning = true
	updateAccumulator = 0
	bindLocalShadowLightTracking()

	bindTagTracking(ClientCullingService.Tags.Billboard)
	bindTagTracking(ClientCullingService.Tags.SurfaceGui)
	bindTagTracking(ClientCullingService.Tags.Particle)
	bindTagTracking(ClientCullingService.Tags.Light)
	bindTagTracking(ClientCullingService.Tags.Beam)
	bindTagTracking(ClientCullingService.Tags.Trail)
	bindTagTracking(ClientCullingService.Tags.Texture)
	bindTagTracking(ClientCullingService.Tags.Decal)
	bindTagTracking(ClientCullingService.Tags.Shadow)

	if
		config.autoTagBillboards
		or config.autoTagSurfaceGuis
		or config.autoTagDecorativeEffects
		or config.autoTagDecorativeTextures
		or shouldCullDecorativeShadows(config)
	then
		autoTagExistingCullables()
		serviceMaid:GiveTask(Workspace.DescendantAdded:Connect(function(instance)
			autoTagInstance(instance, getConfig())
		end))
	end

	heartbeatConnection = RunService.Heartbeat:Connect(function(deltaTime)
		local latestConfig = getConfig()
		updateAccumulator += deltaTime
		if updateAccumulator < latestConfig.updateInterval then
			return
		end

		updateAccumulator = 0
		updateCulling()
	end)
	serviceMaid:GiveTask(heartbeatConnection)

	DebugModule.debugInfo("Client culling service started", "ClientCullingService")
end

function ClientCullingService.Stop()
	if not isRunning then
		return
	end

	isRunning = false
	serviceMaid:DoCleaning()
	heartbeatConnection = nil
	updateAccumulator = 0
	for _, instances in pairs(taggedInstances) do
		table.clear(instances)
	end

	for instance in pairs(instanceStates) do
		restoreInstance(instance)
	end
	table.clear(instanceStates)
	shadowCullingActive = false
end

function ClientCullingService.TagInstance(instance: Instance, tag: string)
	assert(isSupportedInstance(instance), "ClientCullingService.TagInstance requires a supported visual instance")
	assert(typeof(tag) == "string" and tag ~= "", "ClientCullingService.TagInstance requires a non-empty tag")

	if not CollectionService:HasTag(instance, tag) then
		CollectionService:AddTag(instance, tag)
	end
end

return ClientCullingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3506">
        <Properties>
          <string name="Name">ClientDeviceProfile</string>
          <string name="Source"><![CDATA[--!strict

local UserInputService = game:GetService("UserInputService")

type DeviceKind = "Phone" | "Tablet" | "Desktop" | "Console" | "VR"

local ClientDeviceProfile = {}
local cachedDeviceKind: DeviceKind? = nil

local function getStudioDeviceKind(): DeviceKind?
	local serviceOk, service = pcall(function()
		return game:GetService("StudioDeviceSimulatorService")
	end)
	if not serviceOk then
		return nil
	end

	local deviceOk, deviceId = pcall(function()
		return (service :: any):GetDeviceAsync()
	end)
	if not deviceOk or typeof(deviceId) ~= "string" or deviceId == "default" then
		return nil
	end

	local infoOk, info = pcall(function()
		return (service :: any):GetDeviceInfoAsync(deviceId)
	end)
	if not infoOk or typeof(info) ~= "table" then
		return nil
	end

	local deviceForm = (info :: any).DeviceForm
	if deviceForm == Enum.DeviceForm.Phone then
		return "Phone"
	elseif deviceForm == Enum.DeviceForm.Tablet then
		return "Tablet"
	elseif deviceForm == Enum.DeviceForm.Console then
		return "Console"
	elseif deviceForm == Enum.DeviceForm.VR then
		return "VR"
	end

	return "Desktop"
end

local function resolveDeviceKind(): DeviceKind
	local studioDeviceKind = getStudioDeviceKind()
	if studioDeviceKind then
		return studioDeviceKind
	end

	if UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled and not UserInputService.MouseEnabled then
		return "Phone"
	end

	return "Desktop"
end

function ClientDeviceProfile.GetKind(): DeviceKind
	if cachedDeviceKind == nil then
		cachedDeviceKind = resolveDeviceKind()
	end

	return cachedDeviceKind
end

function ClientDeviceProfile.IsMobile(): boolean
	local deviceKind = ClientDeviceProfile.GetKind()
	return deviceKind == "Phone" or deviceKind == "Tablet"
end

return ClientDeviceProfile
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3507">
        <Properties>
          <string name="Name">ClientGraphicsService</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local ClientDeviceProfile = require(ReplicatedStorage.Modules.ClientDeviceProfile)
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local ClientCullingService = require(ReplicatedStorage.Modules.ClientCullingService)
local EnvironmentService = require(ReplicatedStorage.Modules.EnvironmentService)
local LiveEventWorldVisualService = require(ReplicatedStorage.Modules.LiveEventWorldVisualService)
local TsunamiVisualService = require(ReplicatedStorage.Modules.TsunamiVisualService)

local ClientGraphicsService = {}
local isInitialized = false
local originalGlobalShadows: boolean? = nil

function ClientGraphicsService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	if not RunService:IsClient() then
		return
	end

	EnvironmentService.Start()
	LiveEventWorldVisualService.Start()

	local config = CoreConfig.clientGraphics
	if typeof(config) ~= "table" then
		return
	end

	if config.disableGlobalShadowsOnMobile == true and ClientDeviceProfile.IsMobile() then
		if originalGlobalShadows == nil then
			originalGlobalShadows = Lighting.GlobalShadows
		end
		Lighting.GlobalShadows = false
		EnvironmentService.SetGlobalShadowsOverride(false)
		DebugModule.debugInfo("Applied mobile graphics override: GlobalShadows=false", "ClientGraphicsService")
	end

	ClientCullingService.Start()
	TsunamiVisualService.Start()
end

function ClientGraphicsService.Shutdown()
	if not isInitialized then
		return
	end

	ClientCullingService.Stop()
	TsunamiVisualService.Stop()
	LiveEventWorldVisualService.Stop()
	EnvironmentService.SetGlobalShadowsOverride(nil)
	EnvironmentService.Stop()
	if originalGlobalShadows ~= nil then
		Lighting.GlobalShadows = originalGlobalShadows
		originalGlobalShadows = nil
	end
	isInitialized = false
end

return ClientGraphicsService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3508">
