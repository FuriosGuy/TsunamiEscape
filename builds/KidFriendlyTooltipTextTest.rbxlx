          <Item class="ModuleScript" referent="3556">
            <Properties>
              <string name="Name">PlaytimeRewardsUI</string>
              <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Maid = require(Modules:WaitForChild("Maid"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local PlayerHandler = require(Modules:WaitForChild("Shared"):WaitForChild("PlayerHandler_Client"))
local UIFolder = Modules:WaitForChild("UI")
local VisualFunctions = require(UIFolder:WaitForChild("VisualFunctions"))
local SharedFolder = Modules:WaitForChild("Shared")
local NumberFormatting = require(SharedFolder:WaitForChild("NumberFormatting"))
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Client"))
local PlaytimeRewardsConfig = require(Modules:WaitForChild("Shared"):WaitForChild("PlaytimeRewardsConfig"))

local PlaytimeRewardsUI = {}
PlaytimeRewardsUI.__index = PlaytimeRewardsUI

local MODULE_NAME = "PlaytimeRewardsUI"
local PLAYTIME_ELAPSED_ATTRIBUTE = "PlaytimeRewardElapsed"
local PLAYTIME_CLAIMED_ATTRIBUTE = "PlaytimeRewardsClaimed"
local COUNTDOWN_UPDATE_INTERVAL = 0.2
local COMPACT_NUMBER_THRESHOLD_LENGTH = 20
local READY_TEXT_COLOR = Color3.fromRGB(0, 255, 0)
local READY_GRADIENT_TOP = Color3.fromRGB(255, 255, 255)
local READY_GRADIENT_BOTTOM = Color3.fromRGB(0, 130, 15)
local playtimeConfig = if CoreConfig.clientDebug and CoreConfig.clientDebug.playtimeRewards
	then CoreConfig.clientDebug.playtimeRewards
	else nil
local DEBUG_SEQUENTIAL_CLAIM_MODE = if playtimeConfig
		and typeof(playtimeConfig.debugSequentialClaimMode) == "boolean"
	then RunService:IsStudio() and playtimeConfig.debugSequentialClaimMode
	else false

type RewardTier = PlaytimeRewardsConfig.RewardTier

type RewardEntry = {
	tier: RewardTier,
	tierIndex: number,
	root: Frame,
	claimButton: TextButton,
	countdownLabel: TextLabel,
	rewardLabel: TextLabel,
	rotateImage: ImageLabel,
	textGradient: UIGradient?,
	iconGradient: UIGradient?,
	iconGradientAnimated: boolean,
	baseBackgroundColor: Color3,
	claimedBackgroundColor: Color3,
	inFlight: boolean,
	isClaimed: boolean,
}

type ControllerOptions = {
	player: Player,
	root: Instance,
	onClaimableCountChanged: ((number) -> ())?,
}

local function formatWithCommasOnly(value: number): string
	return NumberFormatting.FormatWithCommas(value)
end

local function formatCompactNumber(value: number): string
	return NumberFormatting.FormatCompactNumber(value)
end

local function formatNumber(value: number): string
	local formatted = formatWithCommasOnly(value)
	if string.len(formatted) > COMPACT_NUMBER_THRESHOLD_LENGTH then
		return formatCompactNumber(value)
	end

	return formatted
end

local function formatCountdown(remainingSeconds: number): string
	local clamped = math.max(0, math.ceil(remainingSeconds))
	local minutes = math.floor(clamped / 60)
	local seconds = clamped % 60
	return string.format("%02d:%02d", minutes, seconds)
end

local function parseClaimedTiers(value: any): { [string]: boolean }
	local claimed: { [string]: boolean } = {}
	if typeof(value) ~= "string" or value == "" then
		return claimed
	end

	for token in string.gmatch(value, "([^,]+)") do
		if token ~= "" then
			claimed[token] = true
		end
	end

	return claimed
end

local function getNumericAttribute(player: Player, attributeName: string, defaultValue: number): number
	local value = player:GetAttribute(attributeName)
	if typeof(value) == "number" then
		return value
	end

	return defaultValue
end

local function formatRewardText(tier: RewardTier, player: Player): string
	local parts = {}
	for _, reward in ipairs(tier.rewards) do
		if reward.kind == "XPSpeed" then
			local rebirthMultiplier = getNumericAttribute(player, "Rebirth_XPMultiplier", 1)
			local devMultiplier = getNumericAttribute(player, "DevProduct_XPSpeedMultiplier", 1)
			local miscMultiplier = getNumericAttribute(player, "Misc_XPSpeedMultiplier", 1)
			local friendMultiplier = getNumericAttribute(player, "Friend_XPMultiplier", 1)
			local treadmillMultiplier = getNumericAttribute(player, "Treadmill_XPMultiplier", 1)
			local effectiveXP = reward.amount
				* rebirthMultiplier
				* devMultiplier
				* miscMultiplier
				* friendMultiplier
				* treadmillMultiplier
			local amount = formatCompactNumber(effectiveXP)
			table.insert(parts, "+" .. amount .. " XP")
		elseif reward.kind == "Wins" then
			local effectiveWins = PlayerHandler.CalculatePlaytimeWinsAward(player, reward.amount)
			local amount = formatNumber(effectiveWins)
			table.insert(parts, "+" .. amount .. " Wins")
		elseif reward.kind == "Level" then
			local amount = formatNumber(reward.amount)
			local suffix = if reward.amount == 1 then "Level" else "Levels"
			table.insert(parts, "+" .. amount .. " " .. suffix)
		elseif reward.kind == "Rebirth" then
			local amount = formatNumber(reward.amount)
			local suffix = if reward.amount == 1 then "Rebirth" else "Rebirths"
			table.insert(parts, "+" .. amount .. " " .. suffix)
		else
			local amount = formatNumber(reward.amount)
			table.insert(parts, "+" .. amount)
		end
	end

	return table.concat(parts, " ")
end

local function getFirstUnclaimedTierIndex(claimed: { [string]: boolean }): number?
	for index, tier in ipairs(PlaytimeRewardsConfig.TIERS) do
		if claimed[tier.id] ~= true then
			return index
		end
	end
	return nil
end

local function getTierIconImage(tier: RewardTier): string
	local primaryReward = tier.rewards[1]
	if primaryReward and primaryReward.kind then
		return PlaytimeRewardsConfig.GetIconForTier(tier.id, primaryReward.kind)
	end
	return PlaytimeRewardsConfig.PLACEHOLDER_ICON_IMAGE
end

local function getTierClaimedIconImage(tier: RewardTier): string
	local primaryReward = tier.rewards[1]
	if primaryReward and primaryReward.kind then
		return PlaytimeRewardsConfig.GetClaimedIconForTier(tier.id, primaryReward.kind)
	end
	return PlaytimeRewardsConfig.PLACEHOLDER_ICON_IMAGE
end

local function toClaimedBackgroundColor(color: Color3): Color3
	local factor = 0.45
	return Color3.new(color.R * factor, color.G * factor, color.B * factor)
end

local function getExistingClaimButton(root: Frame): TextButton?
	local claimButton = root:FindFirstChild("TextButton")
	if claimButton and claimButton:IsA("TextButton") then
		return claimButton
	end

	local legacyClaimButton = root:FindFirstChild("ClaimButton")
	if legacyClaimButton and legacyClaimButton:IsA("TextButton") then
		return legacyClaimButton
	end

	return nil
end

local function getExistingCountdownLabel(root: Frame): (TextLabel?, UIGradient?)
	local existing = root:FindFirstChild("TimerLabel")
	local label: TextLabel?
	if existing and existing:IsA("TextLabel") then
		label = existing
	else
		local fallbackExisting = root:FindFirstChild("CountdownLabel")
		if fallbackExisting and fallbackExisting:IsA("TextLabel") then
			label = fallbackExisting
		end
	end
	if not label then
		return nil, nil
	end

	local gradient = label:FindFirstChild("TextGradient")
	local textGradient = if gradient and gradient:IsA("UIGradient") then gradient else nil

	return label, textGradient
end

local function getExistingRotateImage(root: Frame): ImageLabel?
	local existing = root:FindFirstChild("RotateImage")
	if existing and existing:IsA("ImageLabel") then
		return existing
	end

	return nil
end

local function getExistingIconGradient(rotateImage: ImageLabel): UIGradient?
	local existingGradient = rotateImage:FindFirstChild("PlaytimeIconGradient")
	if existingGradient and existingGradient:IsA("UIGradient") then
		return existingGradient
	end

	local fallbackGradient = rotateImage:FindFirstChildOfClass("UIGradient")
	if fallbackGradient then
		fallbackGradient.Name = "PlaytimeIconGradient"
		return fallbackGradient
	end

	return nil
end

local function getOrCreateIconGradient(rotateImage: ImageLabel): UIGradient
	local gradient = getExistingIconGradient(rotateImage)
	if gradient then
		return gradient
	end

	local newGradient = Instance.new("UIGradient")
	newGradient.Name = "PlaytimeIconGradient"
	newGradient.Enabled = false
	newGradient.Parent = rotateImage
	return newGradient
end

local function getExistingRewardLabel(root: Frame): TextLabel?
	local existing = root:FindFirstChild("RewardLabel")
	if existing and existing:IsA("TextLabel") then
		return existing
	end

	return nil
end

function PlaytimeRewardsUI.new(options: ControllerOptions)
	local self = setmetatable({}, PlaytimeRewardsUI)

	self.player = options.player
	self.root = options.root
	self.maid = Maid.new()
	self.entryMaid = Maid.new()
	self.entries = {} :: { [string]: RewardEntry }
	self.updateAccumulator = 0
	self.destroyed = false
	self.onClaimableCountChanged = if typeof(options.onClaimableCountChanged) == "function"
		then options.onClaimableCountChanged
		else nil
	self.lastClaimableCount = -1

	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local remote = remotes:FindFirstChild("PlaytimeRewardAction")
	self.playtimeRewardAction = if remote and remote:IsA("RemoteEvent") then remote else nil
	if not self.playtimeRewardAction then
		DebugModule.debugWarn("PlaytimeRewardAction remote missing", MODULE_NAME)
	end

	self.maid:GiveTask(function()
		self.entryMaid:DoCleaning()
	end)

	self:Rebuild()
	self:Bind()
	self:Refresh()

	return self
end

function PlaytimeRewardsUI:NotifyClaimableCount(claimableCount: number)
	if self.lastClaimableCount == claimableCount then
		return
	end
	self.lastClaimableCount = claimableCount

	local callback = self.onClaimableCountChanged
	if not callback then
		return
	end

	local ok, err = pcall(callback, claimableCount)
	if not ok then
		DebugModule.debugWarn(string.format("onClaimableCountChanged callback failed: %s", tostring(err)), MODULE_NAME)
	end
end

function PlaytimeRewardsUI:GetRewardListAndTemplate(): (Frame?, Frame?)
	local rewardsFrame = self.root:FindFirstChild("RewardsFrame", true)
	if not rewardsFrame or not rewardsFrame:IsA("Frame") then
		return nil, nil
	end

	local bodyFrame = rewardsFrame:FindFirstChild("BodyFrame")
	if not bodyFrame or not bodyFrame:IsA("Frame") then
		return nil, nil
	end

	local list = bodyFrame:FindFirstChild("List")
	if not list or not list:IsA("Frame") then
		return nil, nil
	end

	local template = list:FindFirstChild("PlaytimeRewardButton_Template")
	if not template or not template:IsA("Frame") then
		return list, nil
	end

	return list, template
end

function PlaytimeRewardsUI:ClearEntries()
	for _, entry in pairs(self.entries) do
		if entry.root.Parent then
			entry.root:Destroy()
		end
	end
	table.clear(self.entries)
end

function PlaytimeRewardsUI:Rebuild()
	self.entryMaid:DoCleaning()
	self:ClearEntries()

	local list, template = self:GetRewardListAndTemplate()
	if not list or not template then
		return
	end

	template.Visible = false
	for _, child in ipairs(list:GetChildren()) do
		if child:IsA("Frame") and child:GetAttribute("PlaytimeRewardEntry") == true then
			child:Destroy()
		end
	end

	for index, tier in ipairs(PlaytimeRewardsConfig.TIERS) do
		local entryFrame = template:Clone()
		entryFrame.Name = "PlaytimeRewardButton_" .. tier.id
		entryFrame.LayoutOrder = index
		entryFrame.Visible = true
		-- Opt out of global hover/click visual hooks for this runtime card.
		entryFrame:SetAttribute("isHover", nil)
		entryFrame:SetAttribute("isShine", nil)
		entryFrame:SetAttribute("PlaytimeRewardEntry", true)
		local claimButton = getExistingClaimButton(entryFrame)
		local countdownLabel, textGradient = getExistingCountdownLabel(entryFrame)
		local rotateImage = getExistingRotateImage(entryFrame)
		local iconGradient = if rotateImage then getExistingIconGradient(rotateImage) else nil
		local rewardLabel = getExistingRewardLabel(entryFrame)
		if not claimButton or not countdownLabel or not rotateImage or not rewardLabel then
			DebugModule.debugWarn(
				string.format(
					"Playtime template entry missing required child for %s | button=%s timer=%s icon=%s reward=%s",
					tier.id,
					tostring(claimButton ~= nil),
					tostring(countdownLabel ~= nil),
					tostring(rotateImage ~= nil),
					tostring(rewardLabel ~= nil)
				),
				MODULE_NAME
			)
			entryFrame:Destroy()
			continue
		end
		claimButton.AutoButtonColor = false

		rotateImage.Image = getTierIconImage(tier)
		rewardLabel.Text = formatRewardText(tier, self.player)
		if textGradient then
			textGradient.Enabled = false
		end
		if iconGradient then
			iconGradient.Enabled = false
		end

		entryFrame.Parent = list

		local entry: RewardEntry = {
			tier = tier,
			tierIndex = index,
			root = entryFrame,
			claimButton = claimButton,
			countdownLabel = countdownLabel,
			rewardLabel = rewardLabel,
			rotateImage = rotateImage,
			textGradient = textGradient,
			iconGradient = iconGradient,
			iconGradientAnimated = false,
			baseBackgroundColor = entryFrame.BackgroundColor3,
			claimedBackgroundColor = toClaimedBackgroundColor(entryFrame.BackgroundColor3),
			inFlight = false,
			isClaimed = false,
		}
		self.entries[tier.id] = entry

		self.entryMaid:GiveTask(claimButton.Activated:Connect(function()
			if entry.isClaimed or entry.inFlight then
				return
			end

			if DEBUG_SEQUENTIAL_CLAIM_MODE then
				local claimedSet = parseClaimedTiers(self.player:GetAttribute(PLAYTIME_CLAIMED_ATTRIBUTE))
				local expectedTierIndex = getFirstUnclaimedTierIndex(claimedSet)
				if not expectedTierIndex or entry.tierIndex ~= expectedTierIndex then
					return
				end
			else
				local elapsed = self.player:GetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE)
				local elapsedSeconds = if typeof(elapsed) == "number" then elapsed else 0
				if elapsedSeconds < tier.unlockSeconds then
					return
				end
			end

			if self.playtimeRewardAction then
				entry.inFlight = true
				self:ApplyClaimingState(entry)
				self.playtimeRewardAction:FireServer("Claim", tier.id)
				self.entryMaid:GiveTask(task.delay(2, function()
					if self.destroyed then
						return
					end
					if not entry.isClaimed then
						entry.inFlight = false
					end
				end))
			end
		end))
	end
end

function PlaytimeRewardsUI:ApplyLockedState(entry: RewardEntry, remainingSeconds: number)
	entry.root.BackgroundColor3 = entry.baseBackgroundColor
	entry.root.Interactable = false
	if DEBUG_SEQUENTIAL_CLAIM_MODE then
		entry.countdownLabel.Text = "LOCKED"
	else
		entry.countdownLabel.Text = formatCountdown(remainingSeconds)
	end
	entry.countdownLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	if entry.textGradient then
		entry.textGradient.Enabled = false
	end
	entry.rewardLabel.Visible = false
	entry.rotateImage.Image = getTierIconImage(entry.tier)
	entry.rotateImage.Visible = true
	if entry.iconGradient then
		entry.iconGradient.Enabled = false
	end
	entry.iconGradientAnimated = false
	entry.claimButton.Active = false
	entry.claimButton.Interactable = false
	entry.claimButton.Selectable = false
end

function PlaytimeRewardsUI:ApplyReadyState(entry: RewardEntry)
	entry.root.BackgroundColor3 = entry.baseBackgroundColor
	entry.root.Interactable = true
	entry.countdownLabel.Text = "CLAIM"
	entry.countdownLabel.TextColor3 = READY_TEXT_COLOR
	if entry.textGradient then
		entry.textGradient.Enabled = true
		entry.textGradient.Rotation = 90
		entry.textGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, READY_GRADIENT_TOP),
			ColorSequenceKeypoint.new(1, READY_GRADIENT_BOTTOM),
		})
	end
	entry.rewardLabel.Visible = false
	entry.rotateImage.Image = getTierIconImage(entry.tier)
	entry.rotateImage.Visible = true
	if entry.iconGradient then
		entry.iconGradient.Enabled = false
	end
	entry.iconGradientAnimated = false
	entry.claimButton.Active = true
	entry.claimButton.Interactable = true
	entry.claimButton.Selectable = true
end

function PlaytimeRewardsUI:ApplyClaimingState(entry: RewardEntry)
	entry.root.BackgroundColor3 = entry.baseBackgroundColor
	entry.root.Interactable = false
	entry.countdownLabel.Text = "CLAIMING..."
	entry.countdownLabel.TextColor3 = READY_TEXT_COLOR
	if entry.textGradient then
		entry.textGradient.Enabled = true
		entry.textGradient.Rotation = 90
		entry.textGradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, READY_GRADIENT_TOP),
			ColorSequenceKeypoint.new(1, READY_GRADIENT_BOTTOM),
		})
	end
	entry.rewardLabel.Visible = false
	entry.rotateImage.Image = getTierIconImage(entry.tier)
	entry.rotateImage.Visible = true
	if entry.iconGradient then
		entry.iconGradient.Enabled = false
	end
	entry.iconGradientAnimated = false
	entry.claimButton.Active = false
	entry.claimButton.Interactable = false
	entry.claimButton.Selectable = false
end

function PlaytimeRewardsUI:ApplyClaimedState(entry: RewardEntry)
	entry.root.BackgroundColor3 = entry.claimedBackgroundColor
	entry.root.Interactable = false
	entry.countdownLabel.Text = "CLAIMED"
	entry.countdownLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	if entry.textGradient then
		entry.textGradient.Enabled = false
	end
	entry.rewardLabel.Visible = true
	entry.rotateImage.Image = getTierClaimedIconImage(entry.tier)
	entry.rotateImage.Visible = true
	if entry.tier.id == "Gift12" then
		local iconGradient = entry.iconGradient or getOrCreateIconGradient(entry.rotateImage)
		entry.iconGradient = iconGradient
		iconGradient.Enabled = true
		if not entry.iconGradientAnimated then
			VisualFunctions.SetupRotatingGradient(iconGradient)
			entry.iconGradientAnimated = true
		end
	else
		local iconGradient = entry.iconGradient
		if iconGradient then
			iconGradient.Enabled = false
		end
		entry.iconGradientAnimated = false
	end
	entry.claimButton.Active = false
	entry.claimButton.Interactable = false
	entry.claimButton.Selectable = false
	entry.inFlight = false
	entry.isClaimed = true
end

function PlaytimeRewardsUI:Refresh()
	if self.destroyed then
		return
	end

	if next(self.entries) == nil then
		self:Rebuild()
	end

	local elapsedAttribute = self.player:GetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE)
	local elapsedSeconds = if typeof(elapsedAttribute) == "number" then elapsedAttribute else 0
	local claimedSet = parseClaimedTiers(self.player:GetAttribute(PLAYTIME_CLAIMED_ATTRIBUTE))
	local isFreshCycle = next(claimedSet) == nil and elapsedSeconds <= 0
	if isFreshCycle then
		-- The server clears both attributes after the final cycle claim. Clear
		-- any local pending state immediately so the new cycle is responsive.
		for _, entry in pairs(self.entries) do
			entry.inFlight = false
		end
	end
	local expectedTierIndex = if DEBUG_SEQUENTIAL_CLAIM_MODE then getFirstUnclaimedTierIndex(claimedSet) else nil
	local claimableCount = 0

	for tierId, entry in pairs(self.entries) do
		local tier = entry.tier
		entry.rewardLabel.Text = formatRewardText(tier, self.player)
		local isClaimed = claimedSet[tierId] == true
		if isClaimed then
			self:ApplyClaimedState(entry)
		else
			entry.isClaimed = false
			if entry.inFlight then
				self:ApplyClaimingState(entry)
				continue
			end

			if DEBUG_SEQUENTIAL_CLAIM_MODE then
				if expectedTierIndex and entry.tierIndex == expectedTierIndex then
					self:ApplyReadyState(entry)
					claimableCount += 1
				else
					self:ApplyLockedState(entry, 0)
				end
			else
				local remaining = tier.unlockSeconds - elapsedSeconds
				if remaining <= 0 then
					self:ApplyReadyState(entry)
					claimableCount += 1
				else
					self:ApplyLockedState(entry, remaining)
				end
			end
		end
	end

	self:NotifyClaimableCount(claimableCount)
end

function PlaytimeRewardsUI:Bind()
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(PLAYTIME_ELAPSED_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(PLAYTIME_CLAIMED_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))

	self.maid:GiveTask(self.root.DescendantAdded:Connect(function(descendant)
		if descendant.Name == "RewardsFrame" or descendant.Name == "PlaytimeRewardButton_Template" then
			task.defer(function()
				if self.destroyed then
					return
				end
				self:Rebuild()
				self:Refresh()
			end)
		end
	end))

	self.maid:GiveTask(RunService.Heartbeat:Connect(function(dt)
		self.updateAccumulator += dt
		if self.updateAccumulator < COUNTDOWN_UPDATE_INTERVAL then
			return
		end
		self.updateAccumulator = 0

		self:Refresh()
	end))
end

function PlaytimeRewardsUI:Destroy()
	if self.destroyed then
		return
	end
	self.destroyed = true
	self:NotifyClaimableCount(0)
	self.maid:DoCleaning()
	self.entryMaid:DoCleaning()
	self:ClearEntries()
end

return PlaytimeRewardsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3557">
            <Properties>
              <string name="Name">PremiumUI</string>
              <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)
local CoreConfig = require(ReplicatedStorage.Modules.Shared:WaitForChild("CoreConfig_Shared"))
local PlayerDataConfig = require(ReplicatedStorage.Modules.Shared:WaitForChild("PlayerDataConfig"))
local SoundService = require(ReplicatedStorage.Modules.SoundService)
local VisualFunctions = require(ReplicatedStorage.Modules.UI.VisualFunctions)

local PremiumUI = {}
PremiumUI.__index = PremiumUI

type PremiumUIObject = {
	screenGui: ScreenGui,
	player: Player,
	maid: any,
	frame: GuiObject?,
	promptButton: GuiButton?,
	statusLabel: TextLabel?,
	multiplierLabel: TextLabel?,
	timerLabel: TextLabel?,
	multiplier: number,
	initialized: boolean,
	alive: boolean,
}

local MODULE_NAME = "PremiumUI"
local PREMIUM_STATUS_COLOR = Color3.fromRGB(0, 255, 0)
local PREMIUM_MULTIPLIER = if typeof(PlayerDataConfig.PREMIUM_MULTIPLIER) == "number"
	then math.max(1, PlayerDataConfig.PREMIUM_MULTIPLIER)
	else 1.25

function PremiumUI.new(screenGui: ScreenGui): PremiumUIObject
	local player = assert(Players.LocalPlayer, "PremiumUI requires a local player")

	return setmetatable({
		screenGui = screenGui,
		player = player,
		maid = Maid.new(),
		frame = nil,
		promptButton = nil,
		statusLabel = nil,
		multiplierLabel = nil,
		timerLabel = nil,
		multiplier = PREMIUM_MULTIPLIER,
		initialized = false,
		alive = true,
	}, PremiumUI) :: PremiumUIObject
end

function PremiumUI:refresh()
	if not self.alive or not self.frame or not self.promptButton then
		return
	end

	local isPremium = self.player.MembershipType == Enum.MembershipType.Premium
	self.frame.Visible = true
	self.frame.Active = true
	self.frame:SetAttribute("UiDisabled", false)
	self.promptButton.Active = true

	if self.statusLabel then
		self.statusLabel.Text = "+"
		self.statusLabel.TextColor3 = PREMIUM_STATUS_COLOR
		self.statusLabel.Visible = not isPremium
	end
	if self.multiplierLabel then
		self.multiplierLabel.Text = string.format("%.2fx", self.multiplier)
		self.multiplierLabel.Visible = true
	end
	if self.timerLabel then
		self.timerLabel.Visible = false
	end
end

function PremiumUI:Init()
	if self.initialized then
		return
	end
	self.initialized = true

	local speedMultiFrame = self.screenGui:FindFirstChild("SpeedMultiFrame", true)
	if not speedMultiFrame or not speedMultiFrame:IsA("GuiObject") then
		DebugModule.debugWarn("SpeedMultiFrame was not found", MODULE_NAME)
		return
	end

	local frame = speedMultiFrame:FindFirstChild("PremiumMultiplierFrame")
	local promptButton = frame and frame:FindFirstChild("PromptButton", true)
	local statusLabel = frame and frame:FindFirstChild("TextLabel", true)
	local multiplierLabel = frame and frame:FindFirstChild("Multiplier", true)
	local timerLabel = frame and frame:FindFirstChild("TimerLabel", true)

	if not frame or not frame:IsA("GuiObject") then
		DebugModule.debugWarn("PremiumMultiplierFrame was not found", MODULE_NAME)
		return
	end
	if not promptButton or not promptButton:IsA("GuiButton") then
		DebugModule.debugWarn("PremiumMultiplierFrame PromptButton was not found", MODULE_NAME)
		return
	end
	if not statusLabel or not statusLabel:IsA("TextLabel") then
		DebugModule.debugWarn("PremiumMultiplierFrame TextLabel was not found", MODULE_NAME)
		return
	end
	if not multiplierLabel or not multiplierLabel:IsA("TextLabel") then
		DebugModule.debugWarn("PremiumMultiplierFrame Multiplier was not found", MODULE_NAME)
		return
	end

	self.frame = frame
	self.promptButton = promptButton
	self.statusLabel = statusLabel
	self.multiplierLabel = multiplierLabel
	self.timerLabel = if timerLabel and timerLabel:IsA("TextLabel") then timerLabel else nil

	frame.Active = true
	promptButton.Active = true
	VisualFunctions.SetupFrameHover(frame, 1.1, 15, 1.5)
	VisualFunctions.SetupFrameClick(frame, 0.95, -15, 0.75)

	self.maid:GiveTask(promptButton.Activated:Connect(function()
		if not CoreConfig.canShowPremiumPrompt(self.player.MembershipType, RunService:IsStudio()) then
			self:refresh()
			return
		end

		SoundService.PlayGuiSound("Click")
		local promptOk, promptError = pcall(function()
			MarketplaceService:PromptPremiumPurchase(self.player)
		end)
		if not promptOk then
			DebugModule.debugWarn("Premium purchase prompt failed: " .. tostring(promptError), MODULE_NAME)
		end
	end))
	self.maid:GiveTask(self.player:GetPropertyChangedSignal("MembershipType"):Connect(function()
		self:refresh()
	end))

	self:refresh()
end

function PremiumUI:Destroy()
	if not self.alive then
		return
	end

	self.alive = false
	self.maid:DoCleaning()
	self.frame = nil
	self.promptButton = nil
	self.statusLabel = nil
	self.multiplierLabel = nil
	self.timerLabel = nil
end

return PremiumUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3558">
            <Properties>
              <string name="Name">ProgressFrameVisibilityController</string>
              <string name="Source"><![CDATA[local ProgressFrameVisibilityController = {}
ProgressFrameVisibilityController.__index = ProgressFrameVisibilityController

type ProgressFrameVisibilityControllerObject = {
	screenGui: ScreenGui,
	stageProgressFrame: GuiObject?,
	eventProgressFrame: GuiObject?,
	originalStageProgressVisible: boolean?,
	originalEventProgressVisible: boolean?,
	eventActive: boolean,
	raceParticipant: boolean,
	destroyed: boolean,
}

local function getGuiObject(screenGui: ScreenGui, name: string): GuiObject?
	local instance = screenGui:FindFirstChild(name)
	return if instance and instance:IsA("GuiObject") then instance else nil
end

function ProgressFrameVisibilityController.new(screenGui: ScreenGui): ProgressFrameVisibilityControllerObject
	local stageProgressFrame = getGuiObject(screenGui, "StageProgressFrame")
	local eventProgressFrame = getGuiObject(screenGui, "EventProgress")

	return setmetatable({
		screenGui = screenGui,
		stageProgressFrame = stageProgressFrame,
		eventProgressFrame = eventProgressFrame,
		originalStageProgressVisible = if stageProgressFrame then stageProgressFrame.Visible else nil,
		originalEventProgressVisible = if eventProgressFrame then eventProgressFrame.Visible else nil,
		eventActive = false,
		raceParticipant = false,
		destroyed = false,
	}, ProgressFrameVisibilityController)
end

function ProgressFrameVisibilityController.Refresh(self: ProgressFrameVisibilityControllerObject)
	if self.destroyed then
		return
	end

	if self.eventProgressFrame then
		self.eventProgressFrame.Visible = self.eventActive
	end
	if self.stageProgressFrame then
		self.stageProgressFrame.Visible = not self.eventActive and not self.raceParticipant
	end
end

function ProgressFrameVisibilityController.SetEventActive(
	self: ProgressFrameVisibilityControllerObject,
	isActive: boolean
)
	if self.destroyed then
		return
	end

	self.eventActive = isActive
	self:Refresh()
end

function ProgressFrameVisibilityController.SetRaceParticipant(
	self: ProgressFrameVisibilityControllerObject,
	isParticipant: boolean
)
	if self.destroyed then
		return
	end

	self.raceParticipant = isParticipant
	self:Refresh()
end

function ProgressFrameVisibilityController.Destroy(self: ProgressFrameVisibilityControllerObject)
	if self.destroyed then
		return
	end
	self.destroyed = true

	if self.stageProgressFrame and self.originalStageProgressVisible ~= nil then
		self.stageProgressFrame.Visible = self.originalStageProgressVisible
	end
	if self.eventProgressFrame and self.originalEventProgressVisible ~= nil then
		self.eventProgressFrame.Visible = self.originalEventProgressVisible
	end
	self.stageProgressFrame = nil
	self.eventProgressFrame = nil
end

return ProgressFrameVisibilityController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3559">
            <Properties>
              <string name="Name">PromptBuyProductsUI</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local SharedFolder = Modules:WaitForChild("Shared")
local UI = Modules:WaitForChild("UI")

local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Client"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local Maid = require(Modules:WaitForChild("Maid"))
local PlayerHandler = require(Modules:WaitForChild("Shared"):WaitForChild("PlayerHandler_Client"))
local ProductService = require(Modules:WaitForChild("Shared"):WaitForChild("ProductService_Client"))
local RewardedVideoClient = require(Modules:WaitForChild("RewardedVideoClient"))
local VisualFunctions = require(UI:WaitForChild("VisualFunctions"))
local TweenConfig = require(UI:WaitForChild("TweenConfig"))

local PromptBuyProductsUI = {}
PromptBuyProductsUI.__index = PromptBuyProductsUI

local MODULE_NAME = "PromptBuyProductsUI"
local DEFAULT_VISIBLE_POSITION = UDim2.new(0.897, 0, 0.21, 0)
local DEFAULT_HIDDEN_POSITION = UDim2.new(2, 0, 0.21, 0)
local DEFAULT_PROMPT_DURATION_SECONDS = 10
local PROMPT_BLOCKING_FRAMES = {
	"LoadingFrame",
	"NotificationFrame",
	"MinigameNotificationFrame",
	"SpinWheelFrame",
	"DailyRewardFrame",
	"RebirthFrame",
	"ShopFrame",
	"TrailFrame",
	"KartFrame",
	"TrollFrame",
}

type ProductKind = "DevProduct" | "GamePass" | "Premium"

type ProductInfo = {
	[string]: any,
}

type ProductCandidate = {
	key: string,
	id: number,
	kind: ProductKind,
	infoType: any,
	category: string,
	info: ProductInfo,
}

type PromptBuyProductsUIObject = {
	screenGui: ScreenGui,
	player: Player,
	frame: Frame,
	productImage: ImageLabel?,
	priceIcon: ImageLabel?,
	countdownLabel: TextLabel,
	priceLabel: TextLabel,
	productTitleLabel: TextLabel,
	productDescriptionLabel: TextLabel,
	buyFrame: GuiObject,
	buyButton: GuiButton,
	watchAdFrame: GuiObject,
	watchAdButton: GuiButton,
	exitFrame: GuiObject,
	exitButton: GuiButton,
	maid: any,
	characterMaid: any,
	alive: boolean,
	promptVisible: boolean,
	selectionInFlight: boolean,
	promptToken: number,
	deathsSincePrompt: number,
	deathTarget: number,
	deathTriggerReady: boolean,
	timeTriggerReady: boolean,
	nextTimeTriggerAt: number,
	currentProduct: ProductCandidate?,
	premiumPromptActive: boolean,
	rewardedVideoInFlight: boolean,
	activeTween: Tween?,
	studioPromptReady: boolean,
	random: Random,
	marketplaceInfoCache: { [string]: ProductInfo },
}

type PromptBuyProductsUIType = PromptBuyProductsUIObject

local promptConfig: any = CoreConfig.promptBuy or {}
local premiumPromptConfig: any = promptConfig.premiumPrompt or {}
local STUDIO_ALWAYS_SHOW = RunService:IsStudio() and promptConfig.studioAlwaysShow == true
local STUDIO_SHOW_OWNED_PRODUCTS = RunService:IsStudio() and promptConfig.studioShowOwnedProducts == true
local MIN_DEATHS = math.max(1, math.floor(tonumber(promptConfig.minDeaths) or 3))
local MAX_DEATHS = math.max(MIN_DEATHS, math.floor(tonumber(promptConfig.maxDeaths) or 5))
local MIN_MINUTES = math.max(1, math.floor(tonumber(promptConfig.minMinutes) or 2))
local MAX_MINUTES = math.max(MIN_MINUTES, math.floor(tonumber(promptConfig.maxMinutes) or 5))
local SHORT_INTERVAL_SELECTION_WEIGHT =
	math.max(1, math.floor(tonumber(promptConfig.shortIntervalSelectionWeight) or 2))
local TEMPORARY_BOOST_SELECTION_WEIGHT = math.max(1, tonumber(promptConfig.temporaryBoostSelectionWeight) or 3)
local BLOODMOON_KART_SELECTION_WEIGHT = math.max(1, tonumber(promptConfig.bloodmoonKartSelectionWeight) or 2.5)
local PREMIUM_PROMPT_SELECTION_WEIGHT = math.max(1, tonumber(promptConfig.premiumPromptSelectionWeight) or 1)
local PROMPT_DURATION_SECONDS =
	math.max(1, math.floor(tonumber(promptConfig.displayDurationSeconds) or DEFAULT_PROMPT_DURATION_SECONDS))
local VISIBLE_POSITION = if typeof(promptConfig.visiblePosition) == "UDim2"
	then promptConfig.visiblePosition
	else DEFAULT_VISIBLE_POSITION
local HIDDEN_POSITION = if typeof(promptConfig.hiddenPosition) == "UDim2"
	then promptConfig.hiddenPosition
	else DEFAULT_HIDDEN_POSITION
local PREMIUM_PROMPT_IMAGE = tostring(premiumPromptConfig.productImage or "rbxassetid://106963890821116")
local PREMIUM_PROMPT_TITLE = tostring(premiumPromptConfig.title or "ROBLOX PLUS")
local PREMIUM_PROMPT_DESCRIPTION = tostring(
	premiumPromptConfig.description or "Get permanent 1.25x XP Speed and Wins multipliers with Roblox Plus."
)
local DEFAULT_BUY_BUTTON_TEXT = "BUY"
local PREMIUM_BUY_BUTTON_TEXT = "SUBSCRIBE"

local function findRequiredChild(root: Instance, name: string, className: string): Instance
	local child = root:FindFirstChild(name, true)
	assert(
		child and child.ClassName == className,
		string.format("%s.%s must be a %s", root:GetFullName(), name, className)
	)
	return child
end

local function getRandomInteger(random: Random, minimum: number, maximum: number): number
	return random:NextInteger(minimum, maximum)
end

local function getPromptIntervalMinutes(random: Random): number
	if MIN_MINUTES >= MAX_MINUTES or SHORT_INTERVAL_SELECTION_WEIGHT <= 1 then
		return getRandomInteger(random, MIN_MINUTES, MAX_MINUTES)
	end

	local totalWeight = 0
	for minute = MIN_MINUTES, MAX_MINUTES do
		if minute >= 2 and minute <= 3 then
			totalWeight += SHORT_INTERVAL_SELECTION_WEIGHT
		else
			totalWeight += 1
		end
	end

	local roll = random:NextInteger(1, totalWeight)
	for minute = MIN_MINUTES, MAX_MINUTES do
		local weight = if minute >= 2 and minute <= 3 then SHORT_INTERVAL_SELECTION_WEIGHT else 1
		if roll <= weight then
			return minute
		end
		roll -= weight
	end

	return MAX_MINUTES
end

local function formatCountdown(seconds: number): string
	local remaining = math.max(0, math.ceil(seconds))
	return string.format("%ds", remaining)
end

local function getRewardedVideoPlacement(productKey: string): string?
	if productKey == "TempSpeedBoost" then
		return "PromptTempSpeedBoost"
	elseif productKey == "TempWinBoost" then
		return "PromptTempWinBoost"
	end
	return nil
end

local function isLiveEventActive(eventName: string): boolean
	local liveEventState = ReplicatedStorage:FindFirstChild("LiveEventState")
	if not liveEventState or not liveEventState:IsA("Folder") then
		return false
	end

	local activeEventIds = liveEventState:GetAttribute("ActiveEventIds")
	return typeof(activeEventIds) == "string"
		and string.find("," .. activeEventIds .. ",", "," .. eventName .. ",", 1, true) ~= nil
end

local function getEventKartProduct(productKey: string): { [string]: any }?
	local eventKartProducts = ProductService.EventKartProducts
	if typeof(eventKartProducts) ~= "table" then
		return nil
	end

	for _, eventProducts in pairs(eventKartProducts) do
		if typeof(eventProducts) == "table" and typeof(eventProducts[productKey]) == "table" then
			return eventProducts[productKey]
		end
	end

	return nil
end

local function isEventProductAvailable(productKey: string): boolean
	local eventKartProducts = ProductService.EventKartProducts
	if typeof(eventKartProducts) ~= "table" then
		return true
	end

	for eventName, eventProducts in pairs(eventKartProducts) do
		if typeof(eventProducts) == "table" and eventProducts[productKey] ~= nil then
			return isLiveEventActive(tostring(eventName))
		end
	end

	return true
end

local function getSelectionWeight(candidate: ProductCandidate): number
	if candidate.kind == "Premium" then
		return PREMIUM_PROMPT_SELECTION_WEIGHT
	end

	if candidate.category == "TemporaryBoost" then
		return TEMPORARY_BOOST_SELECTION_WEIGHT
	end

	if getEventKartProduct(candidate.key) ~= nil and isEventProductAvailable(candidate.key) then
		return BLOODMOON_KART_SELECTION_WEIGHT
	end

	return 1
end

local function toAssetId(value: any): string?
	if typeof(value) ~= "number" or value <= 0 then
		return nil
	end

	return "rbxassetid://" .. tostring(math.floor(value))
end

local function getCategory(productKey: string): string
	if string.find(productKey, "Trail", 1, true) then
		return "Trail"
	elseif getEventKartProduct(productKey) ~= nil then
		return "Kart"
	elseif
		string.find(productKey, "Kart", 1, true)
		or productKey == "AdvancedTank"
		or productKey == "ShoppingKart"
		or productKey == "FormulaCar"
	then
		return "Kart"
	elseif productKey == "StarterPack" then
		return "Utility"
	elseif productKey == "TempSpeedBoost" or productKey == "TempWinBoost" then
		return "TemporaryBoost"
	elseif string.sub(productKey, 1, 4) == "Spin" then
		return "Spin"
	elseif string.find(productKey, "Treadmill", 1, true) then
		return "Treadmill"
	elseif productKey == "+100K" or productKey == "+1M" or productKey == "+10M" then
		return "Speed"
	elseif productKey == "+1000" or productKey == "+5000" or productKey == "+10000" then
		return "Wins"
	elseif string.find(productKey, "Wins", 1, true) or string.find(productKey, "Win", 1, true) then
		return "Wins"
	elseif string.find(productKey, "Speed", 1, true) or string.find(productKey, "x", 1, true) then
		return "Speed"
	end

	return "Utility"
end

local function getDescription(random: Random, category: string): string
	local pools = promptConfig.descriptionPools
	local pool = if typeof(pools) == "table" then pools[category] else nil
	if typeof(pool) ~= "table" or #pool == 0 then
		pool = if typeof(pools) == "table" then pools.Default else nil
	end
	if typeof(pool) ~= "table" or #pool == 0 then
		return "Power up your run and progress faster!"
	end

	local description = tostring(pool[getRandomInteger(random, 1, #pool)])
	return string.sub(description, 1, 130)
end

local function isExcludedDevProduct(productKey: string): boolean
	-- Keep this safety check local to the selector so config drift cannot expose
	-- the strict ReturnToStage offer through the generic purchase prompt.
	if productKey == "ReturnToStage" or productKey == "Teleport" then
		return true
	end

	local excludedKeys = promptConfig.excludedDevProductKeys
	if typeof(excludedKeys) == "table" and excludedKeys[productKey] == true then
		return true
	end

	for _, multiplierProductKey in pairs(ProductService.MULTIPLIER_TO_PRODUCT) do
		if multiplierProductKey == productKey then
			return true
		end
	end

	return false
end

function PromptBuyProductsUI.new(screenGui: Instance): PromptBuyProductsUIType
	assert(screenGui:IsA("ScreenGui"), "PromptBuyProductsUI requires a ScreenGui root")

	local frame = findRequiredChild(screenGui, "PromptBuyProductsFrame", "Frame") :: Frame
	local bodyFrame = findRequiredChild(frame, "BodyFrame", "Frame") :: Frame
	local buyFrame = findRequiredChild(frame, "BuyButton", "Frame") :: GuiObject
	local watchAdFrame = findRequiredChild(frame, "WatchAdButton", "Frame") :: GuiObject
	local exitFrame = findRequiredChild(frame, "ExitButton", "Frame") :: GuiObject

	local self = setmetatable({
		screenGui = screenGui :: ScreenGui,
		player = Players.LocalPlayer,
		frame = frame,
		productImage = bodyFrame:FindFirstChild("ProductImage", true) :: ImageLabel?,
		priceIcon = frame:FindFirstChild("Image") :: ImageLabel?,
		countdownLabel = findRequiredChild(frame, "CountdownLabel", "TextLabel") :: TextLabel,
		priceLabel = findRequiredChild(frame, "PriceLabel", "TextLabel") :: TextLabel,
		productTitleLabel = findRequiredChild(frame, "ProductTitleLabel", "TextLabel") :: TextLabel,
		productDescriptionLabel = findRequiredChild(frame, "ProductDescriptionLabel", "TextLabel") :: TextLabel,
		buyFrame = buyFrame,
		buyButton = findRequiredChild(buyFrame, "TextButton", "TextButton") :: GuiButton,
		watchAdFrame = watchAdFrame,
		watchAdButton = findRequiredChild(watchAdFrame, "TextButton", "TextButton") :: GuiButton,
		exitFrame = exitFrame,
		exitButton = findRequiredChild(exitFrame, "TextButton", "TextButton") :: GuiButton,
		maid = Maid.new(),
		characterMaid = Maid.new(),
		alive = true,
		promptVisible = false,
		selectionInFlight = false,
		promptToken = 0,
		deathsSincePrompt = 0,
		deathTarget = MIN_DEATHS,
		deathTriggerReady = false,
		timeTriggerReady = false,
		nextTimeTriggerAt = 0,
		currentProduct = nil,
		premiumPromptActive = false,
		rewardedVideoInFlight = false,
		activeTween = nil,
		studioPromptReady = true,
		random = Random.new(),
		marketplaceInfoCache = {},
	}, PromptBuyProductsUI)

	self.frame.Position = HIDDEN_POSITION
	self.frame.Visible = true
	self:_enableInteraction()
	self.watchAdFrame.Visible = false
	self.countdownLabel.Text = formatCountdown(0)

	return self
end

function PromptBuyProductsUI._getMarketplaceInfo(
	self: PromptBuyProductsUIType,
	productId: number,
	infoType: any
): ProductInfo?
	local cacheKey = tostring(infoType) .. ":" .. tostring(productId)
	local cached = self.marketplaceInfoCache[cacheKey]
	if cached then
		return cached
	end

	local success, info = pcall(function()
		return MarketplaceService:GetProductInfo(productId, infoType)
	end)
	if not success or typeof(info) ~= "table" then
		DebugModule.debugWarn(
			string.format("Product metadata unavailable | productId=%d | infoType=%s", productId, tostring(infoType)),
			MODULE_NAME
		)
		return nil
	end

	local typedInfo = info :: ProductInfo
	self.marketplaceInfoCache[cacheKey] = typedInfo
	return typedInfo
end

function PromptBuyProductsUI._isPermanentProductOwned(
	self: PromptBuyProductsUIType,
	productKey: string,
	productKind: ProductKind,
	productId: number
): boolean
	if STUDIO_SHOW_OWNED_PRODUCTS then
		return false
	end

	if productKind == "GamePass" then
		return ProductService.userOwnsGamePass(self.player, productId)
	end

	local permanentProductKeys = promptConfig.permanentDevProductKeys
	local ownershipType = if typeof(permanentProductKeys) == "table" then permanentProductKeys[productKey] else nil
	if ownershipType == "Trail" then
		return PlayerHandler.OwnsTrail(self.player, productKey)
	elseif ownershipType == "Kart" then
		return PlayerHandler.OwnsKart(self.player, productKey)
	end

	local eventKartProduct = getEventKartProduct(productKey)
	if typeof(eventKartProduct) == "table" and typeof(eventKartProduct.KartName) == "string" then
		return PlayerHandler.OwnsKart(self.player, eventKartProduct.KartName)
	end

	return false
end

function PromptBuyProductsUI._collectEligibleProducts(self: PromptBuyProductsUIType): { ProductCandidate }
	local candidates: { ProductCandidate } = {}

	for productKey, rawId in pairs(ProductService.DevProducts) do
		local isEventKartProduct = getEventKartProduct(productKey) ~= nil
		if
			typeof(productKey) == "string"
			and typeof(rawId) == "number"
			and not isExcludedDevProduct(productKey)
			and (not isEventKartProduct or isEventProductAvailable(productKey))
			and not self:_isPermanentProductOwned(productKey, "DevProduct", rawId)
		then
			local productInfo = self:_getMarketplaceInfo(rawId, Enum.InfoType.Product)
			if productInfo then
				table.insert(candidates, {
					key = productKey,
					id = rawId,
					kind = "DevProduct",
					infoType = Enum.InfoType.Product,
					category = getCategory(productKey),
					info = productInfo,
				})
			end
		end
	end

	for productKey, rawId in pairs(ProductService.Gamepasses) do
		if typeof(productKey) == "string" and typeof(rawId) == "number" then
			if not self:_isPermanentProductOwned(productKey, "GamePass", rawId) then
				local productInfo = self:_getMarketplaceInfo(rawId, Enum.InfoType.GamePass)
				if productInfo then
					table.insert(candidates, {
						key = productKey,
						id = rawId,
						kind = "GamePass",
						infoType = Enum.InfoType.GamePass,
						category = getCategory(productKey),
						info = productInfo,
					})
				end
			end
		end
	end

	if CoreConfig.canShowPremiumPrompt(self.player.MembershipType, RunService:IsStudio()) then
		table.insert(candidates, {
			key = "RobloxPlus",
			id = 0,
			kind = "Premium",
			infoType = nil,
			category = "Premium",
			info = {
				Name = PREMIUM_PROMPT_TITLE,
				Description = PREMIUM_PROMPT_DESCRIPTION,
			},
		})
	end

	return candidates
end

function PromptBuyProductsUI._selectProduct(self: PromptBuyProductsUIType): ProductCandidate?
	local candidates = self:_collectEligibleProducts()
	if #candidates == 0 then
		DebugModule.debugWarn("No eligible products available for generic prompt", MODULE_NAME)
		return nil
	end

	local totalWeight = 0
	for _, candidate in ipairs(candidates) do
		totalWeight += getSelectionWeight(candidate)
	end

	local selection = self.random:NextNumber(0, totalWeight)
	local accumulatedWeight = 0
	for _, candidate in ipairs(candidates) do
		accumulatedWeight += getSelectionWeight(candidate)
		if selection <= accumulatedWeight then
			return candidate
		end
	end

	return candidates[#candidates]
end

function PromptBuyProductsUI._isBlockedByOtherUI(self: PromptBuyProductsUIType): boolean
	for _, frameName in ipairs(PROMPT_BLOCKING_FRAMES) do
		local otherFrame = self.screenGui:FindFirstChild(frameName, true)
		if otherFrame and otherFrame:IsA("GuiObject") and otherFrame.Visible then
			return true
		end
	end

	return false
end

function PromptBuyProductsUI._stopActiveTween(self: PromptBuyProductsUIType)
	if self.activeTween then
		self.activeTween:Cancel()
		self.activeTween:Destroy()
		self.activeTween = nil
	end
end

function PromptBuyProductsUI._tweenTo(self: PromptBuyProductsUIType, position: UDim2)
	self:_stopActiveTween()
	local tween = TweenService:Create(
		self.frame,
		TweenConfig.ProductPrompt,
		{ Position = position }
	)
	self.activeTween = tween
	tween:Play()
	tween.Completed:Once(function()
		if self.activeTween == tween then
			self.activeTween = nil
		end
		tween:Destroy()
	end)
end

function PromptBuyProductsUI._startCountdown(self: PromptBuyProductsUIType, token: number)
	task.spawn(function()
		local expiresAt = os.clock() + PROMPT_DURATION_SECONDS
		while self.alive and self.promptVisible and self.promptToken == token do
			local remaining = expiresAt - os.clock()
			self.countdownLabel.Text = formatCountdown(remaining)
			if remaining <= 0 then
				self:_hidePrompt(token)
				break
			end
			task.wait(0.1)
		end
	end)
end

function PromptBuyProductsUI._resetTriggers(self: PromptBuyProductsUIType)
	self.deathsSincePrompt = 0
	self.deathTarget = getRandomInteger(self.random, MIN_DEATHS, MAX_DEATHS)
	self.deathTriggerReady = false
	self.timeTriggerReady = false
	local minutes = getPromptIntervalMinutes(self.random)
	self.nextTimeTriggerAt = os.clock() + minutes * 60
end

function PromptBuyProductsUI._enableInteraction(self: PromptBuyProductsUIType)
	self.frame.Active = true
	self.frame.Interactable = true
	self.buyFrame.Active = true
	self.buyFrame.Interactable = true
	self.exitFrame.Active = true
	self.exitFrame.Interactable = true
	self.buyButton.Active = true
	self.buyButton.Interactable = true
	self.buyButton.Selectable = true
	self.exitButton.Active = true
	self.exitButton.Interactable = true
	self.exitButton.Selectable = true
	self.watchAdFrame.Active = true
	self.watchAdFrame.Interactable = true
	self.watchAdButton.Active = true
	self.watchAdButton.Interactable = true
	self.watchAdButton.Selectable = true
end

function PromptBuyProductsUI._showProduct(self: PromptBuyProductsUIType, product: ProductCandidate)
	if product.kind == "Premium" then
		self:ShowPremiumPrompt()
		return
	end

	if getEventKartProduct(product.key) ~= nil and not isEventProductAvailable(product.key) then
		return
	end

	self.promptToken += 1
	local token = self.promptToken
	self.currentProduct = product
	self.premiumPromptActive = false
	self.rewardedVideoInFlight = false
	self.promptVisible = true
	self:_enableInteraction()
	if STUDIO_ALWAYS_SHOW then
		self.studioPromptReady = false
	end
	self.countdownLabel.Text = formatCountdown(PROMPT_DURATION_SECONDS)
	self.buyButton.Text = DEFAULT_BUY_BUTTON_TEXT
	self.priceLabel.Visible = true
	if self.priceIcon then
		self.priceIcon.Visible = true
	end
	local isCreatorFree = product.kind == "DevProduct"
		and product.key ~= "ReturnToStage"
		and ProductService.IsLocalExperienceCreator(self.player)
	self.priceLabel.Text = if isCreatorFree
		then "FREE"
		else tostring(math.max(0, math.floor(tonumber(product.info.PriceInRobux) or 0)))
	self.productTitleLabel.Text = string.upper(tostring(product.info.Name or product.key))
	self.productDescriptionLabel.Text = getDescription(self.random, product.category)
	self.watchAdFrame.Visible = product.category == "TemporaryBoost" and RewardedVideoClient.IsAvailable()

	local imageId = toAssetId(product.info.IconImageAssetId)
	if self.productImage then
		self.productImage.Visible = true
		if imageId then
			self.productImage.Image = imageId
		end
	end

	self.frame.Visible = true
	self:_tweenTo(VISIBLE_POSITION)

	self:_startCountdown(token)
end

function PromptBuyProductsUI.ShowPremiumPrompt(self: PromptBuyProductsUIType)
	if not self.alive then
		return
	end

	self.promptToken += 1
	local token = self.promptToken
	self.currentProduct = nil
	self.premiumPromptActive = true
	self.rewardedVideoInFlight = false
	self.promptVisible = true
	self:_enableInteraction()
	if STUDIO_ALWAYS_SHOW then
		self.studioPromptReady = false
	end

	self.countdownLabel.Text = formatCountdown(PROMPT_DURATION_SECONDS)
	self.buyButton.Text = PREMIUM_BUY_BUTTON_TEXT
	self.priceLabel.Visible = false
	if self.priceIcon then
		self.priceIcon.Visible = false
	end
	self.productTitleLabel.Text = PREMIUM_PROMPT_TITLE
	self.productDescriptionLabel.Text = PREMIUM_PROMPT_DESCRIPTION
	self.watchAdFrame.Visible = false
	if self.productImage then
		self.productImage.Image = PREMIUM_PROMPT_IMAGE
		self.productImage.Visible = true
	end

	self.frame.Visible = true
	self:_tweenTo(VISIBLE_POSITION)
	self:_startCountdown(token)
end

function PromptBuyProductsUI._hidePrompt(self: PromptBuyProductsUIType, expectedToken: number?)
	if expectedToken and expectedToken ~= self.promptToken then
		return
	end

	self.promptToken += 1
	self.promptVisible = false
	self.currentProduct = nil
	self.premiumPromptActive = false
	self.rewardedVideoInFlight = false
	self.watchAdFrame.Visible = false
	self.buyButton.Text = DEFAULT_BUY_BUTTON_TEXT
	self.priceLabel.Visible = true
	if self.priceIcon then
		self.priceIcon.Visible = true
	end
	if STUDIO_ALWAYS_SHOW then
		self.studioPromptReady = true
	end
	self.countdownLabel.Text = formatCountdown(0)
	self:_tweenTo(HIDDEN_POSITION)
end

function PromptBuyProductsUI._handlePurchaseFinished(
	self: PromptBuyProductsUIType,
	productId: number,
	wasPurchased: boolean
)
	local product = self.currentProduct
	if not self.alive or not self.promptVisible or not wasPurchased or not product then
		return
	end

	if product.id ~= productId then
		return
	end

	DebugModule.debugInfo(
		string.format("Prompt purchase succeeded; hiding product prompt | productId=%d", productId),
		MODULE_NAME
	)
	self:_hidePrompt()
end

function PromptBuyProductsUI._tryShowPrompt(self: PromptBuyProductsUIType)
	if
		not self.alive
		or self.promptVisible
		or self.selectionInFlight
		or STUDIO_ALWAYS_SHOW and not self.studioPromptReady
		or self:_isBlockedByOtherUI()
	then
		return
	end

	if
		not STUDIO_ALWAYS_SHOW
		and (
			self.player:GetAttribute("Data_Loaded") ~= true
			or self.player:GetAttribute("TutorialCompleted") ~= true
			or (typeof(self.player:GetAttribute("WinCount")) ~= "number"
				or (self.player:GetAttribute("WinCount") :: number) < 1)
			or not self.deathTriggerReady and not self.timeTriggerReady
		)
	then
		return
	end

	self.selectionInFlight = true
	local product = self:_selectProduct()
	self.selectionInFlight = false
	if not self.alive or not product then
		self:_resetTriggers()
		return
	end

	self:_resetTriggers()
	self:_showProduct(product)
end

function PromptBuyProductsUI._recordDeath(self: PromptBuyProductsUIType)
	if not self.alive then
		return
	end

	self.deathsSincePrompt += 1
	if self.deathsSincePrompt >= self.deathTarget then
		self.deathTriggerReady = true
	end
	self:_tryShowPrompt()
end

function PromptBuyProductsUI._bindCharacter(self: PromptBuyProductsUIType, character: Model)
	self.characterMaid:DoCleaning()

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		local humanoidInstance = character:WaitForChild("Humanoid", 5)
		if humanoidInstance and humanoidInstance:IsA("Humanoid") then
			humanoid = humanoidInstance
		end
	end
	if not humanoid then
		DebugModule.debugWarn("Prompt Buy could not bind Humanoid death signal", MODULE_NAME)
		return
	end

	self.characterMaid:GiveTask(humanoid.Died:Connect(function()
		self:_recordDeath()
	end))
end

function PromptBuyProductsUI.Init(self: PromptBuyProductsUIType)
	self:_resetTriggers()

	VisualFunctions.SetupFrameHover(self.buyFrame, 1.05, 35, 1.2)
	VisualFunctions.SetupFrameClick(self.buyFrame, 0.9, -15, 0.8)
	VisualFunctions.SetupFrameHover(self.exitFrame, 1.05, 35, 1.2)
	VisualFunctions.SetupFrameClick(self.exitFrame, 0.9, -15, 0.8)
	VisualFunctions.SetupFrameHover(self.watchAdFrame, 1.05, 35, 1.2)
	VisualFunctions.SetupFrameClick(self.watchAdFrame, 0.9, -15, 0.8)

	self.maid:GiveTask(self.buyButton.Activated:Connect(function()
		if not self.alive or not self.promptVisible then
			return
		end

		if self.premiumPromptActive then
			local promptOk, promptError = pcall(function()
				MarketplaceService:PromptPremiumPurchase(self.player)
			end)
			if not promptOk then
				DebugModule.debugWarn("Premium purchase prompt failed: " .. tostring(promptError), MODULE_NAME)
				return
			end

			self:_hidePrompt()
			return
		end

		local product = self.currentProduct
		if not product then
			return
		end

		if product.kind == "GamePass" then
			ProductService.promptGamePassPurchase(self.player, product.id)
		else
			ProductService.promptProductPurchase(self.player, product.id)
		end
	end))

	self.maid:GiveTask(self.exitButton.Activated:Connect(function()
		self:_hidePrompt()
	end))

	self.maid:GiveTask(self.watchAdButton.Activated:Connect(function()
		local product = self.currentProduct
		if
			not self.alive
			or not self.promptVisible
			or self.rewardedVideoInFlight
			or not product
			or product.category ~= "TemporaryBoost"
		then
			return
		end

		local placementName = getRewardedVideoPlacement(product.key)
		if not placementName or not RewardedVideoClient.Request(placementName) then
			self.watchAdFrame.Visible = false
			return
		end

		self.rewardedVideoInFlight = true
		self.watchAdFrame.Active = false
		self.watchAdFrame.Interactable = false
		self.watchAdButton.Active = false
		self.watchAdButton.Interactable = false
	end))

	self.maid:GiveTask(
		RewardedVideoClient.ConnectResult(function(placementName: string, completed: boolean, _resultName: string)
			local product = self.currentProduct
			if not product or getRewardedVideoPlacement(product.key) ~= placementName then
				return
			end

			self.rewardedVideoInFlight = false
			if completed then
				self:_hidePrompt()
			else
				self:_enableInteraction()
				self.watchAdFrame.Visible = RewardedVideoClient.IsAvailable()
			end
		end)
	)

	self.maid:GiveTask(
		MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, productId, wasPurchased)
			if player == self.player then
				self:_handlePurchaseFinished(productId, wasPurchased)
			end
		end)
	)

	self.maid:GiveTask(
		MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId, productId, wasPurchased)
			if userId == self.player.UserId then
				self:_handlePurchaseFinished(productId, wasPurchased)
			end
		end)
	)

	self.maid:GiveTask(
		ProductService.ConnectCreatorPurchaseFinished(
			function(purchaseKind: string, productId: number, wasPurchased: boolean, _reason: string)
				if purchaseKind == "Product" then
					self:_handlePurchaseFinished(productId, wasPurchased)
				end
			end
		)
	)

	self.maid:GiveTask(self.player.CharacterAdded:Connect(function(character)
		self:_bindCharacter(character)
	end))
	if self.player.Character then
		self:_bindCharacter(self.player.Character)
	end

	if STUDIO_ALWAYS_SHOW then
		self:_tryShowPrompt()
	end

	local function bindLiveEventState(stateFolder: Instance)
		if not stateFolder:IsA("Folder") then
			return
		end

		self.maid.LiveEventState = stateFolder:GetAttributeChangedSignal("ActiveEventIds"):Connect(function()
			local currentProduct = self.currentProduct
			if
				currentProduct
				and getEventKartProduct(currentProduct.key) ~= nil
				and not isEventProductAvailable(currentProduct.key)
			then
				self:_hidePrompt()
			end
		end)
	end

	local liveEventState = ReplicatedStorage:FindFirstChild("LiveEventState")
	if liveEventState then
		bindLiveEventState(liveEventState)
	else
		self.maid.LiveEventStateAdded = ReplicatedStorage.ChildAdded:Connect(function(child)
			if child.Name == "LiveEventState" then
				self.maid.LiveEventStateAdded = nil
				bindLiveEventState(child)
			end
		end)
	end

	self.maid:GiveTask(self.player:GetAttributeChangedSignal("TutorialCompleted"):Connect(function()
		self:_tryShowPrompt()
	end))

	task.spawn(function()
		while self.alive and self.screenGui.Parent do
			if os.clock() >= self.nextTimeTriggerAt then
				self.timeTriggerReady = true
			end
			self:_tryShowPrompt()
			task.wait(1)
		end
	end)

	DebugModule.debugInfo("Prompt Buy Products UI initialized", MODULE_NAME)
end

function PromptBuyProductsUI.Destroy(self: PromptBuyProductsUIType)
	if not self.alive then
		return
	end

	self.alive = false
	self.promptToken += 1
	self.promptVisible = false
	self.currentProduct = nil
	self.premiumPromptActive = false
	self.rewardedVideoInFlight = false
	self.watchAdFrame.Visible = false
	self:_stopActiveTween()
	self.characterMaid:DoCleaning()
	self.maid:DoCleaning()
	self.frame.Position = HIDDEN_POSITION
	self.frame.Visible = true
end

return PromptBuyProductsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3560">
            <Properties>
              <string name="Name">RemoteBindings</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ProductService = require(ReplicatedStorage.Modules.Shared:WaitForChild("ProductService_Client"))

type MaidLike = {
	GiveTask: (self: MaidLike, task: any) -> any,
}

export type BindContext = {
	remotes: Instance,
	sessionMaid: MaidLike,
	localPlayer: Player,
	onXPGainAwarded: (amount: number) -> (),
	onWinAwarded: (amount: number, source: string?) -> (),
	onEventWinAwarded: (eventName: string, amount: number) -> (),
	onVerifyRewardResult: (success: boolean, nextClaimUnix: number?) -> (),
	onRebirthResult: () -> (),
	onShowNotification: (message: string, themeName: string?, notificationStyle: string?) -> (),
	onReturnToStageOffer: (shouldShow: boolean, stage: number?, duration: number?) -> (),
	onOpenVerifyFrameRequested: () -> (),
	onTriggerJumpscare: () -> (),
	onTrackedPlayerRemoving: (removingPlayer: Player) -> (),
	onLocalCharacterAdded: () -> (),
	onRequestReturnToStageOffer: () -> (),
	onPromptProductPurchaseFinished: (productId: number, wasPurchased: boolean) -> (),
	onPromptReturnToStageDeclined: (productId: number, wasPurchased: boolean) -> (),
}

local RemoteBindings = {}

function RemoteBindings.Bind(context: BindContext)
	local remotes = context.remotes
	local sessionMaid = context.sessionMaid

	local winRemote = remotes:WaitForChild("WinButtonPressed") :: RemoteEvent
	local eventWinRemote = remotes:WaitForChild("EventWinAwarded") :: RemoteEvent
	local xpRemote = remotes:WaitForChild("XPGainAwarded") :: RemoteEvent
	local verifyResultRemote = remotes:WaitForChild("VerifyRewardResult") :: RemoteEvent
	local rebirthResultRemote = remotes:WaitForChild("RebirthResult") :: RemoteEvent
	local showNotificationRemote = remotes:WaitForChild("ShowNotification") :: RemoteEvent
	local returnToStageOfferRemote = remotes:WaitForChild("ReturnToStageOffer") :: RemoteEvent
	local openVerifyFrameRemote = remotes:WaitForChild("OpenVerifyFrame") :: RemoteEvent
	local triggerJumpscareRemote = remotes:WaitForChild("TriggerJumpscare") :: RemoteEvent

	sessionMaid:GiveTask(xpRemote.OnClientEvent:Connect(context.onXPGainAwarded))
	sessionMaid:GiveTask(winRemote.OnClientEvent:Connect(context.onWinAwarded))
	sessionMaid:GiveTask(eventWinRemote.OnClientEvent:Connect(function(eventName: string, amount: number)
		if typeof(eventName) ~= "string" or typeof(amount) ~= "number" then
			return
		end
		context.onEventWinAwarded(eventName, amount)
	end))
	sessionMaid:GiveTask(verifyResultRemote.OnClientEvent:Connect(context.onVerifyRewardResult))
	sessionMaid:GiveTask(rebirthResultRemote.OnClientEvent:Connect(context.onRebirthResult))
	sessionMaid:GiveTask(showNotificationRemote.OnClientEvent:Connect(context.onShowNotification))
	sessionMaid:GiveTask(returnToStageOfferRemote.OnClientEvent:Connect(context.onReturnToStageOffer))
	sessionMaid:GiveTask(openVerifyFrameRemote.OnClientEvent:Connect(context.onOpenVerifyFrameRequested))
	sessionMaid:GiveTask(triggerJumpscareRemote.OnClientEvent:Connect(context.onTriggerJumpscare))

	sessionMaid:GiveTask(Players.PlayerRemoving:Connect(context.onTrackedPlayerRemoving))
	sessionMaid:GiveTask(context.localPlayer.CharacterAdded:Connect(context.onLocalCharacterAdded))
	sessionMaid:GiveTask(task.defer(context.onRequestReturnToStageOffer))

	sessionMaid:GiveTask(MarketplaceService.PromptProductPurchaseFinished:Connect(function(_, productId, wasPurchased)
		context.onPromptProductPurchaseFinished(productId, wasPurchased)
	end))
	sessionMaid:GiveTask(
		ProductService.ConnectCreatorPurchaseFinished(
			function(purchaseKind: string, productId: number, wasPurchased: boolean, _reason: string)
				if purchaseKind == "Product" then
					context.onPromptProductPurchaseFinished(productId, wasPurchased)
				end
			end
		)
	)
	sessionMaid:GiveTask(MarketplaceService.PromptProductPurchaseFinished:Connect(function(_, productId, wasPurchased)
		context.onPromptReturnToStageDeclined(productId, wasPurchased)
	end))
end

return RemoteBindings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3561">
            <Properties>
              <string name="Name">RewardCelebrationController</string>
              <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfettiBurstPlayer = require(ReplicatedStorage.Modules.UI:WaitForChild("ConfettiBurstPlayer"))
local TweenConfig = require(ReplicatedStorage.Modules.UI:WaitForChild("TweenConfig"))

local RewardCelebrationController = {}
RewardCelebrationController.__index = RewardCelebrationController

type ControllerOptions = {
	root: Instance,
	soundService: any,
	coreConfig: any,
}

function RewardCelebrationController.new(options: ControllerOptions)
	local self = setmetatable({}, RewardCelebrationController)

	local confettiHost = options.root:FindFirstChild("ConfettiFrame", true)
	self.confettiPlayer = if confettiHost and confettiHost:IsA("GuiObject")
		then ConfettiBurstPlayer.GetOrCreateSingleton(confettiHost)
		else nil
	self.soundService = options.soundService
	self.rewardCelebrationCount = if options.coreConfig.leveling
			and typeof(options.coreConfig.leveling.rewardCelebrationConfettiCount) == "number"
		then math.max(1, math.floor(options.coreConfig.leveling.rewardCelebrationConfettiCount))
		else 45
	self.rewardCelebrationColors = if options.coreConfig.leveling
			and typeof(options.coreConfig.leveling.rebirthConfettiColors) == "table"
			and #options.coreConfig.leveling.rebirthConfettiColors > 0
		then options.coreConfig.leveling.rebirthConfettiColors
		else nil
	self.rewardCelebrationDuration = if options.coreConfig.leveling
			and typeof(options.coreConfig.leveling.rebirthConfettiDuration) == "number"
		then options.coreConfig.leveling.rebirthConfettiDuration
		else 1.5
	self.pulseToken = 0
	self.isPulsing = false
	self.activeTween = nil :: Tween?
	self.pulseButtonFrame = nil :: GuiObject?

	return self
end

function RewardCelebrationController:PlayRewardCelebration(playHorn: boolean?)
	if playHorn ~= false then
		self.soundService.PlayGuiSound("Confetti")
	end

	if self.confettiPlayer then
		self.confettiPlayer:PlayBurst(
			self.rewardCelebrationColors,
			self.rewardCelebrationDuration,
			self.rewardCelebrationCount
		)
	end
end

function RewardCelebrationController:GetOrCreateButtonScale(buttonFrame: GuiObject): UIScale
	local existingScale = buttonFrame:FindFirstChild("RebirthPulseScale")
	if existingScale and existingScale:IsA("UIScale") then
		return existingScale
	end

	local uiScale = Instance.new("UIScale")
	uiScale.Name = "RebirthPulseScale"
	uiScale.Scale = 1
	uiScale:SetAttribute("IgnoreInteractionScale", true)
	uiScale.Parent = buttonFrame
	return uiScale
end

function RewardCelebrationController:StopRebirthButtonPulse()
	local buttonFrame = self.pulseButtonFrame
	self.pulseToken += 1
	self.isPulsing = false
	self.pulseButtonFrame = nil

	if self.activeTween then
		self.activeTween:Cancel()
		self.activeTween = nil
	end

	if buttonFrame then
		self:GetOrCreateButtonScale(buttonFrame).Scale = 1
	end
end

function RewardCelebrationController:StartRebirthButtonPulse(buttonFrame: GuiObject?)
	if not buttonFrame then
		return
	end

	if self.isPulsing and self.pulseButtonFrame == buttonFrame then
		return
	end
	if self.isPulsing then
		self:StopRebirthButtonPulse()
	end

	self.pulseToken += 1
	self.isPulsing = true
	self.pulseButtonFrame = buttonFrame
	local pulseToken = self.pulseToken
	local uiScale = self:GetOrCreateButtonScale(buttonFrame)
	uiScale.Scale = 1

	local function playPulse(targetScale: number)
		if pulseToken ~= self.pulseToken or not self.isPulsing then
			return
		end
		if buttonFrame.Parent == nil then
			self:StopRebirthButtonPulse()
			return
		end

		local tween = TweenService:Create(
			uiScale,
			TweenConfig.RewardPulse,
			{ Scale = targetScale }
		)
		self.activeTween = tween
		tween.Completed:Once(function(playbackState)
			if pulseToken ~= self.pulseToken then
				return
			end
			if playbackState ~= Enum.PlaybackState.Completed then
				return
			end

			playPulse(if targetScale > 1 then 1 else 1.06)
		end)
		tween:Play()
	end

	playPulse(1.06)
end

function RewardCelebrationController:UpdateRebirthReady(isReady: boolean, buttonFrame: GuiObject?)
	if isReady then
		self:StartRebirthButtonPulse(buttonFrame)
	else
		self:StopRebirthButtonPulse()
	end
end

function RewardCelebrationController:Destroy()
	self:StopRebirthButtonPulse()
end

return RewardCelebrationController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3562">
            <Properties>
              <string name="Name">SpinWheelUI</string>
              <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local ConfigFolder = Modules:WaitForChild("Config")
local SharedFolder = Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Client"))
local PlayerHandler = require(SharedFolder:WaitForChild("PlayerHandler_Client"))
local SpinWheelConfig = require(ConfigFolder:WaitForChild("SpinWheelConfig"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local Maid = require(Modules:WaitForChild("Maid"))
local ProductService = require(Modules:WaitForChild("Shared"):WaitForChild("ProductService_Client"))
local RewardedVideoClient = require(Modules:WaitForChild("RewardedVideoClient"))
local VisualFunctions = require(Modules:WaitForChild("UI"):WaitForChild("VisualFunctions"))
local ConfettiBurstPlayer = require(Modules:WaitForChild("UI"):WaitForChild("ConfettiBurstPlayer"))
local SoundService = require(Modules:WaitForChild("SoundService"))
local TweenConfig = require(Modules:WaitForChild("UI"):WaitForChild("TweenConfig"))

local SpinWheelUI = {}
SpinWheelUI.__index = SpinWheelUI

local MODULE_NAME = "SpinWheelUI"
local SPINS_ATTRIBUTE = "SpinWheelSpins"
local NEXT_FREE_SPIN_ATTRIBUTE = "SpinWheelNextFreeSpinUnix"
local FREE_SPIN_COOLDOWN_SECONDS = 24 * 60 * 60
local REWARDED_AD_REMAINING_ATTRIBUTE = "SpinWheelRewardedAdSpinsRemaining"
local REWARDED_AD_NEXT_AVAILABLE_ATTRIBUTE = "SpinWheelRewardedAdNextAvailableUnix"
local REWARDED_AD_RESET_ATTRIBUTE = "SpinWheelRewardedAdResetUnix"
local BLUR_SIZE = 24
local BADGE_NAME = "SpinWheelClaimableNotification"
local SPIN_LABEL_TEXT_COLOR = Color3.fromRGB(254, 199, 41)
local SPIN_LABEL_GRADIENT_BOTTOM = Color3.fromHex("#FF5500")
local SPIN_LABEL_SHINE = Color3.fromRGB(255, 255, 255)
local SPIN_LABEL_BASE_SHAKE_DEGREES = 1.5
local SPIN_LABEL_MAX_SHAKE_DEGREES = 10
local SPIN_LABEL_BASE_SCALE_POP = 0.015
local SPIN_LABEL_MAX_SCALE_POP = 0.12
local SPIN_WHEEL_BASE_SHAKE_PIXELS = 2
local SPIN_WHEEL_MAX_SHAKE_PIXELS = 12
local SPIN_WHEEL_BASE_SCALE_POP = 0.01
local SPIN_WHEEL_MAX_SCALE_POP = 0.075
local SPIN_ARROW_BASE_SHAKE_PIXELS = 1
local SPIN_ARROW_MAX_SHAKE_PIXELS = 7
local SPIN_ARROW_BASE_SHAKE_DEGREES = 0.75
local SPIN_ARROW_MAX_SHAKE_DEGREES = 6
local SPIN_REWARD_CONFETTI_COLORS = {
	Color3.fromRGB(255, 240, 166),
	Color3.fromRGB(255, 215, 64),
	Color3.fromRGB(255, 181, 46),
	Color3.fromRGB(242, 140, 40),
}
local SPIN_REWARD_CONFETTI_DURATION = 1.5
local SPIN_REWARD_CONFETTI_COUNT = 55
local DEFAULT_JUMP_HEIGHT = 8.6
local DEFAULT_JUMP_POWER = 50
local MOVEMENT_LOCK_ACTION = "SpinWheelMovementLock"
local MOVEMENT_LOCK_KEYS = {
	Enum.KeyCode.W,
	Enum.KeyCode.A,
	Enum.KeyCode.S,
	Enum.KeyCode.D,
	Enum.KeyCode.Up,
	Enum.KeyCode.Down,
	Enum.KeyCode.Left,
	Enum.KeyCode.Right,
	Enum.KeyCode.Space,
}

type VisibilityState = {
	visible: boolean,
	interactable: boolean,
}

local MODAL_PRESERVED_FRAME_NAMES: { [string]: boolean } = {
	EventFrameList = true,
	EventProgress = true,
	StageProgressFrame = true,
	NotificationFrame = true,
	MinigameNotificationFrame = true,
	LevelUpFrame = true,
	ConfettiFrame = true,
}

type Controller = {
	root: Instance,
	player: Player,
	maid: any,
	frame: Frame?,
	mainFrame: Frame?,
	notificationFrame: Frame?,
	notificationFrameDefaultZIndex: number?,
	confettiHost: GuiObject?,
	confettiPlayer: any,
	arrow: GuiObject?,
	spinWheelButtonFrame: GuiObject?,
	spinButtonFrame: Frame?,
	spinButton: TextButton?,
	spinLabel: TextLabel?,
	spinLabelShineOverlay: TextLabel?,
	spinLabelScale: UIScale?,
	spinLabelShineScale: UIScale?,
	spinLabelOriginalRotation: number?,
	spinLabelShineOriginalRotation: number?,
	arrowOriginalPosition: UDim2?,
	arrowOriginalRotation: number?,
	mainFrameScale: UIScale?,
	mainFrameOriginalPosition: UDim2?,
	mainFrameOriginalScale: number?,
	nextSpinLabel: TextLabel?,
	nextSpinLabel1: TextLabel?,
	watchAdButtonFrame: Frame?,
	watchAdButton: TextButton?,
	exitButton: GuiButton?,
	rewardFrames: { [SpinWheelConfig.RewardId]: GuiObject },
	visibilitySnapshot: { [GuiObject]: VisibilityState },
	badge: GuiObject?,
	blurEffect: BlurEffect?,
	createdBlur: boolean,
	isOpen: boolean,
	alive: boolean,
	spinInFlight: boolean,
	rewardedAdInFlight: boolean,
	rewardedAdCooldownVisible: boolean,
	rewardedAdRemainingOverride: number?,
	rewardedAdNextAvailableOverride: number?,
	rewardedAdResetOverride: number?,
	watchAdDisabled: boolean?,
	spinButtonDisabled: boolean?,
	spinToken: number,
	idleThread: thread?,
	countdownThread: thread?,
	availabilityThread: thread?,
	spinThread: thread?,
	spinTickThread: thread?,
	spinLabelEffectThread: thread?,
	grantThread: thread?,
	activeTween: Tween?,
	lastBadgeText: string?,
	pendingServerToken: string?,
	movementLockedHumanoid: Humanoid?,
	movementWalkSpeed: number?,
	movementJumpHeight: number?,
	movementJumpPower: number?,
	movementAutoRotate: boolean?,
	movementInputBound: boolean,
}

local function findGuiButton(instance: Instance?): GuiButton?
	if not instance then
		return nil
	end
	if instance:IsA("GuiButton") then
		return instance
	end
	return instance:FindFirstChildWhichIsA("GuiButton", true)
end

local function findTextLabel(instance: Instance?, name: string): TextLabel?
	if not instance then
		return nil
	end
	local child = instance:FindFirstChild(name, true)
	return if child and child:IsA("TextLabel") then child else nil
end

local function getNumberAttribute(player: Player, name: string, defaultValue: number): number
	local value = player:GetAttribute(name)
	return if typeof(value) == "number" then value else defaultValue
end

local function formatDuration(seconds: number): string
	local remaining = math.max(0, math.floor(seconds))
	local hours = math.floor(remaining / 3600)
	local minutes = math.floor((remaining % 3600) / 60)
	local remainder = remaining % 60
	return string.format("%02d:%02d:%02d", hours, minutes, remainder)
end

local function normalizePositiveAngle(angle: number): number
	local normalized = angle % 360
	return if normalized < 0 then normalized + 360 else normalized
end

local function normalizeSignedAngle(angle: number): number
	local normalized = normalizePositiveAngle(angle)
	return if normalized > 180 then normalized - 360 else normalized
end

local function getCenter(guiObject: GuiObject): Vector2
	return guiObject.AbsolutePosition + (guiObject.AbsoluteSize * 0.5)
end

local function getAngleBetween(origin: Vector2, target: Vector2): number
	local delta = target - origin
	return math.deg(math.atan2(delta.Y, delta.X))
end

local function getRewardName(rewardId: SpinWheelConfig.RewardId): string
	local reward = SpinWheelConfig.GetReward(rewardId)
	return if reward then reward.displayName else string.upper(rewardId)
end

function SpinWheelUI.new(root: Instance): Controller
	local self = setmetatable({
		root = root,
		player = game:GetService("Players").LocalPlayer,
		maid = Maid.new(),
		frame = nil,
		mainFrame = nil,
		notificationFrame = nil,
		notificationFrameDefaultZIndex = nil,
		confettiHost = nil,
		confettiPlayer = nil,
		arrow = nil,
		spinWheelButtonFrame = nil,
		spinButtonFrame = nil,
		spinButton = nil,
		spinLabel = nil,
		spinLabelShineOverlay = nil,
		spinLabelScale = nil,
		spinLabelShineScale = nil,
		spinLabelOriginalRotation = nil,
		spinLabelShineOriginalRotation = nil,
		arrowOriginalPosition = nil,
		arrowOriginalRotation = nil,
		mainFrameScale = nil,
		mainFrameOriginalPosition = nil,
		mainFrameOriginalScale = nil,
		nextSpinLabel = nil,
		nextSpinLabel1 = nil,
		watchAdButtonFrame = nil,
		watchAdButton = nil,
		exitButton = nil,
		rewardFrames = {},
		visibilitySnapshot = {},
		badge = nil,
		blurEffect = nil,
		createdBlur = false,
		isOpen = false,
		alive = true,
		spinInFlight = false,
		rewardedAdInFlight = false,
		rewardedAdCooldownVisible = false,
		rewardedAdRemainingOverride = nil,
		rewardedAdNextAvailableOverride = nil,
		rewardedAdResetOverride = nil,
		watchAdDisabled = nil,
		spinButtonDisabled = nil,
		spinToken = 0,
		idleThread = nil,
		countdownThread = nil,
		availabilityThread = nil,
		spinThread = nil,
		spinTickThread = nil,
		spinLabelEffectThread = nil,
		grantThread = nil,
		activeTween = nil,
		lastBadgeText = nil,
		pendingServerToken = nil,
		movementLockedHumanoid = nil,
		movementWalkSpeed = nil,
		movementJumpHeight = nil,
		movementJumpPower = nil,
		movementAutoRotate = nil,
		movementInputBound = false,
	}, SpinWheelUI) :: Controller
	return self
end

function SpinWheelUI:findReferences()
	local frameInstance = self.root:FindFirstChild("SpinWheelFrame", true)
	local buttonFrame = self.root:FindFirstChild("SpinWheelButtonFrame", true)
	if not frameInstance or not frameInstance:IsA("Frame") then
		DebugModule.debugWarn("SpinWheelFrame missing", MODULE_NAME)
		return false
	end
	if not buttonFrame or not buttonFrame:IsA("GuiObject") then
		DebugModule.debugWarn("SpinWheelButtonFrame missing", MODULE_NAME)
		return false
	end

	self.frame = frameInstance
	self.mainFrame = frameInstance:FindFirstChild("MainFrame") :: Frame?
	local notificationFrame = self.root:FindFirstChild("NotificationFrame", true)
	self.notificationFrame = if notificationFrame and notificationFrame:IsA("Frame") then notificationFrame else nil
	if self.notificationFrame then
		self.notificationFrameDefaultZIndex = self.notificationFrame.ZIndex
	end
	local confettiHost = self.root:FindFirstChild("ConfettiFrame", true)
	self.confettiHost = if confettiHost and confettiHost:IsA("GuiObject") then confettiHost else nil
	if self.confettiHost then
		self.confettiPlayer = ConfettiBurstPlayer.GetOrCreateSingleton(self.confettiHost)
		self:raiseConfettiLayer()
	end
	self.arrow = frameInstance:FindFirstChild("Arrow") :: GuiObject?
	if self.arrow then
		self.arrowOriginalPosition = self.arrow.Position
		self.arrowOriginalRotation = self.arrow.Rotation
	end
	self.spinWheelButtonFrame = buttonFrame
	self.spinButtonFrame = frameInstance:FindFirstChild("SpinButton") :: Frame?
	local spinButton = findGuiButton(self.spinButtonFrame)
	self.spinButton = if spinButton and spinButton:IsA("TextButton") then spinButton else nil
	self.spinLabel = findTextLabel(frameInstance, "SpinLabel")
	self.nextSpinLabel = findTextLabel(frameInstance, "NextSpinLabel")
	self.nextSpinLabel1 = findTextLabel(frameInstance, "NextSpinLabel1")
	local watchAdButtonFrame = frameInstance:FindFirstChild("WatchAdButton")
	self.watchAdButtonFrame = if watchAdButtonFrame and watchAdButtonFrame:IsA("Frame") then watchAdButtonFrame else nil
	local watchAdButton = findGuiButton(watchAdButtonFrame)
	self.watchAdButton = if watchAdButton and watchAdButton:IsA("TextButton") then watchAdButton else nil
	self.exitButton = findGuiButton(frameInstance:FindFirstChild("ExitButton"))

	if
		not self.mainFrame
		or not self.arrow
		or not self.spinButtonFrame
		or not self.spinButton
		or not self.exitButton
	then
		DebugModule.debugWarn("Spin wheel UI references incomplete", MODULE_NAME)
		return false
	end

	for _, reward in ipairs(SpinWheelConfig.Rewards) do
		local rewardFrame = self.mainFrame:FindFirstChild(reward.frameName)
		if rewardFrame and rewardFrame:IsA("GuiObject") then
			self.rewardFrames[reward.id] = rewardFrame
		end
	end

	return true
end

function SpinWheelUI:raiseConfettiLayer()
	local confettiHost = self.confettiHost
	if not confettiHost then
		return
	end

	local highestSiblingZIndex = 0
	for _, child in ipairs(self.root:GetChildren()) do
		if child:IsA("GuiObject") and child ~= confettiHost then
			highestSiblingZIndex = math.max(highestSiblingZIndex, child.ZIndex)
		end
	end

	confettiHost.ZIndex = math.max(confettiHost.ZIndex, highestSiblingZIndex + 1)
end

function SpinWheelUI:playRewardConfetti()
	local confettiPlayer = self.confettiPlayer
	if not confettiPlayer then
		return
	end

	local confettiHost = self.confettiHost
	if confettiHost then
		confettiHost.Visible = true
	end
	self:raiseConfettiLayer()
	confettiPlayer:PlayBurst(
		SPIN_REWARD_CONFETTI_COLORS,
		SPIN_REWARD_CONFETTI_DURATION,
		SPIN_REWARD_CONFETTI_COUNT
	)
end

function SpinWheelUI:setNotificationLayerForWheel(isWheelOpen: boolean)
	local notificationFrame = self.notificationFrame
	if not notificationFrame then
		return
	end

	if isWheelOpen then
		local wheelZIndex = if self.frame then self.frame.ZIndex else notificationFrame.ZIndex
		notificationFrame.ZIndex = math.max(notificationFrame.ZIndex, wheelZIndex + 1)
		return
	end

	local defaultZIndex = self.notificationFrameDefaultZIndex
	if defaultZIndex ~= nil then
		notificationFrame.ZIndex = defaultZIndex
	end
end

function SpinWheelUI:setupSpinLabelGradient(): TextLabel?
	local label = self.spinLabel
	if not label then
		return nil
	end

	label.TextColor3 = SPIN_LABEL_TEXT_COLOR

	for _, child in ipairs(label:GetChildren()) do
		local isGradient = child.Name == "SpinLabelBottomColor" or child.Name == "SpinLabelShine"
		local isScale = child.Name == "SpinLabelSpinScale"
		if isGradient or isScale then
			if (isGradient and child:IsA("UIGradient")) or (isScale and child:IsA("UIScale")) then
				child:Destroy()
			else
				DebugModule.debugWarn(
					child.Name .. " has an unexpected class: " .. child.ClassName,
					MODULE_NAME
				)
				return nil
			end
		end
	end

	local bottomColorGradient = Instance.new("UIGradient")
	bottomColorGradient.Name = "SpinLabelBottomColor"
	bottomColorGradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(1, SPIN_LABEL_GRADIENT_BOTTOM),
	})
	bottomColorGradient.Rotation = 90
	bottomColorGradient.Parent = label

	local parent = label.Parent
	if not parent then
		bottomColorGradient:Destroy()
		return nil
	end

	local existingOverlay = parent:FindFirstChild("SpinLabelShineOverlay")
	if existingOverlay then
		existingOverlay:Destroy()
	end

	local shineOverlay = label:Clone()
	shineOverlay.Name = "SpinLabelShineOverlay"
	shineOverlay.ZIndex = label.ZIndex + 1
	shineOverlay.TextColor3 = SPIN_LABEL_SHINE
	shineOverlay.TextTransparency = 0
	shineOverlay.BackgroundTransparency = 1
	shineOverlay.Interactable = false
	for _, child in ipairs(shineOverlay:GetChildren()) do
		if child:IsA("UIStroke") or child:IsA("UIGradient") then
			child:Destroy()
		end
	end

	local shineGradient = Instance.new("UIGradient")
	shineGradient.Name = "SpinLabelShine"
	shineGradient.Color = ColorSequence.new(SPIN_LABEL_SHINE)
	shineGradient.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1),
		NumberSequenceKeypoint.new(0.42, 1),
		NumberSequenceKeypoint.new(0.5, 0),
		NumberSequenceKeypoint.new(0.58, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	shineGradient.Offset = Vector2.new(-1, 0)
	shineGradient.Parent = shineOverlay
	shineOverlay.Parent = parent

	local labelScale = Instance.new("UIScale")
	labelScale.Name = "SpinLabelSpinScale"
	labelScale.Scale = 1
	labelScale.Parent = label

	local shineScale = Instance.new("UIScale")
	shineScale.Name = "SpinLabelSpinScale"
	shineScale.Scale = 1
	shineScale.Parent = shineOverlay

	self.maid:GiveTask(bottomColorGradient)
	self.maid:GiveTask(shineOverlay)
	self.maid:GiveTask(labelScale)
	self.maid:GiveTask(shineScale)
	self.spinLabelShineOverlay = shineOverlay
	self.spinLabelScale = labelScale
	self.spinLabelShineScale = shineScale
	self.spinLabelOriginalRotation = label.Rotation
	self.spinLabelShineOriginalRotation = shineOverlay.Rotation

	local shineTween = TweenService:Create(
		shineGradient,
		TweenConfig.SpinWheelShine,
		{ Offset = Vector2.new(1, 0) }
	)
	self.maid:GiveTask(shineTween)
	shineTween:Play()

	self.maid:GiveTask(label:GetPropertyChangedSignal("Visible"):Connect(function()
		shineOverlay.Visible = label.Visible
	end))
	self.maid:GiveTask(label:GetPropertyChangedSignal("Text"):Connect(function()
		shineOverlay.Text = label.Text
	end))

	return shineOverlay
end

function SpinWheelUI:setupSpinWheelEffect()
	local mainFrame = self.mainFrame
	if not mainFrame then
		return
	end

	self.mainFrameOriginalPosition = mainFrame.Position
	local existingScale = mainFrame:FindFirstChild("SpinWheelSpinScale")
	if existingScale and not existingScale:IsA("UIScale") then
		DebugModule.debugWarn("SpinWheelSpinScale has an unexpected class: " .. existingScale.ClassName, MODULE_NAME)
		return
	end

	local scale = existingScale :: UIScale?
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "SpinWheelSpinScale"
		scale.Scale = 1
		scale.Parent = mainFrame
		self.maid:GiveTask(scale)
	end

	self.mainFrameScale = scale
	self.mainFrameOriginalScale = scale.Scale
end

function SpinWheelUI:setButtonEnabled(button: GuiButton, isEnabled: boolean)
	button.Active = isEnabled
	button.AutoButtonColor = isEnabled
	button.Selectable = isEnabled
	if button.Parent and button.Parent:IsA("Frame") then
		button.Parent.Interactable = isEnabled
	end
end

function SpinWheelUI:getFreeSpinCooldownSeconds(): number
	local config = CoreConfig.spinWheel
	return if config and typeof(config.freeSpinCooldownSeconds) == "number"
		then math.max(1, math.floor(config.freeSpinCooldownSeconds))
		else FREE_SPIN_COOLDOWN_SECONDS
end

function SpinWheelUI:getRewardedAdMaxSpins(): number
	local config = CoreConfig.spinWheel
	return if config and typeof(config.rewardedAdMaxSpins) == "number"
		then math.max(1, math.floor(config.rewardedAdMaxSpins))
		else 5
end

local function formatMinutesSeconds(seconds: number): string
	local remaining = math.max(0, math.floor(seconds))
	return string.format("%02d:%02d", math.floor(remaining / 60), remaining % 60)
end

function SpinWheelUI:getRewardedAdState(): (number, number, number)
	local maxSpins = self:getRewardedAdMaxSpins()
	local remaining = self.rewardedAdRemainingOverride
		or getNumberAttribute(self.player, REWARDED_AD_REMAINING_ATTRIBUTE, maxSpins)
	local nextAvailableUnix = self.rewardedAdNextAvailableOverride
		or getNumberAttribute(self.player, REWARDED_AD_NEXT_AVAILABLE_ATTRIBUTE, 0)
	local resetUnix = self.rewardedAdResetOverride or getNumberAttribute(self.player, REWARDED_AD_RESET_ATTRIBUTE, 0)
	local safeRemaining = math.clamp(math.floor(remaining), 0, maxSpins)
	local safeNextAvailableUnix = math.max(0, math.floor(nextAvailableUnix))
	local safeResetUnix = math.max(0, math.floor(resetUnix))
	if safeResetUnix > 0 and safeResetUnix <= os.time() then
		-- The server applies the authoritative reset when the next ad is requested.
		return maxSpins, 0, 0
	end
	return safeRemaining, safeNextAvailableUnix, safeResetUnix
end

local function formatRewardedAdCountdown(seconds: number): string
	local remaining = math.max(0, math.floor(seconds))
	if remaining >= 60 * 60 then
		return formatDuration(remaining)
	end
	return formatMinutesSeconds(remaining)
end

function SpinWheelUI:updateWatchAdButton()
	local button = self.watchAdButton
	local frame = self.watchAdButtonFrame
	local cooldownLabel = self.nextSpinLabel1
	if not button or not frame then
		return
	end

	local maxSpins = self:getRewardedAdMaxSpins()
	local remaining, nextAvailableUnix, resetUnix = self:getRewardedAdState()
	local cooldownRemaining = math.max(0, nextAvailableUnix - os.time())
	local dailyResetRemaining = if remaining <= 0 then math.max(0, resetUnix - os.time()) else 0
	local countdownRemaining = math.max(cooldownRemaining, dailyResetRemaining)
	local disabled = self.rewardedAdInFlight or remaining <= 0 or cooldownRemaining > 0
	if countdownRemaining <= 0 then
		self.rewardedAdCooldownVisible = false
	end

	button.Text = string.format("WATCH AD TO SPIN (%d/%d)", remaining, maxSpins)
	if cooldownLabel then
		cooldownLabel.Text = formatRewardedAdCountdown(countdownRemaining)
		cooldownLabel.Visible = self.rewardedAdCooldownVisible and countdownRemaining > 0 and disabled
	end
	self:setButtonEnabled(button, not disabled)
	if self.watchAdDisabled ~= disabled then
		VisualFunctions.SetFrameDisabledState(frame, disabled, 0.75)
		self.watchAdDisabled = disabled
	end
end

function SpinWheelUI:hasSpinAvailable(): boolean
	if getNumberAttribute(self.player, SPINS_ATTRIBUTE, 0) > 0 then
		return true
	end

	local nextFreeSpinUnix = getNumberAttribute(self.player, NEXT_FREE_SPIN_ATTRIBUTE, 0)
	return nextFreeSpinUnix <= os.time()
end

function SpinWheelUI:updateAvailabilityBadge()
	local shouldShow = self:hasSpinAvailable()
	if not shouldShow then
		if self.badge then
			self.badge:Destroy()
			self.badge = nil
		end
		self.lastBadgeText = nil
		return
	end

	local buttonFrame = self.spinWheelButtonFrame
	if not buttonFrame or buttonFrame.Parent == nil then
		return
	end

	local count = math.max(1, math.floor(getNumberAttribute(self.player, SPINS_ATTRIBUTE, 0)))
	local countText = tostring(count)
	if self.badge == nil or self.badge.Parent == nil then
		local template = self.root:FindFirstChild("NotifShow_Template", true)
		if template and template:IsA("GuiObject") then
			self.badge = template:Clone()
			self.badge.Name = BADGE_NAME
			self.badge.Visible = true
			self.badge.Parent = buttonFrame
		end
	end

	if self.badge then
		self.badge.Visible = true
		if self.lastBadgeText == countText then
			return
		end
		self.lastBadgeText = countText
		local numberLabel = self.badge:FindFirstChild("NumberLabel", true)
		if numberLabel and (numberLabel:IsA("TextLabel") or numberLabel:IsA("TextButton")) then
			(numberLabel :: TextLabel).Text = countText
		end
	end
end

function SpinWheelUI:updateCountdownLabel()
	local label = self.nextSpinLabel
	if not label then
		return
	end

	if self:hasSpinAvailable() then
		label.Text = "NEXT SPIN READY!"
		return
	end

	local nextFreeSpinUnix = getNumberAttribute(self.player, NEXT_FREE_SPIN_ATTRIBUTE, 0)
	local remaining = math.max(0, nextFreeSpinUnix - os.time())
	label.Text = "NEXT SPIN IN " .. formatDuration(remaining)
end

function SpinWheelUI:updateSpinButton()
	local button = self.spinButton
	if not button then
		return
	end

	local spinCount = math.max(0, math.floor(getNumberAttribute(self.player, SPINS_ATTRIBUTE, 0)))
	local hasSpinAvailable = self:hasSpinAvailable()
	local shouldDarken = not hasSpinAvailable
	button.Text = if spinCount <= 1 then "SPIN" else "SPIN (" .. tostring(spinCount) .. ")"
	self:setButtonEnabled(button, not self.spinInFlight and hasSpinAvailable)
	if self.spinButtonFrame and self.spinButtonDisabled ~= shouldDarken then
		VisualFunctions.SetFrameDisabledState(self.spinButtonFrame, shouldDarken, 0.75)
		self.spinButtonDisabled = shouldDarken
	end
	if self.exitButton then
		self:setButtonEnabled(self.exitButton, not self.spinInFlight)
	end
	self:updateAvailabilityBadge()
	self:updateCountdownLabel()
	self:updateWatchAdButton()
end

function SpinWheelUI:refreshRewardPreviews()
	local maxXPSpeed = getNumberAttribute(self.player, "MaxXPSpeed", 1)
	local smallSpeed = SpinWheelConfig.GetSmallSpeedBase(maxXPSpeed)
	local totalWins = getNumberAttribute(self.player, "WinCount", 0)
	local wheelWins = SpinWheelConfig.GetWheelWinsBase(totalWins)
	local largeSpeed = SpinWheelConfig.GetLargeSpeedBase(maxXPSpeed)

	local previewText: { [SpinWheelConfig.RewardId]: string } = {
		SpeedSmall = "+" .. VisualFunctions.FormatNumber(smallSpeed) .. " SPEED",
		SpeedLarge = "+" .. VisualFunctions.FormatNumber(largeSpeed) .. " SPEED",
		Wins = "+" .. VisualFunctions.FormatNumber(wheelWins) .. " WINS",
		Rebirth = "+1 REBIRTH",
		FlameTrail = "FLAME TRAIL",
		FlameKart = "FLAME KART",
	}

	for rewardId, rewardFrame in pairs(self.rewardFrames) do
		local rewardName = findTextLabel(rewardFrame, "RewardName")
		if rewardName then
			rewardName.Text = previewText[rewardId]
		end
		local chance = findTextLabel(rewardFrame, "Chance")
		local reward = SpinWheelConfig.GetReward(rewardId)
		if chance and reward then
			chance.Text = tostring(reward.chance) .. "%"
		end
	end
end

function SpinWheelUI:loadPrices()
	for _, pack in ipairs(SpinWheelConfig.PurchasePacks) do
		local packFrame = self.frame and self.frame:FindFirstChild(pack.buttonName, true)
		local priceLabel = findTextLabel(packFrame, "PriceLabel")
		local productId = tonumber(ProductService.DevProducts[pack.productKey])
		if priceLabel then
			priceLabel.Text = "..."
		end
		if not packFrame then
			DebugModule.debugWarn("Purchase frame missing: " .. pack.buttonName, MODULE_NAME)
		elseif not productId or productId <= 0 then
			DebugModule.debugWarn("Purchase product ID missing: " .. pack.productKey, MODULE_NAME)
		elseif not priceLabel then
			DebugModule.debugWarn("PriceLabel missing: " .. pack.buttonName, MODULE_NAME)
		else
			local thread = task.spawn(function()
				local ok, info = pcall(function()
					return MarketplaceService:GetProductInfo(productId, Enum.InfoType.Product)
				end)
				if not self.alive or priceLabel.Parent == nil then
					return
				end
				if ok and typeof(info) == "table" then
					local price = (info :: any).PriceInRobux
					if typeof(price) == "number" then
						priceLabel.Text = tostring(math.max(0, math.floor(price)))
					else
						priceLabel.Text = "0"
						DebugModule.debugWarn("Product has no Robux price: " .. pack.productKey, MODULE_NAME)
					end
				else
					priceLabel.Text = "0"
					DebugModule.debugWarn(
						"Failed price lookup for " .. pack.productKey .. " (" .. tostring(info) .. ")",
						MODULE_NAME
					)
				end
			end)
			self.maid:GiveSpawnTask(thread)
		end
	end
end

function SpinWheelUI:stopIdleRotation()
	if self.idleThread then
		task.cancel(self.idleThread)
		self.idleThread = nil
	end
end

function SpinWheelUI:startIdleRotation()
	self:stopIdleRotation()
	local mainFrame = self.mainFrame
	if not mainFrame then
		return
	end

	local config = CoreConfig.spinWheel
	local degreesPerSecond = if config and typeof(config.idleRotationDegreesPerSecond) == "number"
		then config.idleRotationDegreesPerSecond
		else 8
	self.idleThread = task.spawn(function()
		while self.alive and self.isOpen and mainFrame.Parent ~= nil do
			local dt = RunService.RenderStepped:Wait()
			if not self.spinInFlight then
				mainFrame.Rotation += dt * degreesPerSecond
			end
		end
	end)
end

function SpinWheelUI:stopCountdown()
	if self.countdownThread then
		task.cancel(self.countdownThread)
		self.countdownThread = nil
	end
end

function SpinWheelUI:startCountdown()
	self:stopCountdown()
	self.countdownThread = task.spawn(function()
		while self.alive and self.isOpen and self.frame and self.frame.Parent ~= nil do
			self:updateSpinButton()
			task.wait(1)
		end
	end)
end

function SpinWheelUI:startAvailabilityWatcher()
	if self.availabilityThread then
		task.cancel(self.availabilityThread)
		self.availabilityThread = nil
	end
	self.availabilityThread = task.spawn(function()
		while self.alive and self.root.Parent ~= nil do
			self:updateSpinButton()
			task.wait(1)
		end
	end)
end

function SpinWheelUI:stopAvailabilityWatcher()
	if self.availabilityThread then
		task.cancel(self.availabilityThread)
		self.availabilityThread = nil
	end
end

function SpinWheelUI:resetSpinVisuals()
	local label = self.spinLabel
	if label then
		label.Rotation = self.spinLabelOriginalRotation or 0
	end
	local shineOverlay = self.spinLabelShineOverlay
	if shineOverlay then
		shineOverlay.Rotation = self.spinLabelShineOriginalRotation or 0
	end
	if self.spinLabelScale then
		self.spinLabelScale.Scale = 1
	end
	if self.spinLabelShineScale then
		self.spinLabelShineScale.Scale = 1
	end
	local arrow = self.arrow
	if arrow then
		if self.arrowOriginalPosition then
			arrow.Position = self.arrowOriginalPosition
		end
		arrow.Rotation = self.arrowOriginalRotation or 0
	end
	local mainFrame = self.mainFrame
	if mainFrame and self.mainFrameOriginalPosition then
		mainFrame.Position = self.mainFrameOriginalPosition
	end
	if self.mainFrameScale and self.mainFrameOriginalScale then
		self.mainFrameScale.Scale = self.mainFrameOriginalScale
	end
end

function SpinWheelUI:stopSpinEffect()
	if self.spinLabelEffectThread then
		task.cancel(self.spinLabelEffectThread)
		self.spinLabelEffectThread = nil
	end
	self:resetSpinVisuals()
end

function SpinWheelUI:startSpinEffect(token: number, plannedTravelDegrees: number, duration: number)
	self:stopSpinEffect()

	local label = self.spinLabel
	local shineOverlay = self.spinLabelShineOverlay
	local labelScale = self.spinLabelScale
	local shineScale = self.spinLabelShineScale
	local arrow = self.arrow
	local mainFrame = self.mainFrame
	if not mainFrame then
		return
	end

	local referenceSpeed = math.max(1, plannedTravelDegrees / math.max(duration, 0.5) * 5)
	self.spinLabelEffectThread = task.spawn(function()
		local previousRotation = mainFrame.Rotation
		local shakePhase = 0
		while
			self.alive
			and self.isOpen
			and self.spinInFlight
			and token == self.spinToken
			and mainFrame.Parent ~= nil
		do
			local deltaTime = RunService.RenderStepped:Wait()
			local currentRotation = mainFrame.Rotation
			local degreesPerSecond = if deltaTime > 0
				then math.abs(currentRotation - previousRotation) / deltaTime
				else 0
			previousRotation = currentRotation

			local speedAlpha = math.clamp(degreesPerSecond / referenceSpeed, 0, 1)
			local intensity = speedAlpha ^ 0.7
			shakePhase += deltaTime * (18 + (28 * intensity))
			local shakeOffset = math.sin(shakePhase) * (
				SPIN_LABEL_BASE_SHAKE_DEGREES + (SPIN_LABEL_MAX_SHAKE_DEGREES * intensity)
			)
			local pulse = 0.5 + (0.5 * math.sin(shakePhase + (math.pi / 2)))
			if label and shineOverlay and labelScale and shineScale then
				local scale = 1
					+ (SPIN_LABEL_BASE_SCALE_POP + (SPIN_LABEL_MAX_SCALE_POP * intensity)) * pulse

				label.Rotation = (self.spinLabelOriginalRotation or 0) + shakeOffset
				shineOverlay.Rotation = (self.spinLabelShineOriginalRotation or 0) + shakeOffset
				labelScale.Scale = scale
				shineScale.Scale = scale
			end

			if arrow and self.arrowOriginalPosition then
				local arrowShake = math.sin((shakePhase * 1.2) + math.pi) * (
					SPIN_ARROW_BASE_SHAKE_PIXELS + (SPIN_ARROW_MAX_SHAKE_PIXELS * intensity)
				)
				local arrowBounce = math.abs(math.sin(shakePhase * 0.9)) * (
					SPIN_ARROW_BASE_SHAKE_PIXELS + (SPIN_ARROW_MAX_SHAKE_PIXELS * 0.65 * intensity)
				)
				arrow.Position = UDim2.new(
					self.arrowOriginalPosition.X.Scale,
					self.arrowOriginalPosition.X.Offset + arrowShake,
					self.arrowOriginalPosition.Y.Scale,
					self.arrowOriginalPosition.Y.Offset + arrowBounce
				)
				arrow.Rotation = (self.arrowOriginalRotation or 0) + math.sin(shakePhase * 1.05) * (
					SPIN_ARROW_BASE_SHAKE_DEGREES + (SPIN_ARROW_MAX_SHAKE_DEGREES * intensity)
				)
			end

			local mainFrameScale = self.mainFrameScale
			local mainFramePosition = self.mainFrameOriginalPosition
			if mainFrameScale and mainFramePosition then
				local wheelShake = math.sin(shakePhase * 0.85) * (
					SPIN_WHEEL_BASE_SHAKE_PIXELS + (SPIN_WHEEL_MAX_SHAKE_PIXELS * intensity)
				)
				local wheelVerticalShake = math.sin(shakePhase * 1.1) * (
					(SPIN_WHEEL_BASE_SHAKE_PIXELS * 0.35) + (SPIN_WHEEL_MAX_SHAKE_PIXELS * 0.25 * intensity)
				)
				mainFrame.Position = UDim2.new(
					mainFramePosition.X.Scale,
					mainFramePosition.X.Offset + wheelShake,
					mainFramePosition.Y.Scale,
					mainFramePosition.Y.Offset + wheelVerticalShake
				)
				mainFrameScale.Scale = (self.mainFrameOriginalScale or 1)
					* (1 + (SPIN_WHEEL_BASE_SCALE_POP + (SPIN_WHEEL_MAX_SCALE_POP * intensity)) * pulse)
			end
		end

		if self.spinLabelEffectThread == coroutine.running() then
			self.spinLabelEffectThread = nil
			self:resetSpinVisuals()
		end
	end)
end

function SpinWheelUI:stopSpinTween()
	self.spinToken += 1
	self:stopSpinEffect()
	if self.spinTickThread then
		task.cancel(self.spinTickThread)
		self.spinTickThread = nil
	end
	if self.activeTween then
		self.activeTween:Cancel()
		self.activeTween = nil
	end
	if self.spinThread then
		task.cancel(self.spinThread)
		self.spinThread = nil
	end
	self.spinInFlight = false
end

function SpinWheelUI:resetCompletedSpinState()
	if self.spinInFlight then
		return
	end

	if self.activeTween then
		self.activeTween:Cancel()
		self.activeTween = nil
	end
	if self.spinThread then
		task.cancel(self.spinThread)
		self.spinThread = nil
	end
	if self.spinTickThread then
		task.cancel(self.spinTickThread)
		self.spinTickThread = nil
	end
	self:stopGrantThread()
	self.pendingServerToken = nil
	self.spinToken += 1
end

function SpinWheelUI:startSpinTickSound(tween: Tween, token: number)
	if self.spinTickThread then
		task.cancel(self.spinTickThread)
		self.spinTickThread = nil
	end

	local mainFrame = self.mainFrame
	if not mainFrame then
		return
	end

	local rewardCount = 0
	for _ in pairs(self.rewardFrames) do
		rewardCount += 1
	end
	if rewardCount <= 0 then
		return
	end

	local segmentAngle = 360 / rewardCount
	local config = CoreConfig.spinWheel
	local volume = if config and typeof(config.wheelTickVolume) == "number"
		then math.max(0, config.wheelTickVolume)
		else 0.25
	local minPlaybackSpeed = if config and typeof(config.wheelTickMinPlaybackSpeed) == "number"
		then math.max(1, config.wheelTickMinPlaybackSpeed)
		else 1
	local maxPlaybackSpeed = if config and typeof(config.wheelTickMaxPlaybackSpeed) == "number"
		then math.max(minPlaybackSpeed, config.wheelTickMaxPlaybackSpeed)
		else 1.6
	local referenceDegreesPerSecond = if config
			and typeof(config.wheelTickReferenceDegreesPerSecond) == "number"
		then math.max(1, config.wheelTickReferenceDegreesPerSecond)
		else 720

	self.spinTickThread = task.spawn(function()
		local previousRotation = mainFrame.Rotation
		while self.alive and self.isOpen and token == self.spinToken and mainFrame.Parent ~= nil do
			if tween.PlaybackState ~= Enum.PlaybackState.Playing then
				break
			end

			local deltaTime = RunService.RenderStepped:Wait()
			local currentRotation = mainFrame.Rotation
			local previousSegment = math.floor(previousRotation / segmentAngle)
			local currentSegment = math.floor(currentRotation / segmentAngle)
			local crossedSegments = math.abs(currentSegment - previousSegment)

			if crossedSegments > 0 then
				local degreesPerSecond = if deltaTime > 0
					then math.abs(currentRotation - previousRotation) / deltaTime
					else 0
				local speedAlpha = math.clamp(degreesPerSecond / referenceDegreesPerSecond, 0, 1)
				local playbackSpeed = minPlaybackSpeed + ((maxPlaybackSpeed - minPlaybackSpeed) * speedAlpha)
				local tickCount = math.min(crossedSegments, 4)

				for _ = 1, tickCount do
					SoundService.PlayGuiSound("Click", nil, {
						Volume = volume,
						PlaybackSpeed = playbackSpeed,
						AllowOverlap = true,
					})
				end
			end

			previousRotation = currentRotation
		end

		if self.spinTickThread == coroutine.running() then
			self.spinTickThread = nil
		end
	end)
end

function SpinWheelUI:getRotationForReward(rewardId: SpinWheelConfig.RewardId): number?
	local mainFrame = self.mainFrame
	local arrow = self.arrow
	local rewardFrame = self.rewardFrames[rewardId]
	if not mainFrame or not arrow or not rewardFrame then
		return nil
	end

	local wheelCenter = getCenter(mainFrame)
	local arrowAngle = getAngleBetween(wheelCenter, getCenter(arrow))
	local rewardAngle = getAngleBetween(wheelCenter, getCenter(rewardFrame))
	local requiredDelta = normalizePositiveAngle(arrowAngle - rewardAngle)
	local config = CoreConfig.spinWheel
	local fullTurns = if config and typeof(config.spinFullTurns) == "number"
		then math.max(1, math.floor(config.spinFullTurns))
		else 6
	return mainFrame.Rotation + (fullTurns * 360) + requiredDelta
end

function SpinWheelUI:correctRewardAlignment(rewardId: SpinWheelConfig.RewardId)
	local mainFrame = self.mainFrame
	local arrow = self.arrow
	local rewardFrame = self.rewardFrames[rewardId]
	if not mainFrame or not arrow or not rewardFrame then
		return
	end

	local wheelCenter = getCenter(mainFrame)
	local arrowAngle = getAngleBetween(wheelCenter, getCenter(arrow))
	local rewardAngle = getAngleBetween(wheelCenter, getCenter(rewardFrame))
	mainFrame.Rotation += normalizeSignedAngle(arrowAngle - rewardAngle)
end

function SpinWheelUI:showResult(result: { [string]: any })
	local rewardId = result.rewardId
	if typeof(rewardId) ~= "string" then
		return
	end
	local reward = SpinWheelConfig.GetReward(rewardId)
	if not reward then
		return
	end

	local theme = VisualFunctions.NotificationThemes.Gold

	local rewardTerms = {}
	local awardedSpeed = tonumber(result.awardedSpeed) or 0
	local awardedWins = tonumber(result.awardedWins) or 0
	local awardedRebirth = tonumber(result.awardedRebirth) or 0
	if awardedSpeed > 0 then
		table.insert(rewardTerms, "+" .. VisualFunctions.FormatNumber(awardedSpeed) .. " SPEED")
	end
	if awardedWins > 0 then
		table.insert(rewardTerms, "+" .. VisualFunctions.FormatNumber(awardedWins) .. " WINS")
	end
	if awardedRebirth > 0 then
		table.insert(rewardTerms, "+" .. tostring(awardedRebirth) .. " REBIRTH")
	end
	local rewardText = if #rewardTerms > 0
		then table.concat(rewardTerms, " ")
		else getRewardName(rewardId :: SpinWheelConfig.RewardId)

	SoundService.PlayGuiSound("WinReward")
	self:playRewardConfetti()
	VisualFunctions.ShowNotification("YOU WIN " .. rewardText .. "!", theme.textColor, theme.gradientBottomColor)
end

function SpinWheelUI:stopGrantThread()
	if self.grantThread then
		task.cancel(self.grantThread)
		self.grantThread = nil
	end
end

function SpinWheelUI:scheduleGrant(token: string)
	self:stopGrantThread()
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local grantRemote = remotes:FindFirstChild("SpinWheelGrant")
	if not grantRemote or not grantRemote:IsA("RemoteEvent") then
		DebugModule.debugWarn("SpinWheelGrant remote missing", MODULE_NAME)
		return
	end

	self.grantThread = task.delay(0.75, function()
		self.grantThread = nil
		if self.alive and self.pendingServerToken == token then
			grantRemote:FireServer(token)
		end
	end)
end

function SpinWheelUI:spin(result: { [string]: any })
	if self.activeTween or self.spinThread or self.spinTickThread then
		DebugModule.debugWarn("Ignoring duplicate spin start while a spin is active", MODULE_NAME)
		return
	end
	local rewardId = result.rewardId
	if typeof(rewardId) ~= "string" or not self.mainFrame then
		self.spinInFlight = false
		self:updateSpinButton()
		return
	end

	local typedRewardId = rewardId :: SpinWheelConfig.RewardId
	local startingRotation = self.mainFrame.Rotation
	local targetRotation = self:getRotationForReward(typedRewardId)
	if not targetRotation then
		self.spinInFlight = false
		self:updateSpinButton()
		return
	end

	self.spinToken += 1
	local token = self.spinToken
	self:stopIdleRotation()
	if self.spinTickThread then
		task.cancel(self.spinTickThread)
		self.spinTickThread = nil
	end
	local config = CoreConfig.spinWheel
	local duration = if config and typeof(config.spinRotationDuration) == "number"
		then math.max(0.5, config.spinRotationDuration)
		else 4
	local tween = TweenService:Create(
		self.mainFrame,
		TweenConfig.WithDuration(duration, TweenConfig.SpinWheelRotation),
		{ Rotation = targetRotation }
	)
	self.activeTween = tween

	self.spinThread = task.spawn(function()
		tween:Play()
		self:startSpinEffect(token, math.abs(targetRotation - startingRotation), duration)
		self:startSpinTickSound(tween, token)
		tween.Completed:Wait()
		if self.spinTickThread then
			task.cancel(self.spinTickThread)
			self.spinTickThread = nil
		end
		self:stopSpinEffect()
		if not self.alive or not self.isOpen or token ~= self.spinToken then
			return
		end
		RunService.RenderStepped:Wait()
		self:correctRewardAlignment(typedRewardId)
		local tickVolume = if config and typeof(config.wheelTickVolume) == "number"
			then math.max(0, config.wheelTickVolume)
			else 0.25
		SoundService.PlayGuiSound("Click", nil, {
			Volume = tickVolume,
			PlaybackSpeed = 1,
			AllowOverlap = true,
		})
		self.activeTween = nil
		self.spinThread = nil
		local serverToken = result.token
		if typeof(serverToken) ~= "string" then
			self.spinInFlight = false
			self:updateSpinButton()
			self:startIdleRotation()
			return
		end
		self.pendingServerToken = serverToken
		local remotes = ReplicatedStorage:WaitForChild("Remotes")
		local claimRemote = remotes:FindFirstChild("SpinWheelClaim")
		if claimRemote and claimRemote:IsA("RemoteEvent") then
			claimRemote:FireServer(serverToken)
		else
			DebugModule.debugWarn("SpinWheelClaim remote missing", MODULE_NAME)
			self.spinInFlight = false
			self:updateSpinButton()
			self:startIdleRotation()
		end
	end)
end

function SpinWheelUI:captureVisibility()
	table.clear(self.visibilitySnapshot)
	for _, child in ipairs(self.root:GetChildren()) do
		if child:IsA("GuiObject") then
			self.visibilitySnapshot[child] = {
				visible = child.Visible,
				interactable = child.Interactable,
			}

			if child ~= self.frame and not MODAL_PRESERVED_FRAME_NAMES[child.Name] then
				child.Visible = false
			end
		end
	end
end

function SpinWheelUI:restoreVisibility()
	for guiObject, state in pairs(self.visibilitySnapshot) do
		if guiObject.Parent then
			guiObject.Visible = state.visible
			guiObject.Interactable = state.interactable
		end
	end
	table.clear(self.visibilitySnapshot)
end

function SpinWheelUI:enableBlur()
	local existing = Lighting:FindFirstChild("SpinWheelBlur")
	if existing and existing:IsA("BlurEffect") then
		self.blurEffect = existing
		self.createdBlur = false
	else
		local blur = Instance.new("BlurEffect")
		blur.Name = "SpinWheelBlur"
		blur.Size = BLUR_SIZE
		blur.Enabled = true
		blur.Parent = Lighting
		self.blurEffect = blur
		self.createdBlur = true
	end
	if self.blurEffect then
		self.blurEffect.Size = BLUR_SIZE
		self.blurEffect.Enabled = true
	end
end

function SpinWheelUI:disableBlur()
	if self.blurEffect then
		if self.createdBlur then
			self.blurEffect:Destroy()
		else
			self.blurEffect.Enabled = false
		end
	end
	self.blurEffect = nil
	self.createdBlur = false
end

function SpinWheelUI:bindMovementInputLock()
	if self.movementInputBound then
		return
	end

	ContextActionService:BindActionAtPriority(MOVEMENT_LOCK_ACTION, function()
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value, table.unpack(MOVEMENT_LOCK_KEYS))
	self.movementInputBound = true
end

function SpinWheelUI:unbindMovementInputLock()
	if not self.movementInputBound then
		return
	end

	ContextActionService:UnbindAction(MOVEMENT_LOCK_ACTION)
	self.movementInputBound = false
end

function SpinWheelUI:unlockPlayerMovement()
	local humanoid = self.movementLockedHumanoid
	if humanoid and humanoid.Parent then
		local savedWalkSpeed = self.movementWalkSpeed
		local effectiveWalkSpeed = PlayerHandler.GetEffectiveWalkSpeed(self.player)
		humanoid.WalkSpeed = if typeof(savedWalkSpeed) == "number" and savedWalkSpeed > 0
			then savedWalkSpeed
			else math.max(effectiveWalkSpeed, 1)

		local savedJumpHeight = self.movementJumpHeight
		humanoid.JumpHeight = if typeof(savedJumpHeight) == "number" and savedJumpHeight > 0
			then savedJumpHeight
			else DEFAULT_JUMP_HEIGHT

	local savedJumpPower = self.movementJumpPower
		humanoid.JumpPower = if typeof(savedJumpPower) == "number" and savedJumpPower > 0
			then savedJumpPower
			else DEFAULT_JUMP_POWER

		local trollFrame = self.root:FindFirstChild("TrollFrame", true)
		local anotherMovementLockActive = trollFrame and trollFrame:IsA("GuiObject") and trollFrame.Visible
		local savedAutoRotate = self.movementAutoRotate
		humanoid.AutoRotate = if anotherMovementLockActive
			then false
			elseif typeof(savedAutoRotate) == "boolean"
			then savedAutoRotate
			else true
	end

	self.movementLockedHumanoid = nil
	self.movementWalkSpeed = nil
	self.movementJumpHeight = nil
	self.movementJumpPower = nil
	self.movementAutoRotate = nil
	self:unbindMovementInputLock()
end

function SpinWheelUI:resetModalState()
	self.isOpen = false
	self:setNotificationLayerForWheel(false)
	self.player:SetAttribute("SpinWheelModalOpen", false)
	self:unlockPlayerMovement()
	self:stopIdleRotation()
	self:stopCountdown()
	self:stopSpinTween()
	if self.frame then
		self.frame.Visible = false
		self.frame.Interactable = false
	end
	self:disableBlur()
	self:restoreVisibility()
	self:updateAvailabilityBadge()
end

function SpinWheelUI:lockPlayerMovement()
	self:bindMovementInputLock()

	local character = self.player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return
	end

	if self.movementLockedHumanoid ~= humanoid then
		self:unlockPlayerMovement()
		self:bindMovementInputLock()
		self.movementLockedHumanoid = humanoid
		self.movementWalkSpeed = humanoid.WalkSpeed
		self.movementJumpHeight = humanoid.JumpHeight
		self.movementJumpPower = humanoid.JumpPower
		self.movementAutoRotate = humanoid.AutoRotate
	end

	humanoid.WalkSpeed = 0
	humanoid.JumpHeight = 0
	humanoid.JumpPower = 0
	humanoid.AutoRotate = false
	humanoid:Move(Vector3.zero, true)
end

function SpinWheelUI:open()
	if self.isOpen or not self.frame then
		return
	end
	self:captureVisibility()
	self.isOpen = true
	self:setNotificationLayerForWheel(true)
	self.player:SetAttribute("SpinWheelModalOpen", true)
	self:lockPlayerMovement()
	self.frame.Visible = true
	self.frame.Interactable = true
	self:enableBlur()
	self:refreshRewardPreviews()
	self:updateSpinButton()
	self:startIdleRotation()
	self:startCountdown()
end

function SpinWheelUI:close()
	if not self.isOpen then
		return
	end
	if self.spinInFlight then
		return
	end
	self:resetModalState()
end

function SpinWheelUI:requestSpin(ignoreLocalAvailability: boolean?): boolean
	if self.spinInFlight or (not ignoreLocalAvailability and not self:hasSpinAvailable()) then
		return false
	end

	self:resetCompletedSpinState()
	self.spinInFlight = true
	self:updateSpinButton()

	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local remote = remotes:FindFirstChild("SpinWheelRequest")
	if not remote or not remote:IsA("RemoteEvent") then
		self.spinInFlight = false
		self:updateSpinButton()
		DebugModule.debugWarn("SpinWheelRequest remote missing", MODULE_NAME)
		return false
	end

	remote:FireServer()
	return true
end

function SpinWheelUI:bind()
	local frame = self.frame
	if frame then
		self.maid:GiveTask(frame:GetPropertyChangedSignal("Visible"):Connect(function()
			if self.isOpen and not frame.Visible then
				DebugModule.debugInfo("Spin wheel modal reset after external frame hide", MODULE_NAME)
				self:resetModalState()
			end
		end))
	end

	local spinWheelButtonFrame = self.spinWheelButtonFrame
	local spinWheelButton = findGuiButton(spinWheelButtonFrame)
	if spinWheelButton then
		self.maid:GiveTask(spinWheelButton.Activated:Connect(function()
			SoundService.PlayGuiSound("Click")
			self:open()
		end))
	end

	self:setupSpinWheelEffect()
	if self.spinLabel then
		local shineOverlay = self:setupSpinLabelGradient()
		VisualFunctions.SetupPulsate(self.spinLabel, 1.06)
		if shineOverlay then
			VisualFunctions.SetupPulsate(shineOverlay, 1.06)
		end
	end

	if self.exitButton then
		self.maid:GiveTask(self.exitButton.Activated:Connect(function()
			if self.spinInFlight then
				return
			end
			SoundService.PlayGuiSound("Close")
			self:close()
		end))
	end

	if self.spinButton then
		self.maid:GiveTask(self.spinButton.Activated:Connect(function()
			self:requestSpin()
		end))
	end

	if self.watchAdButtonFrame and self.watchAdButton then
		VisualFunctions.SetupFrameHover(self.watchAdButtonFrame, 1.05, 35, 1.2)
		VisualFunctions.SetupFrameClick(self.watchAdButtonFrame, 0.9, -15, 0.8)
		self.maid:GiveTask(self.watchAdButton.Activated:Connect(function()
			if self.rewardedAdInFlight then
				return
			end
			local remaining, nextAvailableUnix = self:getRewardedAdState()
			if remaining <= 0 or nextAvailableUnix > os.time() then
				self:updateWatchAdButton()
				return
			end
			SoundService.PlayGuiSound("Click")
			if RewardedVideoClient.Request("SpinWheel") then
				self.rewardedAdInFlight = true
				self:updateWatchAdButton()
			end
		end))
	end

	for _, pack in ipairs(SpinWheelConfig.PurchasePacks) do
		local packFrame = self.frame and self.frame:FindFirstChild(pack.buttonName, true)
		local buyButton = findGuiButton(packFrame and packFrame:FindFirstChild("BuyButton", true))
		if not packFrame then
			DebugModule.debugWarn("Purchase frame missing while binding: " .. pack.buttonName, MODULE_NAME)
		elseif not buyButton then
			DebugModule.debugWarn("BuyButton missing while binding: " .. pack.buttonName, MODULE_NAME)
		else
			self.maid:GiveTask(buyButton.Activated:Connect(function()
				local productId = tonumber(ProductService.DevProducts[pack.productKey])
				if productId and productId > 0 then
					SoundService.PlayGuiSound("Click")
					ProductService.promptProductPurchase(self.player, productId)
				else
					DebugModule.debugWarn("Cannot prompt missing product: " .. pack.productKey, MODULE_NAME)
				end
			end))
		end
	end

	self.maid:GiveTask(self.player:GetAttributeChangedSignal(SPINS_ATTRIBUTE):Connect(function()
		self:updateSpinButton()
	end))
	self.maid:GiveTask(self.player.CharacterAdded:Connect(function()
		if not self.alive or not self.isOpen then
			return
		end

		self:unlockPlayerMovement()
		task.defer(function()
			if self.alive and self.isOpen then
				self:lockPlayerMovement()
			end
		end)
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(NEXT_FREE_SPIN_ATTRIBUTE):Connect(function()
		self:updateSpinButton()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(REWARDED_AD_REMAINING_ATTRIBUTE):Connect(function()
		self.rewardedAdRemainingOverride = nil
		self:updateWatchAdButton()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(REWARDED_AD_NEXT_AVAILABLE_ATTRIBUTE):Connect(function()
		self.rewardedAdNextAvailableOverride = nil
		self:updateWatchAdButton()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(REWARDED_AD_RESET_ATTRIBUTE):Connect(function()
		self.rewardedAdResetOverride = nil
		self:updateWatchAdButton()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("SpinWheelOpenRequested"):Connect(function()
		self:open()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("MaxXPSpeed"):Connect(function()
		self:refreshRewardPreviews()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("WinCount"):Connect(function()
		self:refreshRewardPreviews()
	end))
	self.maid:GiveTask(
		RewardedVideoClient.ConnectResult(
			function(
				placementName: string,
				completed: boolean,
				_resultName: string,
				remainingUses: number?,
				nextAvailableUnix: number?,
				resetUnix: number?
			)
				if placementName ~= "SpinWheel" then
					return
				end
				if typeof(remainingUses) == "number" then
					self.rewardedAdRemainingOverride = remainingUses
				end
				if typeof(nextAvailableUnix) == "number" then
					self.rewardedAdNextAvailableOverride = nextAvailableUnix
				end
				if typeof(resetUnix) == "number" then
					self.rewardedAdResetOverride = resetUnix
				end
				if not completed then
					self.rewardedAdInFlight = false
					self.rewardedAdCooldownVisible = false
					self.rewardedAdRemainingOverride = nil
					self.rewardedAdNextAvailableOverride = nil
					self.rewardedAdResetOverride = nil
					DebugModule.debugInfo("Spin wheel rewarded ad did not complete", MODULE_NAME)
				end
				self:updateWatchAdButton()
			end
		)
	)

	local spinAdRewardedRemote = ReplicatedStorage:WaitForChild("Remotes"):FindFirstChild("SpinWheelAdRewarded")
	if spinAdRewardedRemote and spinAdRewardedRemote:IsA("RemoteEvent") then
		self.maid:GiveTask(
			spinAdRewardedRemote.OnClientEvent:Connect(
				function(spinCount: number?, remainingUses: number?, nextAvailableUnix: number?, resetUnix: number?)
					self.rewardedAdInFlight = false
					self.rewardedAdCooldownVisible = (
						typeof(nextAvailableUnix) == "number" and nextAvailableUnix > os.time()
					)
						or (
							typeof(remainingUses) == "number"
							and remainingUses <= 0
							and typeof(resetUnix) == "number"
							and resetUnix > os.time()
						)
					if typeof(remainingUses) == "number" then
						self.rewardedAdRemainingOverride = remainingUses
					end
					if typeof(nextAvailableUnix) == "number" then
						self.rewardedAdNextAvailableOverride = nextAvailableUnix
					end
					if typeof(resetUnix) == "number" then
						self.rewardedAdResetOverride = resetUnix
					end
					self:updateWatchAdButton()
					DebugModule.debugInfo(
						"Starting wheel spin after rewarded ad | spins=" .. tostring(spinCount),
						MODULE_NAME
					)
					if not self.isOpen then
						self:open()
					end
					self:requestSpin(true)
				end
			)
		)
	else
		DebugModule.debugWarn("SpinWheelAdRewarded remote missing", MODULE_NAME)
	end

	local resultRemote = ReplicatedStorage:WaitForChild("Remotes"):FindFirstChild("SpinWheelResult")
	if resultRemote and resultRemote:IsA("RemoteEvent") then
		self.maid:GiveTask(resultRemote.OnClientEvent:Connect(function(result: { [string]: any })
			local phase = result.phase
			if phase == "Started" and self.isOpen then
				self:spin(result)
			elseif phase == "RewardReady" and self.isOpen then
				local token = result.token
				if typeof(token) == "string" and token == self.pendingServerToken then
					self:showResult(result)
					self:scheduleGrant(token)
				end
			elseif phase == "Granted" then
				local token = result.token
				if typeof(token) == "string" and token == self.pendingServerToken then
					self:stopGrantThread()
					self:stopSpinEffect()
					self.pendingServerToken = nil
					self.spinInFlight = false
					self.activeTween = nil
					self.spinThread = nil
					self.spinTickThread = nil
					self:updateSpinButton()
					self:refreshRewardPreviews()
					if self.isOpen then
						self:startIdleRotation()
					end
				end
			elseif phase == "Error" then
				local token = result.token
				if typeof(token) ~= "string" or token ~= self.pendingServerToken then
					return
				end
				self:stopGrantThread()
				self:stopSpinEffect()
				self.pendingServerToken = nil
				self.spinInFlight = false
				self.activeTween = nil
				self.spinThread = nil
				self.spinTickThread = nil
				self:updateSpinButton()
				if self.isOpen then
					self:startIdleRotation()
				end
			end
		end))
	end

	self.maid:GiveTask(self.root.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			self:Destroy()
		end
	end))
	self.maid:GiveTask(self.root.Destroying:Connect(function()
		self:Destroy()
	end))
end

function SpinWheelUI:Init()
	if not self:findReferences() then
		return
	end
	self:bind()
	self:loadPrices()
	self:startAvailabilityWatcher()
	local remaining, nextAvailableUnix, resetUnix = self:getRewardedAdState()
	self.rewardedAdCooldownVisible = nextAvailableUnix > os.time() or (remaining <= 0 and resetUnix > os.time())
	self:updateSpinButton()
	self.frame.Visible = false
	self.frame.Interactable = false
end

function SpinWheelUI:Destroy()
	if not self.alive then
		return
	end
	self.alive = false
	self.isOpen = false
	self:setNotificationLayerForWheel(false)
	self.player:SetAttribute("SpinWheelModalOpen", false)
	self:unlockPlayerMovement()
	self:stopIdleRotation()
	self:stopCountdown()
	self:stopAvailabilityWatcher()
	self:stopSpinTween()
	self:stopGrantThread()
	if self.badge then
		self.badge:Destroy()
		self.badge = nil
	end
	if self.frame then
		self.frame.Visible = false
		self.frame.Interactable = false
	end
	self:disableBlur()
	self:restoreVisibility()
	self.maid:DoCleaning()
end

return SpinWheelUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3563">
            <Properties>
              <string name="Name">StageProgressBindings</string>
              <string name="Source"><![CDATA[local StageProgressBindings = {}

type BindOptions = {
	sessionMaid: any,
	playersService: Players,
	workspace: Workspace,
	player: Player,
	connectTrackedPlayer: (Player) -> (),
	disconnectTrackedPlayer: (Player) -> (),
	updateStageProgressPlayerMarkers: () -> (),
	tryRefreshStageProgress: () -> (),
}

function StageProgressBindings.Bind(options: BindOptions)
	for _, trackedPlayer in ipairs(options.playersService:GetPlayers()) do
		options.connectTrackedPlayer(trackedPlayer)
	end

	options.sessionMaid:GiveTask(options.playersService.PlayerAdded:Connect(function(addedPlayer)
		options.connectTrackedPlayer(addedPlayer)
		task.defer(options.updateStageProgressPlayerMarkers)
	end))

	options.sessionMaid:GiveTask(options.playersService.PlayerRemoving:Connect(function(removingPlayer)
		options.disconnectTrackedPlayer(removingPlayer)
		task.defer(options.updateStageProgressPlayerMarkers)
	end))

	options.sessionMaid:GiveTask(options.workspace.DescendantAdded:Connect(function(descendant)
		local currentWorld = options.player:GetAttribute("Current_World")
		if typeof(currentWorld) ~= "string" or currentWorld == "" then
			return
		end

		local worldsFolder = options.workspace:FindFirstChild("Worlds")
		local world = worldsFolder and worldsFolder:FindFirstChild(currentWorld)
		if not world or not descendant:IsDescendantOf(world) then
			return
		end

		if descendant.Name == "LobbyRegion" or descendant.Name == "StageEnd" or descendant.Name == "InvisEnd" then
			task.defer(options.tryRefreshStageProgress)
			return
		end

		local stageAncestor = descendant:FindFirstAncestor("Stages")
		if stageAncestor == world:FindFirstChild("Stages") then
			task.defer(options.tryRefreshStageProgress)
		end
	end))
end

return StageProgressBindings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3564">
            <Properties>
              <string name="Name">TemporaryBoostUI</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)
local ProductService = require(ReplicatedStorage.Modules.Shared:WaitForChild("ProductService_Client"))
local SoundService = require(ReplicatedStorage.Modules.SoundService)
local TweenConfig = require(ReplicatedStorage.Modules.UI.TweenConfig)

local TemporaryBoostUI = {}
TemporaryBoostUI.__index = TemporaryBoostUI

type ColorTarget = {
	instance: Instance,
	property: string,
}

type BoostBinding = {
	frame: GuiObject,
	promptButton: GuiButton,
	image: GuiObject?,
	statusLabel: TextLabel,
	timerLabel: TextLabel,
	endAttributeName: string,
	productId: number,
	originalSize: UDim2,
	hoverSize: UDim2,
	clickSize: UDim2,
	originalRotation: number,
	isHovering: boolean,
	isPressed: boolean,
	sizeTween: Tween?,
	rotationTween: Tween?,
	colorTargets: { ColorTarget },
	colorTweens: { Tween },
	pressedColors: { [Instance]: { [string]: Color3 } },
}

type TemporaryBoostUIObject = {
	screenGui: ScreenGui,
	player: Player,
	maid: any,
	bindings: { BoostBinding },
	updateThread: thread?,
	alive: boolean,
	initialized: boolean,
	promptCooldownUntil: number,
}

local MODULE_NAME = "TemporaryBoostUI"
local ACTIVE_COLOR = Color3.fromRGB(255, 255, 255)
local INACTIVE_COLOR = Color3.fromRGB(0, 255, 0)

local function scaledSize(size: UDim2, multiplier: number): UDim2
	return UDim2.new(
		size.X.Scale * multiplier,
		size.X.Offset * multiplier,
		size.Y.Scale * multiplier,
		size.Y.Offset * multiplier
	)
end

local function darkenColor(color: Color3, multiplier: number): Color3
	return Color3.new(
		math.clamp(color.R * multiplier, 0, 1),
		math.clamp(color.G * multiplier, 0, 1),
		math.clamp(color.B * multiplier, 0, 1)
	)
end

local function getColorTargets(root: GuiObject, excluded: { [Instance]: boolean }): { ColorTarget }
	local targets: { ColorTarget } = {}

	local function addTarget(instance: Instance, property: string)
		if excluded[instance] then
			return
		end
		table.insert(targets, {
			instance = instance,
			property = property,
		})
	end

	local function inspect(instance: Instance)
		if instance:IsA("Frame") or instance:IsA("ScrollingFrame") then
			addTarget(instance, "BackgroundColor3")
		elseif instance:IsA("TextLabel") then
			addTarget(instance, "TextColor3")
			addTarget(instance, "BackgroundColor3")
		elseif instance:IsA("TextButton") or instance:IsA("TextBox") then
			addTarget(instance, "BackgroundColor3")
			addTarget(instance, "TextColor3")
		elseif instance:IsA("ImageLabel") then
			addTarget(instance, "ImageColor3")
			addTarget(instance, "BackgroundColor3")
		elseif instance:IsA("ImageButton") then
			addTarget(instance, "BackgroundColor3")
			addTarget(instance, "ImageColor3")
		elseif instance:IsA("UIStroke") then
			addTarget(instance, "Color")
		end
	end

	inspect(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		inspect(descendant)
	end

	return targets
end

local function formatRemaining(seconds: number): string
	local totalSeconds = math.max(0, math.ceil(seconds))
	if totalSeconds >= 60 * 60 then
		local hours = math.floor(totalSeconds / (60 * 60))
		local minutes = math.floor((totalSeconds % (60 * 60)) / 60)
		local remainingSeconds = totalSeconds % 60
		return string.format("%02d:%02d:%02d", hours, minutes, remainingSeconds)
	end

	local minutes = math.floor(totalSeconds / 60)
	local remainingSeconds = totalSeconds % 60
	return string.format("%02d:%02d", minutes, remainingSeconds)
end

local function getRemainingSeconds(player: Player, endAttributeName: string): number
	local endValue = player:GetAttribute(endAttributeName)
	if typeof(endValue) ~= "number" then
		return 0
	end

	return math.max(0, endValue - os.time())
end

function TemporaryBoostUI.new(screenGui: ScreenGui): TemporaryBoostUIObject
	local player = assert(Players.LocalPlayer, "TemporaryBoostUI requires a local player")

	return setmetatable({
		screenGui = screenGui,
		player = player,
		maid = Maid.new(),
		bindings = {},
		updateThread = nil,
		alive = true,
		initialized = false,
		promptCooldownUntil = 0,
	}, TemporaryBoostUI)
end

function TemporaryBoostUI:refreshBinding(binding: BoostBinding)
	local remainingSeconds = getRemainingSeconds(self.player, binding.endAttributeName)
	local isActive = remainingSeconds > 0
	local statusColor = if isActive then ACTIVE_COLOR else INACTIVE_COLOR

	binding.timerLabel.Text = formatRemaining(remainingSeconds)
	binding.statusLabel.Text = if isActive then "2x" else "+"
	binding.statusLabel.TextColor3 = if binding.isPressed then darkenColor(statusColor, 0.75) else statusColor

	if binding.isPressed then
		local pressedStatusColors = binding.pressedColors[binding.statusLabel]
		if pressedStatusColors then
			pressedStatusColors.TextColor3 = statusColor
		end
	end
end

function TemporaryBoostUI:refresh()
	if not self.alive then
		return
	end

	for _, binding in ipairs(self.bindings) do
		self:refreshBinding(binding)
	end
end

function TemporaryBoostUI:createBinding(
	speedMultiFrame: GuiObject,
	frameName: string,
	endAttributeName: string,
	productId: number
): BoostBinding?
	local frame = speedMultiFrame:FindFirstChild(frameName)
	local promptButton = frame and frame:FindFirstChild("PromptButton")
	local image = frame and (frame:FindFirstChild("RotateImage") or frame:FindFirstChild("Image"))
	local statusLabel = frame and frame:FindFirstChild("TextLabel")
	local timerLabel = frame and frame:FindFirstChild("TimerLabel")

	if not frame or not frame:IsA("GuiObject") then
		DebugModule.debugWarn("Missing boost frame: " .. frameName, MODULE_NAME)
		return nil
	end
	if not promptButton or not promptButton:IsA("GuiButton") then
		DebugModule.debugWarn("Missing boost PromptButton: " .. frameName, MODULE_NAME)
		return nil
	end
	if not statusLabel or not statusLabel:IsA("TextLabel") then
		DebugModule.debugWarn("Missing boost TextLabel: " .. frameName, MODULE_NAME)
		return nil
	end
	if not timerLabel or not timerLabel:IsA("TextLabel") then
		DebugModule.debugWarn("Missing boost TimerLabel: " .. frameName, MODULE_NAME)
		return nil
	end
	if image and not image:IsA("GuiObject") then
		image = nil
	end

	local binding: BoostBinding = {
		frame = frame,
		promptButton = promptButton,
		image = image :: GuiObject?,
		statusLabel = statusLabel,
		timerLabel = timerLabel,
		endAttributeName = endAttributeName,
		productId = productId,
		originalSize = frame.Size,
		hoverSize = scaledSize(frame.Size, 1.1),
		clickSize = scaledSize(frame.Size, 0.95),
		originalRotation = if image then image.Rotation else 0,
		isHovering = false,
		isPressed = false,
		sizeTween = nil,
		rotationTween = nil,
		colorTargets = getColorTargets(frame, {}),
		colorTweens = {},
		pressedColors = {},
	}

	frame.Active = true
	promptButton.Active = true

	local function tweenVisuals(size: UDim2, rotation: number, tweenInfo: TweenInfo)
		if binding.sizeTween then
			binding.sizeTween:Cancel()
		end
		binding.sizeTween = TweenService:Create(frame, tweenInfo, { Size = size })
		binding.sizeTween:Play()

		if binding.image then
			if binding.rotationTween then
				binding.rotationTween:Cancel()
			end
			binding.rotationTween = TweenService:Create(binding.image, tweenInfo, { Rotation = rotation })
			binding.rotationTween:Play()
		end
	end

	local function cancelColorTweens()
		for _, tween in ipairs(binding.colorTweens) do
			tween:Cancel()
		end
		table.clear(binding.colorTweens)
	end

	local function darkenPressedColors()
		cancelColorTweens()
		table.clear(binding.pressedColors)

		for _, target in ipairs(binding.colorTargets) do
			local instance = target.instance
			local instanceAny = instance :: any
			local currentColor = instanceAny[target.property] :: Color3
			local colors = binding.pressedColors[instance]
			if not colors then
				colors = {}
				binding.pressedColors[instance] = colors
			end
			colors[target.property] = currentColor

			local tween = TweenService:Create(instance, TweenConfig.Click, {
				[target.property] = darkenColor(currentColor, 0.75),
			})
			table.insert(binding.colorTweens, tween)
			tween:Play()
		end
	end

	local function restorePressedColors()
		cancelColorTweens()

		for instance, colors in pairs(binding.pressedColors) do
			local tween = TweenService:Create(instance, TweenConfig.Click, colors)
			table.insert(binding.colorTweens, tween)
			tween:Play()
		end
		table.clear(binding.pressedColors)
	end

	local function showHover()
		if binding.isHovering then
			return
		end
		binding.isHovering = true
		SoundService.PlayGuiSound("Hover")
		tweenVisuals(binding.hoverSize, binding.originalRotation + 15, TweenConfig.Hover)
	end

	local function showPressed()
		if binding.isPressed then
			return
		end
		binding.isPressed = true
		SoundService.PlayGuiSound("Click")
		darkenPressedColors()
		tweenVisuals(binding.clickSize, binding.originalRotation - 15, TweenConfig.Click)
	end

	local function restoreVisuals()
		binding.isPressed = false
		binding.isHovering = false
		restorePressedColors()
		tweenVisuals(binding.originalSize, binding.originalRotation, TweenConfig.Hover)
	end

	self.maid:GiveTask(promptButton.MouseEnter:Connect(showHover))
	self.maid:GiveTask(promptButton.MouseLeave:Connect(restoreVisuals))
	self.maid:GiveTask(promptButton.MouseButton1Down:Connect(showPressed))
	self.maid:GiveTask(promptButton.MouseButton1Up:Connect(function()
		binding.isPressed = false
		restorePressedColors()
		if binding.isHovering then
			tweenVisuals(binding.hoverSize, binding.originalRotation + 15, TweenConfig.Hover)
		else
			restoreVisuals()
		end
	end))

	self.maid:GiveTask(promptButton.InputBegan:Connect(function(input: InputObject)
		local inputName = input.UserInputType.Name
		if input.UserInputType == Enum.UserInputType.Touch or string.find(inputName, "Gamepad") then
			showPressed()
		end
	end))
	self.maid:GiveTask(promptButton.InputEnded:Connect(function(input: InputObject)
		local inputName = input.UserInputType.Name
		if input.UserInputType == Enum.UserInputType.Touch or string.find(inputName, "Gamepad") then
			if binding.isHovering then
				binding.isPressed = false
				restorePressedColors()
				tweenVisuals(binding.hoverSize, binding.originalRotation + 15, TweenConfig.Hover)
			else
				restoreVisuals()
			end
		end
	end))

	self.maid:GiveTask(promptButton.Activated:Connect(function()
		local now = os.clock()
		if now < self.promptCooldownUntil then
			return
		end
		self.promptCooldownUntil = now + 0.5
		ProductService.promptProductPurchase(self.player, binding.productId)
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(endAttributeName):Connect(function()
		self:refreshBinding(binding)
	end))

	return binding
end

function TemporaryBoostUI:Init()
	if self.initialized then
		return
	end
	self.initialized = true

	local speedMultiFrame = self.screenGui:FindFirstChild("SpeedMultiFrame", true)
	if not speedMultiFrame or not speedMultiFrame:IsA("GuiObject") then
		DebugModule.debugWarn("SpeedMultiFrame was not found", MODULE_NAME)
		return
	end

	local speedBinding = self:createBinding(
		speedMultiFrame,
		"TempSpeedBoostBuyFrame",
		"TemporarySpeedBoostEndUnix",
		ProductService.DevProducts.TempSpeedBoost
	)
	if speedBinding then
		table.insert(self.bindings, speedBinding)
	end

	local winBinding = self:createBinding(
		speedMultiFrame,
		"TempWinBoostBuyFrame",
		"TemporaryWinBoostEndUnix",
		ProductService.DevProducts.TempWinBoost
	)
	if winBinding then
		table.insert(self.bindings, winBinding)
	end

	self:refresh()
	self.updateThread = task.spawn(function()
		while self.alive and self.screenGui.Parent do
			self:refresh()
			task.wait(1)
		end
	end)
end

function TemporaryBoostUI:Destroy()
	if not self.alive then
		return
	end

	self.alive = false
	for _, binding in ipairs(self.bindings) do
		if binding.sizeTween then
			binding.sizeTween:Cancel()
		end
		if binding.rotationTween then
			binding.rotationTween:Cancel()
		end
		for _, tween in ipairs(binding.colorTweens) do
			tween:Cancel()
		end
		table.clear(binding.colorTweens)
		table.clear(binding.pressedColors)
	end
	if self.updateThread and coroutine.status(self.updateThread) ~= "dead" then
		pcall(task.cancel, self.updateThread)
	end
	self.updateThread = nil
	self.maid:DoCleaning()
	table.clear(self.bindings)
end

return TemporaryBoostUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3565">
            <Properties>
              <string name="Name">TrailDisplayController</string>
              <string name="Source"><![CDATA[local TrailDisplayController = {}

export type RefreshCallback = () -> ()

function TrailDisplayController.CreateOwnedTrailsRefreshHandler(
	updateTrailShop: RefreshCallback,
	refreshAffordableTrailBadge: RefreshCallback
): RefreshCallback
	return function()
		updateTrailShop()
		refreshAffordableTrailBadge()
	end
end

return TrailDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3566">
            <Properties>
              <string name="Name">TrailShopController</string>
              <string name="Source"><![CDATA[--!strict

local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Maid = require(ReplicatedStorage.Modules:WaitForChild("Maid"))
local VisualFunctions = require(ReplicatedStorage.Modules.UI:WaitForChild("VisualFunctions"))
local SoundService = require(ReplicatedStorage.Modules:WaitForChild("SoundService"))
local PlayerHandler = require(ReplicatedStorage.Modules.Shared:WaitForChild("PlayerHandler_Client"))
local ProductService = require(ReplicatedStorage.Modules.Shared:WaitForChild("ProductService_Client"))
local SpinWheelConfig = require(ReplicatedStorage.Modules.Config:WaitForChild("SpinWheelConfig"))

local TrailShopController = {}

type TrailConfig = { [string]: any }

type TrailEntry = {
	frame: Frame,
	buyButton: Frame?,
	robuxBuyButton: Frame?,
	equipButton: Frame?,
	robuxOriginalPosition: UDim2?,
	robuxOriginalSize: UDim2?,
}

type Options = {
	player: Player,
	openSpinWheelFromShop: (player: Player) -> (),
	applyWheelStyle: (frame: Frame) -> (),
	applyEquipStyle: (frame: Frame) -> (),
	canBuyEventProduct: (config: TrailConfig, isOwned: boolean) -> boolean,
	formatTrailMultiplier: (multiplier: number) -> string,
	getOrCreateEquipButton: (entryFrame: Frame) -> Frame?,
}

type Controller = {
	Build: (self: Controller) -> (),
	Update: (self: Controller) -> (),
	Destroy: (self: Controller) -> (),
}

local WHEEL_BACKGROUND_COLOR = Color3.fromRGB(254, 199, 41)
local WHEEL_GRADIENT_BOTTOM_COLOR = Color3.fromRGB(255, 85, 0)

function TrailShopController.new(options: Options): Controller
	local player = options.player
	local shopMaid = Maid.new()
	local entryFrames: { [string]: TrailEntry } = {}
	local productCache: { [number]: any } = {}
	local destroyed = false
	local controller: Controller = {} :: Controller

	local function spawnShopTask(callback: () -> ())
		local thread = task.spawn(function()
			if destroyed then
				return
			end
			callback()
		end)
		shopMaid:GiveTask(thread)
		return thread
	end

	local function updateTrailEntryPrice(trailName: string, config: TrailConfig)
		local entry = entryFrames[trailName]
		if not entry or not entry.robuxBuyButton then
			return
		end
		if config.RewardSource == "SpinWheel" or config.EventOnly == true then
			entry.robuxBuyButton.Visible = false
			return
		end

		local priceLabel = entry.robuxBuyButton:FindFirstChild("PriceLabel", true)
		local trailTypeImage = entry.frame:FindFirstChild("TrailType", true)
		local productKey = config.ProductKey
		local productId = if typeof(productKey) == "string" then ProductService.DevProducts[productKey] else nil
		if typeof(productId) ~= "number" then
			if priceLabel and priceLabel:IsA("TextLabel") then
				priceLabel.Text = "---"
			end
			return
		end

		spawnShopTask(function()
			local info = productCache[productId]
			if not info then
				local success, result = pcall(function()
					return MarketplaceService:GetProductInfo(productId, Enum.InfoType.Product)
				end)
				if success then
					info = result
					productCache[productId] = result
				end
			end

			if info and not destroyed then
				if priceLabel and priceLabel:IsA("TextLabel") and priceLabel.Parent then
					priceLabel.Text = tostring(info.PriceInRobux or 0)
				end

				if trailTypeImage and trailTypeImage:IsA("ImageLabel") and trailTypeImage.Parent then
					local iconId = tonumber(info.IconImageAssetId)
					if iconId and iconId > 0 then
						trailTypeImage.Image = "rbxassetid://" .. tostring(iconId)
					end
				end
			end
		end)
	end

	local function updateTrailShop()
		for trailName, entry in pairs(entryFrames) do
			local config = PlayerHandler.GetTrailConfig(trailName)
			if not config then
				continue
			end

			local isOwned = PlayerHandler.OwnsTrail(player, trailName)
			local isEquipped = player:GetAttribute("Trail_Equipped") == trailName
			local currentWins = player:GetAttribute("WinCount") or 0
			local isWheelOnly = config.RewardSource == "SpinWheel"
			local isEventLocked = config.EventOnly == true and not isOwned

			entry.frame.BackgroundColor3 = if isWheelOnly then WHEEL_BACKGROUND_COLOR else config.BackgroundColor
			local frameGradient = entry.frame:FindFirstChildOfClass("UIGradient")
			if not frameGradient then
				frameGradient = Instance.new("UIGradient")
				frameGradient.Parent = entry.frame
			end
			frameGradient.Rotation = 90
			frameGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(
					1,
					if isWheelOnly then WHEEL_GRADIENT_BOTTOM_COLOR else config.GradientBottomColor
				),
			})
			VisualFunctions.RefreshFrameInteractionColors(entry.frame)

			local trailImage = entry.frame:FindFirstChild("Image", true)
			if
				trailImage
				and (trailImage:IsA("ImageLabel") or trailImage:IsA("ImageButton"))
				and typeof(config.ImageAssetId) == "string"
			then
				trailImage.Image = config.ImageAssetId
			end

			local trailNameLabel = entry.frame:FindFirstChild("TrailName", true)
			if trailNameLabel and trailNameLabel:IsA("TextLabel") then
				trailNameLabel.Text = string.upper(config.DisplayName)
			end

			local speedAmountLabel = entry.frame:FindFirstChild("SpeedAmount", true)
			if speedAmountLabel and speedAmountLabel:IsA("TextLabel") then
				speedAmountLabel.Text = string.format("%sx Speed Boost", options.formatTrailMultiplier(config.XPMultiplier))
			end

			local trailTypeLabel = entry.frame:FindFirstChild("TrailType", true)
			if trailTypeLabel and trailTypeLabel:IsA("TextLabel") then
				trailTypeLabel.Text = if isEventLocked
					then "EVENT"
					else if isWheelOnly and not isOwned
						then "SPIN"
						else if config.CanBuyWithWins then "WINS / ROBUX" else "ROBUX ONLY"
			elseif
				trailTypeLabel
				and (trailTypeLabel:IsA("ImageLabel") or trailTypeLabel:IsA("ImageButton"))
				and (isWheelOnly or config.EventOnly == true)
			then
				if isWheelOnly then
					local wheelReward = SpinWheelConfig.GetReward("FlameTrail")
					if wheelReward then
						trailTypeLabel.Image = wheelReward.imageAssetId
					end
				elseif config.EventOnly == true and typeof(config.ImageAssetId) == "string" then
					trailTypeLabel.Image = config.ImageAssetId
				end
			end

			local buyTextButton = entry.buyButton and entry.buyButton:FindFirstChild("TextButton", true)
			if buyTextButton and buyTextButton:IsA("TextButton") then
				buyTextButton.Text = string
					.format("%d", math.round(config.WinsRequired))
					:reverse()
					:gsub("(%d%d%d)", "%1,")
					:reverse()
					:gsub("^,", "")
			end

			local equipTextButton = entry.equipButton and entry.equipButton:FindFirstChild("TextButton", true)
			if equipTextButton and equipTextButton:IsA("TextButton") then
				equipTextButton.Text = if isEventLocked
					then "EVENT"
					else if isWheelOnly and not isOwned
						then "SPIN"
						else if isEquipped then "UNEQUIP" else "EQUIP"
			end

			if entry.buyButton then
				entry.buyButton.Visible = not isWheelOnly and not isOwned and config.CanBuyWithWins
				VisualFunctions.SetFrameInteractableState(
					entry.buyButton,
					not isWheelOnly and currentWins >= config.WinsRequired
				)
			end

			if entry.robuxBuyButton then
				entry.robuxBuyButton.Visible = not isWheelOnly and config.EventOnly ~= true and not isOwned
				if not config.CanBuyWithWins then
					if entry.buyButton then
						entry.robuxBuyButton.Position = entry.buyButton.Position
						entry.robuxBuyButton.Size = entry.buyButton.Size
					end
				else
					if entry.robuxOriginalPosition then
						entry.robuxBuyButton.Position = entry.robuxOriginalPosition
					end
					if entry.robuxOriginalSize then
						entry.robuxBuyButton.Size = entry.robuxOriginalSize
					end
				end
			end

			if entry.equipButton then
				local eventProductAvailable = options.canBuyEventProduct(config, isOwned)
				entry.equipButton.Visible = isWheelOnly
					or config.EventOnly == true
					or isOwned
					or eventProductAvailable
				VisualFunctions.SetFrameInteractableState(
					entry.equipButton,
					if isEventLocked then false elseif isWheelOnly and not isOwned then true else isOwned
				)
				if isEventLocked then
					options.applyEquipStyle(entry.equipButton)
					entry.equipButton.BackgroundColor3 = config.BackgroundColor
					local eventGradient = entry.equipButton:FindFirstChildOfClass("UIGradient")
					if eventGradient then
						eventGradient.Rotation = 90
						eventGradient.Color = ColorSequence.new({
							ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
							ColorSequenceKeypoint.new(1, config.GradientBottomColor),
						})
					end
					VisualFunctions.RefreshFrameInteractionColors(entry.equipButton)
				elseif isWheelOnly and not isOwned then
					options.applyWheelStyle(entry.equipButton)
				else
					options.applyEquipStyle(entry.equipButton)
				end
			end

			updateTrailEntryPrice(trailName, config)
		end
	end

	function controller:Build()
		shopMaid:DoCleaning()
		local trailFrame = VisualFunctions.ActiveFrameGroup.TrailFrame
		local scrollBackground = trailFrame and trailFrame:FindFirstChild("ScrollBackground")
		local scrollingFrame = scrollBackground and scrollBackground:FindFirstChild("ScrollingFrame")
		if not scrollingFrame or not scrollingFrame:IsA("ScrollingFrame") then
			return
		end

		local template = scrollingFrame:FindFirstChild("SpeedTrailTemplate")
		if not template or not template:IsA("Frame") then
			return
		end

		for _, child in ipairs(scrollingFrame:GetChildren()) do
			if child ~= template and child:IsA("Frame") then
				child:Destroy()
			end
		end
		table.clear(entryFrames)
		template.Visible = false

		for index, trailName in ipairs(PlayerHandler.TRAIL_ORDER) do
			local config = PlayerHandler.GetTrailConfig(trailName)
			if not config then
				continue
			end

			local clone = template:Clone()
			clone.Name = trailName .. "Template"
			clone.LayoutOrder = index
			clone.Visible = true
			clone.Parent = scrollingFrame

			local buyButton = clone:FindFirstChild("BuyButton")
			local robuxBuyButton = clone:FindFirstChild("RobuxBuyButton")
			local equipButton = options.getOrCreateEquipButton(clone)

			if buyButton and buyButton:IsA("Frame") then
				local textButton = buyButton:FindFirstChild("TextButton", true)
				if textButton and textButton:IsA("TextButton") then
					shopMaid:GiveTask(textButton.Activated:Connect(function()
						SoundService.PlayGuiSound("Click")
						if config.EventOnly == true and not PlayerHandler.OwnsTrail(player, trailName) then
							return
						end
						if config.RewardSource == "SpinWheel" and not PlayerHandler.OwnsTrail(player, trailName) then
							options.openSpinWheelFromShop(player)
							return
						end
						local trailRemote = ReplicatedStorage:WaitForChild("Remotes"):FindFirstChild("TrailAction")
						if trailRemote and trailRemote:IsA("RemoteEvent") then
							trailRemote:FireServer("BuyWithWins", trailName)
						end
					end))
				end
			end

			if robuxBuyButton and robuxBuyButton:IsA("Frame") then
				local textButton = robuxBuyButton:FindFirstChild("TextButton", true)
				if textButton and textButton:IsA("TextButton") then
					shopMaid:GiveTask(textButton.Activated:Connect(function()
						SoundService.PlayGuiSound("Click")
						local productKey = config.ProductKey
						local productId = if typeof(productKey) == "string" then ProductService.DevProducts[productKey] else nil
						if typeof(productId) == "number" and productId ~= 0 then
							ProductService.promptProductPurchase(player, productId)
						end
					end))
				end
			end

			if equipButton then
				local textButton = equipButton:FindFirstChild("TextButton", true)
				if textButton and textButton:IsA("TextButton") then
					shopMaid:GiveTask(textButton.Activated:Connect(function()
						SoundService.PlayGuiSound("Click")
						if config.EventOnly == true and not PlayerHandler.OwnsTrail(player, trailName) then
							return
						end
						if config.RewardSource == "SpinWheel" and not PlayerHandler.OwnsTrail(player, trailName) then
							options.openSpinWheelFromShop(player)
							return
						end
						local trailRemote = ReplicatedStorage:WaitForChild("Remotes"):FindFirstChild("TrailAction")
						if trailRemote and trailRemote:IsA("RemoteEvent") then
							trailRemote:FireServer("Equip", trailName)
						end
					end))
				end
			end

			entryFrames[trailName] = {
				frame = clone,
				buyButton = if buyButton and buyButton:IsA("Frame") then buyButton else nil,
				robuxBuyButton = if robuxBuyButton and robuxBuyButton:IsA("Frame") then robuxBuyButton else nil,
				equipButton = equipButton,
				robuxOriginalPosition = if robuxBuyButton and robuxBuyButton:IsA("Frame")
					then robuxBuyButton.Position
					else nil,
				robuxOriginalSize = if robuxBuyButton and robuxBuyButton:IsA("Frame")
					then robuxBuyButton.Size
					else nil,
			}
		end

		updateTrailShop()
	end

	function controller:Update()
		updateTrailShop()
	end

	function controller:Destroy()
		destroyed = true
		shopMaid:DoCleaning()
		table.clear(entryFrames)
		table.clear(productCache)
	end

	return controller
end

return TrailShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3567">
            <Properties>
              <string name="Name">TutorialNotificationSystem</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")
local Modules = ReplicatedStorage:WaitForChild("Modules")
local PlayerHandler = require(Modules:WaitForChild("Shared"):WaitForChild("PlayerHandler_Client"))
local FramerateManager = require(Modules:WaitForChild("FramerateManager"))
local NotificationLayoutController = require(Modules.UI.MainGUI.NotificationLayoutController)

local TutorialNotificationSystem = {}
TutorialNotificationSystem.__index = TutorialNotificationSystem

local TUTORIAL_LEVEL_TARGET = 3
local TUTORIAL_BEAM_UPDATE_INTERVAL = 0.1
local TUTORIAL_BEAM_TEMPLATE = script:FindFirstChild("Beam")
local TUTORIAL_SEEN_ATTRIBUTE = "TutorialSeen"
local TUTORIAL_COMPLETED_ATTRIBUTE = "TutorialCompleted"
local TUTORIAL_PROGRESS_SEEN = "Seen"
local TUTORIAL_PROGRESS_COMPLETED = "Completed"
local TUTORIAL_MESSAGE_STEP_1 = "GET TO LEVEL 3!"
local TUTORIAL_MESSAGE_STEP_2 = "DRIVE HERE!"
local TUTORIAL_FINAL_MESSAGE = "TUTORIAL COMPLETE! NOW ESCAPE THE TSUNAMI!"
local TUTORIAL_WIN_BUTTON_STAGE = 1
local TUTORIAL_HIGHLIGHT_COLOR = Color3.fromRGB(255, 255, 255)
local TUTORIAL_HIGHLIGHT_FILL_TRANSPARENCY = 0.75
local TUTORIAL_HIGHLIGHT_OUTLINE_TRANSPARENCY = 0

type ControllerOptions = {
	player: Player,
	sessionMaid: any,
	visualFunctions: any,
	soundService: any,
	debugModule: any,
	tweenGuiFadeIn: (GuiObject, number) -> (),
	tweenGuiFadeOut: (GuiObject, number) -> (),
	spawnSessionTask: (() -> ()) -> thread,
	isCleanedUp: () -> boolean,
	getNumericAttribute: (Instance?, string) -> number?,
	playRewardCelebration: () -> (),
	onTutorialUnlocked: (() -> ())?,
}

function TutorialNotificationSystem.new(options: ControllerOptions)
	local self = setmetatable({}, TutorialNotificationSystem)

	self.player = options.player
	self.sessionMaid = options.sessionMaid
	self.visualFunctions = options.visualFunctions
	self.soundService = options.soundService
	self.debugModule = options.debugModule
	self.tweenGuiFadeIn = options.tweenGuiFadeIn
	self.tweenGuiFadeOut = options.tweenGuiFadeOut
	self.spawnSessionTask = options.spawnSessionTask
	self.isCleanedUp = options.isCleanedUp
	self.getNumericAttribute = options.getNumericAttribute
	self.playRewardCelebration = options.playRewardCelebration
	self.onTutorialUnlocked = options.onTutorialUnlocked

	local tutorialCompleted = self.player:GetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE) == true
	local tutorialSeen = self.player:GetAttribute(TUTORIAL_SEEN_ATTRIBUTE) == true
	self.tutorialStep = 1
	-- Resume tutorial across rejoins until fully completed.
	self.tutorialActive = false
	self.tutorialHasUsedTreadmill = self.player:GetAttribute("Treadmill_Active") == true
	self.tutorialLastMessageKey = nil
	self.tutorialFinalizing = false
	self.tutorialNotificationLock = false
	self.tutorialCompletionThread = nil
	self.tutorialStarted = false
	self.tutorialSeenSent = tutorialSeen
	self.tutorialCompletedSent = tutorialCompleted

	self.notificationFrame = nil :: Frame?
	self.notificationLabel = nil :: TextLabel?
	self.tutorialLabel = nil :: TextLabel?
	self.skipButtonFrame = nil :: GuiObject?
	self.skipButton = nil :: GuiButton?
	self.boundSkipButton = nil :: GuiButton?

	self.tutorialBeam = nil :: Beam?
	self.tutorialBeamAttachment0 = nil :: Attachment?
	self.tutorialBeamAttachment1 = nil :: Attachment?
	self.tutorialCurrentTargetPart = nil :: BasePart?
	self.tutorialHighlight = nil :: Highlight?
	self.tutorialHighlightAdornee = nil :: Instance?
	self.tutorialBeamUpdateAccumulator = 0
	self.tutorialWinButtonSearchWorld = nil
	self.tutorialWinButtonSearchStage = nil
	self.tutorialWinButtonSearchPart = nil
	self.tutorialShowKartBeamUntil = 0
	self.notificationTransparencyDefaults = {} :: { [Instance]: { [string]: number } }
	self.notificationDefaultsFrame = nil :: Instance?
	local remotesFolder = ReplicatedStorage:FindFirstChild("Remotes")
	local tutorialProgressRemote = if remotesFolder then remotesFolder:FindFirstChild("TutorialProgress") else nil
	self.tutorialProgressRemote = if tutorialProgressRemote and tutorialProgressRemote:IsA("RemoteEvent")
		then tutorialProgressRemote
		else nil

	return self
end

function TutorialNotificationSystem:SetSkipButtonVisible(isVisible: boolean)
	if self.skipButtonFrame then
		self.skipButtonFrame.Visible = isVisible
	end

	if self.skipButton then
		self.skipButton.Active = isVisible
		self.skipButton.Selectable = isVisible
		self.skipButton.AutoButtonColor = isVisible
	end
end

function TutorialNotificationSystem:ClearTutorialOnlyControls()
	if self.tutorialLabel then
		self.tutorialLabel.Text = ""
		self.tutorialLabel.Visible = false
	end

	self:SetSkipButtonVisible(false)
end

function TutorialNotificationSystem:RefreshNotificationReferences()
	local frame = self.visualFunctions.HUD.NotificationFrame
	local label = self.visualFunctions.Labels.NotificationTextLabel
	local tutorialLabelInstance = if frame then frame:FindFirstChild("TutorialLabel", true) else nil
	local skipFrame = if frame then frame:FindFirstChild("SkipButtonFrame", true) else nil
	local skipButton = if skipFrame and skipFrame:IsA("GuiObject")
		then skipFrame:FindFirstChildWhichIsA("GuiButton", true)
		else nil

	self.notificationFrame = if frame and frame:IsA("Frame") then frame else nil
	self.notificationLabel = if label and label:IsA("TextLabel") then label else nil
	self.tutorialLabel = if tutorialLabelInstance and tutorialLabelInstance:IsA("TextLabel")
		then tutorialLabelInstance
		else nil
	self.skipButtonFrame = if skipFrame and skipFrame:IsA("GuiObject") then skipFrame else nil
	self.skipButton = if skipButton and skipButton:IsA("GuiButton") then skipButton else nil
	self:ClearTutorialOnlyControls()
	self:CaptureNotificationTransparencyDefaults()
	self:BindSkipButton()
end

function TutorialNotificationSystem:CaptureNotificationTransparencyDefaults()
	local frame = self.notificationFrame
	if not frame then
		return
	end

	if self.notificationDefaultsFrame == frame then
		return
	end

	self.notificationDefaultsFrame = frame
	self.notificationTransparencyDefaults = {}

	local function captureForInstance(instance: Instance)
		local defaults = {} :: { [string]: number }
		if instance:IsA("Frame") or instance:IsA("ScrollingFrame") then
			defaults.BackgroundTransparency = instance.BackgroundTransparency
		elseif instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
			defaults.TextTransparency = instance.TextTransparency
		elseif instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
			defaults.BackgroundTransparency = instance.BackgroundTransparency
			defaults.ImageTransparency = instance.ImageTransparency
		elseif instance:IsA("UIStroke") then
			defaults.Transparency = instance.Transparency
		end

		if next(defaults) ~= nil then
			self.notificationTransparencyDefaults[instance] = defaults
		end
	end

	captureForInstance(frame)
	for _, descendant in ipairs(frame:GetDescendants()) do
		captureForInstance(descendant)
	end
end

function TutorialNotificationSystem:RestoreNotificationTransparencyDefaults()
	for instance, defaults in pairs(self.notificationTransparencyDefaults) do
		if not instance.Parent then
			continue
		end

		for propertyName, value in pairs(defaults) do
			pcall(function()
				(instance :: any)[propertyName] = value
			end)
		end
	end
end

function TutorialNotificationSystem:NotifyTutorialProgress(state: string)
	if not self.tutorialStarted or self.player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	if state ~= TUTORIAL_PROGRESS_SEEN and state ~= TUTORIAL_PROGRESS_COMPLETED then
		return
	end

	if state == TUTORIAL_PROGRESS_SEEN then
		if self.tutorialSeenSent then
			return
		end
		self.tutorialSeenSent = true
		self.player:SetAttribute(TUTORIAL_SEEN_ATTRIBUTE, true)
	else
		if self.tutorialCompletedSent then
			return
		end
		self.tutorialCompletedSent = true
		self.tutorialSeenSent = true
		self.player:SetAttribute(TUTORIAL_SEEN_ATTRIBUTE, true)
		self.player:SetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE, true)
	end

	local remote = self.tutorialProgressRemote
	if not remote then
		return
	end

	local ok, err = pcall(function()
		remote:FireServer(state)
	end)
	if not ok then
		self.debugModule.debugWarn(
			string.format("Failed to send tutorial progress '%s': %s", state, tostring(err)),
			"TutorialNotificationSystem"
		)
	end
end

function TutorialNotificationSystem:BindSkipButton()
	if not self.skipButton or self.boundSkipButton == self.skipButton then
		return
	end

	self.boundSkipButton = self.skipButton
	self.sessionMaid:GiveTask(self.skipButton.Activated:Connect(function()
		if not self.tutorialActive or self.tutorialFinalizing then
			return
		end

		self.soundService.PlayGuiSound("Click")
		self:StartTutorialFinalStep("skipButton")
	end))
end

function TutorialNotificationSystem:ShowNonTutorialNotification(
	message: string,
	textColor: Color3?,
	gradientBottomColor: Color3?,
	notificationStyle: string?,
	notificationKey: string?
): boolean
	if self.tutorialNotificationLock then
		return false
	end

	local function setGradientsEnabledRecursive(root: Instance?, isEnabled: boolean)
		if not root then
			return
		end

		local gradient = if root:IsA("UIGradient") then root else root:FindFirstChildWhichIsA("UIGradient", true)
		if gradient then
			gradient.Enabled = isEnabled
		end

		for _, descendant in ipairs(root:GetDescendants()) do
			if descendant:IsA("UIGradient") then
				descendant.Enabled = isEnabled
			end
		end
	end

	setGradientsEnabledRecursive(self.notificationLabel, true)
	setGradientsEnabledRecursive(self.tutorialLabel, true)
	setGradientsEnabledRecursive(self.skipButton, true)

	self:ClearTutorialOnlyControls()
	if notificationStyle == "QuickFade" then
		self.visualFunctions.ShowQuickFadeNotification(message, textColor, gradientBottomColor)
	else
		self.visualFunctions.ShowNotification(message, textColor, gradientBottomColor, notificationKey)
	end

	-- Generic notification tweens may touch descendants, so re-hide tutorial-only labels after handoff.
	self:ClearTutorialOnlyControls()
	return true
end

function TutorialNotificationSystem:GetCurrentWorldInstance(): Instance?
	local currentWorld = self.player:GetAttribute("Current_World")
	if typeof(currentWorld) ~= "string" or currentWorld == "" then
		return nil
	end

	local worldsFolder = Workspace:FindFirstChild("Worlds")
	if not worldsFolder then
		return nil
	end

	return worldsFolder:FindFirstChild(currentWorld)
end

function TutorialNotificationSystem:GetPlayerRootPart(): BasePart?
	local character = self.player.Character
	if not character then
		return nil
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if rootPart and rootPart:IsA("BasePart") then
		return rootPart
	end

	return nil
end

function TutorialNotificationSystem:GetTutorialKartTwoButtonData(): (number, BasePart?)
	local defaultWinsRequired = 15
	local world = self:GetCurrentWorldInstance()
	if not world then
		return defaultWinsRequired, nil
	end

	local kartButtonsFolder = world:FindFirstChild("KartButtons")
	if not kartButtonsFolder then
		return defaultWinsRequired, nil
	end

	local kartButtonTwo: Model? = nil
	for _, descendant in ipairs(kartButtonsFolder:GetDescendants()) do
		if not descendant:IsA("Model") then
			continue
		end

		local kartNumber = self.getNumericAttribute(descendant, "KartNumber")
		if kartNumber == 2 then
			kartButtonTwo = descendant
			break
		end

		if descendant.Name == "KartButton_2" then
			kartButtonTwo = descendant
		end
	end

	if not kartButtonTwo then
		return defaultWinsRequired, nil
	end

	local winsRequired = self.getNumericAttribute(kartButtonTwo, "WinsRequired") or defaultWinsRequired
	local buttonPart = kartButtonTwo:FindFirstChild("Button", true)
	local typedButtonPart = if buttonPart and buttonPart:IsA("BasePart") then buttonPart else nil
	return math.max(1, math.floor(winsRequired)), typedButtonPart
end

function TutorialNotificationSystem:GetTutorialKartTwoName(): string?
	local world = self:GetCurrentWorldInstance()
	if not world then
		return nil
	end

	local kartModelsFolder = ReplicatedStorage:FindFirstChild("KartModels")
	if not kartModelsFolder then
		return nil
	end

	local worldKartFolder = kartModelsFolder:FindFirstChild(world.Name)
	if not worldKartFolder then
		return nil
	end

	for _, child in ipairs(worldKartFolder:GetChildren()) do
		if child:IsA("Model") and string.match(child.Name, "^2_") then
			return child.Name
		end
	end

	return nil
end

function TutorialNotificationSystem:OwnsTutorialKartTwo(): boolean
	local ownedKarts = PlayerHandler.GetOwnedKarts(self.player)
	local kartTwoName = self:GetTutorialKartTwoName()
	if typeof(kartTwoName) == "string" and kartTwoName ~= "" and ownedKarts[kartTwoName] == true then
		return true
	end

	for kartName, isOwned in pairs(ownedKarts) do
		if isOwned and string.match(kartName, "^2_") then
			return true
		end
	end

	return false
end

function TutorialNotificationSystem:FindNearestTreadmillPart(world: Instance?, rootPart: BasePart): BasePart?
	if not world then
		return nil
	end

	local treadmillsFolder = world:FindFirstChild("Treadmills")
	if not treadmillsFolder then
		return nil
	end

	local nearestPart: BasePart? = nil
	local shortestDistance = math.huge
	for _, treadmill in ipairs(treadmillsFolder:GetChildren()) do
		if not treadmill:IsA("Model") then
			continue
		end

		local xpMultiplier = self.getNumericAttribute(treadmill, "XP_Multiplier")
		if xpMultiplier ~= 1 then
			continue
		end

		local hasGainInterval = self.getNumericAttribute(treadmill, "XPGainInterval") ~= nil
		if not hasGainInterval then
			continue
		end

		local touchPart = treadmill:FindFirstChild("TouchPart", true)
		local targetPart = if touchPart and touchPart:IsA("BasePart")
			then touchPart
			else treadmill:FindFirstChildWhichIsA("BasePart", true)
		if not targetPart or not targetPart:IsA("BasePart") then
			continue
		end

		local distance = (targetPart.Position - rootPart.Position).Magnitude
		if distance < shortestDistance then
			shortestDistance = distance
			nearestPart = targetPart
		end
	end

	return nearestPart
end

function TutorialNotificationSystem:FindFirstWinButtonPart(world: Instance?): BasePart?
	if not world then
		return nil
	end

	local winButtonsFolder = world:FindFirstChild("WinButtons")
	if not winButtonsFolder then
		return nil
	end

	local targetStage = TUTORIAL_WIN_BUTTON_STAGE
	local exactButton = winButtonsFolder:FindFirstChild(string.format("WinButton_%d", targetStage))
	if exactButton then
		local exactButtonPart = exactButton:FindFirstChild("Button", true)
		if exactButtonPart and exactButtonPart:IsA("BasePart") then
			self.tutorialWinButtonSearchPart = exactButtonPart
			self.tutorialWinButtonSearchWorld = world
			self.tutorialWinButtonSearchStage = targetStage
			return exactButtonPart
		end
	end

	if
		self.tutorialWinButtonSearchWorld == world
		and self.tutorialWinButtonSearchStage == targetStage
		and self.tutorialWinButtonSearchPart
		and self.tutorialWinButtonSearchPart.Parent
	then
		return self.tutorialWinButtonSearchPart
	end

	self.tutorialWinButtonSearchWorld = world
	self.tutorialWinButtonSearchStage = targetStage
	self.tutorialWinButtonSearchPart = nil

	return nil
end

function TutorialNotificationSystem:ShowTutorialNotification(
	message: string,
	showSkipButton: boolean,
	tutorialHeader: string?
)
	local frame = self.notificationFrame
	local label = self.notificationLabel
	if not frame or not label then
		return
	end
	self:RestoreNotificationTransparencyDefaults()

	local function setTextControlTutorialStyle(root: Instance?)
		if not root then
			return
		end

		local function applyToInstance(instance: Instance)
			if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
				instance.BackgroundTransparency = 1
				instance.TextColor3 = Color3.fromRGB(255, 255, 255)
			elseif instance:IsA("UIGradient") then
				instance.Enabled = false
			end
		end

		applyToInstance(root)
		for _, descendant in ipairs(root:GetDescendants()) do
			applyToInstance(descendant)
		end
	end

	label.Text = message
	setTextControlTutorialStyle(label)

	if self.tutorialLabel then
		self.tutorialLabel.Text = tutorialHeader or ""
		self.tutorialLabel.Visible = tutorialHeader ~= nil and tutorialHeader ~= ""
		setTextControlTutorialStyle(self.tutorialLabel)
	end

	if self.skipButton then
		setTextControlTutorialStyle(self.skipButton)
	end

	frame.Visible = true
	frame.Position = NotificationLayoutController.GetVisiblePosition(frame, true)

	-- Re-assert after tween start to avoid stale visual state from previous notifications.
	setTextControlTutorialStyle(label)
	if self.tutorialLabel then
		setTextControlTutorialStyle(self.tutorialLabel)
	end
	if self.skipButton then
		setTextControlTutorialStyle(self.skipButton)
	end

	self:SetSkipButtonVisible(showSkipButton)
end

function TutorialNotificationSystem:ShowTutorialStepMessage(
	message: string,
	showSkipButton: boolean,
	stepNumber: number
)
	local tutorialHeader = string.format("TUTORIAL %d/3", math.clamp(stepNumber, 1, 3))
	local messageKey = string.format("%s|%s|%s", message, tostring(showSkipButton), tutorialHeader)
	if self.tutorialLastMessageKey == messageKey then
		return
	end

	self.tutorialLastMessageKey = messageKey
	self:ShowTutorialNotification(message, showSkipButton, tutorialHeader)
end

function TutorialNotificationSystem:CleanupBeamAttachments()
	if self.tutorialBeamAttachment0 then
		self.tutorialBeamAttachment0:Destroy()
		self.tutorialBeamAttachment0 = nil
	end

	if self.tutorialBeamAttachment1 then
		self.tutorialBeamAttachment1:Destroy()
		self.tutorialBeamAttachment1 = nil
	end

	self.tutorialCurrentTargetPart = nil
end

function TutorialNotificationSystem:CleanupHighlight()
	if self.tutorialHighlight then
		self.tutorialHighlight:Destroy()
		self.tutorialHighlight = nil
	end

	self.tutorialHighlightAdornee = nil
end

function TutorialNotificationSystem:CleanupBeam()
	self:CleanupBeamAttachments()
	self:CleanupHighlight()
	if self.tutorialBeam then
		self.tutorialBeam:Destroy()
		self.tutorialBeam = nil
	end
end

function TutorialNotificationSystem:GetHighlightAdornee(targetPart: BasePart): Instance
	local model = targetPart:FindFirstAncestorWhichIsA("Model")
	if model and model ~= self.player.Character then
		return model
	end

	return targetPart
end

function TutorialNotificationSystem:UpdateTutorialHighlight(targetPart: BasePart?)
	if not targetPart or not targetPart.Parent then
		self:CleanupHighlight()
		return
	end

	local adornee = self:GetHighlightAdornee(targetPart)
	if not self.tutorialHighlight then
		local highlight = Instance.new("Highlight")
		highlight.Name = "TutorialTargetHighlight"
		highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		highlight.FillTransparency = TUTORIAL_HIGHLIGHT_FILL_TRANSPARENCY
		highlight.OutlineTransparency = TUTORIAL_HIGHLIGHT_OUTLINE_TRANSPARENCY
		highlight.Parent = Workspace
		self.tutorialHighlight = highlight
	end

	if self.tutorialHighlightAdornee ~= adornee then
		self.tutorialHighlight.Adornee = adornee
		self.tutorialHighlightAdornee = adornee
	end

	self.tutorialHighlight.FillColor = TUTORIAL_HIGHLIGHT_COLOR
	self.tutorialHighlight.OutlineColor = TUTORIAL_HIGHLIGHT_COLOR
	self.tutorialHighlight.Enabled = true
end

function TutorialNotificationSystem:UpdateBeamTarget(targetPart: BasePart?)
	local rootPart = self:GetPlayerRootPart()
	if not rootPart or not targetPart or not targetPart.Parent then
		self:CleanupBeamAttachments()
		self:CleanupHighlight()
		if self.tutorialBeam then
			self.tutorialBeam.Enabled = false
		end
		return
	end

	if not self.tutorialBeam then
		if TUTORIAL_BEAM_TEMPLATE and TUTORIAL_BEAM_TEMPLATE:IsA("Beam") then
			self.tutorialBeam = TUTORIAL_BEAM_TEMPLATE:Clone()
		else
			self.tutorialBeam = Instance.new("Beam")
			self.tutorialBeam.Name = "TutorialGuideBeam"
		end
	end

	if self.tutorialCurrentTargetPart ~= targetPart then
		if self.tutorialBeamAttachment1 then
			self.tutorialBeamAttachment1:Destroy()
			self.tutorialBeamAttachment1 = nil
		end
		self.tutorialCurrentTargetPart = targetPart
	end

	if not self.tutorialBeamAttachment0 or self.tutorialBeamAttachment0.Parent ~= rootPart then
		if self.tutorialBeamAttachment0 then
			self.tutorialBeamAttachment0:Destroy()
		end
		self.tutorialBeamAttachment0 = Instance.new("Attachment")
		self.tutorialBeamAttachment0.Name = "TutorialGuideBeamAttachment0"
		self.tutorialBeamAttachment0.Position = Vector3.new(0, 0, -0.5)
		self.tutorialBeamAttachment0.Parent = rootPart
	end

	if not self.tutorialBeamAttachment1 or self.tutorialBeamAttachment1.Parent ~= targetPart then
		if self.tutorialBeamAttachment1 then
			self.tutorialBeamAttachment1:Destroy()
		end
		self.tutorialBeamAttachment1 = Instance.new("Attachment")
		self.tutorialBeamAttachment1.Name = "TutorialGuideBeamAttachment1"
		self.tutorialBeamAttachment1.Parent = targetPart
	end

	self.tutorialBeam.Attachment0 = self.tutorialBeamAttachment0
	self.tutorialBeam.Attachment1 = self.tutorialBeamAttachment1
	self.tutorialBeam.Parent = rootPart
	self.tutorialBeam.Enabled = true
	self:UpdateTutorialHighlight(targetPart)
end

function TutorialNotificationSystem:ResolveBeamTarget(): BasePart?
	if not self.tutorialActive then
		return nil
	end

	local rootPart = self:GetPlayerRootPart()
	if not rootPart then
		return nil
	end

	local world = self:GetCurrentWorldInstance()
	if self.tutorialFinalizing then
		return nil
	end

	if self.tutorialStep == 1 then
		if self.player:GetAttribute("Treadmill_Active") == true then
			return nil
		end
		return self:FindNearestTreadmillPart(world, rootPart)
	end

	if self.tutorialStep == 2 or self.tutorialStep == 3 then
		local currentWins = self.player:GetAttribute("WinCount") or 0
		local winsRequired, kartButtonPart = self:GetTutorialKartTwoButtonData()
		if currentWins < winsRequired then
			return self:FindFirstWinButtonPart(world)
		end

		return kartButtonPart
	end

	return nil
end

function TutorialNotificationSystem:StartTutorialFinalStep(reason: string)
	if not self.tutorialStarted or not self.tutorialActive or self.tutorialFinalizing then
		return
	end

	self.tutorialFinalizing = true
	self.tutorialStep = 4
	self.tutorialNotificationLock = true
	self.tutorialShowKartBeamUntil = 0
	self.tutorialLastMessageKey = nil
	self:NotifyTutorialProgress(TUTORIAL_PROGRESS_COMPLETED)
	self:ShowTutorialNotification(TUTORIAL_FINAL_MESSAGE, false, "TUTORIAL COMPLETE!")
	self.playRewardCelebration()

	self.debugModule.debugInfo("Tutorial final step started | reason=" .. reason, "TutorialNotificationSystem")

	if self.tutorialCompletionThread then
		task.cancel(self.tutorialCompletionThread)
		self.tutorialCompletionThread = nil
	end

	self.tutorialCompletionThread = self.spawnSessionTask(function()
		task.wait(3)
		if self.isCleanedUp() then
			return
		end

		local frame = self.notificationFrame
		if frame then
			self.tweenGuiFadeOut(frame, 0.35)
			task.wait(0.35)
			if frame.Parent then
				frame.Visible = false
			end
		end
		self:RestoreNotificationTransparencyDefaults()

		self:ClearTutorialOnlyControls()
		self.tutorialActive = false
		self.tutorialFinalizing = false
		self.tutorialNotificationLock = false
		self.tutorialShowKartBeamUntil = 0
		self:CleanupBeam()
		self.player:SetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE, true)

		local onTutorialUnlocked = self.onTutorialUnlocked
		if onTutorialUnlocked then
			local ok, err = pcall(onTutorialUnlocked)
			if not ok then
				self.debugModule.debugWarn(
					"Tutorial unlock callback failed: " .. tostring(err),
					"TutorialNotificationSystem"
				)
			end
		end
	end)
end

function TutorialNotificationSystem:EvaluateTutorialStep(): (number, number, boolean)
	local currentLevel = self.player:GetAttribute("CurrentLevel") or 1
	local currentWins = self.player:GetAttribute("WinCount") or 0
	local winsRequired, _ = self:GetTutorialKartTwoButtonData()
	local hasLevelTarget = currentLevel >= TUTORIAL_LEVEL_TARGET
	local hasFirstWin = currentWins >= 1
	local ownsKartTwo = self:OwnsTutorialKartTwo()

	if hasLevelTarget and hasFirstWin and ownsKartTwo then
		return 4, winsRequired, true
	end

	if not hasLevelTarget then
		return 1, winsRequired, false
	end

	if not hasFirstWin then
		return 2, winsRequired, false
	end

	return 3, winsRequired, false
end

function TutorialNotificationSystem:OnProgressChanged()
	if not self.tutorialStarted or not self.tutorialActive then
		self.tutorialNotificationLock = false
		self:SetSkipButtonVisible(false)
		return
	end

	self.tutorialNotificationLock = true
	self:BindSkipButton()

	if self.tutorialFinalizing then
		return
	end

	if self.player:GetAttribute("Treadmill_Active") == true then
		self.tutorialHasUsedTreadmill = true
	end

	local targetStep, winsRequired, shouldComplete = self:EvaluateTutorialStep()
	if shouldComplete then
		self:StartTutorialFinalStep("progressRequirementsSatisfied")
		return
	end

	if self.tutorialStep ~= targetStep then
		self.tutorialStep = targetStep
		self.tutorialLastMessageKey = nil
	end

	if self.tutorialStep == 1 then
		self:ShowTutorialStepMessage(TUTORIAL_MESSAGE_STEP_1, true, 1)
		return
	end

	if self.tutorialStep == 2 then
		self:ShowTutorialStepMessage(TUTORIAL_MESSAGE_STEP_2, true, 2)
		return
	end

	if self.tutorialStep == 3 then
		local currentWins = self.player:GetAttribute("WinCount") or 0
		local stepMessage = if currentWins < winsRequired
			then string.format("GET %d WINS FOR A FASTER KART!", winsRequired)
			else "GET A FASTER KART!"
		self:ShowTutorialStepMessage(stepMessage, true, 3)
	end
end

function TutorialNotificationSystem:OnHeartbeat(dt: number)
	if not self.tutorialActive then
		return
	end

	self.tutorialBeamUpdateAccumulator += dt
	if self.tutorialBeamUpdateAccumulator < TUTORIAL_BEAM_UPDATE_INTERVAL then
		return
	end
	self.tutorialBeamUpdateAccumulator = 0
	self:UpdateBeamTarget(self:ResolveBeamTarget())
end

function TutorialNotificationSystem:Start()
	if self.tutorialStarted or self.player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	local tutorialCompleted = self.player:GetAttribute(TUTORIAL_COMPLETED_ATTRIBUTE) == true
	local tutorialSeen = self.player:GetAttribute(TUTORIAL_SEEN_ATTRIBUTE) == true
	self.tutorialStarted = true
	self.tutorialActive = not tutorialCompleted
	self.tutorialNotificationLock = self.tutorialActive
	self.tutorialSeenSent = tutorialSeen
	self.tutorialCompletedSent = tutorialCompleted
	self:RefreshNotificationReferences()
	if not self.tutorialActive then
		self.tutorialNotificationLock = false
		self:SetSkipButtonVisible(false)
		return
	end

	self:NotifyTutorialProgress(TUTORIAL_PROGRESS_SEEN)
	self.sessionMaid:GiveTask(function()
		self:CleanupBeam()
	end)
	if not FramerateManager:IsRunning() then
		FramerateManager:Start()
	end
	local tutorialUpdateCallback = function(dt: number)
		self:OnHeartbeat(dt)
	end
	FramerateManager:BindToUpdate(tutorialUpdateCallback)
	self.sessionMaid:GiveTask(function()
		FramerateManager:UnbindFromUpdate(tutorialUpdateCallback)
	end)
	self:OnProgressChanged()
end

return TutorialNotificationSystem
]]></string>
