		gradientBottomColor = Color3.fromRGB(0, 81, 255),
	},
	{
		kartName = "1_Sled",
		displayName = "Ice Sled",
		sourceFolder = "Specials",
		sourceSubfolder = "FrostbiteRally",
		eventId = "FrostbiteRally",
		showOnlyWhenOwned = true,
		imageAssetId = "rbxassetid://118255357334971",
		backgroundColor = Color3.fromRGB(204, 238, 255),
		gradientBottomColor = Color3.fromRGB(115, 173, 255),
	},
	{
		kartName = "2_Snowmobile",
		displayName = "Snowmobile",
		sourceFolder = "Specials",
		sourceSubfolder = "FrostbiteRally",
		eventId = "FrostbiteRally",
		showOnlyWhenOwned = true,
		imageAssetId = "rbxassetid://86298743744530",
		backgroundColor = Color3.fromRGB(204, 238, 255),
		gradientBottomColor = Color3.fromRGB(115, 173, 255),
	},
	{
		kartName = "3_IglooKart",
		displayName = "Igloo Kart",
		sourceFolder = "Specials",
		sourceSubfolder = "FrostbiteRally",
		eventId = "FrostbiteRally",
		productKey = "IglooKart",
		showOnlyWhenOwned = true,
		imageAssetId = "rbxassetid://82634533787672",
		backgroundColor = Color3.fromRGB(204, 238, 255),
		gradientBottomColor = Color3.fromRGB(115, 173, 255),
	},
}

local function getKartEventId(config: KartConfig): string?
	local eventId = config.eventId
	if typeof(eventId) ~= "string" or eventId == "" then
		eventId = config.sourceSubfolder
	end
	return if typeof(eventId) == "string" and eventId ~= "" then eventId else nil
end

local function getNumericAttribute(instance: Instance?, attributeName: string): number?
	if not instance then
		return nil
	end

	local value = instance:GetAttribute(attributeName)
	if typeof(value) == "number" then
		return value
	end
	if typeof(value) == "string" then
		return tonumber(value)
	end
	return nil
end

function KartShopController.new(options: Options): Controller
	local player = options.player
	local shopMaid = Maid.new()
	local entryFrames: { [string]: KartEntry } = {}
	local controller: Controller = {} :: Controller

	local function getKartShopStepsText(config: KartConfig): string?
		local sourceFolder = config.sourceFolder or "Gamepasses"
		local kartModel = KartCatalog.FindModel(config.kartName, sourceFolder, config.sourceSubfolder)
		local xpGain = getNumericAttribute(kartModel, "XP_Gain")
		if typeof(xpGain) == "number" then
			return string.format("+%s/Steps", tostring(math.round(xpGain)))
		end
		return nil
	end

	local function isEventKartConfig(config: KartConfig): boolean
		return getKartEventId(config) ~= nil
	end

	local function canBuyEventProduct(config: KartConfig, isOwned: boolean): boolean
		local eventId = getKartEventId(config)
		return not isOwned
			and eventId ~= nil
			and typeof(config.productKey) == "string"
			and options.isLiveEventActive(eventId)
	end

	local function updateKartShop()
		local kartFrame = VisualFunctions.ActiveFrameGroup.KartFrame
		local scrollBackground = kartFrame and kartFrame:FindFirstChild("ScrollBackground")
		local scrollingFrame = scrollBackground and scrollBackground:FindFirstChild("ScrollingFrame")
		if not scrollingFrame or not scrollingFrame:IsA("ScrollingFrame") then
			return
		end

		for _, config in ipairs(KART_FRAME_CONFIGS) do
			local entry = entryFrames[config.kartName]
			if not entry then
				continue
			end

			local isOwned = PlayerHandler.OwnsKart(player, config.kartName)
			local isEquipped = player:GetAttribute("Kart_Equipped") == config.kartName
			local isWheelOnly = config.wheelOnly == true
			local eventKart = isEventKartConfig(config)
			entry.frame.BackgroundColor3 = if eventKart
				then config.backgroundColor
				elseif isWheelOnly then WHEEL_BACKGROUND_COLOR
				else config.backgroundColor

			local frameGradient = entry.frame:FindFirstChildOfClass("UIGradient")
			if not frameGradient then
				frameGradient = Instance.new("UIGradient")
				frameGradient.Parent = entry.frame
			end
			frameGradient.Rotation = 90
			frameGradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
				ColorSequenceKeypoint.new(
					1,
					if eventKart
						then config.gradientBottomColor
						elseif isWheelOnly then WHEEL_GRADIENT_BOTTOM_COLOR
						else config.gradientBottomColor
				),
			})
			VisualFunctions.RefreshFrameInteractionColors(entry.frame)

			local kartNameLabel = entry.frame:FindFirstChild("KartName", true)
			if kartNameLabel and kartNameLabel:IsA("TextLabel") then
				kartNameLabel.Text = string.upper(config.displayName)
				kartNameLabel.TextColor3 = config.backgroundColor
			end

			local kartTypeImage = entry.frame:FindFirstChild("KartType", true)
			if kartTypeImage and (kartTypeImage:IsA("ImageLabel") or kartTypeImage:IsA("ImageButton")) then
				if isWheelOnly and typeof(config.wheelImage) == "string" then
					kartTypeImage.Image = config.wheelImage
				elseif typeof(config.imageAssetId) == "string" then
					kartTypeImage.Image = config.imageAssetId
				elseif typeof(config.gamePassId) == "number" then
					local info = options.getMarketplaceInfoCached(config.gamePassId, Enum.InfoType.GamePass)
					if info then
						local iconAssetId = tonumber((info :: any).IconImageAssetId)
						if iconAssetId and iconAssetId > 0 then
							kartTypeImage.Image = "rbxassetid://" .. tostring(iconAssetId)
						end
					end
				elseif typeof(config.productKey) == "string" then
					local productId = ProductService.DevProducts[config.productKey]
					if typeof(productId) == "number" then
						local info = options.getMarketplaceInfoCached(productId, Enum.InfoType.Product)
						if info then
							local iconAssetId = tonumber((info :: any).IconImageAssetId)
							if iconAssetId and iconAssetId > 0 then
								kartTypeImage.Image = "rbxassetid://" .. tostring(iconAssetId)
							end
						end
					end
				end
			end

			local speedAmountLabel = entry.frame:FindFirstChild("SpeedAmount", true)
			if speedAmountLabel and speedAmountLabel:IsA("TextLabel") then
				speedAmountLabel.Text = getKartShopStepsText(config) or "+0/Steps"
			end

			if entry.equipButton then
				local textButton = entry.equipButton:FindFirstChild("TextButton", true)
				if textButton and textButton:IsA("TextButton") then
					if isWheelOnly and not isOwned then
						textButton.Text = "SPIN"
					elseif isEventKartConfig(config) and not isOwned and typeof(config.productKey) ~= "string" then
						textButton.Text = "EVENT"
					elseif isEquipped then
						textButton.Text = "EQUIPPED"
					elseif isOwned then
						textButton.Text = "EQUIP"
					else
						textButton.Text = "BUY"
					end
				end

				VisualFunctions.SetFrameInteractableState(
					entry.equipButton,
					isOwned or (isWheelOnly and not isOwned) or canBuyEventProduct(config, isOwned)
				)
				if isWheelOnly and not isOwned then
					options.applyWheelStyle(entry.equipButton)
				else
					options.applyEquipStyle(entry.equipButton)
				end
			end
		end
	end

	function controller:Build()
		shopMaid:DoCleaning()
		local kartFrame = VisualFunctions.ActiveFrameGroup.KartFrame
		local scrollBackground = kartFrame and kartFrame:FindFirstChild("ScrollBackground")
		local scrollingFrame = scrollBackground and scrollBackground:FindFirstChild("ScrollingFrame")
		if not scrollingFrame or not scrollingFrame:IsA("ScrollingFrame") then
			return
		end

		local template = scrollingFrame:FindFirstChild("KartTemplate")
		if not template or not template:IsA("Frame") then
			return
		end

		for _, child in ipairs(scrollingFrame:GetChildren()) do
			if child ~= template and child:IsA("Frame") then
				child:Destroy()
			end
		end
		table.clear(entryFrames)
		template.Visible = false

		local sortedKartConfigs: { KartConfig } = {}
		for _, config in ipairs(KART_FRAME_CONFIGS) do
			local isOwned = PlayerHandler.OwnsKart(player, config.kartName)
			if
				config.showOnlyWhenOwned ~= true
				or isOwned
				or (isEventKartConfig(config) and typeof(config.productKey) == "string" and options.isLiveEventActive(getKartEventId(config)))
			then
				table.insert(sortedKartConfigs, config)
			end
		end
		table.sort(sortedKartConfigs, function(a, b)
			local aKartModel = KartCatalog.FindModel(a.kartName, a.sourceFolder, a.sourceSubfolder)
			local bKartModel = KartCatalog.FindModel(b.kartName, b.sourceFolder, b.sourceSubfolder)
			local aGain = getNumericAttribute(aKartModel, "XP_Gain") or 0
			local bGain = getNumericAttribute(bKartModel, "XP_Gain") or 0
			if aGain == bGain then
				return a.displayName < b.displayName
			end
			return aGain > bGain
		end)

		for index, config in ipairs(sortedKartConfigs) do
			local clone = template:Clone()
			clone.Name = config.kartName .. "Template"
			clone.LayoutOrder = index
			clone.Visible = true
			clone.Parent = scrollingFrame

			local equipButton = clone:FindFirstChild("EquipButton")
			if equipButton and equipButton:IsA("Frame") then
				local textButton = equipButton:FindFirstChild("TextButton", true)
				if textButton and textButton:IsA("TextButton") then
					shopMaid:GiveTask(textButton.Activated:Connect(function()
						SoundService.PlayGuiSound("Click")
						local isOwned = PlayerHandler.OwnsKart(player, config.kartName)
						if isEventKartConfig(config) and not isOwned and not options.isLiveEventActive(getKartEventId(config)) then
							return
						end
						if config.wheelOnly == true and not isOwned then
							options.openSpinWheelFromShop(player)
							return
						end
						if not isOwned then
							if typeof(config.productKey) == "string" then
								local productId = ProductService.DevProducts[config.productKey]
								if typeof(productId) == "number" then
									ProductService.promptProductPurchase(player, productId)
								end
							elseif typeof(config.gamePassId) == "number" then
								ProductService.promptGamePassPurchase(player, config.gamePassId)
							end
							return
						end
						options.kartActionRemote:FireServer("Equip", config.kartName)
					end))
				end
			end

			entryFrames[config.kartName] = {
				frame = clone,
				equipButton = if equipButton and equipButton:IsA("Frame") then equipButton else nil,
			}
		end

		updateKartShop()
	end

	function controller:Update()
		updateKartShop()
	end

	function controller:Destroy()
		shopMaid:DoCleaning()
		table.clear(entryFrames)
	end

	return controller
end

return KartShopController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3548">
            <Properties>
              <string name="Name">LevelDisplayController</string>
              <string name="Source"><![CDATA[local LevelDisplayController = {}
LevelDisplayController.__index = LevelDisplayController

type ControllerOptions = {
	player: Player,
	visualFunctions: any,
	playerHandler: any,
	soundService: any,
	refreshRebirthReadyState: () -> (),
	tutorialSystem: any?,
	defaultMaxPlayerSpeed: number,
}

type Controller = {
	player: Player,
	visualFunctions: any,
	playerHandler: any,
	soundService: any,
	refreshRebirthReadyState: () -> (),
	tutorialSystem: any?,
	defaultMaxPlayerSpeed: number,
	lastLevel: number,
	lastMaxSpeed: number,
	hasSuppressedInitialLoadedLevel: boolean,
	alive: boolean,
}

local function getNumberAttribute(player: Player, attributeName: string, fallback: number): number
	local value = player:GetAttribute(attributeName)
	return if typeof(value) == "number" then value else fallback
end

function LevelDisplayController.new(options: ControllerOptions): Controller
	local player = options.player
	return setmetatable({
		player = player,
		visualFunctions = options.visualFunctions,
		playerHandler = options.playerHandler,
		soundService = options.soundService,
		refreshRebirthReadyState = options.refreshRebirthReadyState,
		tutorialSystem = options.tutorialSystem,
		defaultMaxPlayerSpeed = options.defaultMaxPlayerSpeed,
		lastLevel = getNumberAttribute(player, "CurrentLevel", 1),
		lastMaxSpeed = getNumberAttribute(player, "Max_Player_Speed", options.defaultMaxPlayerSpeed),
		hasSuppressedInitialLoadedLevel = false,
		alive = true,
	}, LevelDisplayController) :: Controller
end

function LevelDisplayController:SyncState(level: number, maxSpeed: number)
	if not self.alive then
		return
	end

	self.lastLevel = level
	self.lastMaxSpeed = maxSpeed
end

function LevelDisplayController:UpdateLevelDisplay()
	if not self.alive then
		return
	end

	local level = getNumberAttribute(self.player, "CurrentLevel", 1)
	local maxLevel = getNumberAttribute(self.player, "MaxLevel", 25)
	local rebirthMultiplier = getNumberAttribute(self.player, "Rebirth_XPMultiplier", 1)
	local maxSpeed = self.playerHandler.GetEffectiveMaxPlayerSpeed(self.player)

	self.visualFunctions.UpdateLevelLabel(level, maxLevel)
	self.visualFunctions.UpdateLevelProgressBar(level, maxLevel)
	self.visualFunctions.UpdateLevelNeededLabel(level, maxLevel)

	local isInitialLoadedJump = not self.hasSuppressedInitialLoadedLevel and level > self.lastLevel + 1
	if isInitialLoadedJump then
		self.hasSuppressedInitialLoadedLevel = true
	elseif level > self.lastLevel then
		self.soundService.PlayGuiSound("LevelUp")
		self.visualFunctions.ShowLevelUpNotification(self.lastLevel, level, self.lastMaxSpeed, maxSpeed)
	end

	self.lastLevel = level
	self.lastMaxSpeed = maxSpeed
	local nextStats = self.playerHandler.GetNextRebirthStats(self.player)
	self.visualFunctions.UpdateRebirthPreview(
		rebirthMultiplier,
		nextStats.NextMultiplier,
		maxLevel,
		nextStats.NextMaxLevel
	)
	self.refreshRebirthReadyState()

	if self.tutorialSystem then
		self.tutorialSystem:OnProgressChanged()
	end
end

function LevelDisplayController:UpdateMaxSpeedDisplay()
	if not self.alive then
		return
	end

	local maxSpeed = self.playerHandler.GetEffectiveMaxPlayerSpeed(self.player)
	self.visualFunctions.UpdateMaxSpeedLabel(maxSpeed)
	self.lastMaxSpeed = maxSpeed
end

function LevelDisplayController:GetLevelUpdateHandler(): () -> ()
	return function()
		self:UpdateLevelDisplay()
	end
end

function LevelDisplayController:GetMaxSpeedUpdateHandler(): () -> ()
	return function()
		self:UpdateMaxSpeedDisplay()
	end
end

function LevelDisplayController:Destroy()
	if not self.alive then
		return
	end

	self.alive = false
	self.tutorialSystem = nil
	self.refreshRebirthReadyState = function() end
end

return LevelDisplayController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3549">
            <Properties>
              <string name="Name">LiveEventBannerUI</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local NotificationLayoutController = require(ReplicatedStorage.Modules.UI.MainGUI.NotificationLayoutController)

local DebugModule = require(ReplicatedStorage.Modules:WaitForChild("DebugModule"))
local Maid = require(ReplicatedStorage.Modules.Maid)
local SoundService = require(ReplicatedStorage.Modules.SoundService)

type EventDisplayData = {
	id: string,
	displayText: string,
	displayColor: string,
	startText: string,
	startSound: string,
	showCountdown: boolean,
	environmentName: string,
	effects: {
		xpMultiplier: number,
		winButtonMultiplier: number,
		walkSpeedMultiplier: number,
	},
	endsAtUnix: number,
	startsAtUnix: number,
}

local LiveEventBannerUI = {}
LiveEventBannerUI.__index = LiveEventBannerUI

type LiveEventBannerUIObject = {
	container: GuiObject?,
	template: Frame?,
	stateFolder: Folder?,
	cards: { [string]: Frame },
	cardEventData: { [string]: EventDisplayData },
	cardEndsAt: { [string]: number },
	cardStartsAt: { [string]: number },
	cardModes: { [string]: "live" | "starting" | "ending" | "upcoming" },
	cardUpcomingPrefixes: { [string]: string },
	cardEnvironmentNames: { [string]: string },
	originalContainerSize: UDim2?,
	originalCountdownLabel1TextColor: Color3?,
	originalContainerVisible: boolean?,
	originalTemplateVisible: boolean?,
	maid: any,
	initialized: boolean,
	refreshAccumulator: number,
	eventStartSoundArmed: boolean,
}

local MODULE_NAME = "LiveEventBannerUI"

local function formatMultiplier(multiplier: number): string
	local roundedMultiplier = math.round(multiplier)
	if math.abs(multiplier - roundedMultiplier) < 0.001 then
		return string.format("%dx", roundedMultiplier)
	end
	return string.format("%.2fx", multiplier)
end

local function getEventTooltipDescription(eventData: EventDisplayData): string
	local bonusDescriptions: { string } = {}
	local effects = eventData.effects
	if math.abs(effects.xpMultiplier - 1) > 0.001 then
		table.insert(bonusDescriptions, formatMultiplier(effects.xpMultiplier) .. " XP Speed")
	end
	if math.abs(effects.winButtonMultiplier - 1) > 0.001 then
		table.insert(bonusDescriptions, formatMultiplier(effects.winButtonMultiplier) .. " Wins")
	end

	local description = ""
	if #bonusDescriptions > 0 then
		description = "Race through it with " .. table.concat(bonusDescriptions, " and ") .. "!"
	end

	if effects.walkSpeedMultiplier < 0.999 then
		local movementDescription = string.format(
			"but move %d%% slower",
			math.round((1 - effects.walkSpeedMultiplier) * 100)
		)
		description = if description == ""
			then "Race carefully: " .. movementDescription .. "!"
			else string.gsub(description, "!$", ", " .. movementDescription .. "!")
	elseif effects.walkSpeedMultiplier > 1.001 then
		local movementDescription = string.format(
			"move %d%% faster",
			math.round((effects.walkSpeedMultiplier - 1) * 100)
		)
		description = if description == ""
			then "Race fast: " .. movementDescription .. "!"
			else string.gsub(description, "!$", " and " .. movementDescription .. "!")
	end
	if eventData.environmentName ~= "" then
		description = if description == ""
			then "Race to earn event Wins for cool event rewards!"
			else string.gsub(description, "!$", " and earn event Wins too!")
	end
	if description == "" then
		return "Race in this limited-time event and grab the rewards!"
	end

	return description
end

local function setEventLabelInteraction(eventLabel: TextLabel?, isLive: boolean)
	if not eventLabel then
		return
	end

	eventLabel.Active = isLive
	eventLabel.Interactable = isLive
	eventLabel:SetAttribute("EventTooltipEnabled", isLive)
	eventLabel:SetAttribute("UiDisabled", not isLive)
end

local function escapeRichText(value: string): string
	local escaped = string.gsub(value, "&", "&amp;")
	escaped = string.gsub(escaped, "<", "&lt;")
	escaped = string.gsub(escaped, ">", "&gt;")
	return escaped
end

local function parseHexColor(value: string): Color3?
	local redHex, greenHex, blueHex = string.match(value, "^#?(%x%x)(%x%x)(%x%x)$")
	if not redHex or not greenHex or not blueHex then
		return nil
	end

	local red = tonumber(redHex, 16)
	local green = tonumber(greenHex, 16)
	local blue = tonumber(blueHex, 16)
	if red == nil or green == nil or blue == nil then
		return nil
	end

	return Color3.fromRGB(red, green, blue)
end

local function getEventStartText(eventData: EventDisplayData): string
	if eventData.startText ~= "" then
		return eventData.startText
	end
	return string.upper(eventData.displayText) .. " STARTS..."
end

local function formatRemainingTime(
	deadlineUnix: number,
	prefix: string,
	finishedText: string?,
	expiredText: string?
): string
	if deadlineUnix <= 0 then
		return finishedText or prefix .. " 00"
	end

	local remaining = math.max(0, deadlineUnix - DateTime.now().UnixTimestamp)
	if remaining <= 0 then
		return expiredText or prefix .. " 00"
	end
	local seconds = remaining % 60
	if remaining >= 3600 then
		local hours = math.floor(remaining / 3600)
		local minutes = math.floor((remaining % 3600) / 60)
		return string.format("%s %02d:%02d:%02d", prefix, hours, minutes, seconds)
	end
	if remaining >= 60 then
		local minutes = math.floor(remaining / 60)
		return string.format("%s %02d:%02d", prefix, minutes, seconds)
	end

	return string.format("%s %02d", prefix, seconds)
end

local function getColoredEventText(eventData: EventDisplayData): string
	local displayText = escapeRichText(string.upper(eventData.displayText))
	if eventData.displayColor == "" then
		return displayText
	end

	return string.format('<font color="%s">%s</font>', eventData.displayColor, displayText)
end

local function getLiveEventLabelText(eventData: EventDisplayData, endsAtUnix: number): string
	local eventText = getColoredEventText(eventData)
	if not eventData.showCountdown then
		return eventText
	end

	return eventText .. " " .. formatRemainingTime(endsAtUnix, "ENDS IN:", "LIVE")
end

local function decodeEventData(value: any): { EventDisplayData }
	if typeof(value) ~= "string" or value == "" then
		return {}
	end

	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, value)
	if not ok or typeof(decoded) ~= "table" then
		return {}
	end

	local events: { EventDisplayData } = {}
	for _, entry in ipairs(decoded :: { any }) do
		if
			typeof(entry) == "table"
			and typeof(entry.id) == "string"
			and typeof(entry.displayText) == "string"
			and (typeof(entry.endsAtUnix) == "number" or typeof(entry.startsAtUnix) == "number")
		then
			local rawEffects = if typeof(entry.effects) == "table" then entry.effects else {}
			table.insert(events, {
				id = entry.id,
				displayText = entry.displayText,
				displayColor = if typeof(entry.displayColor) == "string" then entry.displayColor else "",
				startText = if typeof(entry.startText) == "string" then entry.startText else "",
				startSound = if typeof(entry.startSound) == "string" then entry.startSound else "",
				showCountdown = entry.showCountdown ~= false,
				environmentName = if typeof(entry.environmentName) == "string" then entry.environmentName else "",
				effects = {
					xpMultiplier = if typeof(rawEffects.xpMultiplier) == "number" then rawEffects.xpMultiplier else 1,
					winButtonMultiplier = if typeof(rawEffects.winButtonMultiplier) == "number"
						then rawEffects.winButtonMultiplier
						else 1,
					walkSpeedMultiplier = if typeof(rawEffects.walkSpeedMultiplier) == "number"
						then rawEffects.walkSpeedMultiplier
						else 1,
				},
				endsAtUnix = if typeof(entry.endsAtUnix) == "number" then entry.endsAtUnix else 0,
				startsAtUnix = if typeof(entry.startsAtUnix) == "number" then entry.startsAtUnix else 0,
			})
		end
	end

	return events
end

local function getCardKey(eventData: EventDisplayData, mode: "live" | "upcoming"): string
	return mode .. "#" .. eventData.id
end

local function setCountdownLabel1Color(label: TextLabel, color: Color3?, originalColor: Color3?)
	if color then
		label.TextColor3 = color
	elseif originalColor then
		label.TextColor3 = originalColor
	end
end

local function getTemplateCountdownLabel1Color(template: Frame?): Color3?
	if not template then
		return nil
	end

	local countdownLabel1 = template:FindFirstChild("CountdownLabel1")
	if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
		return countdownLabel1.TextColor3
	end

	return nil
end

local function getStartSoundEvent(events: { EventDisplayData }): EventDisplayData?
	for _, eventData in ipairs(events) do
		if eventData.startSound ~= "" then
			return eventData
		end
	end

	return nil
end

function LiveEventBannerUI.new(screenGui: ScreenGui): LiveEventBannerUIObject
	local containerInstance = screenGui:FindFirstChild("EventFrameList", true)
	local container = if containerInstance and containerInstance:IsA("GuiObject") then containerInstance else nil
	local templateInstance = container and container:FindFirstChild("EventFrameTemplate", true)
	local template = if templateInstance and templateInstance:IsA("Frame") then templateInstance else nil

	return setmetatable({
		container = container,
		template = template,
		stateFolder = nil,
		cards = {},
		cardEventData = {},
		cardEndsAt = {},
		cardStartsAt = {},
		cardModes = {},
		cardUpcomingPrefixes = {},
		cardEnvironmentNames = {},
		originalContainerSize = if container then container.Size else nil,
		originalCountdownLabel1TextColor = getTemplateCountdownLabel1Color(template),
		originalContainerVisible = if container then container.Visible else nil,
		originalTemplateVisible = if template then template.Visible else nil,
		maid = Maid.new(),
		initialized = false,
		refreshAccumulator = 1,
		eventStartSoundArmed = false,
	}, LiveEventBannerUI)
end

function LiveEventBannerUI:refreshCountdowns()
	for key, card in pairs(self.cards) do
		local mode = self.cardModes[key]
		if mode == "upcoming" then
			local countdownLabel1 = card:FindFirstChild("CountdownLabel1")
			if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
				setCountdownLabel1Color(countdownLabel1, nil, self.originalCountdownLabel1TextColor)
				countdownLabel1.Text = (self.cardUpcomingPrefixes[key] or "")
					.. " "
					.. formatRemainingTime(self.cardStartsAt[key] or 0, "LIVE IN:", "LIVE IN: 00")
			end
		elseif mode == "starting" or mode == "ending" then
			local countdownLabel1 = card:FindFirstChild("CountdownLabel1")
			if mode == "starting" then
				local eventData = self.cardEventData[key]
				if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
					setCountdownLabel1Color(
						countdownLabel1,
						if eventData then parseHexColor(eventData.displayColor) else nil,
						self.originalCountdownLabel1TextColor
					)
					countdownLabel1.Text = if eventData then getEventStartText(eventData) else "STARTING..."
				end
			elseif countdownLabel1 and countdownLabel1:IsA("TextLabel") then
				setCountdownLabel1Color(countdownLabel1, nil, self.originalCountdownLabel1TextColor)
				countdownLabel1.Text = "ENDING..."
			end
		else
			local eventLabel = card:FindFirstChild("EventLabel")
			local endsAtUnix = self.cardEndsAt[key] or 0
			if endsAtUnix > 0 and endsAtUnix <= DateTime.now().UnixTimestamp then
				self.cardModes[key] = "ending"
				local countdownLabel1 = card:FindFirstChild("CountdownLabel1")
				if eventLabel and eventLabel:IsA("TextLabel") then
					eventLabel.Visible = false
				end
				if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
					countdownLabel1.Visible = true
					countdownLabel1.RichText = false
					setCountdownLabel1Color(countdownLabel1, nil, self.originalCountdownLabel1TextColor)
					countdownLabel1.Text = "ENDING..."
				end
			elseif eventLabel and eventLabel:IsA("TextLabel") then
				local eventData = self.cardEventData[key]
				if eventData then
					eventLabel.Text = getLiveEventLabelText(eventData, endsAtUnix)
				end
			end
		end
	end
end

function LiveEventBannerUI:rebuild()
	if not self.container or not self.template or not self.stateFolder then
		return
	end

	local activeEventData = decodeEventData(self.stateFolder:GetAttribute("ActiveEvents"))
	local upcomingEventData = decodeEventData(self.stateFolder:GetAttribute("UpcomingEvents"))
	local transitionComplete = self.stateFolder:GetAttribute("EnvironmentTransitionComplete") == true
	local startSoundEvent = getStartSoundEvent(activeEventData)
	if not startSoundEvent then
		self.eventStartSoundArmed = false
	elseif transitionComplete and self.eventStartSoundArmed then
		self.eventStartSoundArmed = false
		SoundService.PlayGuiSound(startSoundEvent.startSound)
	end
	local endingCardCount = 0
	if not transitionComplete then
		for key, _ in pairs(self.cards) do
			if
				(self.cardModes[key] == "live" or self.cardModes[key] == "ending")
				and (self.cardEnvironmentNames[key] or "") ~= ""
			then
				local stillActive = false
				for _, eventEntry in ipairs(activeEventData) do
					if getCardKey(eventEntry, "live") == key then
						stillActive = true
						break
					end
				end
				if not stillActive then
					endingCardCount += 1
				end
			end
		end
	end
	local totalEventCount = #activeEventData + #upcomingEventData + endingCardCount
	local visibleEventCount = math.max(1, totalEventCount)
	local desiredCards: { [string]: boolean } = {}
	local cardHeightScale = 1 / visibleEventCount
	local originalContainerSize = self.originalContainerSize
	if originalContainerSize then
		self.container.Size = UDim2.new(
			originalContainerSize.X.Scale,
			originalContainerSize.X.Offset,
			originalContainerSize.Y.Scale * visibleEventCount,
			originalContainerSize.Y.Offset * visibleEventCount
		)
	end
	local cardIndex = 0
	for _, eventEntry in ipairs(activeEventData) do
		cardIndex += 1
		local key = getCardKey(eventEntry, "live")
		desiredCards[key] = true
		local card = self.cards[key]
		if not card then
			card = self.template:Clone()
			card.Name = "EventFrame_" .. eventEntry.id
			self.cards[key] = card
		end

		card.LayoutOrder = cardIndex
		card.Size = UDim2.new(1, 0, cardHeightScale, 0)
		card.Visible = true
		local eventLabel = card:FindFirstChild("EventLabel")
		local countdownLabel1 = card:FindFirstChild("CountdownLabel1")
		local isStarting = eventEntry.environmentName ~= "" and not transitionComplete
		card:SetAttribute("EventId", eventEntry.id)
		card:SetAttribute("EventTooltipDescription", getEventTooltipDescription(eventEntry))
		if isStarting then
			if eventLabel and eventLabel:IsA("TextLabel") then
				setEventLabelInteraction(eventLabel, false)
				eventLabel.Visible = false
			end
			if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
				countdownLabel1.Visible = true
				countdownLabel1.RichText = false
				setCountdownLabel1Color(
					countdownLabel1,
					parseHexColor(eventEntry.displayColor),
					self.originalCountdownLabel1TextColor
				)
				countdownLabel1.Text = getEventStartText(eventEntry)
			end
			self.cardModes[key] = "starting"
		else
			if eventLabel and eventLabel:IsA("TextLabel") then
				setEventLabelInteraction(eventLabel, true)
				eventLabel.Visible = true
				eventLabel.RichText = true
				eventLabel.Text = getLiveEventLabelText(eventEntry, eventEntry.endsAtUnix)
			end
			if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
				countdownLabel1.Visible = false
			end
			self.cardModes[key] = "live"
		end
		self.cardStartsAt[key] = 0
		self.cardEventData[key] = eventEntry
		self.cardEndsAt[key] = eventEntry.endsAtUnix
		self.cardEnvironmentNames[key] = eventEntry.environmentName
		if eventEntry.endsAtUnix > 0 and eventEntry.endsAtUnix <= DateTime.now().UnixTimestamp then
			if eventLabel and eventLabel:IsA("TextLabel") then
				setEventLabelInteraction(eventLabel, false)
				eventLabel.Visible = false
			end
			if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
				countdownLabel1.Visible = true
				countdownLabel1.RichText = false
				setCountdownLabel1Color(countdownLabel1, nil, self.originalCountdownLabel1TextColor)
				countdownLabel1.Text = "ENDING..."
			end
			self.cardModes[key] = "ending"
		end
		if card.Parent ~= self.container then
			card.Parent = self.container
		end
	end

	for _, eventEntry in ipairs(upcomingEventData) do
		cardIndex += 1
		local key = getCardKey(eventEntry, "upcoming")
		desiredCards[key] = true
		local card = self.cards[key]
		if not card then
			card = self.template:Clone()
			card.Name = "EventFrame_" .. eventEntry.id .. "_Upcoming"
			self.cards[key] = card
		end

		card.LayoutOrder = cardIndex
		card.Size = UDim2.new(1, 0, cardHeightScale, 0)
		card.Visible = true
		local eventLabel = card:FindFirstChild("EventLabel")
		local countdownLabel1 = card:FindFirstChild("CountdownLabel1")
		card:SetAttribute("EventId", eventEntry.id)
		card:SetAttribute("EventTooltipDescription", getEventTooltipDescription(eventEntry))
		if eventLabel and eventLabel:IsA("TextLabel") then
			setEventLabelInteraction(eventLabel, false)
			eventLabel.Visible = false
		end
		if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
			countdownLabel1.Visible = true
			countdownLabel1.RichText = true
			setCountdownLabel1Color(countdownLabel1, nil, self.originalCountdownLabel1TextColor)
		end
		self.cardModes[key] = "upcoming"
		self.cardEventData[key] = eventEntry
		self.cardEndsAt[key] = 0
		self.cardStartsAt[key] = eventEntry.startsAtUnix
		self.cardUpcomingPrefixes[key] = getColoredEventText(eventEntry)
		self.cardEnvironmentNames[key] = ""
		if card.Parent ~= self.container then
			card.Parent = self.container
		end
	end

	if not transitionComplete then
		for key, card in pairs(self.cards) do
			if
				not desiredCards[key]
				and (self.cardModes[key] == "live" or self.cardModes[key] == "ending")
				and (self.cardEnvironmentNames[key] or "") ~= ""
			then
				cardIndex += 1
				desiredCards[key] = true
				card.LayoutOrder = cardIndex
				card.Size = UDim2.new(1, 0, cardHeightScale, 0)
				card.Visible = true

				local eventLabel = card:FindFirstChild("EventLabel")
				local countdownLabel1 = card:FindFirstChild("CountdownLabel1")
				if eventLabel and eventLabel:IsA("TextLabel") then
					setEventLabelInteraction(eventLabel, false)
					eventLabel.Visible = false
				end
				if countdownLabel1 and countdownLabel1:IsA("TextLabel") then
					countdownLabel1.Visible = true
					countdownLabel1.RichText = false
					setCountdownLabel1Color(countdownLabel1, nil, self.originalCountdownLabel1TextColor)
					countdownLabel1.Text = "ENDING..."
				end
				self.cardModes[key] = "ending"
			end
		end
	end

	for key, card in pairs(self.cards) do
		if not desiredCards[key] then
			card:Destroy()
			self.cards[key] = nil
			self.cardEventData[key] = nil
			self.cardEndsAt[key] = nil
			self.cardStartsAt[key] = nil
			self.cardModes[key] = nil
			self.cardUpcomingPrefixes[key] = nil
			self.cardEnvironmentNames[key] = nil
		end
	end

	self.container.Visible = totalEventCount > 0
	self.template.Visible = false
	local templateEventLabel = self.template:FindFirstChild("EventLabel")
	if templateEventLabel and templateEventLabel:IsA("TextLabel") then
		setEventLabelInteraction(templateEventLabel, false)
	end
	self:refreshCountdowns()
	DebugModule.debugInfo(
		string.format(
			"Event layout refresh | active=%d | upcoming=%d | visible=%s | class=%s | bottom=%.3f",
			#activeEventData,
			#upcomingEventData,
			tostring(self.container.Visible),
			self.container.ClassName,
			(self.container.AbsolutePosition.Y + self.container.AbsoluteSize.Y)
				/ math.max(1, Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize.Y or 1)
		),
		MODULE_NAME
	)
	NotificationLayoutController.Refresh()
end

function LiveEventBannerUI:refresh()
	if not self.stateFolder then
		return
	end
	self:rebuild()
end

function LiveEventBannerUI:Init()
	if self.initialized then
		return
	end
	self.initialized = true

	if not self.container or not self.template then
		DebugModule.debugWarn("EventFrameList or EventFrameTemplate is missing", MODULE_NAME)
		return
	end
	if not self.template:FindFirstChild("CountdownLabel1") then
		DebugModule.debugWarn("EventFrameTemplate.CountdownLabel1 is missing", MODULE_NAME)
	end
	self.template.Visible = false
	self.container.Visible = false

	self.maid.Timer = RunService.Heartbeat:Connect(function(deltaTime: number)
		if not self.initialized then
			return
		end
		self.refreshAccumulator += deltaTime
		if self.refreshAccumulator >= 1 then
			self.refreshAccumulator = 0
			self:refreshCountdowns()
		end
	end)

	local stateFolder = ReplicatedStorage:FindFirstChild("LiveEventState")
	if not stateFolder or not stateFolder:IsA("Folder") then
		self.maid.StateAdded = ReplicatedStorage.ChildAdded:Connect(function(child: Instance)
			if child.Name == "LiveEventState" and child:IsA("Folder") then
				self.stateFolder = child
				self.maid.StateAdded = nil
				self.maid.ActiveEvents = child:GetAttributeChangedSignal("ActiveEvents"):Connect(function()
					self:refresh()
				end)
				self.maid.UpcomingEvents = child:GetAttributeChangedSignal("UpcomingEvents"):Connect(function()
					self:refresh()
				end)
				self.maid.EnvironmentTransition = child
					:GetAttributeChangedSignal("EnvironmentTransitionComplete")
					:Connect(function()
						if child:GetAttribute("EnvironmentTransitionComplete") ~= true then
					self.eventStartSoundArmed = true
						end
						self:refresh()
					end)
				self:refresh()
			end
		end)
		return
	end

	self.stateFolder = stateFolder
	self.maid.ActiveEvents = stateFolder:GetAttributeChangedSignal("ActiveEvents"):Connect(function()
		self:refresh()
	end)
	self.maid.UpcomingEvents = stateFolder:GetAttributeChangedSignal("UpcomingEvents"):Connect(function()
		self:refresh()
	end)
	self.maid.EnvironmentTransition = stateFolder
		:GetAttributeChangedSignal("EnvironmentTransitionComplete")
		:Connect(function()
			if stateFolder:GetAttribute("EnvironmentTransitionComplete") ~= true then
				self.eventStartSoundArmed = true
			end
			self:refresh()
		end)
	self:refresh()
end

function LiveEventBannerUI:Destroy()
	if not self.initialized then
		return
	end
	self.initialized = false
	self.maid:DoCleaning()
	for key, card in pairs(self.cards) do
		card:Destroy()
		self.cards[key] = nil
		self.cardEventData[key] = nil
		self.cardEndsAt[key] = nil
		self.cardStartsAt[key] = nil
		self.cardModes[key] = nil
		self.cardUpcomingPrefixes[key] = nil
		self.cardEnvironmentNames[key] = nil
	end
	if self.container and self.originalContainerVisible ~= nil then
		self.container.Visible = self.originalContainerVisible
	end
	if self.container and self.originalContainerSize then
		self.container.Size = self.originalContainerSize
	end
	if self.template and self.originalTemplateVisible ~= nil then
		self.template.Visible = self.originalTemplateVisible
	end
	self.stateFolder = nil
end

return LiveEventBannerUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3550">
            <Properties>
              <string name="Name">MainOrchestrator</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local ContentProvider = game:GetService("ContentProvider")
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)
local VisualFunctions = require(ReplicatedStorage.Modules.UI.VisualFunctions)
local TweenConfig = require(ReplicatedStorage.Modules.UI.TweenConfig)
local SoundService = require(ReplicatedStorage.Modules.SoundService)
local Players = game:GetService("Players")
local PlayerHandler = require(ReplicatedStorage.Modules.Shared:WaitForChild("PlayerHandler_Client"))
local ProductService = require(ReplicatedStorage.Modules.Shared:WaitForChild("ProductService_Client"))
local KartCatalog = require(ReplicatedStorage.Modules.KartCatalog)
local VerifyRewardCalculator = require(ReplicatedStorage.Modules.Shared.VerifyRewardCalculator)
local MainFunctions = require(ReplicatedStorage.Modules.UI.MainFunctions)
local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local SpinWheelConfig = require(ReplicatedStorage.Modules.Config.SpinWheelConfig)
local FavoriteGamePrompt = require(ReplicatedStorage.Modules.FavoriteGamePrompt)
local TutorialNotificationSystem = require(script.Parent:WaitForChild("TutorialNotificationSystem"))
local PlaytimeRewardsUI = require(script.Parent:WaitForChild("PlaytimeRewardsUI"))
local DailyRewardsUI = require(script.Parent:WaitForChild("DailyRewardsUI"))
local DailyRewardPromptController = require(script.Parent:WaitForChild("DailyRewardPromptController"))
local VerifyGroupController = require(script.Parent:WaitForChild("VerifyGroupController"))
local RewardCelebrationController = require(script.Parent:WaitForChild("RewardCelebrationController"))
local WinDisplayController = require(script.Parent:WaitForChild("WinDisplayController"))
local LevelDisplayController = require(script.Parent:WaitForChild("LevelDisplayController"))
local HudDisplayController = require(script.Parent:WaitForChild("HudDisplayController"))
local TrailDisplayController = require(script.Parent:WaitForChild("TrailDisplayController"))
local TrailShopController = require(script.Parent:WaitForChild("TrailShopController"))
local PlayerAttributeBindings = require(script.Parent:WaitForChild("PlayerAttributeBindings"))
local StageProgressBindings = require(script.Parent:WaitForChild("StageProgressBindings"))
local RemoteBindings = require(script.Parent:WaitForChild("RemoteBindings"))
local DisplayRefreshBindings = require(script.Parent:WaitForChild("DisplayRefreshBindings"))
local KartShopController = require(script.Parent:WaitForChild("KartShopController"))
local RewardedVideoClient = require(ReplicatedStorage.Modules.RewardedVideoClient)
local MenuOpenController = require(script.Parent:WaitForChild("MenuOpenController"))
local WinStreakUI = require(script.Parent:WaitForChild("WinStreakUI"))
local DEFAULT_PLAYER_SPEED = if typeof(PlayerHandler.DEFAULT_ATTRIBUTES.Player_Speed) == "number"
	then PlayerHandler.DEFAULT_ATTRIBUTES.Player_Speed
	else 16
local DEFAULT_MAX_PLAYER_SPEED = if typeof(PlayerHandler.DEFAULT_ATTRIBUTES.Max_Player_Speed) == "number"
	then PlayerHandler.DEFAULT_ATTRIBUTES.Max_Player_Speed
	else 16

local MainOrchestrator = {}
local DEBUG_TROLL_FRAME_ONLY_FOR_ME = false -- Enabled to allow self-testing as requested
local DEBUG_LOADING_DETAILS = false
local STARTUP_LOADING_ENABLED = true
local hasCompletedStartupLoading = false
local verifyRewardConfig = VerifyRewardCalculator.GetConfig(CoreConfig)
local VERIFY_REWARD_CLAIM_COUNT_ATTRIBUTE = verifyRewardConfig.claimCountAttribute
local VERIFY_REWARD_NEXT_CLAIM_ATTRIBUTE = "VerifyRewardNextClaimUnix"
local VERIFY_REWARD_COUNTDOWN_UPDATE_INTERVAL = 1
local RETURN_TO_STAGE_BUTTON_SPLIT_POSITION = UDim2.new(0.261, 0, 0.484, 0)
local RETURN_TO_STAGE_BUTTON_CENTER_POSITION = UDim2.new(0.5, 0, 0.484, 0)
local WHEEL_BACKGROUND_COLOR = Color3.fromRGB(254, 199, 41)
local WHEEL_GRADIENT_BOTTOM_COLOR = Color3.fromRGB(255, 85, 0)
local EQUIP_BACKGROUND_COLOR = Color3.fromRGB(0, 255, 0)
local EQUIP_GRADIENT_BOTTOM_COLOR = Color3.fromRGB(0, 130, 15)
local DISABLE_WAVE_PURCHASE_WATCHDOG_SECONDS = 30
local DISABLE_WAVE_NOTIFICATION_KEY = "DisableWavesCooldown"
local DISABLE_WAVE_NOTIFICATION_MESSAGE = "WAVES DISABLED!"

local function applyReturnToStageAdLayout(frame: Frame, adAvailable: boolean)
	local paidButton = frame:FindFirstChild("ReturnToStageButton", true)
	if paidButton and paidButton:IsA("GuiObject") then
		paidButton.Position = if adAvailable
			then RETURN_TO_STAGE_BUTTON_SPLIT_POSITION
			else RETURN_TO_STAGE_BUTTON_CENTER_POSITION
	end

	local watchAdFrame = frame:FindFirstChild("WatchAdButton", true)
	if watchAdFrame and watchAdFrame:IsA("GuiObject") then
		watchAdFrame.Visible = adAvailable
	end

	local orLabel = frame:FindFirstChild("TextLabel")
	if orLabel and orLabel:IsA("TextLabel") then
		orLabel.Visible = adAvailable
	end
end

local function isLiveEventActive(eventId: string?): boolean
	if typeof(eventId) ~= "string" or eventId == "" then
		return false
	end

	local liveEventState = ReplicatedStorage:FindFirstChild("LiveEventState")
	if not liveEventState then
		return false
	end

	local activeEventIds = liveEventState:GetAttribute("ActiveEventIds")
	return typeof(activeEventIds) == "string"
		and string.find("," .. activeEventIds .. ",", "," .. eventId .. ",", 1, true) ~= nil
end

local function getKartEventId(config: { [string]: any }): string?
	local eventId = config.eventId
	if typeof(eventId) ~= "string" or eventId == "" then
		eventId = config.sourceSubfolder
	end
	return if typeof(eventId) == "string" and eventId ~= "" then eventId else nil
end

local function isEventKartConfig(config: { [string]: any }): boolean
	return getKartEventId(config) ~= nil
end

local function canBuyEventProduct(config: { [string]: any }, isOwned: boolean): boolean
	local eventId = getKartEventId(config)
	return not isOwned
		and eventId ~= nil
		and typeof(config.productKey) == "string"
		and isLiveEventActive(eventId)
end

local function formatTrailMultiplier(multiplier: number): string
	local text = string.format("%.2f", multiplier)
	text = text:gsub("%.00$", "")
	text = text:gsub("(%..-)0$", "%1")
	return text
end

local function getOrCreateEquipButton(entryFrame: Frame): Frame?
	local existing = entryFrame:FindFirstChild("EquipButton")
	if existing and existing:IsA("Frame") then
		return existing
	end

	local buyButton = entryFrame:FindFirstChild("BuyButton")
	if not buyButton or not buyButton:IsA("Frame") then
		return nil
	end

	local equipButton = buyButton:Clone()
	equipButton.Name = "EquipButton"
	equipButton.Parent = entryFrame

	local textButton = equipButton:FindFirstChild("TextButton", true)
	if textButton and textButton:IsA("TextButton") then
		textButton.Text = "EQUIP"
	end

	return equipButton
end

local function applyWheelStyle(frame: Frame)
	frame.BackgroundColor3 = WHEEL_BACKGROUND_COLOR
	frame:SetAttribute("OriginalDisabledBaseColor", nil)
	local gradient = frame:FindFirstChildOfClass("UIGradient")
	if not gradient then
		gradient = Instance.new("UIGradient")
		gradient.Parent = frame
	end
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, WHEEL_GRADIENT_BOTTOM_COLOR),
	})
	VisualFunctions.RefreshFrameInteractionColors(frame)
end

local function applyEquipStyle(frame: Frame)
	frame.BackgroundColor3 = EQUIP_BACKGROUND_COLOR
	local gradient = frame:FindFirstChildOfClass("UIGradient")
	if not gradient then
		gradient = Instance.new("UIGradient")
		gradient.Parent = frame
	end
	gradient.Rotation = 90
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
		ColorSequenceKeypoint.new(1, EQUIP_GRADIENT_BOTTOM_COLOR),
	})
	VisualFunctions.RefreshFrameInteractionColors(frame)
end

local function openSpinWheelFromShop(player: Player)
	MainFunctions.SetFrameVisibleSimple("TrailFrame", false)
	MainFunctions.SetFrameVisibleSimple("KartFrame", false)
	local requestId = player:GetAttribute("SpinWheelOpenRequested")
	local nextRequestId = if typeof(requestId) == "number" then requestId + 1 else 1
	player:SetAttribute("SpinWheelOpenRequested", nextRequestId)
end

function MainOrchestrator.Init(root: Instance)
	if root:GetAttribute("MainOrchestratorInitialized") == true then
		DebugModule.debugWarn(
			"MainOrchestrator.Init called more than once for " .. root:GetFullName(),
			"MainOrchestrator"
		)
		return
	end

	root:SetAttribute("MainOrchestratorInitialized", true)
	root:SetAttribute("StartupLoadingComplete", false)
	root:SetAttribute("PostLoadingStartupComplete", false)
	hasCompletedStartupLoading = false

	DebugModule.debugPrint("Initializing Main GUI for " .. root.Name, "MainOrchestrator")
	local sessionMaid = Maid.new()
	local stageProgressTrackedPlayerMaids: { [Player]: Maid } = {}
	local stageProgressTrackedRootParts: { [Player]: BasePart } = {}
	local isCleanedUp = false
	local startupLoadingTask: thread? = nil
	local disableWaveCountdownTask: thread? = nil
	local disableWavePurchaseWatchdogTask: thread? = nil
	local disableWavePurchaseAttempt = 0
	local disableWavePurchaseInFlight = false
	local disableWaveNotificationCooldownEnd = 0
	local function cancelThread(thread: thread?)
		if thread and coroutine.status(thread) ~= "dead" then
			pcall(task.cancel, thread)
		end
	end
	local function cancelDisableWavePurchaseWatchdog()
		disableWavePurchaseAttempt += 1
		if disableWavePurchaseWatchdogTask then
			cancelThread(disableWavePurchaseWatchdogTask)
			disableWavePurchaseWatchdogTask = nil
		end
	end
	local function updateDisableWaveButtonInteraction()
		local frame = VisualFunctions.HUD.DisableWaveButtonFrame
		if not frame then
			return
		end

		local rawCooldownEnd = Players.LocalPlayer:GetAttribute("DisableWavesCooldownEnd")
		local cooldownEnd = if typeof(rawCooldownEnd) == "number" then math.floor(rawCooldownEnd) else 0
		local isOnCooldown = cooldownEnd > os.time()
		VisualFunctions.SetFrameInteractableState(frame, not isOnCooldown and not disableWavePurchaseInFlight)
	end

	if VisualFunctions.ResetRuntimeState then
		VisualFunctions.ResetRuntimeState()
	end

	local function cleanupInitSession()
		if isCleanedUp then
			return
		end

		isCleanedUp = true
		root:SetAttribute("MainOrchestratorInitialized", false)
		root:SetAttribute("StartupLoadingComplete", false)
		root:SetAttribute("PostLoadingStartupComplete", false)
		sessionMaid:DoCleaning()
		if VisualFunctions.ResetRuntimeState then
			VisualFunctions.ResetRuntimeState()
		end
	end

	sessionMaid:GiveTask(root.Destroying:Connect(cleanupInitSession))
	sessionMaid:GiveTask(root.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			cleanupInitSession()
		end
	end))

	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local kartActionRemote = remotes:WaitForChild("KartAction") :: RemoteEvent
	local returnToStagePromptOpenedRemote = remotes:WaitForChild("ReturnToStagePromptOpened") :: RemoteEvent
	local trollActionRequestRemote = remotes:WaitForChild("TrollActionRequest") :: RemoteEvent
	local dataRecoveryRequestRemote = remotes:WaitForChild("DataRecoveryRequest") :: RemoteEvent
	local dataRecoveryResultRemote = remotes:WaitForChild("DataRecoveryResult") :: RemoteEvent
	local hideReturnToStageFrame: () -> () = function() end
	local localPlayer = Players.LocalPlayer
	local hasShownFavoriteGamePrompt = false
	local function promptFavoriteGameIfReady()
		if
			hasShownFavoriteGamePrompt
			or not hasCompletedStartupLoading
			or localPlayer:GetAttribute("Data_Loaded") ~= true
		then
			return
		end

		hasShownFavoriteGamePrompt = true
		sessionMaid:GiveTask(
			FavoriteGamePrompt.StartDeferredPrompt(localPlayer, function(): boolean
				return not isCleanedUp
			end)
		)
	end
	local canUseTrollFrame = true
	local allowSelfTargetingInTrollDebug = RunService:IsStudio() and DEBUG_TROLL_FRAME_ONLY_FOR_ME

	local trollFrame: Frame? = nil
	local trollNameLabel: TextLabel? = nil
	local trollPreviousButton: GuiButton? = nil
	local trollNextButton: GuiButton? = nil
	local trollButtonFrame: GuiObject? = nil
	local trollActionButtons: { [string]: GuiButton } = {}
	local syncTrollCamera: () -> ()
	local trollSelectedPlayer: Player? = nil
	local trollSpectateConnection: RBXScriptConnection? = nil
	local trollSelectedCharacterAddedConnection: RBXScriptConnection? = nil
	local trollSelectedCharacterRemovingConnection: RBXScriptConnection? = nil
	local jumpscareImage: ImageLabel? = nil
	local jumpscareHideToken = 0
	local trollMovementLockState: {
		humanoid: Humanoid?,
		walkSpeed: number?,
		jumpHeight: number?,
		autoRotate: boolean?,
	} =
		{
			humanoid = nil,
			walkSpeed = nil,
			jumpHeight = nil,
			autoRotate = nil,
		}
	local loadingMovementLockState: {
		humanoid: Humanoid?,
		walkSpeed: number?,
		jumpHeight: number?,
		autoRotate: boolean?,
		onLoadingComplete: () -> (),
	} =
		{
			humanoid = nil,
			walkSpeed = nil,
			jumpHeight = nil,
			autoRotate = nil,
			onLoadingComplete = function() end,
		}
	local loadingFrame: Frame? = nil
	local loadingImage: ImageLabel? = nil
	local loadingGameImage: ImageLabel? = nil
	local loadingLightRay: ImageLabel? = nil
	local loadingLevelsBarFrame: Frame? = nil
	local loadingProgressFrame: Frame? = nil
	local loadingProgressLabel: TextLabel? = nil
	local loadingCurrentLabel: TextLabel? = nil
	local loadingSkipButtonFrame: GuiObject? = nil
	local loadingSkipButton: GuiButton? = nil
	local loadingDataRecoveryFrame: Frame? = nil
	local loadingDataRecoveryWarningLabel: TextLabel? = nil
	local loadingDataRecoveryAttemptsLabel: TextLabel? = nil
	local loadingDataRecoveryRetryButton: GuiButton? = nil
	local loadingDataRecoveryResetButton: GuiButton? = nil
	local loadingDataRecoveryPopScale: UIScale? = nil
	local loadingDataRecoveryPopTween: Tween? = nil
	local dataRecoveryRequestInFlight = false
	local runStartupLoading: () -> () = function() end
	local tutorialSystem: any? = nil
	local loadingProgressTween: Tween? = nil
	local loadingCurrentLabelTween: Tween? = nil
	local loadingCurrentLabelText = ""
	local loadingProgressFloor = 0
	local loadingSkipRequested = false
	local verifyGroupCountdownLabel: TextLabel? = nil
	local verifyRewardWhenLabel: TextLabel? = nil
	local refreshVerifyCountdownLabel: (() -> ())? = nil
	local verifyRewardXPLabel: TextLabel? = nil
	local verifyRewardWinsLabel: TextLabel? = nil
	local refreshVerifyRewardValueLabels: (() -> ())? = nil
	local verifyGroupController: any = nil
	local stageProgressFrame: Frame? = nil
	local stageProgressTrackFrame: Frame? = nil
	local stageProgressMarkersFrame: Frame? = nil
	local stageProgressMarkerTemplate: GuiObject? = nil
	local stageProgressAvatarTemplate: ImageLabel? = nil
	local stageProgressCurrentStageLabel: TextLabel? = nil
	local stageProgressCurrentWorldLabel: TextLabel? = nil
	local stageProgressMarkerClones: { GuiObject } = {}
	local stageProgressPlayerMarkers: { [number]: ImageLabel } = {}
	local stageProgressPlayerMarkerMissingUntil: { [number]: number } = {}
	local stageProgressAvatarCache: { [number]: string } = {}
	local stageProgressWorldName: string? = nil
	local stageProgressStartPosition: Vector3? = nil
	local stageProgressEndPosition: Vector3? = nil
	local STAGE_PROGRESS_MARKER_MISSING_GRACE = 2
	local STAGE_PROGRESS_MARKER_UPDATE_INTERVAL = 0.1
	local STAGE_PROGRESS_WORLD_STYLES = {
		World1 = {
			backgroundColor = Color3.fromRGB(85, 255, 0),
		},
		Fallback = {
			backgroundColor = Color3.fromRGB(255, 255, 255),
		},
	}
	local rebirthReadyUIState = {
		buttonFrame = nil :: GuiObject?,
		template = nil :: GuiObject?,
		badge = nil :: GuiObject?,
		refresh = nil :: (() -> ())?,
		wasReady = false,
		notificationPending = false,
		skipNotificationUntil = 0,
	}
	local kartPurchaseUIState = {
		buttonFrame = nil :: GuiObject?,
		template = nil :: GuiObject?,
		badge = nil :: GuiObject?,
		refresh = nil :: (() -> ())?,
	}
	local trailAffordableUIState = {
		buttonFrame = nil :: GuiObject?,
		template = nil :: GuiObject?,
		badge = nil :: GuiObject?,
		refresh = nil :: (() -> ())?,
	}
	local playtimeClaimableUIState = {
		buttonFrame = nil :: GuiObject?,
		template = nil :: GuiObject?,
		badge = nil :: GuiObject?,
