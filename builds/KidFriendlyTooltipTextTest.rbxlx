        <Item class="ModuleScript" referent="3524">
          <Properties>
            <string name="Name">DailyRewardsConfig</string>
            <string name="Source"><![CDATA[local DailyRewardsConfig = {}

export type RewardKind = "XPSpeed" | "Wins" | "Level" | "Rebirth"

export type DailyRewardDefinition = {
	day: number,
	kind: RewardKind,
	amount: number,
	levelRequirementPercent: number?,
	currentWinsPercent: number?,
	topColor: Color3,
	bottomColor: Color3,
	image: string,
}

DailyRewardsConfig.DAY_COUNT = 7
DailyRewardsConfig.SECONDS_PER_DAY = 24 * 60 * 60
DailyRewardsConfig.MIN_TIMEZONE_OFFSET_MINUTES = -14 * 60
DailyRewardsConfig.MAX_TIMEZONE_OFFSET_MINUTES = 14 * 60
DailyRewardsConfig.CYCLE_SCALE_MULTIPLIER = 1.1
DailyRewardsConfig.CURRENT_DAY_ATTRIBUTE = "DailyRewardCurrentDay"
DailyRewardsConfig.NEXT_CLAIM_ATTRIBUTE = "DailyRewardNextClaimUnix"
DailyRewardsConfig.CYCLE_COUNT_ATTRIBUTE = "DailyRewardCycleCount"

local REWARDS: { DailyRewardDefinition } = table.freeze({
	{
		day = 1,
		kind = "XPSpeed",
		amount = 5000,
		levelRequirementPercent = 0.05,
		topColor = Color3.fromRGB(255, 78, 78),
		bottomColor = Color3.fromRGB(206, 0, 3),
		image = "rbxassetid://125552789489073",
	},
	{
		day = 2,
		kind = "Wins",
		amount = 100,
		currentWinsPercent = 0.05,
		topColor = Color3.fromRGB(254, 199, 41),
		bottomColor = Color3.fromRGB(255, 85, 0),
		image = "rbxassetid://104709782370430",
	},
	{
		day = 3,
		kind = "XPSpeed",
		amount = 10000,
		levelRequirementPercent = 0.15,
		topColor = Color3.fromRGB(255, 78, 78),
		bottomColor = Color3.fromRGB(206, 0, 3),
		image = "rbxassetid://125552789489073",
	},
	{
		day = 4,
		kind = "Wins",
		amount = 250,
		currentWinsPercent = 0.10,
		topColor = Color3.fromRGB(254, 199, 41),
		bottomColor = Color3.fromRGB(255, 85, 0),
		image = "rbxassetid://104709782370430",
	},
	{
		day = 5,
		kind = "Level",
		amount = 5,
		topColor = Color3.fromRGB(88, 216, 255),
		bottomColor = Color3.fromRGB(0, 81, 255),
		image = "rbxassetid://106046877471425",
	},
	{
		day = 6,
		kind = "XPSpeed",
		amount = 25000,
		levelRequirementPercent = 0.35,
		topColor = Color3.fromRGB(255, 78, 78),
		bottomColor = Color3.fromRGB(206, 0, 3),
		image = "rbxassetid://125552789489073",
	},
	{
		day = 7,
		kind = "Rebirth",
		amount = 1,
		topColor = Color3.fromRGB(227, 74, 255),
		bottomColor = Color3.fromRGB(74, 3, 255),
		image = "rbxassetid://138330067069857",
	},
})

DailyRewardsConfig.REWARDS = REWARDS

function DailyRewardsConfig.GetReward(day: number): DailyRewardDefinition?
	return REWARDS[day]
end

function DailyRewardsConfig.GetScaledAmount(reward: DailyRewardDefinition, cycleCount: number): number
	if reward.kind ~= "XPSpeed" and reward.kind ~= "Wins" then
		return reward.amount
	end

	local safeCycleCount = math.max(0, math.floor(cycleCount))
	return math.round(reward.amount * (DailyRewardsConfig.CYCLE_SCALE_MULTIPLIER ^ safeCycleCount))
end

function DailyRewardsConfig.GetLocalDayKey(unixTimestamp: number, timezoneOffsetMinutes: number): number
	local safeTimestamp = if typeof(unixTimestamp) == "number" and unixTimestamp == unixTimestamp
		then unixTimestamp
		else 0
	local safeOffset = math.clamp(
		math.round(timezoneOffsetMinutes),
		DailyRewardsConfig.MIN_TIMEZONE_OFFSET_MINUTES,
		DailyRewardsConfig.MAX_TIMEZONE_OFFSET_MINUTES
	)
	return math.floor((safeTimestamp + safeOffset * 60) / DailyRewardsConfig.SECONDS_PER_DAY)
end

function DailyRewardsConfig.GetNextLocalResetUnix(unixTimestamp: number, timezoneOffsetMinutes: number): number
	local safeOffset = math.clamp(
		math.round(timezoneOffsetMinutes),
		DailyRewardsConfig.MIN_TIMEZONE_OFFSET_MINUTES,
		DailyRewardsConfig.MAX_TIMEZONE_OFFSET_MINUTES
	)
	local currentDayKey = DailyRewardsConfig.GetLocalDayKey(unixTimestamp, safeOffset)
	return (currentDayKey + 1) * DailyRewardsConfig.SECONDS_PER_DAY - safeOffset * 60
end

function DailyRewardsConfig.GetRewardAmount(
	reward: DailyRewardDefinition,
	cycleCount: number,
	maxXPSpeed: number?,
	currentWins: number?
): number
	local baseAmount = DailyRewardsConfig.GetScaledAmount(reward, cycleCount)
	if reward.kind == "Wins" then
		local percentage = reward.currentWinsPercent
		if typeof(percentage) ~= "number" or percentage <= 0 then
			return baseAmount
		end

		local safeCurrentWins = if typeof(currentWins) == "number"
			and currentWins == currentWins
			and currentWins ~= math.huge
			and currentWins ~= -math.huge
			then math.max(0, currentWins)
			else 0
		local percentageAmount = math.round(safeCurrentWins * percentage)
		return math.max(baseAmount, percentageAmount)
	end

	if reward.kind ~= "XPSpeed" then
		return baseAmount
	end

	local percentage = reward.levelRequirementPercent
	if typeof(percentage) ~= "number" or percentage <= 0 then
		return baseAmount
	end

	local requiredXP = if typeof(maxXPSpeed) == "number"
		and maxXPSpeed == maxXPSpeed
		and maxXPSpeed ~= math.huge
		and maxXPSpeed ~= -math.huge
		then math.max(0, maxXPSpeed)
		else 0

	return baseAmount + math.round(requiredXP * percentage)
end

function DailyRewardsConfig.GetRewardLabel(kind: RewardKind, amount: number): string
	if kind == "XPSpeed" then
		return "SPEED"
	end
	if kind == "Wins" then
		return "WINS"
	end
	if kind == "Level" then
		return if amount == 1 then "LEVEL" else "LEVELS"
	end

	return if amount == 1 then "REBIRTH" else "REBIRTHS"
end

return DailyRewardsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3525">
          <Properties>
            <string name="Name">FunnelAnalytics_Client</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DebugModule = require(ReplicatedStorage.Modules:WaitForChild("DebugModule"))

local FunnelAnalytics = {}
local MODULE_NAME = "FunnelAnalytics_Client"
local REMOTE_NAME = "FunnelAnalyticsAction"
local MAX_CLIENT_ACTION_NAME_LENGTH = 64
local clientActionRemote: RemoteEvent? = nil

local function getClientActionRemote(): RemoteEvent?
	if clientActionRemote and clientActionRemote.Parent then
		return clientActionRemote
	end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		return nil
	end

	local remote = remotes:FindFirstChild(REMOTE_NAME)
	if remote and remote:IsA("RemoteEvent") then
		clientActionRemote = remote
		return remote
	end

	return nil
end

function FunnelAnalytics.FireClientAction(actionName: string, payload: { [string]: string | number | boolean }?)
	if typeof(actionName) ~= "string" or actionName == "" then
		return
	end

	local remote = getClientActionRemote()
	if not remote then
		DebugModule.debugWarn(
			string.format("Client analytics action skipped; remote missing | action=%s", actionName),
			MODULE_NAME
		)
		return
	end

	remote:FireServer(string.sub(actionName, 1, MAX_CLIENT_ACTION_NAME_LENGTH), payload or {})
end

return FunnelAnalytics
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3526">
          <Properties>
            <string name="Name">NumberFormatting</string>
            <string name="Source"><![CDATA[local NumberFormatting = {}

local SUFFIXES = {
	"",
	"K",
	"M",
	"B",
	"T",
	"Qd",
	"Qi",
	"Sx",
	"Sp",
	"Oc",
	"No",
	"Dc",
	"Ud",
	"Dd",
	"Td",
	"Qad",
	"Qid",
	"Sxd",
	"Spd",
	"Od",
	"Nd",
	"Vg",
}

-- Continue short-scale abbreviations through centillion. For example,
-- unvigintillion becomes Uvg and quadragintillion becomes Qag.
local UNIT_PREFIXES = {
	[1] = "U",
	[2] = "D",
	[3] = "T",
	[4] = "Qa",
	[5] = "Qi",
	[6] = "Sx",
	[7] = "Sp",
	[8] = "O",
	[9] = "N",
}
local TENS_SUFFIXES = {
	[2] = "Vg",
	[3] = "Tg",
	[4] = "Qag",
	[5] = "Qig",
	[6] = "Sxg",
	[7] = "Spg",
	[8] = "Og",
	[9] = "Ng",
}

for numberName = 21, 99 do
	local tens = math.floor(numberName / 10)
	local units = numberName % 10
	local tensSuffix = TENS_SUFFIXES[tens]
	if units == 0 then
		SUFFIXES[numberName + 2] = tensSuffix
	else
		SUFFIXES[numberName + 2] = UNIT_PREFIXES[units] .. tensSuffix
	end
end

SUFFIXES[102] = "Ce"

local function trimDecimalText(text: string): string
	text = text:gsub("%.00$", "")
	return text:gsub("(%..-)0$", "%1")
end

function NumberFormatting.FormatWithCommas(value: number): string
	local rounded = math.round(value)
	local formatted = string.format("%.0f", rounded)

	local count = 0
	repeat
		local updated
		updated, count = string.gsub(formatted, "^(-?%d+)(%d%d%d)", "%1,%2")
		formatted = updated
	until count == 0

	return formatted
end

function NumberFormatting.FormatNumber(value: number): string
	local magnitude = math.abs(value)
	if magnitude < 1000 then
		return NumberFormatting.FormatWithCommas(value)
	end

	local index = math.floor(math.log10(magnitude) / 3)
	index = math.clamp(index, 0, #SUFFIXES - 1)
	local suffix = SUFFIXES[index + 1]
	local shortValue = value / (10 ^ (index * 3))
	local text = trimDecimalText(string.format("%.2f", shortValue))

	return text .. suffix
end

function NumberFormatting.FormatCompactNumber(value: number): string
	local magnitude = math.abs(value)
	local suffixIndex = 1
	local compactValue = value

	while math.abs(compactValue) >= 1000 and suffixIndex < #SUFFIXES do
		compactValue /= 1000
		suffixIndex += 1
	end

	if suffixIndex == 1 then
		return NumberFormatting.FormatWithCommas(value)
	end

	local suffix = SUFFIXES[suffixIndex]
	if magnitude >= 1000 then
		if math.abs(compactValue) >= 100 then
			return string.format("%.0f%s", compactValue, suffix)
		elseif math.abs(compactValue) >= 10 then
			return trimDecimalText(string.format("%.1f%s", compactValue, suffix))
		end
		return trimDecimalText(string.format("%.2f%s", compactValue, suffix))
	end

	return NumberFormatting.FormatWithCommas(value)
end

return NumberFormatting
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3527">
