		RemoteBindings.Bind({
			remotes = remotes,
			sessionMaid = sessionMaid,
			localPlayer = localPlayer,
			onXPGainAwarded = function(amount: number)
				if amount <= 0 then
					return
				end

				VisualFunctions.CreateFloatingText(VisualFunctions.HUD.Float_CurrentSpeedFrame, amount, 1)
			end,
			onWinAwarded = winDisplayController:GetWinAwardedHandler(),
			onEventWinAwarded = winDisplayController:GetEventWinAwardedHandler(),
			onVerifyRewardResult = function(success: boolean, nextClaimUnix: number?)
				refreshVerifyClaimableBadge()
				updateVerifyGroupCountdown(nextClaimUnix)
				if success then
					local verifyFrame = VisualFunctions.ActiveFrameGroup.VerifyFrame
					if verifyFrame then
						VisualFunctions.CloseWindow(verifyFrame)
					end

					local theme = VisualFunctions.NotificationThemes.Gold
					showNotificationRespectingTutorial(
						"VERIFY REWARD CLAIMED!",
						theme.textColor,
						theme.gradientBottomColor
					)
				else
					local theme = VisualFunctions.NotificationThemes.Red
					showNotificationRespectingTutorial("VERIFY FAILED!", theme.textColor, theme.gradientBottomColor)
				end
			end,
			onRebirthResult = function()
				local function showRebirthNotification()
					SoundService.PlayGuiSound("Rebirth")
					local theme = VisualFunctions.NotificationThemes.Purple
					showNotificationRespectingTutorial(
						"YOU REBIRTHED!!",
						theme.textColor,
						theme.gradientBottomColor
					)
				end

				local rebirthFrame = VisualFunctions.ActiveFrameGroup.RebirthFrame
				if rebirthFrame and rebirthFrame.Visible then
					VisualFunctions.CloseWindow(rebirthFrame)
				end

				local skipNotificationUntil = if typeof(rebirthReadyUIState.skipNotificationUntil) == "number"
					then rebirthReadyUIState.skipNotificationUntil
					else 0
				if tick() < skipNotificationUntil then
					sessionMaid:GiveTask(task.delay(1.1, function()
						if not isCleanedUp then
							showRebirthNotification()
						end
					end))
				else
					showRebirthNotification()
				end
			end,
			onShowNotification = function(message: string, themeName: string?, notificationStyle: string?)
				local theme = if typeof(themeName) == "string" and VisualFunctions.NotificationThemes[themeName]
					then VisualFunctions.NotificationThemes[themeName]
					else VisualFunctions.NotificationThemes.Default
				showNotificationRespectingTutorial(
					message,
					theme.textColor,
					theme.gradientBottomColor,
					notificationStyle
				)
			end,
			onReturnToStageOffer = function(shouldShow: boolean, stage: number?, duration: number?)
				if shouldShow and typeof(stage) == "number" and typeof(duration) == "number" then
					showReturnToStageFrame(stage, duration)
				else
					hideReturnToStageFrame()
				end
			end,
			onOpenVerifyFrameRequested = function()
				local verifyFrame = VisualFunctions.ActiveFrameGroup.VerifyFrame
				if verifyFrame and not verifyFrame.Visible then
					SoundService.PlayGuiSound("Click")
					MainFunctions.ToggleFrame("VerifyFrame")
				end
			end,
			onTriggerJumpscare = function()
				SoundService.PlayGuiSound("Click", nil, {
					SoundId = 1631688574,
					Volume = 1,
					PlaybackSpeed = 1,
					AllowOverlap = true,
				})

				if not jumpscareImage then
					return
				end

				jumpscareImage.Visible = true
				jumpscareHideToken += 1
				local hideToken = jumpscareHideToken
				spawnSessionTask(function()
					task.wait(2)
					if hideToken ~= jumpscareHideToken then
						return
					end
					if jumpscareImage then
						jumpscareImage.Visible = false
					end
				end)
			end,
			onTrackedPlayerRemoving = function(removingPlayer: Player)
				if removingPlayer == trollSelectedPlayer then
					updateTrollSelection(nil)
					syncTrollCamera()
				end
			end,
			onLocalCharacterAdded = function()
				if STARTUP_LOADING_ENABLED and loadingFrame and loadingFrame.Visible and not hasCompletedStartupLoading then
					sessionMaid:GiveTask(task.defer(function()
						if not isCleanedUp then
							lockLocalMovementForLoading()
						end
					end))
				end
				sessionMaid:GiveTask(task.defer(function()
					if not isCleanedUp and hasCompletedStartupLoading and tutorialSystem then
						tutorialSystem:OnProgressChanged()
					end
				end))
			end,
			onRequestReturnToStageOffer = function()
				local requestRemote = remotes:WaitForChild("RequestReturnToStageOffer")
				if requestRemote:IsA("RemoteEvent") then
					requestRemote:FireServer()
				end
			end,
				onPromptProductPurchaseFinished = function(productId: number, wasPurchased: boolean)
				if productId == ProductService.DevProducts.DisableWaves then
					cancelDisableWavePurchaseWatchdog()
					disableWavePurchaseInFlight = false
					updateDisableWaveButton()
				end

				if productId == ProductService.DevProducts.SkipRebirth and wasPurchased then
					rebirthReadyUIState.skipNotificationUntil = tick() + 1.5
				end

				local theme = if wasPurchased
					then VisualFunctions.NotificationThemes.Green
					else VisualFunctions.NotificationThemes.Red
				local message = if wasPurchased then "PURCHASE SUCCESS!" else "PURCHASE FAILED!"
				showNotificationRespectingTutorial(message, theme.textColor, theme.gradientBottomColor)
			end,
			onPromptReturnToStageDeclined = function(productId: number, wasPurchased: boolean)
				if productId == ProductService.DevProducts.ReturnToStage and not wasPurchased then
					local returnToStageDeclined = remotes:WaitForChild("ReturnToStageDeclined")
					if returnToStageDeclined:IsA("RemoteEvent") then
						returnToStageDeclined:FireServer()
					end
				end
			end,
		})

		hudDisplayController:UpdateUI()
		updateMultiplierShop()
		updateDisableWavePrice()
		updateDisableWaveButton()
		updateReturnToStagePrice()
		updateShopButtons()
		productCache.buildKartShop()
		productCache.buildTrailShop()
		refreshKartPurchaseBadge()
		refreshAffordableTrailBadge()
		refreshPlaytimeClaimableBadge()
		dailyRewardPromptController:RefreshBadge()
		refreshVerifyClaimableBadge()
		updateVerifyRewardValueLabels()
		updateVerifyGroupCountdown(nil)
		if verifyGroupController then
			verifyGroupController:RefreshMembership()
		end
		tryRefreshStageProgress()
		sessionMaid:GiveTask(task.delay(0.5, function()
			updateX2WinShop()
			hudDisplayController:UpdateXPProductLabels()
			updateShopButtons()
			productCache.updateKartShop()
			refreshKartPurchaseBadge()
			productCache.updateTrailShop()
			refreshAffordableTrailBadge()
			refreshPlaytimeClaimableBadge()
			dailyRewardPromptController:RefreshBadge()
			refreshVerifyClaimableBadge()
			updateVerifyRewardValueLabels()
			updateVerifyGroupCountdown(nil)
			tryRefreshStageProgress()
		end))
		if winDisplayController then
			winDisplayController:SetDisplayedWinCount(player:GetAttribute("WinCount") or 0)
		end
		sessionMaid:GiveTask(RunService.Heartbeat:Connect(function(dt)
			stageProgressMarkerUpdateAccumulator =
				math.min(stageProgressMarkerUpdateAccumulator + dt, STAGE_PROGRESS_MARKER_UPDATE_INTERVAL * 3)
			if stageProgressMarkerUpdateAccumulator >= STAGE_PROGRESS_MARKER_UPDATE_INTERVAL then
				stageProgressMarkerUpdateAccumulator = 0
				if updateStageProgressPlayerMarkers and (not stageProgressFrame or stageProgressFrame.Visible) then
					updateStageProgressPlayerMarkers()
				end
			end

			verifyRewardCountdownAccumulator =
				math.min(verifyRewardCountdownAccumulator + dt, VERIFY_REWARD_COUNTDOWN_UPDATE_INTERVAL * 2)
			if verifyRewardCountdownAccumulator >= VERIFY_REWARD_COUNTDOWN_UPDATE_INTERVAL then
				verifyRewardCountdownAccumulator = 0
				refreshVerifyClaimableBadge()
				updateVerifyGroupCountdown(nil)
			end
		end))
		sessionMaid:GiveTask(task.defer(runStartupLoading))
	end

	DebugModule.debugPrint("Main GUI initialization complete", "MainOrchestrator")
end

return MainOrchestrator
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3551">
            <Properties>
              <string name="Name">MenuOpenController</string>
              <string name="Source"><![CDATA[--!strict

local GuiService = game:GetService("GuiService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Maid = require(ReplicatedStorage.Modules:WaitForChild("Maid"))
local TweenConfig = require(ReplicatedStorage.Modules.UI:WaitForChild("TweenConfig"))

local MenuOpenController = {}
MenuOpenController.__index = MenuOpenController

local OPEN_TWEEN_INFO = TweenConfig.MenuOpen
local CLOSE_TWEEN_INFO = TweenConfig.MenuClose
local HIDDEN_TRANSPARENCY = 1

type TweenTarget = {
	instance: Instance,
	propertyName: string,
	visibleValue: number,
}

export type Controller = {
	Destroy: (self: Controller) -> (),
}

type ControllerState = Controller & {
	frame: GuiObject?,
	maid: any,
	tweenMaid: any,
	tweenTargets: { TweenTarget },
	isMenuOpen: boolean,
	isDestroyed: boolean,
}

local function addTweenTarget(targets: { TweenTarget }, instance: Instance, propertyName: string)
	local currentValue = (instance :: any)[propertyName]
	if typeof(currentValue) ~= "number" then
		return
	end

	table.insert(targets, {
		instance = instance,
		propertyName = propertyName,
		visibleValue = currentValue,
	})
end

local function collectTweenTargets(frame: GuiObject): { TweenTarget }
	local targets: { TweenTarget } = {}

	if frame:IsA("Frame") then
		addTweenTarget(targets, frame, "BackgroundTransparency")
	end

	for _, descendant in ipairs(frame:GetDescendants()) do
		if descendant:IsA("TextLabel") or descendant:IsA("TextButton") or descendant:IsA("TextBox") then
			addTweenTarget(targets, descendant, "TextTransparency")
		end

		if descendant:IsA("UIStroke") then
			addTweenTarget(targets, descendant, "Transparency")
		end
	end

	return targets
end

local function setTargetTransparency(target: TweenTarget, transparency: number)
	(target.instance :: any)[target.propertyName] = transparency
end

function MenuOpenController.new(root: Instance): Controller
	local self = setmetatable({
		frame = nil :: GuiObject?,
		maid = Maid.new(),
		tweenMaid = Maid.new(),
		tweenTargets = {} :: { TweenTarget },
		isMenuOpen = false,
		isDestroyed = false,
	}, MenuOpenController) :: ControllerState

	local candidate = root:FindFirstChild("MenuOpen", true)
	if not candidate or not candidate:IsA("GuiObject") then
		return self
	end

	self.frame = candidate
	self.tweenTargets = collectTweenTargets(candidate)
	self.maid:GiveTask(self.tweenMaid)

	for _, target in ipairs(self.tweenTargets) do
		setTargetTransparency(target, HIDDEN_TRANSPARENCY)
	end
	candidate.Visible = false

	local function setMenuOpen(isOpen: boolean)
		if self.isDestroyed or not self.frame then
			return
		end

		self.isMenuOpen = isOpen
		self.tweenMaid:DoCleaning()

		if isOpen then
			self.frame.Visible = true
		end

		local closeCompletionTween: Tween? = nil
		for _, target in ipairs(self.tweenTargets) do
			local goal = if isOpen then target.visibleValue else HIDDEN_TRANSPARENCY
			local tween = TweenService:Create(
				target.instance,
				if isOpen then OPEN_TWEEN_INFO else CLOSE_TWEEN_INFO,
				{ [target.propertyName] = goal }
			)
			self.tweenMaid:GiveTask(tween)
			if not isOpen and not closeCompletionTween then
				closeCompletionTween = tween
				local frame = self.frame
				self.tweenMaid:GiveTask(tween.Completed:Connect(function()
					if not self.isDestroyed and not self.isMenuOpen and self.frame == frame then
						frame.Visible = false
					end
				end))
			end
			tween:Play()
		end
	end

	self.maid:GiveTask(GuiService.MenuOpened:Connect(function()
		setMenuOpen(true)
	end))
	self.maid:GiveTask(GuiService.MenuClosed:Connect(function()
		setMenuOpen(false)
	end))

	setMenuOpen(GuiService.MenuIsOpen)
	return self
end

function MenuOpenController:Destroy()
	if self.isDestroyed then
		return
	end

	self.isDestroyed = true
	self.maid:DoCleaning()
	if self.frame then
		self.frame.Visible = false
	end
end

return MenuOpenController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3552">
            <Properties>
              <string name="Name">MinigameUI</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ContentProvider = game:GetService("ContentProvider")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RobloxSoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)
local NotificationLayoutController = require(ReplicatedStorage.Modules.UI.MainGUI.NotificationLayoutController)

local MinigameUI = {}
MinigameUI.__index = MinigameUI

type ProgressFrameVisibilityControllerLike = {
	SetRaceParticipant: (self: ProgressFrameVisibilityControllerLike, isParticipant: boolean) -> (),
}

type MinigameUIObject = {
	screenGui: ScreenGui,
	root: Frame?,
	requiredPlayersLabel: TextLabel?,
	requiredPlayersOriginalVisible: boolean?,
	startingLabel: TextLabel?,
	messageLabel: TextLabel?,
	joinFrame: GuiObject?,
	joinButton: TextButton?,
	stageProgressFrame: GuiObject?,
	startingLabelOriginalVisible: boolean?,
	messageLabelOriginalVisible: boolean?,
	startSurfaceGui: SurfaceGui?,
	countdownSurfaceGui: SurfaceGui?,
	countdownSurfaceLabel: TextLabel?,
	startSurfaceGuiOriginalEnabled: boolean?,
	countdownSurfaceGuiOriginalEnabled: boolean?,
	countdownSurfaceLabelOriginalText: string?,
	countdownSound: Sound?,
	preloadThread: thread?,
	countdownSoundPlayed: boolean,
	world: Instance?,
	joinRequest: RemoteEvent?,
	joinResult: RemoteEvent?,
	raceNotification: RemoteEvent?,
	maid: any,
	runtimeMaid: any,
	originalRootVisible: boolean?,
	originalJoinVisible: boolean?,
	countdownThread: thread?,
	messageThread: thread?,
	messageToken: number,
	visibilityController: ProgressFrameVisibilityControllerLike?,
	runtimeBound: boolean,
	joinPending: boolean,
	joinAttemptToken: number,
	lastParticipant: boolean,
	initialized: boolean,
}

local LOCAL_PLAYER = Players.LocalPlayer
local MODULE_NAME = "MinigameUI"
local COUNTDOWN_SOUND_ID = "rbxassetid://100324658979992"
local ACTIVE_STATES: { [string]: boolean } = {
	Open = true,
	Grace = true,
	Starting = true,
	Countdown = true,
	Racing = true,
}

local function findMinigameWorld(): Instance?
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	return worldsFolder and worldsFolder:FindFirstChild("Minigame")
end

function MinigameUI.new(
	screenGui: ScreenGui,
	visibilityController: ProgressFrameVisibilityControllerLike?
): MinigameUIObject
	local root = screenGui:FindFirstChild("MinigameNotificationFrame")
	local rootFrame = if root and root:IsA("Frame") then root else nil
	local requiredPlayers = rootFrame and rootFrame:FindFirstChild("RequiredPlayers")
	local startingLabel = rootFrame and rootFrame:FindFirstChild("StartingLabel")
	local messageLabel = rootFrame and rootFrame:FindFirstChild("TextLabel")
	local joinFrame = rootFrame and rootFrame:FindFirstChild("JoinButtonFrame")
	local joinButton = joinFrame and joinFrame:FindFirstChild("TextButton")
	local stageProgressFrame = screenGui:FindFirstChild("StageProgressFrame")
	local countdownSound = Instance.new("Sound")
	countdownSound.Name = "MinigameCountdownLocal"
	countdownSound.SoundId = COUNTDOWN_SOUND_ID
	countdownSound.Volume = 1
	countdownSound.Looped = false
	countdownSound.Parent = RobloxSoundService

	return setmetatable({
		screenGui = screenGui,
		root = rootFrame,
		requiredPlayersLabel = if requiredPlayers and requiredPlayers:IsA("TextLabel") then requiredPlayers else nil,
		requiredPlayersOriginalVisible = if requiredPlayers and requiredPlayers:IsA("GuiObject")
			then requiredPlayers.Visible
			else nil,
		startingLabel = if startingLabel and startingLabel:IsA("TextLabel") then startingLabel else nil,
		messageLabel = if messageLabel and messageLabel:IsA("TextLabel") then messageLabel else nil,
		joinFrame = if joinFrame and joinFrame:IsA("GuiObject") then joinFrame else nil,
		joinButton = if joinButton and joinButton:IsA("TextButton") then joinButton else nil,
		stageProgressFrame = if stageProgressFrame and stageProgressFrame:IsA("GuiObject")
			then stageProgressFrame
			else nil,
		startingLabelOriginalVisible = if startingLabel and startingLabel:IsA("GuiObject")
			then startingLabel.Visible
			else nil,
		messageLabelOriginalVisible = if messageLabel and messageLabel:IsA("GuiObject")
			then messageLabel.Visible
			else nil,
		startSurfaceGui = nil,
		countdownSurfaceGui = nil,
		countdownSurfaceLabel = nil,
		startSurfaceGuiOriginalEnabled = nil,
		countdownSurfaceGuiOriginalEnabled = nil,
		countdownSurfaceLabelOriginalText = nil,
		countdownSound = countdownSound,
		preloadThread = nil,
		countdownSoundPlayed = false,
		world = nil,
		joinRequest = nil,
		joinResult = nil,
		raceNotification = nil,
		maid = Maid.new(),
		runtimeMaid = Maid.new(),
		originalRootVisible = if rootFrame then rootFrame.Visible else nil,
		originalJoinVisible = if joinFrame and joinFrame:IsA("GuiObject") then joinFrame.Visible else nil,
		countdownThread = nil,
		messageThread = nil,
		messageToken = 0,
		visibilityController = visibilityController,
		runtimeBound = false,
		joinPending = false,
		joinAttemptToken = 0,
		lastParticipant = false,
		initialized = false,
	}, MinigameUI)
end

local function formatSeconds(seconds: number): number
	return math.max(0, math.ceil(seconds))
end

function MinigameUI:cancelCountdown()
	if self.countdownThread then
		task.cancel(self.countdownThread)
		self.countdownThread = nil
	end
end

function MinigameUI:cancelMessage()
	self.messageToken += 1
	if self.messageThread then
		task.cancel(self.messageThread)
		self.messageThread = nil
	end
end

function MinigameUI:bindRaceSurfaceObjects(): boolean
	if not self.world then
		return false
	end

	local cooldownStart = self.world:FindFirstChild("CooldownStart")
	if not cooldownStart then
		return false
	end

	if self.startSurfaceGui and not self.startSurfaceGui:IsDescendantOf(cooldownStart) then
		self.startSurfaceGui = nil
		self.startSurfaceGuiOriginalEnabled = nil
	end
	if self.countdownSurfaceGui and not self.countdownSurfaceGui:IsDescendantOf(cooldownStart) then
		self.countdownSurfaceGui = nil
		self.countdownSurfaceGuiOriginalEnabled = nil
	end
	if self.countdownSurfaceLabel and not self.countdownSurfaceLabel:IsDescendantOf(cooldownStart) then
		self.countdownSurfaceLabel = nil
		self.countdownSurfaceLabelOriginalText = nil
	end

	local startSurfaceGui = cooldownStart:FindFirstChild("SurfaceGui1")
	if not self.startSurfaceGui and startSurfaceGui and startSurfaceGui:IsA("SurfaceGui") then
		self.startSurfaceGui = startSurfaceGui
		self.startSurfaceGuiOriginalEnabled = startSurfaceGui.Enabled
	end

	local countdownSurfaceGui = cooldownStart:FindFirstChild("SurfaceGui2")
	if not self.countdownSurfaceGui and countdownSurfaceGui and countdownSurfaceGui:IsA("SurfaceGui") then
		self.countdownSurfaceGui = countdownSurfaceGui
		self.countdownSurfaceGuiOriginalEnabled = countdownSurfaceGui.Enabled
	end

	local countdownFrame = self.countdownSurfaceGui and self.countdownSurfaceGui:FindFirstChild("Frame")
	local countdownSurfaceLabel = countdownFrame and countdownFrame:FindFirstChild("CountdownLabel")
	if not self.countdownSurfaceLabel and countdownSurfaceLabel and countdownSurfaceLabel:IsA("TextLabel") then
		self.countdownSurfaceLabel = countdownSurfaceLabel
		self.countdownSurfaceLabelOriginalText = countdownSurfaceLabel.Text
	end

	return self.countdownSurfaceLabel ~= nil
end

function MinigameUI:setMessage(message: string, duration: number)
	if not self.messageLabel then
		return
	end

	self:cancelMessage()
	self.messageLabel.Text = message
	local token = self.messageToken
	self.messageThread = task.spawn(function()
		task.wait(duration)
		if token ~= self.messageToken or not self.initialized then
			return
		end
		self.messageThread = nil
		self:refresh()
	end)
	-- Reconcile parent and child visibility after message state becomes active.
	self:refresh(false)
end

function MinigameUI:updateCountdownLoop()
	self:cancelCountdown()
	if not self.world then
		return
	end

	local state = self.world:GetAttribute("RaceState")
	if state ~= "Grace" and state ~= "Countdown" then
		return
	end

	self.countdownThread = task.spawn(function()
		while
			self.initialized
			and self.world
			and (self.world:GetAttribute("RaceState") == "Grace" or self.world:GetAttribute("RaceState") == "Countdown")
		do
			local state = self.world:GetAttribute("RaceState")
			local deadlineAttribute = if state == "Grace"
				then self.world:GetAttribute("GraceEndsAt")
				else self.world:GetAttribute("CountdownEndsAt")
			local deadline = if typeof(deadlineAttribute) == "number" then deadlineAttribute else 0
			local remaining = deadline - Workspace:GetServerTimeNow()

			local startingText: string
			local surfaceText = ""
			if state == "Countdown" then
				local countdownNumber = if remaining > 3
					then 3
					elseif remaining > 2 then 2
					elseif remaining > 1 then 1
					else 0
				startingText = if countdownNumber > 0
					then "STARTING IN " .. tostring(countdownNumber) .. " SECONDS"
					else "START!"
				surfaceText = if countdownNumber > 0 then tostring(countdownNumber) else "START!"
			else
				local seconds = formatSeconds(remaining)
				startingText = if seconds > 0 then "STARTING IN " .. tostring(seconds) .. " SECONDS" else "STARTING!"
			end

			if self.startingLabel then
				self.startingLabel.Text = startingText
			end
			if self.countdownSurfaceLabel then
				self.countdownSurfaceLabel.Text = surfaceText
			end
			task.wait(0.1)
		end
		self.countdownThread = nil
	end)
end

function MinigameUI:refresh(restartCountdown: boolean?)
	local root = self.root
	local world = self.world
	if not root then
		if self.visibilityController then
			self.visibilityController:SetRaceParticipant(false)
		end
		return
	end
	if not world or not self.runtimeBound then
		if self.visibilityController then
			self.visibilityController:SetRaceParticipant(false)
		end
		root.Visible = false
		if self.joinFrame then
			self.joinFrame.Visible = false
		end
		NotificationLayoutController.Refresh()
		return
	end
	self:bindRaceSurfaceObjects()

	local stateValue = world:GetAttribute("RaceState")
	local state = if typeof(stateValue) == "string" then stateValue else "Cooldown"
	local inWorld1 = LOCAL_PLAYER:GetAttribute("Current_World") == "World1"
	local participant = LOCAL_PLAYER:GetAttribute("MinigameParticipant") == true
	local hasTemporaryMessage = self.messageThread ~= nil
	local surfaceGuisVisible = state ~= "Racing"
	if self.startSurfaceGui then
		self.startSurfaceGui.Enabled = surfaceGuisVisible
	end
	if self.countdownSurfaceGui then
		self.countdownSurfaceGui.Enabled = surfaceGuisVisible
	end
	local visible = inWorld1
		and (
			(not participant and (state == "Open" or state == "Grace"))
			or (participant and ACTIVE_STATES[state] == true)
			or hasTemporaryMessage
		)
	root.Visible = visible

	if self.requiredPlayersLabel then
		local playerCountValue = world:GetAttribute("RacePlayerCount")
		local requiredPlayersValue = world:GetAttribute("RaceRequiredPlayers")
		local playerCount = if typeof(playerCountValue) == "number"
			then math.max(0, math.floor(playerCountValue))
			else 0
		local requiredPlayers = if typeof(requiredPlayersValue) == "number"
			then math.max(1, math.floor(requiredPlayersValue))
			else 5
		local raceLabelState = state == "Grace" or state == "Starting" or state == "Countdown" or state == "Racing"
		self.requiredPlayersLabel.Text = if state == "Racing"
			then "RACE TO THE FINISH!"
			else string.format("REQUIRED PLAYERS: %d/%d", playerCount, requiredPlayers)
		self.requiredPlayersLabel.Visible = visible and raceLabelState
	end

	if self.visibilityController then
		self.visibilityController:SetRaceParticipant(participant)
	elseif self.stageProgressFrame then
		self.stageProgressFrame.Visible = not participant
	end
	if self.joinButton then
		local joinable = visible and (state == "Open" or state == "Grace") and not participant and not self.joinPending
		self.joinButton.Active = joinable
		self.joinButton.AutoButtonColor = self.joinButton.Active
		self.joinButton.Text = if self.joinPending
			then "JOINING..."
			elseif participant then "JOINED"
			elseif state == "Racing" then "RACING"
			else "JOIN"
		if self.joinFrame then
			self.joinFrame.Visible = joinable
		end
	end

	local startingLabelVisible = visible and (state == "Grace" or state == "Starting" or state == "Countdown")
	local raceLabelsVisible = visible and state ~= "Racing"
	if self.startingLabel then
		self.startingLabel.Visible = startingLabelVisible
	end
	if self.messageLabel then
		self.messageLabel.Visible = visible
			and (hasTemporaryMessage or (raceLabelsVisible and self.messageLabelOriginalVisible ~= false))
	end

	if self.startingLabel then
		if state == "Starting" then
			self.startingLabel.Text = "STARTING..."
		elseif state ~= "Grace" and state ~= "Countdown" then
			self.startingLabel.Text = ""
		end
	end
	if self.messageLabel and self.messageThread == nil then
		self.messageLabel.Text = if state == "Racing" then "" else "JOIN THE RACE!"
	end

	if state == "Countdown" and not self.countdownSoundPlayed and self.countdownSound then
		self.countdownSound.TimePosition = 0
		self.countdownSound:Play()
		self.countdownSoundPlayed = true
	elseif state ~= "Countdown" then
		if self.countdownSound then
			self.countdownSound:Stop()
		end
		self.countdownSoundPlayed = false
	end

	if restartCountdown ~= false then
		self:updateCountdownLoop()
	end

	NotificationLayoutController.Refresh()
end

function MinigameUI:onRaceNotification(
	eventName: string,
	placement: number?,
	awardedWins: number?,
	awardedLevels: number?,
	message: string?
)
	if eventName == "RaceEnded" and typeof(message) == "string" then
		self:setMessage(message, 4)
	end
end

local function getJoinFailureMessage(reason: string): string
	if reason == "RaceFull" then
		return "RACE IS FULL!"
	end
	if reason == "RaceClosed" then
		return "RACE IS NOT OPEN!"
	end
	if reason == "WrongWorld" then
		return "RETURN TO WORLD 1 TO JOIN!"
	end
	if reason == "CharacterUnavailable" then
		return "RESPAWN BEFORE JOINING!"
	end
	if reason == "RateLimited" then
		return "PLEASE WAIT A MOMENT!"
	end
	return "COULD NOT JOIN RACE!"
end

function MinigameUI:tryBindRuntime(): boolean
	if
		self.runtimeBound
		and self.world
		and self.world.Parent
		and self.joinRequest
		and self.joinResult
		and self.raceNotification
	then
		return true
	end

	local world = findMinigameWorld()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local joinRequest = remotes and remotes:FindFirstChild("MinigameJoinRequest")
	local joinResult = remotes and remotes:FindFirstChild("MinigameJoinResult")
	local raceNotification = remotes and remotes:FindFirstChild("MinigameRaceNotification")
	if
		not self.root
		or not world
		or not joinRequest
		or not joinRequest:IsA("RemoteEvent")
		or not joinResult
		or not joinResult:IsA("RemoteEvent")
		or not raceNotification
		or not raceNotification:IsA("RemoteEvent")
	then
		self.runtimeBound = false
		self.world = nil
		self.joinRequest = nil
		self.joinResult = nil
		self.raceNotification = nil
		self:refresh(false)
		return false
	end

	self.runtimeMaid:DoCleaning()
	self.runtimeMaid = Maid.new()
	self.maid.RuntimeMaid = self.runtimeMaid
	self.world = world
	self.joinRequest = joinRequest
	self.joinResult = joinResult
	self.raceNotification = raceNotification
	self.runtimeBound = true
	self.joinPending = false
	self:bindRaceSurfaceObjects()

	self.runtimeMaid.JoinButton = if self.joinButton
		then self.joinButton.Activated:Connect(function()
			if not self.joinRequest or not self.joinButton or not self.joinButton.Active or self.joinPending then
				return
			end

			self.joinPending = true
			self.joinAttemptToken += 1
			local token = self.joinAttemptToken
			self:refresh(false)
			self.joinRequest:FireServer()
			local timeoutThread = task.delay(3, function()
				if self.initialized and self.joinPending and token == self.joinAttemptToken then
					self.joinPending = false
					self:setMessage("JOIN REQUEST TIMED OUT!", 3)
					self:refresh(false)
				end
			end)
			self.runtimeMaid.JoinTimeout = function()
				pcall(task.cancel, timeoutThread)
			end
		end)
		else nil
	self.runtimeMaid.JoinResult = joinResult.OnClientEvent:Connect(function(success: boolean, reason: string)
		self.joinPending = false
		self.joinAttemptToken += 1
		self.runtimeMaid.JoinTimeout = nil
		if success ~= true then
			self:setMessage(getJoinFailureMessage(reason), 3)
		end
		self:refresh()
	end)
	self.runtimeMaid.RaceNotification = raceNotification.OnClientEvent:Connect(function(...)
		self:onRaceNotification(...)
	end)
	self.runtimeMaid.RaceState = world:GetAttributeChangedSignal("RaceState"):Connect(function()
		self:refresh()
	end)
	self.runtimeMaid.RacePlayerCount = world:GetAttributeChangedSignal("RacePlayerCount"):Connect(function()
		self:refresh(false)
	end)
	self.runtimeMaid.RaceRequiredPlayers = world:GetAttributeChangedSignal("RaceRequiredPlayers"):Connect(function()
		self:refresh(false)
	end)
	self.runtimeMaid.RaceDeadline = world:GetAttributeChangedSignal("GraceEndsAt"):Connect(function()
		self:updateCountdownLoop()
	end)
	self.runtimeMaid.CountdownDeadline = world:GetAttributeChangedSignal("CountdownEndsAt"):Connect(function()
		self:updateCountdownLoop()
	end)
	self.runtimeMaid.SurfaceDescendantAdded = world.DescendantAdded:Connect(function(descendant: Instance)
		if
			descendant.Name == "CooldownStart"
			or descendant.Name == "SurfaceGui1"
			or descendant.Name == "SurfaceGui2"
			or descendant.Name == "Frame"
			or descendant.Name == "CountdownLabel"
		then
			if self:bindRaceSurfaceObjects() then
				self:refresh(false)
			end
		end
	end)
	self.runtimeMaid.WorldAncestry = world.AncestryChanged:Connect(function(_, parent)
		if parent == nil and self.world == world then
			self.runtimeBound = false
			self.world = nil
			self:cancelCountdown()
			self:refresh(false)
		end
	end)
	self:refresh()
	return true
end

function MinigameUI:bindDiscoveryListeners()
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	if worldsFolder then
		self.maid.MinigameAdded = worldsFolder.ChildAdded:Connect(function(child: Instance)
			if child.Name == "Minigame" then
				self:tryBindRuntime()
			end
		end)
	end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if remotes then
		self.maid.MinigameRemoteAdded = remotes.ChildAdded:Connect(function(child: Instance)
			if
				child.Name == "MinigameJoinRequest"
				or child.Name == "MinigameJoinResult"
				or child.Name == "MinigameRaceNotification"
			then
				self:tryBindRuntime()
			end
		end)
	end
end

function MinigameUI:Init()
	if self.initialized then
		return
	end
	self.initialized = true
	self.lastParticipant = LOCAL_PLAYER:GetAttribute("MinigameParticipant") == true
	self.preloadThread = task.spawn(function()
		local success, errorMessage = pcall(function()
			if self.countdownSound then
				ContentProvider:PreloadAsync({ self.countdownSound })
			end
		end)
		if not success then
			DebugModule.debugWarn("Countdown sound preload failed: " .. tostring(errorMessage), MODULE_NAME)
		end
	end)

	if self.requiredPlayersLabel then
		self.maid.RequiredPlayersVisibility = self.requiredPlayersLabel
			:GetPropertyChangedSignal("Visible")
			:Connect(function()
				if self.initialized then
					self:refresh(false)
				end
			end)
	end
	if self.startingLabel then
		self.maid.StartingLabelVisibility = self.startingLabel:GetPropertyChangedSignal("Visible"):Connect(function()
			if self.initialized then
				self:refresh(false)
			end
		end)
	end
	self.maid.WorldChanged = LOCAL_PLAYER:GetAttributeChangedSignal("Current_World"):Connect(function()
		self:refresh()
	end)
	self.maid.ParticipantChanged = LOCAL_PLAYER:GetAttributeChangedSignal("MinigameParticipant"):Connect(function()
		local isParticipant = LOCAL_PLAYER:GetAttribute("MinigameParticipant") == true
		local leftRace = self.lastParticipant and not isParticipant
		self.lastParticipant = isParticipant
		if not isParticipant then
			self:cancelMessage()
		end
		self.joinPending = false
		self:refresh()

		local raceState = self.world and self.world:GetAttribute("RaceState")
		if leftRace and (raceState == "Open" or raceState == "Grace") then
			self:setMessage("JOIN THE RACE!", 3)
		end
	end)
	self.maid.WorkspaceChildAdded = Workspace.ChildAdded:Connect(function(child: Instance)
		if child.Name == "Worlds" then
			self:bindDiscoveryListeners()
			self:tryBindRuntime()
		end
	end)
	self.maid.ReplicatedStorageChildAdded = ReplicatedStorage.ChildAdded:Connect(function(child: Instance)
		if child.Name == "Remotes" then
			self:bindDiscoveryListeners()
			self:tryBindRuntime()
		end
	end)
	self:bindDiscoveryListeners()
	if not self:tryBindRuntime() then
		DebugModule.debugInfo("Minigame UI waiting for streamed runtime objects", MODULE_NAME)
	end
end

function MinigameUI:Destroy()
	if not self.initialized then
		return
	end

	self.initialized = false
	self:cancelCountdown()
	self:cancelMessage()
	if self.preloadThread then
		task.cancel(self.preloadThread)
		self.preloadThread = nil
	end
	if self.countdownSound then
		self.countdownSound:Stop()
		self.countdownSound:Destroy()
		self.countdownSound = nil
	end
	self.maid:DoCleaning()
	if self.requiredPlayersLabel and self.requiredPlayersOriginalVisible ~= nil then
		self.requiredPlayersLabel.Visible = self.requiredPlayersOriginalVisible
	end
	if self.startingLabel and self.startingLabelOriginalVisible ~= nil then
		self.startingLabel.Visible = self.startingLabelOriginalVisible
	end
	if self.messageLabel and self.messageLabelOriginalVisible ~= nil then
		self.messageLabel.Visible = self.messageLabelOriginalVisible
	end
	if self.startSurfaceGui and self.startSurfaceGuiOriginalEnabled ~= nil then
		self.startSurfaceGui.Enabled = self.startSurfaceGuiOriginalEnabled
	end
	if self.countdownSurfaceGui and self.countdownSurfaceGuiOriginalEnabled ~= nil then
		self.countdownSurfaceGui.Enabled = self.countdownSurfaceGuiOriginalEnabled
	end
	if self.countdownSurfaceLabel and self.countdownSurfaceLabelOriginalText ~= nil then
		self.countdownSurfaceLabel.Text = self.countdownSurfaceLabelOriginalText
	end
	if self.visibilityController then
		self.visibilityController:SetRaceParticipant(false)
	elseif self.stageProgressFrame then
		self.stageProgressFrame.Visible = true
	end
	if self.root and self.originalRootVisible ~= nil then
		self.root.Visible = self.originalRootVisible
	end
	if self.joinFrame and self.originalJoinVisible ~= nil then
		self.joinFrame.Visible = self.originalJoinVisible
	end
	self.runtimeBound = false
	self.joinPending = false
	self.world = nil
	self.joinRequest = nil
	self.joinResult = nil
	self.raceNotification = nil
end

return MinigameUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3553">
            <Properties>
              <string name="Name">MouseTooltipController</string>
              <string name="Source"><![CDATA[--!strict

local UserInputService = game:GetService("UserInputService")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)
local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local TweenConfig = require(ReplicatedStorage.Modules.UI.TweenConfig)

local MouseTooltipController = {}
MouseTooltipController.__index = MouseTooltipController

type TooltipDefinition = {
	description: string | (() -> string),
	isEnabled: ((target: GuiObject) -> boolean)?,
	descriptionForTarget: ((target: GuiObject) -> string)?,
}

type TooltipVisualState = {
	textTransparency: number?,
	imageTransparency: number?,
	backgroundTransparency: number?,
	strokeTransparency: number?,
}

type TooltipPositionCandidate = {
	anchorPoint: Vector2,
	screenPosition: Vector2,
}

type MouseTooltipControllerObject = {
	screenGui: ScreenGui,
	playerGui: PlayerGui?,
	maid: any,
	tooltip: GuiObject?,
	bodyFrame: GuiObject?,
	descriptionLabel: TextLabel?,
	baseTooltipYScale: number,
	baseTooltipYOffset: number,
	baseDisplayOrder: number,
	tooltipScale: UIScale?,
	visualStates: { [Instance]: TooltipVisualState },
	animationTweens: { [Instance]: Tween },
	lastMousePosition: Vector2?,
	boundTargets: { [GuiObject]: TooltipDefinition },
	activeTarget: GuiObject?,
	initialized: boolean,
	alive: boolean,
	tooltipLayerActive: boolean,
}

local MODULE_NAME = "MouseTooltipController"
local SCREEN_PADDING = 6
local DESCRIPTION_VERTICAL_PADDING = 8
local BASE_TOOLTIP_SIZE = UDim2.new(0.13, 0, 0.038, 0)
local TOOLTIP_HIDDEN_SCALE = 0.94
local TOOLTIP_FADE_ALPHA = 0.82
local MAX_DESCRIPTION_LENGTH = #"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua."
local REFERENCE_VIEWPORT_HEIGHT = if CoreConfig.uiAdjuster
	and typeof(CoreConfig.uiAdjuster.referenceViewport) == "Vector2"
	then math.max(1, CoreConfig.uiAdjuster.referenceViewport.Y)
	else 1080

local TOOLTIP_DEFINITIONS: { [string]: TooltipDefinition } = table.freeze({
	InviteFriendsTopbar = {
		description = "Invite friends and unlock +0.10x for every new friend you bring in!",
	},
	PremiumMultiplierFrame = {
		description = "Premium gives you a permanent 1.25x XP Speed and Wins boost!",
	},
	TempSpeedBoostBuyFrame = {
		description = "Double your XP Speed for a while and level up faster!",
	},
	TempWinBoostBuyFrame = {
		description = "Double your Wins for a while and stack up rewards!",
	},
	SpinWheelButtonFrame = {
		description = "Spin the wheel for free turns and surprise rewards!",
	},
	DailyRewardButtonFrame = {
		description = "Come back each day to grab your next reward!",
	},
	DisableWaveButtonFrame = {
		description = function(): string
			local disableWavesConfig = CoreConfig.disableWaves
			local configuredDuration = if typeof(disableWavesConfig) == "table"
				and typeof(disableWavesConfig.durationSeconds) == "number"
				then disableWavesConfig.durationSeconds
				else 15
			local durationSeconds = math.max(1, math.floor(configuredDuration))
			return ("Take a wave break: waves stay off for %d seconds!"):format(durationSeconds)
		end,
	},
	StarterPackButtonFrame = {
		description = "Start strong with 10,000 XP Speed and 250 Wins!",
	},
	WinStreak = {
		description = "Reach stage 20 to grow your streak by +0.2x! Dying resets it.",
	},
	EventLabel = {
		description = "Check the event details and see what you can win!",
		isEnabled = function(target: GuiObject): boolean
			return target:GetAttribute("EventTooltipEnabled") == true
		end,
		descriptionForTarget = function(target: GuiObject): string
			local card = target:FindFirstAncestorWhichIsA("Frame")
			local description = card and card:GetAttribute("EventTooltipDescription")
			return if typeof(description) == "string" and description ~= ""
				then description
				else "Check the event details and see what you can win!"
		end,
	},
})

local INVITE_TOPBAR_WIDGET_NAME = "InviteFriendsTopbar"
local INVITE_TOPBAR_TARGET_NAME = "ClickRegion"

local HIDDEN_TOOLTIP_CHILDREN = table.freeze({
	"Image",
	"ProductImage",
	"PriceLabel",
	"CountdownLabel",
	"BuyButton",
	"WatchAdButton",
	"ExitButton",
})

for targetName, definition in pairs(TOOLTIP_DEFINITIONS) do
	local description = if typeof(definition.description) == "function"
		then definition.description()
		else definition.description
	assert(
		#description <= MAX_DESCRIPTION_LENGTH,
		("Tooltip description exceeds length limit: %s"):format(targetName)
	)
end

local function findGuiObject(root: Instance, name: string): GuiObject?
	local instance = root:FindFirstChild(name, true)
	if instance and instance:IsA("GuiObject") then
		return instance
	end

	return nil
end

local function findTextLabel(root: Instance, name: string): TextLabel?
	local instance = root:FindFirstChild(name, true)
	if instance and instance:IsA("TextLabel") then
		return instance
	end

	return nil
end

function MouseTooltipController.new(screenGui: ScreenGui): MouseTooltipControllerObject
	assert(screenGui:IsA("ScreenGui"), "MouseTooltipController requires a ScreenGui root")

	return setmetatable({
		screenGui = screenGui,
		playerGui = screenGui:FindFirstAncestorOfClass("PlayerGui") :: PlayerGui?,
		maid = Maid.new(),
		tooltip = nil,
		bodyFrame = nil,
		descriptionLabel = nil,
		baseTooltipYScale = 0,
		baseTooltipYOffset = 0,
		baseDisplayOrder = screenGui.DisplayOrder,
		tooltipScale = nil,
		visualStates = {},
		animationTweens = {},
		lastMousePosition = nil,
		boundTargets = {},
		activeTarget = nil,
		initialized = false,
		alive = true,
		tooltipLayerActive = false,
	}, MouseTooltipController) :: MouseTooltipControllerObject
end

function MouseTooltipController._getScreenBounds(
	self: MouseTooltipControllerObject
): (Vector2, Vector2, Vector2)
	local screenGuiPosition = self.screenGui.AbsolutePosition
	local screenGuiSize = self.screenGui.AbsoluteSize
	if screenGuiSize.X > 0 and screenGuiSize.Y > 0 then
		return screenGuiPosition, screenGuiSize, screenGuiPosition
	end

	local camera = Workspace.CurrentCamera
	if camera and camera.ViewportSize.X > 0 and camera.ViewportSize.Y > 0 then
		return Vector2.zero, camera.ViewportSize, screenGuiPosition
	end

	return screenGuiPosition, self.screenGui.AbsoluteSize, screenGuiPosition
end

function MouseTooltipController._resizeToDescription(
	self: MouseTooltipControllerObject,
	screenSize: Vector2
)
	local tooltip = self.tooltip
	local descriptionLabel = self.descriptionLabel
	if not tooltip or not descriptionLabel or descriptionLabel.Text == "" then
		return
	end

	local labelWidth = descriptionLabel.AbsoluteSize.X
	if labelWidth <= 0 then
		return
	end

	local measuredText = TextService:GetTextSize(
		descriptionLabel.Text,
		descriptionLabel.TextSize,
		descriptionLabel.Font,
		Vector2.new(labelWidth, math.huge)
	)
	local singleLineText = TextService:GetTextSize(
		"Ag",
		descriptionLabel.TextSize,
		descriptionLabel.Font,
		Vector2.new(labelWidth, math.huge)
	)
	local labelHeightScale = math.max(descriptionLabel.Size.Y.Scale, 0.01)
	local baseHeight = self.baseTooltipYScale * screenSize.Y + self.baseTooltipYOffset
	local singleLineHeight = math.max(1, singleLineText.Y)
	local additionalTextHeight = math.max(0, measuredText.Y - singleLineHeight)
	local viewportHeightRatio = math.clamp(screenSize.Y / REFERENCE_VIEWPORT_HEIGHT, 0.25, 1)
	local viewportTextScale = viewportHeightRatio ^ 2
	local scaledAdditionalTextHeight = additionalTextHeight * viewportTextScale
	local requiredHeight = baseHeight + math.ceil(scaledAdditionalTextHeight / labelHeightScale)
	if scaledAdditionalTextHeight > 0 then
		requiredHeight += DESCRIPTION_VERTICAL_PADDING
	end
	local maximumHeight = math.max(baseHeight, screenSize.Y - (SCREEN_PADDING * 2))
	local targetHeight = math.clamp(
		math.max(baseHeight, requiredHeight),
		baseHeight,
		maximumHeight
	)
	local currentSize = tooltip.Size
	local targetYScale = targetHeight / screenSize.Y

	if math.abs(currentSize.Y.Scale - targetYScale) > 0.001 or currentSize.Y.Offset ~= 0 then
		tooltip.Size = UDim2.new(
			currentSize.X.Scale,
			currentSize.X.Offset,
			targetYScale,
			0
		)
	end
end

function MouseTooltipController._updatePosition(self: MouseTooltipControllerObject)
	if not self.alive or not self.tooltip or not self.tooltip.Visible then
		return
	end

	local _, screenSize = self:_getScreenBounds()
	if screenSize.X <= 0 or screenSize.Y <= 0 then
		return
	end

	self:_resizeToDescription(screenSize)
	local mouseScreenPosition = UserInputService:GetMouseLocation()
	if mouseScreenPosition == Vector2.zero and self.lastMousePosition then
		mouseScreenPosition = self.lastMousePosition
	end
	local tooltipSize = self.tooltip.AbsoluteSize
	if tooltipSize.X <= 0 or tooltipSize.Y <= 0 then
		return
	end

	local topLeft: TooltipPositionCandidate = {
		anchorPoint = Vector2.new(1, 1),
		screenPosition = mouseScreenPosition,
	}
	local topRight: TooltipPositionCandidate = {
		anchorPoint = Vector2.new(0, 1),
		screenPosition = mouseScreenPosition,
	}
	local bottomLeft: TooltipPositionCandidate = {
		anchorPoint = Vector2.new(1, 0),
		screenPosition = mouseScreenPosition,
	}
	local bottomRight: TooltipPositionCandidate = {
		anchorPoint = Vector2.new(0, 0),
		screenPosition = mouseScreenPosition,
	}

	local isNearRightEdge = mouseScreenPosition.X > screenSize.X * 0.5
	local isNearBottomEdge = mouseScreenPosition.Y > screenSize.Y * 0.5
	local candidates: { TooltipPositionCandidate } = if isNearBottomEdge then
		if isNearRightEdge then { topLeft, topRight, bottomLeft, bottomRight }
		else { topRight, topLeft, bottomRight, bottomLeft }
	else if isNearRightEdge then { bottomLeft, bottomRight, topLeft, topRight }
	else { bottomRight, bottomLeft, topRight, topLeft }

	local function getAnchorOffset(anchorPoint: Vector2): Vector2
		return Vector2.new(tooltipSize.X * anchorPoint.X, tooltipSize.Y * anchorPoint.Y)
	end

	local function fits(candidate: TooltipPositionCandidate): boolean
		local topLeftPosition = candidate.screenPosition - getAnchorOffset(candidate.anchorPoint)
		local bottomRightPosition = topLeftPosition + tooltipSize
		return topLeftPosition.X >= SCREEN_PADDING
			and topLeftPosition.Y >= SCREEN_PADDING
			and bottomRightPosition.X <= screenSize.X - SCREEN_PADDING
			and bottomRightPosition.Y <= screenSize.Y - SCREEN_PADDING
	end

	local function clippingScore(candidate: TooltipPositionCandidate): number
		local topLeftPosition = candidate.screenPosition - getAnchorOffset(candidate.anchorPoint)
		local bottomRightPosition = topLeftPosition + tooltipSize
		return math.max(0, SCREEN_PADDING - topLeftPosition.X)
			+ math.max(0, SCREEN_PADDING - topLeftPosition.Y)
			+ math.max(0, bottomRightPosition.X - (screenSize.X - SCREEN_PADDING))
			+ math.max(0, bottomRightPosition.Y - (screenSize.Y - SCREEN_PADDING))
	end

	local chosenCandidate: TooltipPositionCandidate? = nil
	local leastClippedCandidate = candidates[1]
	local leastClippedScore = clippingScore(leastClippedCandidate)
	for _, candidate in ipairs(candidates) do
		if fits(candidate) then
			chosenCandidate = candidate
			break
		end

		local score = clippingScore(candidate)
		if score < leastClippedScore then
			leastClippedCandidate = candidate
			leastClippedScore = score
		end
	end

	local resolvedCandidate = chosenCandidate or leastClippedCandidate
	self.tooltip.AnchorPoint = resolvedCandidate.anchorPoint
	self.tooltip.Position = UDim2.fromOffset(
		resolvedCandidate.screenPosition.X,
		resolvedCandidate.screenPosition.Y
	)
end

function MouseTooltipController._cancelTooltipAnimations(self: MouseTooltipControllerObject)
	local activeTweens = table.clone(self.animationTweens)
	table.clear(self.animationTweens)
	for _, tween in pairs(activeTweens) do
		tween:Cancel()
	end
end

function MouseTooltipController._getFadedTransparency(original: number, alpha: number): number
	return math.clamp(original + ((1 - original) * alpha), 0, 1)
end

function MouseTooltipController._setTooltipVisualTransparency(
	self: MouseTooltipControllerObject,
	alpha: number
)
	for instance, visualState in pairs(self.visualStates) do
		if not instance.Parent then
			continue
		end

		if visualState.textTransparency ~= nil
			and (instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox"))
		then
			instance.TextTransparency = self._getFadedTransparency(visualState.textTransparency, alpha)
		end
		if visualState.imageTransparency ~= nil
			and (instance:IsA("ImageLabel") or instance:IsA("ImageButton"))
		then
			instance.ImageTransparency = self._getFadedTransparency(visualState.imageTransparency, alpha)
		end
		if visualState.backgroundTransparency ~= nil and instance:IsA("GuiObject") then
			instance.BackgroundTransparency = self._getFadedTransparency(
				visualState.backgroundTransparency,
				alpha
			)
		end
		if visualState.strokeTransparency ~= nil and instance:IsA("UIStroke") then
			instance.Transparency = self._getFadedTransparency(visualState.strokeTransparency, alpha)
		end
	end
end

function MouseTooltipController._getTooltipVisualGoals(
	self: MouseTooltipControllerObject,
	visualState: TooltipVisualState,
	alpha: number
): { [string]: any }
	local goals: { [string]: any } = {}
	if visualState.textTransparency ~= nil then
		goals.TextTransparency = self._getFadedTransparency(visualState.textTransparency, alpha)
	end
	if visualState.imageTransparency ~= nil then
		goals.ImageTransparency = self._getFadedTransparency(visualState.imageTransparency, alpha)
	end
	if visualState.backgroundTransparency ~= nil then
		goals.BackgroundTransparency = self._getFadedTransparency(
			visualState.backgroundTransparency,
			alpha
		)
	end
	if visualState.strokeTransparency ~= nil then
		goals.Transparency = self._getFadedTransparency(visualState.strokeTransparency, alpha)
	end
	return goals
end

function MouseTooltipController._playTooltipTween(
	self: MouseTooltipControllerObject,
	instance: Instance,
	tweenInfo: TweenInfo,
	goals: { [string]: any }
): Tween
	local previousTween = self.animationTweens[instance]
	if previousTween then
		previousTween:Cancel()
	end

	local tween = TweenService:Create(instance, tweenInfo, goals)
	self.animationTweens[instance] = tween
	local completedConnection: RBXScriptConnection?
	completedConnection = tween.Completed:Connect(function()
		if completedConnection then
			completedConnection:Disconnect()
			completedConnection = nil
		end
		if self.animationTweens[instance] == tween then
			self.animationTweens[instance] = nil
		end
	end)
	tween:Play()
	return tween
end

function MouseTooltipController._restoreTooltipLayer(self: MouseTooltipControllerObject)
	if self.tooltipLayerActive then
		self.screenGui.DisplayOrder = self.baseDisplayOrder
		self.tooltipLayerActive = false
	end
end

function MouseTooltipController._hide(self: MouseTooltipControllerObject, target: GuiObject?)
	if not self.alive or self.activeTarget ~= target then
		return
	end

	self.activeTarget = nil
	local tooltip = self.tooltip
	if not tooltip then
		self:_restoreTooltipLayer()
		return
	end

	self:_cancelTooltipAnimations()
	if not tooltip.Visible then
		self:_restoreTooltipLayer()
		return
	end

	local tooltipScale = self.tooltipScale
	if tooltipScale then
		local closeTween = self:_playTooltipTween(tooltipScale, TweenConfig.TooltipClose, {
			Scale = TOOLTIP_HIDDEN_SCALE,
		})
		local completedConnection: RBXScriptConnection?
		completedConnection = closeTween.Completed:Connect(function(playbackState: Enum.PlaybackState)
			if completedConnection then
				completedConnection:Disconnect()
				completedConnection = nil
			end
			if playbackState ~= Enum.PlaybackState.Completed
				or not self.alive
				or self.activeTarget ~= nil
				or self.tooltip ~= tooltip
			then
				return
			end
			tooltip.Visible = false
			tooltipScale.Scale = 1
			self:_setTooltipVisualTransparency(0)
			self:_restoreTooltipLayer()
		end)
	end

	for instance, visualState in pairs(self.visualStates) do
		local goals = self:_getTooltipVisualGoals(visualState, TOOLTIP_FADE_ALPHA)
		if next(goals) then
			self:_playTooltipTween(instance, TweenConfig.TooltipClose, goals)
		end
	end
end

function MouseTooltipController._raiseTooltipLayer(self: MouseTooltipControllerObject)
	if self.tooltipLayerActive then
		return
	end

	local highestDisplayOrder = self.baseDisplayOrder
	local playerGui = self.playerGui
	if playerGui then
		for _, child in ipairs(playerGui:GetChildren()) do
			if child:IsA("ScreenGui") and child ~= self.screenGui then
				highestDisplayOrder = math.max(highestDisplayOrder, child.DisplayOrder)
			end
		end
	end

	self.screenGui.DisplayOrder = highestDisplayOrder + 1
	self.tooltipLayerActive = true
end

function MouseTooltipController._animateTooltipSwitch(
	self: MouseTooltipControllerObject,
	target: GuiObject,
	description: string
)
	local tooltip = self.tooltip
	local descriptionLabel = self.descriptionLabel
	local tooltipScale = self.tooltipScale
	if not tooltip or not descriptionLabel or not tooltipScale then
		return
	end

	self:_updatePosition()
	local closeTween = self:_playTooltipTween(tooltipScale, TweenConfig.TooltipClose, {
		Scale = TOOLTIP_HIDDEN_SCALE,
	})
	local completedConnection: RBXScriptConnection?
	completedConnection = closeTween.Completed:Connect(function(playbackState: Enum.PlaybackState)
		if completedConnection then
			completedConnection:Disconnect()
			completedConnection = nil
		end
		if playbackState ~= Enum.PlaybackState.Completed
			or not self.alive
			or self.activeTarget ~= target
			or self.tooltip ~= tooltip
		then
			return
		end

		descriptionLabel.Text = description
		self:_updatePosition()
		self:_setTooltipVisualTransparency(TOOLTIP_FADE_ALPHA)
		tooltipScale.Scale = TOOLTIP_HIDDEN_SCALE
		self:_playTooltipTween(tooltipScale, TweenConfig.TooltipOpen, {
			Scale = 1,
		})
		for instance, visualState in pairs(self.visualStates) do
			local goals = self:_getTooltipVisualGoals(visualState, 0)
			if next(goals) then
				self:_playTooltipTween(instance, TweenConfig.TooltipOpen, goals)
			end
		end
	end)

	for instance, visualState in pairs(self.visualStates) do
		local goals = self:_getTooltipVisualGoals(visualState, TOOLTIP_FADE_ALPHA)
		if next(goals) then
			self:_playTooltipTween(instance, TweenConfig.TooltipClose, goals)
		end
	end
end

function MouseTooltipController._show(self: MouseTooltipControllerObject, target: GuiObject)
	if not self.alive then
		return
	end

	local definition = self.boundTargets[target]
	if not definition or not self.tooltip or not self.descriptionLabel then
		return
	end
	if definition.isEnabled and not definition.isEnabled(target) then
		return
	end

	local description = if definition.descriptionForTarget
		then definition.descriptionForTarget(target)
		elseif typeof(definition.description) == "function"
		then definition.description()
		else definition.description
	local wasVisible = self.tooltip.Visible
	self:_cancelTooltipAnimations()
	self.activeTarget = target
	self:_raiseTooltipLayer()
	self.tooltip.Visible = true
	if wasVisible then
		self:_animateTooltipSwitch(target, description)
		return
	else
		self.descriptionLabel.Text = description
		self:_setTooltipVisualTransparency(TOOLTIP_FADE_ALPHA)
		local tooltipScale = self.tooltipScale
		if tooltipScale then
			tooltipScale.Scale = TOOLTIP_HIDDEN_SCALE
			self:_playTooltipTween(tooltipScale, TweenConfig.TooltipOpen, {
				Scale = 1,
			})
		end
		for instance, visualState in pairs(self.visualStates) do
			local goals: { [string]: any } = {}
			if visualState.textTransparency ~= nil then
				goals.TextTransparency = visualState.textTransparency
			end
			if visualState.imageTransparency ~= nil then
				goals.ImageTransparency = visualState.imageTransparency
			end
			if visualState.backgroundTransparency ~= nil then
				goals.BackgroundTransparency = visualState.backgroundTransparency
			end
			if visualState.strokeTransparency ~= nil then
				goals.Transparency = visualState.strokeTransparency
			end
			if next(goals) then
				self:_playTooltipTween(instance, TweenConfig.TooltipOpen, goals)
			end
		end
	end
	self:_updatePosition()
end

function MouseTooltipController._bindTarget(
	self: MouseTooltipControllerObject,
	target: GuiObject,
	definition: TooltipDefinition
)
	if self.boundTargets[target] then
		return
	end

	self.boundTargets[target] = definition
	self.maid:GiveTask(target.MouseEnter:Connect(function(x: number, y: number)
		self.lastMousePosition = Vector2.new(x, y)
		self:_show(target)
	end))
	self.maid:GiveTask(target.MouseLeave:Connect(function()
		self.lastMousePosition = nil
		self:_hide(target)
	end))
	self.maid:GiveTask(target.MouseMoved:Connect(function(x: number, y: number)
		self.lastMousePosition = Vector2.new(x, y)
		if self.activeTarget == target then
			self:_updatePosition()
		end
	end))
	self.maid:GiveTask(target.Destroying:Connect(function()
		self.boundTargets[target] = nil
		self:_hide(target)
	end))
	if definition.isEnabled then
		self.maid:GiveTask(target:GetAttributeChangedSignal("EventTooltipEnabled"):Connect(function()
			if self.activeTarget == target and not definition.isEnabled(target) then
				self:_hide(target)
			end
		end))
	end
end

function MouseTooltipController._bindMainGuiTarget(
	self: MouseTooltipControllerObject,
	target: GuiObject
)
	local definition = TOOLTIP_DEFINITIONS[target.Name]
	if definition then
		self:_bindTarget(target, definition)
	end
end

function MouseTooltipController._findInviteTopbarTarget(
	self: MouseTooltipControllerObject,
	instance: Instance
): GuiObject?
	local widget = if instance:IsA("GuiObject") and instance.Name == INVITE_TOPBAR_WIDGET_NAME
		then instance
		else instance:FindFirstAncestor(INVITE_TOPBAR_WIDGET_NAME)
	if not widget or not widget:IsA("GuiObject") then
		return nil
	end

	local clickRegion = widget:FindFirstChild(INVITE_TOPBAR_TARGET_NAME, true)
	if clickRegion and clickRegion:IsA("GuiObject") then
		return clickRegion
	end

	return nil
end

function MouseTooltipController._bindInviteTopbarTarget(
	self: MouseTooltipControllerObject,
	instance: Instance
)
	local target = self:_findInviteTopbarTarget(instance)
	local definition = TOOLTIP_DEFINITIONS[INVITE_TOPBAR_WIDGET_NAME]
	if target and definition then
		self:_bindTarget(target, definition)
	end
end

function MouseTooltipController._configureTooltip(self: MouseTooltipControllerObject): boolean
	local tooltip = findGuiObject(self.screenGui, "MouseTooltip")
	if not tooltip then
		DebugModule.debugWarn("MouseTooltip frame was not found", MODULE_NAME)
		return false
	end

	local bodyFrame = findGuiObject(tooltip, "BodyFrame")
	local descriptionLabel = findTextLabel(tooltip, "DescriptionLabel")
	if not bodyFrame or not descriptionLabel then
		DebugModule.debugWarn("MouseTooltip requires BodyFrame and DescriptionLabel", MODULE_NAME)
		return false
	end

	self.tooltip = tooltip
	self.bodyFrame = bodyFrame
	self.descriptionLabel = descriptionLabel
	self.baseTooltipYScale = BASE_TOOLTIP_SIZE.Y.Scale
	self.baseTooltipYOffset = BASE_TOOLTIP_SIZE.Y.Offset
	local tooltipScale = tooltip:FindFirstChild("TooltipAnimationScale")
	if tooltipScale and not tooltipScale:IsA("UIScale") then
		tooltipScale = nil
	end
	if not tooltipScale then
		local newTooltipScale = Instance.new("UIScale")
		newTooltipScale.Name = "TooltipAnimationScale"
		newTooltipScale.Scale = 1
		newTooltipScale.Parent = tooltip
		tooltipScale = newTooltipScale
	end
	self.tooltipScale = tooltipScale :: UIScale
	table.clear(self.visualStates)
	local function captureVisualState(instance: Instance)
		local visualState: TooltipVisualState = {}
		local hasVisualState = false
		if instance:IsA("TextLabel") or instance:IsA("TextButton") or instance:IsA("TextBox") then
			visualState.textTransparency = instance.TextTransparency
			hasVisualState = true
		end
		if instance:IsA("ImageLabel") or instance:IsA("ImageButton") then
			visualState.imageTransparency = instance.ImageTransparency
			hasVisualState = true
		end
		if instance:IsA("GuiObject") then
			visualState.backgroundTransparency = instance.BackgroundTransparency
			hasVisualState = true
		end
		if instance:IsA("UIStroke") then
			visualState.strokeTransparency = instance.Transparency
			hasVisualState = true
		end
		if hasVisualState then
			self.visualStates[instance] = visualState
		end
	end
	captureVisualState(tooltip)
	for _, descendant in ipairs(tooltip:GetDescendants()) do
		captureVisualState(descendant)
	end
	local configuredSize = tooltip.Size
	tooltip.Size = UDim2.new(
		configuredSize.X.Scale,
		configuredSize.X.Offset,
		BASE_TOOLTIP_SIZE.Y.Scale,
		BASE_TOOLTIP_SIZE.Y.Offset
	)

	tooltip.AnchorPoint = Vector2.new(0.5, 0.5)
	tooltip.Active = false
	tooltip.Interactable = false
	tooltip.Visible = false
	tooltip.ZIndex = 100
	bodyFrame.Visible = true
	descriptionLabel.Visible = true
	for _, descendant in ipairs(tooltip:GetDescendants()) do
		if descendant:IsA("GuiObject") then
			descendant.ZIndex = 100
		end
	end

	for _, childName in ipairs(HIDDEN_TOOLTIP_CHILDREN) do
		local child = tooltip:FindFirstChild(childName, true)
		if child and child:IsA("GuiObject") then
			child.Visible = false
		end
	end

	return true
end

function MouseTooltipController.Init(self: MouseTooltipControllerObject)
	if self.initialized then
		return
	end
	self.initialized = true

	if not self:_configureTooltip() then
		return
	end

	for _, descendant in ipairs(self.screenGui:GetDescendants()) do
		if descendant:IsA("GuiObject") then
			self:_bindMainGuiTarget(descendant)
		end
	end

	self.maid:GiveTask(self.screenGui.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("GuiObject") then
			self:_bindMainGuiTarget(descendant)
		end
	end))

	local playerGui = self.playerGui
	if playerGui then
		for _, descendant in ipairs(playerGui:GetDescendants()) do
			self:_bindInviteTopbarTarget(descendant)
		end
		self.maid:GiveTask(playerGui.DescendantAdded:Connect(function(descendant)
			self:_bindInviteTopbarTarget(descendant)
		end))
	end
	self.maid:GiveTask(UserInputService.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseMovement then
			self:_updatePosition()
		end
	end))
	self.maid:GiveTask(self.screenGui:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_updatePosition()
	end))
	self.maid:GiveTask(self.screenGui:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		self:_updatePosition()
	end))
	self.maid:GiveTask(self.tooltip:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:_updatePosition()
	end))
	self.maid:GiveTask(self.tooltip:GetPropertyChangedSignal("Size"):Connect(function()
		self:_updatePosition()
	end))

	DebugModule.debugPrint("Mouse tooltip initialized", MODULE_NAME)
end

function MouseTooltipController.Destroy(self: MouseTooltipControllerObject)
	if not self.alive then
		return
	end

	self.alive = false
	self:_cancelTooltipAnimations()
	self.maid:DoCleaning()
	self:_restoreTooltipLayer()
	self.boundTargets = {}
	self.activeTarget = nil
	self.lastMousePosition = nil
	if self.tooltip then
		if self.tooltipScale then
			self.tooltipScale.Scale = 1
		end
		self:_setTooltipVisualTransparency(0)
		self.tooltip.Visible = false
	end
	self.tooltip = nil
	self.bodyFrame = nil
	self.descriptionLabel = nil
	self.tooltipScale = nil
	table.clear(self.visualStates)
	table.clear(self.animationTweens)
end

return MouseTooltipController
]]></string>
