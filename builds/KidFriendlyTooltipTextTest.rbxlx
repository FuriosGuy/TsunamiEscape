      <Item class="ModuleScript" referent="3756">
        <Properties>
          <string name="Name">ReferralService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local ProductService = require(script.Parent.Shared:WaitForChild("ProductService_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local FunnelAnalytics =
	require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("FunnelAnalytics_Server"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))
local DataStoreRequestGate = require(script.Parent:WaitForChild("DataStoreRequestGate"))

local ProductServerService = require(script.Parent:WaitForChild("ProductServerService"))

local ReferralService = {}

local MODULE_NAME = "ReferralService"
local socialConfig = CoreConfig.social
local persistenceConfig = CoreConfig.persistence
local DATASTORE_BUDGET_WAIT_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.datastoreBudgetWaitSeconds) == "number"
	then math.max(0.25, persistenceConfig.datastoreBudgetWaitSeconds)
	else 5
local FRIEND_INVITE_MULTIPLIER_STEP = if socialConfig
		and typeof(socialConfig.friendInviteMultiplierStep) == "number"
	then math.max(0, socialConfig.friendInviteMultiplierStep)
	else 0.1
local analyticsConfig = if CoreConfig.analytics then CoreConfig.analytics else nil
local analyticsFunnels = if analyticsConfig and typeof(analyticsConfig.funnels) == "table"
	then analyticsConfig.funnels
	else nil
local REFERRAL_FUNNEL_NAME = if analyticsFunnels and typeof(analyticsFunnels.referral) == "string"
	then analyticsFunnels.referral
	else "FriendInviteConversion"
local FRIEND_INVITE_PROMPT_FUNNEL_NAME = if analyticsFunnels
		and typeof(analyticsFunnels.friendInvitePrompt) == "string"
	then analyticsFunnels.friendInvitePrompt
	else "FriendInvitePrompt"

local friendReferralClaimsStore = DataStoreService:GetDataStore(ProductService.DataStores["FriendReferralClaims"])
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ShowNotification = Remotes:WaitForChild("ShowNotification") :: RemoteEvent

local function normalizeUserId(value: any): number?
	if typeof(value) ~= "number" then
		return nil
	end

	local userId = math.floor(value)
	if userId <= 0 then
		return nil
	end

	return userId
end

local function tryClaimReferralReward(inviteeUserId: number, referrerUserId: number): boolean
	local claimedReferral = false
	local success, err = pcall(function()
		local gateOk, gateResult = DataStoreRequestGate.Run(
			"StandardUpdate",
			"ClaimReferral",
			function()
				return friendReferralClaimsStore:UpdateAsync(tostring(inviteeUserId), function(existingValue)
					if existingValue ~= nil then
						return existingValue
					end

					claimedReferral = true
					return referrerUserId
				end)
			end,
			{
				maxWaitSeconds = DATASTORE_BUDGET_WAIT_SECONDS,
			}
		)
		if not gateOk then
			error(gateResult)
		end
	end)

	if not success then
		DebugModule.debugWarn(
			string.format(
				"Failed to claim referral reward | invitee=%d | referrer=%d | err=%s",
				inviteeUserId,
				referrerUserId,
				tostring(err)
			),
			MODULE_NAME
		)
		return false
	end

	return claimedReferral
end

local function incrementOfflineReferrerCount(referrerUserId: number): boolean
	for attempt = 1, 3 do
		local success = ProductServerService.UpdateStoredPlayerData(referrerUserId, function(nextData)
			local currentCount = nextData.FriendInviteCount
			if typeof(currentCount) ~= "number" then
				currentCount = 0
			end
			nextData.FriendInviteCount = math.max(0, math.floor(currentCount)) + 1
			return nextData
		end)
		if success then
			return true
		end
		if attempt < 3 then
			task.wait(attempt)
		end
	end

	DebugModule.debugWarn(
		"Offline referral update exhausted retries; claim remains recorded | referrer=" .. tostring(referrerUserId),
		MODULE_NAME
	)
	return false
end

local function grantReferralReward(referrerUserId: number): boolean
	local referrerPlayer = Players:GetPlayerByUserId(referrerUserId)
	if referrerPlayer then
		PlayerHandler.AddFriendInviteCount(referrerPlayer, 1)
		ShowNotification:FireClient(
			referrerPlayer,
			string.format("FRIEND JOINED! +%.2fx FRIENDS MULTIPLIER", FRIEND_INVITE_MULTIPLIER_STEP),
			"Green"
		)
		ProductServerService.SavePlayerData(referrerPlayer)
		return true
	end

	return incrementOfflineReferrerCount(referrerUserId)
end

local function grantInviteeReward(inviteePlayer: Player)
	PlayerHandler.AddFriendInviteCount(inviteePlayer, 1)
	ShowNotification:FireClient(
		inviteePlayer,
		string.format("FRIEND INVITE BONUS! +%.2fx FRIENDS MULTIPLIER", FRIEND_INVITE_MULTIPLIER_STEP),
		"Green"
	)
	ProductServerService.SavePlayerData(inviteePlayer)
end

function ReferralService.OnPlayerAdded(player: Player)
	local joinData = player:GetJoinData()
	local referrerUserId = normalizeUserId(joinData.ReferredByPlayerId)
	if referrerUserId == nil or referrerUserId == player.UserId then
		return
	end

	if not tryClaimReferralReward(player.UserId, referrerUserId) then
		return
	end

	local referralSessionId =
		FunnelAnalytics.OpenRecurringFunnel(player, REFERRAL_FUNNEL_NAME, "Referral Join Detected", {
			customField01 = "InviteeJoined",
		})

	grantInviteeReward(player)
	if referralSessionId then
		FunnelAnalytics.LogRecurringStep(player, REFERRAL_FUNNEL_NAME, referralSessionId, 2, "Invitee Reward Granted", {
			customField01 = "InviteeReward",
		})
	end

	if grantReferralReward(referrerUserId) then
		if referralSessionId then
			FunnelAnalytics.LogRecurringStep(
				player,
				REFERRAL_FUNNEL_NAME,
				referralSessionId,
				3,
				"Referrer Reward Granted",
				{
					customField01 = "ReferrerReward",
				}
			)
		end
		DebugModule.debugInfo(
			string.format(
				"Referral rewards granted | invitee=%s(%d) | referrer=%d | step=%.2f",
				player.Name,
				player.UserId,
				referrerUserId,
				FRIEND_INVITE_MULTIPLIER_STEP
			),
			MODULE_NAME
		)
	end
end

local function handleInvitePromptOpened(player: Player, payload: { [string]: any })
	local sessionId =
		FunnelAnalytics.OpenRecurringFunnel(player, FRIEND_INVITE_PROMPT_FUNNEL_NAME, "Invite Prompt Opened", {
			customField01 = tostring(payload.source or "Topbar"),
		})
	if sessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			FRIEND_INVITE_PROMPT_FUNNEL_NAME,
			sessionId,
			2,
			"Invite Prompt Displayed",
			{
				customField01 = tostring(payload.source or "Topbar"),
			}
		)
	end
end

function ReferralService.Init()
	FunnelAnalytics.RegisterClientAction("FriendInvitePromptOpened", handleInvitePromptOpened)
	DebugModule.debugInfo("ReferralService initialized", MODULE_NAME)
end

return ReferralService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3757">
        <Properties>
          <string name="Name">ReturnToStageService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Maid = require(Modules:WaitForChild("Maid"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local ProductService = require(script.Parent.Shared:WaitForChild("ProductService_Server"))
local ValidationService = require(script.Parent:WaitForChild("ValidationService"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))

local ReturnToStageService = {}

-- CONFIG
local returnToStageConfig = CoreConfig.returnToStage
local RETURN_TO_STAGE_DURATION = if returnToStageConfig and typeof(returnToStageConfig.duration) == "number"
	then math.max(1, returnToStageConfig.duration)
	else 10
local RETURN_TO_STAGE_ENABLED = if returnToStageConfig and typeof(returnToStageConfig.enabled) == "boolean"
	then returnToStageConfig.enabled
	else true
local RETURN_TO_STAGE_IMMUNITY_DURATION = 2
local MODULE_NAME = "ReturnToStageService"
local isInitialized = false
local serviceMaid = Maid.new()

-- REMOTES
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ReturnToStageOffer = Remotes:WaitForChild("ReturnToStageOffer") :: RemoteEvent
local ReturnToStageDeclined = Remotes:WaitForChild("ReturnToStageDeclined") :: RemoteEvent
local ReturnToStagePromptOpened = Remotes:WaitForChild("ReturnToStagePromptOpened") :: RemoteEvent
local RequestReturnToStageOffer = Remotes:WaitForChild("RequestReturnToStageOffer") :: RemoteEvent

-- STATE
local pendingReturnToStage: {
	[Player]: {
		stage: number,
		worldName: string,
		expiresAt: number,
		promptLocked: boolean?,
		newRunStarted: boolean,
		maid: any, -- Rule #3.10: Handle expiration thread
	},
} =
	{}

local pendingReturnOfferRequest: { [Player]: boolean } = {}
local successfulReturnListeners: { [number]: (player: Player, stage: number, worldName: string) -> () } = {}
local nextSuccessfulReturnListenerId = 0

local function notifySuccessfulReturn(player: Player, stage: number, worldName: string)
	for _, listener in pairs(successfulReturnListeners) do
		local success, errorMessage = pcall(listener, player, stage, worldName)
		if not success then
			DebugModule.debugWarn(
				string.format("Successful return listener failed | player=%s | reason=%s", player.Name, tostring(errorMessage)),
				MODULE_NAME
			)
		end
	end
end

local function findNearestTsunamiCover(world: Instance, origin: Vector3): BasePart?
	local roadsFolder = world:FindFirstChild("Roads")
	if not roadsFolder then
		return nil
	end

	local nearestCover: BasePart? = nil
	local nearestDistance = math.huge
	for _, descendant in ipairs(roadsFolder:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Name == "TsunamiCover" then
			local distance = (descendant.Position - origin).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestCover = descendant
			end
		end
	end

	return nearestCover
end

local function findReturnStageDestination(worldName: string, stageNumber: number): BasePart?
	local worldsFolder = workspace:FindFirstChild("Worlds")
	local world = worldsFolder and worldsFolder:FindFirstChild(worldName)
	if not world then
		return nil
	end

	local stagesFolder = world:FindFirstChild("Stages")
	local stageInstance = stagesFolder and stagesFolder:FindFirstChild("Stage_" .. tostring(stageNumber))
	if not stageInstance then
		return nil
	end

	local stagePart = if stageInstance:IsA("BasePart")
		then stageInstance
		else stageInstance:FindFirstChildWhichIsA("BasePart", true)
	if not stagePart then
		return nil
	end

	return findNearestTsunamiCover(world, stagePart.Position)
end

-- Shared server-side stage destination lookup for safe world redirects.
function ReturnToStageService.GetStageDestination(worldName: string, stageNumber: number): BasePart?
	if worldName == "" or stageNumber < 0 then
		return nil
	end

	return findReturnStageDestination(worldName, math.floor(stageNumber))
end

-- Finds safe return cover relative to a specific world barrier.
function ReturnToStageService.GetNearestTsunamiCover(worldName: string, origin: Vector3): BasePart?
	if worldName == "" then
		return nil
	end

	local worldsFolder = workspace:FindFirstChild("Worlds")
	local world = worldsFolder and worldsFolder:FindFirstChild(worldName)
	if not world then
		return nil
	end

	return findNearestTsunamiCover(world, origin)
end

function ReturnToStageService.OfferReturnToStage(player: Player)
	if not RETURN_TO_STAGE_ENABLED then
		pendingReturnToStage[player] = nil
		ReturnToStageOffer:FireClient(player, false)
		return
	end

	local state = pendingReturnToStage[player]
	if not state or state.stage <= 0 or state.worldName == "" then
		pendingReturnToStage[player] = nil
		ReturnToStageOffer:FireClient(player, false)
		return
	end

	local expiresAt = os.clock() + RETURN_TO_STAGE_DURATION
	state.expiresAt = expiresAt

	-- Rule #3.10: Resource bounding/cleanup
	if not state.maid then
		state.maid = Maid.new()
	end
	state.maid.ExpireThread = nil

	ReturnToStageOffer:FireClient(player, true, state.stage, RETURN_TO_STAGE_DURATION)

	state.maid.ExpireThread = task.spawn(function()
		task.wait(RETURN_TO_STAGE_DURATION)
		local currentState = pendingReturnToStage[player]
		if not player.Parent or not currentState then
			return
		end

		if currentState == state and currentState.expiresAt == expiresAt and os.clock() >= currentState.expiresAt then
			if currentState.promptLocked == true then
				return
			end

			DebugModule.debugPrint(string.format("ReturnToStage offer expired for %s", player.Name), MODULE_NAME)
			pendingReturnToStage[player] = nil
			if currentState.newRunStarted ~= true then
				ValidationService.ResetStageProgress(player, currentState.worldName)
				player:SetAttribute("CurrentStage", 0)
			end
			ReturnToStageOffer:FireClient(player, false)
		end
	end)
end

function ReturnToStageService.HandlePurchase(player: Player, productId: number, isPurchased: boolean): (boolean, string)
	if productId ~= ProductService.DevProducts.ReturnToStage then
		return false, "InvalidProduct"
	end
	if not isPurchased then
		return false, "NotPurchased"
	end
	if not RETURN_TO_STAGE_ENABLED then
		pendingReturnToStage[player] = nil
		ReturnToStageOffer:FireClient(player, false)
		return false, "Disabled"
	end

	local state = pendingReturnToStage[player]
	if not state or (os.clock() > state.expiresAt and state.promptLocked ~= true) then
		pendingReturnToStage[player] = nil
		return false, "OfferUnavailable"
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	local destination = findReturnStageDestination(state.worldName, state.stage)

	if
		not character
		or not humanoid
		or humanoid.Health <= 0
		or not rootPart
		or not rootPart:IsA("BasePart")
		or not destination
	then
		pendingReturnToStage[player] = nil
		return false, "CharacterUnavailable"
	end

	character:PivotTo(destination.CFrame * CFrame.new(0, 3, 0))
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero
	ValidationService.ResetStageProgress(player, state.worldName)
	ValidationService.RecordPassedStage(player, state.worldName, state.stage)
	player:SetAttribute("CurrentStage", state.stage)
	player:SetAttribute("TsunamiImmunityUntil", Workspace:GetServerTimeNow() + RETURN_TO_STAGE_IMMUNITY_DURATION)
	ValidationService.MarkServerTeleport(player, RETURN_TO_STAGE_IMMUNITY_DURATION)
	notifySuccessfulReturn(player, state.stage, state.worldName)
	DebugModule.debugInfo(
		string.format(
			"ReturnToStage completed | player=%s | stage=%d | immunitySeconds=%d",
			player.Name,
			state.stage,
			RETURN_TO_STAGE_IMMUNITY_DURATION
		),
		MODULE_NAME
	)
	ReturnToStageService.CleanupPlayer(player) -- Full cleanup after success
	ReturnToStageOffer:FireClient(player, false)
	return true, "Granted"
end

function ReturnToStageService.HandleCreatorPurchase(player: Player, productId: number): (boolean, string)
	if productId ~= ProductService.DevProducts.ReturnToStage then
		return false, "InvalidProduct"
	end

	local state = pendingReturnToStage[player]
	if not state or state.promptLocked ~= true then
		DebugModule.debugWarn(
			"Creator ReturnToStage rejected because strict offer is not locked | player=" .. player.Name,
			MODULE_NAME
		)
		return false, "OfferNotLocked"
	end

	return ReturnToStageService.HandlePurchase(player, productId, true)
end

function ReturnToStageService.OnDeclined(player: Player)
	local state = pendingReturnToStage[player]
	if not state then
		return
	end

	ReturnToStageService.CleanupPlayer(player)
	if state.newRunStarted ~= true then
		ValidationService.ResetStageProgress(player, state.worldName)
		player:SetAttribute("CurrentStage", 0)
	end
	ReturnToStageOffer:FireClient(player, false)
end

function ReturnToStageService.OnPromptOpened(player: Player)
	ReturnToStageService.PrepareRewardedReturn(player)
end

function ReturnToStageService.PrepareRewardedReturn(player: Player): boolean
	local state = pendingReturnToStage[player]
	if not state then
		return false
	end

	if state.expiresAt > 0 and os.clock() > state.expiresAt then
		return false
	end

	state.promptLocked = true
	return true
end

function ReturnToStageService.CancelRewardedReturn(player: Player)
	local state = pendingReturnToStage[player]
	if not state then
		return
	end

	state.promptLocked = false
	if state.expiresAt > 0 and os.clock() >= state.expiresAt then
		ReturnToStageService.CleanupPlayer(player)
		if state.newRunStarted ~= true then
			ValidationService.ResetStageProgress(player, state.worldName)
			player:SetAttribute("CurrentStage", 0)
		end
		ReturnToStageOffer:FireClient(player, false)
	end
end

function ReturnToStageService.OnRequestOffer(player: Player)
	if not RETURN_TO_STAGE_ENABLED then
		return
	end

	if player:GetAttribute("Data_Loaded") ~= true then
		pendingReturnOfferRequest[player] = true
		return
	end

	local stage = player:GetAttribute("CurrentStage")
	local worldName = player:GetAttribute("Current_World")

	if typeof(stage) == "number" and stage > 0 and typeof(worldName) == "string" and worldName ~= "" then
		if not pendingReturnToStage[player] then
		pendingReturnToStage[player] = {
			stage = stage,
			worldName = worldName,
			expiresAt = 0,
			promptLocked = false,
			newRunStarted = false,
			maid = Maid.new(),
		}
		end
		ReturnToStageService.OfferReturnToStage(player)
	else
		pendingReturnToStage[player] = nil
		ReturnToStageOffer:FireClient(player, false)
	end
end

function ReturnToStageService.SetPendingState(player: Player, stage: number, worldName: string)
	if not RETURN_TO_STAGE_ENABLED then
		return
	end

	local previousState = pendingReturnToStage[player]
	if previousState and previousState.maid then
		previousState.maid:DoCleaning()
	end
	pendingReturnToStage[player] = {
		stage = stage,
		worldName = worldName,
		expiresAt = 0,
		promptLocked = false,
		newRunStarted = false,
		maid = Maid.new(),
	}
end

-- A checkpoint after respawn proves the player started a fresh run. The old
-- return offer must not later reset that fresh run when its timer expires.
function ReturnToStageService.MarkNewRunStarted(player: Player): boolean
	local state = pendingReturnToStage[player]
	if not state then
		return false
	end

	state.newRunStarted = true
	if state.promptLocked == true then
		ReturnToStageOffer:FireClient(player, false)
		return false
	end

	DebugModule.debugInfo(
		string.format(
			"ReturnToStage offer cancelled because a new run started | player=%s | savedStage=%d",
			player.Name,
			state.stage
		),
		MODULE_NAME
	)
	ReturnToStageService.CleanupPlayer(player)
	ValidationService.ResetStageProgress(player, state.worldName)
	player:SetAttribute("CurrentStage", 0)
	ReturnToStageOffer:FireClient(player, false)
	return true
end

function ReturnToStageService.CheckQueuedRequest(player: Player)
	if pendingReturnOfferRequest[player] then
		pendingReturnOfferRequest[player] = nil
		ReturnToStageService.OnRequestOffer(player)
	end
end

function ReturnToStageService.CleanupPlayer(player: Player)
	local state = pendingReturnToStage[player]
	if state and state.maid then
		state.maid:DoCleaning()
	end
	pendingReturnToStage[player] = nil
	pendingReturnOfferRequest[player] = nil
end

function ReturnToStageService.RegisterSuccessfulReturn(
	listener: (player: Player, stage: number, worldName: string) -> ()
): ()
	nextSuccessfulReturnListenerId += 1
	local listenerId = nextSuccessfulReturnListenerId
	successfulReturnListeners[listenerId] = listener

	return function()
		successfulReturnListeners[listenerId] = nil
	end
end

function ReturnToStageService.Init()
	if isInitialized then
		return
	end
	isInitialized = true
	serviceMaid.ReturnToStageDeclined = ReturnToStageDeclined.OnServerEvent:Connect(ReturnToStageService.OnDeclined)
	serviceMaid.ReturnToStagePromptOpened =
		ReturnToStagePromptOpened.OnServerEvent:Connect(ReturnToStageService.OnPromptOpened)
	serviceMaid.RequestReturnToStageOffer =
		RequestReturnToStageOffer.OnServerEvent:Connect(ReturnToStageService.OnRequestOffer)
	DebugModule.debugInfo("ReturnToStageService Initialized", MODULE_NAME)
end

function ReturnToStageService.Shutdown()
	for player in pairs(table.clone(pendingReturnToStage)) do
		ReturnToStageService.CleanupPlayer(player)
	end
	serviceMaid:DoCleaning()
	table.clear(pendingReturnOfferRequest)
	table.clear(successfulReturnListeners)
	isInitialized = false
end

return ReturnToStageService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3758">
        <Properties>
          <string name="Name">RewardedVideoService</string>
          <string name="Source"><![CDATA[local AdService = game:GetService("AdService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CoreConfig = require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("CoreConfig_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local Maid = require(Modules.Maid)
local ProductService = require(script.Parent.Shared:WaitForChild("ProductService_Server"))
local ReturnToStageService = require(script.Parent.ReturnToStageService)

local RewardedVideoService = {}

local MODULE_NAME = "RewardedVideoService"
local rewardedVideoConfig: any = CoreConfig.rewardedVideo or {}
local ENABLED = rewardedVideoConfig.enabled ~= false
local REQUEST_COOLDOWN_SECONDS = math.max(0, tonumber(rewardedVideoConfig.requestCooldownSeconds) or 3)
local spinWheelConfig: any = CoreConfig.spinWheel or {}
local SPIN_WHEEL_REWARDED_AD_MAX_SPINS = math.max(1, math.floor(tonumber(spinWheelConfig.rewardedAdMaxSpins) or 5))
local SPIN_WHEEL_REWARDED_AD_COOLDOWN_SECONDS =
	math.max(1, math.floor(tonumber(spinWheelConfig.rewardedAdCooldownSeconds) or (5 * 60)))
local SPIN_WHEEL_REWARDED_AD_RESET_SECONDS =
	math.max(1, math.floor(tonumber(spinWheelConfig.rewardedAdResetSeconds) or (24 * 60 * 60)))

local SPIN_WHEEL_AD_REMAINING_ATTRIBUTE = "SpinWheelRewardedAdSpinsRemaining"
local SPIN_WHEEL_AD_NEXT_AVAILABLE_ATTRIBUTE = "SpinWheelRewardedAdNextAvailableUnix"
local SPIN_WHEEL_AD_RESET_ATTRIBUTE = "SpinWheelRewardedAdResetUnix"

type Placement = {
	productKey: string,
	placementId: number?,
	remainingAttribute: string?,
	nextAvailableAttribute: string?,
	resetAttribute: string?,
	maxUses: number?,
	cooldownSeconds: number?,
	resetSeconds: number?,
}

local placements: { [string]: Placement } = {
	PromptTempSpeedBoost = {
		productKey = "TempSpeedBoost",
		placementId = nil,
	},
	PromptTempWinBoost = {
		productKey = "TempWinBoost",
		placementId = nil,
	},
	ReturnToStage = {
		productKey = "ReturnToStage",
		placementId = nil,
	},
	SpinWheel = {
		productKey = "Spin1",
		placementId = nil,
		remainingAttribute = SPIN_WHEEL_AD_REMAINING_ATTRIBUTE,
		nextAvailableAttribute = SPIN_WHEEL_AD_NEXT_AVAILABLE_ATTRIBUTE,
		resetAttribute = SPIN_WHEEL_AD_RESET_ATTRIBUTE,
		maxUses = SPIN_WHEEL_REWARDED_AD_MAX_SPINS,
		cooldownSeconds = SPIN_WHEEL_REWARDED_AD_COOLDOWN_SECONDS,
		resetSeconds = SPIN_WHEEL_REWARDED_AD_RESET_SECONDS,
	},
}

local configuredPlacements: any = rewardedVideoConfig.placements
if typeof(configuredPlacements) == "table" then
	for placementName, placement in pairs(placements) do
		local rawPlacementId = configuredPlacements[placementName]
		if typeof(rawPlacementId) == "number" and rawPlacementId > 0 then
			placement.placementId = math.floor(rawPlacementId)
		end
	end
end

local isInitialized = false
local serviceMaid = Maid.new()
local requestRemote: RemoteEvent? = nil
local resultRemote: RemoteEvent? = nil
local requestInFlight: { [Player]: boolean } = {}
local requestThreads: { [Player]: thread } = {}
local lastRequestAt: { [Player]: number } = {}

type Reservation = {
	placement: Placement,
	previousRemaining: number,
	previousNextAvailableUnix: number,
	previousResetUnix: number,
}

local reservations: { [Player]: Reservation } = {}

local function getOrCreateRemote(name: string): RemoteEvent
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local existing = remotes:FindFirstChild(name)
	if existing then
		assert(existing:IsA("RemoteEvent"), string.format("%s must be a RemoteEvent", name))
		return existing
	end

	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end

local function getPlacementState(player: Player, placement: Placement): (number?, number?, number?)
	if not placement.remainingAttribute or not placement.nextAvailableAttribute then
		return nil, nil, nil
	end

	local remaining = player:GetAttribute(placement.remainingAttribute)
	local nextAvailableUnix = player:GetAttribute(placement.nextAvailableAttribute)
	local resetUnix = if placement.resetAttribute then player:GetAttribute(placement.resetAttribute) else nil
	return if typeof(remaining) == "number" then math.max(0, math.floor(remaining)) else nil,
		if typeof(nextAvailableUnix) == "number" then math.max(0, math.floor(nextAvailableUnix)) else nil,
		if typeof(resetUnix) == "number" then math.max(0, math.floor(resetUnix)) else nil
end

local function resetExpiredPlacementQuota(player: Player, placement: Placement, now: number)
	if not placement.resetAttribute or not placement.remainingAttribute then
		return
	end

	local resetUnix = player:GetAttribute(placement.resetAttribute)
	if typeof(resetUnix) ~= "number" or resetUnix <= 0 or now < resetUnix then
		return
	end

	player:SetAttribute(placement.remainingAttribute, placement.maxUses or 0)
	player:SetAttribute(placement.resetAttribute, 0)
	if placement.nextAvailableAttribute then
		local nextAvailableUnix = player:GetAttribute(placement.nextAvailableAttribute)
		if typeof(nextAvailableUnix) ~= "number" or nextAvailableUnix <= now then
			player:SetAttribute(placement.nextAvailableAttribute, 0)
		end
	end
end

local function sendResult(player: Player, placementName: string, completed: boolean, resultName: string)
	if resultRemote and player.Parent then
		local placement = placements[placementName]
		local remaining, nextAvailableUnix, resetUnix =
			if placement then getPlacementState(player, placement) else nil, nil, nil
		if remaining ~= nil then
			resultRemote:FireClient(
				player,
				placementName,
				completed,
				resultName,
				remaining,
				nextAvailableUnix or 0,
				resetUnix or 0
			)
		else
			resultRemote:FireClient(player, placementName, completed, resultName)
		end
	end
end

local function initializePlacementState(player: Player, placement: Placement)
	if not placement.remainingAttribute or not placement.nextAvailableAttribute then
		return
	end

	local currentRemaining = player:GetAttribute(placement.remainingAttribute)
	if typeof(currentRemaining) ~= "number" then
		player:SetAttribute(placement.remainingAttribute, placement.maxUses or 0)
	end

	local currentNextAvailableUnix = player:GetAttribute(placement.nextAvailableAttribute)
	if typeof(currentNextAvailableUnix) ~= "number" then
		player:SetAttribute(placement.nextAvailableAttribute, 0)
	end

	if placement.resetAttribute then
		local currentResetUnix = player:GetAttribute(placement.resetAttribute)
		if typeof(currentResetUnix) ~= "number" then
			player:SetAttribute(placement.resetAttribute, 0)
			currentResetUnix = 0
		end
		if
			typeof(currentRemaining) == "number"
			and currentRemaining <= 0
			and currentResetUnix <= 0
			and placement.maxUses
		then
			-- Migrate the old session-only quota into a fresh daily quota once.
			player:SetAttribute(placement.remainingAttribute, placement.maxUses)
		end
	end

	resetExpiredPlacementQuota(player, placement, os.time())
end

local function initializePlayerState(player: Player)
	for _, placement in pairs(placements) do
		initializePlacementState(player, placement)
	end
end

local function reservePlacementUse(player: Player, placement: Placement): (Reservation?, string?)
	if not placement.remainingAttribute or not placement.nextAvailableAttribute then
		return nil, nil
	end

	initializePlacementState(player, placement)
	local now = os.time()
	resetExpiredPlacementQuota(player, placement, now)
	local remaining, nextAvailableUnix, resetUnix = getPlacementState(player, placement)
	local safeRemaining = remaining or 0
	local safeNextAvailableUnix = nextAvailableUnix or 0
	local safeResetUnix = resetUnix or 0
	if safeRemaining <= 0 then
		return nil, "NoSpinsRemaining"
	end
	if safeNextAvailableUnix > os.time() then
		return nil, "Cooldown"
	end

	local reservation: Reservation = {
		placement = placement,
		previousRemaining = safeRemaining,
		previousNextAvailableUnix = safeNextAvailableUnix,
		previousResetUnix = safeResetUnix,
	}
	player:SetAttribute(placement.remainingAttribute, safeRemaining - 1)
	player:SetAttribute(placement.nextAvailableAttribute, now + math.max(1, math.floor(placement.cooldownSeconds or 0)))
	if placement.resetAttribute and safeResetUnix <= 0 then
		player:SetAttribute(placement.resetAttribute, now + math.max(1, math.floor(placement.resetSeconds or 0)))
	end
	return reservation, nil
end

local function restoreReservation(player: Player)
	local reservation = reservations[player]
	if not reservation or player.Parent == nil then
		reservations[player] = nil
		return
	end

	local placement = reservation.placement
	if placement.remainingAttribute and placement.nextAvailableAttribute then
		player:SetAttribute(placement.remainingAttribute, reservation.previousRemaining)
		player:SetAttribute(placement.nextAvailableAttribute, reservation.previousNextAvailableUnix)
		if placement.resetAttribute then
			player:SetAttribute(placement.resetAttribute, reservation.previousResetUnix)
		end
	end
	reservations[player] = nil
end

local function getShowResultName(result: any): string
	if typeof(result) == "EnumItem" then
		return result.Name
	end
	return tostring(result)
end

local function cancelRequestThread(player: Player)
	restoreReservation(player)
	local requestThread = requestThreads[player]
	if requestThread then
		if coroutine.status(requestThread) ~= "dead" then
			pcall(task.cancel, requestThread)
		end
		requestThreads[player] = nil
	end
	requestInFlight[player] = nil
	lastRequestAt[player] = nil
end

local function handleRequest(player: Player, placementName: any)
	if typeof(placementName) ~= "string" then
		DebugModule.debugWarn("Rejected rewarded video request with invalid placement name", MODULE_NAME)
		return
	end

	local placement = placements[placementName]
	if not ENABLED or not placement then
		sendResult(player, placementName, false, if ENABLED then "UnknownPlacement" else "Disabled")
		return
	end

	if requestInFlight[player] then
		sendResult(player, placementName, false, "RequestInFlight")
		return
	end

	local now = os.clock()
	local lastRequest = lastRequestAt[player] or 0
	if now - lastRequest < REQUEST_COOLDOWN_SECONDS then
		sendResult(player, placementName, false, "Cooldown")
		return
	end

	if placementName == "ReturnToStage" and not ReturnToStageService.PrepareRewardedReturn(player) then
		sendResult(player, placementName, false, "OfferUnavailable")
		return
	end

	local productId = ProductService.DevProducts[placement.productKey]
	if typeof(productId) ~= "number" or productId <= 0 then
		if placementName == "ReturnToStage" then
			ReturnToStageService.CancelRewardedReturn(player)
		end
		sendResult(player, placementName, false, "ProductUnavailable")
		DebugModule.debugWarn("Rewarded video product missing | placement=" .. placementName, MODULE_NAME)
		return
	end

	local reservation, reservationError = reservePlacementUse(player, placement)
	if reservationError then
		sendResult(player, placementName, false, reservationError)
		return
	end

	requestInFlight[player] = true
	lastRequestAt[player] = now
	if reservation then
		reservations[player] = reservation
	end
	local requestThread = task.spawn(function()
		local success, result = pcall(function()
			local reward = AdService:CreateAdRewardFromDevProductId(productId)
			if placement.placementId then
				return AdService:ShowRewardedVideoAdAsync(player, reward, placement.placementId)
			end
			return AdService:ShowRewardedVideoAdAsync(player, reward)
		end)
		local completed = success and result == Enum.ShowAdResult.ShowCompleted

		requestInFlight[player] = nil
		requestThreads[player] = nil
		if not completed then
			restoreReservation(player)
		else
			reservations[player] = nil
		end

		if placementName == "ReturnToStage" and not completed then
			ReturnToStageService.CancelRewardedReturn(player)
		end

		if not success then
			DebugModule.debugWarn(
				"Rewarded video failed | player="
					.. player.Name
					.. " | placement="
					.. placementName
					.. " | error="
					.. tostring(result),
				MODULE_NAME
			)
		end

		sendResult(player, placementName, completed, if success then getShowResultName(result) else "Error")
	end)
	requestThreads[player] = requestThread

	DebugModule.debugInfo(
		"Rewarded video requested | player=" .. player.Name .. " | placement=" .. placementName,
		MODULE_NAME
	)
end

export type RequestResult = {
	success: boolean,
	reason: string,
}

function RewardedVideoService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	local createdRequestRemote = getOrCreateRemote("RewardedVideoRequest")
	local createdResultRemote = getOrCreateRemote("RewardedVideoResult")
	requestRemote = createdRequestRemote
	resultRemote = createdResultRemote
	serviceMaid.Request = createdRequestRemote.OnServerEvent:Connect(handleRequest)
	serviceMaid.PlayerAdded = Players.PlayerAdded:Connect(initializePlayerState)
	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(cancelRequestThread)
	for _, player in ipairs(Players:GetPlayers()) do
		initializePlayerState(player)
	end

	DebugModule.debugInfo("Rewarded video service initialized | enabled=" .. tostring(ENABLED), MODULE_NAME)
end

function RewardedVideoService.IsEnabled(): boolean
	return ENABLED
end

function RewardedVideoService.Request(player: Player, placementId: number?): RequestResult
	if player == nil then
		return { success = false, reason = "InvalidPlayer" }
	end
	if placementId ~= nil and typeof(placementId) ~= "number" then
		return { success = false, reason = "InvalidPlacementId" }
	end
	return { success = ENABLED, reason = if ENABLED then "UseClientRequest" else "Disabled" }
end

function RewardedVideoService.Shutdown()
	if not isInitialized then
		return
	end

	for player in pairs(table.clone(requestThreads)) do
		cancelRequestThread(player)
	end
	for player in pairs(table.clone(reservations)) do
		restoreReservation(player)
	end
	table.clear(requestInFlight)
	table.clear(lastRequestAt)
	table.clear(reservations)
	serviceMaid:DoCleaning()
	requestRemote = nil
	resultRemote = nil
	isInitialized = false
end

return RewardedVideoService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3759">
        <Properties>
          <string name="Name">Shared</string>
        </Properties>
        <Item class="ModuleScript" referent="3760">
          <Properties>
            <string name="Name">CoreConfig_Server</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoreConfig = table.clone(require(ReplicatedStorage.Modules.Shared:WaitForChild("CoreConfig_Shared")))

-- Funnel analytics configuration (server-side Roblox AnalyticsService events)
CoreConfig.analytics = {
	enabled = true, -- Master toggle for funnel analytics helpers.
	economyEventsEnabled = true, -- Tracks authoritative currency sources/sinks in Roblox economy analytics.
	liveServerOnly = true, -- Funnel events only send from published live servers, never Studio/client.
	tutorialKartPrefix = "2_", -- Kart-name prefix used to detect the tutorial's second kart unlock.
	funnels = {
		verifyReward = "VerifyRewardClaim", -- Daily verify reward claim conversion funnel.
		rebirth = "RebirthFlow", -- Rebirth progression funnel across normal/purchased rebirths.
		playtimeReward = "PlaytimeRewardClaim", -- Playtime gift claim funnel.
		dailyReward = "DailyRewardClaim", -- Daily login reward claim funnel.
		dailyRewardClaimAll = "DailyRewardClaimAll", -- Claim-all daily reward purchase funnel.
		referral = "FriendInviteConversion", -- Invite/referral reward conversion funnel.
		friendInvitePrompt = "FriendInvitePrompt", -- Client invite-prompt engagement funnel.
		starterPack = "StarterPackFlow", -- Starter pack purchase/reward funnel.
		kartProgression = "KartProgressionFlow", -- Kart purchase/equip progression funnel.
	},
}

-- One-time progression and race badges awarded by the server.
CoreConfig.badges = {
	experienceId = 9824719186, -- Main experience that owns and awards these badges.
	skipInStudio = true, -- Studio cannot persist real badge awards; test live in the published experience.
	successRefreshSeconds = 300, -- Avoid repeating ownership requests while nothing changed.
	initialRetrySeconds = 30, -- Retry transient Roblox badge-service failures after this delay.
	maxRetrySeconds = 600, -- Cap retries so service outages cannot spam requests.
	welcome = 3273304151493169,
	rebirthOnce = 1450520018893580,
	raceChampion = 3647670825159407,
