local OFFER_LABELS: { [string]: string } = {
	VIP = "VIP Pass",
	["2xWins"] = "2x Wins",
	["3xTreadmill"] = "3x Treadmill Pass",
	["15xTreadmill"] = "15x Treadmill Pass",
	["35xTreadmill"] = "35x Treadmill Pass",
	["100xTreadmill"] = "100x Treadmill Pass",
	AdvancedTank = "Advanced Tank Kart",
	ShoppingKart = "Shopping Kart",
	FormulaCar = "Formula Car",
	["+1000"] = "+1,000 Wins",
	["+5000"] = "+5,000 Wins",
	["+10000"] = "+10,000 Wins",
	["+100K"] = "+100K XP Speed",
	["+1M"] = "+1M XP Speed",
	["+10M"] = "+10M XP Speed",
	["2x"] = "2x XP Multiplier",
	["4x"] = "4x XP Multiplier",
	["8x"] = "8x XP Multiplier",
	["16x"] = "16x XP Multiplier",
	["32x"] = "32x XP Multiplier",
	["64x"] = "64x XP Multiplier",
	["100x"] = "100x XP Multiplier",
	TempWinBoost = "2x Win Boost",
}
local marketplaceNameCache: { [string]: string | false } = {}

local function getRandomFromPool(pool: { string }): string?
	local count = #pool
	if count <= 0 then
		return nil
	end

	return pool[math.random(1, count)]
end

local function getMarketplaceItemName(itemId: number, infoType: Enum.InfoType): string?
	local cacheKey = string.format("%s:%d", infoType.Name, itemId)
	local cached = marketplaceNameCache[cacheKey]
	if cached == false then
		return nil
	end
	if typeof(cached) == "string" then
		return cached
	end

	local ok, result = pcall(function()
		return MarketplaceService:GetProductInfo(itemId, infoType)
	end)
	if not ok or typeof(result) ~= "table" then
		marketplaceNameCache[cacheKey] = false
		return nil
	end

	local name = result.Name
	if typeof(name) == "string" and name ~= "" then
		marketplaceNameCache[cacheKey] = name
		return name
	end

	marketplaceNameCache[cacheKey] = false
	return nil
end

local function resolveOfferDisplayName(offerKey: string): string
	local gamePassId = ProductService.Gamepasses[offerKey]
	if typeof(gamePassId) == "number" and gamePassId > 0 then
		local liveName = getMarketplaceItemName(gamePassId, Enum.InfoType.GamePass)
		if liveName then
			return liveName
		end
	end

	local devProductId = ProductService.DevProducts[offerKey]
	if typeof(devProductId) == "number" and devProductId > 0 then
		local liveName = getMarketplaceItemName(devProductId, Enum.InfoType.Product)
		if liveName then
			return liveName
		end
	end

	return OFFER_LABELS[offerKey] or offerKey
end

local function buildShopPromotionOffers(): { string }
	local offers: { string } = {}
	for _, offerKey in ipairs(SystemChatService.ShopPromotionOfferKeys) do
		local gamePassId = ProductService.Gamepasses[offerKey]
		local devProductId = ProductService.DevProducts[offerKey]
		local hasCatalogEntry = (typeof(gamePassId) == "number" and gamePassId > 0)
			or (typeof(devProductId) == "number" and devProductId > 0)
		if hasCatalogEntry then
			table.insert(offers, resolveOfferDisplayName(offerKey))
		end
	end

	return offers
end

local shopPromotionOffers: { string }? = nil

type EventReward = {
	name: string,
	winsRequired: number,
}

type LiveEventChatContext = {
	id: string,
	displayName: string,
	color: Color3,
	rewardTemplates: { string },
	promotionalTemplates: { string },
	tipMessages: { string },
	rewards: { EventReward },
	kartNames: { string },
}

local function getStringPool(source: any, key: string, fallback: { string }): { string }
	if typeof(source) == "table" then
		local pool = source[key]
		if typeof(pool) == "table" and #pool > 0 then
			return pool
		end
	end

	return fallback
end

local function getEventRewards(eventDefinition: { [string]: any }): { EventReward }
	local rewards: { EventReward } = {}
	local progressUi = eventDefinition.progressUi
	local unlocks = if typeof(progressUi) == "table" then progressUi.unlocks else nil
	if typeof(unlocks) ~= "table" then
		return rewards
	end

	for _, rawReward in ipairs(unlocks) do
		if
			type(rawReward) == "table"
			and typeof(rawReward.displayName) == "string"
			and rawReward.displayName ~= ""
			and typeof(rawReward.winsRequired) == "number"
		then
			table.insert(rewards, {
				name = rawReward.displayName,
				winsRequired = math.max(0, math.floor(rawReward.winsRequired)),
			})
		end
	end

	return rewards
end

local function getEventKartNames(eventId: string): { string }
	local kartNames: { string } = {}
	local eventProducts = ProductService.EventKartProducts[eventId]
	if typeof(eventProducts) ~= "table" then
		return kartNames
	end

	for productKey, productConfig in pairs(eventProducts) do
		if typeof(productKey) == "string" and typeof(productConfig) == "table" then
			local gamePassId = ProductService.Gamepasses[productKey]
			local devProductId = ProductService.DevProducts[productKey]
			local hasProduct = (typeof(gamePassId) == "number" and gamePassId > 0)
				or (typeof(devProductId) == "number" and devProductId > 0)
			if hasProduct then
				table.insert(kartNames, resolveOfferDisplayName(productKey))
			end
		end
	end

	table.sort(kartNames)
	return kartNames
end

local function getLiveEventDefinition(eventName: string): { [string]: any }?
	local liveEventsConfig = CoreConfig.liveEvents
	if typeof(liveEventsConfig) ~= "table" or typeof(liveEventsConfig.events) ~= "table" then
		return nil
	end

	for _, eventDefinition in ipairs(liveEventsConfig.events) do
		if
			type(eventDefinition) == "table"
			and typeof(eventDefinition.id) == "string"
			and string.lower(eventDefinition.id) == string.lower(eventName)
		then
			return eventDefinition
		end
	end

	return nil
end

local function getActiveEventContexts(): { LiveEventChatContext }
	local contexts: { LiveEventChatContext } = {}
	local stateFolder = ReplicatedStorage:FindFirstChild("LiveEventState")
	if not stateFolder or not stateFolder:IsA("Folder") then
		return contexts
	end

	local encodedEvents = stateFolder:GetAttribute("ActiveEvents")
	if typeof(encodedEvents) ~= "string" then
		return contexts
	end

	local ok, decoded = pcall(HttpService.JSONDecode, HttpService, encodedEvents)
	if not ok or typeof(decoded) ~= "table" then
		return contexts
	end

	for _, eventEntry in ipairs(decoded) do
		if typeof(eventEntry) == "table" and typeof(eventEntry.id) == "string" then
			local eventDefinition = getLiveEventDefinition(eventEntry.id)
			if eventDefinition then
				local eventChatConfig = eventDefinition.systemChat
				local isBloodmoon = string.lower(eventEntry.id) == "bloodmoon"
				local displayName = if typeof(eventEntry.displayText) == "string"
					then string.upper(eventEntry.displayText)
					elseif typeof(eventDefinition.displayText) == "string"
					then string.upper(eventDefinition.displayText)
					else eventEntry.id
				local color = if isBloodmoon
					then SystemChatService.Config.BloodmoonColor
					elseif typeof(eventDefinition.displayColor) == "Color3"
					then eventDefinition.displayColor
					else SystemChatService.Config.DefaultColor
				table.insert(contexts, {
					id = eventEntry.id,
					displayName = displayName,
					color = color,
					rewardTemplates = getStringPool(
						eventChatConfig,
						"rewardTemplates",
						if isBloodmoon
							then SystemChatService.BloodmoonRewardTemplates
							else DEFAULT_EVENT_REWARD_TEMPLATES
					),
					promotionalTemplates = getStringPool(
						eventChatConfig,
						"promotionalTemplates",
						if isBloodmoon
							then SystemChatService.BloodmoonPromotionalTemplates
							else DEFAULT_EVENT_PROMOTIONAL_TEMPLATES
					),
					tipMessages = getStringPool(
						eventChatConfig,
						"tipMessages",
						if isBloodmoon
							then SystemChatService.BloodmoonTipMessages
							else SystemChatService.LiveEventMessages
					),
					rewards = getEventRewards(eventDefinition),
					kartNames = getEventKartNames(eventEntry.id),
				})
			end
		end
	end

	return contexts
end

local function getEventBoostNames(): { string }
	local boostNames: { string } = {}
	local temporaryWinBoostId = ProductService.DevProducts.TempWinBoost
	if typeof(temporaryWinBoostId) == "number" and temporaryWinBoostId > 0 then
		table.insert(boostNames, resolveOfferDisplayName("TempWinBoost"))
	end

	return boostNames
end

local function replaceTemplateValues(template: string, values: { [string]: string }): string
	local message = template
	for placeholder, value in pairs(values) do
		message = string.gsub(message, "{" .. placeholder .. "}", function()
			return value
		end)
	end

	return message
end

local function buildEventRewardMessage(context: LiveEventChatContext): string?
	local template = getRandomFromPool(context.rewardTemplates)
	local reward = if #context.rewards > 0
		then context.rewards[math.random(1, #context.rewards)]
		else nil
	if not template or not reward then
		return nil
	end

	return replaceTemplateValues(template, {
		EVENT = context.displayName,
		WINS = tostring(reward.winsRequired),
		REWARD = reward.name,
	})
end

local function buildEventPromotionalMessage(context: LiveEventChatContext): string?
	local template = getRandomFromPool(context.promotionalTemplates)
	if not template then
		return nil
	end

	local rewardNames: { string } = {}
	for _, reward in ipairs(context.rewards) do
		table.insert(rewardNames, reward.name)
	end

	local reward = getRandomFromPool(rewardNames)
	local boost = getRandomFromPool(getEventBoostNames())
	local kart = getRandomFromPool(context.kartNames)
	local replacements: { [string]: string } = {
		EVENT = context.displayName,
	}

	if string.find(template, "{REWARD}", 1, true) then
		if not reward then
			return nil
		end
		replacements.REWARD = reward
	end
	if string.find(template, "{WINS}", 1, true) then
		if not reward then
			return nil
		end
		replacements.WINS = tostring(reward.winsRequired)
	end
	if string.find(template, "{BOOST}", 1, true) then
		if not boost then
			return nil
		end
		replacements.BOOST = boost
	end
	if string.find(template, "{KART}", 1, true) then
		if not kart then
			return nil
		end
		replacements.KART = kart
	end

	return replaceTemplateValues(template, replacements)
end

local function buildEventTipMessage(context: LiveEventChatContext): string?
	local template = getRandomFromPool(context.tipMessages)
	if not template then
		return nil
	end

	return replaceTemplateValues(template, {
		EVENT = context.displayName,
	})
end

local function buildPromotionalMessage(): string?
	local promoMode = math.random(1, 3)

	if promoMode == 1 then
		local message = getRandomFromPool(SystemChatService.LikeFavoritePromotionalMessages)
		if not message then
			return nil
		end
		local emoji = getRandomFromPool(SystemChatService.LikeFavoriteEmojis)
		return if emoji then string.format("%s %s", emoji, message) else message
	elseif promoMode == 2 then
		local message = getRandomFromPool(SystemChatService.GroupPromotionalMessages)
		if not message then
			return nil
		end
		local emoji = getRandomFromPool(SystemChatService.GroupEmojis)
		return if emoji then string.format("%s %s", emoji, message) else message
	end

	local template = getRandomFromPool(SystemChatService.ShopPromotionalTemplates)
	if not shopPromotionOffers then
		shopPromotionOffers = buildShopPromotionOffers()
	end
	local offer = getRandomFromPool(shopPromotionOffers)
	if not template or not offer then
		return nil
	end
	local emoji = getRandomFromPool(SystemChatService.ShopEmojis)
	local message = string.gsub(template, "{ITEM}", offer)
	return if emoji then string.format("%s %s", emoji, message) else message
end

local function buildLiveEventMessage(context: LiveEventChatContext): string
	local template = getRandomFromPool(SystemChatService.LiveEventMessages)
	if template then
		return replaceTemplateValues(template, {
			EVENT = context.displayName,
		})
	end

	return string.format("%s is live! Check the event progress before it ends!", context.displayName)
end

local function buildEventMessage(context: LiveEventChatContext): string
	local messageType = math.random(1, 3)
	if messageType == 1 then
		return buildEventTipMessage(context) or buildLiveEventMessage(context)
	elseif messageType == 2 then
		return buildEventRewardMessage(context)
			or buildEventTipMessage(context)
			or buildLiveEventMessage(context)
	end

	return buildEventPromotionalMessage(context)
		or buildEventTipMessage(context)
		or buildLiveEventMessage(context)
end

local function buildScheduledMessage(): (string?, Color3?, string?)
	local activeEvents = getActiveEventContexts()
	if #activeEvents == 0 then
		return buildPromotionalMessage(), SystemChatService.Config.PromoColor, nil
	end

	local eventWeight = SystemChatService.Config.LiveEventSelectionWeight
	local normalWeight = SystemChatService.Config.NormalSelectionWeight
	local totalWeight = eventWeight + normalWeight
	local chooseEvent = math.random(1, totalWeight) <= eventWeight

	if chooseEvent then
		local activeEvent = activeEvents[math.random(1, #activeEvents)]
		local message = buildEventMessage(activeEvent)
		if message then
			return message, activeEvent.color, activeEvent.id
		end
	end

	return buildPromotionalMessage(), SystemChatService.Config.PromoColor, nil
end

local function getRemotesFolder(): Instance
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name = "Remotes"
		remotes.Parent = ReplicatedStorage
	end

	return remotes
end

local function getRemote(): RemoteEvent
	local remotes = getRemotesFolder()
	local remote = remotes:FindFirstChild(REMOTE_NAME) :: RemoteEvent?
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = REMOTE_NAME
		remote.Parent = remotes
	end

	return remote
end

local function colorToHex(color: Color3): string
	return string.format("#%02X%02X%02X", color.R * 255, color.G * 255, color.B * 255)
end

local function randomSteppedInteger(minValue: number, maxValue: number): number
	local resolvedMin = math.floor(math.min(minValue, maxValue))
	local resolvedMax = math.floor(math.max(minValue, maxValue))
	local step = if resolvedMax - resolvedMin >= 10 then 10 else 1

	if resolvedMin == resolvedMax then
		return resolvedMin
	end

	local stepCount = math.floor((resolvedMax - resolvedMin) / step)
	return resolvedMin + (math.random(0, stepCount) * step)
end

function SystemChatService.FormatMessage(message: string, color: Color3?): string
	local resolvedColor = color or SystemChatService.Config.DefaultColor
	return string.format('<font color="%s"><b>%s</b></font>', colorToHex(resolvedColor), message)
end

function SystemChatService.FormatPurchaseMessage(
	playerName: string,
	itemName: string,
	price: number,
	color: Color3?
): string
	local message = string.format("[SYSTEM]: %s just bought '%s' for %d Robux!", playerName, itemName, price)
	return SystemChatService.FormatMessage(message, color)
end

local function formatOrdinal(value: number): string
	local mod100 = value % 100
	if mod100 >= 11 and mod100 <= 13 then
		return tostring(value) .. "th"
	end

	local mod10 = value % 10
	if mod10 == 1 then
		return tostring(value) .. "st"
	elseif mod10 == 2 then
		return tostring(value) .. "nd"
	elseif mod10 == 3 then
		return tostring(value) .. "rd"
	end

	return tostring(value) .. "th"
end

function SystemChatService.FormatRebirthMessage(playerName: string, rebirthCount: number, color: Color3?): string
	local message =
		string.format("[SYSTEM]: %s just rebirthed for the %s time!", playerName, formatOrdinal(rebirthCount))
	return SystemChatService.FormatMessage(message, color or SystemChatService.Config.RebirthColor)
end

function SystemChatService.FormatPlayerJoinMessage(playerName: string, color: Color3?): string
	local message = string.format("[SYSTEM]: %s joined the server!", playerName)
	return SystemChatService.FormatMessage(message, color or SystemChatService.Config.PlayerJoinColor)
end

function SystemChatService.FormatPlayerLeaveMessage(playerName: string, color: Color3?): string
	local message = string.format("[SYSTEM]: %s left the server!", playerName)
	return SystemChatService.FormatMessage(message, color or SystemChatService.Config.PlayerLeaveColor)
end

function SystemChatService.BroadcastMessage(message: string, color: Color3?)
	assert(RunService:IsServer(), "BroadcastMessage must be called on the server")
	local formattedMessage = SystemChatService.FormatMessage(message, color)
	getRemote():FireAllClients(formattedMessage)
	local publishSuccess, publishError = pcall(function()
		MessagingService:PublishAsync(TOPIC_NAME, {
			ServerInstanceId = serverInstanceId,
			FormattedMessage = formattedMessage,
		})
	end)

	if not publishSuccess then
		DebugModule.debugWarn("Failed to publish global system chat: " .. tostring(publishError), MODULE_NAME)
	end
end

local function shouldBroadcastPurchase(dedupeKey: string): boolean
	local now = os.clock()
	for key, timestamp in pairs(purchaseAnnouncementTimes) do
		if now - timestamp >= PURCHASE_ANNOUNCEMENT_DEDUPE_SECONDS then
			purchaseAnnouncementTimes[key] = nil
		end
	end

	local previousTimestamp = purchaseAnnouncementTimes[dedupeKey]
	if previousTimestamp and now - previousTimestamp < PURCHASE_ANNOUNCEMENT_DEDUPE_SECONDS then
		DebugModule.debugInfo("Duplicate purchase announcement suppressed | key=" .. dedupeKey, MODULE_NAME)
		return false
	end

	purchaseAnnouncementTimes[dedupeKey] = now
	return true
end

function SystemChatService.BroadcastPurchase(
	player: Player,
	itemName: string,
	price: number,
	color: Color3?,
	dedupeKey: string?
)
	assert(RunService:IsServer(), "BroadcastPurchase must be called on the server")
	local resolvedDedupeKey = dedupeKey or (tostring(player.UserId) .. ":" .. itemName)
	if not shouldBroadcastPurchase(resolvedDedupeKey) then
		return
	end

	local formattedMessage = SystemChatService.FormatPurchaseMessage(player.Name, itemName, price, color)
	getRemote():FireAllClients(formattedMessage)
	local publishSuccess, publishError = pcall(function()
		MessagingService:PublishAsync(TOPIC_NAME, {
			ServerInstanceId = serverInstanceId,
			FormattedMessage = formattedMessage,
		})
	end)

	if not publishSuccess then
		DebugModule.debugWarn("Failed to publish global purchase chat: " .. tostring(publishError), MODULE_NAME)
	end
end

function SystemChatService.BroadcastLocalMessage(message: string, color: Color3?)
	assert(RunService:IsServer(), "BroadcastLocalMessage must be called on the server")
	getRemote():FireAllClients(SystemChatService.FormatMessage(message, color))
end

function SystemChatService.BroadcastLocalRebirth(player: Player, rebirthCount: number, color: Color3?)
	assert(RunService:IsServer(), "BroadcastLocalRebirth must be called on the server")
	getRemote():FireAllClients(SystemChatService.FormatRebirthMessage(player.Name, rebirthCount, color))
end

function SystemChatService.BroadcastLocalPlayerJoin(player: Player, color: Color3?)
	assert(RunService:IsServer(), "BroadcastLocalPlayerJoin must be called on the server")
	getRemote():FireAllClients(SystemChatService.FormatPlayerJoinMessage(player.Name, color))
end

function SystemChatService.BroadcastLocalPlayerLeave(playerName: string, color: Color3?)
	assert(RunService:IsServer(), "BroadcastLocalPlayerLeave must be called on the server")
	getRemote():FireAllClients(SystemChatService.FormatPlayerLeaveMessage(playerName, color))
end

function SystemChatService.StartPromotionalLoop()
	assert(RunService:IsServer(), "StartPromotionalLoop must be called on the server")
	if promotionalLoopStarted then
		return
	end

	promotionalLoopStarted = true
	promotionalLoopAlive = true
	serverMaid.PromotionalLoopCleanup = function()
		promotionalLoopAlive = false
	end
	serverMaid.PromotionalLoopThread = task.spawn(function()
		while promotionalLoopAlive do
			local delayTime =
				randomSteppedInteger(SystemChatService.Config.PromoMinDelay, SystemChatService.Config.PromoMaxDelay)
			task.wait(delayTime)
			if not promotionalLoopAlive then
				break
			end

			local message, messageColor, eventId = buildScheduledMessage()
			if not message then
				continue
			end

			-- Recheck immediately before sending so a message selected during an event
			-- cannot leak after LiveEventService has published the event end.
			if eventId then
				local eventStillActive = false
				for _, currentEvent in ipairs(getActiveEventContexts()) do
					if string.lower(currentEvent.id) == string.lower(eventId) then
						eventStillActive = true
						break
					end
				end
				if not eventStillActive then
					continue
				end
			end

			SystemChatService.BroadcastLocalMessage("[SYSTEM]: " .. message, messageColor)
		end
	end)
end

function SystemChatService.StartPlayerAnnouncementLoop()
	assert(RunService:IsServer(), "StartPlayerAnnouncementLoop must be called on the server")
	if playerAnnouncementsStarted then
		return
	end

	playerAnnouncementsStarted = true

	local function announcePlayerJoin(player: Player)
		serverMaid["JoinAnnouncement:" .. player.UserId] = task.spawn(function()
			task.wait(1)
			if player.Parent == Players then
				SystemChatService.BroadcastLocalPlayerJoin(player)
			end
		end)
	end

	serverMaid.PlayerAddedConnection = Players.PlayerAdded:Connect(function(player)
		announcePlayerJoin(player)
	end)

	serverMaid.PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
		serverMaid["JoinAnnouncement:" .. player.UserId] = nil
		SystemChatService.BroadcastLocalPlayerLeave(player.Name)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		announcePlayerJoin(player)
	end
end

function SystemChatService.ShutdownServer()
	assert(RunService:IsServer(), "ShutdownServer must be called on the server")
	promotionalLoopStarted = false
	playerAnnouncementsStarted = false
	promotionalLoopAlive = false
	serverSubscription = nil
	table.clear(purchaseAnnouncementTimes)
	serverMaid:DoCleaning()
end

function SystemChatService.InitServer()
	assert(RunService:IsServer(), "InitServer must be called on the server")
	if not serverSubscription then
		local subscribeSuccess, subscribeResult = pcall(function()
			return MessagingService:SubscribeAsync(TOPIC_NAME, function(message)
				local data = message.Data
				if typeof(data) ~= "table" then
					return
				end

				if data.ServerInstanceId == serverInstanceId then
					return
				end

				local formattedMessage = data.FormattedMessage
				if typeof(formattedMessage) ~= "string" then
					return
				end

				getRemote():FireAllClients(formattedMessage)
			end)
		end)

		if subscribeSuccess then
			serverSubscription = subscribeResult
			serverMaid.ServerSubscription = subscribeResult
		else
			DebugModule.debugWarn(
				"Failed to subscribe to global system chat topic: " .. tostring(subscribeResult),
				MODULE_NAME
			)
		end
	end

	if not serverShutdownBound then
		serverShutdownBound = true
		game:BindToClose(function()
			SystemChatService.ShutdownServer()
		end)
	end

	SystemChatService.StartPromotionalLoop()
	SystemChatService.StartPlayerAnnouncementLoop()
end

return SystemChatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3765">
          <Properties>
            <string name="Name">VerifyRewardCalculator_Server</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local VerifyRewardCalculator = require(ReplicatedStorage.Modules.Shared:WaitForChild("VerifyRewardCalculator"))

function VerifyRewardCalculator.AdvanceClaimCount(player: Player, config: any): number
	local nextClaimCount = VerifyRewardCalculator.GetClaimCount(player, config) + 1
	player:SetAttribute(config.claimCountAttribute, nextClaimCount)
	return nextClaimCount
end

return VerifyRewardCalculator
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3766">
          <Properties>
            <string name="Name">WorldSpawnService_Server</string>
            <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")

local WorldSpawnService = {}

export type SpawnLocation = Model | BasePart

local function isSpawnLocation(instance: Instance?): boolean
	return instance ~= nil and (instance:IsA("Model") or instance:IsA("BasePart"))
end

local function findNestedSpawnLocation(container: Instance): SpawnLocation?
	local nestedSpawnLocation = container:FindFirstChild("SpawnLocation", true)
	if isSpawnLocation(nestedSpawnLocation) then
		return nestedSpawnLocation :: SpawnLocation
	end

	return nil
end

function WorldSpawnService.Get(worldName: string): SpawnLocation?
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	local worldFolder = worldsFolder and worldsFolder:FindFirstChild(worldName)
	if not worldFolder then
		return nil
	end

	local spawnContainer = worldFolder:FindFirstChild("SpawnLocation")
	if spawnContainer and spawnContainer:IsA("Model") then
		return findNestedSpawnLocation(spawnContainer) or spawnContainer
	end
	if isSpawnLocation(spawnContainer) then
		return spawnContainer :: SpawnLocation
	end

	return findNestedSpawnLocation(worldFolder)
end

return WorldSpawnService
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="3767">
        <Properties>
          <string name="Name">SpinWheelService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local ReplicatedConfigFolder = Modules:WaitForChild("Config")
local ServerSharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(ServerSharedFolder:WaitForChild("CoreConfig_Server"))
local SpinWheelConfig = require(ReplicatedConfigFolder:WaitForChild("SpinWheelConfig"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local Maid = require(Modules:WaitForChild("Maid"))
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local ProductService = require(script.Parent.Shared:WaitForChild("ProductService_Server"))
local ProductServerService = require(script.Parent:WaitForChild("ProductServerService"))
local LevelingService = require(script.Parent:WaitForChild("LevelingService"))
local EconomyAnalytics = require(script.Parent:WaitForChild("EconomyAnalytics"))

local SpinWheelService = {}

local MODULE_NAME = "SpinWheelService"
local SPINS_ATTRIBUTE = "SpinWheelSpins"
local NEXT_FREE_SPIN_ATTRIBUTE = "SpinWheelNextFreeSpinUnix"
local REWARDED_AD_NEXT_AVAILABLE_ATTRIBUTE = "SpinWheelRewardedAdNextAvailableUnix"
local REWARDED_AD_RESET_ATTRIBUTE = "SpinWheelRewardedAdResetUnix"
local INITIALIZED_ATTRIBUTE = "SpinWheelFreeSpinInitialized"
local PROCESSED_RECEIPTS_ATTRIBUTE = "SpinWheelProcessedReceiptIds"
local REQUEST_COOLDOWN_SECONDS = 0.15
local MAX_STORED_RECEIPTS = 40
local spinWheelConfig = if CoreConfig.spinWheel then CoreConfig.spinWheel else {}
local SPIN_ANIMATION_DURATION_SECONDS = if typeof(spinWheelConfig.spinRotationDuration) == "number"
	then math.max(0.5, spinWheelConfig.spinRotationDuration)
	else 4
local PENDING_SPIN_TIMEOUT_SECONDS = SPIN_ANIMATION_DURATION_SECONDS + 10

local FREE_SPIN_COOLDOWN_SECONDS = if typeof(spinWheelConfig.freeSpinCooldownSeconds) == "number"
	then math.max(1, math.floor(spinWheelConfig.freeSpinCooldownSeconds))
	else 24 * 60 * 60
local REWARDED_AD_COOLDOWN_SECONDS = if typeof(spinWheelConfig.rewardedAdCooldownSeconds) == "number"
	then math.max(1, math.floor(spinWheelConfig.rewardedAdCooldownSeconds))
	else 5 * 60
local DEBUG_FREE_SPIN_READY_IN_STUDIO = spinWheelConfig.debugFreeSpinReadyInStudio == true

local requestInFlight: { [Player]: boolean } = {}
local lastRequestTimes: { [Player]: number } = {}
local processedReceipts: { [Player]: { [string]: boolean } } = {}
local serviceMaid = Maid.new()

type PendingSpin = {
	token: string,
	reward: SpinWheelConfig.RewardDefinition,
	previousSpinCount: number,
	previousNextFreeSpinUnix: number,
	startedAt: number,
	expiresAt: number,
	status: "Started" | "Ready",
	preparedResult: { [string]: any }?,
}

local pendingSpins: { [Player]: PendingSpin } = {}
local initialized = false

local function getOrCreateRemote(name: string): RemoteEvent
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local existing = remotes:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end

	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end

local spinRequestRemote = getOrCreateRemote("SpinWheelRequest")
local spinResultRemote = getOrCreateRemote("SpinWheelResult")
local spinClaimRemote = getOrCreateRemote("SpinWheelClaim")
local spinGrantRemote = getOrCreateRemote("SpinWheelGrant")
local spinAdRewardedRemote = getOrCreateRemote("SpinWheelAdRewarded")

local function getNumberAttribute(player: Player, name: string, defaultValue: number): number
	local value = player:GetAttribute(name)
	return if typeof(value) == "number" then value else defaultValue
end

local function getSpinCount(player: Player): number
	return math.max(0, math.floor(getNumberAttribute(player, SPINS_ATTRIBUTE, 0)))
end

local function setSpinCount(player: Player, count: number)
	player:SetAttribute(SPINS_ATTRIBUTE, math.max(0, math.floor(count)))
end

local function addSpins(player: Player, amount: number)
	setSpinCount(player, getSpinCount(player) + math.max(0, math.floor(amount)))
end

local function isStudioFreeSpinDebugEnabled(): boolean
	return RunService:IsStudio() and DEBUG_FREE_SPIN_READY_IN_STUDIO
end

local function readReceiptHistory(player: Player): { [string]: boolean }
	local history = processedReceipts[player]
	if history then
		return history
	end

	history = {}
	local serialized = player:GetAttribute(PROCESSED_RECEIPTS_ATTRIBUTE)
	if typeof(serialized) == "string" then
		for receiptId in string.gmatch(serialized, "[^,]+") do
			history[receiptId] = true
		end
	end
	processedReceipts[player] = history
	return history
end

local function rememberReceipt(player: Player, receiptId: string): boolean
	if receiptId == "" then
		return true
	end

	local history = readReceiptHistory(player)
	if history[receiptId] then
		return false
	end
	history[receiptId] = true

	local receiptIds = {}
	for storedReceiptId in pairs(history) do
		table.insert(receiptIds, storedReceiptId)
	end
	table.sort(receiptIds)
	while #receiptIds > MAX_STORED_RECEIPTS do
		history[table.remove(receiptIds, 1) :: string] = nil
	end
	player:SetAttribute(PROCESSED_RECEIPTS_ATTRIBUTE, table.concat(receiptIds, ","))
	return true
end

local function getNextFreeSpinUnix(player: Player): number
	return math.max(0, math.floor(getNumberAttribute(player, NEXT_FREE_SPIN_ATTRIBUTE, 0)))
end

local function makeFreeSpinReadyIfDue(player: Player): boolean
	local spins = getSpinCount(player)
	if spins > 0 then
		return true
	end

	if isStudioFreeSpinDebugEnabled() then
		addSpins(player, 1)
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, 0)
		return true
	end

	local now = os.time()
	local nextFreeSpinUnix = getNextFreeSpinUnix(player)
	local hasInitialized = player:GetAttribute(INITIALIZED_ATTRIBUTE) == true
	if not hasInitialized then
		player:SetAttribute(INITIALIZED_ATTRIBUTE, true)
		addSpins(player, 1)
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, 0)
		return true
	end

	if nextFreeSpinUnix > 0 and now >= nextFreeSpinUnix then
		addSpins(player, 1)
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, now + FREE_SPIN_COOLDOWN_SECONDS)
		return true
	end

	return false
end

local function chooseReward(): SpinWheelConfig.RewardDefinition
	local totalChance = 0
	for _, reward in ipairs(SpinWheelConfig.Rewards) do
		totalChance += reward.chance
	end

	local roll = Random.new():NextNumber(0, totalChance)
	local cumulativeChance = 0
	for _, reward in ipairs(SpinWheelConfig.Rewards) do
		cumulativeChance += reward.chance
		if roll <= cumulativeChance then
			return reward
		end
	end

	return SpinWheelConfig.Rewards[#SpinWheelConfig.Rewards]
end

local function getSmallSpeedBase(player: Player): number
	return SpinWheelConfig.GetSmallSpeedBase(getNumberAttribute(player, "MaxXPSpeed", 1))
end

local function getLargeSpeedBase(player: Player): number
	return SpinWheelConfig.GetLargeSpeedBase(getNumberAttribute(player, "MaxXPSpeed", 1))
end

local function calculateReward(player: Player, reward: SpinWheelConfig.RewardDefinition): { [string]: any }
	local result: { [string]: any } = {
		rewardId = reward.id,
		duplicate = false,
		awardedSpeed = 0,
		awardedWins = 0,
		awardedRebirth = 0,
	}

	if reward.id == "SpeedSmall" then
		result.awardedSpeed = getSmallSpeedBase(player)
	elseif reward.id == "SpeedLarge" then
		result.awardedSpeed = getLargeSpeedBase(player)
	elseif reward.id == "Wins" then
		result.awardedWins = SpinWheelConfig.GetWheelWinsBase(getNumberAttribute(player, "WinCount", 0))
	elseif reward.id == "Rebirth" then
		-- Wheel rewards grant the rebirth directly, like Daily/Playtime rewards.
		result.awardedRebirth = 1
	elseif reward.id == "FlameTrail" then
		if PlayerHandler.OwnsTrail(player, "FlameTrail") then
			result.duplicate = true
			result.awardedSpeed = getSmallSpeedBase(player)
			result.awardedWins = SpinWheelConfig.GetWheelWinsBase(getNumberAttribute(player, "WinCount", 0))
		else
		end
	elseif reward.id == "FlameKart" then
		if PlayerHandler.OwnsKart(player, "1_FlameKart") then
			result.duplicate = true
			result.awardedSpeed = getLargeSpeedBase(player)
			result.awardedWins = SpinWheelConfig.GetWheelWinsBase(getNumberAttribute(player, "WinCount", 0))
		else
		end
	end

	return result
end

local function logReward(player: Player, result: { [string]: any })
	local rewardId = tostring(result.rewardId)

	if result.awardedSpeed > 0 then
		EconomyAnalytics.LogSource(
			player,
			"XPSpeed",
			result.awardedSpeed,
			Enum.AnalyticsEconomyTransactionType.TimedReward.Name,
			"SpinWheel_" .. rewardId
		)
	end
	if result.awardedWins > 0 then
		EconomyAnalytics.LogSource(
			player,
			"Wins",
			result.awardedWins,
			Enum.AnalyticsEconomyTransactionType.TimedReward.Name,
			"SpinWheel_" .. rewardId
		)
	end
end

local function processReward(player: Player, reward: SpinWheelConfig.RewardDefinition, result: { [string]: any })
	if result.awardedSpeed > 0 then
		PlayerHandler.AddExactXPSpeed(player, result.awardedSpeed)
	end
	if result.awardedWins > 0 then
		PlayerHandler.AddExactWins(player, result.awardedWins)
	end

	if reward.id == "Rebirth" and result.awardedRebirth > 0 then
		if not LevelingService.PerformRebirth(player, true) then
			DebugModule.debugError("Rebirth could not be completed", nil, MODULE_NAME)
			return
		end
	elseif reward.id == "FlameTrail" and not result.duplicate then
		PlayerHandler.AddOwnedTrail(player, "FlameTrail")
	elseif reward.id == "FlameKart" and not result.duplicate then
		PlayerHandler.AddOwnedKart(player, "1_FlameKart")
	end

	logReward(player, result)
end

local function restorePendingSpin(player: Player): boolean
	local pending = pendingSpins[player]
	if not pending then
		return false
	end

	setSpinCount(player, pending.previousSpinCount)
	player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, pending.previousNextFreeSpinUnix)
	pendingSpins[player] = nil
	return true
end

local function expirePendingSpin(player: Player)
	local pending = pendingSpins[player]
	if pending and os.clock() >= pending.expiresAt then
		restorePendingSpin(player)
	end
end

local function handleSpinRequest(player: Player)
	if player.Parent == nil or player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	local now = os.clock()
	if requestInFlight[player] or now < (lastRequestTimes[player] or 0) + REQUEST_COOLDOWN_SECONDS then
		return
	end
	requestInFlight[player] = true
	lastRequestTimes[player] = now
	expirePendingSpin(player)
	if pendingSpins[player] then
		requestInFlight[player] = nil
		return
	end

	local ready = makeFreeSpinReadyIfDue(player)
	if not ready or getSpinCount(player) <= 0 then
		requestInFlight[player] = nil
		return
	end

	local previousSpinCount = getSpinCount(player)
	local previousNextFreeSpinUnix = getNextFreeSpinUnix(player)
	setSpinCount(player, previousSpinCount - 1)
	local nextFreeSpinUnix = getNextFreeSpinUnix(player)
	if isStudioFreeSpinDebugEnabled() and getSpinCount(player) <= 0 then
		addSpins(player, 1)
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, 0)
	elseif nextFreeSpinUnix <= os.time() then
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, os.time() + FREE_SPIN_COOLDOWN_SECONDS)
	end

	local reward = chooseReward()
	local token = HttpService:GenerateGUID(false)
	pendingSpins[player] = {
		token = token,
		reward = reward,
		previousSpinCount = previousSpinCount,
		previousNextFreeSpinUnix = previousNextFreeSpinUnix,
		startedAt = os.clock(),
		expiresAt = os.clock() + PENDING_SPIN_TIMEOUT_SECONDS,
		status = "Started",
	}
	spinResultRemote:FireClient(player, {
		phase = "Started",
		token = token,
		rewardId = reward.id,
		remainingSpins = getSpinCount(player),
	})
	requestInFlight[player] = nil
end

local function handleSpinClaim(player: Player, token: any)
	if typeof(token) ~= "string" or token == "" then
		return
	end

	expirePendingSpin(player)
	local pending = pendingSpins[player]
	if not pending or pending.token ~= token or pending.status ~= "Started" then
		return
	end
	if os.clock() < pending.startedAt + SPIN_ANIMATION_DURATION_SECONDS then
		DebugModule.debugWarn("Spin claim arrived before animation finished for " .. player.Name, MODULE_NAME)
		return
	end

	local ok, resultOrError = pcall(calculateReward, player, pending.reward)
	if not ok then
		restorePendingSpin(player)
		DebugModule.debugWarn(
			"Spin calculation failed for " .. player.Name .. ": " .. tostring(resultOrError),
			MODULE_NAME
		)
		return
	end

	local result = resultOrError :: { [string]: any }
	pending.status = "Ready"
	pending.preparedResult = result
	result.phase = "RewardReady"
	result.token = token
	result.remainingSpins = getSpinCount(player)
	spinResultRemote:FireClient(player, result)
end

local function handleSpinGrant(player: Player, token: any)
	if typeof(token) ~= "string" or token == "" then
		return
	end

	expirePendingSpin(player)
	local pending = pendingSpins[player]
	if not pending or pending.token ~= token or pending.status ~= "Ready" or not pending.preparedResult then
		return
	end

	local result = pending.preparedResult
	local ok, grantError = pcall(processReward, player, pending.reward, result)
	if not ok then
		restorePendingSpin(player)
		DebugModule.debugWarn("Spin reward failed for " .. player.Name .. ": " .. tostring(grantError), MODULE_NAME)
		return
	end

	pendingSpins[player] = nil
	result.phase = "Granted"
	result.token = token
	result.remainingSpins = getSpinCount(player)
	spinResultRemote:FireClient(player, result)
	ProductServerService.SavePlayerData(player)
end

local function registerPurchaseCallbacks()
	for _, pack in ipairs(SpinWheelConfig.PurchasePacks) do
		local productId = ProductService.DevProducts[pack.productKey]
		if productId then
			DebugModule.debugPrint(
				"Registered spin product "
					.. pack.productKey
					.. " ("
					.. tostring(productId)
					.. ") for "
					.. tostring(pack.spins)
					.. " spins",
				MODULE_NAME
			)
			ProductServerService.SetProductCallback(
				productId,
				function(player: Player, _: number, bought: boolean, purchaseId: string?, purchaseChannel: EnumItem?)
					if not bought then
						return
					end
					if purchaseId and not rememberReceipt(player, purchaseId) then
						return
					end
					addSpins(player, pack.spins)
					if pack.productKey == "Spin1" and purchaseChannel == Enum.ProductPurchaseChannel.AdReward then
						player:SetAttribute(
							REWARDED_AD_NEXT_AVAILABLE_ATTRIBUTE,
							os.time() + REWARDED_AD_COOLDOWN_SECONDS
						)
						spinAdRewardedRemote:FireClient(
							player,
							getSpinCount(player),
							player:GetAttribute("SpinWheelRewardedAdSpinsRemaining"),
							player:GetAttribute(REWARDED_AD_NEXT_AVAILABLE_ATTRIBUTE),
							player:GetAttribute(REWARDED_AD_RESET_ATTRIBUTE)
						)
						DebugModule.debugInfo(
							"Rewarded spin granted; requesting automatic wheel spin | player=" .. player.Name,
							MODULE_NAME
						)
					end
					ProductServerService.SavePlayerData(player)
				end
			)
		end
	end
end

function SpinWheelService.OnPlayerAdded(player: Player)
	if player:GetAttribute(INITIALIZED_ATTRIBUTE) ~= true then
		local now = os.time()
		local existingSpins = getSpinCount(player)
		local existingNextFreeSpinUnix = getNextFreeSpinUnix(player)

		-- Existing ad/product spins must not be mistaken for the initial free spin.
		if existingSpins <= 0 and existingNextFreeSpinUnix <= now then
			addSpins(player, 1)
			player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, 0)
		elseif existingSpins > 0 and existingNextFreeSpinUnix <= 0 then
			player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, now + FREE_SPIN_COOLDOWN_SECONDS)
		end

		player:SetAttribute(INITIALIZED_ATTRIBUTE, true)
	end
	readReceiptHistory(player)
end

function SpinWheelService.CleanupPlayer(player: Player)
	if pendingSpins[player] then
		restorePendingSpin(player)
	end
	requestInFlight[player] = nil
	lastRequestTimes[player] = nil
	processedReceipts[player] = nil
end

function SpinWheelService.Init()
	if initialized then
		return
	end
	initialized = true
	serviceMaid.SpinRequest = spinRequestRemote.OnServerEvent:Connect(handleSpinRequest)
	serviceMaid.SpinClaim = spinClaimRemote.OnServerEvent:Connect(handleSpinClaim)
	serviceMaid.SpinGrant = spinGrantRemote.OnServerEvent:Connect(handleSpinGrant)
	registerPurchaseCallbacks()
	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(SpinWheelService.CleanupPlayer)
	DebugModule.debugPrint("Spin wheel service initialized", MODULE_NAME)
end

function SpinWheelService.Shutdown()
	for player in pairs(table.clone(pendingSpins)) do
		restorePendingSpin(player)
	end
	serviceMaid:DoCleaning()
	table.clear(requestInFlight)
	table.clear(lastRequestTimes)
	table.clear(processedReceipts)
	table.clear(pendingSpins)
	initialized = false
end

return SpinWheelService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3768">
        <Properties>
          <string name="Name">TemporaryBoostService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local ProductService = require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("ProductService_Server"))
local CoreConfig = require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("CoreConfig_Server"))
local ProductServerService = require(script.Parent.ProductServerService)

local TemporaryBoostService = {}

local MODULE_NAME = "TemporaryBoostService"
local temporaryBoostConfig: any = CoreConfig.temporaryBoosts or {}
local PURCHASE_DURATION_SECONDS =
	math.max(1, math.floor(tonumber(temporaryBoostConfig.purchaseDurationSeconds) or (10 * 60)))
local REWARDED_AD_DURATION_SECONDS =
	math.max(1, math.floor(tonumber(temporaryBoostConfig.rewardedAdDurationSeconds) or (5 * 60)))
local SPEED_END_ATTRIBUTE = "TemporarySpeedBoostEndUnix"
local WIN_END_ATTRIBUTE = "TemporaryWinBoostEndUnix"

local initialized = false

local function grantBoost(player: Player, endAttributeName: string, durationSeconds: number): number
	local now = os.time()
	local currentEnd = player:GetAttribute(endAttributeName)
	local existingEnd = if typeof(currentEnd) == "number" then currentEnd else 0
	local newEnd = math.max(now, existingEnd) + durationSeconds

	player:SetAttribute(endAttributeName, newEnd)
	DebugModule.debugInfo(
		string.format(
			"Granted temporary boost | player=%s | attribute=%s | endUnix=%d | addedSeconds=%d",
			player.Name,
			endAttributeName,
			newEnd,
			durationSeconds
		),
		MODULE_NAME
	)

	return newEnd
end

function TemporaryBoostService.GrantSpeedBoost(player: Player, durationSeconds: number): number
	return grantBoost(player, SPEED_END_ATTRIBUTE, math.max(1, math.floor(durationSeconds)))
end

function TemporaryBoostService.GrantWinBoost(player: Player, durationSeconds: number): number
	return grantBoost(player, WIN_END_ATTRIBUTE, math.max(1, math.floor(durationSeconds)))
end

function TemporaryBoostService.Init()
	if initialized then
		return
	end
	initialized = true

	ProductServerService.SetProductCallback(
		ProductService.DevProducts.TempSpeedBoost,
		function(player: Player, _: number?, _: boolean?, _: string?, purchaseChannel: EnumItem?)
			local durationSeconds = if purchaseChannel == Enum.ProductPurchaseChannel.AdReward
				then REWARDED_AD_DURATION_SECONDS
				else PURCHASE_DURATION_SECONDS
			grantBoost(player, SPEED_END_ATTRIBUTE, durationSeconds)
		end
	)

	ProductServerService.SetProductCallback(
		ProductService.DevProducts.TempWinBoost,
		function(player: Player, _: number?, _: boolean?, _: string?, purchaseChannel: EnumItem?)
			local durationSeconds = if purchaseChannel == Enum.ProductPurchaseChannel.AdReward
				then REWARDED_AD_DURATION_SECONDS
				else PURCHASE_DURATION_SECONDS
			grantBoost(player, WIN_END_ATTRIBUTE, durationSeconds)
		end
	)

	DebugModule.debugInfo("Temporary boost products registered", MODULE_NAME)
end

return TemporaryBoostService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3769">
        <Properties>
          <string name="Name">TrollService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Maid = require(Modules:WaitForChild("Maid"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))

local TrollService = {}

-- CONFIG
local trollConfig = if CoreConfig.server and CoreConfig.server.trollService then CoreConfig.server.trollService else nil
local TROLL_ACTION_TIMEOUT = if trollConfig and typeof(trollConfig.actionTimeout) == "number"
	then math.max(1, trollConfig.actionTimeout)
	else 60
local TROLL_SLOW_DURATION = if trollConfig and typeof(trollConfig.slowDuration) == "number"
	then math.max(0.1, trollConfig.slowDuration)
	else 10
local TROLL_FREEZE_DURATION = if trollConfig and typeof(trollConfig.freezeDuration) == "number"
	then math.max(0.1, trollConfig.freezeDuration)
	else 10
local DEFAULT_TROLL_SLOW_SPEED = if trollConfig and typeof(trollConfig.defaultSlowSpeed) == "number"
	then math.max(0, trollConfig.defaultSlowSpeed)
	else (if typeof(PlayerHandler.DEFAULT_ATTRIBUTES.Player_Speed) == "number"
		then PlayerHandler.DEFAULT_ATTRIBUTES.Player_Speed
		else 16)
local TROLL_NOTIFICATION_STYLE = if trollConfig and trollConfig.notificationStyle == "QuickFade"
	then "QuickFade"
	else nil
local TROLL_NOTIFICATION_TICK_INTERVAL = if trollConfig
		and typeof(trollConfig.notificationTickInterval) == "number"
	then math.max(0.25, trollConfig.notificationTickInterval)
	else 1
local MODULE_NAME = "TrollService"
local isInitialized = false
local serviceMaid = Maid.new()

-- REMOTES
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local TrollActionRequest = Remotes:WaitForChild("TrollActionRequest") :: RemoteEvent
local TriggerJumpscare = Remotes:WaitForChild("TriggerJumpscare") :: RemoteEvent
local ShowNotification = Remotes:WaitForChild("ShowNotification") :: RemoteEvent

-- STATE (Managed per lifetime)
local pendingTrollActions: {
	[Player]: {
		actionName: string,
		targetUserId: number,
		expiresAt: number,
	},
} = {}

local activeTrollEffects: {
	[Player]: {
		slowUntil: number?,
		freezeUntil: number?,
		maid: any, -- Maid to handle thread cleanup
	},
} =
	{}

local function getEffectMaid(player: Player): any
	local state = activeTrollEffects[player]
	if not state then
		state = { maid = Maid.new() }
		activeTrollEffects[player] = state
	end
	return state.maid
end

local function isEffectActive(untilTime: number?): boolean
	return typeof(untilTime) == "number" and untilTime > os.clock()
end

local function showTimedNotification(player: Player, prefix: string, duration: number, themeName: string)
	local startedAt = os.clock()
	local maid = getEffectMaid(player)

	-- Rule #3.10: Clean up previous notification thread
	maid.TimedNotification = nil

	maid.TimedNotification = task.spawn(function()
		while player.Parent do
			local remaining = math.max(0, math.ceil(duration - (os.clock() - startedAt)))
			ShowNotification:FireClient(
				player,
				string.format("%s %ds", prefix, remaining),
				themeName,
				TROLL_NOTIFICATION_STYLE
			)
			if remaining <= 0 then
				break
			end
			task.wait(TROLL_NOTIFICATION_TICK_INTERVAL)
		end
	end)
end

function TrollService.GetEffectiveWalkSpeed(player: Player): number?
	local state = activeTrollEffects[player]
	if not state then
		return nil
	end

	if isEffectActive(state.freezeUntil) then
		return 0
	end

	if isEffectActive(state.slowUntil) then
		return DEFAULT_TROLL_SLOW_SPEED * PlayerHandler.GetLiveEventWalkSpeedMultiplier(player)
	end

	return nil
end

function TrollService.UpdatePlayerSpeed(player: Player)
	local targetSpeed = TrollService.GetEffectiveWalkSpeed(player)
	if targetSpeed == nil then
		-- Restore the event-adjusted speed after a troll effect ends.
		targetSpeed = PlayerHandler.GetEffectiveWalkSpeed(player)
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.WalkSpeed = targetSpeed
	end
end

function TrollService.HandleTrollPurchase(player: Player, productId: number, isPurchased: boolean)
	if not isPurchased then
		return
	end

	local pendingAction = pendingTrollActions[player]
	pendingTrollActions[player] = nil

	if not pendingAction or os.clock() > pendingAction.expiresAt then
		return
	end

	local targetPlayer = Players:GetPlayerByUserId(pendingAction.targetUserId)
	if not targetPlayer then
		return
	end

	local maid = getEffectMaid(targetPlayer)
	local state = activeTrollEffects[targetPlayer]

	if pendingAction.actionName == "Kill" then
		local character = targetPlayer.Character
		local humanoid = character and character:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			ShowNotification:FireClient(targetPlayer, "YOU WERE KILLED!", "Red", TROLL_NOTIFICATION_STYLE)
			humanoid.Health = 0
		end
	elseif pendingAction.actionName == "Slow" then
		state.slowUntil = os.clock() + TROLL_SLOW_DURATION
		state.freezeUntil = nil
		TrollService.UpdatePlayerSpeed(targetPlayer)
		showTimedNotification(targetPlayer, "SLOWED FOR", TROLL_SLOW_DURATION, "Blue")

		maid.SlowExpire = task.spawn(function()
			task.wait(TROLL_SLOW_DURATION)
			state.slowUntil = nil
			TrollService.UpdatePlayerSpeed(targetPlayer)
		end)
	elseif pendingAction.actionName == "Freeze" then
		state.freezeUntil = os.clock() + TROLL_FREEZE_DURATION
		state.slowUntil = nil
		TrollService.UpdatePlayerSpeed(targetPlayer)
		showTimedNotification(targetPlayer, "FROZEN FOR", TROLL_FREEZE_DURATION, "Red")

		maid.FreezeExpire = task.spawn(function()
			task.wait(TROLL_FREEZE_DURATION)
			state.freezeUntil = nil
			TrollService.UpdatePlayerSpeed(targetPlayer)
		end)
	elseif pendingAction.actionName == "Jumpscare" then
		TriggerJumpscare:FireClient(targetPlayer)
	end
end

function TrollService.OnTrollRequest(player: Player, actionName: string, targetUserId: number)
	-- Rule #3.12: Basic validation and rate limiting could be added here
	if typeof(actionName) ~= "string" or typeof(targetUserId) ~= "number" then
		return
	end

	local validActions = { Kill = true, Slow = true, Freeze = true, Jumpscare = true }
	if not validActions[actionName] then
		return
	end

	local targetPlayer = Players:GetPlayerByUserId(targetUserId)
	if not targetPlayer then
		return
	end

	pendingTrollActions[player] = {
		actionName = actionName,
		targetUserId = targetUserId,
		expiresAt = os.clock() + TROLL_ACTION_TIMEOUT,
	}
end

function TrollService.CleanupPlayer(player: Player)
	pendingTrollActions[player] = nil
	local state = activeTrollEffects[player]
	if state then
		-- Rule #3.10 & #3.21: Explicit cleanup of all effect threads
		state.maid:DoCleaning()
		activeTrollEffects[player] = nil
	end
end

function TrollService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	serviceMaid.TrollActionRequest = TrollActionRequest.OnServerEvent:Connect(TrollService.OnTrollRequest)
	DebugModule.debugInfo("TrollService Initialized", MODULE_NAME)
end

function TrollService.Shutdown()
	for player in pairs(table.clone(pendingTrollActions)) do
		TrollService.CleanupPlayer(player)
	end
	for player in pairs(table.clone(activeTrollEffects)) do
		TrollService.CleanupPlayer(player)
	end
	serviceMaid:DoCleaning()
	isInitialized = false
end

return TrollService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3770">
        <Properties>
          <string name="Name">TsunamiSystem</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))

local TsunamiSystem = {}

export type TsunamiConfig = {
	Chance: number,
	Speed: number,
	ModelName: string?,
}

type ActiveTsunamiState = {
	instance: Folder,
	worldName: string,
	startCFrame: CFrame,
	targetCFrame: CFrame,
	startServerTime: number,
	duration: number,
	hitHalfExtents: Vector3,
	previousWaveCFrame: CFrame?,
	previousPlayerPositions: { [Player]: Vector3 },
}

TsunamiSystem.TsunamiConfigs = {
	["Very Slow"] = {
		Chance = 25,
		Speed = 65,
	},
	["Slow"] = {
		Chance = 40,
		Speed = 80,
	},
	["Medium"] = {
		Chance = 60,
		Speed = 120,
	},
	["Fast"] = {
		Chance = 25,
		Speed = 190,
	},
	["Very Fast"] = {
		Chance = 15,
		Speed = 220,
	},
	["Extremely Fast"] = {
		Chance = 5,
		Speed = 260,
	},
}

local tsunamiRollOrder = {
	"Extremely Fast",
	"Very Fast",
	"Fast",
	"Medium",
	"Slow",
	"Very Slow",
}

local activeStates: { [Folder]: ActiveTsunamiState } = {}
local disabledWorlds: { [string]: number } = {}
local disableExpiryThreads: { [string]: thread } = {}
local disableGenerations: { [string]: number } = {}
local hitEvaluationConnection: RBXScriptConnection? = nil
local hitEvaluationAccumulator = 0
local nextWaveId = 0
local recoverySerial = 0
local tsunamiTemplatesFolder = ReplicatedStorage:WaitForChild("Tsunamis")
local tsunamiSystemConfig = if CoreConfig.server and CoreConfig.server.tsunamiSystem
	then CoreConfig.server.tsunamiSystem
	else nil
local MIN_RANDOM_PATH_DISTANCE = if tsunamiSystemConfig
		and typeof(tsunamiSystemConfig.minRandomPathDistance) == "number"
	then math.max(0, tsunamiSystemConfig.minRandomPathDistance)
	else 200
local HIT_EVALUATION_INTERVAL = if tsunamiSystemConfig
		and typeof(tsunamiSystemConfig.hitEvaluationInterval) == "number"
	then math.clamp(tsunamiSystemConfig.hitEvaluationInterval, 0.025, 0.25)
	else 0.05
local HIT_PADDING = if tsunamiSystemConfig and typeof(tsunamiSystemConfig.hitPadding) == "number"
	then math.max(0, tsunamiSystemConfig.hitPadding)
	else 2

local function getWorld(worldName: string): Instance?
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	if not worldsFolder then
		DebugModule.debugWarn("Workspace.Worlds folder not found", "TsunamiSystem")
		return nil
	end

	return worldsFolder:FindFirstChild(worldName)
end

local function getTsunamiFolder(worldName: string): Instance?
	local world = getWorld(worldName)
	if not world then
		DebugModule.debugWarn("World " .. worldName .. " not found", "TsunamiSystem")
		return nil
	end

	local tsunamiFolder = world:FindFirstChild("Tsunamis")
	if not tsunamiFolder then
		DebugModule.debugWarn("Tsunamis folder missing for " .. worldName, "TsunamiSystem")
		return nil
	end

	return tsunamiFolder
end

local function getPointsFolder(worldName: string, pointsFolderName: string?): Instance?
	local tsunamiFolder = getTsunamiFolder(worldName)
	if not tsunamiFolder then
		return nil
	end

	local resolvedFolderName = pointsFolderName or "Points"
	local pointsFolder = tsunamiFolder:FindFirstChild(resolvedFolderName)
	if not pointsFolder then
		DebugModule.debugWarn(resolvedFolderName .. " folder missing for " .. worldName, "TsunamiSystem")
		return nil
	end

	return pointsFolder
end

local function getPointCFrame(worldName: string, pointName: string, pointsFolderName: string?): CFrame?
	local pointsFolder = getPointsFolder(worldName, pointsFolderName)
	if not pointsFolder then
		return nil
	end

	local point = pointsFolder:FindFirstChild(pointName)
	if not point then
		DebugModule.debugWarn(pointName .. " point missing for " .. worldName, "TsunamiSystem")
		return nil
	end

	if point:IsA("BasePart") then
		return point.CFrame
	elseif point:IsA("Model") then
		return point:GetPivot()
	end

	DebugModule.debugWarn(pointName .. " point must be a BasePart or Model in " .. worldName, "TsunamiSystem")
	return nil
end

local function getTemplatePart(tsunamiName: string, config: TsunamiConfig): BasePart?
	local modelName = config.ModelName or tsunamiName
	local template = tsunamiTemplatesFolder:FindFirstChild(modelName)
	if not template then
		local templateNames = {}
		for _, child in ipairs(tsunamiTemplatesFolder:GetChildren()) do
			table.insert(templateNames, child.Name .. ":" .. child.ClassName)
		end
		table.sort(templateNames)
		local templateParent = tsunamiTemplatesFolder.Parent
		DebugModule.debugWarn(
			string.format(
				"Template lookup failed | requested=%s | folder=%s | parent=%s | children=%s | serverTime=%.3f",
				modelName,
				tsunamiTemplatesFolder:GetFullName(),
				if templateParent then templateParent:GetFullName() else "nil",
				if #templateNames > 0 then table.concat(templateNames, ",") else "none",
				Workspace:GetServerTimeNow()
			),
			"TsunamiSystem"
		)
		return nil
	end

	if not template:IsA("BasePart") then
		DebugModule.debugWarn(
			string.format(
				"Template lookup failed | requested=%s | class=%s | path=%s | expected=BasePart",
				modelName,
				template.ClassName,
				template:GetFullName()
			),
			"TsunamiSystem"
		)
		return nil
	end

	return template
end

local function getOrCreateActiveStatesFolder(tsunamiFolder: Instance): Folder?
	local existingFolder = tsunamiFolder:FindFirstChild("ActiveStates")
	if existingFolder then
		if existingFolder:IsA("Folder") then
			return existingFolder
		end

		DebugModule.debugWarn("Tsunamis.ActiveStates must be a Folder", "TsunamiSystem")
		return nil
	end

	local activeStatesFolder = Instance.new("Folder")
	activeStatesFolder.Name = "ActiveStates"
	activeStatesFolder.Parent = tsunamiFolder
	return activeStatesFolder
end

local function stopHitEvaluator()
	if hitEvaluationConnection then
		hitEvaluationConnection:Disconnect()
		hitEvaluationConnection = nil
	end

	hitEvaluationAccumulator = 0
end

local function cleanupActiveState(state: Folder, reason: string)
	local activeState = activeStates[state]
	local elapsed = if activeState then math.max(0, Workspace:GetServerTimeNow() - activeState.startServerTime) else -1
	DebugModule.debugInfo(
		string.format(
			"Cleanup state | waveId=%s | reason=%s | elapsed=%.2fs | duration=%.2fs | parent=%s",
			tostring(state:GetAttribute("WaveId") or state.Name),
			reason,
			elapsed,
			if activeState then activeState.duration else -1,
			if state.Parent then state.Parent:GetFullName() else "nil"
		),
		"TsunamiSystem"
	)
	activeStates[state] = nil
	if state.Parent then
		state:Destroy()
	end
end

local function getLivingRootPosition(player: Player): (Humanoid?, Vector3?)
	local character = player.Character
	if not character then
		return nil, nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not humanoid or humanoid.Health <= 0 or not rootPart or not rootPart:IsA("BasePart") then
		return nil, nil
	end

	return humanoid, rootPart.Position
end

local function isPointInsideAxisAlignedBox(point: Vector3, halfExtents: Vector3): boolean
	return math.abs(point.X) <= halfExtents.X
		and math.abs(point.Y) <= halfExtents.Y
		and math.abs(point.Z) <= halfExtents.Z
end

local function isSegmentInsideAxisAlignedBox(startPoint: Vector3, endPoint: Vector3, halfExtents: Vector3): boolean
	if isPointInsideAxisAlignedBox(startPoint, halfExtents) or isPointInsideAxisAlignedBox(endPoint, halfExtents) then
		return true
	end

	local tMin = 0
	local tMax = 1

	local deltaX = endPoint.X - startPoint.X
	if math.abs(deltaX) < 0.000001 then
		if startPoint.X < -halfExtents.X or startPoint.X > halfExtents.X then
			return false
		end
	else
		local inverseDelta = 1 / deltaX
		local first = (-halfExtents.X - startPoint.X) * inverseDelta
		local second = (halfExtents.X - startPoint.X) * inverseDelta
		if first > second then
			first, second = second, first
		end
		tMin = math.max(tMin, first)
		tMax = math.min(tMax, second)
		if tMin > tMax then
			return false
		end
	end

	local deltaY = endPoint.Y - startPoint.Y
	if math.abs(deltaY) < 0.000001 then
		if startPoint.Y < -halfExtents.Y or startPoint.Y > halfExtents.Y then
			return false
		end
	else
		local inverseDelta = 1 / deltaY
		local first = (-halfExtents.Y - startPoint.Y) * inverseDelta
		local second = (halfExtents.Y - startPoint.Y) * inverseDelta
		if first > second then
			first, second = second, first
		end
		tMin = math.max(tMin, first)
		tMax = math.min(tMax, second)
		if tMin > tMax then
			return false
		end
	end

	local deltaZ = endPoint.Z - startPoint.Z
	if math.abs(deltaZ) < 0.000001 then
		return startPoint.Z >= -halfExtents.Z and startPoint.Z <= halfExtents.Z
	end

	local inverseDelta = 1 / deltaZ
	local first = (-halfExtents.Z - startPoint.Z) * inverseDelta
	local second = (halfExtents.Z - startPoint.Z) * inverseDelta
	if first > second then
		first, second = second, first
	end
	tMin = math.max(tMin, first)
	tMax = math.min(tMax, second)
	return tMin <= tMax
end

local function evaluateActiveStates()
	local now = Workspace:GetServerTimeNow()
	local players = Players:GetPlayers()

	for state, activeState in pairs(activeStates) do
		if not state.Parent then
			activeStates[state] = nil
			continue
		end

		local elapsed = now - activeState.startServerTime
		local hasExpired = elapsed >= activeState.duration
		local sampleElapsed = math.clamp(elapsed, 0, activeState.duration)
		local alpha = sampleElapsed / activeState.duration
		local waveCFrame = activeState.startCFrame:Lerp(activeState.targetCFrame, alpha)
		local previousWaveCFrame = activeState.previousWaveCFrame or waveCFrame
		for _, player in ipairs(players) do
			local humanoid, currentPosition = getLivingRootPosition(player)
			if humanoid and currentPosition and player:GetAttribute("Current_World") == activeState.worldName then
				local immunityUntil = player:GetAttribute("TsunamiImmunityUntil")
				if typeof(immunityUntil) == "number" and immunityUntil > now then
					activeState.previousPlayerPositions[player] = currentPosition
					continue
				elseif typeof(immunityUntil) == "number" and immunityUntil > 0 then
					player:SetAttribute("TsunamiImmunityUntil", 0)
				end

				local currentLocalPosition = waveCFrame:PointToObjectSpace(currentPosition)
				local previousPosition = activeState.previousPlayerPositions[player] or currentPosition
				local previousLocalPosition = previousWaveCFrame:PointToObjectSpace(previousPosition)
				local isInside = isSegmentInsideAxisAlignedBox(
					previousLocalPosition,
					currentLocalPosition,
					activeState.hitHalfExtents
				)

				if isInside and humanoid.Health > 0 then
					humanoid.Health = 0
				end

				activeState.previousPlayerPositions[player] = currentPosition
			else
				activeState.previousPlayerPositions[player] = nil
			end
		end
		activeState.previousWaveCFrame = waveCFrame

		if hasExpired then
			cleanupActiveState(state, "duration.expired")
		end
	end

	if next(activeStates) == nil then
		stopHitEvaluator()
	end
end

local function startHitEvaluator()
	if hitEvaluationConnection then
		return
	end

	hitEvaluationAccumulator = 0
	hitEvaluationConnection = RunService.Heartbeat:Connect(function(deltaTime)
		hitEvaluationAccumulator += deltaTime
		if hitEvaluationAccumulator < HIT_EVALUATION_INTERVAL then
			return
		end

		hitEvaluationAccumulator = 0
		evaluateActiveStates()
	end)
end

local function getRandomSpawnCFrame(startCFrame: CFrame, endCFrame: CFrame): CFrame
	local baseStartPosition = startCFrame.Position
	local baseEndPosition = endCFrame.Position
	local pathVector = baseEndPosition - baseStartPosition
	local pathDistance = pathVector.Magnitude

	if pathDistance <= MIN_RANDOM_PATH_DISTANCE then
		return startCFrame
	end

	local direction = pathVector.Unit
	local maxStartAlpha = math.max(0, (pathDistance - MIN_RANDOM_PATH_DISTANCE) / pathDistance)
	local startAlpha = math.random() * maxStartAlpha

	local randomStartPosition = baseStartPosition + (direction * (pathDistance * startAlpha))
	return CFrame.new(randomStartPosition)
end

function TsunamiSystem.ResolveTsunamiName(tsunamiName: string): string?
	if TsunamiSystem.TsunamiConfigs[tsunamiName] then
		return tsunamiName
	end

	local normalizedName = string.lower(string.gsub(tsunamiName, "[%s_]+", ""))
	for configuredName, _ in pairs(TsunamiSystem.TsunamiConfigs) do
		local normalizedConfiguredName = string.lower(string.gsub(configuredName, "[%s_]+", ""))
		if normalizedConfiguredName == normalizedName then
			return configuredName
		end
	end

	return nil
end

function TsunamiSystem.GetTsunamiConfig(tsunamiName: string): TsunamiConfig?
	local resolvedName = TsunamiSystem.ResolveTsunamiName(tsunamiName)
	if not resolvedName then
		DebugModule.debugWarn("Missing tsunami config for " .. tsunamiName, "TsunamiSystem")
		return nil
	end

	return TsunamiSystem.TsunamiConfigs[resolvedName]
end

function TsunamiSystem.GetDebugPointsFolders(worldName: string): { Instance }
	local tsunamiFolder = getTsunamiFolder(worldName)
	if not tsunamiFolder then
		return {}
	end

	local debugFolders = {}
	for _, child in ipairs(tsunamiFolder:GetChildren()) do
		if string.find(child.Name, "PointsDebug_", 1, true) == 1 then
			table.insert(debugFolders, child)
		end
	end

	table.sort(debugFolders, function(a, b)
		return a.Name < b.Name
	end)

	return debugFolders
end

function TsunamiSystem.IsWorldDisabled(worldName: string): boolean
	local disabledUntil = disabledWorlds[worldName]
	if not disabledUntil then
		return false
	end

	if os.clock() >= disabledUntil then
		-- Keep expired disable state until recovery consumes it. This prevents
		-- the normal scheduler from racing the immediate recovery wave.
		return true
	end

	return true
end

function TsunamiSystem.SpawnRecoveryTsunami(worldName: string): Folder?
	local disabledUntil = disabledWorlds[worldName]
	if not disabledUntil or os.clock() < disabledUntil then
		return nil
	end

	disabledWorlds[worldName] = nil
	disableExpiryThreads[worldName] = nil
	disableGenerations[worldName] = nil
	recoverySerial += 1

	local world = getWorld(worldName)
	local canSpawn = world ~= nil and (worldName ~= "Minigame" or world:GetAttribute("RaceState") == "Racing")
	if not canSpawn then
		return nil
	end

	return TsunamiSystem.SpawnCycleForWorld(worldName)
end

function TsunamiSystem.GetRecoverySerial(): number
	return recoverySerial
end

function TsunamiSystem.DisableWorldTsunamis(worldName: string, duration: number)
	local durationSeconds = math.max(0, duration)
	local previousExpiryThread = disableExpiryThreads[worldName]
	if previousExpiryThread then
		pcall(task.cancel, previousExpiryThread)
		disableExpiryThreads[worldName] = nil
	end

	local generation = (disableGenerations[worldName] or 0) + 1
	disableGenerations[worldName] = generation
	local disabledUntil = os.clock() + durationSeconds
	disabledWorlds[worldName] = disabledUntil

	DebugModule.debugPrint(
		string.format("Disabled tsunami spawning in %s for %.1f seconds", worldName, duration),
		"TsunamiSystem"
	)

	if durationSeconds <= 0 then
		disabledWorlds[worldName] = nil
		disableGenerations[worldName] = nil
		return
	end

	disableExpiryThreads[worldName] = task.delay(durationSeconds, function()
		if disableGenerations[worldName] ~= generation then
			return
		end

		local currentDisabledUntil = disabledWorlds[worldName]
		if currentDisabledUntil ~= disabledUntil then
			return
		end

		local recoveryWave = TsunamiSystem.SpawnRecoveryTsunami(worldName)
		if recoveryWave then
			DebugModule.debugPrint(
				"Spawned recovery tsunami after disable-waves cooldown | world=" .. worldName,
				"TsunamiSystem"
			)
		end
	end)
end

function TsunamiSystem.ClearWorldTsunamis(worldName: string)
	local tsunamiFolder = getTsunamiFolder(worldName)
	if not tsunamiFolder then
		return
	end

	for state, activeState in pairs(activeStates) do
		if activeState.worldName == worldName then
			cleanupActiveState(state, "world.clear")
		end
	end

	for _, child in ipairs(tsunamiFolder:GetChildren()) do
		if child:IsA("BasePart") and child.Name ~= "Start" and child.Name ~= "End" then
			child:Destroy()
		elseif child:IsA("Folder") and child.Name == "ActiveStates" then
			for _, state in ipairs(child:GetChildren()) do
				state:Destroy()
			end
		end
	end

	if next(activeStates) == nil then
		stopHitEvaluator()
	end
	DebugModule.debugPrint("Cleared active tsunamis in " .. worldName, "TsunamiSystem")
end

function TsunamiSystem.Destroy()
	stopHitEvaluator()
	for state in pairs(activeStates) do
		cleanupActiveState(state, "system.destroy")
	end

	table.clear(activeStates)
	table.clear(disabledWorlds)
	recoverySerial = 0
	for worldName, expiryThread in pairs(disableExpiryThreads) do
		pcall(task.cancel, expiryThread)
		disableExpiryThreads[worldName] = nil
		disableGenerations[worldName] = nil
	end
	DebugModule.debugPrint("TsunamiSystem destroyed active runtime state", "TsunamiSystem")
end

function TsunamiSystem.SpawnCycleForWorld(worldName: string, useStartupPath: boolean?): Folder?
	if TsunamiSystem.IsWorldDisabled(worldName) then
		return nil
	end

	local debugFolders = TsunamiSystem.GetDebugPointsFolders(worldName)
	if #debugFolders > 0 then
		local lastSpawnedTsunami: Folder? = nil

		for _, debugFolder in ipairs(debugFolders) do
			local tsunamiName = string.gsub(debugFolder.Name, "^PointsDebug_", "")
			local spawnedTsunami = TsunamiSystem.SpawnTsunami(worldName, tsunamiName, debugFolder.Name, useStartupPath)
			if spawnedTsunami then
				lastSpawnedTsunami = spawnedTsunami
			end
		end

		return lastSpawnedTsunami
	end

	return TsunamiSystem.SpawnRandomTsunami(worldName, nil, useStartupPath)
end

function TsunamiSystem.RollTsunamiType(worldName: string): string?
	if not getWorld(worldName) then
		return nil
	end

	local successfulRolls = {}

	for _, tsunamiName in ipairs(tsunamiRollOrder) do
		local config = TsunamiSystem.TsunamiConfigs[tsunamiName]
		if config and math.random(1, 100) <= config.Chance then
			table.insert(successfulRolls, tsunamiName)
		end
	end

	if #successfulRolls > 0 then
		return successfulRolls[math.random(1, #successfulRolls)]
	end

	return "Medium"
end

function TsunamiSystem.SpawnTsunami(
	worldName: string,
	tsunamiName: string,
	pointsFolderName: string?,
	useStartupPath: boolean?
): Folder?
	local resolvedTsunamiName = TsunamiSystem.ResolveTsunamiName(tsunamiName)
	if not resolvedTsunamiName then
		DebugModule.debugWarn("Missing tsunami config for " .. tsunamiName, "TsunamiSystem")
		return nil
	end

	local tsunamiConfig = TsunamiSystem.TsunamiConfigs[resolvedTsunamiName]
	if not tsunamiConfig then
		return nil
	end

	local startCFrame = getPointCFrame(worldName, "Start", pointsFolderName)
	local endCFrame = getPointCFrame(worldName, "End", pointsFolderName)
	local template = getTemplatePart(resolvedTsunamiName, tsunamiConfig)
	local tsunamiFolder = getTsunamiFolder(worldName)

	if not startCFrame or not endCFrame or not template or not tsunamiFolder then
		return nil
	end

	if useStartupPath == true then
		startCFrame = getRandomSpawnCFrame(startCFrame, endCFrame)
	end

	local startPosition = startCFrame.Position
	local endPosition = endCFrame.Position
	local pathVector = endPosition - startPosition
	local pathDistance = pathVector.Magnitude
	local duration = if tsunamiConfig.Speed > 0 then pathDistance / tsunamiConfig.Speed else 0

	if duration <= 0 or pathDistance <= 0 then
		return nil
	end

	local direction = pathVector.Unit
	local startPivot = CFrame.lookAt(startPosition, startPosition + direction) * CFrame.Angles(0, math.rad(-90), 0)
	local targetPivot = CFrame.lookAt(endPosition, endPosition + direction) * CFrame.Angles(0, math.rad(-90), 0)
	local pivotToPartOffset = template:GetPivot():ToObjectSpace(template.CFrame)
	local startPartCFrame = startPivot * pivotToPartOffset
	local targetPartCFrame = targetPivot * pivotToPartOffset
	local activeStatesFolder = getOrCreateActiveStatesFolder(tsunamiFolder)
	if not activeStatesFolder then
		return nil
	end

	nextWaveId += 1
	local startServerTime = Workspace:GetServerTimeNow()
	local state = Instance.new("Folder")
	state.Name = string.format("Wave_%d", nextWaveId)
	state:SetAttribute("WaveId", nextWaveId)
	state:SetAttribute("WorldName", worldName)
	state:SetAttribute("TsunamiName", resolvedTsunamiName)
	state:SetAttribute("TemplateName", tsunamiConfig.ModelName or resolvedTsunamiName)
	state:SetAttribute("StartCFrame", startPartCFrame)
	state:SetAttribute("TargetCFrame", targetPartCFrame)
	state:SetAttribute("StartServerTime", startServerTime)
	state:SetAttribute("Duration", duration)
	state:SetAttribute("VisualSize", template.Size)
	state.Parent = activeStatesFolder

	activeStates[state] = {
		instance = state,
		worldName = worldName,
		startCFrame = startPartCFrame,
		targetCFrame = targetPartCFrame,
		startServerTime = state:GetAttribute("StartServerTime") :: number,
		duration = duration,
		hitHalfExtents = (template.Size * 0.5) + Vector3.new(HIT_PADDING, HIT_PADDING, HIT_PADDING),
		previousWaveCFrame = nil,
		previousPlayerPositions = {},
	}
	startHitEvaluator()

	DebugModule.debugPrint(
		string.format(
			"Spawned tsunami state | waveId=%d | name=%s | world=%s | template=%s | points=%s | start=(%.1f,%.1f,%.1f) | target=(%.1f,%.1f,%.1f) | duration=%.2fs | serverTime=%.3f | stateParent=%s | activeStateCount=%d",
			nextWaveId,
			resolvedTsunamiName,
			worldName,
			tsunamiConfig.ModelName or resolvedTsunamiName,
			pointsFolderName or "Points",
			startPartCFrame.Position.X,
			startPartCFrame.Position.Y,
			startPartCFrame.Position.Z,
			targetPartCFrame.Position.X,
			targetPartCFrame.Position.Y,
			targetPartCFrame.Position.Z,
			duration,
			startServerTime,
			activeStatesFolder:GetFullName(),
			#activeStatesFolder:GetChildren()
		),
		"TsunamiSystem"
	)

	return state
end

function TsunamiSystem.SpawnRandomTsunami(
	worldName: string,
	pointsFolderName: string?,
	useStartupPath: boolean?
): Folder?
	local tsunamiName = TsunamiSystem.RollTsunamiType(worldName)
	if not tsunamiName then
		return nil
	end

	return TsunamiSystem.SpawnTsunami(worldName, tsunamiName, pointsFolderName, useStartupPath)
end

return TsunamiSystem
]]></string>
        </Properties>
