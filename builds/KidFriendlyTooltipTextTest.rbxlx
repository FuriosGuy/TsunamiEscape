        <Item class="ModuleScript" referent="3531">
          <Properties>
            <string name="Name">ProductService_Client</string>
            <string name="Source"><![CDATA[--!strict

-- Client-only purchase prompts and local game-pass ownership cache.
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ProductCatalog = require(Modules.Shared:WaitForChild("ProductCatalog"))
local SoundService = require(Modules:WaitForChild("SoundService"))
local FunnelAnalytics = require(Modules.Shared:WaitForChild("FunnelAnalytics_Client"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))

local ProductService: { [string]: any } = {}
ProductService.Gamepasses = ProductCatalog.Gamepasses
ProductService.DevProducts = ProductCatalog.DevProducts
ProductService.BloodmoonKartProducts = ProductCatalog.BloodmoonKartProducts
ProductService.EventKartProducts = ProductCatalog.EventKartProducts
ProductService.MULTIPLIER_TO_PRODUCT = ProductCatalog.MULTIPLIER_TO_PRODUCT

type CreatorPurchaseFinishedCallback = (purchaseKind: string, productId: number, success: boolean, reason: string) -> ()

local ownershipCache: { [number]: { [number]: boolean } } = {}
local creatorPurchaseFinishedCallbacks: { CreatorPurchaseFinishedCallback } = {}
local CreatorPurchaseRequest = Remotes:WaitForChild("CreatorPurchaseRequest") :: RemoteEvent
local CreatorPurchaseResult = Remotes:WaitForChild("CreatorPurchaseResult") :: RemoteEvent

local function resolveUserId(playerOrUserId: Player | number): number
	if typeof(playerOrUserId) == "Instance" then
		return (playerOrUserId :: Player).UserId
	end

	return playerOrUserId
end

function ProductService.SetGamePassOwnershipCache(playerOrUserId: Player | number, id: number, owned: boolean)
	local userId = resolveUserId(playerOrUserId)
	local userCache = ownershipCache[userId]
	if not userCache then
		userCache = {}
		ownershipCache[userId] = userCache
	end

	userCache[id] = owned
end

function ProductService.ClearOwnershipCache(playerOrUserId: Player | number)
	ownershipCache[resolveUserId(playerOrUserId)] = nil
end

function ProductService.userOwnsGamePass(player: Player, id: number): boolean
	local userId = player.UserId
	local userCache = ownershipCache[userId]
	if not userCache then
		userCache = {}
		ownershipCache[userId] = userCache
	end

	if userCache[id] ~= nil then
		return userCache[id]
	end

	local success, owned = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(userId, id)
	end)
	if success then
		ProductService.SetGamePassOwnershipCache(userId, id, owned)
		return owned
	end

	return false
end

function ProductService.IsLocalExperienceCreator(player: Player): boolean
	local creatorUserId = Remotes:GetAttribute("CreatorPurchaseUserId")
	return player == Players.LocalPlayer
		and typeof(creatorUserId) == "number"
		and player.UserId == creatorUserId
end

function ProductService.ConnectCreatorPurchaseFinished(callback: CreatorPurchaseFinishedCallback): () -> ()
	table.insert(creatorPurchaseFinishedCallbacks, callback)
	local connected = true
	return function()
		if not connected then
			return
		end
		connected = false
		local callbackIndex = table.find(creatorPurchaseFinishedCallbacks, callback)
		if callbackIndex then
			table.remove(creatorPurchaseFinishedCallbacks, callbackIndex)
		end
	end
end

function ProductService.promptGamePassPurchase(player: Player, id: number)
	local success, errorMessage = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, id)
	end)
	if success then
		if id == ProductService.Gamepasses.StarterPack then
			FunnelAnalytics.FireClientAction("StarterPackPromptOpened", {
				source = "GamePassPrompt",
			})
		end
		SoundService.PlayGuiSound("BellRing")
	else
		DebugModule.debugWarn("PromptGamePassPurchase failed: " .. tostring(errorMessage), "ProductService_Client")
	end
end

function ProductService.promptProductPurchase(player: Player, id: number): boolean
	if typeof(id) ~= "number" or id <= 0 then
		DebugModule.debugWarn("Invalid developer product ID: " .. tostring(id), "ProductService_Client")
		return false
	end

	local isCreatorProduct = ProductService.IsLocalExperienceCreator(player)
	local creatorIdentityPending = game.CreatorType == Enum.CreatorType.Group
		and Remotes:GetAttribute("CreatorPurchaseIdentityReady") ~= true
	if creatorIdentityPending then
		DebugModule.debugWarn(
			"Developer product request blocked until creator identity is resolved | productId=" .. tostring(id),
			"ProductService_Client"
		)
		return false
	end

	DebugModule.debugInfo(
		"Developer product route | productId="
			.. tostring(id)
			.. " | creator="
			.. tostring(isCreatorProduct)
			.. " | serviceReady="
			.. tostring(Remotes:GetAttribute("CreatorPurchaseServiceReady")),
		"ProductService_Client"
	)

	if isCreatorProduct then
		if Remotes:GetAttribute("CreatorPurchaseServiceReady") ~= true then
			DebugModule.debugWarn(
				"Creator developer product request blocked until server service is ready | productId=" .. tostring(id),
				"ProductService_Client"
			)
			return false
		end

		local requestOk, requestError = pcall(function()
			CreatorPurchaseRequest:FireServer("Product", id)
		end)
		if requestOk then
			SoundService.PlayGuiSound("BellRing")
			return true
		else
			DebugModule.debugWarn(
				"Creator developer product request failed for productId="
					.. tostring(id)
					.. ": "
					.. tostring(requestError),
				"ProductService_Client"
			)
			return false
		end
	end

	local success, errorMessage = pcall(function()
		MarketplaceService:PromptProductPurchase(player, id)
	end)
	if success then
		SoundService.PlayGuiSound("BellRing")
		return true
	else
		DebugModule.debugWarn(
			"PromptProductPurchase failed for productId=" .. tostring(id) .. ": " .. tostring(errorMessage),
			"ProductService_Client"
		)
		return false
	end
end

CreatorPurchaseResult.OnClientEvent:Connect(function(rawPurchaseKind, rawProductId, rawSuccess, rawReason)
	if
		type(rawPurchaseKind) ~= "string"
		or rawPurchaseKind ~= "Product"
		or type(rawProductId) ~= "number"
		or type(rawSuccess) ~= "boolean"
		or type(rawReason) ~= "string"
	then
		DebugModule.debugWarn("Received malformed creator purchase result", "ProductService_Client")
		return
	end

	for _, callback in ipairs(table.clone(creatorPurchaseFinishedCallbacks)) do
		local callbackOk, callbackError = pcall(callback, rawPurchaseKind, rawProductId, rawSuccess, rawReason)
		if not callbackOk then
			DebugModule.debugWarn(
				"Creator purchase result callback failed: " .. tostring(callbackError),
				"ProductService_Client"
			)
		end
	end
	SoundService.PlayGuiSound(if rawSuccess then "Success" else "Close")
end)

MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, bought)
	if player == Players.LocalPlayer and bought then
		ProductService.SetGamePassOwnershipCache(player, id, true)
	end
	SoundService.PlayGuiSound(if bought then "Success" else "Close")
end)

MarketplaceService.PromptProductPurchaseFinished:Connect(function(_, _, bought)
	SoundService.PlayGuiSound(if bought then "Success" else "Close")
end)

return ProductService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3532">
          <Properties>
            <string name="Name">SystemChatService_Client</string>
            <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")

local DebugModule = require(ReplicatedStorage.Modules:WaitForChild("DebugModule"))

local SystemChatService = {}
local MODULE_NAME = "SystemChatService_Client"
local REMOTE_NAME = "GlobalSystemChat"
local clientConnection: RBXScriptConnection? = nil

local function getRemote(): RemoteEvent?
	local remotes = ReplicatedStorage:FindFirstChild("Remotes") or ReplicatedStorage:WaitForChild("Remotes", 10)
	if not remotes then
		return nil
	end

	local remote = remotes:FindFirstChild(REMOTE_NAME) or remotes:WaitForChild(REMOTE_NAME, 10)
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end

	return nil
end

local function displayMessage(formattedMessage: string)
	local textChannels = TextChatService:FindFirstChild("TextChannels")
		or TextChatService:WaitForChild("TextChannels", 10)
	local generalChannel = textChannels
		and (textChannels:FindFirstChild("RBXGeneral") or textChannels:WaitForChild("RBXGeneral", 10))

	if generalChannel and generalChannel:IsA("TextChannel") then
		generalChannel:DisplaySystemMessage(formattedMessage)
		return
	end

	local success, errorMessage = pcall(function()
		StarterGui:SetCore("ChatMakeSystemMessage", {
			Text = formattedMessage:gsub("<[^>]->", ""),
			Color = Color3.fromRGB(254, 200, 42),
		})
	end)
	if not success then
		DebugModule.debugWarn("No available chat channel for system chat: " .. tostring(errorMessage), MODULE_NAME)
	end
end

function SystemChatService.InitClient()
	if clientConnection then
		return
	end

	local remote = getRemote()
	if not remote then
		DebugModule.debugWarn("Global system chat remote missing", MODULE_NAME)
		return
	end

	clientConnection = remote.OnClientEvent:Connect(function(formattedMessage: any)
		if typeof(formattedMessage) == "string" then
			displayMessage(formattedMessage)
		end
	end)
end

function SystemChatService.ShutdownClient()
	if clientConnection then
		clientConnection:Disconnect()
		clientConnection = nil
	end
end

return SystemChatService
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3533">
          <Properties>
            <string name="Name">VerifyRewardCalculator</string>
            <string name="Source"><![CDATA[local VerifyRewardCalculator = {}

export type VerifyRewardConfig = {
	baseXP: number,
	baseWins: number,
	growthMultiplier: number,
	roundStep: number,
	claimCountAttribute: string,
}

export type VerifyRewardPreview = {
	claimCount: number,
	growthFactor: number,
	baseXP: number,
	baseWins: number,
	xpAward: number,
	winsAward: number,
}

local DEFAULT_BASE_XP = 5000
local DEFAULT_BASE_WINS = 50
local DEFAULT_GROWTH_MULTIPLIER = 1.1
local DEFAULT_ROUND_STEP = 5
local DEFAULT_CLAIM_COUNT_ATTRIBUTE = "VerifyRewardClaimCount"

local function sanitizePositiveNumber(value: any, fallback: number): number
	if typeof(value) ~= "number" or value <= 0 then
		return fallback
	end
	return value
end

local function getNumericAttribute(player: Player, attributeName: string, fallback: number): number
	local rawValue = player:GetAttribute(attributeName)
	return if typeof(rawValue) == "number" then rawValue else fallback
end

local function roundUpToStep(value: number, step: number): number
	if value <= 0 then
		return 0
	end
	return math.ceil(value / step) * step
end

function VerifyRewardCalculator.GetConfig(coreConfig: any): VerifyRewardConfig
	local levelingConfig = if coreConfig then coreConfig.leveling else nil
	local baseXP = sanitizePositiveNumber(if levelingConfig then levelingConfig.verifyRewardXP else nil, DEFAULT_BASE_XP)
	local baseWins = sanitizePositiveNumber(if levelingConfig then levelingConfig.verifyRewardWins else nil, DEFAULT_BASE_WINS)
	local growthMultiplier = sanitizePositiveNumber(
		if levelingConfig then levelingConfig.verifyRewardDailyGrowthMultiplier else nil,
		DEFAULT_GROWTH_MULTIPLIER
	)
	local roundStep = math.max(
		1,
		math.floor(sanitizePositiveNumber(
			if levelingConfig then levelingConfig.verifyRewardRoundStep else nil,
			DEFAULT_ROUND_STEP
		))
	)
	local claimCountAttribute = if levelingConfig
			and typeof(levelingConfig.verifyRewardClaimCountAttribute) == "string"
			and levelingConfig.verifyRewardClaimCountAttribute ~= ""
		then levelingConfig.verifyRewardClaimCountAttribute
		else DEFAULT_CLAIM_COUNT_ATTRIBUTE

	return {
		baseXP = baseXP,
		baseWins = baseWins,
		growthMultiplier = growthMultiplier,
		roundStep = roundStep,
		claimCountAttribute = claimCountAttribute,
	}
end

function VerifyRewardCalculator.GetClaimCount(player: Player, config: VerifyRewardConfig): number
	local rawValue = player:GetAttribute(config.claimCountAttribute)
	return if typeof(rawValue) == "number" then math.max(0, math.floor(rawValue)) else 0
end

function VerifyRewardCalculator.ComputeRewardsForNextClaim(
	player: Player,
	config: VerifyRewardConfig
): VerifyRewardPreview
	local claimCount = VerifyRewardCalculator.GetClaimCount(player, config)
	local growthFactor = math.pow(config.growthMultiplier, claimCount + 1)
	local baseXP = config.baseXP * growthFactor
	local baseWins = config.baseWins * growthFactor

	local rebirthMultiplier = getNumericAttribute(player, "Rebirth_XPMultiplier", 1)
	local devMultiplier = getNumericAttribute(player, "DevProduct_XPSpeedMultiplier", 1)
	local miscMultiplier = getNumericAttribute(player, "Misc_XPSpeedMultiplier", 1)
	local friendMultiplier = getNumericAttribute(player, "Friend_XPMultiplier", 1)
	local treadmillMultiplier = getNumericAttribute(player, "Treadmill_XPMultiplier", 1)
	local winMultiplier = getNumericAttribute(player, "WinMultiplier", 1)

	local effectiveXP = baseXP * rebirthMultiplier * devMultiplier * miscMultiplier * friendMultiplier * treadmillMultiplier
	local effectiveWins = baseWins * winMultiplier

	return {
		claimCount = claimCount,
		growthFactor = growthFactor,
		baseXP = baseXP,
		baseWins = baseWins,
		xpAward = roundUpToStep(effectiveXP, config.roundStep),
		winsAward = roundUpToStep(effectiveWins, config.roundStep),
	}
end

return VerifyRewardCalculator
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="3534">
        <Properties>
          <string name="Name">SoundService</string>
          <string name="Source"><![CDATA[local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RobloxSoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local TweenConfig = require(ReplicatedStorage.Modules.UI.TweenConfig)

local SoundService = {}
local guiSoundFolder: Folder? = nil
if RunService:IsClient() then
	guiSoundFolder = Instance.new("Folder")
	guiSoundFolder.Name = "GuiSounds"
	guiSoundFolder.Parent = RobloxSoundService
end

SoundService.WorldMusicPlaylists = {
	Fallback = {
		LobbyMusicList = { 138197655562277 },
		ActionMusicList = { 72666159391603 },
	},
}

export type SoundSettings = {
	SoundId: string | number,
	Volume: number?,
	Pitch: number?,
	PlaybackSpeed: number?,
	Looped: boolean?,
	AllowOverlap: boolean?,
	RollOffMode: Enum.RollOffMode?,
	RollOffMinDistance: number?,
	RollOffMaxDistance: number?,
	TimePosition: number?,
}

SoundService.Sounds = {
	["Click"] = {
		SoundId = 124637583082916,
		Volume = 0.4,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = false,
	},
	["Pop"] = {
		SoundId = 109359226723492,
		Volume = 0.8,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["Close"] = {
		SoundId = 92389629512441,
		Volume = 0.4,
		Pitch = 1,
		PlaybackSpeed = 0.75,
		Looped = false,
		AllowOverlap = false,
	},
	["BellRing"] = {
		SoundId = 128714357287984,
		Volume = 0.4,
		Pitch = 1,
		PlaybackSpeed = 0.75,
		Looped = false,
		AllowOverlap = false,
	},
	["Success"] = {
		SoundId = 128044073486125,
		Volume = 0.4,
		Pitch = 1,
		PlaybackSpeed = 0.75,
		Looped = false,
		AllowOverlap = false,
	},
	["Hover"] = {
		SoundId = 139800881181209,
		Volume = 0.3,
		Pitch = 1,
		PlaybackSpeed = 1.5,
		Looped = false,
		AllowOverlap = false,
	},
	["LevelUp"] = {
		SoundId = 3120909354,
		Volume = 0.7,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["Rebirth"] = {
		SoundId = 100288208393628,
		Volume = 0.7,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["WinReward"] = {
		SoundId = 136993031050456,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["BloodmoonRise"] = {
		SoundId = 89079094196786,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = false,
	},
	["NeonRushRise"] = {
		SoundId = 3060210880,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = false,
	},
	["Confetti"] = {
		SoundId = 1631688574,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["Swish"] = {
		SoundId = 91252825775281,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["AmbientLoop"] = {
		SoundId = 0,
		Volume = 0.35,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = true,
		RollOffMode = Enum.RollOffMode.InverseTapered,
		RollOffMinDistance = 10,
		RollOffMaxDistance = 80,
	},
	["Wave Crash"] = {
		SoundId = 79068891226084,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = true,
		RollOffMode = Enum.RollOffMode.InverseTapered,
		RollOffMinDistance = 64,
		RollOffMaxDistance = 256,
	},
	["KartEngine"] = {
		SoundId = 9112787430,
		Volume = 2,
		Pitch = 1,
		PlaybackSpeed = 0.5,
		Looped = true,
		RollOffMode = Enum.RollOffMode.InverseTapered,
		RollOffMinDistance = 32,
		RollOffMaxDistance = 96,
	},
}

local function normalizeSoundId(soundId: string | number): string
	if typeof(soundId) == "number" then
		return "rbxassetid://" .. tostring(soundId)
	end

	if string.find(soundId, "rbxassetid://") == 1 then
		return soundId
	end

	return "rbxassetid://" .. soundId
end

local function getConfig(soundName: string): SoundSettings?
	local config = SoundService.Sounds[soundName]
	if not config then
		DebugModule.debugWarn("Missing sound config for " .. soundName, "SoundService")
		return nil
	end

	return config
end

local function applyProperties(sound: Sound, soundName: string, config: SoundSettings)
	sound.SoundId = normalizeSoundId(config.SoundId)
	sound.Volume = config.Volume or 1
	sound.PlaybackSpeed = config.PlaybackSpeed or config.Pitch or 1
	sound.Looped = config.Looped == true
	sound.Name = soundName

	if config.TimePosition then
		sound.TimePosition = config.TimePosition
	end

	if config.RollOffMode then
		sound.RollOffMode = config.RollOffMode
	end

	if config.RollOffMinDistance then
		sound.RollOffMinDistance = config.RollOffMinDistance
	end

	if config.RollOffMaxDistance then
		sound.RollOffMaxDistance = config.RollOffMaxDistance
	end
end

local function createSound(parent: Instance, soundName: string, overrideSettings: SoundSettings?): Sound?
	local baseConfig = getConfig(soundName)
	if not baseConfig then
		return nil
	end

	local mergedConfig = table.clone(baseConfig)
	if overrideSettings then
		for key, value in pairs(overrideSettings) do
			(mergedConfig :: any)[key] = value
		end
	end

	local sound = Instance.new("Sound")
	applyProperties(sound, soundName, mergedConfig)
	sound.Parent = parent

	return sound
end

local function getOrCreateCachedGuiSound(soundName: string): Sound?
	if not guiSoundFolder then
		return nil
	end

	local existing = guiSoundFolder:FindFirstChild(soundName)
	if existing and existing:IsA("Sound") then
		return existing
	end

	local sound = createSound(guiSoundFolder, soundName)
	if not sound then
		return nil
	end

	return sound
end

function SoundService.RegisterSound(soundName: string, config: SoundSettings)
	SoundService.Sounds[soundName] = config
	DebugModule.debugPrint("Registered sound config for " .. soundName, "SoundService")
end

function SoundService.GetWorldMusicPlaylist(worldName: string?, playlistName: string?): { string | number }
	local selectedPlaylistName = playlistName or "LobbyMusicList"
	local worldConfig = if worldName then SoundService.WorldMusicPlaylists[worldName] else nil
	local playlist = worldConfig and worldConfig[selectedPlaylistName]
	if playlist and #playlist > 0 then
		return playlist
	end

	local fallbackConfig = SoundService.WorldMusicPlaylists.Fallback
	local fallbackPlaylist = fallbackConfig and fallbackConfig[selectedPlaylistName]
	if fallbackPlaylist and #fallbackPlaylist > 0 then
		return fallbackPlaylist
	end

	return {}
end

function SoundService.CreateSound(parent: Instance, soundName: string, overrideSettings: SoundSettings?): Sound?
	return createSound(parent, soundName, overrideSettings)
end

function SoundService.PlayGuiSound(soundName: string, parent: Instance?, overrideSettings: SoundSettings?): Sound?
	local baseConfig = getConfig(soundName)
	if not baseConfig then
		return nil
	end

	if parent == nil and overrideSettings == nil and not baseConfig.AllowOverlap then
		local cachedSound = getOrCreateCachedGuiSound(soundName)
		if not cachedSound then
			return nil
		end

		cachedSound:Stop()
		cachedSound.TimePosition = 0
		cachedSound:Play()
		return cachedSound
	end

	local targetParent = parent or RobloxSoundService
	local sound = createSound(targetParent, soundName, overrideSettings)
	if not sound then
		return nil
	end

	sound:Play()
	if not sound.Looped then
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	end

	return sound
end

function SoundService.PlayWorkspaceSound(soundName: string, parent: Instance, overrideSettings: SoundSettings?): Sound?
	local sound = createSound(parent, soundName, overrideSettings)
	if not sound then
		return nil
	end

	sound:Play()
	if not sound.Looped then
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	end

	return sound
end

function SoundService.StopSound(sound: Sound)
	sound:Stop()
end

function SoundService.FadeOutAndDestroy(sound: Sound, fadeTime: number)
	local tween = TweenService:Create(sound, TweenConfig.WithDuration(fadeTime, TweenConfig.MusicFade), { Volume = 0 })
	tween:Play()
	tween.Completed:Once(function()
		sound:Stop()
		sound:Destroy()
	end)
end

return SoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3535">
        <Properties>
          <string name="Name">TsunamiVisualService</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local SoundService = require(game:GetService("ReplicatedStorage").Modules.SoundService)
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)
local TweenConfig = require(ReplicatedStorage.Modules.UI.TweenConfig)
local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)

type VisualConfig = {
	enabled: boolean,
	billboardMaxDistance: number,
	disableShadows: boolean,
	soundGraceSeconds: number,
}

type StateBinding = {
	state: Folder,
	maid: any,
	visualMaid: any?,
	visual: BasePart?,
	templateName: string?,
	startCFrame: CFrame?,
	targetCFrame: CFrame?,
	startServerTime: number?,
	duration: number?,
	lastInvalidAttributes: string?,
	expiredLogged: boolean,
}

type StateData = {
	templateName: string,
	startCFrame: CFrame,
	targetCFrame: CFrame,
	startServerTime: number,
	duration: number,
	visualSize: Vector3,
}

type WorldBinding = {
	world: Instance,
	maid: any,
	tsunamiMaid: any?,
	activeStatesMaid: any?,
	states: { [Folder]: StateBinding },
	visualFolder: Folder?,
	activeStatesFolder: Folder?,
	tsunamiFolder: Instance?,
}

type ServiceState = {
	maid: any,
	worldBindings: { [Instance]: WorldBinding },
	worldsFolder: Instance?,
	worldsMaid: any?,
	liveEventState: Folder?,
	liveEventStateMaid: any?,
	isRunning: boolean,
}

local TsunamiVisualService = {}
local serviceState: ServiceState? = nil
local tsunamiTemplatesFolder = ReplicatedStorage:WaitForChild("Tsunamis")

local DEFAULT_CONFIG: VisualConfig = {
	enabled = true,
	billboardMaxDistance = 450,
	disableShadows = true,
	soundGraceSeconds = 1.5,
}

local function getAttributeTypeSummary(state: Folder): string
	return string.format(
		"TemplateName=%s,StartCFrame=%s,TargetCFrame=%s,StartServerTime=%s,Duration=%s,VisualSize=%s",
		typeof(state:GetAttribute("TemplateName")),
		typeof(state:GetAttribute("StartCFrame")),
		typeof(state:GetAttribute("TargetCFrame")),
		typeof(state:GetAttribute("StartServerTime")),
		typeof(state:GetAttribute("Duration")),
		typeof(state:GetAttribute("VisualSize"))
	)
end

local function getTemplateFolderSummary(): string
	local templateNames = {}
	for _, child in ipairs(tsunamiTemplatesFolder:GetChildren()) do
		table.insert(templateNames, child.Name .. ":" .. child.ClassName)
	end
	table.sort(templateNames)
	return if #templateNames > 0 then table.concat(templateNames, ",") else "none"
end

local function getConfig(): VisualConfig
	local rawConfig = CoreConfig.clientTsunamiVisuals
	if typeof(rawConfig) ~= "table" then
		return table.clone(DEFAULT_CONFIG)
	end

	local billboardMaxDistance = if typeof(rawConfig.billboardMaxDistance) == "number"
		then math.max(0, rawConfig.billboardMaxDistance)
		else DEFAULT_CONFIG.billboardMaxDistance
	local soundGraceSeconds = if typeof(rawConfig.soundGraceSeconds) == "number"
		then math.max(0, rawConfig.soundGraceSeconds)
		else DEFAULT_CONFIG.soundGraceSeconds

	return {
		enabled = rawConfig.enabled ~= false,
		billboardMaxDistance = billboardMaxDistance,
		disableShadows = rawConfig.disableShadows ~= false,
		soundGraceSeconds = soundGraceSeconds,
	}
end

local function isBloodmoonActive(): boolean
	local liveEventState = ReplicatedStorage:FindFirstChild("LiveEventState")
	if not liveEventState or not liveEventState:IsA("Folder") then
		return false
	end

	local activeEventIds = liveEventState:GetAttribute("ActiveEventIds")
	return typeof(activeEventIds) == "string"
		and string.find("," .. activeEventIds .. ",", ",Bloodmoon,", 1, true) ~= nil
end

local function getTemplate(templateName: string): BasePart?
	local template = tsunamiTemplatesFolder:FindFirstChild(templateName)
	return if template and template:IsA("BasePart") then template else nil
end

local function applyBillboardTextColor(visual: BasePart, sourceTemplate: BasePart, colorTemplate: BasePart)
	local visualBillboard = visual:FindFirstChild("BillboardGui", true)
	local sourceBillboard = sourceTemplate:FindFirstChild("BillboardGui", true)
	local colorBillboard = colorTemplate:FindFirstChild("BillboardGui", true)
	if not visualBillboard or not sourceBillboard or not colorBillboard then
		return
	end

	for _, sourceDescendant in ipairs(sourceBillboard:GetDescendants()) do
		if not sourceDescendant:IsA("TextLabel") and not sourceDescendant:IsA("TextButton") then
			continue
		end

		local visualText = visualBillboard:FindFirstChild(sourceDescendant.Name, true)
		local colorText = colorBillboard:FindFirstChild(sourceDescendant.Name, true)
		if not visualText or not colorText then
			continue
		end
		if not visualText:IsA("TextLabel") and not visualText:IsA("TextButton") then
			continue
		end
		if not colorText:IsA("TextLabel") and not colorText:IsA("TextButton") then
			continue
		end

		visualText.TextColor3 = colorText.TextColor3
		local sourceGradient = sourceDescendant:FindFirstChildOfClass("UIGradient")
		local colorGradient = colorText:FindFirstChildOfClass("UIGradient")
		local visualGradient = visualText:FindFirstChildOfClass("UIGradient")
		if sourceGradient and colorGradient and visualGradient then
			visualGradient.Color = colorGradient.Color
			visualGradient.Rotation = colorGradient.Rotation
		end
	end
end

local function applyVisualColor(visual: BasePart, templateName: string)
	local sourceTemplate = getTemplate(templateName)
	local colorTemplate = if isBloodmoonActive() then getTemplate("Extremely Fast") else sourceTemplate
	if colorTemplate then
		visual.Color = colorTemplate.Color
		if sourceTemplate then
			applyBillboardTextColor(visual, sourceTemplate, colorTemplate)
		end
	end
end

local function cleanupVisual(binding: StateBinding, reason: string)
	if binding.visualMaid then
		local visual = binding.visual
		DebugModule.debugInfo(
			string.format(
				"Cleanup visual | waveId=%s | reason=%s | visualParent=%s | position=%s",
				tostring(binding.state:GetAttribute("WaveId") or binding.state.Name),
				reason,
				if visual and visual.Parent then visual.Parent:GetFullName() else "nil",
				if visual then tostring(visual.Position) else "nil"
			),
			"TsunamiVisualService"
		)
		binding.visualMaid:DoCleaning()
		binding.visualMaid = nil
	end

	binding.visual = nil
end

local function getVisualFolder(binding: WorldBinding): Folder?
	local existingFolder = binding.world:FindFirstChild("ClientTsunamiVisuals")
	if existingFolder then
		if existingFolder:IsA("Folder") then
			binding.visualFolder = existingFolder
			return existingFolder
		end

		DebugModule.debugWarn(
			"ClientTsunamiVisuals exists but is not a Folder in " .. binding.world:GetFullName(),
			"TsunamiVisualService"
		)
		return nil
	end

	local visualFolder = Instance.new("Folder")
	visualFolder.Name = "ClientTsunamiVisuals"
	visualFolder:SetAttribute("DisableClientCulling", true)
	visualFolder.Parent = binding.world
	binding.visualFolder = visualFolder
	return visualFolder
end

local function configureVisual(visual: BasePart, config: VisualConfig)
	visual.Anchored = true
	visual.CanCollide = false
	visual.CanTouch = false
	visual.CanQuery = false
	if config.disableShadows then
		visual.CastShadow = false
	end

	for _, descendant in ipairs(visual:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			if config.disableShadows then
				descendant.CastShadow = false
			end
		elseif descendant:IsA("BillboardGui") then
			descendant.MaxDistance = config.billboardMaxDistance
		end
	end
end

local function readStateAttributes(state: Folder): (StateData?, string?)
	local templateName = state:GetAttribute("TemplateName")
	local startCFrame = state:GetAttribute("StartCFrame")
	local targetCFrame = state:GetAttribute("TargetCFrame")
	local startServerTime = state:GetAttribute("StartServerTime")
	local duration = state:GetAttribute("Duration")
	local visualSize = state:GetAttribute("VisualSize")

	if
		typeof(templateName) ~= "string"
		or typeof(startCFrame) ~= "CFrame"
		or typeof(targetCFrame) ~= "CFrame"
		or typeof(startServerTime) ~= "number"
		or typeof(duration) ~= "number"
		or typeof(visualSize) ~= "Vector3"
		or duration <= 0
	then
		return nil, getAttributeTypeSummary(state)
	end

	return {
		templateName = templateName,
		startCFrame = startCFrame,
		targetCFrame = targetCFrame,
		startServerTime = startServerTime,
		duration = duration,
		visualSize = visualSize,
	},
		nil
end

local function refreshStateVisual(binding: StateBinding, worldBinding: WorldBinding)
	local config = getConfig()
	if not config.enabled then
		cleanupVisual(binding, "config.disabled")
		return
	end
	if not binding.state.Parent then
		return
	end

	local stateData, invalidAttributes = readStateAttributes(binding.state)
	if not stateData then
		if binding.lastInvalidAttributes ~= invalidAttributes then
			binding.lastInvalidAttributes = invalidAttributes
			DebugModule.debugWarn(
				string.format(
					"State attributes incomplete | waveId=%s | path=%s | fields=%s | stateParent=%s",
					tostring(binding.state:GetAttribute("WaveId") or binding.state.Name),
					binding.state:GetFullName(),
					invalidAttributes or "unknown",
					if binding.state.Parent then binding.state.Parent:GetFullName() else "nil"
				),
				"TsunamiVisualService"
			)
		end
		return
	end
	if binding.lastInvalidAttributes then
		DebugModule.debugInfo(
			string.format(
				"State attributes recovered | waveId=%s | fields=%s",
				tostring(binding.state:GetAttribute("WaveId") or binding.state.Name),
				binding.lastInvalidAttributes
			),
			"TsunamiVisualService"
		)
		binding.lastInvalidAttributes = nil
	end
	binding.expiredLogged = false

	local templateName = stateData.templateName
	local startCFrame = stateData.startCFrame
	local targetCFrame = stateData.targetCFrame
	local startServerTime = stateData.startServerTime
	local duration = stateData.duration
	local visualSize = stateData.visualSize

	if
		binding.visual
		and binding.visual.Parent
		and binding.templateName == templateName
		and binding.startCFrame == startCFrame
		and binding.targetCFrame == targetCFrame
		and binding.startServerTime == startServerTime
		and binding.duration == duration
	then
		return
	end

	cleanupVisual(binding, "state.changed")

	local now = Workspace:GetServerTimeNow()
	local elapsed = now - startServerTime
	if elapsed >= duration then
		if not binding.expiredLogged then
			binding.expiredLogged = true
			DebugModule.debugWarn(
				string.format(
					"State arrived too late for visual | waveId=%s | template=%s | age=%.2fs | duration=%.2fs | lateBy=%.2fs | stateParent=%s",
					tostring(binding.state:GetAttribute("WaveId") or binding.state.Name),
					templateName,
					elapsed,
					duration,
					elapsed - duration,
					if binding.state.Parent then binding.state.Parent:GetFullName() else "nil"
				),
				"TsunamiVisualService"
			)
		end
		return
	end

	local template = tsunamiTemplatesFolder:FindFirstChild(templateName)
	if not template or not template:IsA("BasePart") then
		DebugModule.debugWarn(
			string.format(
				"Client template lookup failed | waveId=%s | requested=%s | folder=%s | children=%s | state=%s",
				tostring(binding.state:GetAttribute("WaveId") or binding.state.Name),
				templateName,
				tsunamiTemplatesFolder:GetFullName(),
				getTemplateFolderSummary(),
				binding.state:GetFullName()
			),
			"TsunamiVisualService"
		)
		return
	end

	local visualFolder = getVisualFolder(worldBinding)
	if not visualFolder then
		return
	end

	local visual = template:Clone()
	visual.Name = "ClientTsunami_" .. tostring(binding.state:GetAttribute("WaveId") or binding.state.Name)
	visual:SetAttribute("DisableClientCulling", true)
	configureVisual(visual, config)
	applyVisualColor(visual, templateName)

	local clampedElapsed = math.max(0, elapsed)
	local alpha = math.clamp(clampedElapsed / duration, 0, 1)
	visual.CFrame = startCFrame:Lerp(targetCFrame, alpha)
	visual.Parent = visualFolder

	local visualMaid = Maid.new()
	visualMaid:GiveTask(visual)
	binding.visualMaid = visualMaid
	binding.visual = visual
	binding.templateName = templateName
	binding.startCFrame = startCFrame
	binding.targetCFrame = targetCFrame
	binding.startServerTime = startServerTime
	binding.duration = duration

	local remaining = duration - clampedElapsed
	local tween = TweenService:Create(visual, TweenConfig.WithDuration(remaining, TweenConfig.TsunamiVisual), {
		CFrame = targetCFrame,
	})
	visualMaid:GiveTask(tween)
	visualMaid:GiveTask(tween.Completed:Connect(function(playbackState)
		if binding.visual ~= visual then
			return
		end
		DebugModule.debugInfo(
			string.format(
				"Visual tween completed | waveId=%s | state=%s | playbackState=%s | visualParent=%s | atTarget=%s",
				tostring(binding.state:GetAttribute("WaveId") or binding.state.Name),
				if binding.state.Parent then "present" else "removed",
				tostring(playbackState),
				if visual.Parent then visual.Parent:GetFullName() else "nil",
				tostring((visual.CFrame.Position - targetCFrame.Position).Magnitude <= 0.1)
			),
			"TsunamiVisualService"
		)
	end))
	tween:Play()

	if clampedElapsed <= config.soundGraceSeconds then
		local sound = SoundService.PlayWorkspaceSound("Wave Crash", visual)
		if sound then
			visualMaid:GiveTask(sound)
		end
	end

	DebugModule.debugInfo(
		string.format("Bound %s tsunami visual; remaining=%.2fs", templateName, remaining),
		"TsunamiVisualService"
	)
	DebugModule.debugInfo(
		string.format(
			"Visual created | waveId=%s | template=%s | age=%.2fs | remaining=%.2fs | start=%s | target=%s | current=%s | parent=%s | transparency=%.2f | localTransparency=%.2f | anchored=%s | canQuery=%s | canTouch=%s | canCollide=%s",
			tostring(binding.state:GetAttribute("WaveId") or binding.state.Name),
			templateName,
			clampedElapsed,
			remaining,
			tostring(startCFrame.Position),
			tostring(targetCFrame.Position),
			tostring(visual.Position),
			if visual.Parent then visual.Parent:GetFullName() else "nil",
			visual.Transparency,
			visual.LocalTransparencyModifier,
			tostring(visual.Anchored),
			tostring(visual.CanQuery),
			tostring(visual.CanTouch),
			tostring(visual.CanCollide)
		),
		"TsunamiVisualService"
	)

	-- The size attribute is read to validate the replicated state contract.
	if visual.Size ~= visualSize then
		DebugModule.debugWarn(
			"Client tsunami template size differs from server state for " .. templateName,
			"TsunamiVisualService"
		)
	end
end

local function cleanupState(worldBinding: WorldBinding, state: Folder)
	local binding = worldBinding.states[state]
	if not binding then
		return
	end

	DebugModule.debugInfo(
		string.format(
			"State removed | waveId=%s | stateParent=%s | visualParent=%s",
			tostring(state:GetAttribute("WaveId") or state.Name),
			if state.Parent then state.Parent:GetFullName() else "nil",
			if binding.visual and binding.visual.Parent then binding.visual.Parent:GetFullName() else "nil"
		),
		"TsunamiVisualService"
	)
	worldBinding.states[state] = nil
	binding.maid:DoCleaning()
end

local function bindState(worldBinding: WorldBinding, state: Instance)
	if not state:IsA("Folder") or worldBinding.states[state] then
		return
	end

	local stateBinding: StateBinding = {
		state = state,
		maid = Maid.new(),
		visualMaid = nil,
		visual = nil,
		templateName = nil,
		startCFrame = nil,
		targetCFrame = nil,
		startServerTime = nil,
		duration = nil,
		lastInvalidAttributes = nil,
		expiredLogged = false,
	}
	worldBinding.states[state] = stateBinding
	stateBinding.maid:GiveTask(function()
		cleanupVisual(stateBinding, "state.cleanup")
	end)

	stateBinding.maid:GiveTask(state.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			cleanupState(worldBinding, state)
		end
	end))
	for _, attributeName in ipairs({
		"TemplateName",
		"StartCFrame",
		"TargetCFrame",
		"StartServerTime",
		"Duration",
		"VisualSize",
	}) do
		stateBinding.maid:GiveTask(state:GetAttributeChangedSignal(attributeName):Connect(function()
			refreshStateVisual(stateBinding, worldBinding)
		end))
	end

	DebugModule.debugInfo(
		string.format(
			"State arrived | waveId=%s | path=%s | stateParent=%s | serverAge=%s | attributes=%s | activeStateCount=%d",
			tostring(state:GetAttribute("WaveId") or state.Name),
			state:GetFullName(),
			if state.Parent then state.Parent:GetFullName() else "nil",
			if typeof(state:GetAttribute("StartServerTime")) == "number"
				then string.format(
					"%.2fs",
					Workspace:GetServerTimeNow() - (state:GetAttribute("StartServerTime") :: number)
				)
				else "unknown",
			getAttributeTypeSummary(state),
			if worldBinding.activeStatesFolder then #worldBinding.activeStatesFolder:GetChildren() else 0
		),
		"TsunamiVisualService"
	)

	refreshStateVisual(stateBinding, worldBinding)
end

local function bindActiveStatesFolder(worldBinding: WorldBinding, activeStatesFolder: Instance)
	if not activeStatesFolder:IsA("Folder") then
		DebugModule.debugWarn(
			"ActiveStates is not a Folder in " .. worldBinding.world:GetFullName(),
			"TsunamiVisualService"
		)
		return
	end

	if worldBinding.activeStatesFolder == activeStatesFolder then
		return
	end

	if worldBinding.activeStatesMaid then
		worldBinding.activeStatesMaid:DoCleaning()
		worldBinding.activeStatesMaid = nil
	end
	for state in pairs(worldBinding.states) do
		cleanupState(worldBinding, state)
	end

	worldBinding.activeStatesFolder = activeStatesFolder
	local activeStatesMaid = Maid.new()
	worldBinding.activeStatesMaid = activeStatesMaid
	activeStatesMaid:GiveTask(activeStatesFolder.ChildAdded:Connect(function(child)
		bindState(worldBinding, child)
	end))
	activeStatesMaid:GiveTask(activeStatesFolder.ChildRemoved:Connect(function(child)
		if child:IsA("Folder") then
			cleanupState(worldBinding, child)
		end
	end))

	for _, state in ipairs(activeStatesFolder:GetChildren()) do
		bindState(worldBinding, state)
	end
end

local function bindTsunamiFolder(worldBinding: WorldBinding, tsunamiFolder: Instance)
	if worldBinding.tsunamiFolder == tsunamiFolder then
		return
	end

	if worldBinding.tsunamiMaid then
		worldBinding.tsunamiMaid:DoCleaning()
		worldBinding.tsunamiMaid = nil
	end
	if worldBinding.activeStatesMaid then
		worldBinding.activeStatesMaid:DoCleaning()
		worldBinding.activeStatesMaid = nil
	end
	for state in pairs(worldBinding.states) do
		cleanupState(worldBinding, state)
	end

	worldBinding.tsunamiFolder = tsunamiFolder
	local tsunamiMaid = Maid.new()
	worldBinding.tsunamiMaid = tsunamiMaid
	local activeStatesFolder = tsunamiFolder:FindFirstChild("ActiveStates")
	if activeStatesFolder then
		bindActiveStatesFolder(worldBinding, activeStatesFolder)
	end

	tsunamiMaid:GiveTask(tsunamiFolder.ChildAdded:Connect(function(child)
		if child.Name == "ActiveStates" then
			bindActiveStatesFolder(worldBinding, child)
		end
	end))
	tsunamiMaid:GiveTask(tsunamiFolder.ChildRemoved:Connect(function(child)
		if child == worldBinding.activeStatesFolder then
			for state in pairs(worldBinding.states) do
				cleanupState(worldBinding, state)
			end
			if worldBinding.activeStatesMaid then
				worldBinding.activeStatesMaid:DoCleaning()
				worldBinding.activeStatesMaid = nil
			end
			worldBinding.activeStatesFolder = nil
		end
	end))
end

local function refreshWorldVisuals(worldBinding: WorldBinding)
	for _, stateBinding in pairs(worldBinding.states) do
		refreshStateVisual(stateBinding, worldBinding)
	end
end

local function refreshAllVisualColors()
	local state = serviceState
	if not state or not state.isRunning then
		return
	end

	for _, worldBinding in pairs(state.worldBindings) do
		for _, stateBinding in pairs(worldBinding.states) do
			if stateBinding.visual and stateBinding.visual.Parent and stateBinding.templateName then
				applyVisualColor(stateBinding.visual, stateBinding.templateName)
			end
		end
	end
end

local function bindLiveEventState(state: ServiceState, liveEventState: Instance)
	if not liveEventState:IsA("Folder") or state.liveEventState == liveEventState then
		return
	end

	if state.liveEventStateMaid then
		state.liveEventStateMaid:DoCleaning()
	end

	state.liveEventState = liveEventState
	local liveEventStateMaid = Maid.new()
	state.liveEventStateMaid = liveEventStateMaid
	liveEventStateMaid:GiveTask(liveEventState:GetAttributeChangedSignal("ActiveEventIds"):Connect(function()
		refreshAllVisualColors()
		DebugModule.debugInfo(
			"Bloodmoon tsunami color mode updated | active=" .. tostring(isBloodmoonActive()),
			"TsunamiVisualService"
		)
	end))

	refreshAllVisualColors()
end

local function cleanupWorld(state: ServiceState, world: Instance)
	local worldBinding = state.worldBindings[world]
	if not worldBinding then
		return
	end

	state.worldBindings[world] = nil
	for stateFolder in pairs(worldBinding.states) do
		cleanupState(worldBinding, stateFolder)
	end
	if worldBinding.tsunamiMaid then
		worldBinding.tsunamiMaid:DoCleaning()
		worldBinding.tsunamiMaid = nil
	end
	if worldBinding.activeStatesMaid then
		worldBinding.activeStatesMaid:DoCleaning()
		worldBinding.activeStatesMaid = nil
	end
	worldBinding.maid:DoCleaning()
	if worldBinding.visualFolder and worldBinding.visualFolder.Parent then
		worldBinding.visualFolder:Destroy()
	end
end

local function bindWorld(state: ServiceState, world: Instance)
	if state.worldBindings[world] then
		return
	end

	local worldBinding: WorldBinding = {
		world = world,
		maid = Maid.new(),
		tsunamiMaid = nil,
		activeStatesMaid = nil,
		states = {},
		visualFolder = nil,
		activeStatesFolder = nil,
		tsunamiFolder = nil,
	}
	state.worldBindings[world] = worldBinding

	worldBinding.maid:GiveTask(world.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			cleanupWorld(state, world)
		end
	end))
	worldBinding.maid:GiveTask(world.ChildAdded:Connect(function(child)
		if child.Name == "Tsunamis" then
			bindTsunamiFolder(worldBinding, child)
		elseif child.Name == "ClientTsunamiVisuals" and child:IsA("Folder") then
			worldBinding.visualFolder = child
			refreshWorldVisuals(worldBinding)
		end
	end))
	worldBinding.maid:GiveTask(world.ChildRemoved:Connect(function(child)
		if child == worldBinding.tsunamiFolder then
			for stateFolder in pairs(worldBinding.states) do
				cleanupState(worldBinding, stateFolder)
			end
			if worldBinding.tsunamiMaid then
				worldBinding.tsunamiMaid:DoCleaning()
				worldBinding.tsunamiMaid = nil
			end
			if worldBinding.activeStatesMaid then
				worldBinding.activeStatesMaid:DoCleaning()
				worldBinding.activeStatesMaid = nil
			end
			worldBinding.tsunamiFolder = nil
			worldBinding.activeStatesFolder = nil
		elseif child == worldBinding.visualFolder then
			worldBinding.visualFolder = nil
			refreshWorldVisuals(worldBinding)
		end
	end))

	local tsunamiFolder = world:FindFirstChild("Tsunamis")
	if tsunamiFolder then
		bindTsunamiFolder(worldBinding, tsunamiFolder)
	end
end

local function bindWorldsFolder(state: ServiceState, worldsFolder: Instance)
	if state.worldsFolder == worldsFolder then
		return
	end

	if state.worldsMaid then
		state.worldsMaid:DoCleaning()
		state.worldsMaid = nil
	end
	for world in pairs(state.worldBindings) do
		cleanupWorld(state, world)
	end

	state.worldsFolder = worldsFolder
	local worldsMaid = Maid.new()
	state.worldsMaid = worldsMaid
	worldsMaid:GiveTask(worldsFolder.ChildAdded:Connect(function(world)
		bindWorld(state, world)
	end))
	worldsMaid:GiveTask(worldsFolder.ChildRemoved:Connect(function(world)
		cleanupWorld(state, world)
	end))

	for _, world in ipairs(worldsFolder:GetChildren()) do
		bindWorld(state, world)
	end
end

function TsunamiVisualService.Start()
	if serviceState and serviceState.isRunning then
		return
	end
	if not RunService:IsClient() then
		return
	end

	local state: ServiceState = {
		maid = Maid.new(),
		worldBindings = {},
		worldsFolder = nil,
		worldsMaid = nil,
		liveEventState = nil,
		liveEventStateMaid = nil,
		isRunning = true,
	}
	serviceState = state

	local config = getConfig()
	if not config.enabled then
		DebugModule.debugInfo("Tsunami visual service disabled by config", "TsunamiVisualService")
		return
	end

	local existingLiveEventState = ReplicatedStorage:FindFirstChild("LiveEventState")
	if existingLiveEventState then
		bindLiveEventState(state, existingLiveEventState)
	end
	state.maid:GiveTask(ReplicatedStorage.ChildAdded:Connect(function(child)
		if child.Name == "LiveEventState" then
			bindLiveEventState(state, child)
		end
	end))
	state.maid:GiveTask(ReplicatedStorage.ChildRemoved:Connect(function(child)
		if child ~= state.liveEventState then
			return
		end

		if state.liveEventStateMaid then
			state.liveEventStateMaid:DoCleaning()
			state.liveEventStateMaid = nil
		end
		state.liveEventState = nil
		refreshAllVisualColors()
	end))

	local function onWorldsFolderAdded(child: Instance)
		if child.Name == "Worlds" then
			bindWorldsFolder(state, child)
		end
	end

	state.maid:GiveTask(Workspace.ChildAdded:Connect(onWorldsFolderAdded))
	state.maid:GiveTask(Workspace.ChildRemoved:Connect(function(child)
		if child ~= state.worldsFolder then
			return
		end

		if state.worldsMaid then
			state.worldsMaid:DoCleaning()
			state.worldsMaid = nil
		end
		for world in pairs(state.worldBindings) do
			cleanupWorld(state, world)
		end
		state.worldsFolder = nil
	end))
	local worldsFolder = Workspace:FindFirstChild("Worlds") or Workspace:WaitForChild("Worlds", 15)
	if worldsFolder then
		bindWorldsFolder(state, worldsFolder)
	else
		DebugModule.debugWarn("Workspace.Worlds was not available within 15 seconds", "TsunamiVisualService")
	end

	state.maid:GiveTask(function()
		state.isRunning = false
		if state.worldsMaid then
			state.worldsMaid:DoCleaning()
			state.worldsMaid = nil
		end
		for world in pairs(state.worldBindings) do
			cleanupWorld(state, world)
		end
		table.clear(state.worldBindings)
		state.worldsFolder = nil
		if state.liveEventStateMaid then
			state.liveEventStateMaid:DoCleaning()
			state.liveEventStateMaid = nil
		end
		state.liveEventState = nil
	end)

	DebugModule.debugInfo("Tsunami visual service started", "TsunamiVisualService")
end

function TsunamiVisualService.Stop()
	local state = serviceState
	if not state then
		return
	end

	serviceState = nil
	state.isRunning = false
	state.maid:DoCleaning()
	table.clear(state.worldBindings)
	DebugModule.debugInfo("Tsunami visual service stopped", "TsunamiVisualService")
end

return TsunamiVisualService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3536">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="3537">
          <Properties>
            <string name="Name">ConfettiBurstPlayer</string>
            <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfettiController = require(ReplicatedStorage.Modules.UI:WaitForChild("ConfettiController"))

export type ConfettiBurstPlayer = {
	PlayBurst: (
		self: ConfettiBurstPlayer,
		colors: { Color3 }?,
		duration: number?,
		totalCount: number?,
		batchSize: number?,
		batchDelay: number?
	) -> (),
	Reset: (self: ConfettiBurstPlayer) -> (),
	Destroy: (self: ConfettiBurstPlayer) -> (),
}

type ConfettiBurstPlayerInternal = ConfettiBurstPlayer & {
	_container: GuiObject,
	_emitter: any,
	_renderConnection: RBXScriptConnection?,
	_destroyed: boolean,
}

local ConfettiBurstPlayer = {}
ConfettiBurstPlayer.__index = ConfettiBurstPlayer

local singleton: ConfettiBurstPlayerInternal? = nil

local function startLoop(self: ConfettiBurstPlayerInternal)
	if self._renderConnection then
		return
	end

	self._renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
		self._emitter:Update(deltaTime)
		if not self._emitter:IsActive() and self._renderConnection then
			self._renderConnection:Disconnect()
			self._renderConnection = nil
		end
	end)
end

function ConfettiBurstPlayer.new(container: GuiObject): ConfettiBurstPlayer
	local self = setmetatable({
		_container = container,
		_emitter = ConfettiController.new(container, 40),
		_renderConnection = nil,
		_destroyed = false,
	}, ConfettiBurstPlayer) :: ConfettiBurstPlayerInternal

	return self
end

function ConfettiBurstPlayer.GetOrCreateSingleton(container: GuiObject?): ConfettiBurstPlayer?
	if not container then
		return nil
	end

	if singleton and singleton._destroyed then
		singleton = nil
	end

	if singleton and singleton._container == container and container.Parent ~= nil then
		return singleton
	end

	if singleton then
		singleton:Destroy()
		singleton = nil
	end

	singleton = ConfettiBurstPlayer.new(container) :: ConfettiBurstPlayerInternal
	return singleton
end

function ConfettiBurstPlayer:PlayBurst(
	colors: { Color3 }?,
	duration: number?,
	totalCount: number?,
	batchSize: number?,
	batchDelay: number?
)
	local selfInternal = self :: ConfettiBurstPlayerInternal
	if selfInternal._destroyed then
		return
	end

	selfInternal._emitter:Reset()
	selfInternal._emitter:PlayBurst(colors, duration, totalCount, batchSize, batchDelay)
	startLoop(selfInternal)
end

function ConfettiBurstPlayer:Reset()
	local selfInternal = self :: ConfettiBurstPlayerInternal
	if selfInternal._destroyed then
		return
	end

	selfInternal._emitter:Reset()
	if selfInternal._renderConnection then
		selfInternal._renderConnection:Disconnect()
		selfInternal._renderConnection = nil
	end
end

function ConfettiBurstPlayer:Destroy()
	local selfInternal = self :: ConfettiBurstPlayerInternal
	if selfInternal._destroyed then
		return
	end

	selfInternal._destroyed = true

	if selfInternal._renderConnection then
		selfInternal._renderConnection:Disconnect()
		selfInternal._renderConnection = nil
	end

	selfInternal._emitter:Destroy()

	if singleton == selfInternal then
		singleton = nil
	end
end

return ConfettiBurstPlayer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3538">
          <Properties>
            <string name="Name">ConfettiController</string>
            <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

export type ConfettiController = {
	PlayBurst: (
		self: ConfettiController,
		colors: { Color3 }?,
		duration: number?,
		totalCount: number?,
		batchSize: number?,
		batchDelay: number?
	) -> (),
	Stop: (self: ConfettiController) -> (),
	Reset: (self: ConfettiController) -> (),
	Destroy: (self: ConfettiController) -> (),
	Update: (self: ConfettiController, deltaTime: number) -> (),
	IsActive: (self: ConfettiController) -> boolean,
	SetColors: (self: ConfettiController, colors: { Color3 }) -> (),
}

type ConfettiParticle = {
	label: ImageLabel,
	defaultSize: Vector2,
	color: Color3,
	emitterPosition: Vector2,
	emitterPower: Vector2,
	position: Vector2,
	power: Vector2,
	heightScale: number,
	rotation: number,
	rotationSpeed: number,
	enabled: boolean,
	outOfBounds: boolean,
}

type ConfettiControllerInternal = ConfettiController & {
	_particles: { ConfettiParticle },
	_parent: GuiObject,
	_colors: { Color3 },
	_gravity: Vector2,
	_burstEndTime: number,
	_destroyed: boolean,
	_nextBatchTime: number,
	_remainingBurstCount: number,
	_batchSize: number,
	_batchDelay: number,
}

local ConfettiController = {}
ConfettiController.__index = ConfettiController

local camera = Workspace.CurrentCamera

local TEMPLATE_IMAGES = {
	"rbxassetid://2695001063",
	"rbxassetid://910256717",
}

local DEFAULT_COLORS = {
	Color3.fromRGB(168, 100, 253),
	Color3.fromRGB(41, 205, 255),
	Color3.fromRGB(120, 255, 68),
	Color3.fromRGB(255, 113, 141),
	Color3.fromRGB(253, 255, 106),
}

local DEFAULT_GRAVITY = Vector2.new(0, 400)
local DEFAULT_COUNT = 35
local DEFAULT_DURATION = 1.4
local DEFAULT_BATCH_DELAY = 0
local DEFAULT_SIZE = Vector2.new(30, 30)
local EMITTER_POSITION_Y = 0
local MIN_EMITTER_X = 0
local MAX_EMITTER_X = 1
local MIN_FORCE_X = -150
local MAX_FORCE_X = 150
local MIN_FORCE_Y = 200
local MAX_FORCE_Y = 500

local function getViewportSize(): Vector2
	local currentCamera = Workspace.CurrentCamera
	if currentCamera then
		camera = currentCamera
	end

	if camera then
		return camera.ViewportSize
	end

	return Vector2.new(1920, 1080)
end

local function copyColors(colors: { Color3 }?): { Color3 }
	if not colors or #colors == 0 then
		return table.clone(DEFAULT_COLORS)
	end

	return table.clone(colors)
end

local function randomForce(): Vector2
	return Vector2.new(math.random(MIN_FORCE_X, MAX_FORCE_X), math.random(MIN_FORCE_Y, MAX_FORCE_Y))
end

local function randomEmitterPosition(): Vector2
	return Vector2.new(MIN_EMITTER_X + math.random() * (MAX_EMITTER_X - MIN_EMITTER_X), EMITTER_POSITION_Y)
end

local function createParticleLabel(parent: GuiObject): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = "ConfettiParticle"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Image = TEMPLATE_IMAGES[math.random(1, #TEMPLATE_IMAGES)]
	label.Size = UDim2.fromOffset(DEFAULT_SIZE.X, DEFAULT_SIZE.Y)
	label.Visible = false
	label.ZIndex = 20
	label.Parent = parent
	return label
end

local function resetParticle(particle: ConfettiParticle, colors: { Color3 }, keepVisible: boolean)
	particle.color = colors[math.random(1, #colors)]
	particle.position = Vector2.zero
	particle.power = particle.emitterPower + Vector2.new(math.random(-50, 50), math.random(-60, 60))
	particle.heightScale = 1
	particle.rotation = math.random(0, 359)
	particle.rotationSpeed = math.random(-540, 540)
	particle.outOfBounds = not keepVisible
	particle.label.Visible = keepVisible
	particle.label.ImageColor3 = particle.color
	particle.label.Rotation = particle.rotation
	particle.label.Size = UDim2.fromOffset(particle.defaultSize.X, particle.defaultSize.Y)
end

local function createParticle(parent: GuiObject, colors: { Color3 }): ConfettiParticle
	local label = createParticleLabel(parent)
	local particle: ConfettiParticle = {
		label = label,
		defaultSize = DEFAULT_SIZE,
		color = colors[1],
		emitterPosition = randomEmitterPosition(),
		emitterPower = randomForce(),
		position = Vector2.zero,
		power = Vector2.zero,
		heightScale = 1,
		rotation = 0,
		rotationSpeed = 0,
		enabled = false,
		outOfBounds = true,
	}

	resetParticle(particle, colors, false)
	return particle
end

function ConfettiController.new(parent: GuiObject, count: number?): ConfettiController
	local colors = copyColors(nil)
	local self = setmetatable({
		_particles = {},
		_parent = parent,
		_colors = colors,
		_gravity = DEFAULT_GRAVITY,
		_burstEndTime = 0,
		_destroyed = false,
		_nextBatchTime = 0,
		_remainingBurstCount = 0,
		_batchSize = 0,
		_batchDelay = DEFAULT_BATCH_DELAY,
	}, ConfettiController) :: ConfettiControllerInternal

	for _ = 1, count or DEFAULT_COUNT do
		table.insert(self._particles, createParticle(parent, colors))
	end

	return self
end

function ConfettiController:_ensureParticleCount(targetCount: number)
	while #self._particles < targetCount do
		table.insert(self._particles, createParticle(self._parent, self._colors))
	end
end

function ConfettiController:_activateParticles(count: number)
	local activated = 0
	for _, particle in ipairs(self._particles) do
		if not particle.enabled then
			particle.enabled = true
			particle.emitterPosition = randomEmitterPosition()
			particle.emitterPower = randomForce()
			resetParticle(particle, self._colors, true)
			activated += 1
			if activated >= count then
				break
			end
		end
	end
end

function ConfettiController:SetColors(colors: { Color3 })
	self._colors = copyColors(colors)
end

function ConfettiController:PlayBurst(
	colors: { Color3 }?,
	duration: number?,
	totalCount: number?,
	batchSize: number?,
	batchDelay: number?
)
	self._colors = copyColors(colors)
	local finalTotalCount = math.max(1, math.floor(totalCount or #self._particles))
	local finalBatchSize = math.max(1, math.floor(batchSize or finalTotalCount))
	self:_ensureParticleCount(finalTotalCount)

	self._burstEndTime = os.clock() + (duration or DEFAULT_DURATION)
	self._remainingBurstCount = finalTotalCount
	self._batchSize = finalBatchSize
	self._batchDelay = math.max(0, batchDelay or DEFAULT_BATCH_DELAY)
	self._nextBatchTime = os.clock()
end

function ConfettiController:Stop()
	self._burstEndTime = 0
	self._nextBatchTime = 0
	self._remainingBurstCount = 0
	for _, particle in ipairs(self._particles) do
		particle.enabled = false
	end
end

function ConfettiController:Reset()
	self:Stop()
	for _, particle in ipairs(self._particles) do
		resetParticle(particle, self._colors, false)
	end
end

function ConfettiController:IsActive(): boolean
	if self._destroyed then
		return false
	end

	if self._burstEndTime > 0 or self._remainingBurstCount > 0 then
		return true
	end

	for _, particle in ipairs(self._particles) do
		if particle.enabled or not particle.outOfBounds or particle.label.Visible then
			return true
		end
	end

	return false
end

function ConfettiController:Update(deltaTime: number)
	if not self:IsActive() then
		return
	end

	local now = os.clock()
	if self._burstEndTime > 0 and now >= self._burstEndTime then
		self._burstEndTime = 0
		self._nextBatchTime = 0
		self._remainingBurstCount = 0
		for _, particle in ipairs(self._particles) do
			particle.enabled = false
		end
	end

	if self._remainingBurstCount > 0 and now >= self._nextBatchTime then
		local countToActivate = math.min(self._batchSize, self._remainingBurstCount)
		self:_activateParticles(countToActivate)
		self._remainingBurstCount -= countToActivate
		self._nextBatchTime = now + self._batchDelay
	end

	local viewportSize = getViewportSize()
	local gravityStep = self._gravity * deltaTime

	for _, particle in ipairs(self._particles) do
		if not particle.enabled and particle.outOfBounds then
			particle.label.Visible = false
			continue
		end

		particle.position += particle.power * deltaTime
		particle.power += gravityStep
		particle.rotation += particle.rotationSpeed * deltaTime

		local screenX = viewportSize.X * particle.emitterPosition.X + particle.position.X
		local screenY = viewportSize.Y * particle.emitterPosition.Y + particle.position.Y
		particle.label.Position = UDim2.fromOffset(screenX, screenY)
		particle.label.Rotation = particle.rotation

		if particle.power.Y < 0 then
			particle.heightScale = math.abs(math.cos(now * 10 + particle.rotation))
		else
			particle.heightScale = 1
		end

		local height = math.max(2, particle.defaultSize.Y * particle.heightScale)
		particle.label.Size = UDim2.fromOffset(particle.defaultSize.X, height)
		particle.label.ImageColor3 = if particle.heightScale < 0.35
			then particle.color:Lerp(Color3.new(0, 0, 0), 0.35)
			else particle.color
		particle.label.Visible = true

		local isOutOfBounds = screenX > viewportSize.X + particle.defaultSize.X
			or screenX < -particle.defaultSize.X
			or screenY > viewportSize.Y + particle.defaultSize.Y
			or screenY < -particle.defaultSize.Y

		if isOutOfBounds then
			particle.outOfBounds = true
			if particle.enabled and self._burstEndTime > 0 then
				particle.emitterPower = randomForce()
				resetParticle(particle, self._colors, true)
			else
				particle.label.Visible = false
			end
		else
			particle.outOfBounds = false
		end
	end
end

function ConfettiController:Destroy()
	if self._destroyed then
		return
	end

	self._destroyed = true
	self._burstEndTime = 0

	for _, particle in ipairs(self._particles) do
		particle.label:Destroy()
	end

	table.clear(self._particles)
end

return ConfettiController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3539">
          <Properties>
            <string name="Name">InviteFriendsTopbar</string>
            <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local StarterGui = game:GetService("StarterGui")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local FunnelAnalytics = require(Modules:WaitForChild("Shared"):WaitForChild("FunnelAnalytics_Client"))
local ClientDeviceProfile = require(Modules:WaitForChild("ClientDeviceProfile"))
local SharedFolder = Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Client"))

local TopbarFolder = ReplicatedStorage:WaitForChild("Topbar")
local Icon = require(TopbarFolder:WaitForChild("Icon"))

local InviteFriendsTopbar = {}

local MODULE_NAME = "InviteFriendsTopbar"
local localPlayer = Players.LocalPlayer
local socialConfig = CoreConfig.social
local iconImage = if socialConfig and typeof(socialConfig.friendInviteTopbarIconImage) == "string"
	then socialConfig.friendInviteTopbarIconImage
	else "rbxassetid://112009101194397"
local iconLabel = if socialConfig and typeof(socialConfig.friendInviteTopbarLabel) == "string"
	then socialConfig.friendInviteTopbarLabel
	else "Invite"
local promptMessage = if socialConfig and typeof(socialConfig.friendInvitePromptMessage) == "string"
	then socialConfig.friendInvitePromptMessage
	else "Invite friends to join and earn +0.10x multiplier per unique friend!"
local iconName = "InviteFriendsTopbar"

local started = false

local function showClientNotification(message: string)
	local success, err = pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Invite Friends",
			Text = message,
			Duration = 4,
		})
	end)

	if not success then
		DebugModule.debugWarn("Failed to show invite notification: " .. tostring(err), MODULE_NAME)
	end
end

local function canSendInvite(): boolean
	local success, canSend = pcall(function()
		return SocialService:CanSendGameInviteAsync(localPlayer)
	end)

	if not success then
		DebugModule.debugWarn("CanSendGameInviteAsync failed: " .. tostring(canSend), MODULE_NAME)
		return false
	end

	return canSend == true
end

local function promptInvite()
	if not canSendInvite() then
		showClientNotification("Invites are unavailable right now on this platform or account.")
		return
	end

	local inviteOptions = Instance.new("ExperienceInviteOptions")
	inviteOptions.PromptMessage = promptMessage

	local success, err = pcall(function()
		SocialService:PromptGameInvite(localPlayer, inviteOptions)
	end)

	if not success then
		DebugModule.debugWarn("PromptGameInvite failed: " .. tostring(err), MODULE_NAME)
		showClientNotification("Failed to open the invite prompt.")
		return
	end

	FunnelAnalytics.FireClientAction("FriendInvitePromptOpened", {
		source = "Topbar",
	})
end

function InviteFriendsTopbar.Start()
	if started then
		return
	end
	started = true

	local existingIcon = Icon.getIcon(iconName)
	if existingIcon then
		existingIcon:destroy()
	end

	Icon.setTopbarEnabled(true)

	local topbarLabel = if ClientDeviceProfile.IsMobile() then "" else iconLabel
	local inviteIcon = Icon.new():setName(iconName):setLeft():setImage(iconImage):setLabel(topbarLabel):oneClick()

	inviteIcon.selected:Connect(function()
		promptInvite()
	end)

	DebugModule.debugInfo("Invite friends topbar icon started", MODULE_NAME)
end

return InviteFriendsTopbar
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3540">
          <Properties>
            <string name="Name">MainFunctions</string>
            <string name="Source"><![CDATA[local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PlayerHandler = require(ReplicatedStorage.Modules.Shared:WaitForChild("PlayerHandler_Client"))
local VisualFunctions = require(ReplicatedStorage.Modules.UI.VisualFunctions)

local MainFunctions = {}
local FRAME_TOGGLE_DEBOUNCE = 0.15
local MOVEMENT_CHECK_INTERVAL = 0.1
local lastFrameToggleTimes: { [string]: number } = {}
local TROLL_HUD_HIDE_KEYS = {
	"LevelsBarFrame",
	"SpeedMultiFrame",
	"SpeedBuyFrame",
	"RightSideButtonsFrame",
}

local MOVEMENT_KEYS = {
	[Enum.KeyCode.W] = true,
	[Enum.KeyCode.A] = true,
	[Enum.KeyCode.S] = true,
	[Enum.KeyCode.D] = true,
	[Enum.KeyCode.Up] = true,
	[Enum.KeyCode.Down] = true,
	[Enum.KeyCode.Left] = true,
	[Enum.KeyCode.Right] = true,
}

local function setTrollHudVisibility(isVisible: boolean)
	local hud = VisualFunctions.HUD
	for _, hudKey in ipairs(TROLL_HUD_HIDE_KEYS) do
		local guiObject = (hud :: any)[hudKey]
		if guiObject and guiObject:IsA("GuiObject") then
			if isVisible then
				guiObject:SetAttribute("TrollPrevVisible", guiObject.Visible)
				guiObject.Visible = false
			else
				local previousVisible = guiObject:GetAttribute("TrollPrevVisible")
				if typeof(previousVisible) == "boolean" then
					guiObject.Visible = previousVisible
				else
					guiObject.Visible = true
				end
				guiObject:SetAttribute("TrollPrevVisible", nil)
			end
		end
	end
end

function MainFunctions.SetFrameVisibleSimple(frameName: string, isVisible: boolean)
	local targetFrame = VisualFunctions.ActiveFrameGroup[frameName]
	if not targetFrame then
		return
	end

	targetFrame.Visible = isVisible
	targetFrame.Interactable = isVisible

	if frameName == "TrollFrame" then
		setTrollHudVisibility(isVisible)
	end
end

--[[
	Closes all managed frames except the one provided.
]]
function MainFunctions.CloseOtherFrames(except: Frame?)
	local frames = VisualFunctions.ActiveFrameGroup
	if not frames then
		return
	end

	local closeTasks = {}
	for _, frame in pairs(frames) do
		if frame and frame ~= except and frame.Visible then
			if frame.Name == "TrollFrame" then
				MainFunctions.SetFrameVisibleSimple("TrollFrame", false)
			else
				table.insert(closeTasks, VisualFunctions.CloseWindow(frame))
			end
		end
	end

	-- Wait for all close animations to finish (Yielding)
	if #closeTasks > 0 then
		for _, task in ipairs(closeTasks) do
			if typeof(task) == "RBXScriptSignal" then
				task:Wait()
			end
		end
	end
end

--[[
	Toggles a specific managed frame.
]]
function MainFunctions.ToggleFrame(frameName: string)
	local targetFrame = VisualFunctions.ActiveFrameGroup[frameName]
	if not targetFrame then
		return
	end

	local now = tick()
	local lastToggleTime = lastFrameToggleTimes[frameName] or 0
	if now - lastToggleTime < FRAME_TOGGLE_DEBOUNCE then
		return
	end
	lastFrameToggleTimes[frameName] = now

	if frameName == "TrollFrame" then
		if targetFrame.Visible then
			MainFunctions.SetFrameVisibleSimple("TrollFrame", false)
		else
			task.spawn(function()
				MainFunctions.CloseOtherFrames(targetFrame)
				MainFunctions.SetFrameVisibleSimple("TrollFrame", true)
			end)
		end
		return
	end

	if targetFrame.Visible then
		VisualFunctions.CloseWindow(targetFrame)
	else
		task.spawn(function()
			MainFunctions.CloseOtherFrames(targetFrame)
			VisualFunctions.OpenWindow(targetFrame)
		end)
	end
end

--[[
	Starts the movement gain detection.
	Fires a RemoteEvent to the server when movement keys are held.
]]
function MainFunctions.StartMovementDetection(humanoid: Humanoid): () -> ()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		return function() end
	end

	local MovementAction = remotes:FindFirstChild("MovementAction") :: RemoteEvent
	if not MovementAction then
		return function() end
	end

	local player = Players.LocalPlayer
	local stopped = false
	local lastMovementSignal = 0
	local lastMovementCheck = 0
	local movementConnection = RunService.Heartbeat:Connect(function()
		local now = tick()
		if stopped then
			return
		end
		if player:GetAttribute("SpinWheelModalOpen") == true then
			return
		end

		if now - lastMovementCheck < MOVEMENT_CHECK_INTERVAL then
			return
		end
		lastMovementCheck = now

		local interval = PlayerHandler.GetMovementInterval(player)
		if not interval then
			interval = 0.25
		end

		if now - lastMovementSignal < interval then
			return
		end

		if not humanoid or humanoid.Parent == nil or humanoid.Health <= 0 then
			return
		end

		local isMoving = humanoid.MoveDirection.Magnitude > 0.05
		for key in pairs(MOVEMENT_KEYS) do
			if UserInputService:IsKeyDown(key) then
				isMoving = true
				break
			end
		end

		if isMoving then
			lastMovementSignal = now
			MovementAction:FireServer()
		end
	end)

	local function stopMovement()
		if stopped then
			return
		end

		stopped = true
		movementConnection:Disconnect()
	end

	return stopMovement
end

--[[
	Stops the movement gain detection.
]]
function MainFunctions.StopMovementDetection(movementStopper: (() -> ())?)
	if movementStopper then
		movementStopper()
	end
end

return MainFunctions
]]></string>
          </Properties>
        </Item>
