    <Item class="Folder" referent="3739">
      <Properties>
        <string name="Name">Modules</string>
      </Properties>
      <Item class="ModuleScript" referent="3740">
        <Properties>
          <string name="Name">BadgeAwardService</string>
          <string name="Source"><![CDATA[local BadgeService = game:GetService("BadgeService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoreConfig = require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("CoreConfig_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))

local BadgeAwardService = {}
BadgeAwardService.__index = BadgeAwardService

local MODULE_NAME = "BadgeAwardService"
local badgeConfig: any = if typeof(CoreConfig.badges) == "table" then CoreConfig.badges else {}
local BADGE_EXPERIENCE_ID = if typeof(badgeConfig.experienceId) == "number"
	then math.floor(badgeConfig.experienceId)
	else 0
local SKIP_IN_STUDIO = badgeConfig.skipInStudio ~= false
local SUCCESS_REFRESH_SECONDS = math.max(60, math.floor(tonumber(badgeConfig.successRefreshSeconds) or 300))
local INITIAL_RETRY_SECONDS = math.max(5, math.floor(tonumber(badgeConfig.initialRetrySeconds) or 30))
local MAX_RETRY_SECONDS = math.max(INITIAL_RETRY_SECONDS, math.floor(tonumber(badgeConfig.maxRetrySeconds) or 600))
local MAX_BADGE_CHECK_COUNT = 10

type BadgeRequest = {
	badgeId: number,
	label: string,
}

type BadgeInfoCacheEntry = {
	isEnabled: boolean,
}

type PlayerState = {
	inFlight: boolean,
	pendingRequests: { BadgeRequest }?,
	knownEligible: { [number]: boolean },
	nextAttemptAt: number,
	retrySeconds: number,
	retryThread: thread?,
	requestThread: thread?,
	alive: boolean,
}

type Service = {
	playerStates: { [Player]: PlayerState },
	badgeInfoCache: { [number]: BadgeInfoCacheEntry },
	loggedSkipReasons: { [string]: boolean },
	alive: boolean,
}

local function copyRequests(requests: { BadgeRequest }): { BadgeRequest }
	local copied = {}
	for _, request in ipairs(requests) do
		table.insert(copied, {
			badgeId = request.badgeId,
			label = request.label,
		})
	end
	return copied
end

local function cancelThread(thread: thread?)
	if thread and coroutine.status(thread) ~= "dead" then
		pcall(task.cancel, thread)
	end
end

local function getOwnedBadgeId(value: any): number?
	if typeof(value) == "number" and value > 0 then
		return math.floor(value)
	end
	if typeof(value) == "table" then
		local badgeId = value.BadgeId
		if typeof(badgeId) ~= "number" then
			badgeId = value.Id
		end
		if typeof(badgeId) ~= "number" then
			badgeId = value.id
		end
		if typeof(badgeId) == "number" and badgeId > 0 then
			return math.floor(badgeId)
		end
	end
	return nil
end

local function checkOwnedBadges(userId: number, badgeIds: { number }): (boolean, { [number]: boolean }, any)
	local ownedBadges: { [number]: boolean } = {}
	for startIndex = 1, #badgeIds, MAX_BADGE_CHECK_COUNT do
		local endIndex = math.min(startIndex + MAX_BADGE_CHECK_COUNT - 1, #badgeIds)
		local batch = {}
		for index = startIndex, endIndex do
			table.insert(batch, badgeIds[index])
		end

		local success, result = pcall(function()
			return BadgeService:CheckUserBadgesAsync(userId, batch)
		end)
		if not success or typeof(result) ~= "table" then
			return false, ownedBadges, result
		end

		for _, value in ipairs(result) do
			local badgeId = getOwnedBadgeId(value)
			if badgeId then
				ownedBadges[badgeId] = true
			end
		end
	end

	return true, ownedBadges, nil
end

function BadgeAwardService.new(): Service
	return setmetatable({
		playerStates = {},
		badgeInfoCache = {},
		loggedSkipReasons = {},
		alive = true,
	}, BadgeAwardService) :: Service
end

function BadgeAwardService:_logSkipOnce(reason: string, message: string)
	if self.loggedSkipReasons[reason] then
		return
	end
	self.loggedSkipReasons[reason] = true
	DebugModule.debugInfo(message, MODULE_NAME)
end

function BadgeAwardService:_canUseService(): boolean
	if not self.alive then
		return false
	end

	if SKIP_IN_STUDIO and RunService:IsStudio() then
		self:_logSkipOnce(
			"studio",
			"Badge API calls skipped in Studio; persistent badge awards require a published server"
		)
		return false
	end

	if BADGE_EXPERIENCE_ID <= 0 then
		self:_logSkipOnce(
			"missingExperience",
			"Badge API calls skipped because badge owning experience is not configured"
		)
		return false
	end

	if game.GameId ~= BADGE_EXPERIENCE_ID then
		self:_logSkipOnce(
			"wrongExperience",
			string.format(
				"Badge API calls skipped outside owning experience | currentUniverse=%d | badgeUniverse=%d",
				game.GameId,
				BADGE_EXPERIENCE_ID
			)
		)
		return false
	end

	return true
end

function BadgeAwardService:_getPlayerState(player: Player): PlayerState
	local existing = self.playerStates[player]
	if existing then
		return existing
	end

	local state: PlayerState = {
		inFlight = false,
		pendingRequests = nil,
		knownEligible = {},
		nextAttemptAt = 0,
		retrySeconds = INITIAL_RETRY_SECONDS,
		retryThread = nil,
		requestThread = nil,
		alive = true,
	}
	self.playerStates[player] = state
	return state
end

function BadgeAwardService:_hasNewRequest(state: PlayerState, requests: { BadgeRequest }): boolean
	for _, request in ipairs(requests) do
		if not state.knownEligible[request.badgeId] then
			return true
		end
	end
	return false
end

function BadgeAwardService:_scheduleRetry(
	player: Player,
	state: PlayerState,
	requests: { BadgeRequest },
	reason: string
)
	if not state.alive or not player.Parent then
		return
	end

	local retryAfter = state.retrySeconds
	state.retrySeconds = math.min(state.retrySeconds * 2, MAX_RETRY_SECONDS)
	state.nextAttemptAt = os.clock() + retryAfter
	DebugModule.debugWarn(
		string.format(
			"Badge sync retry scheduled | player=%s | afterSeconds=%d | reason=%s",
			player.Name,
			retryAfter,
			reason
		),
		MODULE_NAME
	)

	cancelThread(state.retryThread)
	state.retryThread = task.delay(retryAfter, function()
		state.retryThread = nil
		if not self.alive or not state.alive or not player.Parent then
			return
		end
		self:SyncPlayer(player, state.pendingRequests or requests)
	end)
end

function BadgeAwardService:_getBadgeInfo(badgeId: number): BadgeInfoCacheEntry?
	local cached = self.badgeInfoCache[badgeId]
	if cached then
		return cached
	end

	local success, result = pcall(function()
		return BadgeService:GetBadgeInfoAsync(badgeId)
	end)
	if not success or typeof(result) ~= "table" or typeof(result.IsEnabled) ~= "boolean" then
		return nil
	end

	local entry = { isEnabled = result.IsEnabled }
	self.badgeInfoCache[badgeId] = entry
	return entry
end

function BadgeAwardService:_runSync(player: Player, state: PlayerState, requests: { BadgeRequest })
	if not self.alive or not state.alive or not player.Parent then
		state.inFlight = false
		return
	end

	local badgeIds = {}
	for _, request in ipairs(requests) do
		table.insert(badgeIds, request.badgeId)
		state.knownEligible[request.badgeId] = true
	end

	local checkSuccess, ownedBadges, checkError = checkOwnedBadges(player.UserId, badgeIds)
	if not checkSuccess then
		state.inFlight = false
		state.requestThread = nil
		self:_scheduleRetry(player, state, requests, "CheckUserBadgesAsync: " .. tostring(checkError))
		return
	end

	local hasTransientFailure = false
	for _, request in ipairs(requests) do
		if not ownedBadges[request.badgeId] then
			local badgeInfo = self:_getBadgeInfo(request.badgeId)
			if not badgeInfo then
				hasTransientFailure = true
				DebugModule.debugWarn(
					string.format("%s badge metadata lookup failed for %s", request.label, player.Name),
					MODULE_NAME
				)
			elseif not badgeInfo.isEnabled then
				DebugModule.debugWarn(
					string.format("%s badge is disabled and cannot be awarded", request.label),
					MODULE_NAME
				)
			else
				local awardCallSuccess, awardedOrError = pcall(function()
					return BadgeService:AwardBadgeAsync(player.UserId, request.badgeId)
				end)
				if not awardCallSuccess or awardedOrError ~= true then
					hasTransientFailure = true
					DebugModule.debugWarn(
						string.format(
							"%s badge award failed for %s: %s",
							request.label,
							player.Name,
							tostring(awardedOrError)
						),
						MODULE_NAME
					)
				else
					ownedBadges[request.badgeId] = true
				end
			end
		end
	end

	state.inFlight = false
	state.requestThread = nil
	if hasTransientFailure then
		self:_scheduleRetry(player, state, requests, "badge metadata or award failure")
		return
	end

	state.retrySeconds = INITIAL_RETRY_SECONDS
	state.nextAttemptAt = os.clock() + SUCCESS_REFRESH_SECONDS
	if state.pendingRequests and self:_hasNewRequest(state, state.pendingRequests) then
		local pending = state.pendingRequests
		state.pendingRequests = nil
		self:SyncPlayer(player, pending)
	end
end

function BadgeAwardService:SyncPlayer(player: Player, requests: { BadgeRequest })
	if not self:_canUseService() or not player.Parent or #requests == 0 then
		return
	end

	local state = self:_getPlayerState(player)
	if not state.alive then
		return
	end

	local copiedRequests = copyRequests(requests)
	state.pendingRequests = copiedRequests
	if state.inFlight then
		return
	end

	if os.clock() < state.nextAttemptAt and not self:_hasNewRequest(state, copiedRequests) then
		return
	end

	state.pendingRequests = nil
	state.inFlight = true
	state.requestThread = task.spawn(function()
		local success, errorMessage = xpcall(function()
			self:_runSync(player, state, copiedRequests)
		end, debug.traceback)
		if not success and self.alive and state.alive and player.Parent then
			state.inFlight = false
			state.requestThread = nil
			self:_scheduleRetry(
				player,
				state,
				copiedRequests,
				"unexpected badge sync error: " .. tostring(errorMessage)
			)
		end
	end)
end

function BadgeAwardService:CleanupPlayer(player: Player)
	local state = self.playerStates[player]
	if not state then
		return
	end

	state.alive = false
	state.pendingRequests = nil
	cancelThread(state.retryThread)
	cancelThread(state.requestThread)
	state.retryThread = nil
	state.requestThread = nil
	self.playerStates[player] = nil
end

function BadgeAwardService:Shutdown()
	if not self.alive then
		return
	end

	self.alive = false
	local players = {}
	for player in pairs(self.playerStates) do
		table.insert(players, player)
	end
	for _, player in ipairs(players) do
		self:CleanupPlayer(player)
	end
	table.clear(self.badgeInfoCache)
	table.clear(self.loggedSkipReasons)
end

return BadgeAwardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3741">
        <Properties>
          <string name="Name">CompensationService</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CoreConfig = require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("CoreConfig_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local ProductServerService = require(script.Parent:WaitForChild("ProductServerService"))
local TemporaryBoostService = require(script.Parent:WaitForChild("TemporaryBoostService"))

local CompensationService = {}

local MODULE_NAME = "CompensationService"
local CLAIMS_ATTRIBUTE = "CompensationClaimedCampaigns"
local SPEED_END_ATTRIBUTE = "TemporarySpeedBoostEndUnix"
local WIN_END_ATTRIBUTE = "TemporaryWinBoostEndUnix"

type CompensationDefinition = {
	enabled: boolean?,
	campaignId: string?,
	startUnix: number?,
	endUnix: number?,
	speedBoostSeconds: number?,
	winBoostSeconds: number?,
}

local claimedThisSession: { [Player]: boolean } = {}

local function getDefinition(): CompensationDefinition
	local configured = CoreConfig.compensation
	return if typeof(configured) == "table" then configured :: CompensationDefinition else {}
end

local function hasClaimedCampaign(claimedCampaigns: any, campaignId: string): boolean
	if typeof(claimedCampaigns) ~= "string" or claimedCampaigns == "" then
		return false
	end

	for storedCampaignId in string.gmatch(claimedCampaigns, "[^|]+") do
		if storedCampaignId == campaignId then
			return true
		end
	end

	return false
end

local function appendCampaign(claimedCampaigns: any, campaignId: string): string
	if typeof(claimedCampaigns) ~= "string" or claimedCampaigns == "" then
		return campaignId
	end
	return claimedCampaigns .. "|" .. campaignId
end

local function getPositiveDuration(value: number?, fallback: number): number
	return if typeof(value) == "number" and value > 0 then math.floor(value) else fallback
end

function CompensationService.Init()
	local definition = getDefinition()
	if definition.enabled ~= true then
		DebugModule.debugInfo("Compensation campaign disabled", MODULE_NAME)
		return
	end

	DebugModule.debugInfo(
		string.format(
			"Compensation campaign ready | id=%s | startUnix=%s | endUnix=%s | speedSeconds=%d | winSeconds=%d",
			tostring(definition.campaignId),
			tostring(definition.startUnix),
			tostring(definition.endUnix),
			getPositiveDuration(definition.speedBoostSeconds, 30 * 60),
			getPositiveDuration(definition.winBoostSeconds, 30 * 60)
		),
		MODULE_NAME
	)
end

function CompensationService.TryGrant(player: Player): boolean
	if player:GetAttribute("Data_Loaded") ~= true or claimedThisSession[player] then
		return false
	end

	local definition = getDefinition()
	local campaignId = definition.campaignId
	local startUnix = definition.startUnix
	local endUnix = definition.endUnix
	local nowUnix = os.time()
	if
		definition.enabled ~= true
		or typeof(campaignId) ~= "string"
		or campaignId == ""
		or typeof(startUnix) ~= "number"
		or typeof(endUnix) ~= "number"
		or nowUnix < startUnix
		or nowUnix >= endUnix
	then
		return false
	end

	local previousClaims = player:GetAttribute(CLAIMS_ATTRIBUTE)
	if hasClaimedCampaign(previousClaims, campaignId) then
		return false
	end

	claimedThisSession[player] = true
	local previousSpeedEnd = player:GetAttribute(SPEED_END_ATTRIBUTE)
	local previousWinEnd = player:GetAttribute(WIN_END_ATTRIBUTE)
	local updatedClaims = appendCampaign(previousClaims, campaignId)
	player:SetAttribute(CLAIMS_ATTRIBUTE, updatedClaims)
	TemporaryBoostService.GrantSpeedBoost(player, getPositiveDuration(definition.speedBoostSeconds, 30 * 60))
	TemporaryBoostService.GrantWinBoost(player, getPositiveDuration(definition.winBoostSeconds, 30 * 60))

	if not ProductServerService.SavePlayerData(player, true) then
		player:SetAttribute(CLAIMS_ATTRIBUTE, previousClaims)
		player:SetAttribute(SPEED_END_ATTRIBUTE, previousSpeedEnd)
		player:SetAttribute(WIN_END_ATTRIBUTE, previousWinEnd)
		claimedThisSession[player] = nil
		DebugModule.debugWarn(
			"Compensation claim rolled back because save failed | player="
				.. player.Name
				.. " | campaign="
				.. campaignId,
			MODULE_NAME
		)
		return false
	end

	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	local showNotification = remotes and remotes:FindFirstChild("ShowNotification")
	if showNotification and showNotification:IsA("RemoteEvent") and player.Parent then
		showNotification:FireClient(player, "COMPENSATION CLAIMED! +30 MIN 2X SPEED AND 2X WINS!", "Green")
	end

	DebugModule.debugInfo("Compensation claimed | player=" .. player.Name .. " | campaign=" .. campaignId, MODULE_NAME)
	return true
end

function CompensationService.CleanupPlayer(player: Player)
	claimedThisSession[player] = nil
end

return CompensationService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3742">
        <Properties>
          <string name="Name">Config</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3743">
        <Properties>
          <string name="Name">CreatorPurchaseService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local GroupService = game:GetService("GroupService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Maid = require(Modules:WaitForChild("Maid"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local ProductService = require(script.Parent.Shared:WaitForChild("ProductService_Server"))
local ProductServerService = require(script.Parent:WaitForChild("ProductServerService"))
local ReturnToStageService = require(script.Parent:WaitForChild("ReturnToStageService"))

local CreatorPurchaseService = {}

local MODULE_NAME = "CreatorPurchaseService"
local REQUEST_COOLDOWN_SECONDS = 0.75
local CREATOR_READY_ATTRIBUTE = "CreatorPurchaseServiceReady"
local CREATOR_USER_ID_ATTRIBUTE = "CreatorPurchaseUserId"
local CREATOR_IDENTITY_READY_ATTRIBUTE = "CreatorPurchaseIdentityReady"

type PurchaseKind = "Product"
type GrantCallback = () -> (boolean, string)

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local CreatorPurchaseRequest = Remotes:WaitForChild("CreatorPurchaseRequest") :: RemoteEvent
local CreatorPurchaseResult = Remotes:WaitForChild("CreatorPurchaseResult") :: RemoteEvent

local serviceMaid = Maid.new()
local requestTimes: { [Player]: number } = {}
local requestInFlight: { [Player]: boolean } = {}
local creatorUserId: number? = nil
local initialized = false

local function isExperienceCreator(player: Player): boolean
	return creatorUserId ~= nil and player.UserId == creatorUserId
end

local function resolveCreatorUserId(): number?
	if game.CreatorType == Enum.CreatorType.User then
		return game.CreatorId > 0 and game.CreatorId or nil
	end
	if game.CreatorType ~= Enum.CreatorType.Group or game.CreatorId <= 0 then
		return nil
	end

	local success, groupInfo = pcall(function()
		return GroupService:GetGroupInfoAsync(game.CreatorId)
	end)
	if not success or typeof(groupInfo) ~= "table" or typeof(groupInfo.Owner) ~= "table" then
		DebugModule.debugWarn(
			"Could not resolve group owner for creator purchases | groupId=" .. tostring(game.CreatorId),
			MODULE_NAME
		)
		return nil
	end

	local ownerId = groupInfo.Owner.Id
	return typeof(ownerId) == "number" and ownerId > 0 and ownerId or nil
end

local function findProductKey(products: { [string]: any }, productId: number): string?
	for productKey, rawProductId in pairs(products) do
		if typeof(rawProductId) == "number" and rawProductId == productId then
			return productKey
		end
	end

	return nil
end

local function isLiveEventActive(eventName: string): boolean
	local stateFolder = ReplicatedStorage:FindFirstChild("LiveEventState")
	if not stateFolder or not stateFolder:IsA("Folder") then
		return false
	end

	local activeEventIds = stateFolder:GetAttribute("ActiveEventIds")
	return typeof(activeEventIds) == "string"
		and string.find("," .. activeEventIds .. ",", "," .. eventName .. ",", 1, true) ~= nil
end

local function isEventProductAvailable(productKey: string): boolean
	local eventKartProducts = ProductService.EventKartProducts
	if typeof(eventKartProducts) == "table" then
		for eventName, eventProducts in pairs(eventKartProducts) do
			if typeof(eventProducts) == "table" and eventProducts[productKey] ~= nil then
				return isLiveEventActive(tostring(eventName))
			end
		end
	end

	return true
end

local function sendResult(player: Player, purchaseKind: string, productId: number, success: boolean, reason: string)
	if player.Parent then
		CreatorPurchaseResult:FireClient(player, purchaseKind, productId, success, reason)
	end
end

local function completeGrant(
	player: Player,
	purchaseKind: PurchaseKind,
	productId: number,
	productKey: string,
	grantCallback: GrantCallback
)
	requestInFlight[player] = true
	local callOk, granted, reason = pcall(grantCallback)
	requestInFlight[player] = nil

	if not callOk then
		local callError = granted
		granted = false
		reason = "GrantError"
		DebugModule.debugWarn(
			string.format(
				"Creator purchase grant errored | player=%s | kind=%s | productId=%d | error=%s",
				player.Name,
				purchaseKind,
				productId,
				tostring(callError)
			),
			MODULE_NAME
		)
	end

	local success = granted == true
	local resultReason = if typeof(reason) == "string" then reason else if success then "Granted" else "GrantFailed"
	sendResult(player, purchaseKind, productId, success, resultReason)
	DebugModule.debugInfo(
		string.format(
			"Creator purchase request completed | player=%s | kind=%s | product=%s | success=%s | reason=%s",
			player.Name,
			purchaseKind,
			productKey,
			tostring(success),
			resultReason
		),
		MODULE_NAME
	)
end

local function onPurchaseRequest(player: Player, rawPurchaseKind: unknown, rawProductId: unknown)
	if
		typeof(rawPurchaseKind) ~= "string"
		or rawPurchaseKind ~= "Product"
		or typeof(rawProductId) ~= "number"
		or rawProductId <= 0
		or rawProductId ~= math.floor(rawProductId)
	then
		DebugModule.debugWarn("Rejected malformed creator purchase request", MODULE_NAME)
		return
	end

	local purchaseKind = rawPurchaseKind :: PurchaseKind
	local productId = math.floor(rawProductId)
	DebugModule.debugInfo(
		string.format("Creator purchase request received | player=%s | productId=%d", player.Name, productId),
		MODULE_NAME
	)
	if not isExperienceCreator(player) then
		sendResult(player, purchaseKind, productId, false, "NotCreator")
		return
	end

	if Remotes:GetAttribute(CREATOR_READY_ATTRIBUTE) ~= true then
		sendResult(player, purchaseKind, productId, false, "ServiceUnavailable")
		return
	end

	local now = os.clock()
	local lastRequestAt = requestTimes[player] or 0
	if now - lastRequestAt < REQUEST_COOLDOWN_SECONDS then
		sendResult(player, purchaseKind, productId, false, "RateLimited")
		return
	end
	requestTimes[player] = now

	if requestInFlight[player] then
		sendResult(player, purchaseKind, productId, false, "RequestInFlight")
		return
	end

	local productKey = findProductKey(ProductService.DevProducts, productId)
	if not productKey then
		DebugModule.debugWarn(
			string.format("Rejected unknown creator purchase | kind=%s | productId=%d", purchaseKind, productId),
			MODULE_NAME
		)
		sendResult(player, purchaseKind, productId, false, "UnknownProduct")
		return
	end

	-- ReturnToStage keeps its strict offer validation and uses a dedicated grant path.
	if productKey == "ReturnToStage" then
		completeGrant(player, purchaseKind, productId, productKey, function()
			return ReturnToStageService.HandleCreatorPurchase(player, productId)
		end)
		return
	end

	if not isEventProductAvailable(productKey) then
		sendResult(player, purchaseKind, productId, false, "EventInactive")
		return
	end

	completeGrant(player, purchaseKind, productId, productKey, function()
		return ProductServerService.GrantCreatorDeveloperProduct(player, productId)
	end)
end

function CreatorPurchaseService.IsExperienceCreator(player: Player): boolean
	return isExperienceCreator(player)
end

function CreatorPurchaseService.CleanupPlayer(player: Player)
	requestTimes[player] = nil
	requestInFlight[player] = nil
end

function CreatorPurchaseService.Init()
	if initialized then
		return
	end
	initialized = true
	creatorUserId = resolveCreatorUserId()
	ProductServerService.SetCreatorUserId(creatorUserId)
	Remotes:SetAttribute(CREATOR_USER_ID_ATTRIBUTE, creatorUserId)
	Remotes:SetAttribute(CREATOR_IDENTITY_READY_ATTRIBUTE, true)
	Remotes:SetAttribute(CREATOR_READY_ATTRIBUTE, creatorUserId ~= nil)
	serviceMaid.CreatorPurchaseRequest = CreatorPurchaseRequest.OnServerEvent:Connect(onPurchaseRequest)
	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(CreatorPurchaseService.CleanupPlayer)
	DebugModule.debugInfo(
		"Creator free purchase service initialized | creatorType="
			.. tostring(game.CreatorType)
			.. " | creatorUserId="
			.. tostring(creatorUserId)
			.. " | ready="
			.. tostring(creatorUserId ~= nil),
		MODULE_NAME
	)
end

function CreatorPurchaseService.Shutdown()
	if not initialized then
		return
	end

	Remotes:SetAttribute(CREATOR_READY_ATTRIBUTE, false)
	Remotes:SetAttribute(CREATOR_USER_ID_ATTRIBUTE, nil)
	Remotes:SetAttribute(CREATOR_IDENTITY_READY_ATTRIBUTE, false)
	serviceMaid:DoCleaning()
	for player in pairs(table.clone(requestTimes)) do
		CreatorPurchaseService.CleanupPlayer(player)
	end
	creatorUserId = nil
	ProductServerService.SetCreatorUserId(nil)
	initialized = false
	DebugModule.debugInfo("Creator free purchase service shutdown", MODULE_NAME)
end

return CreatorPurchaseService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3744">
        <Properties>
          <string name="Name">DailyRewardsService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local SharedFolder = Modules:WaitForChild("Shared")
local ServerSharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local FunnelAnalytics =
	require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("FunnelAnalytics_Server"))
local Maid = require(Modules:WaitForChild("Maid"))
local DailyRewardsConfig = require(SharedFolder:WaitForChild("DailyRewardsConfig"))
local CoreConfig = require(ServerSharedFolder:WaitForChild("CoreConfig_Server"))

local LevelingService = require(script.Parent:WaitForChild("LevelingService"))
local EconomyAnalytics = require(script.Parent:WaitForChild("EconomyAnalytics"))

local DailyRewardsService = {}

local MODULE_NAME = "DailyRewardsService"
local REQUEST_COOLDOWN_SECONDS = 0.15
local CURRENT_DAY_ATTRIBUTE = DailyRewardsConfig.CURRENT_DAY_ATTRIBUTE
local NEXT_CLAIM_ATTRIBUTE = DailyRewardsConfig.NEXT_CLAIM_ATTRIBUTE
local CYCLE_COUNT_ATTRIBUTE = DailyRewardsConfig.CYCLE_COUNT_ATTRIBUTE
local LAST_CLAIM_DAY_KEY_ATTRIBUTE = "DailyRewardLastClaimDayKey"
local TIMEZONE_OFFSET_ATTRIBUTE = "DailyRewardTimezoneOffsetMinutes"
local TIMEZONE_INITIALIZED_ATTRIBUTE = "DailyRewardTimezoneInitialized"
local DAY_COUNT = DailyRewardsConfig.DAY_COUNT
local dailyRewardsConfig = if CoreConfig.server and CoreConfig.server.dailyRewards
	then CoreConfig.server.dailyRewards
	else nil
local DEBUG_SEQUENTIAL_CLAIM_MODE = RunService:IsStudio()
	and dailyRewardsConfig
	and typeof(dailyRewardsConfig.debugSequentialClaimMode) == "boolean"
	and dailyRewardsConfig.debugSequentialClaimMode == true
local analyticsConfig = if CoreConfig.analytics then CoreConfig.analytics else nil
local analyticsFunnels = if analyticsConfig and typeof(analyticsConfig.funnels) == "table"
	then analyticsConfig.funnels
	else nil
local DAILY_REWARD_FUNNEL_NAME = if analyticsFunnels and typeof(analyticsFunnels.dailyReward) == "string"
	then analyticsFunnels.dailyReward
	else "DailyRewardClaim"
local DAILY_REWARD_CLAIM_ALL_FUNNEL_NAME = if analyticsFunnels
		and typeof(analyticsFunnels.dailyRewardClaimAll) == "string"
	then analyticsFunnels.dailyRewardClaimAll
	else "DailyRewardClaimAll"

type DailyRewardDefinition = DailyRewardsConfig.DailyRewardDefinition

local isInitialized = false
local serviceMaid = Maid.new()
local requestInFlight: { [Player]: boolean } = {}
local lastRequestAt: { [Player]: number } = {}
local claimAllFunnelSessions: { [Player]: string } = {}

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local dailyRewardAction = Remotes:FindFirstChild("DailyRewardAction") :: RemoteEvent?
if not dailyRewardAction then
	local createdRemote = Instance.new("RemoteEvent")
	createdRemote.Name = "DailyRewardAction"
	createdRemote.Parent = Remotes
	dailyRewardAction = createdRemote
end
local dailyRewardTimeSync = Remotes:FindFirstChild("DailyRewardTimeSync") :: RemoteEvent?
if not dailyRewardTimeSync then
	local createdRemote = Instance.new("RemoteEvent")
	createdRemote.Name = "DailyRewardTimeSync"
	createdRemote.Parent = Remotes
	dailyRewardTimeSync = createdRemote
end

local XPGainAwarded = Remotes:WaitForChild("XPGainAwarded") :: RemoteEvent
local WinButtonPressed = Remotes:WaitForChild("WinButtonPressed") :: RemoteEvent
local ShowNotification = Remotes:WaitForChild("ShowNotification") :: RemoteEvent

local function sanitizeCurrentDay(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 1
	end

	return math.clamp(math.floor(rawValue), 1, DAY_COUNT)
end

local function sanitizeNextClaimUnix(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 0
	end

	return math.max(0, math.floor(rawValue))
end

local function sanitizeCycleCount(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 0
	end

	return math.max(0, math.floor(rawValue))
end

local function sanitizeDayKey(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 0
	end

	return math.max(0, math.floor(rawValue))
end

local function sanitizeTimezoneOffsetMinutes(rawValue: any): number
	if typeof(rawValue) ~= "number" or rawValue ~= rawValue or rawValue == math.huge or rawValue == -math.huge then
		return 0
	end

	return math.clamp(
		math.round(rawValue),
		DailyRewardsConfig.MIN_TIMEZONE_OFFSET_MINUTES,
		DailyRewardsConfig.MAX_TIMEZONE_OFFSET_MINUTES
	)
end

local function ensurePlayerState(player: Player)
	player:SetAttribute(CURRENT_DAY_ATTRIBUTE, sanitizeCurrentDay(player:GetAttribute(CURRENT_DAY_ATTRIBUTE)))
	player:SetAttribute(NEXT_CLAIM_ATTRIBUTE, sanitizeNextClaimUnix(player:GetAttribute(NEXT_CLAIM_ATTRIBUTE)))
	player:SetAttribute(CYCLE_COUNT_ATTRIBUTE, sanitizeCycleCount(player:GetAttribute(CYCLE_COUNT_ATTRIBUTE)))
	player:SetAttribute(LAST_CLAIM_DAY_KEY_ATTRIBUTE, sanitizeDayKey(player:GetAttribute(LAST_CLAIM_DAY_KEY_ATTRIBUTE)))
	player:SetAttribute(TIMEZONE_OFFSET_ATTRIBUTE, sanitizeTimezoneOffsetMinutes(player:GetAttribute(TIMEZONE_OFFSET_ATTRIBUTE)))
	player:SetAttribute(TIMEZONE_INITIALIZED_ATTRIBUTE, player:GetAttribute(TIMEZONE_INITIALIZED_ATTRIBUTE) == true)
end

local function canClaimCurrentReward(player: Player, nowUnix: number): boolean
	if DEBUG_SEQUENTIAL_CLAIM_MODE then
		return true
	end

	if player:GetAttribute(TIMEZONE_INITIALIZED_ATTRIBUTE) ~= true then
		return false
	end

	local timezoneOffsetMinutes = sanitizeTimezoneOffsetMinutes(player:GetAttribute(TIMEZONE_OFFSET_ATTRIBUTE))
	local currentDayKey = DailyRewardsConfig.GetLocalDayKey(nowUnix, timezoneOffsetMinutes)
	local lastClaimDayKey = sanitizeDayKey(player:GetAttribute(LAST_CLAIM_DAY_KEY_ATTRIBUTE))
	return currentDayKey > lastClaimDayKey
end

local function migrateLegacyClaimWindow(player: Player, nowUnix: number, timezoneOffsetMinutes: number)
	local legacyNextClaimUnix = sanitizeNextClaimUnix(player:GetAttribute(NEXT_CLAIM_ATTRIBUTE))
	if legacyNextClaimUnix <= 0 then
		return
	end

	local legacyClaimUnix = math.max(0, legacyNextClaimUnix - DailyRewardsConfig.SECONDS_PER_DAY)
	local legacyClaimDayKey = DailyRewardsConfig.GetLocalDayKey(legacyClaimUnix, timezoneOffsetMinutes)
	local currentDayKey = DailyRewardsConfig.GetLocalDayKey(nowUnix, timezoneOffsetMinutes)
	if currentDayKey <= legacyClaimDayKey then
		player:SetAttribute(LAST_CLAIM_DAY_KEY_ATTRIBUTE, legacyClaimDayKey)
		player:SetAttribute(
			NEXT_CLAIM_ATTRIBUTE,
			DailyRewardsConfig.GetNextLocalResetUnix(nowUnix, timezoneOffsetMinutes)
		)
	else
		player:SetAttribute(LAST_CLAIM_DAY_KEY_ATTRIBUTE, 0)
		player:SetAttribute(NEXT_CLAIM_ATTRIBUTE, 0)
	end
end

function DailyRewardsService.SyncTimezone(player: Player, rawTimezoneOffsetMinutes: any): boolean
	if player:GetAttribute("Data_Loaded") ~= true then
		return false
	end

	local timezoneOffsetMinutes = sanitizeTimezoneOffsetMinutes(rawTimezoneOffsetMinutes)
	if player:GetAttribute(TIMEZONE_INITIALIZED_ATTRIBUTE) == true then
		return sanitizeTimezoneOffsetMinutes(player:GetAttribute(TIMEZONE_OFFSET_ATTRIBUTE))
			== timezoneOffsetMinutes
	end

	local nowUnix = os.time()
	player:SetAttribute(TIMEZONE_OFFSET_ATTRIBUTE, timezoneOffsetMinutes)
	player:SetAttribute(TIMEZONE_INITIALIZED_ATTRIBUTE, true)
	migrateLegacyClaimWindow(player, nowUnix, timezoneOffsetMinutes)
	return true
end

local function applyRewardGrant(
	player: Player,
	reward: DailyRewardDefinition,
	cycleCount: number,
	transactionTypeName: string?,
	itemSku: string?,
	maxXPSpeedSnapshot: number?,
	currentWinsSnapshot: number?
)
	local maxXPSpeed = maxXPSpeedSnapshot
	if maxXPSpeed == nil then
		maxXPSpeed = player:GetAttribute("MaxXPSpeed")
	end
	local currentWins = currentWinsSnapshot
	if currentWins == nil then
		currentWins = player:GetAttribute("WinCount")
	end

	local rewardAmount = DailyRewardsConfig.GetRewardAmount(reward, cycleCount, maxXPSpeed, currentWins)
	local resolvedTransactionType = transactionTypeName or Enum.AnalyticsEconomyTransactionType.TimedReward.Name
	local resolvedItemSku = itemSku or "DailyReward"

	if reward.kind == "XPSpeed" then
		local awardedAmount = PlayerHandler.AddExactXPSpeed(player, rewardAmount)
		EconomyAnalytics.LogSource(
			player,
			"XPSpeed",
			awardedAmount,
			resolvedTransactionType,
			resolvedItemSku,
			{ customField01 = reward.kind, customField02 = tostring(cycleCount) }
		)
		XPGainAwarded:FireClient(player, awardedAmount)
		return
	end

	if reward.kind == "Wins" then
		local finalWins = PlayerHandler.AddExactWins(player, rewardAmount)
		EconomyAnalytics.LogSource(
			player,
			"Wins",
			finalWins,
			resolvedTransactionType,
			resolvedItemSku,
			{ customField01 = reward.kind, customField02 = tostring(cycleCount) }
		)
		WinButtonPressed:FireClient(player, finalWins, "DailyReward")
		return
	end

	if reward.kind == "Level" then
		PlayerHandler.AddLevels(player, rewardAmount)
		return
	end

	if reward.kind == "Rebirth" then
		for _ = 1, rewardAmount do
			LevelingService.PerformRebirth(player, true)
		end
		return
	end

	DebugModule.debugWarn(
		string.format("Unsupported daily reward kind '%s' for %s", tostring(reward.kind), player.Name),
		MODULE_NAME
	)
end

local function getCurrentDayFields(player: Player)
	return {
		customField01 = tostring(sanitizeCurrentDay(player:GetAttribute(CURRENT_DAY_ATTRIBUTE))),
		customField02 = tostring(sanitizeCycleCount(player:GetAttribute(CYCLE_COUNT_ATTRIBUTE))),
	}
end

local function advanceAfterSingleClaim(player: Player, claimedDay: number, nowUnix: number)
	if claimedDay >= DAY_COUNT then
		local currentCycleCount = sanitizeCycleCount(player:GetAttribute(CYCLE_COUNT_ATTRIBUTE))
		player:SetAttribute(CURRENT_DAY_ATTRIBUTE, 1)
		player:SetAttribute(CYCLE_COUNT_ATTRIBUTE, currentCycleCount + 1)
	else
		player:SetAttribute(CURRENT_DAY_ATTRIBUTE, claimedDay + 1)
	end

	local timezoneOffsetMinutes = sanitizeTimezoneOffsetMinutes(player:GetAttribute(TIMEZONE_OFFSET_ATTRIBUTE))
	local currentDayKey = DailyRewardsConfig.GetLocalDayKey(nowUnix, timezoneOffsetMinutes)
	player:SetAttribute(LAST_CLAIM_DAY_KEY_ATTRIBUTE, currentDayKey)
	player:SetAttribute(
		NEXT_CLAIM_ATTRIBUTE,
		if DEBUG_SEQUENTIAL_CLAIM_MODE
			then 0
			else DailyRewardsConfig.GetNextLocalResetUnix(nowUnix, timezoneOffsetMinutes)
	)
end

local function resetAfterClaimAll(player: Player, nowUnix: number)
	local currentCycleCount = sanitizeCycleCount(player:GetAttribute(CYCLE_COUNT_ATTRIBUTE))
	player:SetAttribute(CURRENT_DAY_ATTRIBUTE, 1)
	player:SetAttribute(CYCLE_COUNT_ATTRIBUTE, currentCycleCount + 1)
	local timezoneOffsetMinutes = sanitizeTimezoneOffsetMinutes(player:GetAttribute(TIMEZONE_OFFSET_ATTRIBUTE))
	local currentDayKey = DailyRewardsConfig.GetLocalDayKey(nowUnix, timezoneOffsetMinutes)
	player:SetAttribute(LAST_CLAIM_DAY_KEY_ATTRIBUTE, currentDayKey)
	player:SetAttribute(
		NEXT_CLAIM_ATTRIBUTE,
		if DEBUG_SEQUENTIAL_CLAIM_MODE
			then 0
			else DailyRewardsConfig.GetNextLocalResetUnix(nowUnix, timezoneOffsetMinutes)
	)
end

function DailyRewardsService.ClaimCurrent(player: Player): boolean
	ensurePlayerState(player)

	local nowUnix = os.time()
	local currentDay = sanitizeCurrentDay(player:GetAttribute(CURRENT_DAY_ATTRIBUTE))
	local claimSessionId = FunnelAnalytics.OpenRecurringFunnel(
		player,
		DAILY_REWARD_FUNNEL_NAME,
		"Daily Reward Claim Clicked",
		getCurrentDayFields(player)
	)

	if not canClaimCurrentReward(player, nowUnix) then
		if claimSessionId then
			FunnelAnalytics.LogRecurringStep(
				player,
				DAILY_REWARD_FUNNEL_NAME,
				claimSessionId,
				2,
				"Daily Reward Not Ready",
				getCurrentDayFields(player)
			)
		end
		ShowNotification:FireClient(player, "DAILY REWARD NOT READY!", "Red")
		return false
	end

	local cycleCount = sanitizeCycleCount(player:GetAttribute(CYCLE_COUNT_ATTRIBUTE))
	local reward = DailyRewardsConfig.GetReward(currentDay)
	if not reward then
		return false
	end

	local grantOk, grantError = pcall(function()
		applyRewardGrant(player, reward, cycleCount)
	end)
	if not grantOk then
		DebugModule.debugWarn(
			string.format(
				"Daily reward claim failed | player=%s day=%d err=%s",
				player.Name,
				currentDay,
				tostring(grantError)
			),
			MODULE_NAME
		)
		ShowNotification:FireClient(player, "DAILY REWARD CLAIM FAILED!", "Red")
		return false
	end

	if claimSessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			DAILY_REWARD_FUNNEL_NAME,
			claimSessionId,
			2,
			"Daily Reward Granted",
			getCurrentDayFields(player)
		)
	end

	advanceAfterSingleClaim(player, currentDay, nowUnix)
	ShowNotification:FireClient(player, "DAILY REWARD CLAIMED!", "Green")
	return true
end

function DailyRewardsService.ClaimAllRemaining(player: Player): boolean
	ensurePlayerState(player)

	local currentDay = sanitizeCurrentDay(player:GetAttribute(CURRENT_DAY_ATTRIBUTE))
	local cycleCount = sanitizeCycleCount(player:GetAttribute(CYCLE_COUNT_ATTRIBUTE))
	local maxXPSpeedSnapshot = player:GetAttribute("MaxXPSpeed")
	local currentWinsSnapshot = player:GetAttribute("WinCount")
	local nowUnix = os.time()
	local claimAllSessionId = claimAllFunnelSessions[player]
	if not claimAllSessionId then
		claimAllSessionId = FunnelAnalytics.OpenRecurringFunnel(
			player,
			DAILY_REWARD_CLAIM_ALL_FUNNEL_NAME,
			"Claim All Purchased",
			getCurrentDayFields(player)
		)
	else
		FunnelAnalytics.LogRecurringStep(
			player,
			DAILY_REWARD_CLAIM_ALL_FUNNEL_NAME,
			claimAllSessionId,
			2,
			"Claim All Purchased",
			getCurrentDayFields(player)
		)
	end

	local grantOk, grantError = pcall(function()
		for day = currentDay, DAY_COUNT do
			local reward = DailyRewardsConfig.GetReward(day)
			if reward then
				applyRewardGrant(
					player,
					reward,
					cycleCount,
					Enum.AnalyticsEconomyTransactionType.IAP.Name,
					"DailyRewardClaimAll",
					maxXPSpeedSnapshot,
					currentWinsSnapshot
				)
			end
		end
	end)
	if not grantOk then
		DebugModule.debugWarn(
			string.format(
				"Claim all daily rewards failed | player=%s startDay=%d err=%s",
				player.Name,
				currentDay,
				tostring(grantError)
			),
			MODULE_NAME
		)
		ShowNotification:FireClient(player, "CLAIM ALL FAILED!", "Red")
		return false
	end

	if claimAllSessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			DAILY_REWARD_CLAIM_ALL_FUNNEL_NAME,
			claimAllSessionId,
			if claimAllFunnelSessions[player] then 3 else 2,
			"Claim All Rewards Granted",
			getCurrentDayFields(player)
		)
	end
	claimAllFunnelSessions[player] = nil

	resetAfterClaimAll(player, nowUnix)
	ShowNotification:FireClient(player, "CLAIMED ALL DAILY REWARDS!", "Green")
	return true
end

local function handleClaimAllPromptOpened(player: Player, payload: { [string]: any })
	local currentDay = sanitizeCurrentDay(player:GetAttribute(CURRENT_DAY_ATTRIBUTE))
	local cycleCount = sanitizeCycleCount(player:GetAttribute(CYCLE_COUNT_ATTRIBUTE))
	local sessionId =
		FunnelAnalytics.OpenRecurringFunnel(player, DAILY_REWARD_CLAIM_ALL_FUNNEL_NAME, "Claim All Prompt Opened", {
			customField01 = tostring(currentDay),
			customField02 = tostring(cycleCount),
			customField03 = tostring(payload.source or "DailyRewardsUI"),
		})
	if sessionId then
		claimAllFunnelSessions[player] = sessionId
	end
end

function DailyRewardsService.OnRewardAction(player: Player, action: string)
	if typeof(action) ~= "string" then
		return
	end

	if action ~= "ClaimCurrent" then
		return
	end

	local now = os.clock()
	local lastRequest = lastRequestAt[player] or 0
	if now - lastRequest < REQUEST_COOLDOWN_SECONDS then
		return
	end
	lastRequestAt[player] = now

	if requestInFlight[player] == true then
		return
	end

	requestInFlight[player] = true
	DailyRewardsService.ClaimCurrent(player)
	requestInFlight[player] = nil
end

function DailyRewardsService.OnPlayerAdded(player: Player)
	ensurePlayerState(player)
end

function DailyRewardsService.CleanupPlayer(player: Player)
	requestInFlight[player] = nil
	lastRequestAt[player] = nil
	claimAllFunnelSessions[player] = nil
end

function DailyRewardsService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	serviceMaid.RewardAction = dailyRewardAction.OnServerEvent:Connect(DailyRewardsService.OnRewardAction)
	serviceMaid.TimeSync = dailyRewardTimeSync.OnServerEvent:Connect(function(player: Player, timezoneOffsetMinutes: any)
		DailyRewardsService.SyncTimezone(player, timezoneOffsetMinutes)
	end)
	FunnelAnalytics.RegisterClientAction("DailyRewardClaimAllPromptOpened", handleClaimAllPromptOpened)
	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(DailyRewardsService.CleanupPlayer)
	DebugModule.debugInfo("DailyRewardsService initialized", MODULE_NAME)
end

function DailyRewardsService.Shutdown()
	serviceMaid:DoCleaning()
	table.clear(requestInFlight)
	table.clear(lastRequestAt)
	table.clear(claimAllFunnelSessions)
	isInitialized = false
end

return DailyRewardsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3745">
        <Properties>
          <string name="Name">DataRecoveryService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DebugModule = require(ReplicatedStorage.Modules:WaitForChild("DebugModule"))
local ProductServerService = require(script.Parent:WaitForChild("ProductServerService"))

local DataRecoveryService = {}

local MODULE_NAME = "DataRecoveryService"
local MAX_RECOVERY_ATTEMPTS = 3
local REQUEST_COOLDOWN_SECONDS = 1

type RetryHandler = (player: Player) -> (boolean, string?)

local remotes = ReplicatedStorage:WaitForChild("Remotes")
local requestRemote: RemoteEvent? = nil
local resultRemote: RemoteEvent? = nil
local requestConnection: RBXScriptConnection? = nil
local playerAddedConnection: RBXScriptConnection? = nil
local playerRemovingConnection: RBXScriptConnection? = nil
local recoveryAttempts: { [Player]: number } = {}
local retryAttempts: { [Player]: number } = {}
local resetAttempts: { [Player]: number } = {}
local lastRequestAt: { [Player]: number } = {}
local recoveryRequestsInFlight: { [Player]: boolean } = {}
local retryHandler: RetryHandler? = nil

local function getOrCreateRemote(name: string): RemoteEvent
	local existing = remotes:FindFirstChild(name)
	if existing then
		assert(existing:IsA("RemoteEvent"), name .. " must be a RemoteEvent")
		return existing
	end

	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end

local function initializePlayer(player: Player)
	recoveryAttempts[player] = 0
	retryAttempts[player] = 0
	resetAttempts[player] = 0
	lastRequestAt[player] = nil
	recoveryRequestsInFlight[player] = nil
	player:SetAttribute("DataRecoveryAttempts", 0)
end

local function cleanupPlayer(player: Player)
	recoveryAttempts[player] = nil
	retryAttempts[player] = nil
	resetAttempts[player] = nil
	lastRequestAt[player] = nil
	recoveryRequestsInFlight[player] = nil
end

local function sendResult(player: Player, success: boolean, attempts: number, message: string)
	if resultRemote and player.Parent ~= nil then
		resultRemote:FireClient(player, success, attempts, message)
	end
end

local function recordRecoveryAttempt(player: Player): number
	local attempts = (recoveryAttempts[player] or 0) + 1
	recoveryAttempts[player] = attempts
	player:SetAttribute("DataRecoveryAttempts", attempts)
	return attempts
end

local function handleRequest(player: Player, action: any)
	if typeof(action) ~= "string" then
		return
	end
	if player:GetAttribute("Data_LoadState") ~= "RecoveryRequired" then
		return
	end

	local now = os.clock()
	local lastRequest = lastRequestAt[player]
	if lastRequest ~= nil and now - lastRequest < REQUEST_COOLDOWN_SECONDS then
		return
	end
	lastRequestAt[player] = now

	if action ~= "Retry" and action ~= "Reset" then
		return
	end

	if recoveryRequestsInFlight[player] then
		return
	end

	local actionAttempts = if action == "Retry" then retryAttempts[player] or 0 else resetAttempts[player] or 0
	if actionAttempts >= MAX_RECOVERY_ATTEMPTS then
		sendResult(player, false, recoveryAttempts[player] or 0, "Attempt limit reached. Please rejoin and try again.")
		return
	end

	local attempts = recordRecoveryAttempt(player)
	recoveryRequestsInFlight[player] = true

	if action == "Retry" then
		retryAttempts[player] = actionAttempts + 1
		if retryHandler == nil then
			recoveryRequestsInFlight[player] = nil
			sendResult(player, false, attempts, "Retry is not available yet. Please rejoin and try again.")
			return
		end

		local retryOk, retrySucceeded, retryMessage = pcall(retryHandler, player)
		recoveryRequestsInFlight[player] = nil
		if retryOk and retrySucceeded then
			sendResult(player, true, attempts, "Your data loaded successfully.")
			return
		end

		DebugModule.debugWarn(
			"Recovery load retry failed | player="
				.. player.Name
				.. " | attempt="
				.. tostring(attempts)
				.. " | err="
				.. tostring(if retryOk then retryMessage else retrySucceeded),
			MODULE_NAME
		)
		sendResult(
			player,
			false,
			attempts,
			if retryOk and typeof(retryMessage) == "string"
				then retryMessage
				else "Retry failed safely. Your data was not changed."
		)
		return
	end

	resetAttempts[player] = actionAttempts + 1
	local resetSucceeded = ProductServerService.ResetRecoveryProfile(player)
	recoveryRequestsInFlight[player] = nil
	if resetSucceeded then
		player:Kick("Your profile was reset safely. Please rejoin.")
		return
	end

	DebugModule.debugWarn(
		"Recovery reset request failed | player=" .. player.Name .. " | attempt=" .. tostring(attempts),
		MODULE_NAME
	)
	sendResult(player, false, attempts, "Reset failed safely. Your data was not changed. Please try again or rejoin.")
end

function DataRecoveryService.SetRetryHandler(handler: RetryHandler?)
	retryHandler = handler
end

function DataRecoveryService.RecordInitialRecoveryAttempt(player: Player)
	if player.Parent == nil or player:GetAttribute("Data_LoadState") ~= "RecoveryRequired" then
		return
	end
	if (recoveryAttempts[player] or 0) == 0 then
		recordRecoveryAttempt(player)
	end
end

function DataRecoveryService.Init()
	if requestConnection ~= nil then
		return
	end

	requestRemote = getOrCreateRemote("DataRecoveryRequest")
	resultRemote = getOrCreateRemote("DataRecoveryResult")
	requestConnection = requestRemote.OnServerEvent:Connect(handleRequest)
	playerAddedConnection = Players.PlayerAdded:Connect(initializePlayer)
	playerRemovingConnection = Players.PlayerRemoving:Connect(cleanupPlayer)

	for _, player in ipairs(Players:GetPlayers()) do
		initializePlayer(player)
	end
end

function DataRecoveryService.Shutdown()
	if requestConnection then
		requestConnection:Disconnect()
		requestConnection = nil
	end
	if playerAddedConnection then
		playerAddedConnection:Disconnect()
		playerAddedConnection = nil
	end
	if playerRemovingConnection then
		playerRemovingConnection:Disconnect()
		playerRemovingConnection = nil
	end

	requestRemote = nil
	resultRemote = nil
	retryHandler = nil
	recoveryAttempts = {}
	retryAttempts = {}
	resetAttempts = {}
	lastRequestAt = {}
	recoveryRequestsInFlight = {}
end

return DataRecoveryService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3746">
        <Properties>
          <string name="Name">DataStoreRequestGate</string>
          <string name="Source"><![CDATA[--!strict

local DataStoreService = game:GetService("DataStoreService")

type RequestKind = "StandardUpdate" | "OrderedWrite" | "OrderedList"
type RunOptions = {
	maxWaitSeconds: number?,
	shouldContinue: (() -> boolean)?,
	queueKey: string?,
}

local DataStoreRequestGate = {}

local DEFAULT_MAX_WAIT_SECONDS = 5
local POLL_INTERVAL_SECONDS = 0.25

type QueueState = {
	nextTicket: number,
	servingTicket: number,
	activeRequest: boolean,
	queuedTickets: { [number]: boolean },
}

local queueStates: { [string]: QueueState } = {}

local function getQueueState(queueKey: string): QueueState
	local existingState = queueStates[queueKey]
	if existingState then
		return existingState
	end

	local state: QueueState = {
		nextTicket = 0,
		servingTicket = 1,
		activeRequest = false,
		queuedTickets = {},
	}
	queueStates[queueKey] = state
	return state
end

local function resolveRequestType(names: { string }): any
	for _, name in ipairs(names) do
		local ok, requestType = pcall(function()
			return Enum.DataStoreRequestType[name]
		end)
		if ok and requestType ~= nil then
			return requestType
		end
	end
	return nil
end

local requestTypes: { [RequestKind]: { any } } = {
	StandardUpdate = {},
	OrderedWrite = {},
	OrderedList = {},
}

local standardRead = resolveRequestType({ "StandardRead", "GetAsync" })
local standardWrite = resolveRequestType({ "StandardWrite", "SetIncrementAsync" })
local legacyUpdate = resolveRequestType({ "UpdateAsync" })
if standardRead ~= nil and standardWrite ~= nil then
	requestTypes.StandardUpdate = { standardRead, standardWrite }
elseif legacyUpdate ~= nil then
	requestTypes.StandardUpdate = { legacyUpdate }
end

local orderedWrite = resolveRequestType({ "OrderedWrite", "SetIncrementSortedAsync" })
if orderedWrite ~= nil then
	requestTypes.OrderedWrite = { orderedWrite }
end

local orderedList = resolveRequestType({ "OrderedList", "GetSortedAsync" })
if orderedList ~= nil then
	requestTypes.OrderedList = { orderedList }
end

local function advanceServingTicket(state: QueueState)
	while
		state.servingTicket <= state.nextTicket
		and state.queuedTickets[state.servingTicket] == nil
		and not state.activeRequest
	do
		state.servingTicket += 1
	end
end

local function cancelTicket(state: QueueState, ticket: number)
	state.queuedTickets[ticket] = nil
	advanceServingTicket(state)
end

local function acquireRequestSlot(
	queueKey: string,
	maxWaitSeconds: number,
	shouldContinue: (() -> boolean)?
): (boolean, number?, QueueState?)
	local state = getQueueState(queueKey)
	state.nextTicket += 1
	local ticket = state.nextTicket
	state.queuedTickets[ticket] = true
	local deadline = os.clock() + maxWaitSeconds

	while true do
		if shouldContinue ~= nil and not shouldContinue() then
			cancelTicket(state, ticket)
			return false, nil, nil
		end

		if ticket == state.servingTicket and not state.activeRequest then
			state.queuedTickets[ticket] = nil
			state.activeRequest = true
			return true, ticket, state
		end

		local remaining = deadline - os.clock()
		if remaining <= 0 then
			cancelTicket(state, ticket)
			return false, nil, nil
		end
		task.wait(math.min(POLL_INTERVAL_SECONDS, remaining))
	end
end

local function releaseRequestSlot(state: QueueState, ticket: number)
	if not state.activeRequest then
		return
	end

	state.activeRequest = false
	if state.servingTicket == ticket then
		state.servingTicket += 1
	end
	advanceServingTicket(state)
end

local function hasAvailableBudget(kind: RequestKind): boolean
	local types = requestTypes[kind]
	if #types == 0 then
		-- Older engine versions may not expose the newer budget enums. In that
		-- case, retain pcall protection and let Roblox handle the request.
		return true
	end

	for _, requestType in ipairs(types) do
		local ok, budget = pcall(function()
			return DataStoreService:GetRequestBudgetForRequestType(requestType)
		end)
		if not ok or typeof(budget) ~= "number" then
			return true
		end
		if budget < 1 then
			return false
		end
	end

	return true
end

function DataStoreRequestGate.Run(
	kind: RequestKind,
	operationName: string,
	operation: () -> any,
	options: RunOptions?
): (boolean, any, any, any)
	local resolvedOptions = options or {}
	local maxWaitSeconds = math.max(0, resolvedOptions.maxWaitSeconds or DEFAULT_MAX_WAIT_SECONDS)
	local shouldContinue = resolvedOptions.shouldContinue
	local queueKey = resolvedOptions.queueKey or "Default"
	local acquired, ticket, queueState = acquireRequestSlot(queueKey, maxWaitSeconds, shouldContinue)
	if not acquired or ticket == nil or queueState == nil then
		return false, "Request gate wait cancelled or timed out: " .. operationName, nil, nil
	end

	local deadline = os.clock() + maxWaitSeconds
	while not hasAvailableBudget(kind) do
		if shouldContinue ~= nil and not shouldContinue() then
			releaseRequestSlot(queueState, ticket)
			return false, "Request gate wait cancelled: " .. operationName, nil, nil
		end

		local remaining = deadline - os.clock()
		if remaining <= 0 then
			releaseRequestSlot(queueState, ticket)
			return false, "Datastore budget wait timed out: " .. operationName, nil, nil
		end
		task.wait(math.min(POLL_INTERVAL_SECONDS, remaining))
	end

	local ok, result, result2, result3 = pcall(operation)
	releaseRequestSlot(queueState, ticket)
	return ok, result, result2, result3
end

return DataStoreRequestGate
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3747">
        <Properties>
          <string name="Name">EconomyAnalytics</string>
          <string name="Source"><![CDATA[local AnalyticsService = game:GetService("AnalyticsService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))

local EconomyAnalytics = {}

local MODULE_NAME = "EconomyAnalytics"
local analyticsConfig = if CoreConfig.analytics then CoreConfig.analytics else nil
local ANALYTICS_ENABLED = if analyticsConfig and typeof(analyticsConfig.enabled) == "boolean"
	then analyticsConfig.enabled
	else true
local ECONOMY_EVENTS_ENABLED = if analyticsConfig and typeof(analyticsConfig.economyEventsEnabled) == "boolean"
	then analyticsConfig.economyEventsEnabled
	else true
local LIVE_SERVER_ONLY = if analyticsConfig and typeof(analyticsConfig.liveServerOnly) == "boolean"
	then analyticsConfig.liveServerOnly
	else true
local MAX_SAFE_ANALYTICS_INTEGER = 9007199254740991

type ScalarValue = string | number | boolean

export type CurrencyName = "Wins" | "XPSpeed" | "BloodmoonWins" | "NeonRushWins" | "FrostbiteRallyWins"
export type CustomFields = {
	customField01: ScalarValue?,
	customField02: ScalarValue?,
	customField03: ScalarValue?,
}

local CURRENCY_BALANCE_ATTRIBUTES: { [CurrencyName]: string } = {
	Wins = "WinCount",
	XPSpeed = "AllXPSpeed",
	BloodmoonWins = "BloodmoonWins",
	NeonRushWins = "NeonRushWins",
	FrostbiteRallyWins = "FrostbiteRallyWins",
}

local function canSendAnalytics(): boolean
	if not ANALYTICS_ENABLED or not ECONOMY_EVENTS_ENABLED then
		return false
	end

	if not RunService:IsServer() then
		return false
	end

	if LIVE_SERVER_ONLY and RunService:IsStudio() then
		return false
	end

	return true
end

local function isFiniteNumber(value: unknown): boolean
	return typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function isSafeAnalyticsInteger(value: unknown, allowZero: boolean): boolean
	if not isFiniteNumber(value) then
		return false
	end

	local numberValue = value :: number
	local minimum = if allowZero then 0 else 1
	return numberValue >= minimum and numberValue <= MAX_SAFE_ANALYTICS_INTEGER
end

local function stringifyCustomFieldValue(value: ScalarValue): string
	if typeof(value) == "string" then
		return value
	end

	if typeof(value) == "number" then
		if value == math.huge then
			return "inf"
		end
		if value == -math.huge then
			return "-inf"
		end
		if value ~= value then
			return "nan"
		end
		return tostring(value)
	end

	return if value then "true" else "false"
end

local function sanitizeCustomFields(customFields: CustomFields?): { [string]: string }?
	if customFields == nil then
		return nil
	end

	local sanitized = {} :: { [string]: string }

	if customFields.customField01 ~= nil then
		sanitized[Enum.AnalyticsCustomFieldKeys.CustomField01.Name] =
			string.sub(stringifyCustomFieldValue(customFields.customField01), 1, 100)
	end

	if customFields.customField02 ~= nil then
		sanitized[Enum.AnalyticsCustomFieldKeys.CustomField02.Name] =
			string.sub(stringifyCustomFieldValue(customFields.customField02), 1, 100)
	end

	if customFields.customField03 ~= nil then
		sanitized[Enum.AnalyticsCustomFieldKeys.CustomField03.Name] =
			string.sub(stringifyCustomFieldValue(customFields.customField03), 1, 100)
	end

	if next(sanitized) == nil then
		return nil
	end

	return sanitized
end

function EconomyAnalytics.GetBalance(player: Player, currencyName: CurrencyName): number
	local attributeName = CURRENCY_BALANCE_ATTRIBUTES[currencyName]
	local rawBalance = player:GetAttribute(attributeName)
	if typeof(rawBalance) ~= "number" or not isFiniteNumber(rawBalance) then
		return 0
	end

	return math.max(0, rawBalance)
end

function EconomyAnalytics.Log(
	player: Player,
	flowType: Enum.AnalyticsEconomyFlowType,
	currencyName: CurrencyName,
	amount: number,
	transactionTypeName: string,
	itemSku: string?,
	customFields: CustomFields?
)
	if not canSendAnalytics() then
		return
	end

	if player.Parent == nil or player.UserId <= 0 then
		return
	end

	if not isSafeAnalyticsInteger(amount, false) then
		DebugModule.debugWarn(
			string.format(
				"Skipping economy event with analytics-unsafe amount | player=%s | currency=%s | amount=%s",
				player.Name,
				currencyName,
				tostring(amount)
			),
			MODULE_NAME
		)
		return
	end

	local sanitizedAmount = math.max(1, math.round(amount))
	if not isSafeAnalyticsInteger(sanitizedAmount, false) then
		DebugModule.debugWarn(
			string.format(
				"Skipping economy event with analytics-unsafe rounded amount | player=%s | currency=%s | amount=%s",
				player.Name,
				currencyName,
				tostring(amount)
			),
			MODULE_NAME
		)
		return
	end

	local balanceAttributeName = CURRENCY_BALANCE_ATTRIBUTES[currencyName]
	local rawEndingBalance = player:GetAttribute(balanceAttributeName)
	if not isSafeAnalyticsInteger(rawEndingBalance, true) then
		DebugModule.debugWarn(
			string.format(
				"Skipping economy event with analytics-unsafe ending balance | player=%s | currency=%s | attribute=%s | value=%s",
				player.Name,
				currencyName,
				balanceAttributeName,
				tostring(rawEndingBalance)
			),
			MODULE_NAME
		)
		return
	end

	local endingBalance = math.max(0, math.round(rawEndingBalance))
	if not isSafeAnalyticsInteger(endingBalance, true) then
		DebugModule.debugWarn(
			string.format(
				"Skipping economy event after analytics balance normalization | player=%s | currency=%s | value=%s",
				player.Name,
				currencyName,
				tostring(rawEndingBalance)
			),
			MODULE_NAME
		)
		return
	end
	local sanitizedItemSku = string.sub(itemSku or "", 1, 100)
	local sanitizedCustomFields = sanitizeCustomFields(customFields)

	local ok, err = pcall(function()
		if sanitizedCustomFields then
			AnalyticsService:LogEconomyEvent(
				player,
				flowType,
				currencyName,
				sanitizedAmount,
				endingBalance,
				transactionTypeName,
				sanitizedItemSku,
				sanitizedCustomFields
			)
		else
			AnalyticsService:LogEconomyEvent(
				player,
				flowType,
				currencyName,
				sanitizedAmount,
				endingBalance,
				transactionTypeName,
				sanitizedItemSku
			)
		end
	end)

	if not ok then
		DebugModule.debugWarn(
			string.format(
				"Economy event failed | player=%s | flow=%s | currency=%s | amount=%s | item=%s | err=%s",
				player.Name,
				flowType.Name,
				currencyName,
				tostring(sanitizedAmount),
				sanitizedItemSku,
				tostring(err)
			),
			MODULE_NAME
		)
	end
end

function EconomyAnalytics.LogSource(
	player: Player,
	currencyName: CurrencyName,
	amount: number,
	transactionTypeName: string,
	itemSku: string?,
	customFields: CustomFields?
)
	EconomyAnalytics.Log(
		player,
		Enum.AnalyticsEconomyFlowType.Source,
		currencyName,
		amount,
		transactionTypeName,
		itemSku,
		customFields
	)
end

function EconomyAnalytics.LogSink(
	player: Player,
	currencyName: CurrencyName,
	amount: number,
	transactionTypeName: string,
	itemSku: string?,
	customFields: CustomFields?
)
	EconomyAnalytics.Log(
		player,
		Enum.AnalyticsEconomyFlowType.Sink,
		currencyName,
		amount,
		transactionTypeName,
		itemSku,
		customFields
	)
end

return EconomyAnalytics
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3748">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local ProductService = require(script.Parent.Shared:WaitForChild("ProductService_Server"))
local FunnelAnalytics =
	require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("FunnelAnalytics_Server"))
local Maid = require(Modules:WaitForChild("Maid"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))
local EconomyAnalytics = require(script.Parent:WaitForChild("EconomyAnalytics"))

local EconomyService = {}
local DEFAULT_MAX_PLAYER_SPEED = if typeof(PlayerHandler.DEFAULT_ATTRIBUTES.Max_Player_Speed) == "number"
	then PlayerHandler.DEFAULT_ATTRIBUTES.Max_Player_Speed
	else 16

-- CONFIG
local MODULE_NAME = "EconomyService"
local isInitialized = false
local serviceMaid = Maid.new()

-- REMOTES
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local SpeedAction = Remotes:WaitForChild("SpeedAction") :: RemoteEvent
local TrailAction = Remotes:WaitForChild("TrailAction") :: RemoteEvent
local ShowNotification = Remotes:WaitForChild("ShowNotification") :: RemoteEvent
local XPGainAwarded = Remotes:WaitForChild("XPGainAwarded") :: RemoteEvent
local WinButtonPressed = Remotes:WaitForChild("WinButtonPressed") :: RemoteEvent

local STARTER_PACK_GAMEPASS_ID = ProductService.Gamepasses["StarterPack"]
local STARTER_PACK_REWARD_CLAIMED_ATTRIBUTE = "StarterPackRewardClaimed"
local STARTER_PACK_XP_REWARD = 10000
local STARTER_PACK_WIN_REWARD = 250
local analyticsConfig = if CoreConfig.analytics then CoreConfig.analytics else nil
local analyticsFunnels = if analyticsConfig and typeof(analyticsConfig.funnels) == "table"
	then analyticsConfig.funnels
	else nil
local STARTER_PACK_FUNNEL_NAME = if analyticsFunnels and typeof(analyticsFunnels.starterPack) == "string"
	then analyticsFunnels.starterPack
	else "StarterPackFlow"
local starterPackFunnelSessions: { [Player]: string } = {}

function EconomyService.SyncTrailState(player: Player)
	local equippedTrail = player:GetAttribute("Trail_Equipped")
	if typeof(equippedTrail) == "string" and equippedTrail ~= "" and equippedTrail ~= "None" then
		local trailConfig = PlayerHandler.GetTrailConfig(equippedTrail)
		if trailConfig then
			if not PlayerHandler.OwnsTrail(player, equippedTrail) then
				if trailConfig.EventOnly == true then
					player:SetAttribute("Trail_Equipped", "None")
				else
					PlayerHandler.AddOwnedTrail(player, equippedTrail)
				end
			end
		else
			player:SetAttribute("Trail_Equipped", "None")
		end
	end
	PlayerHandler.ApplyTrailMultiplier(player)
end

function EconomyService.SyncGamePassAttributes(player: Player)
	-- Initial gamepass hydration can add owned karts after datastore load. Keep
	-- the client badge in baseline mode until that authoritative sync completes.
	if player:GetAttribute("GamePassOwnershipSyncComplete") ~= true then
		player:SetAttribute("GamePassOwnershipSyncComplete", false)
	end

	-- Wins GamePass
	local winsId = ProductService.Gamepasses["2xWins"]
	local targetWinMult = if ProductService.userOwnsGamePass(player, winsId) then 2 else 1
	if player:GetAttribute("WinMultiplier") ~= targetWinMult then
		player:SetAttribute("WinMultiplier", targetWinMult)
	end

	-- VIP GamePass
	local vipId = ProductService.Gamepasses["VIP"]
	local targetVIP = ProductService.userOwnsGamePass(player, vipId)
	if player:GetAttribute("HasVIPPass") ~= targetVIP then
		player:SetAttribute("HasVIPPass", targetVIP)
	end

	-- Kart GamePasses
	local karts = { "AdvancedTank", "ShoppingKart", "FormulaCar" }
	for _, kartName in ipairs(karts) do
		local id = ProductService.Gamepasses[kartName]
		if id and ProductService.userOwnsGamePass(player, id) then
			PlayerHandler.AddOwnedKart(player, kartName)
		end
	end

	-- Validate currently equipped kart
	local equipped = player:GetAttribute("Kart_Equipped")
	if
		typeof(equipped) == "string"
		and table.find(karts, equipped)
		and not PlayerHandler.OwnsKart(player, equipped)
	then
		player:SetAttribute("Kart_Equipped", "1_Default")
	end

	-- Treadmill multiplier is runtime state and should only be set by treadmill touch flow.
	-- Owning a treadmill pass grants access to treadmill parts, not passive XP on join.
	if player:GetAttribute("Treadmill_Active") ~= true then
		if player:GetAttribute("Treadmill_XPMultiplier") ~= 1 then
			player:SetAttribute("Treadmill_XPMultiplier", 1)
		end

		local defaultInterval = PlayerHandler.MOVEMENT_CONFIG.XP_GAIN_INTERVAL
		if player:GetAttribute("Movement_XPGainInterval") ~= defaultInterval then
			player:SetAttribute("Movement_XPGainInterval", defaultInterval)
		end
	end

	EconomyService.GrantStarterPackIfEligible(player)
	player:SetAttribute("GamePassOwnershipSyncComplete", true)
end

function EconomyService.GrantStarterPackIfEligible(player: Player): boolean
	if typeof(STARTER_PACK_GAMEPASS_ID) ~= "number" or STARTER_PACK_GAMEPASS_ID == 0 then
		return false
	end

	if player:GetAttribute(STARTER_PACK_REWARD_CLAIMED_ATTRIBUTE) == true then
		return false
	end

	if not ProductService.userOwnsGamePass(player, STARTER_PACK_GAMEPASS_ID) then
		return false
	end

	local sessionId = starterPackFunnelSessions[player]
	if sessionId then
		FunnelAnalytics.LogRecurringStep(player, STARTER_PACK_FUNNEL_NAME, sessionId, 2, "Starter Pack Owned", {
			customField01 = "Owned",
		})
	else
		sessionId = FunnelAnalytics.OpenRecurringFunnel(player, STARTER_PACK_FUNNEL_NAME, "Starter Pack Owned", {
			customField01 = "OwnedOutsidePrompt",
		})
	end

	local awardedWins = PlayerHandler.AddExactWins(player, STARTER_PACK_WIN_REWARD)
	local awardedXP = PlayerHandler.AddExactXPSpeed(player, STARTER_PACK_XP_REWARD)
	EconomyAnalytics.LogSource(
		player,
		"Wins",
		awardedWins,
		Enum.AnalyticsEconomyTransactionType.IAP.Name,
		"StarterPack",
		{ customField01 = "GamePass" }
	)
	EconomyAnalytics.LogSource(
		player,
		"XPSpeed",
		awardedXP,
		Enum.AnalyticsEconomyTransactionType.IAP.Name,
		"StarterPack",
		{ customField01 = "GamePass" }
	)

	player:SetAttribute(STARTER_PACK_REWARD_CLAIMED_ATTRIBUTE, true)
	WinButtonPressed:FireClient(player, awardedWins, "StarterPack")
	XPGainAwarded:FireClient(player, awardedXP)
	ShowNotification:FireClient(player, "STARTER PACK CLAIMED!", "Green")
	if sessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			STARTER_PACK_FUNNEL_NAME,
			sessionId,
			if starterPackFunnelSessions[player] then 3 else 2,
			"Starter Pack Reward Granted",
			{
				customField01 = tostring(awardedWins),
				customField02 = tostring(awardedXP),
			}
		)
	end
	starterPackFunnelSessions[player] = nil

	DebugModule.debugInfo(
		string.format("Starter pack granted | player=%s | wins=%d | xp=%d", player.Name, awardedWins, awardedXP),
		MODULE_NAME
	)

	return true
end

function EconomyService.OnSpeedAction(player: Player, requestedSpeed: number)
	if typeof(requestedSpeed) ~= "number" then
		return
	end
	local maxSpeed = player:GetAttribute("Max_Player_Speed") or DEFAULT_MAX_PLAYER_SPEED
	local liveEventMultiplier = PlayerHandler.GetLiveEventWalkSpeedMultiplier(player)
	local canonicalRequestedSpeed = if liveEventMultiplier > 0
		then requestedSpeed / liveEventMultiplier
		else requestedSpeed
	local finalSpeed = math.clamp(math.round(canonicalRequestedSpeed), 1, maxSpeed)
	player:SetAttribute("Player_Speed", finalSpeed)
end

function EconomyService.OnTrailAction(player: Player, action: string, trailName: string)
	if typeof(action) ~= "string" or typeof(trailName) ~= "string" then
		return
	end
	local config = PlayerHandler.GetTrailConfig(trailName)
	if not config then
		return
	end

	if config.EventOnly == true and not PlayerHandler.OwnsTrail(player, trailName) then
		DebugModule.debugInfo(
			string.format(
				"Rejected locked event trail action | player=%s | action=%s | trail=%s",
				player.Name,
				action,
				trailName
			),
			MODULE_NAME
		)
		ShowNotification:FireClient(player, "EVENT TRAIL LOCKED!", "Red")
		return
	end

	if action == "BuyWithWins" then
		if config.CanBuyWithWins and not PlayerHandler.OwnsTrail(player, trailName) then
			if PlayerHandler.SpendWins(player, config.WinsRequired) then
				EconomyAnalytics.LogSink(
					player,
					"Wins",
					config.WinsRequired,
					Enum.AnalyticsEconomyTransactionType.Shop.Name,
					"Trail_" .. trailName,
					{ customField01 = trailName }
				)
				PlayerHandler.AddOwnedTrail(player, trailName)
				DebugModule.debugInfo(string.format("Player %s bought %s", player.Name, trailName), MODULE_NAME)
			else
				ShowNotification:FireClient(player, "NOT ENOUGH WINS!", "Red")
			end
		end
	elseif action == "Equip" then
		if PlayerHandler.OwnsTrail(player, trailName) then
			local current = player:GetAttribute("Trail_Equipped")
			player:SetAttribute("Trail_Equipped", if current == trailName then "None" else trailName)
		end
	end
end

function EconomyService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	FunnelAnalytics.RegisterClientAction("StarterPackPromptOpened", function(player: Player, payload: { [string]: any })
		local sessionId =
			FunnelAnalytics.OpenRecurringFunnel(player, STARTER_PACK_FUNNEL_NAME, "Starter Pack Prompt Opened", {
				customField01 = tostring(payload.source or "Client"),
			})
		if sessionId then
			starterPackFunnelSessions[player] = sessionId
		end
	end)
	serviceMaid.SpeedAction = SpeedAction.OnServerEvent:Connect(EconomyService.OnSpeedAction)
	serviceMaid.TrailAction = TrailAction.OnServerEvent:Connect(EconomyService.OnTrailAction)
	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(function(player: Player)
		starterPackFunnelSessions[player] = nil
	end)
	DebugModule.debugInfo("EconomyService Initialized", MODULE_NAME)
end

function EconomyService.Shutdown()
	serviceMaid:DoCleaning()
	table.clear(starterPackFunnelSessions)
	isInitialized = false
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3749">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local Maid = require(Modules:WaitForChild("Maid"))
local NumberFormatting = require(Modules.Shared:WaitForChild("NumberFormatting"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))
local DataStoreRequestGate = require(game:GetService("ServerScriptService").Modules:WaitForChild("DataStoreRequestGate"))

local LeaderboardService = {}

local leaderboardDebugConfig = CoreConfig.leaderboard
local persistenceConfig = CoreConfig.persistence
local DATASTORE_BUDGET_WAIT_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.datastoreBudgetWaitSeconds) == "number"
	then math.max(0.25, persistenceConfig.datastoreBudgetWaitSeconds)
	else 5
LeaderboardService.DEBUG_USE_FAKE_DATA = if leaderboardDebugConfig
		and typeof(leaderboardDebugConfig.debugUseFakeData) == "boolean"
	then RunService:IsStudio() and leaderboardDebugConfig.debugUseFakeData
	else false
LeaderboardService.DEBUG_APPEND_FAKE_DATA = if leaderboardDebugConfig
		and typeof(leaderboardDebugConfig.debugAppendFakeData) == "boolean"
	then RunService:IsStudio() and leaderboardDebugConfig.debugAppendFakeData
	else false

export type LeaderboardConfig = {
	Name: string,
	OrderedStoreName: string,
	AttributeName: string,
	BoardPath: { string },
	MaxEntries: number,
	RefreshInterval: number,
	WriteInterval: number,
}

type LeaderboardEntryData = {
	rank: number,
	userId: number,
	username: string,
	value: number,
}

type LeaderboardBoardCache = {
	scrollingFrame: ScrollingFrame,
	template: Frame,
	entryFrames: { Frame },
	lastSignature: string?,
}

local PLACE_COLORS: { [number]: Color3 } = {
	[1] = Color3.fromRGB(255, 183, 0),
	[2] = Color3.fromRGB(176, 176, 176),
	[3] = Color3.fromRGB(139, 99, 31),
}
local DEFAULT_PLACE_COLOR = Color3.fromRGB(0, 102, 255)
-- OrderedDataStore accepts signed 64-bit integer-sized values. Luau numbers
-- lose exact integer precision above 2^53, but clamping at 2^53 incorrectly
-- capped the leaderboard at roughly 9.01 Qd. Keep a small margin below 2^63
-- so the value remains valid for the OrderedDataStore backend.
local MAX_ORDERED_DATASTORE_INT = 9.22e18
local EXACT_LUA_INTEGER_LIMIT = 9007199254740991
local precisionWarningIssued = false

LeaderboardService.Configs = {
	WinLeaderboard = {
		Name = "WinLeaderboard",
		OrderedStoreName = "WinLeaderboard_v1",
		AttributeName = "WinCount",
		BoardPath = { "Folder", "WinLeaderboard", "Leaderboard", "SurfaceGui", "ScrollingFrame" },
		MaxEntries = 100,
		RefreshInterval = 60,
		WriteInterval = 120,
	},
	SpeedLeaderboard = {
		Name = "SpeedLeaderboard",
		OrderedStoreName = "SpeedLeaderboard_v1",
		AttributeName = "AllXPSpeed",
		BoardPath = { "Folder", "SpeedLeaderboard", "Leaderboard", "SurfaceGui", "ScrollingFrame" },
		MaxEntries = 100,
		RefreshInterval = 60,
		WriteInterval = 120,
	},
}

local orderedStores: { [string]: OrderedDataStore } = {}
local lastPublishedValues: { [string]: { [number]: number } } = {}
local lastWriteTimes: { [string]: { [number]: number } } = {}
local pendingWriteValues: { [string]: { [number]: number } } = {}
local pendingWriteThreads: { [string]: { [number]: thread } } = {}
local forceWriteRequests: { [string]: { [number]: boolean } } = {}
local failedWriteValues: { [string]: { [number]: number } } = {}
local lastWriteFailureLogs: { [string]: { [number]: number } } = {}
local lastSuccessfulEntries: { [string]: { LeaderboardEntryData } } = {}
local boardCaches: { [string]: LeaderboardBoardCache } = {}
local playerBindingMaids: { [Player]: Maid } = {}
local serviceMaid = Maid.new()
local isInitialized = false
local isShuttingDown = false

local FORCED_WRITE_WAIT_TIMEOUT_SECONDS = 10
local WRITE_RETRY_INITIAL_SECONDS = 5
local WRITE_RETRY_MAX_SECONDS = 30
local WRITE_FAILURE_LOG_COOLDOWN_SECONDS = 30
local LEADERBOARD_REQUEST_QUEUE = "Leaderboard"
local ORDERED_WRITE_MIN_SPACING_SECONDS = 0.2
local lastOrderedWriteAt = 0

local function isRealLeaderboardUserId(userId: number): boolean
	return userId > 0
end

local function getOrderedStore(storeName: string): OrderedDataStore
	local cached = orderedStores[storeName]
	if cached then
		return cached
	end

	local store = DataStoreService:GetOrderedDataStore(storeName)
	orderedStores[storeName] = store
	return store
end

-- OrderedDataStore writes share one game-server budget. Serialize every write
-- so per-player workers cannot flood Roblox's ordered-write request queue.
local function setOrderedValue(config: LeaderboardConfig, userId: number, value: number): (boolean, any)
	local success, result = DataStoreRequestGate.Run(
		"OrderedWrite",
		"LeaderboardSetAsync",
		function()
			local remainingSpacing = ORDERED_WRITE_MIN_SPACING_SECONDS - (os.clock() - lastOrderedWriteAt)
			if remainingSpacing > 0 then
				task.wait(remainingSpacing)
			end
			lastOrderedWriteAt = os.clock()
			return getOrderedStore(config.OrderedStoreName):SetAsync(tostring(userId), value)
		end,
		{
			maxWaitSeconds = DATASTORE_BUDGET_WAIT_SECONDS,
			queueKey = LEADERBOARD_REQUEST_QUEUE,
		}
	)
	return success, result
end

local function getBoardScrollingFrame(path: { string }): ScrollingFrame?
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	if not worldsFolder then
		return nil
	end

	for _, world in ipairs(worldsFolder:GetChildren()) do
		local current: Instance = world
		local found = true

		for _, segment in ipairs(path) do
			local nextInstance = current:FindFirstChild(segment)
			if not nextInstance then
				found = false
				break
			end
			current = nextInstance
		end

		if found and current:IsA("ScrollingFrame") then
			return current
		end
	end

	return nil
end

local function getBoardCache(config: LeaderboardConfig): LeaderboardBoardCache?
	local existingCache = boardCaches[config.Name]
	if existingCache then
		if existingCache.scrollingFrame.Parent and existingCache.template.Parent == existingCache.scrollingFrame then
			return existingCache
		end

		boardCaches[config.Name] = nil
	end

	local scrollingFrame = getBoardScrollingFrame(config.BoardPath)
	if not scrollingFrame then
		return nil
	end

	local template = scrollingFrame:FindFirstChild("PlaceFrame")
	if not template or not template:IsA("Frame") then
		return nil
	end

	local cache: LeaderboardBoardCache = {
		scrollingFrame = scrollingFrame,
		template = template,
		entryFrames = {},
		lastSignature = nil,
	}
	boardCaches[config.Name] = cache
	return cache
end

local function getPlaceColor(rank: number): Color3
	return PLACE_COLORS[rank] or DEFAULT_PLACE_COLOR
end

local function getPlayerBindingMaid(player: Player): Maid
	local existingMaid = playerBindingMaids[player]
	if existingMaid then
		return existingMaid
	end

	local maid = Maid.new()
	playerBindingMaids[player] = maid
	return maid
end

local function normalizeOrderedDataStoreValue(rawValue: number): number?
	if rawValue ~= rawValue then
		return nil
	end

	if rawValue == math.huge or rawValue == -math.huge then
		return nil
	end

	if rawValue > EXACT_LUA_INTEGER_LIMIT and not precisionWarningIssued then
		precisionWarningIssued = true
		DebugModule.debugWarn(
			"Leaderboard values above 2^53 are stored with Luau number precision; OrderedDataStore support remains available up to its 64-bit limit.",
			"LeaderboardService"
		)
	end

	local clamped = math.clamp(rawValue, 0, MAX_ORDERED_DATASTORE_INT)
	local rounded = math.floor(clamped + 0.5)

	if rounded ~= rounded then
		return nil
	end

	return rounded
end

local function clearPlayerBinding(player: Player)
	local maid = playerBindingMaids[player]
	if maid then
		maid:DoCleaning()
		playerBindingMaids[player] = nil
	end
end

local function clearPlayerWriteState(userId: number)
	for configName in pairs(LeaderboardService.Configs) do
		local configThreads = pendingWriteThreads[configName]
		if configThreads then
			-- Do not cancel a worker that could currently own the global write
			-- lock. Clearing its pending value lets it exit safely at its next
			-- bounded wait point.
			configThreads[userId] = nil
		end

		local configPendingValues = pendingWriteValues[configName]
		if configPendingValues then
			configPendingValues[userId] = nil
		end

		local configLastPublishedValues = lastPublishedValues[configName]
		if configLastPublishedValues then
			configLastPublishedValues[userId] = nil
		end

		local configLastWriteTimes = lastWriteTimes[configName]
		if configLastWriteTimes then
			configLastWriteTimes[userId] = nil
		end

		local configForceRequests = forceWriteRequests[configName]
		if configForceRequests then
			configForceRequests[userId] = nil
		end

		local configFailedValues = failedWriteValues[configName]
		if configFailedValues then
			configFailedValues[userId] = nil
		end

		local configFailureLogs = lastWriteFailureLogs[configName]
		if configFailureLogs then
			configFailureLogs[userId] = nil
		end
	end
end

local function ensureEntryFrame(cache: LeaderboardBoardCache, rank: number): Frame
	local existingFrame = cache.entryFrames[rank]
	if existingFrame and existingFrame.Parent == cache.scrollingFrame then
		return existingFrame
	end

	local clone = cache.template:Clone()
	clone.Parent = cache.scrollingFrame
	cache.entryFrames[rank] = clone
	return clone
end

local function buildEntriesSignature(entries: { LeaderboardEntryData }, maxEntries: number): string
	local parts = table.create(maxEntries)
	for rank = 1, maxEntries do
		local entry = entries[rank]
		if entry then
			parts[rank] = string.format("%d:%d:%s:%d", entry.rank, entry.userId, entry.username, entry.value)
		else
			parts[rank] = string.format("%d:0:No Data:0", rank)
		end
	end

	return table.concat(parts, "|")
end

local function setAvatarImage(imageObject: GuiObject, userId: number)
	if not (imageObject:IsA("ImageLabel") or imageObject:IsA("ImageButton")) then
		return
	end

	local nextRequestId = (imageObject:GetAttribute("LeaderboardAvatarRequestId") or 0) :: number
	nextRequestId += 1
	imageObject:SetAttribute("LeaderboardAvatarRequestId", nextRequestId)
	imageObject:SetAttribute("LeaderboardAvatarUserId", userId)
	imageObject.Image = ""

	task.spawn(function()
		local success, content = pcall(function()
			return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)

		if not success then
			return
		end

		if not imageObject.Parent then
			return
		end

		local activeRequestId = imageObject:GetAttribute("LeaderboardAvatarRequestId")
		local activeUserId = imageObject:GetAttribute("LeaderboardAvatarUserId")
		if activeRequestId ~= nextRequestId or activeUserId ~= userId then
			return
		end

		imageObject.Image = content
	end)
end

local function populateEntry(entryFrame: Frame, rank: number, userId: number, username: string, value: number)
	entryFrame.Name = "Place_" .. tostring(rank)
	entryFrame.LayoutOrder = rank
	entryFrame.Visible = true
	entryFrame.BackgroundColor3 = getPlaceColor(rank)

	local avatarImage = entryFrame:FindFirstChild("Avatar Image", true)
		or entryFrame:FindFirstChild("AvatarImage", true)
	if avatarImage and (avatarImage:IsA("ImageLabel") or avatarImage:IsA("ImageButton")) then
		if userId > 0 then
			setAvatarImage(avatarImage, userId)
		else
			avatarImage.Image = ""
			avatarImage:SetAttribute(
				"LeaderboardAvatarRequestId",
				(avatarImage:GetAttribute("LeaderboardAvatarRequestId") or 0) + 1
			)
			avatarImage:SetAttribute("LeaderboardAvatarUserId", 0)
		end
	end

	local amountLabel = entryFrame:FindFirstChild("Amount", true)
	if amountLabel and amountLabel:IsA("TextLabel") then
		amountLabel.Text = NumberFormatting.FormatNumber(value)
	end

	local placeLabel = entryFrame:FindFirstChild("Place", true)
	if placeLabel and placeLabel:IsA("TextLabel") then
		placeLabel.Text = tostring(rank)
	end

	local playerLabel = entryFrame:FindFirstChild("PlayerLabel", true)
	if playerLabel and playerLabel:IsA("TextLabel") then
		playerLabel.Text = username
	end
end

local function renderLeaderboard(config: LeaderboardConfig, entries: { LeaderboardEntryData })
	local cache = getBoardCache(config)
	if not cache then
		DebugModule.debugWarn("Leaderboard scrolling frame missing for " .. config.Name, "LeaderboardService")
		return
	end

	local signature = buildEntriesSignature(entries, config.MaxEntries)
	if cache.lastSignature == signature then
		return
	end
	cache.lastSignature = signature

	cache.template.Visible = false

	for rank = 1, config.MaxEntries do
		local clone = ensureEntryFrame(cache, rank)
		local entry = entries[rank]
		if entry then
			populateEntry(clone, entry.rank, entry.userId, entry.username, entry.value)
		else
			populateEntry(clone, rank, 0, "No Data", 0)
		end
	end

	local layout = cache.scrollingFrame:FindFirstChildOfClass("UIListLayout")
	if layout then
		task.defer(function()
			cache.scrollingFrame.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y)
		end)
	end
end

local function fetchEntries(
	config: LeaderboardConfig
): { { rank: number, userId: number, username: string, value: number } }
	if LeaderboardService.DEBUG_USE_FAKE_DATA then
		local fakeEntries = {}
		local topValue = 3.17e15
		local decayFactor = 0.82

		for rank = 1, config.MaxEntries do
			local value = math.max(0, math.floor(topValue * (decayFactor ^ (rank - 1))))

			table.insert(fakeEntries, {
				rank = rank,
				userId = 0,
				username = "FakePlayer" .. tostring(rank),
				value = value,
			})
		end

		return fakeEntries
	end

	local lastError: any = nil
	for attempt = 1, 3 do
		local success, pages = DataStoreRequestGate.Run(
			"OrderedList",
			"LeaderboardGetSortedAsync",
			function()
				return getOrderedStore(config.OrderedStoreName):GetSortedAsync(false, config.MaxEntries)
			end,
			{
				maxWaitSeconds = DATASTORE_BUDGET_WAIT_SECONDS,
				queueKey = LEADERBOARD_REQUEST_QUEUE,
			}
		)
		if success and pages ~= nil then
			local pageSuccess, currentPage = pcall(function()
				return pages:GetCurrentPage()
			end)
			if pageSuccess and typeof(currentPage) == "table" then
				local entries: { LeaderboardEntryData } = {}
				for index, item in ipairs(currentPage) do
					local userId = tonumber(item.key)
					local value = tonumber(item.value) or 0
					if not userId or not isRealLeaderboardUserId(userId) then
						continue
					end

					local username = tostring(userId)
					local nameSuccess, resolvedName = pcall(function()
						return Players:GetNameFromUserIdAsync(userId)
					end)
					if nameSuccess and resolvedName then
						username = resolvedName
					end

					table.insert(entries, {
						rank = index,
						userId = userId,
						username = username,
						value = value,
					})
				end

				if LeaderboardService.DEBUG_APPEND_FAKE_DATA then
					local realEntryCount = #entries
					local lowestRealValue = entries[#entries] and entries[#entries].value or 100
					local fakeStartValue = math.max(0, math.floor(lowestRealValue - 1))
					local rank = realEntryCount + 1

					while rank <= config.MaxEntries do
						local offset = rank - realEntryCount
						local fakeValue = math.max(0, fakeStartValue - offset + 1)
						table.insert(entries, {
							rank = rank,
							userId = 0,
							username = "FakePlayer" .. tostring(offset),
							value = fakeValue,
						})
						rank += 1
					end
				end

				lastSuccessfulEntries[config.Name] = table.clone(entries)
				return entries
			end
			lastError = currentPage
		else
			lastError = pages
		end

		if attempt < 3 then
			task.wait(math.min(8, 2 ^ (attempt - 1)))
		end
	end

	DebugModule.debugWarn(
		"Failed to fetch ordered data for " .. config.Name .. "; using last successful snapshot | err=" .. tostring(lastError),
		"LeaderboardService"
	)
	local cachedEntries = lastSuccessfulEntries[config.Name]
	if cachedEntries then
		return table.clone(cachedEntries)
	end
	return {}
end

local function waitForForcedWrite(configName: string, userId: number, expectedValue: number, playerName: string): boolean
	local deadline = os.clock() + FORCED_WRITE_WAIT_TIMEOUT_SECONDS
	while os.clock() < deadline do
		local lastPublished = lastPublishedValues[configName]
		local pendingValues = pendingWriteValues[configName]
		local failedValues = failedWriteValues[configName]
		if lastPublished and lastPublished[userId] == expectedValue and (not pendingValues or pendingValues[userId] == nil) then
			return true
		end
		if failedValues and failedValues[userId] == expectedValue then
			return false
		end
		task.wait(0.1)
	end

	DebugModule.debugWarn(
		string.format("Leaderboard flush timed out for %s (%s)", playerName, configName),
		"LeaderboardService"
	)
	return false
end

local function writeLeaderboardValue(configName: string, player: Player, forceWrite: boolean)
	local config = LeaderboardService.Configs[configName]
	if not config or (isShuttingDown and not forceWrite) then
		return
	end

	local value = player:GetAttribute(config.AttributeName)
	if typeof(value) ~= "number" then
		return
	end

	local normalizedValue = normalizeOrderedDataStoreValue(value)
	if normalizedValue == nil then
		DebugModule.debugWarn(
			string.format(
				"Skipping leaderboard write for %s (%s): invalid numeric value %s",
				player.Name,
				configName,
				tostring(value)
			),
			"LeaderboardService"
		)
		return
	end

	local userId = player.UserId
	if not isRealLeaderboardUserId(userId) then
		return
	end

	lastPublishedValues[configName] = lastPublishedValues[configName] or {}
	lastWriteTimes[configName] = lastWriteTimes[configName] or {}
	pendingWriteValues[configName] = pendingWriteValues[configName] or {}
	pendingWriteThreads[configName] = pendingWriteThreads[configName] or {}
	forceWriteRequests[configName] = forceWriteRequests[configName] or {}
	failedWriteValues[configName] = failedWriteValues[configName] or {}
	lastWriteFailureLogs[configName] = lastWriteFailureLogs[configName] or {}

	local pendingValues = pendingWriteValues[configName]
	if lastPublishedValues[configName][userId] == normalizedValue and pendingValues[userId] == nil then
		return
	end

	pendingValues[userId] = normalizedValue
	failedWriteValues[configName][userId] = nil
	if forceWrite then
		forceWriteRequests[configName][userId] = true
	end

	if not pendingWriteThreads[configName][userId] then
		pendingWriteThreads[configName][userId] = task.spawn(function()
			local retryDelay = WRITE_RETRY_INITIAL_SECONDS

			while true do
				local latestValue = pendingWriteValues[configName][userId]
				if latestValue == nil then
					break
				end

				local forceRequested = isShuttingDown or forceWriteRequests[configName][userId] == true
				local lastWriteTime = lastWriteTimes[configName][userId] or 0
				local timeUntilAllowed = math.max(0, config.WriteInterval - (os.clock() - lastWriteTime))
				if timeUntilAllowed > 0 and not forceRequested then
					local deadline = os.clock() + timeUntilAllowed
					repeat
						local remaining = deadline - os.clock()
						if remaining <= 0 then
							break
						end
						task.wait(math.min(remaining, 1))
						forceRequested = isShuttingDown or forceWriteRequests[configName][userId] == true
					until forceRequested
				end

				latestValue = pendingWriteValues[configName][userId]
				if latestValue == nil then
					break
				end
				pendingWriteValues[configName][userId] = nil

				local success, err = setOrderedValue(config, userId, latestValue)
				if success then
					lastPublishedValues[configName][userId] = latestValue
					lastWriteTimes[configName][userId] = os.clock()
					failedWriteValues[configName][userId] = nil
					if pendingWriteValues[configName][userId] == nil then
						forceWriteRequests[configName][userId] = nil
					end
					retryDelay = WRITE_RETRY_INITIAL_SECONDS
				else
					if pendingWriteValues[configName][userId] == nil then
						pendingWriteValues[configName][userId] = latestValue
					end
					failedWriteValues[configName][userId] = latestValue

					local now = os.clock()
					local lastFailureLog = lastWriteFailureLogs[configName][userId] or 0
					if now - lastFailureLog >= WRITE_FAILURE_LOG_COOLDOWN_SECONDS or forceRequested then
						lastWriteFailureLogs[configName][userId] = now
						DebugModule.debugWarn(
							string.format(
								"Failed leaderboard update for %s (%s): %s",
								player.Name,
								configName,
								tostring(err)
							),
							"LeaderboardService"
						)
					end

					if isShuttingDown then
						break
					end
					local retryDeadline = os.clock() + retryDelay
					repeat
						local remaining = retryDeadline - os.clock()
						if remaining <= 0 then
							break
						end
						task.wait(math.min(remaining, 1))
					until isShuttingDown
					retryDelay = math.min(retryDelay * 2, WRITE_RETRY_MAX_SECONDS)
				end
			end

			local configThreads = pendingWriteThreads[configName]
			if configThreads and configThreads[userId] == coroutine.running() then
				configThreads[userId] = nil
			end
		end)
	end

	if forceWrite then
		waitForForcedWrite(configName, userId, normalizedValue, player.Name)
	end
end

function LeaderboardService.UpdatePlayerStat(configName: string, player: Player)
	if not RunService:IsServer() then
		return
	end

	writeLeaderboardValue(configName, player, false)
end

function LeaderboardService.FlushPlayer(player: Player)
	if not RunService:IsServer() then
		return
	end

	for configName in pairs(LeaderboardService.Configs) do
		writeLeaderboardValue(configName, player, true)
	end
end

function LeaderboardService.FlushPlayers(playersToFlush: { Player })
	for _, player in ipairs(playersToFlush) do
		LeaderboardService.FlushPlayer(player)
	end
end

function LeaderboardService.RefreshLeaderboard(configName: string)
	local config = LeaderboardService.Configs[configName]
	if not config then
		return
	end

	local entries = fetchEntries(config)
	renderLeaderboard(config, entries)
end

function LeaderboardService.BindPlayer(configName: string, player: Player)
	local config = LeaderboardService.Configs[configName]
	if not config then
		return
	end

	local playerMaid = getPlayerBindingMaid(player)
	playerMaid["AttributeChanged_" .. configName] = player
		:GetAttributeChangedSignal(config.AttributeName)
		:Connect(function()
			LeaderboardService.UpdatePlayerStat(configName, player)
		end)

	playerMaid["InitialSync_" .. configName] = task.defer(function()
		LeaderboardService.UpdatePlayerStat(configName, player)
	end)
end

function LeaderboardService.Init()
	if isInitialized then
		return
	end
	isInitialized = true
	isShuttingDown = false

	serviceMaid["PlayerAdded"] = Players.PlayerAdded:Connect(function(player)
		for configName in pairs(LeaderboardService.Configs) do
			LeaderboardService.BindPlayer(configName, player)
		end
	end)

	serviceMaid["PlayerRemoving"] = Players.PlayerRemoving:Connect(function(player)
		if not isShuttingDown then
			LeaderboardService.FlushPlayer(player)
		end
		clearPlayerBinding(player)
		clearPlayerWriteState(player.UserId)
	end)

	for configName, config in pairs(LeaderboardService.Configs) do
		for _, player in ipairs(Players:GetPlayers()) do
			LeaderboardService.BindPlayer(configName, player)
		end

		serviceMaid["RefreshLoop_" .. configName] = task.spawn(function()
			local alive = true
			while alive and not isShuttingDown do
				LeaderboardService.RefreshLeaderboard(configName)

				local refreshDeadline = os.clock() + config.RefreshInterval
				repeat
					local remaining = refreshDeadline - os.clock()
					if remaining <= 0 then
						break
					end
					task.wait(math.min(remaining, 1))
				until not alive or isShuttingDown
			end
		end)

		task.defer(function()
			LeaderboardService.RefreshLeaderboard(configName)
		end)
	end

	game:BindToClose(function()
		LeaderboardService.Shutdown()
	end)
end

function LeaderboardService.Shutdown()
	if isShuttingDown then
		return
	end

	isShuttingDown = true
	-- Leaderboards are derived data; avoid a shutdown-wide ordered-write burst.
	-- Player profile persistence owns the critical shutdown save path.
	serviceMaid:DoCleaning()
	isInitialized = false
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3750">
        <Properties>
          <string name="Name">LevelingService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local SystemChatService =
	require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("SystemChatService_Server"))
local VerifyRewardCalculator =
	require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("VerifyRewardCalculator_Server"))
local FunnelAnalytics =
	require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("FunnelAnalytics_Server"))
local Maid = require(Modules:WaitForChild("Maid"))
local ValidationService = require(script.Parent:WaitForChild("ValidationService"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))
local WorldSpawnService = require(SharedFolder:WaitForChild("WorldSpawnService_Server"))
local EconomyAnalytics = require(script.Parent:WaitForChild("EconomyAnalytics"))

local LevelingService = {}

-- CONFIG
local MODULE_NAME = "LevelingService"
local isInitialized = false
local serviceMaid = Maid.new()
local levelingConfig = CoreConfig.leveling
local verifyRewardConfig = VerifyRewardCalculator.GetConfig(CoreConfig)
local VERIFY_GROUP_ID = if CoreConfig.social and typeof(CoreConfig.social.verifyGroupId) == "number"
	then CoreConfig.social.verifyGroupId
	else 13706307
local VERIFY_REWARD_COOLDOWN_SECONDS = if levelingConfig
		and typeof(levelingConfig.verifyRewardCooldownSeconds) == "number"
	then math.max(0, levelingConfig.verifyRewardCooldownSeconds)
	else 24 * 60 * 60
local VERIFY_REWARD_NEXT_CLAIM_ATTRIBUTE = "VerifyRewardNextClaimUnix"
local VERIFY_DEBUG_IGNORE_COOLDOWN_IN_STUDIO = RunService:IsStudio()
	and levelingConfig
	and levelingConfig.debugVerifyIgnoreCooldownInStudio == true
local REBIRTH_CONFETTI_COLORS = if levelingConfig
		and typeof(levelingConfig.rebirthConfettiColors) == "table"
		and #levelingConfig.rebirthConfettiColors > 0
	then levelingConfig.rebirthConfettiColors
	else {
		Color3.fromRGB(255, 215, 0),
		Color3.fromRGB(255, 43, 43),
		Color3.fromRGB(0, 200, 255),
		Color3.fromRGB(57, 255, 20),
		Color3.fromRGB(170, 0, 255),
	}
local REBIRTH_CONFETTI_DURATION = if levelingConfig
		and typeof(levelingConfig.rebirthConfettiDuration) == "number"
	then levelingConfig.rebirthConfettiDuration
	else 1.5
local REBIRTH_CONFETTI_COUNT = if levelingConfig and typeof(levelingConfig.rebirthConfettiCount) == "number"
	then math.max(1, math.floor(levelingConfig.rebirthConfettiCount))
	else 70
local analyticsConfig = if CoreConfig.analytics then CoreConfig.analytics else nil
local analyticsFunnels = if analyticsConfig and typeof(analyticsConfig.funnels) == "table"
	then analyticsConfig.funnels
	else nil
local VERIFY_REWARD_FUNNEL_NAME = if analyticsFunnels and typeof(analyticsFunnels.verifyReward) == "string"
	then analyticsFunnels.verifyReward
	else "VerifyRewardClaim"
local REBIRTH_FUNNEL_NAME = if analyticsFunnels and typeof(analyticsFunnels.rebirth) == "string"
	then analyticsFunnels.rebirth
	else "RebirthFlow"

-- REMOTES
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local MovementAction = Remotes:WaitForChild("MovementAction") :: RemoteEvent
local RebirthAction = Remotes:WaitForChild("RebirthAction") :: RemoteEvent
local XPGainAwarded = Remotes:WaitForChild("XPGainAwarded") :: RemoteEvent
local VerifyRewardRequest = Remotes:WaitForChild("VerifyRewardRequest") :: RemoteEvent
local VerifyRewardResult = Remotes:WaitForChild("VerifyRewardResult") :: RemoteEvent
local PlayConfettiBurst = Remotes:WaitForChild("PlayConfettiBurst") :: RemoteEvent
local RebirthResult = Remotes:WaitForChild("RebirthResult") :: RemoteEvent
local ShowNotification = Remotes:WaitForChild("ShowNotification") :: RemoteEvent

-- STATE
local lastMovementTime: { [Player]: number } = {}
local trackedHumanoids: { [Player]: Humanoid } = {}
local verifyRewardInFlight: { [Player]: boolean } = {}
local studioVerifyDataLoadedConnections: { [Player]: RBXScriptConnection } = {}
local verifyRewardFunnelSessions: { [Player]: string } = {}
local rebirthFunnelSessions: { [Player]: string } = {}

local function startVerifyRewardFunnel(player: Player): string?
	local nextClaimCount = player:GetAttribute("VerifyRewardClaimCount")
	if typeof(nextClaimCount) ~= "number" then
		nextClaimCount = 0
	end

	local sessionId =
		FunnelAnalytics.OpenRecurringFunnel(player, VERIFY_REWARD_FUNNEL_NAME, "Verify Reward Requested", {
			customField01 = tostring(nextClaimCount + 1),
		})
	verifyRewardFunnelSessions[player] = sessionId or ""
	return sessionId
end

local function getOrStartRebirthFunnelSession(player: Player, isPurchase: boolean): string?
	local existingSessionId = rebirthFunnelSessions[player]
	if typeof(existingSessionId) == "string" and existingSessionId ~= "" then
		return existingSessionId
	end

	local nextRebirthCount = player:GetAttribute("Rebirths")
	if typeof(nextRebirthCount) ~= "number" then
		nextRebirthCount = 0
	end

	local sessionId = FunnelAnalytics.OpenRecurringFunnel(player, REBIRTH_FUNNEL_NAME, "Rebirth Started", {
		customField01 = tostring(nextRebirthCount + 1),
		customField02 = if isPurchase then "Purchased" else "Normal",
	})
	if sessionId then
		rebirthFunnelSessions[player] = sessionId
	end

	return sessionId
end

local function getVerifyRewardNextClaimUnix(player: Player): number
	local rawValue = player:GetAttribute(VERIFY_REWARD_NEXT_CLAIM_ATTRIBUTE)
	if typeof(rawValue) ~= "number" then
		return 0
	end

	local nextClaimUnix = math.max(0, math.floor(rawValue))
	if nextClaimUnix <= 0 then
		return 0
	end

	if VERIFY_DEBUG_IGNORE_COOLDOWN_IN_STUDIO then
		player:SetAttribute(VERIFY_REWARD_NEXT_CLAIM_ATTRIBUTE, 0)
		return 0
	end

	local maxNextClaimUnix = os.time() + VERIFY_REWARD_COOLDOWN_SECONDS
	if VERIFY_REWARD_COOLDOWN_SECONDS >= 0 and nextClaimUnix > maxNextClaimUnix then
		player:SetAttribute(VERIFY_REWARD_NEXT_CLAIM_ATTRIBUTE, maxNextClaimUnix)
		return maxNextClaimUnix
	end

	return nextClaimUnix
end

local function clearVerifyCooldownForStudioDebug(player: Player)
	if not VERIFY_DEBUG_IGNORE_COOLDOWN_IN_STUDIO then
		return
	end

	local currentNextClaim = getVerifyRewardNextClaimUnix(player)
	if currentNextClaim ~= 0 then
		player:SetAttribute(VERIFY_REWARD_NEXT_CLAIM_ATTRIBUTE, 0)
	end
end

local function bindStudioVerifyCooldownReset(player: Player)
	if not VERIFY_DEBUG_IGNORE_COOLDOWN_IN_STUDIO then
		return
	end

	local existingConnection = studioVerifyDataLoadedConnections[player]
	if existingConnection then
		existingConnection:Disconnect()
		studioVerifyDataLoadedConnections[player] = nil
	end

	local function tryResetCooldown()
		if player:GetAttribute("Data_Loaded") == true then
			clearVerifyCooldownForStudioDebug(player)
		end
	end

	tryResetCooldown()
	local dataLoadedConnection = player:GetAttributeChangedSignal("Data_Loaded"):Connect(tryResetCooldown)
	studioVerifyDataLoadedConnections[player] = dataLoadedConnection
end

local function playRebirthConfetti(player: Player)
	PlayConfettiBurst:FireClient(player, REBIRTH_CONFETTI_COLORS, REBIRTH_CONFETTI_DURATION, REBIRTH_CONFETTI_COUNT)
end

local function isPointInsidePart(part: BasePart, point: Vector3): boolean
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local halfSize = part.Size * 0.5
	return math.abs(localPoint.X) <= halfSize.X
		and math.abs(localPoint.Y) <= halfSize.Y
		and math.abs(localPoint.Z) <= halfSize.Z
end

local function findLobbyRegionPart(world: Instance?): BasePart?
	if not world then
		return nil
	end
	local lobbyRegionContainer = world:FindFirstChild("LobbyRegion_Model")
	if lobbyRegionContainer then
		local nestedLobbyRegion = lobbyRegionContainer:FindFirstChild("LobbyRegion", true)
		if nestedLobbyRegion and nestedLobbyRegion:IsA("BasePart") then
			return nestedLobbyRegion
		end
	end
	return nil
end

local function isPlayerInsideWorld1Lobby(player: Player): boolean
	if player:GetAttribute("Current_World") ~= "World1" then
		return false
	end
	local character = player.Character
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local worldsFolder = workspace:FindFirstChild("Worlds")
	local world1 = worldsFolder and worldsFolder:FindFirstChild("World1")
	local lobbyRegion = findLobbyRegionPart(world1)
	if not lobbyRegion then
		return false
	end

	return isPointInsidePart(lobbyRegion, rootPart.Position)
end

local function sendPlayerToWorld1Spawn(player: Player)
	player:SetAttribute("Current_World", "World1")
	player:SetAttribute("CurrentStage", 0)
	player:SetAttribute("Treadmill_Active", false)

	local character = player.Character
	if not character then
		return
	end

	local spawnLocation = WorldSpawnService.Get("World1")
	if spawnLocation then
		character:PivotTo(spawnLocation:GetPivot() * CFrame.new(0, 3, 0))
		ValidationService.MarkServerTeleport(player)
	end
end

function LevelingService.IsPlayerInsideWorld1Lobby(player: Player): boolean
	return isPlayerInsideWorld1Lobby(player)
end

function LevelingService.SendPlayerToWorld1Spawn(player: Player)
	sendPlayerToWorld1Spawn(player)
end

function LevelingService.OnMovementAction(player: Player)
	local humanoid = trackedHumanoids[player]
	if not humanoid or humanoid.Health <= 0 then
		return
	end
	if player:GetAttribute("Treadmill_Active") == true then
		return
	end
	if not ValidationService.ValidateRewardEligibility(player, "MovementXP") then
		return
	end

	local now = os.clock()
	local lastTime = lastMovementTime[player] or 0
	local interval = PlayerHandler.GetMovementInterval(player)
	local tolerance = PlayerHandler.MOVEMENT_CONFIG.XP_GAIN_TOLERANCE

	if now >= lastTime + interval - tolerance then
		lastMovementTime[player] = math.max(now, lastTime + interval)
		local awardedAmount = PlayerHandler.AddXPSpeed(player, PlayerHandler.GetMovementGain(player))
		XPGainAwarded:FireClient(player, awardedAmount)
	end
end

function LevelingService.PerformRebirth(player: Player, isPurchase: boolean)
	local success = PlayerHandler.PerformRebirth(player, isPurchase)
	if success then
		local rebirthSessionId = getOrStartRebirthFunnelSession(player, isPurchase)
		if not isPlayerInsideWorld1Lobby(player) then
			sendPlayerToWorld1Spawn(player)
		end

		local rebirths = player:GetAttribute("Rebirths") or 0
		RebirthResult:FireClient(player)
		playRebirthConfetti(player)
		SystemChatService.BroadcastLocalRebirth(player, rebirths)
		if rebirthSessionId then
			FunnelAnalytics.LogRecurringStep(player, REBIRTH_FUNNEL_NAME, rebirthSessionId, 2, "Rebirth Completed", {
				customField01 = tostring(rebirths),
				customField02 = if isPurchase then "Purchased" else "Normal",
			})
			rebirthFunnelSessions[player] = nil
		end
		DebugModule.debugInfo(
			string.format("Player %s rebirthed (Purchase: %s)", player.Name, tostring(isPurchase)),
			MODULE_NAME
		)
		return true
	end

	rebirthFunnelSessions[player] = nil
	if not isPurchase then
		ShowNotification:FireClient(player, "MAX LEVEL REQUIRED!", "Red")
	end
	return false
end

function LevelingService.OnRebirthRequest(player: Player)
	local currentLevel = player:GetAttribute("CurrentLevel") or 1
	local maxLevel = player:GetAttribute("MaxLevel") or 25

	if currentLevel >= maxLevel then
		getOrStartRebirthFunnelSession(player, false)
		LevelingService.PerformRebirth(player, false)
	else
		ShowNotification:FireClient(player, "MAX LEVEL REQUIRED!", "Red")
	end
end

function LevelingService.OnVerifyRewardRequest(player: Player)
	if verifyRewardInFlight[player] == true then
		DebugModule.debugInfo("Verify reward request ignored (in flight) for " .. player.Name, MODULE_NAME)
		return
	end

	if player:GetAttribute("Data_Loaded") ~= true then
		local verifyRewardSessionId = startVerifyRewardFunnel(player)
		if verifyRewardSessionId then
			FunnelAnalytics.LogRecurringStep(
				player,
				VERIFY_REWARD_FUNNEL_NAME,
				verifyRewardSessionId,
				2,
				"Verify Data Not Loaded"
			)
			verifyRewardFunnelSessions[player] = nil
		end
		VerifyRewardResult:FireClient(player, false, getVerifyRewardNextClaimUnix(player))
		return
	end

	if not ValidationService.ValidateRewardEligibility(player, "VerifyReward") then
		VerifyRewardResult:FireClient(player, false, getVerifyRewardNextClaimUnix(player))
		return
	end

	if VERIFY_DEBUG_IGNORE_COOLDOWN_IN_STUDIO then
		clearVerifyCooldownForStudioDebug(player)
	else
		local requestUnix = os.time()
		local requestNextClaimUnix = getVerifyRewardNextClaimUnix(player)
		if requestNextClaimUnix > requestUnix then
			local verifyRewardSessionId = startVerifyRewardFunnel(player)
			if verifyRewardSessionId then
				FunnelAnalytics.LogRecurringStep(
					player,
					VERIFY_REWARD_FUNNEL_NAME,
					verifyRewardSessionId,
					2,
					"Verify Reward Cooldown"
				)
				verifyRewardFunnelSessions[player] = nil
			end
			VerifyRewardResult:FireClient(player, false, requestNextClaimUnix)
			return
		end
	end

	verifyRewardInFlight[player] = true
	local verifyRewardSessionId = startVerifyRewardFunnel(player)

	local function releaseVerifyRewardLock()
		verifyRewardInFlight[player] = nil
	end

	local success, inGroup = pcall(function()
		return player:IsInGroupAsync(VERIFY_GROUP_ID)
	end)

	if not success or not inGroup then
		if verifyRewardSessionId then
			FunnelAnalytics.LogRecurringStep(
				player,
				VERIFY_REWARD_FUNNEL_NAME,
				verifyRewardSessionId,
				2,
				"Verify Group Missing"
			)
		end
		verifyRewardFunnelSessions[player] = nil
		releaseVerifyRewardLock()
		VerifyRewardResult:FireClient(player, false, getVerifyRewardNextClaimUnix(player))
		return
	end

	if verifyRewardSessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			VERIFY_REWARD_FUNNEL_NAME,
			verifyRewardSessionId,
			2,
			"Verify Group Membership"
		)
	end

	local nowUnix = os.time()
	if not VERIFY_DEBUG_IGNORE_COOLDOWN_IN_STUDIO then
		local nextClaimUnix = getVerifyRewardNextClaimUnix(player)
		if nextClaimUnix > nowUnix then
			if verifyRewardSessionId then
				FunnelAnalytics.LogRecurringStep(
					player,
					VERIFY_REWARD_FUNNEL_NAME,
					verifyRewardSessionId,
					3,
					"Verify Reward Cooldown"
				)
			end
			verifyRewardFunnelSessions[player] = nil
			releaseVerifyRewardLock()
			VerifyRewardResult:FireClient(player, false, nextClaimUnix)
			return
		end
	end

	local awardedXP = 0
	local awardedWins = 0
	local grantSuccess, grantErr = pcall(function()
		local rewardPreview = VerifyRewardCalculator.ComputeRewardsForNextClaim(player, verifyRewardConfig)
		awardedXP = PlayerHandler.AddExactXPSpeed(player, rewardPreview.xpAward)

		local currentWins = player:GetAttribute("WinCount") or 0
		PlayerHandler.SetAttribute(player, "WinCount", currentWins + rewardPreview.winsAward)
		awardedWins = rewardPreview.winsAward
	end)
	if not grantSuccess then
		if verifyRewardSessionId then
			FunnelAnalytics.LogRecurringStep(
				player,
				VERIFY_REWARD_FUNNEL_NAME,
				verifyRewardSessionId,
				3,
				"Verify Reward Grant Failed"
			)
		end
		verifyRewardFunnelSessions[player] = nil
		releaseVerifyRewardLock()
		DebugModule.debugWarn(
			"Verify reward grant failed for " .. player.Name .. ": " .. tostring(grantErr),
			MODULE_NAME
		)
		VerifyRewardResult:FireClient(player, false, getVerifyRewardNextClaimUnix(player))
		return
	end

	local updatedNextClaimUnix = if VERIFY_DEBUG_IGNORE_COOLDOWN_IN_STUDIO
		then 0
		else nowUnix + VERIFY_REWARD_COOLDOWN_SECONDS
	player:SetAttribute("VerifyRewardClaimed", true)
	player:SetAttribute(VERIFY_REWARD_NEXT_CLAIM_ATTRIBUTE, updatedNextClaimUnix)
	VerifyRewardCalculator.AdvanceClaimCount(player, verifyRewardConfig)

	XPGainAwarded:FireClient(player, awardedXP)
	EconomyAnalytics.LogSource(
		player,
		"XPSpeed",
		awardedXP,
		Enum.AnalyticsEconomyTransactionType.TimedReward.Name,
		"VerifyReward",
		{ customField01 = tostring(player:GetAttribute("VerifyRewardClaimCount") or 0) }
	)
	EconomyAnalytics.LogSource(
		player,
		"Wins",
		awardedWins,
		Enum.AnalyticsEconomyTransactionType.TimedReward.Name,
		"VerifyReward",
		{ customField01 = tostring(player:GetAttribute("VerifyRewardClaimCount") or 0) }
	)
	local winRemote = Remotes:FindFirstChild("WinButtonPressed")
	if winRemote and winRemote:IsA("RemoteEvent") then
		winRemote:FireClient(player, awardedWins, "VerifyReward")
	end

	if verifyRewardSessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			VERIFY_REWARD_FUNNEL_NAME,
			verifyRewardSessionId,
			3,
			"Verify Reward Granted",
			{
				customField01 = tostring(player:GetAttribute("VerifyRewardClaimCount") or 0),
			}
		)
	end

	releaseVerifyRewardLock()
	verifyRewardFunnelSessions[player] = nil
	VerifyRewardResult:FireClient(player, true, updatedNextClaimUnix)
end

function LevelingService.TrackHumanoid(player: Player, humanoid: Humanoid?)
	trackedHumanoids[player] = humanoid
	if not humanoid then
		lastMovementTime[player] = 0
	end
end

function LevelingService.OnPlayerAdded(player: Player)
	getVerifyRewardNextClaimUnix(player)
end

function LevelingService.CleanupPlayer(player: Player)
	lastMovementTime[player] = nil
	trackedHumanoids[player] = nil
	verifyRewardInFlight[player] = nil
	verifyRewardFunnelSessions[player] = nil
	rebirthFunnelSessions[player] = nil
	local dataLoadedConnection = studioVerifyDataLoadedConnections[player]
	if dataLoadedConnection then
		dataLoadedConnection:Disconnect()
		studioVerifyDataLoadedConnections[player] = nil
	end
end

function LevelingService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	serviceMaid.MovementAction = MovementAction.OnServerEvent:Connect(LevelingService.OnMovementAction)
	serviceMaid.RebirthAction = RebirthAction.OnServerEvent:Connect(LevelingService.OnRebirthRequest)
	serviceMaid.VerifyRewardRequest = VerifyRewardRequest.OnServerEvent:Connect(LevelingService.OnVerifyRewardRequest)
	if VERIFY_DEBUG_IGNORE_COOLDOWN_IN_STUDIO then
		for _, player in ipairs(Players:GetPlayers()) do
			bindStudioVerifyCooldownReset(player)
		end
		serviceMaid.PlayerAdded = Players.PlayerAdded:Connect(bindStudioVerifyCooldownReset)
	end
	DebugModule.debugInfo("LevelingService Initialized", MODULE_NAME)
end

function LevelingService.Shutdown()
	for player, connection in pairs(table.clone(studioVerifyDataLoadedConnections)) do
		connection:Disconnect()
		studioVerifyDataLoadedConnections[player] = nil
	end
	serviceMaid:DoCleaning()
	isInitialized = false
end

return LevelingService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3751">
        <Properties>
          <string name="Name">LiveEventSchedule</string>
          <string name="Source"><![CDATA[local LiveEventSchedule = {}

type ScheduleDefinition = {
	kind: string?,
	startUnix: number?,
	endUnix: number?,
	cycleStartUnix: number?,
	firstCyclePreEventCountdownStartUnix: number?,
	firstCycleStartsActive: boolean?,
	activeDurationSeconds: number?,
	graceDurationSeconds: number?,
	activeDurationMinSeconds: number?,
	activeDurationMaxSeconds: number?,
	graceDurationMinSeconds: number?,
	graceDurationMaxSeconds: number?,
	randomStepSeconds: number?,
	randomSeed: number?,
}

type DurationRange = {
	minimum: number,
	maximum: number,
}

type RecurringDefinitionValues = {
	firstActiveStartUnix: number,
	activeDurationRange: DurationRange,
	graceDurationRange: DurationRange,
	randomStepSeconds: number,
	randomSeed: number,
}

type RecurringWindow = {
	cycleIndex: number,
	activeStartUnix: number,
	activeDuration: number,
	graceDuration: number,
	nextActiveStartUnix: number,
}

type RecurringWindowCache = RecurringDefinitionValues & RecurringWindow

local recurringWindowCaches: { [any]: RecurringWindowCache } = {}
local DETERMINISTIC_MODULUS = 2147483647
local MAX_CYCLE_SEARCH = 100000

local function normalizeDuration(value: any): number?
	if typeof(value) ~= "number" or value ~= value or value == math.huge or value == -math.huge then
		return nil
	end

	return math.max(1, math.floor(value))
end

local function resolveDurationRange(minimumValue: any, maximumValue: any, fixedValue: any): DurationRange?
	local minimum = normalizeDuration(minimumValue) or normalizeDuration(fixedValue)
	local maximum = normalizeDuration(maximumValue) or minimum
	if minimum == nil or maximum == nil then
		return nil
	end

	if maximum < minimum then
		minimum, maximum = maximum, minimum
	end

	return {
		minimum = minimum,
		maximum = maximum,
	}
end

local function getDeterministicDuration(
	range: DurationRange,
	cycleIndex: number,
	seed: number,
	salt: number,
	stepSeconds: number
): number
	if range.minimum == range.maximum then
		return range.minimum
	end

	local step = math.max(1, math.floor(stepSeconds))
	local span = math.floor((range.maximum - range.minimum) / step) + 1
	local rawValue = (math.floor(seed) + cycleIndex * 1103515245 + salt * 12345) % DETERMINISTIC_MODULUS
	return range.minimum + (rawValue % span) * step
end

local function createRecurringWindow(
	values: RecurringDefinitionValues,
	cycleIndex: number,
	activeStartUnix: number
): RecurringWindowCache
	local activeDuration = getDeterministicDuration(
		values.activeDurationRange,
		cycleIndex,
		values.randomSeed,
		17,
		values.randomStepSeconds
	)
	local graceDuration =
		getDeterministicDuration(values.graceDurationRange, cycleIndex, values.randomSeed, 31, values.randomStepSeconds)

	return {
		firstActiveStartUnix = values.firstActiveStartUnix,
		activeDurationRange = values.activeDurationRange,
		graceDurationRange = values.graceDurationRange,
		randomStepSeconds = values.randomStepSeconds,
		randomSeed = values.randomSeed,
		cycleIndex = cycleIndex,
		activeStartUnix = activeStartUnix,
		activeDuration = activeDuration,
		graceDuration = graceDuration,
		nextActiveStartUnix = activeStartUnix + activeDuration + graceDuration,
	}
end

local function matchesRecurringDefinition(cache: RecurringWindowCache, values: RecurringDefinitionValues): boolean
	return cache.firstActiveStartUnix == values.firstActiveStartUnix
		and cache.activeDurationRange.minimum == values.activeDurationRange.minimum
		and cache.activeDurationRange.maximum == values.activeDurationRange.maximum
		and cache.graceDurationRange.minimum == values.graceDurationRange.minimum
		and cache.graceDurationRange.maximum == values.graceDurationRange.maximum
		and cache.randomStepSeconds == values.randomStepSeconds
		and cache.randomSeed == values.randomSeed
end

local function getUniversalDate(timestamp: number): { [string]: number }
	return os.date("!*t", timestamp)
end

local function getNthWeekdayOfMonth(year: number, month: number, weekday: number, occurrence: number): number
	local firstDayWeekday = getUniversalDate(DateTime.fromUniversalTime(year, month, 1).UnixTimestamp).wday
	local offset = (weekday - firstDayWeekday) % 7
	return 1 + offset + (occurrence - 1) * 7
end

local function isPacificDaylightTime(timestamp: number): boolean
	local year = getUniversalDate(timestamp).year
	local dstStartDay = getNthWeekdayOfMonth(year, 3, 1, 2)
	local dstEndDay = getNthWeekdayOfMonth(year, 11, 1, 1)
	local dstStart = DateTime.fromUniversalTime(year, 3, dstStartDay, 10).UnixTimestamp
	local dstEnd = DateTime.fromUniversalTime(year, 11, dstEndDay, 9).UnixTimestamp

	return timestamp >= dstStart and timestamp < dstEnd
end

local function isWeekendTokyoToPacific(timestamp: number): boolean
	local tokyoWeekday = getUniversalDate(timestamp + 9 * 60 * 60).wday
	if tokyoWeekday == 7 or tokyoWeekday == 1 then
		return true
	end

	-- Monday in Tokyo can still be Sunday in Pacific Time. Account for DST.
	if tokyoWeekday == 2 then
		local pacificOffset = if isPacificDaylightTime(timestamp) then -7 * 60 * 60 else -8 * 60 * 60
		return getUniversalDate(timestamp + pacificOffset).wday == 1
	end

	return false
end

local function getPacificOffset(timestamp: number): number
	return if isPacificDaylightTime(timestamp) then -7 * 60 * 60 else -8 * 60 * 60
end

local function getNextPacificMondayMidnight(timestamp: number): number
	local pacificOffset = getPacificOffset(timestamp)
	local pacificDate = getUniversalDate(timestamp + pacificOffset)
	local daysUntilMonday = (2 - pacificDate.wday) % 7
	if daysUntilMonday == 0 then
		daysUntilMonday = 7
	end

	local localMidnight = DateTime.fromUniversalTime(pacificDate.year, pacificDate.month, pacificDate.day).UnixTimestamp
	local targetLocalMidnight = localMidnight + daysUntilMonday * 24 * 60 * 60
	local candidateTimestamp = targetLocalMidnight - pacificOffset
	return targetLocalMidnight - getPacificOffset(candidateTimestamp)
end

local function getNextTokyoSaturdayMidnight(timestamp: number): number
	local tokyoDate = getUniversalDate(timestamp + 9 * 60 * 60)
	local daysUntilSaturday = (7 - tokyoDate.wday) % 7
	local localMidnight = DateTime.fromUniversalTime(tokyoDate.year, tokyoDate.month, tokyoDate.day).UnixTimestamp
	local candidateTimestamp = localMidnight + daysUntilSaturday * 24 * 60 * 60 - 9 * 60 * 60
	if candidateTimestamp <= timestamp then
		candidateTimestamp += 7 * 24 * 60 * 60
	end

	return candidateTimestamp
end

local function getRecurringDefinitionValues(definition: ScheduleDefinition): RecurringDefinitionValues?
	local cycleStartUnix = definition.cycleStartUnix
	if typeof(cycleStartUnix) ~= "number" or cycleStartUnix <= 0 then
		return nil
	end

	local activeDurationRange = resolveDurationRange(
		definition.activeDurationMinSeconds,
		definition.activeDurationMaxSeconds,
		definition.activeDurationSeconds
	)
	local graceDurationRange = resolveDurationRange(
		definition.graceDurationMinSeconds,
		definition.graceDurationMaxSeconds,
		definition.graceDurationSeconds
	)
	if not activeDurationRange or not graceDurationRange then
		return nil
	end

	local randomSeed = normalizeDuration(definition.randomSeed) or 0
	local randomStepSeconds = normalizeDuration(definition.randomStepSeconds) or 1
	local firstActiveStartUnix = cycleStartUnix
	if definition.firstCycleStartsActive == false then
		firstActiveStartUnix += getDeterministicDuration(graceDurationRange, 0, randomSeed, 31, randomStepSeconds)
	end

	return {
		firstActiveStartUnix = firstActiveStartUnix,
		activeDurationRange = activeDurationRange,
		graceDurationRange = graceDurationRange,
		randomStepSeconds = randomStepSeconds,
		randomSeed = randomSeed,
	}
end

local function getRecurringWindowAtTimestamp(definition: ScheduleDefinition, timestamp: number): RecurringWindowCache?
	local values = getRecurringDefinitionValues(definition)
	if not values then
		return nil
	end

	local cache = recurringWindowCaches[definition]
	if not cache or not matchesRecurringDefinition(cache, values) or timestamp < values.firstActiveStartUnix then
		cache = createRecurringWindow(values, 0, values.firstActiveStartUnix)
		recurringWindowCaches[definition] = cache
	end

	if timestamp >= cache.activeStartUnix then
		local averageCycleDuration = (
			values.activeDurationRange.minimum
			+ values.activeDurationRange.maximum
			+ values.graceDurationRange.minimum
			+ values.graceDurationRange.maximum
		) / 2
		local estimatedCycleIndex =
			math.max(cache.cycleIndex, math.floor((timestamp - values.firstActiveStartUnix) / averageCycleDuration))
		if estimatedCycleIndex > cache.cycleIndex then
			for cycleIndex = cache.cycleIndex + 1, math.min(estimatedCycleIndex, MAX_CYCLE_SEARCH) do
				cache = createRecurringWindow(values, cycleIndex, cache.nextActiveStartUnix)
			end
		end
	end

	if cache.activeStartUnix > timestamp then
		cache = createRecurringWindow(values, 0, values.firstActiveStartUnix)
		recurringWindowCaches[definition] = cache
	end

	local searchCount = 0
	while timestamp >= cache.nextActiveStartUnix and searchCount < MAX_CYCLE_SEARCH do
		searchCount += 1
		cache = createRecurringWindow(values, cache.cycleIndex + 1, cache.nextActiveStartUnix)
	end

	recurringWindowCaches[definition] = cache
	return cache
end

function LiveEventSchedule.IsActive(schedule: any, timestamp: number): boolean
	if typeof(schedule) ~= "table" then
		return false
	end

	local definition = schedule :: ScheduleDefinition
	if definition.kind == "WeekendTokyoToPacific" then
		return isWeekendTokyoToPacific(timestamp)
	end
	if definition.kind == "AbsoluteWindow" then
		return typeof(definition.startUnix) == "number"
			and typeof(definition.endUnix) == "number"
			and timestamp >= definition.startUnix
			and timestamp < definition.endUnix
	end
	if definition.kind == "RecurringWindow" then
		local recurringWindow = getRecurringWindowAtTimestamp(definition, timestamp)
		if not recurringWindow then
			return false
		end

		return timestamp >= recurringWindow.activeStartUnix
			and timestamp < recurringWindow.activeStartUnix + recurringWindow.activeDuration
	end

	return false
end

function LiveEventSchedule.GetEndUnix(schedule: any, timestamp: number): number?
	if typeof(schedule) ~= "table" then
		return nil
	end

	local definition = schedule :: ScheduleDefinition
	if definition.kind == "AbsoluteWindow" and typeof(definition.endUnix) == "number" then
		return definition.endUnix
	end
	if definition.kind == "WeekendTokyoToPacific" and isWeekendTokyoToPacific(timestamp) then
		return getNextPacificMondayMidnight(timestamp)
	end
	if definition.kind == "RecurringWindow" then
		local recurringWindow = getRecurringWindowAtTimestamp(definition, timestamp)
		if not recurringWindow then
			return nil
		end
		if timestamp < recurringWindow.activeStartUnix then
			return nil
		end

		return recurringWindow.activeStartUnix + recurringWindow.activeDuration
	end

	return nil
end

function LiveEventSchedule.GetStartUnix(schedule: any, timestamp: number): number?
	if typeof(schedule) ~= "table" then
		return nil
	end

	local definition = schedule :: ScheduleDefinition
	if definition.kind == "AbsoluteWindow" and typeof(definition.startUnix) == "number" then
		return definition.startUnix
	end
	if definition.kind == "WeekendTokyoToPacific" then
		return getNextTokyoSaturdayMidnight(timestamp)
	end
	if definition.kind == "RecurringWindow" then
		local recurringWindow = getRecurringWindowAtTimestamp(definition, timestamp)
		if not recurringWindow then
			return nil
		end
		if timestamp < recurringWindow.activeStartUnix then
			return recurringWindow.activeStartUnix
		end

		if timestamp < recurringWindow.activeStartUnix + recurringWindow.activeDuration then
			return recurringWindow.activeStartUnix
		end

		return recurringWindow.nextActiveStartUnix
	end

	return nil
end

function LiveEventSchedule.GetPreEventCountdownSeconds(
	schedule: any,
	timestamp: number,
	defaultSeconds: number?
): number?
	if typeof(defaultSeconds) ~= "number" then
		return nil
	end
	if typeof(schedule) ~= "table" then
		return defaultSeconds
	end

	local definition = schedule :: ScheduleDefinition
	if definition.kind ~= "RecurringWindow" then
		return defaultSeconds
	end

	local firstCountdownStartUnix = definition.firstCyclePreEventCountdownStartUnix
	if typeof(firstCountdownStartUnix) ~= "number" then
		return defaultSeconds
	end

	local recurringWindow = getRecurringWindowAtTimestamp(definition, timestamp)
	if
		not recurringWindow
		or recurringWindow.cycleIndex ~= 0
		or timestamp < firstCountdownStartUnix
		or timestamp >= recurringWindow.activeStartUnix
	then
		return defaultSeconds
	end

	return math.max(0, recurringWindow.activeStartUnix - firstCountdownStartUnix)
end

return LiveEventSchedule
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3752">
        <Properties>
          <string name="Name">LiveEventService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CoreConfig = require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("CoreConfig_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local Maid = require(Modules:WaitForChild("Maid"))
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local LiveEventSchedule = require(script.Parent:WaitForChild("LiveEventSchedule"))

local LiveEventService = {}

type LiveEventEffects = {
	xpMultiplier: number?,
	winButtonMultiplier: number?,
	walkSpeedMultiplier: number?,
}

type LiveEventUnlock = {
	id: string?,
	displayName: string?,
	winsRequired: number?,
	kind: string?,
	imageAssetId: string?,
}

type LiveEventProgressUi = {
	backgroundColor: Color3?,
	gradientColor: Color3?,
	infoText: string?,
	winsAttribute: string?,
	maxWins: number?,
	showUnlocks: boolean?,
	unlocks: { LiveEventUnlock }?,
}

type LiveEventBlockUi = {
	billboardText: string?,
	infoText: string?,
	textColor: Color3?,
	gradientColor: Color3?,
}

type LiveEventDefinition = {
	id: string?,
	eventTier: "Major" | "Minor"?,
	enabled: boolean?,
	priority: number?,
	displayText: string?,
	displayColor: Color3?,
	winPopupImageAssetId: string?,
	startText: string?,
	startSound: string?,
	showCountdown: boolean?,
	environmentName: string?,
	debugStudioEnabled: boolean?,
	debugStudioStartAfterSeconds: number?,
	debugStudioDurationSeconds: number?,
	debugStudioGraceDurationSeconds: number?,
	debugStudioForceActiveAfterSeconds: number?,
	preEventCountdownSeconds: number?,
	eventBlockCountdownSeconds: number?,
	kartWinsAttribute: string?,
	kartRequirementLabel: string?,
	stageWinAwards: { any }?,
	schedule: any,
	effects: LiveEventEffects?,
	progressUi: LiveEventProgressUi?,
	eventBlockUi: LiveEventBlockUi?,
}

type UpcomingEvent = {
	definition: LiveEventDefinition,
	startsAtUnix: number,
}

type EventTier = "Major" | "Minor"

type LiveEventRotationConfig = {
	rotationStartUnix: number,
	randomSeed: number,
	version: string,
	firstEventUsesFullCountdown: boolean,
}

type RotationWindow = {
	definition: LiveEventDefinition,
	sequenceIndex: number,
	activeStartUnix: number,
	activeEndUnix: number,
	nextStartUnix: number,
}

type RotationState = {
	activeWindow: RotationWindow?,
	upcomingWindow: RotationWindow?,
}

type RotationCache = {
	rotationStartUnix: number,
	randomSeed: number,
	version: string,
	window: RotationWindow,
}

local MODULE_NAME = "LiveEventService"
local DEFAULT_REFRESH_INTERVAL = 15
local maid = Maid.new()
local initialized = false
local refreshToken = 0
local initializedAt = 0
local initializedUnixTimestamp = 0
local hasPublishedState = false
local publishedBannerActive = false
local publishedBannerText = ""
local publishedActiveIds = ""
local publishedXPMultiplier = 1
local publishedWinButtonMultiplier = 1
local publishedWalkSpeedMultiplier = 1
local publishedEnvironmentName = "Default"
local publishedUpcomingEvents = ""
local publishedEventBlockEvents = ""
local publishedBloodmoonCycleStartUnix = 0
local publishedBloodmoonNextStartUnix = 0
local studioDebugRandom = Random.new()
local studioDebugSelectedEventId: string? = nil
local studioDebugCycleStartedAt = 0
local liveRotationCache: RotationCache? = nil
local liveRotationWarningShown = false

local ROTATION_HASH_MODULUS = 2147483647
local ROTATION_MAX_ADVANCE_STEPS = 10000

local function getStateFolder(): Folder
	local existing = ReplicatedStorage:FindFirstChild("LiveEventState")
	if existing then
		assert(existing:IsA("Folder"), "ReplicatedStorage.LiveEventState must be a Folder")
		return existing
	end

	local folder = Instance.new("Folder")
	folder.Name = "LiveEventState"
	folder.Parent = ReplicatedStorage
	return folder
end

local stateFolder = getStateFolder()

local function getConfigEvents(): { LiveEventDefinition }
	local liveEventsConfig = CoreConfig.liveEvents
	if typeof(liveEventsConfig) ~= "table" or typeof(liveEventsConfig.events) ~= "table" then
		return {}
	end

	return liveEventsConfig.events :: { LiveEventDefinition }
end

local function getConfiguredStudioDebugEventId(): string?
	if not RunService:IsStudio() then
		return nil
	end

	local liveEventsConfig = CoreConfig.liveEvents
	local debugEventId = if typeof(liveEventsConfig) == "table" then liveEventsConfig.debugStudioEventId else nil
	return if typeof(debugEventId) == "string" and debugEventId ~= "" then debugEventId else nil
end

local function isRandomStudioDebugMode(): boolean
	return getConfiguredStudioDebugEventId() == "Random"
end

local function chooseRandomStudioDebugEvent(eventTier: EventTier?, excludedEventId: string?): string?
	local candidates: { string } = {}
	for _, eventDefinition in ipairs(getConfigEvents()) do
		local matchesTier = eventTier == nil or eventDefinition.eventTier == eventTier
		if
			eventDefinition.enabled ~= false
			and eventDefinition.debugStudioEnabled == true
			and matchesTier
			and typeof(eventDefinition.id) == "string"
			and typeof(eventDefinition.debugStudioDurationSeconds) == "number"
			and eventDefinition.debugStudioDurationSeconds > 0
			and eventDefinition.id ~= excludedEventId
		then
			table.insert(candidates, eventDefinition.id)
		end
	end

	if #candidates == 0 then
		return nil
	end

	return candidates[studioDebugRandom:NextInteger(1, #candidates)]
end

local function getEventTier(eventDefinition: LiveEventDefinition): EventTier?
	if eventDefinition.eventTier == "Major" or eventDefinition.eventTier == "Minor" then
		return eventDefinition.eventTier
	end
	return nil
end

local function getNextEventTier(eventDefinition: LiveEventDefinition): EventTier?
	local eventTier = getEventTier(eventDefinition)
	if eventTier == "Major" then
		return "Minor"
	end
	if eventTier == "Minor" then
		return "Major"
	end
	return nil
end

local function getLiveRotationConfig(): LiveEventRotationConfig?
	if RunService:IsStudio() then
		return nil
	end

	local liveEventsConfig = CoreConfig.liveEvents
	local rotation = if typeof(liveEventsConfig) == "table" then liveEventsConfig.rotation else nil
	if typeof(rotation) ~= "table" or rotation.enabled == false then
		return nil
	end

	local rotationStartUnix = rotation.rotationStartUnix
	if typeof(rotationStartUnix) ~= "number" or rotationStartUnix <= 0 then
		return nil
	end

	local randomSeed = if typeof(rotation.randomSeed) == "number" then rotation.randomSeed else 1
	if randomSeed ~= randomSeed or randomSeed == math.huge or randomSeed == -math.huge then
		randomSeed = 1
	end

	return {
		rotationStartUnix = math.floor(rotationStartUnix),
		randomSeed = math.floor(randomSeed),
		version = if typeof(rotation.version) == "string" and rotation.version ~= ""
			then rotation.version
			else "1",
		firstEventUsesFullCountdown = rotation.firstEventUsesFullCountdown == true,
	}
end

local function getLiveRotationDurations(eventDefinition: LiveEventDefinition): (number?, number?)
	local schedule = eventDefinition.schedule
	if typeof(schedule) ~= "table" or schedule.kind ~= "RecurringWindow" then
		return nil, nil
	end

	local activeDuration = schedule.activeDurationSeconds
	local graceDuration = schedule.graceDurationSeconds
	if
		typeof(activeDuration) ~= "number"
		or activeDuration <= 0
		or activeDuration == math.huge
		or activeDuration == -math.huge
		or typeof(graceDuration) ~= "number"
		or graceDuration < 0
		or graceDuration == math.huge
		or graceDuration == -math.huge
	then
		return nil, nil
	end

	return math.floor(activeDuration), math.floor(graceDuration)
end

local function getLiveRotationCandidates(eventTier: EventTier?): { LiveEventDefinition }
	local candidates: { LiveEventDefinition } = {}
	for _, eventDefinition in ipairs(getConfigEvents()) do
		local eventId = eventDefinition.id
		local candidateTier = getEventTier(eventDefinition)
		local activeDuration, graceDuration = getLiveRotationDurations(eventDefinition)
		if
			eventDefinition.enabled ~= false
			and candidateTier ~= nil
			and (eventTier == nil or candidateTier == eventTier)
			and typeof(eventId) == "string"
			and activeDuration ~= nil
			and graceDuration ~= nil
		then
			table.insert(candidates, eventDefinition)
		end
	end

	table.sort(candidates, function(left, right)
		return (left.id or "") < (right.id or "")
	end)
	return candidates
end

local function chooseLiveRotationEvent(
	eventTier: EventTier?,
	sequenceIndex: number,
	randomSeed: number,
	excludedEventId: string?
): LiveEventDefinition?
	local candidates = getLiveRotationCandidates(eventTier)
	if #candidates == 0 then
		return nil
	end

	local tierSalt = if eventTier == "Major" then 17 elseif eventTier == "Minor" then 31 else 47
	local hash = (
		math.floor(randomSeed)
			+ math.floor(sequenceIndex) * 1103515245
			+ tierSalt * 12345
	) % ROTATION_HASH_MODULUS
	local candidateIndex = (hash % #candidates) + 1
	local candidate = candidates[candidateIndex]
	if #candidates > 1 and candidate.id == excludedEventId then
		candidateIndex = (candidateIndex % #candidates) + 1
		candidate = candidates[candidateIndex]
	end

	return candidate
end

local function createLiveRotationWindow(
	eventDefinition: LiveEventDefinition,
	sequenceIndex: number,
	activeStartUnix: number
): RotationWindow?
	local activeDuration, graceDuration = getLiveRotationDurations(eventDefinition)
	if activeDuration == nil or graceDuration == nil then
		return nil
	end

	local activeEndUnix = activeStartUnix + activeDuration
	return {
		definition = eventDefinition,
		sequenceIndex = sequenceIndex,
		activeStartUnix = activeStartUnix,
		activeEndUnix = activeEndUnix,
		nextStartUnix = activeEndUnix + graceDuration,
	}
end

local function getNextLiveRotationWindow(
	window: RotationWindow,
	rotationConfig: LiveEventRotationConfig
): RotationWindow?
	local nextEventTier = getNextEventTier(window.definition)
	local nextEvent = chooseLiveRotationEvent(
		nextEventTier,
		window.sequenceIndex + 1,
		rotationConfig.randomSeed,
		window.definition.id
	)
	if not nextEvent then
		if not liveRotationWarningShown then
			liveRotationWarningShown = true
			DebugModule.debugWarn(
				"No enabled live rotation event found for tier=" .. tostring(nextEventTier),
				MODULE_NAME
			)
		end
		-- Keep rotation alive if a future tier is temporarily empty.
		nextEvent = chooseLiveRotationEvent(nil, window.sequenceIndex + 1, rotationConfig.randomSeed, nil)
	end
	if not nextEvent then
		return nil
	end

	return createLiveRotationWindow(nextEvent, window.sequenceIndex + 1, window.nextStartUnix)
end

local function getLiveRotationState(timestamp: number): RotationState?
	local rotationConfig = getLiveRotationConfig()
	if not rotationConfig then
		liveRotationCache = nil
		return nil
	end

	local cache = liveRotationCache
	if
		not cache
		or cache.rotationStartUnix ~= rotationConfig.rotationStartUnix
		or cache.randomSeed ~= rotationConfig.randomSeed
		or cache.version ~= rotationConfig.version
	then
		local firstEvent = chooseLiveRotationEvent("Major", 0, rotationConfig.randomSeed, nil)
		local firstWindow = if firstEvent
			then createLiveRotationWindow(firstEvent, 0, rotationConfig.rotationStartUnix)
			else nil
		if not firstWindow then
			if not liveRotationWarningShown then
				liveRotationWarningShown = true
				DebugModule.debugWarn("No enabled live rotation Major event found", MODULE_NAME)
			end
			return nil
		end

		cache = {
			rotationStartUnix = rotationConfig.rotationStartUnix,
			randomSeed = rotationConfig.randomSeed,
			version = rotationConfig.version,
			window = firstWindow,
		}
		liveRotationCache = cache
	end

	if timestamp < cache.window.activeStartUnix then
		return {
			activeWindow = nil,
			upcomingWindow = cache.window,
		}
	end

	local advanceSteps = 0
	while timestamp >= cache.window.nextStartUnix and advanceSteps < ROTATION_MAX_ADVANCE_STEPS do
		local nextWindow = getNextLiveRotationWindow(cache.window, rotationConfig)
		if not nextWindow then
			return nil
		end
		cache.window = nextWindow
		advanceSteps += 1
	end

	if timestamp >= cache.window.nextStartUnix then
		DebugModule.debugWarn("Live rotation exceeded the advance limit", MODULE_NAME)
		return nil
	end

	if timestamp < cache.window.activeEndUnix then
		return {
			activeWindow = cache.window,
			-- Resolve the immediate next window early so the server can publish its
			-- final 24-hour countdown before the active event ends.
			upcomingWindow = getNextLiveRotationWindow(cache.window, rotationConfig),
		}
	end

	return {
		activeWindow = nil,
		upcomingWindow = getNextLiveRotationWindow(cache.window, rotationConfig),
	}
end

local function usesLiveRotation(eventDefinition: LiveEventDefinition): boolean
	return not RunService:IsStudio()
		and getEventTier(eventDefinition) ~= nil
		and getLiveRotationConfig() ~= nil
end

local function getLiveRotationEventStartUnix(eventDefinition: LiveEventDefinition, timestamp: number): number?
	local rotationState = getLiveRotationState(timestamp)
	if not rotationState then
		return nil
	end

	local activeWindow = rotationState.activeWindow
	if activeWindow and activeWindow.definition.id == eventDefinition.id then
		return activeWindow.activeStartUnix
	end

	local upcomingWindow = rotationState.upcomingWindow
	if upcomingWindow and upcomingWindow.definition.id == eventDefinition.id then
		return upcomingWindow.activeStartUnix
	end

	return nil
end

local function getLiveRotationEventEndUnix(eventDefinition: LiveEventDefinition, timestamp: number): number?
	local rotationState = getLiveRotationState(timestamp)
	local activeWindow = rotationState and rotationState.activeWindow
	if activeWindow and activeWindow.definition.id == eventDefinition.id then
		return activeWindow.activeEndUnix
	end

	return nil
end

local function getConfiguredEventDefinition(eventId: string?): LiveEventDefinition?
	if typeof(eventId) ~= "string" then
		return nil
	end

	for _, eventDefinition in ipairs(getConfigEvents()) do
		if eventDefinition.id == eventId then
			return eventDefinition
		end
	end

	return nil
end

local function refreshRandomStudioDebugSelection()
	if not isRandomStudioDebugMode() then
		return
	end

	local now = os.clock()
	if studioDebugSelectedEventId == nil or studioDebugCycleStartedAt <= 0 then
		studioDebugSelectedEventId = chooseRandomStudioDebugEvent("Major", nil)
		if studioDebugSelectedEventId == nil then
			DebugModule.debugWarn("No enabled Studio debug Major event found", MODULE_NAME)
		end
		studioDebugCycleStartedAt = now
		return
	end

	local selectedDefinition = getConfiguredEventDefinition(studioDebugSelectedEventId)
	if not selectedDefinition then
		studioDebugSelectedEventId = chooseRandomStudioDebugEvent("Major", nil)
		studioDebugCycleStartedAt = now
		return
	end

	local startAfter = if typeof(selectedDefinition.debugStudioStartAfterSeconds) == "number"
		then math.max(0, selectedDefinition.debugStudioStartAfterSeconds)
		else 0
	local activeDuration = if typeof(selectedDefinition.debugStudioDurationSeconds) == "number"
		then math.max(0, selectedDefinition.debugStudioDurationSeconds)
		else 0
	local graceDuration = if typeof(selectedDefinition.debugStudioGraceDurationSeconds) == "number"
		then math.max(0, selectedDefinition.debugStudioGraceDurationSeconds)
		else 0

	if now - studioDebugCycleStartedAt >= startAfter + activeDuration then
		local previousEventId = studioDebugSelectedEventId
		local nextEventTier = getNextEventTier(selectedDefinition)
		local nextEventId = chooseRandomStudioDebugEvent(nextEventTier, previousEventId)
		if nextEventId == nil then
			DebugModule.debugWarn(
				"No enabled Studio debug event found for next tier=" .. tostring(nextEventTier),
				MODULE_NAME
			)
			-- Keep the lifecycle alive if a future configuration temporarily has
			-- no opposite-tier event. This fallback may repeat the current event.
			nextEventId = chooseRandomStudioDebugEvent(nil, nil)
		end
		studioDebugSelectedEventId = nextEventId
		-- Pick the next event as soon as the current one ends. Its countdown
		-- must describe the event that will actually start after the gap.
		studioDebugCycleStartedAt = now + graceDuration
	end
end

local function getStudioDebugEventId(): string?
	local configuredEventId = getConfiguredStudioDebugEventId()
	return if configuredEventId == "Random" then studioDebugSelectedEventId else configuredEventId
end

local function getStudioDebugCycleBaseUnix(): number
	if isRandomStudioDebugMode() and studioDebugCycleStartedAt > 0 then
		return initializedUnixTimestamp + math.max(0, studioDebugCycleStartedAt - initializedAt)
	end

	return initializedUnixTimestamp
end

local function applyPlayerMultipliers(
	player: Player,
	xpMultiplier: number,
	winButtonMultiplier: number,
	walkSpeedMultiplier: number
)
	player:SetAttribute("LiveEvent_XPMultiplier", xpMultiplier)
	player:SetAttribute("LiveEvent_WinButtonMultiplier", winButtonMultiplier)
	player:SetAttribute("LiveEvent_WalkSpeedMultiplier", walkSpeedMultiplier)
end

local function getRefreshInterval(): number
	local liveEventsConfig = CoreConfig.liveEvents
	local configuredInterval = if typeof(liveEventsConfig) == "table"
		then liveEventsConfig.refreshIntervalSeconds
		else nil
	if typeof(configuredInterval) == "number" then
		return math.clamp(configuredInterval, 1, 60)
	end

	return DEFAULT_REFRESH_INTERVAL
end

local function isEventActive(eventDefinition: LiveEventDefinition, timestamp: number): boolean
	if
		RunService:IsStudio()
		and eventDefinition.debugStudioEnabled == true
		and typeof(eventDefinition.debugStudioStartAfterSeconds) == "number"
	then
		local debugCycleStart = if isRandomStudioDebugMode() and studioDebugCycleStartedAt > 0
			then studioDebugCycleStartedAt
			else initializedAt
		local elapsed = os.clock() - debugCycleStart
		local startAfter = math.max(0, eventDefinition.debugStudioStartAfterSeconds)
		local duration = eventDefinition.debugStudioDurationSeconds
		if typeof(duration) == "number" then
			local activeDuration = math.max(0, duration)
			local graceDuration = eventDefinition.debugStudioGraceDurationSeconds
			if isRandomStudioDebugMode() then
				return elapsed >= startAfter and elapsed < startAfter + activeDuration
			end
			if typeof(graceDuration) == "number" and activeDuration > 0 then
				local cycleDuration = activeDuration + math.max(0, graceDuration)
				if elapsed < startAfter then
					return false
				end
				return (elapsed - startAfter) % cycleDuration < activeDuration
			end
			return elapsed >= startAfter and elapsed < startAfter + activeDuration
		end
		return elapsed >= startAfter
	end

	local studioDelay = eventDefinition.debugStudioForceActiveAfterSeconds
	if RunService:IsStudio() and eventDefinition.debugStudioEnabled == true and typeof(studioDelay) == "number" then
		return os.clock() - initializedAt >= math.max(0, studioDelay)
	end

	if usesLiveRotation(eventDefinition) then
		local rotationState = getLiveRotationState(timestamp)
		local activeWindow = rotationState and rotationState.activeWindow
		return activeWindow ~= nil and activeWindow.definition.id == eventDefinition.id
	end

	return LiveEventSchedule.IsActive(eventDefinition.schedule, timestamp)
end

local function colorToHex(color: Color3): string
	local red = math.clamp(math.round(color.R * 255), 0, 255)
	local green = math.clamp(math.round(color.G * 255), 0, 255)
	local blue = math.clamp(math.round(color.B * 255), 0, 255)
	return string.format("#%02X%02X%02X", red, green, blue)
end

local function escapeRichText(value: string): string
	local escaped = string.gsub(value, "&", "&amp;")
	escaped = string.gsub(escaped, "<", "&lt;")
	escaped = string.gsub(escaped, ">", "&gt;")
	return escaped
end

local function formatBannerText(activeEvents: { LiveEventDefinition }): string
	local eventTexts: { string } = {}
	for _, eventDefinition in ipairs(activeEvents) do
		local displayText = eventDefinition.displayText
		if typeof(displayText) == "string" and displayText ~= "" then
			local formattedText = escapeRichText(string.upper(displayText))
			local displayColor = eventDefinition.displayColor
			if typeof(displayColor) == "Color3" then
				formattedText = string.format('<font color="%s">%s</font>', colorToHex(displayColor), formattedText)
			end
			table.insert(eventTexts, formattedText)
		end
	end

	return table.concat(eventTexts, " &amp; ")
end

local function normalizeStageWinAwards(rawAwards: any): { [number]: { minimumStage: number, amount: number } }
	local awards: { [number]: { minimumStage: number, amount: number } } = {}
	if typeof(rawAwards) ~= "table" then
		return awards
	end

	for _, rawAward in ipairs(rawAwards) do
		if typeof(rawAward) == "table" then
			local minimumStage = rawAward.minimumStage
			local amount = rawAward.amount
			if
				typeof(minimumStage) == "number"
				and minimumStage == minimumStage
				and minimumStage < math.huge
				and typeof(amount) == "number"
				and amount == amount
				and amount < math.huge
				and minimumStage >= 0
				and amount > 0
			then
				table.insert(awards, {
					minimumStage = math.floor(minimumStage),
					amount = math.floor(amount),
				})
			end
		end
	end

	table.sort(awards, function(left, right)
		return left.minimumStage < right.minimumStage
	end)
	return awards
end

local function formatStageWinAwards(rawAwards: any): string?
	local awards = normalizeStageWinAwards(rawAwards)
	if #awards == 0 then
		return nil
	end

	local descriptions: { string } = {}
	for _, award in ipairs(awards) do
		local winLabel = if award.amount == 1 then "WIN" else "WINS"
		table.insert(descriptions, string.format("STAGE %d: %d %s", award.minimumStage, award.amount, winLabel))
	end

	return table.concat(descriptions, " | ") .. "!"
end

local function serializeStageWinAwards(rawAwards: any): { [number]: { minimumStage: number, amount: number } }?
	local awards = normalizeStageWinAwards(rawAwards)
	return if #awards > 0 then awards else nil
end

local function serializeUnlocks(rawUnlocks: any, maxWins: number): { [number]: { [string]: any } }?
	if typeof(rawUnlocks) ~= "table" then
		return nil
	end

	local unlocks: { [number]: { [string]: any } } = {}
	for _, rawUnlock in ipairs(rawUnlocks) do
		if
			typeof(rawUnlock) == "table"
			and typeof(rawUnlock.id) == "string"
			and rawUnlock.id ~= ""
			and typeof(rawUnlock.displayName) == "string"
			and rawUnlock.displayName ~= ""
			and typeof(rawUnlock.winsRequired) == "number"
			and rawUnlock.winsRequired == rawUnlock.winsRequired
			and rawUnlock.winsRequired < math.huge
			and (rawUnlock.kind == "Trail" or rawUnlock.kind == "Kart")
		then
			local unlock: { [string]: any } = {
				id = rawUnlock.id,
				displayName = rawUnlock.displayName,
				winsRequired = math.clamp(math.floor(rawUnlock.winsRequired), 1, maxWins),
				kind = rawUnlock.kind,
			}
			if typeof(rawUnlock.imageAssetId) == "string" and rawUnlock.imageAssetId ~= "" then
				unlock.imageAssetId = rawUnlock.imageAssetId
			end
			table.insert(unlocks, unlock)
		end
	end

	return if #unlocks > 0 then unlocks else nil
end

local function serializeProgressUi(eventDefinition: LiveEventDefinition): { [string]: any }?
	local progressUi = eventDefinition.progressUi
	local infoText = if typeof(progressUi) == "table" and typeof(progressUi.infoText) == "string"
		and progressUi.infoText ~= ""
		then progressUi.infoText
		else formatStageWinAwards(eventDefinition.stageWinAwards)
	if
		typeof(progressUi) ~= "table"
		or typeof(progressUi.backgroundColor) ~= "Color3"
		or typeof(progressUi.gradientColor) ~= "Color3"
		or typeof(infoText) ~= "string"
		or infoText == ""
	then
		return nil
	end

	local serializedProgressUi: { [string]: any } = {
		backgroundColor = colorToHex(progressUi.backgroundColor),
		gradientColor = colorToHex(progressUi.gradientColor),
		infoText = string.upper(infoText),
	}

	local maxWins = if typeof(progressUi.maxWins) == "number"
		and progressUi.maxWins == progressUi.maxWins
		and progressUi.maxWins < math.huge
		then math.max(1, math.floor(progressUi.maxWins))
		else 100
	local unlocks = serializeUnlocks(progressUi.unlocks, maxWins)
	if unlocks then
		serializedProgressUi.unlocks = unlocks
	end

	if typeof(progressUi.winsAttribute) == "string" and progressUi.winsAttribute ~= "" then
		serializedProgressUi.winsAttribute = progressUi.winsAttribute
	end
	if typeof(progressUi.maxWins) == "number" and progressUi.maxWins == progressUi.maxWins then
		serializedProgressUi.maxWins = math.max(1, math.floor(progressUi.maxWins))
	end
	if typeof(progressUi.showUnlocks) == "boolean" then
		serializedProgressUi.showUnlocks = progressUi.showUnlocks
	end

	return serializedProgressUi
end

local function serializeEventBlockUi(eventDefinition: LiveEventDefinition): { [string]: string }?
	local eventBlockUi = eventDefinition.eventBlockUi
	if
		typeof(eventBlockUi) ~= "table"
		or typeof(eventBlockUi.billboardText) ~= "string"
		or eventBlockUi.billboardText == ""
	then
		return nil
	end

	return {
		billboardText = string.upper(eventBlockUi.billboardText),
		infoText = if typeof(eventBlockUi.infoText) == "string" then string.upper(eventBlockUi.infoText) else "",
		textColor = if typeof(eventBlockUi.textColor) == "Color3" then colorToHex(eventBlockUi.textColor) else "",
		gradientColor = if typeof(eventBlockUi.gradientColor) == "Color3"
			then colorToHex(eventBlockUi.gradientColor)
			else "",
	}
end

local function serializeEventEffects(eventDefinition: LiveEventDefinition): { [string]: number }?
	local effects = eventDefinition.effects
	if not effects then
		return nil
	end

	local serializedEffects: { [string]: number } = {}
	if typeof(effects.xpMultiplier) == "number" then
		serializedEffects.xpMultiplier = effects.xpMultiplier
	end
	if typeof(effects.winButtonMultiplier) == "number" then
		serializedEffects.winButtonMultiplier = effects.winButtonMultiplier
	end
	if typeof(effects.walkSpeedMultiplier) == "number" then
		serializedEffects.walkSpeedMultiplier = effects.walkSpeedMultiplier
	end

	return if next(serializedEffects) == nil then nil else serializedEffects
end

local function getStudioEventEndUnix(eventDefinition: LiveEventDefinition, timestamp: number): number?
	if not RunService:IsStudio() or eventDefinition.debugStudioEnabled ~= true then
		return nil
	end
	local startAfter = eventDefinition.debugStudioStartAfterSeconds
	local duration = eventDefinition.debugStudioDurationSeconds
	if typeof(startAfter) ~= "number" or typeof(duration) ~= "number" then
		return nil
	end

	local startUnix = getStudioDebugCycleBaseUnix() + math.max(0, startAfter)
	local activeDuration = math.max(0, duration)
	local graceDuration = eventDefinition.debugStudioGraceDurationSeconds
	if isRandomStudioDebugMode() then
		return startUnix + activeDuration
	end
	if typeof(graceDuration) ~= "number" or activeDuration <= 0 then
		return startUnix + activeDuration
	end

	local cycleDuration = activeDuration + math.max(0, graceDuration)
	if timestamp < startUnix then
		return startUnix + activeDuration
	end

	local cycleStartUnix = startUnix + math.floor((timestamp - startUnix) / cycleDuration) * cycleDuration
	return cycleStartUnix + activeDuration
end

local function getStudioEventStartUnix(eventDefinition: LiveEventDefinition, timestamp: number): number?
	if not RunService:IsStudio() or eventDefinition.debugStudioEnabled ~= true then
		return nil
	end

	local startAfter = eventDefinition.debugStudioStartAfterSeconds
	if typeof(startAfter) ~= "number" then
		return nil
	end

	local startUnix = getStudioDebugCycleBaseUnix() + math.max(0, startAfter)
	local duration = eventDefinition.debugStudioDurationSeconds
	local graceDuration = eventDefinition.debugStudioGraceDurationSeconds
	if typeof(duration) ~= "number" or typeof(graceDuration) ~= "number" then
		return startUnix
	end

	local activeDuration = math.max(0, duration)
	if isRandomStudioDebugMode() then
		-- Random mode selects the next event at the active event's end, so
		-- this timestamp remains the selected event's actual start while it is
		-- upcoming or live. This also keeps event-win cycle resets on the real
		-- start instead of a future repeat cycle.
		return startUnix
	end

	local cycleDuration = activeDuration + math.max(0, graceDuration)
	if activeDuration <= 0 or cycleDuration <= 0 or timestamp < startUnix then
		return startUnix
	end

	local cycleStartUnix = startUnix + math.floor((timestamp - startUnix) / cycleDuration) * cycleDuration
	local cycleElapsed = (timestamp - startUnix) % cycleDuration
	return if cycleElapsed < activeDuration then cycleStartUnix else cycleStartUnix + cycleDuration
end

local function getEventStartUnix(eventDefinition: LiveEventDefinition, timestamp: number): number?
	local studioStartUnix = getStudioEventStartUnix(eventDefinition, timestamp)
	if studioStartUnix ~= nil then
		return studioStartUnix
	end
	if usesLiveRotation(eventDefinition) then
		return getLiveRotationEventStartUnix(eventDefinition, timestamp)
	end

	return LiveEventSchedule.GetStartUnix(eventDefinition.schedule, timestamp)
end

local function getEventEndUnix(eventDefinition: LiveEventDefinition, timestamp: number): number?
	local studioEndUnix = getStudioEventEndUnix(eventDefinition, timestamp)
	if studioEndUnix ~= nil then
		return studioEndUnix
	end
	if usesLiveRotation(eventDefinition) then
		return getLiveRotationEventEndUnix(eventDefinition, timestamp)
	end

	return LiveEventSchedule.GetEndUnix(eventDefinition.schedule, timestamp)
end

local function getEventPreEventCountdownSeconds(eventDefinition: LiveEventDefinition, timestamp: number, startsAtUnix: number?): number?
	if
		RunService:IsStudio()
		and eventDefinition.debugStudioEnabled == true
		and typeof(eventDefinition.debugStudioDurationSeconds) == "number"
		and typeof(eventDefinition.debugStudioGraceDurationSeconds) == "number"
	then
		if typeof(startsAtUnix) ~= "number" then
			return nil
		end

		-- The Studio cycle is authoritative for both the active event and its grace card.
		return math.max(0, startsAtUnix - timestamp)
	end
	if usesLiveRotation(eventDefinition) then
		-- Rotation events use their configured visibility window. The first
		-- rotation event receives the full-countdown exception in Refresh.
		return if typeof(eventDefinition.preEventCountdownSeconds) == "number"
			then math.max(0, eventDefinition.preEventCountdownSeconds)
			else nil
	end

	return LiveEventSchedule.GetPreEventCountdownSeconds(
		eventDefinition.schedule,
		timestamp,
		eventDefinition.preEventCountdownSeconds
	)
end

local function isFirstRotationEventUpcoming(eventDefinition: LiveEventDefinition, timestamp: number): boolean
	local rotationConfig = getLiveRotationConfig()
	if not rotationConfig or not rotationConfig.firstEventUsesFullCountdown then
		return false
	end

	local rotationState = getLiveRotationState(timestamp)
	local upcomingWindow = rotationState and rotationState.upcomingWindow
	return upcomingWindow ~= nil
		and upcomingWindow.sequenceIndex == 0
		and upcomingWindow.definition.id == eventDefinition.id
end

local function getBloodmoonCycleStartUnix(activeEvents: { LiveEventDefinition }, timestamp: number): number
	for _, eventDefinition in ipairs(activeEvents) do
		if eventDefinition.id == "Bloodmoon" then
			local cycleStartUnix = getEventStartUnix(eventDefinition, timestamp)
			if typeof(cycleStartUnix) == "number" and cycleStartUnix > 0 then
				return math.floor(cycleStartUnix)
			end
		end
	end

	return 0
end

local function syncBloodmoonCycle(player: Player, cycleStartUnix: number)
	if cycleStartUnix <= 0 or player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	if PlayerHandler.ResetBloodmoonWinsForCycle(player, cycleStartUnix) then
		DebugModule.debugInfo(
			"Reset Bloodmoon wins for new event cycle | player="
				.. player.Name
				.. " | cycleStartUnix="
				.. tostring(cycleStartUnix),
			MODULE_NAME
		)
	end
end

local function syncEventCycle(player: Player, eventDefinition: LiveEventDefinition, timestamp: number)
	if player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	local eventId = eventDefinition.id
	local winsAttribute = eventDefinition.kartWinsAttribute
	if typeof(eventId) ~= "string" or typeof(winsAttribute) ~= "string" or winsAttribute == "" then
		return
	end

	local cycleStartUnix = getEventStartUnix(eventDefinition, timestamp)
	if typeof(cycleStartUnix) ~= "number" or cycleStartUnix <= 0 then
		return
	end

	if PlayerHandler.ResetEventWinsForCycle(player, eventId, cycleStartUnix) then
		DebugModule.debugInfo(
			"Reset event wins for new cycle | event="
				.. eventId
				.. " | player="
				.. player.Name
				.. " | cycleStartUnix="
				.. tostring(math.floor(cycleStartUnix)),
			MODULE_NAME
		)
	end
end

local function syncConfiguredEventCycles(player: Player, timestamp: number)
	local studioDebugEventId = getStudioDebugEventId()
	for _, eventDefinition in ipairs(getConfigEvents()) do
		if
			eventDefinition.enabled ~= false
			and (studioDebugEventId == nil or eventDefinition.id == studioDebugEventId)
			and isEventActive(eventDefinition, timestamp)
		then
			syncEventCycle(player, eventDefinition, timestamp)
		end
	end
end

local function encodeActiveEvents(activeEvents: { LiveEventDefinition }, timestamp: number): string
	local serializedEvents: { [number]: { [string]: any } } = {}
	for _, eventDefinition in ipairs(activeEvents) do
		if typeof(eventDefinition.id) == "string" and typeof(eventDefinition.displayText) == "string" then
			local displayColor = if typeof(eventDefinition.displayColor) == "Color3"
				then colorToHex(eventDefinition.displayColor)
				else ""
			table.insert(serializedEvents, {
				id = eventDefinition.id,
				displayText = string.upper(eventDefinition.displayText),
				displayColor = displayColor,
				winPopupImageAssetId = if typeof(eventDefinition.winPopupImageAssetId) == "string"
					then eventDefinition.winPopupImageAssetId
					else "",
				startText = if typeof(eventDefinition.startText) == "string"
					then string.upper(eventDefinition.startText)
					else "",
				startSound = if typeof(eventDefinition.startSound) == "string"
					then eventDefinition.startSound
					else "",
				kartWinsAttribute = eventDefinition.kartWinsAttribute or "",
				stageWinAwards = serializeStageWinAwards(eventDefinition.stageWinAwards),
				effects = serializeEventEffects(eventDefinition),
				showCountdown = eventDefinition.showCountdown ~= false,
				environmentName = if typeof(eventDefinition.environmentName) == "string"
					then eventDefinition.environmentName
					else "",
				progressUi = serializeProgressUi(eventDefinition),
				eventBlockUi = serializeEventBlockUi(eventDefinition),
				endsAtUnix = getEventEndUnix(eventDefinition, timestamp) or 0,
			})
		end
	end

	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, serializedEvents)
	return if ok then encoded else "[]"
end

local function encodeUpcomingEvents(upcomingEvents: { UpcomingEvent }): string
	local serializedEvents: { [number]: { [string]: any } } = {}
	for _, upcomingEvent in ipairs(upcomingEvents) do
		local eventDefinition = upcomingEvent.definition
		if typeof(eventDefinition.id) == "string" and typeof(eventDefinition.displayText) == "string" then
			local displayColor = if typeof(eventDefinition.displayColor) == "Color3"
				then colorToHex(eventDefinition.displayColor)
				else ""
			table.insert(serializedEvents, {
				id = eventDefinition.id,
				displayText = string.upper(eventDefinition.displayText),
				displayColor = displayColor,
				winPopupImageAssetId = if typeof(eventDefinition.winPopupImageAssetId) == "string"
					then eventDefinition.winPopupImageAssetId
					else "",
				startText = if typeof(eventDefinition.startText) == "string"
					then string.upper(eventDefinition.startText)
					else "",
				startSound = if typeof(eventDefinition.startSound) == "string"
					then eventDefinition.startSound
					else "",
				kartWinsAttribute = eventDefinition.kartWinsAttribute or "",
				stageWinAwards = serializeStageWinAwards(eventDefinition.stageWinAwards),
				effects = serializeEventEffects(eventDefinition),
				environmentName = if typeof(eventDefinition.environmentName) == "string"
					then eventDefinition.environmentName
					else "",
				eventBlockUi = serializeEventBlockUi(eventDefinition),
				startsAtUnix = upcomingEvent.startsAtUnix,
			})
		end
	end

	local ok, encoded = pcall(HttpService.JSONEncode, HttpService, serializedEvents)
	return if ok then encoded else "[]"
end

local function scheduleRefresh()
	local token = refreshToken
	local refreshThread = task.delay(getRefreshInterval(), function()
		if not initialized or token ~= refreshToken then
			return
		end

		LiveEventService.Refresh()
		scheduleRefresh()
	end)
	-- A completed task.delay thread cannot be cancelled. Maid owns a guarded
	-- cleanup closure instead of the raw thread so recurring scheduling stays quiet.
	maid.RefreshThread = function()
		pcall(task.cancel, refreshThread)
	end
end

function LiveEventService.Refresh()
	refreshRandomStudioDebugSelection()
	local timestamp = DateTime.now().UnixTimestamp
	local activeEvents: { LiveEventDefinition } = {}
	local upcomingEvents: { UpcomingEvent } = {}
	local eventBlockEvents: { UpcomingEvent } = {}
	local xpMultiplier = 1
	local winButtonMultiplier = 1
	local walkSpeedMultiplier = 1
	local bloodmoonNextStartUnix = 0
	local studioDebugEventId = getStudioDebugEventId()

	for _, eventDefinition in ipairs(getConfigEvents()) do
		if eventDefinition.enabled ~= false and (studioDebugEventId == nil or eventDefinition.id == studioDebugEventId) then
			if isEventActive(eventDefinition, timestamp) then
				table.insert(activeEvents, eventDefinition)
				local effects = eventDefinition.effects
				if effects then
					if typeof(effects.xpMultiplier) == "number" then
						xpMultiplier *= math.max(0, effects.xpMultiplier)
					end
					if typeof(effects.winButtonMultiplier) == "number" then
						winButtonMultiplier *= math.max(0, effects.winButtonMultiplier)
					end
					if typeof(effects.walkSpeedMultiplier) == "number" then
						walkSpeedMultiplier *= math.max(0, effects.walkSpeedMultiplier)
					end
				end
			else
				local startsAtUnix = getEventStartUnix(eventDefinition, timestamp)
				local preEventCountdownSeconds = getEventPreEventCountdownSeconds(eventDefinition, timestamp, startsAtUnix)
				local isLiveRotationEvent = usesLiveRotation(eventDefinition)
				local isFirstRotationEvent = isFirstRotationEventUpcoming(eventDefinition, timestamp)
				if
					typeof(startsAtUnix) == "number"
					and startsAtUnix > timestamp
				then
					-- EventBlock countdowns are independent from the event-list
					-- visibility window. Publish the next event even when it is
					-- more than 24 hours away.
					table.insert(eventBlockEvents, {
						definition = eventDefinition,
						startsAtUnix = startsAtUnix,
					})
				end
				if
					eventDefinition.id == "Bloodmoon"
					and typeof(startsAtUnix) == "number"
					and startsAtUnix > timestamp
					and (
						isLiveRotationEvent
							or (
								typeof(eventDefinition.eventBlockCountdownSeconds) == "number"
								and startsAtUnix - timestamp <= math.max(0, eventDefinition.eventBlockCountdownSeconds)
							)
					)
				then
					bloodmoonNextStartUnix = math.floor(startsAtUnix)
				end
				if
					typeof(startsAtUnix) == "number"
					and startsAtUnix > timestamp
					and (
						isFirstRotationEvent
							or (
								typeof(preEventCountdownSeconds) == "number"
								and startsAtUnix - timestamp <= math.max(0, preEventCountdownSeconds)
							)
					)
				then
					table.insert(upcomingEvents, {
						definition = eventDefinition,
						startsAtUnix = startsAtUnix,
					})
				end
			end
		end
	end

	table.sort(activeEvents, function(a, b)
		return (a.priority or 0) > (b.priority or 0)
	end)
	table.sort(upcomingEvents, function(a, b)
		if a.startsAtUnix == b.startsAtUnix then
			return (a.definition.priority or 0) > (b.definition.priority or 0)
		end
		return a.startsAtUnix < b.startsAtUnix
	end)
	-- Keep the in-game EventFrameList focused on the first upcoming event.
	-- Active events and EventBlockEvents retain their independent behavior.
	local upcomingEventsForUi: { UpcomingEvent } = {}
	if upcomingEvents[1] then
		table.insert(upcomingEventsForUi, upcomingEvents[1])
	end
	table.sort(eventBlockEvents, function(a, b)
		if a.startsAtUnix == b.startsAtUnix then
			return (a.definition.priority or 0) > (b.definition.priority or 0)
		end
		return a.startsAtUnix < b.startsAtUnix
	end)

	local bannerText = formatBannerText(activeEvents)
	local activeEventsJson = encodeActiveEvents(activeEvents, timestamp)
	local upcomingEventsJson = encodeUpcomingEvents(upcomingEventsForUi)
	local eventBlockEventsJson = encodeUpcomingEvents(eventBlockEvents)
	local bloodmoonCycleStartUnix = getBloodmoonCycleStartUnix(activeEvents, timestamp)
	local environmentName = "Default"
	for _, eventDefinition in ipairs(activeEvents) do
		if typeof(eventDefinition.environmentName) == "string" and eventDefinition.environmentName ~= "" then
			environmentName = eventDefinition.environmentName
			break
		end
	end
	local activeIds: { string } = {}
	for _, eventDefinition in ipairs(activeEvents) do
		if typeof(eventDefinition.id) == "string" then
			table.insert(activeIds, eventDefinition.id)
		end
	end

	local bannerActive = bannerText ~= ""
	local activeIdsText = table.concat(activeIds, ",")
	local stateChanged = not hasPublishedState
		or bannerActive ~= publishedBannerActive
		or bannerText ~= publishedBannerText
		or activeIdsText ~= publishedActiveIds
		or xpMultiplier ~= publishedXPMultiplier
		or winButtonMultiplier ~= publishedWinButtonMultiplier
		or walkSpeedMultiplier ~= publishedWalkSpeedMultiplier
		or environmentName ~= publishedEnvironmentName
		or bloodmoonCycleStartUnix ~= publishedBloodmoonCycleStartUnix
		or bloodmoonNextStartUnix ~= publishedBloodmoonNextStartUnix
		or bloodmoonNextStartUnix ~= stateFolder:GetAttribute("BloodmoonNextStartUnix")
		or activeEventsJson ~= stateFolder:GetAttribute("ActiveEvents")
		or upcomingEventsJson ~= publishedUpcomingEvents
		or upcomingEventsJson ~= stateFolder:GetAttribute("UpcomingEvents")
		or eventBlockEventsJson ~= publishedEventBlockEvents
		or eventBlockEventsJson ~= stateFolder:GetAttribute("EventBlockEvents")
	if not stateChanged then
		return
	end

	hasPublishedState = true
	publishedBannerActive = bannerActive
	publishedBannerText = bannerText
	publishedActiveIds = activeIdsText
	publishedXPMultiplier = xpMultiplier
	publishedWinButtonMultiplier = winButtonMultiplier
	publishedWalkSpeedMultiplier = walkSpeedMultiplier
	publishedEnvironmentName = environmentName
	publishedUpcomingEvents = upcomingEventsJson
	publishedEventBlockEvents = eventBlockEventsJson
	publishedBloodmoonCycleStartUnix = bloodmoonCycleStartUnix
	publishedBloodmoonNextStartUnix = bloodmoonNextStartUnix
	stateFolder:SetAttribute("BannerActive", bannerActive)
	stateFolder:SetAttribute("BannerText", bannerText)
	stateFolder:SetAttribute("ActiveEventIds", activeIdsText)
	stateFolder:SetAttribute("XPMultiplier", xpMultiplier)
	stateFolder:SetAttribute("WinButtonMultiplier", winButtonMultiplier)
	stateFolder:SetAttribute("WalkSpeedMultiplier", walkSpeedMultiplier)
	stateFolder:SetAttribute("EnvironmentName", environmentName)
	stateFolder:SetAttribute("BloodmoonCycleStartUnix", bloodmoonCycleStartUnix)
	stateFolder:SetAttribute("BloodmoonNextStartUnix", bloodmoonNextStartUnix)
	stateFolder:SetAttribute("ActiveEvents", activeEventsJson)
	stateFolder:SetAttribute("UpcomingEvents", upcomingEventsJson)
	stateFolder:SetAttribute("EventBlockEvents", eventBlockEventsJson)
	DebugModule.debugInfo(
		"Live event state updated | activeIds="
			.. activeIdsText
			.. " | upcomingId="
			.. (if upcomingEventsForUi[1] then upcomingEventsForUi[1].definition.id else "")
			.. " | environment="
			.. environmentName,
		MODULE_NAME
	)

	for _, player in ipairs(Players:GetPlayers()) do
		for _, eventDefinition in ipairs(activeEvents) do
			syncEventCycle(player, eventDefinition, timestamp)
		end
		applyPlayerMultipliers(player, xpMultiplier, winButtonMultiplier, walkSpeedMultiplier)
	end
end

function LiveEventService.Init()
	if initialized then
		return
	end
	initialized = true
	refreshToken += 1
	initializedAt = os.clock()
	initializedUnixTimestamp = DateTime.now().UnixTimestamp

	maid.PlayerAdded = Players.PlayerAdded:Connect(function(player: Player)
		local dataLoadedConnectionKey = "LiveEventDataLoaded_" .. tostring(player.UserId)
		maid[dataLoadedConnectionKey] = player:GetAttributeChangedSignal("Data_Loaded"):Connect(function()
			syncConfiguredEventCycles(player, DateTime.now().UnixTimestamp)
		end)

		local xpMultiplier = stateFolder:GetAttribute("XPMultiplier")
		local winButtonMultiplier = stateFolder:GetAttribute("WinButtonMultiplier")
		local walkSpeedMultiplier = stateFolder:GetAttribute("WalkSpeedMultiplier")
		syncConfiguredEventCycles(player, DateTime.now().UnixTimestamp)
		applyPlayerMultipliers(
			player,
			if typeof(xpMultiplier) == "number" then xpMultiplier else 1,
			if typeof(winButtonMultiplier) == "number" then winButtonMultiplier else 1,
			if typeof(walkSpeedMultiplier) == "number" then walkSpeedMultiplier else 1
		)
	end)
	maid.PlayerRemoving = Players.PlayerRemoving:Connect(function(player: Player)
		maid["LiveEventDataLoaded_" .. tostring(player.UserId)] = nil
	end)
	LiveEventService.Refresh()
	scheduleRefresh()
	DebugModule.debugPrint("Live event service initialized", MODULE_NAME)
end

function LiveEventService.Destroy()
	if not initialized then
		return
	end
	initialized = false
	refreshToken += 1
	maid:DoCleaning()
	hasPublishedState = false
	studioDebugSelectedEventId = nil
	studioDebugCycleStartedAt = 0
	liveRotationCache = nil
	liveRotationWarningShown = false

	stateFolder:SetAttribute("BannerActive", false)
	stateFolder:SetAttribute("BannerText", "")
	stateFolder:SetAttribute("ActiveEventIds", "")
	stateFolder:SetAttribute("XPMultiplier", 1)
	stateFolder:SetAttribute("WinButtonMultiplier", 1)
	stateFolder:SetAttribute("WalkSpeedMultiplier", 1)
	stateFolder:SetAttribute("EnvironmentName", "Default")
	stateFolder:SetAttribute("BloodmoonCycleStartUnix", 0)
	stateFolder:SetAttribute("BloodmoonNextStartUnix", 0)
	stateFolder:SetAttribute("ActiveEvents", "[]")
	stateFolder:SetAttribute("UpcomingEvents", "[]")
	stateFolder:SetAttribute("EventBlockEvents", "[]")
	for _, player in ipairs(Players:GetPlayers()) do
		applyPlayerMultipliers(player, 1, 1, 1)
	end
end

return LiveEventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3753">
        <Properties>
          <string name="Name">MinigameService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local CoreConfig = require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("CoreConfig_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local Maid = require(Modules:WaitForChild("Maid"))
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local SoundService = require(Modules:WaitForChild("SoundService"))
local ValidationService = require(script.Parent:WaitForChild("ValidationService"))
local EconomyAnalytics = require(script.Parent:WaitForChild("EconomyAnalytics"))
local LevelingService = require(script.Parent:WaitForChild("LevelingService"))
local CreatorPurchaseService = require(script.Parent:WaitForChild("CreatorPurchaseService"))
local ReturnToStageService = require(script.Parent:WaitForChild("ReturnToStageService"))

local MinigameService = {}

type RaceState = "Open" | "Grace" | "Starting" | "Countdown" | "Racing" | "Cooldown"

type ParticipantState = {
	order: number,
	finished: boolean,
	maid: any,
	startedAt: number?,
	startPosition: Vector3?,
	maximumAllowedSpeed: number?,
}

type ReturnFreezeState = {
	character: Model,
	humanoid: Humanoid,
	rootPart: BasePart,
	walkSpeed: number,
	jumpPower: number,
	jumpHeight: number,
	autoRotate: boolean,
	rootAnchored: boolean,
	thread: thread?,
}

local MODULE_NAME = "MinigameService"
local DEFAULT_REQUIRED_PLAYERS = 5
local DEFAULT_MAX_PLAYERS = 20
local DEFAULT_GRACE_SECONDS = 30
local DEFAULT_PRE_COUNTDOWN_GRACE_SECONDS = 3
local DEFAULT_COUNTDOWN_FALLBACK_SECONDS = 3
local DEFAULT_RACE_TIMEOUT_SECONDS = 180
local DEFAULT_COOLDOWN_SECONDS = 5 * 60
local DEFAULT_RETURN_FREEZE_SECONDS = 1
local DEFAULT_COUNTDOWN_SOUND_ID = 100324658979992
local RACE_VOID_NOTIFICATION = "NOT ENOUGH PLAYERS TO START RACE!"
local FINISH_LINE_VALIDATION_PADDING = Vector3.new(12, 12, 12)
local FINISH_LINE_SCAN_INTERVAL = 0.05

local serverConfig = CoreConfig.server
local minigameConfig = if serverConfig and typeof(serverConfig.minigame) == "table" then serverConfig.minigame else nil

local function readNumber(name: string, fallback: number, minimum: number): number
	local value = minigameConfig and minigameConfig[name]
	if typeof(value) ~= "number" then
		return fallback
	end

	return math.max(minimum, value)
end

local REQUIRED_PLAYERS = math.floor(readNumber("requiredPlayers", DEFAULT_REQUIRED_PLAYERS, 1))
local MAX_PLAYERS = math.floor(readNumber("maxPlayers", DEFAULT_MAX_PLAYERS, REQUIRED_PLAYERS))
local GRACE_SECONDS = readNumber("gracePeriodSeconds", DEFAULT_GRACE_SECONDS, 1)
local PRE_COUNTDOWN_GRACE_SECONDS = readNumber("preCountdownGraceSeconds", DEFAULT_PRE_COUNTDOWN_GRACE_SECONDS, 0)
local COUNTDOWN_FALLBACK_SECONDS = readNumber("countdownFallbackSeconds", DEFAULT_COUNTDOWN_FALLBACK_SECONDS, 1)
local RACE_TIMEOUT_SECONDS = readNumber("raceTimeoutSeconds", DEFAULT_RACE_TIMEOUT_SECONDS, 1)
local COOLDOWN_SECONDS = readNumber("cooldownSeconds", DEFAULT_COOLDOWN_SECONDS, 0)
local RETURN_FREEZE_SECONDS = readNumber("returnFreezeSeconds", DEFAULT_RETURN_FREEZE_SECONDS, 0)
local COUNTDOWN_SOUND_ID = if minigameConfig and typeof(minigameConfig.countdownSoundId) == "number"
	then minigameConfig.countdownSoundId
	else DEFAULT_COUNTDOWN_SOUND_ID
local DEBUG_ALLOW_SINGLE_PLAYER = RunService:IsStudio()
	and minigameConfig ~= nil
	and minigameConfig.debugAllowSinglePlayerInStudio == true
local DEBUG_SKIP_COOLDOWN = RunService:IsStudio()
	and minigameConfig ~= nil
	and minigameConfig.debugSkipCooldownInStudio == true

local worldsFolder = Workspace:FindFirstChild("Worlds")
local minigameWorld = worldsFolder and worldsFolder:FindFirstChild("Minigame")
assert(minigameWorld, "Workspace.Worlds.Minigame is required")

local cooldownStart = minigameWorld:FindFirstChild("CooldownStart")
local cooldownStartSecond = minigameWorld:FindFirstChild("CooldownStart_2nd")
local finishLine = minigameWorld:FindFirstChild("FinishLine")
local invisEnd = minigameWorld:FindFirstChild("InvisEnd")
local teleportZone = minigameWorld:FindFirstChild("TeleportZone")
assert(cooldownStart and cooldownStart:IsA("BasePart"), "Minigame.CooldownStart must be a BasePart")
assert(cooldownStartSecond and cooldownStartSecond:IsA("BasePart"), "Minigame.CooldownStart_2nd must be a BasePart")
assert(finishLine and finishLine:IsA("BasePart"), "Minigame.FinishLine must be a BasePart")
assert(teleportZone and teleportZone:IsA("BasePart"), "Minigame.TeleportZone must be a BasePart")

local startSurfaceGui = cooldownStart:FindFirstChild("SurfaceGui1")
local countdownSurfaceGui = cooldownStart:FindFirstChild("SurfaceGui2")
local countdownFrame = countdownSurfaceGui and countdownSurfaceGui:FindFirstChild("Frame")
local countdownLabel = countdownFrame and countdownFrame:FindFirstChild("CountdownLabel")
assert(startSurfaceGui and startSurfaceGui:IsA("SurfaceGui"), "Minigame SurfaceGui1 is required")
assert(countdownSurfaceGui and countdownSurfaceGui:IsA("SurfaceGui"), "Minigame SurfaceGui2 is required")
assert(countdownLabel and countdownLabel:IsA("TextLabel"), "Minigame CountdownLabel is required")

local remotes = ReplicatedStorage:FindFirstChild("Remotes")
if not remotes then
	remotes = Instance.new("Folder")
	remotes.Name = "Remotes"
	remotes.Parent = ReplicatedStorage
end

local function getOrCreateRemote(name: string): RemoteEvent
	local existing = remotes:FindFirstChild(name)
	if existing then
		assert(existing:IsA("RemoteEvent"), name .. " must be a RemoteEvent")
		return existing
	end

	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end

local joinRequest = getOrCreateRemote("MinigameJoinRequest")
local joinResult = getOrCreateRemote("MinigameJoinResult")
local raceNotification = getOrCreateRemote("MinigameRaceNotification")
local showNotification = getOrCreateRemote("ShowNotification")
local winButtonPressed = getOrCreateRemote("WinButtonPressed")
local xpGainAwarded = getOrCreateRemote("XPGainAwarded")

SoundService.RegisterSound("MinigameCountdown", {
	SoundId = COUNTDOWN_SOUND_ID,
	Volume = 0,
	PlaybackSpeed = 1,
	Looped = false,
	AllowOverlap = false,
})

local serviceMaid = Maid.new()
local participants: { [Player]: ParticipantState } = {}
local joinRequestLastAt: { [Player]: number } = {}
local raceState: RaceState = "Open"
local phaseThread: thread? = nil
local phaseToken = 0
local joinOrder = 0
local finishCount = 0
local activeCountdownSound: Sound? = nil
local returnFreezeStates: { [Player]: ReturnFreezeState } = {}
local initialized = false

local function serverNow(): number
	return Workspace:GetServerTimeNow()
end

local function setWorldAttribute(name: string, value: any)
	minigameWorld:SetAttribute(name, value)
end

local function setPlayerState(player: Player, participant: boolean, state: string, placement: number?)
	player:SetAttribute("MinigameParticipant", participant)
	player:SetAttribute("MinigameState", state)
	player:SetAttribute("MinigamePlacement", placement)
end

local function getParticipantCount(): number
	local count = 0
	for _ in pairs(participants) do
		count += 1
	end
	return count
end

local function updatePlayerCount()
	setWorldAttribute("RacePlayerCount", getParticipantCount())
	setWorldAttribute("RaceRequiredPlayers", REQUIRED_PLAYERS)
end

local function hasCreatorParticipant(): boolean
	for player in pairs(participants) do
		if CreatorPurchaseService.IsExperienceCreator(player) then
			return true
		end
	end

	return false
end

local function hasEnoughParticipants(): boolean
	local participantCount = getParticipantCount()
	return participantCount >= REQUIRED_PLAYERS
		or (DEBUG_ALLOW_SINGLE_PLAYER and participantCount >= 1)
		or hasCreatorParticipant()
end

local function setRaceSurfaceGuisVisible(visible: boolean)
	startSurfaceGui.Enabled = visible
	countdownSurfaceGui.Enabled = visible
end

local function setRaceState(nextState: RaceState)
	raceState = nextState
	setRaceSurfaceGuisVisible(nextState ~= "Racing")
	setWorldAttribute("RaceState", nextState)
	updatePlayerCount()
end

local function setBarriers(canCollide: boolean)
	cooldownStart.CanCollide = canCollide
	cooldownStartSecond.CanCollide = canCollide
end

local function resetRacePhaseState()
	countdownLabel.Text = ""
	setWorldAttribute("GraceEndsAt", 0)
	setWorldAttribute("CountdownEndsAt", 0)
	setWorldAttribute("RaceEndsAt", 0)
end

local function clearFinishedPlayerStates()
	for _, player in ipairs(Players:GetPlayers()) do
		if player:GetAttribute("MinigameParticipant") ~= true then
			setPlayerState(player, false, "None", nil)
		end
	end
end

local function cancelPhaseThread()
	phaseToken += 1
	local runningThread = coroutine.running()
	if phaseThread and phaseThread ~= runningThread then
		task.cancel(phaseThread)
	end
	phaseThread = nil
end

local function stopCountdownSound()
	local sound = activeCountdownSound
	activeCountdownSound = nil
	if sound and sound.Parent then
		sound:Stop()
		sound:Destroy()
	end
end

local function notify(
	player: Player,
	eventName: string,
	placement: number?,
	awardedWins: number?,
	awardedLevels: number?,
	message: string?
)
	raceNotification:FireClient(player, eventName, placement, awardedWins, awardedLevels, message)
end

local function getRaceSpawnCFrame(order: number): CFrame
	local columns = 5
	local columnIndex = (order - 1) % columns
	local rowIndex = math.floor((order - 1) / columns)
	local xOffset = (columnIndex - 2) * 8
	local zOffset = math.min(18, rowIndex * 8)
	local safeHeight = teleportZone.Size.Y * 0.5 + 3

	return teleportZone.CFrame * CFrame.new(xOffset, safeHeight, zOffset)
end

local function restoreReturnFreeze(player: Player, state: ReturnFreezeState)
	if
		player.Character ~= state.character
		or not state.character.Parent
		or not state.humanoid.Parent
		or not state.rootPart.Parent
	then
		return
	end

	state.humanoid.WalkSpeed = state.walkSpeed
	state.humanoid.JumpPower = state.jumpPower
	state.humanoid.JumpHeight = state.jumpHeight
	state.humanoid.AutoRotate = state.autoRotate
	state.rootPart.AssemblyLinearVelocity = Vector3.zero
	state.rootPart.AssemblyAngularVelocity = Vector3.zero
	state.rootPart.Anchored = state.rootAnchored
	state.rootPart.AssemblyLinearVelocity = Vector3.zero
	state.rootPart.AssemblyAngularVelocity = Vector3.zero
end

local function cancelReturnFreeze(player: Player)
	local state = returnFreezeStates[player]
	if not state then
		return
	end

	returnFreezeStates[player] = nil
	if state.thread and state.thread ~= coroutine.running() then
		task.cancel(state.thread)
	end
	restoreReturnFreeze(player, state)
end

local function freezePlayerAfterReturn(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not rootPart or not rootPart:IsA("BasePart") or humanoid.Health <= 0 then
		return
	end

	local state = returnFreezeStates[player]
	if not state or state.character ~= character or state.humanoid ~= humanoid or state.rootPart ~= rootPart then
		if state then
			cancelReturnFreeze(player)
		end
		state = {
			character = character,
			humanoid = humanoid,
			rootPart = rootPart,
			walkSpeed = humanoid.WalkSpeed,
			jumpPower = humanoid.JumpPower,
			jumpHeight = humanoid.JumpHeight,
			autoRotate = humanoid.AutoRotate,
			rootAnchored = rootPart.Anchored,
			thread = nil,
		}
		returnFreezeStates[player] = state
	elseif state.thread then
		task.cancel(state.thread)
	end

	humanoid.WalkSpeed = 0
	humanoid.JumpPower = 0
	humanoid.JumpHeight = 0
	humanoid.AutoRotate = false
	humanoid.Jump = false
	rootPart.Anchored = true
	rootPart.AssemblyLinearVelocity = Vector3.zero
	rootPart.AssemblyAngularVelocity = Vector3.zero

	state.thread = task.spawn(function()
		task.wait(RETURN_FREEZE_SECONDS)
		if returnFreezeStates[player] ~= state then
			return
		end

		returnFreezeStates[player] = nil
		state.thread = nil
		restoreReturnFreeze(player, state)
	end)
end

local function returnPlayerToWorld1(player: Player)
	if ValidationService.IsPlayerAlive(player) then
		LevelingService.SendPlayerToWorld1Spawn(player)
		ValidationService.MarkServerTeleport(player)
		freezePlayerAfterReturn(player)
	end
end

local function getPlayerFromRaceTouch(hit: BasePart): Player?
	local characterPlayer = ValidationService.GetAlivePlayerFromTouch(hit)
	if characterPlayer then
		return characterPlayer
	end

	local kartModel = hit:FindFirstAncestor("EquippedKart")
	if not kartModel or not kartModel:IsA("Model") then
		return nil
	end

	local ownerUserId = kartModel:GetAttribute("KartOwnerUserId")
	if typeof(ownerUserId) ~= "number" then
		return nil
	end

	local owner = Players:GetPlayerByUserId(ownerUserId)
	if not owner or not ValidationService.IsPlayerAlive(owner) then
		return nil
	end

	return owner
end

local function getNearestFinishPoint(origin: Vector3): Vector3
	local localOrigin = finishLine.CFrame:PointToObjectSpace(origin)
	local halfExtents = finishLine.Size * 0.5 + FINISH_LINE_VALIDATION_PADDING
	local nearestPoint = Vector3.new(
		math.clamp(localOrigin.X, -halfExtents.X, halfExtents.X),
		math.clamp(localOrigin.Y, -halfExtents.Y, halfExtents.Y),
		math.clamp(localOrigin.Z, -halfExtents.Z, halfExtents.Z)
	)
	return finishLine.CFrame:PointToWorldSpace(nearestPoint)
end

-- Touched is only a candidate signal. Confirm current server-observed position
-- before allowing a race reward.
local removeParticipant: (player: Player, reason: string, returnPlayer: boolean, state: string?) -> ()
local startCooldown: (reason: string, notificationMessage: string?) -> ()
local finishRace: (reason: string) -> ()
local beginGrace: () -> ()
local checkPlayerForFinish: (player: Player) -> ()

local function bindParticipantCharacter(player: Player, participant: ParticipantState)
	local function bindHumanoid(character: Model)
		participant.maid.HumanoidDied = nil
		local humanoid = character:FindFirstChildOfClass("Humanoid")
		if not humanoid then
			return
		end

		participant.maid.HumanoidDied = humanoid.Died:Connect(function()
			removeParticipant(player, "Died", false, "None")
		end)
	end

	local character = player.Character
	if character then
		bindHumanoid(character)
	end
	participant.maid.CharacterAdded = player.CharacterAdded:Connect(bindHumanoid)
	participant.maid.CharacterRemoving = player.CharacterRemoving:Connect(function(_removingCharacter: Model)
		if participants[player] == participant then
			removeParticipant(player, "CharacterReset", false, "None")
		end
	end)
	participant.maid.RebirthChanged = player:GetAttributeChangedSignal("Rebirths"):Connect(function()
		if participants[player] ~= participant then
			return
		end

		if raceState ~= "Cooldown" then
			removeParticipant(player, "Rebirth", true, "None")
		end
	end)
	participant.maid.WorldChanged = player:GetAttributeChangedSignal("Current_World"):Connect(function()
		if player:GetAttribute("Current_World") ~= "World1" then
			removeParticipant(player, "WorldChanged", true)
		end
	end)
end

local function clearParticipant(player: Player, participant: ParticipantState, returnPlayer: boolean, state: string)
	if returnPlayer then
		returnPlayerToWorld1(player)
	end

	participant.maid:DoCleaning()
	participants[player] = nil
	setPlayerState(player, false, state, player:GetAttribute("MinigamePlacement") :: number?)
	updatePlayerCount()
end

local function snapshotParticipants(): { Player }
	local snapshot = {}
	for player in pairs(participants) do
		table.insert(snapshot, player)
	end
	return snapshot
end

local function clearAllParticipants(notificationMessage: string?, returnPlayer: boolean)
	for _, player in ipairs(snapshotParticipants()) do
		local participant = participants[player]
		if participant then
			if notificationMessage then
				notify(player, "RaceEnded", nil, nil, nil, notificationMessage)
			end
			clearParticipant(player, participant, returnPlayer, "Finished")
		end
	end
end

local function calculateBaseWins(player: Player, placement: number): number
	local currentWins = player:GetAttribute("WinCount")
	if typeof(currentWins) ~= "number" then
		currentWins = 0
	end

	local rate = if placement == 1 then 0.2 elseif placement == 2 then 0.1 elseif placement == 3 then 0.05 else 0.01
	local rounded = math.floor(math.max(0, currentWins) * rate / 10) * 10
	return math.max(100, rounded)
end

local function getLevelReward(placement: number): number
	return if placement == 1 then 5 elseif placement == 2 then 2 else 0
end

local function formatPlacement(placement: number): string
	local lastTwoDigits = placement % 100
	local suffix = if lastTwoDigits >= 11 and lastTwoDigits <= 13
		then "TH"
		elseif placement % 10 == 1 then "ST"
		elseif placement % 10 == 2 then "ND"
		elseif placement % 10 == 3 then "RD"
		else "TH"
	return tostring(placement) .. suffix
end

local function awardPlacement(player: Player, placement: number)
	local participant = participants[player]
	if not participant or participant.finished or raceState ~= "Racing" then
		return
	end
	if not ValidationService.IsPlayerNearPart(player, finishLine, FINISH_LINE_VALIDATION_PADDING) then
		return
	end
	if participant.startedAt and participant.startPosition then
		if
			not ValidationService.ValidateTravelTime(
				player,
				participant.startPosition,
				getNearestFinishPoint(participant.startPosition),
				participant.startedAt,
				"MinigameRace",
				participant.maximumAllowedSpeed
			)
		then
			removeParticipant(player, "TravelTimeValidation", true)
			return
		end
	end
	if not ValidationService.ValidateRewardEligibility(player, "MinigameRace") then
		removeParticipant(player, "SuspiciousTeleport", true)
		return
	end

	participant.finished = true
	finishCount += 1
	participant.maid:DoCleaning()

	local baseWins = calculateBaseWins(player, placement)
	local beforeAllXPSpeed = player:GetAttribute("AllXPSpeed")
	if typeof(beforeAllXPSpeed) ~= "number" then
		beforeAllXPSpeed = 0
	end

	local awardedWins = PlayerHandler.AddWins(player, baseWins)
	local awardedLevels = PlayerHandler.AddLevels(player, getLevelReward(placement))
	if placement == 1 then
		local currentRaceWins = player:GetAttribute("MinigameRaceWins")
		if typeof(currentRaceWins) ~= "number" then
			currentRaceWins = 0
		end
		PlayerHandler.SetAttribute(player, "MinigameRaceWins", math.max(0, math.floor(currentRaceWins)) + 1)
	end
	local afterAllXPSpeed = player:GetAttribute("AllXPSpeed")
	if typeof(afterAllXPSpeed) ~= "number" then
		afterAllXPSpeed = beforeAllXPSpeed
	end
	local awardedXPSpeed = math.max(0, afterAllXPSpeed - beforeAllXPSpeed)
	if awardedWins > 0 then
		winButtonPressed:FireClient(player, awardedWins, "MinigameRace")
	end
	if awardedXPSpeed > 0 then
		xpGainAwarded:FireClient(player, awardedXPSpeed)
	end

	EconomyAnalytics.LogSource(
		player,
		"Wins",
		awardedWins,
		Enum.AnalyticsEconomyTransactionType.Gameplay.Name,
		"MinigameRace",
		{ customField01 = tostring(placement), customField02 = "Placement" }
	)
	if awardedXPSpeed > 0 then
		EconomyAnalytics.LogSource(
			player,
			"XPSpeed",
			awardedXPSpeed,
			Enum.AnalyticsEconomyTransactionType.Gameplay.Name,
			"MinigameRaceLevelReward",
			{ customField01 = tostring(placement), customField02 = tostring(awardedLevels) }
		)
	end

	setPlayerState(player, false, "Finished", placement)
	returnPlayerToWorld1(player)
	showNotification:FireClient(player, "CONGRATULATIONS! YOU GOT " .. formatPlacement(placement) .. " PLACE!", "Gold")
	participants[player] = nil
	updatePlayerCount()

	if getParticipantCount() <= 0 then
		finishRace("All racers finished")
	end
end

checkPlayerForFinish = function(player: Player)
	if raceState ~= "Racing" then
		return
	end

	local participant = participants[player]
	if not participant or participant.finished then
		return
	end

	awardPlacement(player, finishCount + 1)
end

local function getFinishRedirectCFrame(rootPart: BasePart): CFrame
	local localRootPosition = finishLine.CFrame:PointToObjectSpace(rootPart.Position)
	local xPadding = math.min(3, finishLine.Size.X * 0.25)
	local localTargetPosition = Vector3.new(
		math.clamp(localRootPosition.X, -finishLine.Size.X * 0.5 + xPadding, finishLine.Size.X * 0.5 - xPadding),
		-finishLine.Size.Y * 0.5 + 3,
		0
	)
	local targetPosition = finishLine.CFrame:PointToWorldSpace(localTargetPosition)
	return CFrame.new(targetPosition) * rootPart.CFrame.Rotation
end

local function redirectRacePlayerToFinish(player: Player, triggerPart: BasePart)
	if raceState ~= "Racing" then
		return
	end

	local participant = participants[player]
	if not participant or participant.finished then
		return
	end
	if not ValidationService.IsPlayerNearPart(player, triggerPart, FINISH_LINE_VALIDATION_PADDING) then
		return
	end
	if not ValidationService.ValidateRewardEligibility(player, "MinigameFinishRedirect") then
		removeParticipant(player, "FinishRedirectValidation", true)
		return
	end

	local character = player.Character
	local humanoid = ValidationService.GetAliveHumanoid(character)
	local rootPart = character and character:FindFirstChild("HumanoidRootPart")
	if not character or not humanoid or not rootPart or not rootPart:IsA("BasePart") then
		return
	end

	local targetCFrame = getFinishRedirectCFrame(rootPart)
	local pivotSuccess, pivotError = pcall(function()
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		character:PivotTo(targetCFrame)
		rootPart.AssemblyLinearVelocity = Vector3.zero
		rootPart.AssemblyAngularVelocity = Vector3.zero
		ValidationService.MarkServerTeleport(player)
	end)
	if not pivotSuccess then
		DebugModule.debugWarn(
			string.format("Finish redirect failed | player=%s | reason=%s", player.Name, tostring(pivotError)),
			MODULE_NAME
		)
		return
	end

	DebugModule.debugInfo(
		string.format("Finish redirect completed | player=%s | trigger=%s", player.Name, triggerPart.Name),
		MODULE_NAME
	)
end

removeParticipant = function(player: Player, reason: string, returnPlayer: boolean, state: string?)
	local participant = participants[player]
	if not participant then
		return
	end

	clearParticipant(player, participant, returnPlayer, state or "Finished")
	DebugModule.debugInfo(
		string.format("Removed %s from race (%s) | state=%s", player.Name, reason, state or "Finished"),
		MODULE_NAME
	)

	if (raceState == "Grace" or raceState == "Starting" or raceState == "Countdown") and not hasEnoughParticipants() then
		-- Reopen the join window so a reset, death, rebirth, or Return To Stage
		-- requires the player to press Join again instead of stranding them in cooldown.
		beginGrace()
	elseif raceState == "Racing" and getParticipantCount() <= 0 then
		finishRace("No racers remaining")
	end
end

local function setOpenState()
	resetRacePhaseState()
	setWorldAttribute("CooldownEndsAt", 0)
end

local function runCooldown(token: number)
	local cooldownSeconds = if DEBUG_SKIP_COOLDOWN then 0 else COOLDOWN_SECONDS
	local deadline = serverNow() + cooldownSeconds
	resetRacePhaseState()
	setWorldAttribute("CooldownEndsAt", deadline)

	phaseThread = task.spawn(function()
		local remaining = math.max(0, deadline - serverNow())
		if remaining > 0 then
			task.wait(remaining)
		end
		if token ~= phaseToken or raceState ~= "Cooldown" then
			return
		end

		setOpenState()
		setRaceState("Open")
		phaseThread = nil
		-- Every completed cooldown opens a synchronized join window. Studio only
		-- changes the cooldown duration; it does not change the race flow.
		beginGrace()
	end)
end

startCooldown = function(reason: string, notificationMessage: string?)
	cancelPhaseThread()
	stopCountdownSound()
	resetRacePhaseState()
	setBarriers(true)
	local isRaceVoid = notificationMessage == RACE_VOID_NOTIFICATION
	if isRaceVoid then
		for _, player in ipairs(snapshotParticipants()) do
			showNotification:FireClient(player, RACE_VOID_NOTIFICATION, "Red")
		end
	end
	clearAllParticipants(if isRaceVoid then nil else notificationMessage, true)
	clearFinishedPlayerStates()
	finishCount = 0
	joinOrder = 0
	setRaceState("Cooldown")
	DebugModule.debugInfo(string.format("Race entered cooldown (%s)", reason), MODULE_NAME)
	runCooldown(phaseToken)
end

finishRace = function(reason: string)
	if raceState ~= "Racing" then
		return
	end

	startCooldown(reason, "RACE COMPLETE!")
end

local function voidRace(reason: string)
	if raceState ~= "Grace" then
		return
	end

	startCooldown(reason, RACE_VOID_NOTIFICATION)
end

local function startRace(token: number)
	if token ~= phaseToken or raceState ~= "Countdown" then
		return
	end
	if not hasEnoughParticipants() then
		startCooldown("Countdown ended below required players", RACE_VOID_NOTIFICATION)
		return
	end

	local raceStartedAt = serverNow()
	setBarriers(false)
	setWorldAttribute("CountdownEndsAt", 0)
	setWorldAttribute("RaceEndsAt", raceStartedAt + RACE_TIMEOUT_SECONDS)
	setRaceState("Racing")
	for player, participant in pairs(participants) do
		local character = player.Character
		local rootPart = character and character:FindFirstChild("HumanoidRootPart")
		participant.startedAt = raceStartedAt
		participant.startPosition = if rootPart and rootPart:IsA("BasePart") then rootPart.Position else nil
		participant.maximumAllowedSpeed = math.clamp(PlayerHandler.GetEffectiveWalkSpeed(player), 1, 100000)
		setPlayerState(player, true, "Racing", nil)
	end

	phaseThread = task.spawn(function()
		local deadline = serverNow() + RACE_TIMEOUT_SECONDS
		while token == phaseToken and raceState == "Racing" and serverNow() < deadline do
			task.wait(0.25)
		end

		if token == phaseToken and raceState == "Racing" then
			finishRace("Race timeout")
		end
	end)
end

local function startActualCountdown(token: number)
	if token ~= phaseToken or raceState ~= "Starting" then
		return
	end
	if not hasEnoughParticipants() then
		startCooldown("Starting phase ended below required players", RACE_VOID_NOTIFICATION)
		return
	end

	activeCountdownSound = SoundService.PlayWorkspaceSound("MinigameCountdown", cooldownStart)
	local countdownDeadline = serverNow() + COUNTDOWN_FALLBACK_SECONDS

	countdownLabel.Text = "3"
	setWorldAttribute("CountdownEndsAt", countdownDeadline)
	setBarriers(true)
	setRaceSurfaceGuisVisible(true)
	setRaceState("Countdown")

	phaseThread = task.spawn(function()
		while token == phaseToken and raceState == "Countdown" and serverNow() < countdownDeadline do
			task.wait(0.1)
		end

		if token ~= phaseToken or raceState ~= "Countdown" then
			return
		end

		stopCountdownSound()
		countdownLabel.Text = "START!"
		task.wait(0.2)
		if token == phaseToken and raceState == "Countdown" then
			startRace(token)
		end
	end)
end

local function beginCountdown()
	cancelPhaseThread()
	setWorldAttribute("GraceEndsAt", 0)
	setWorldAttribute("CountdownEndsAt", 0)
	setRaceState("Starting")
	setBarriers(true)
	setRaceSurfaceGuisVisible(true)
	countdownLabel.Text = "STARTING"

	local token = phaseToken
	phaseThread = task.spawn(function()
		local deadline = serverNow() + PRE_COUNTDOWN_GRACE_SECONDS
		while token == phaseToken and raceState == "Starting" and serverNow() < deadline do
			task.wait(0.1)
		end

		if token == phaseToken and raceState == "Starting" then
			startActualCountdown(token)
		end
	end)
end

beginGrace = function()
	cancelPhaseThread()
	stopCountdownSound()
	resetRacePhaseState()
	setWorldAttribute("CooldownEndsAt", 0)
	finishCount = 0
	local highestJoinOrder = 0
	for _, participant in pairs(participants) do
		highestJoinOrder = math.max(highestJoinOrder, participant.order)
	end
	joinOrder = highestJoinOrder
	local token = phaseToken
	local deadline = serverNow() + GRACE_SECONDS
	setWorldAttribute("GraceEndsAt", deadline)
	setWorldAttribute("CountdownEndsAt", 0)
	setBarriers(true)
	setRaceSurfaceGuisVisible(true)
	setRaceState("Grace")

	phaseThread = task.spawn(function()
		while token == phaseToken and raceState == "Grace" and serverNow() < deadline do
			task.wait(0.25)
		end

		if token ~= phaseToken or raceState ~= "Grace" then
			return
		end

		if hasEnoughParticipants() then
			beginCountdown()
		else
			voidRace("Grace period ended below required players")
		end
	end)
end

local function canJoin(player: Player): (boolean, string)
	if raceState ~= "Open" and raceState ~= "Grace" then
		return false, "RaceClosed"
	end
	if participants[player] then
		return false, "AlreadyJoined"
	end
	if getParticipantCount() >= MAX_PLAYERS then
		return false, "RaceFull"
	end
	if player:GetAttribute("Current_World") ~= "World1" then
		return false, "WrongWorld"
	end
	if not ValidationService.IsPlayerAlive(player) then
		return false, "CharacterUnavailable"
	end

	local now = os.clock()
	local lastRequest = joinRequestLastAt[player] or 0
	if now - lastRequest < 1 then
		return false, "RateLimited"
	end
	joinRequestLastAt[player] = now
	return true, "Joined"
end

local function joinPlayer(player: Player): (boolean, string)
	local canJoinRace, reason = canJoin(player)
	if not canJoinRace then
		return false, reason
	end

	joinOrder += 1
	local participant: ParticipantState = {
		order = joinOrder,
		finished = false,
		maid = Maid.new(),
		startedAt = nil,
		startPosition = nil,
		maximumAllowedSpeed = nil,
	}
	participants[player] = participant
	setPlayerState(player, true, "Queued", nil)
	player:SetAttribute("Treadmill_Active", false)
	bindParticipantCharacter(player, participant)
	if player.Character then
		player.Character:PivotTo(getRaceSpawnCFrame(participant.order))
		ValidationService.MarkServerTeleport(player)
	end
	updatePlayerCount()

	if raceState == "Open" then
		beginGrace()
	end

	return true, "Joined"
end

local function initializePlayer(player: Player)
	if player:GetAttribute("MinigameParticipant") ~= true then
		setPlayerState(player, false, "None", nil)
	end
end

function MinigameService.Init()
	if initialized then
		return
	end
	initialized = true
	CreatorPurchaseService.Init()
	serviceMaid.ReturnToStageSuccess = ReturnToStageService.RegisterSuccessfulReturn(function(player: Player)
		removeParticipant(player, "ReturnToStageSuccess", false, "None")
	end)

	raceState = "Open"
	finishCount = 0
	joinOrder = 0
	setBarriers(true)
	setRaceSurfaceGuisVisible(true)
	resetRacePhaseState()
	setWorldAttribute("RaceState", "Open")
	setWorldAttribute("RacePlayerCount", 0)
	setWorldAttribute("RaceRequiredPlayers", REQUIRED_PLAYERS)
	setWorldAttribute("CooldownEndsAt", 0)

	serviceMaid.JoinRequest = joinRequest.OnServerEvent:Connect(function(player: Player)
		local joined, reason = joinPlayer(player)
		joinResult:FireClient(player, joined, reason)
	end)
	finishLine.CanTouch = true
	serviceMaid.FinishLine = finishLine.Touched:Connect(function(hit: BasePart)
		if raceState ~= "Racing" then
			return
		end

		local player = getPlayerFromRaceTouch(hit)
		if not player then
			return
		end

		checkPlayerForFinish(player)
	end)
	local finishScanAccumulator = 0
	serviceMaid.FinishLineScan = RunService.Heartbeat:Connect(function(deltaTime: number)
		if raceState ~= "Racing" then
			finishScanAccumulator = 0
			return
		end

		finishScanAccumulator += deltaTime
		if finishScanAccumulator < FINISH_LINE_SCAN_INTERVAL then
			return
		end
		finishScanAccumulator = 0

		for _, player in ipairs(snapshotParticipants()) do
			if raceState ~= "Racing" then
				break
			end
			checkPlayerForFinish(player)
		end
	end)
	if invisEnd and invisEnd:IsA("BasePart") then
		invisEnd.CanTouch = true
		serviceMaid.InvisEnd = invisEnd.Touched:Connect(function(hit: BasePart)
			if raceState ~= "Racing" then
				return
			end

			local player = getPlayerFromRaceTouch(hit)
			if player then
				redirectRacePlayerToFinish(player, invisEnd)
			end
		end)
	else
		DebugModule.debugWarn("Minigame.InvisEnd is missing; finish redirect disabled", MODULE_NAME)
	end
	serviceMaid.PlayerAdded = Players.PlayerAdded:Connect(initializePlayer)
	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(function(player: Player)
		joinRequestLastAt[player] = nil
		cancelReturnFreeze(player)
		removeParticipant(player, "PlayerRemoving", false)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		initializePlayer(player)
	end

	-- Start the first synchronized join window immediately so players see the
	-- real server countdown as soon as the minigame UI appears.
	beginGrace()

	serviceMaid.Cleanup = function()
		cancelPhaseThread()
		stopCountdownSound()
		setBarriers(true)
		setRaceSurfaceGuisVisible(true)
		for player in pairs(returnFreezeStates) do
			cancelReturnFreeze(player)
		end
		for _, player in ipairs(snapshotParticipants()) do
			local participant = participants[player]
			if participant then
				clearParticipant(player, participant, true, "None")
			end
		end
		participants = {}
		joinRequestLastAt = {}
	end

	DebugModule.debugPrint(
		string.format("MinigameService initialized | required=%d | max=%d", REQUIRED_PLAYERS, MAX_PLAYERS),
		MODULE_NAME
	)
end

function MinigameService.Destroy()
	if not initialized then
		return
	end

	initialized = false
	serviceMaid:DoCleaning()
	raceState = "Open"
	finishCount = 0
	joinOrder = 0
	resetRacePhaseState()
	setWorldAttribute("CooldownEndsAt", 0)
	clearFinishedPlayerStates()
	setBarriers(true)
	setRaceState("Open")
end

function MinigameService.IsRaceRunning(): boolean
	return raceState == "Racing"
end

return MinigameService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3754">
        <Properties>
          <string name="Name">PlaytimeRewardsService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local SharedFolder = Modules:WaitForChild("Shared")
local ServerSharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local Maid = require(Modules:WaitForChild("Maid"))
local PlayerHandler = require(script.Parent.Shared:WaitForChild("PlayerHandler_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local FunnelAnalytics =
	require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("FunnelAnalytics_Server"))
local CoreConfig = require(ServerSharedFolder:WaitForChild("CoreConfig_Server"))
local PlaytimeRewardsConfig = require(SharedFolder:WaitForChild("PlaytimeRewardsConfig"))

local LevelingService = require(script.Parent:WaitForChild("LevelingService"))
local EconomyAnalytics = require(script.Parent:WaitForChild("EconomyAnalytics"))

local PlaytimeRewardsService = {}

local MODULE_NAME = "PlaytimeRewardsService"
local PLAYTIME_ELAPSED_ATTRIBUTE = "PlaytimeRewardElapsed"
local TOTAL_PLAYTIME_ATTRIBUTE = "TotalPlaytimeSeconds"
local PLAYTIME_CLAIMED_ATTRIBUTE = "PlaytimeRewardsClaimed"
local TOTAL_DURATION_SECONDS = PlaytimeRewardsConfig.TOTAL_DURATION_SECONDS
local REQUEST_COOLDOWN_SECONDS = 0.15
local playtimeConfig = if CoreConfig.server and CoreConfig.server.playtimeRewards
	then CoreConfig.server.playtimeRewards
	else nil
local DEBUG_SEQUENTIAL_CLAIM_MODE = if playtimeConfig
		and typeof(playtimeConfig.debugSequentialClaimMode) == "boolean"
	then RunService:IsStudio() and playtimeConfig.debugSequentialClaimMode
	else false
local analyticsConfig = if CoreConfig.analytics then CoreConfig.analytics else nil
local analyticsFunnels = if analyticsConfig and typeof(analyticsConfig.funnels) == "table"
	then analyticsConfig.funnels
	else nil
local PLAYTIME_REWARD_FUNNEL_NAME = if analyticsFunnels and typeof(analyticsFunnels.playtimeReward) == "string"
	then analyticsFunnels.playtimeReward
	else "PlaytimeRewardClaim"

local isInitialized = false
local serviceMaid = Maid.new()
local playerMaids: { [Player]: any } = {}
local claimInFlight: { [Player]: boolean } = {}
local lastRequestAt: { [Player]: number } = {}
local claimFunnelSessions: { [Player]: string } = {}
local readyFunnelSessions: { [Player]: { [string]: string } } = {}

local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local PlaytimeRewardAction = Remotes:WaitForChild("PlaytimeRewardAction") :: RemoteEvent
local XPGainAwarded = Remotes:WaitForChild("XPGainAwarded") :: RemoteEvent
local WinButtonPressed = Remotes:WaitForChild("WinButtonPressed") :: RemoteEvent
local ShowNotification = Remotes:WaitForChild("ShowNotification") :: RemoteEvent

local function parseClaimedTiers(value: any): { [string]: boolean }
	local claimed: { [string]: boolean } = {}
	if typeof(value) ~= "string" or value == "" then
		return claimed
	end

	for token in string.gmatch(value, "([^,]+)") do
		if token ~= "" then
			claimed[token] = true
		end
	end

	return claimed
end

local function serializeClaimedTiers(claimed: { [string]: boolean }): string
	local orderedIds = {}
	for _, tier in ipairs(PlaytimeRewardsConfig.TIERS) do
		if claimed[tier.id] == true then
			table.insert(orderedIds, tier.id)
		end
	end
	return table.concat(orderedIds, ",")
end

local function applyRewardGrant(player: Player, kind: string, amount: number)
	if kind == "XPSpeed" then
		local awardedAmount = PlayerHandler.AddRewardXPSpeed(player, amount)
		EconomyAnalytics.LogSource(
			player,
			"XPSpeed",
			awardedAmount,
			Enum.AnalyticsEconomyTransactionType.TimedReward.Name,
			"PlaytimeReward",
			{ customField01 = kind }
		)
		XPGainAwarded:FireClient(player, awardedAmount)
		return
	end

	if kind == "Wins" then
		local awardedWins = PlayerHandler.AddPlaytimeWins(player, amount)
		EconomyAnalytics.LogSource(
			player,
			"Wins",
			awardedWins,
			Enum.AnalyticsEconomyTransactionType.TimedReward.Name,
			"PlaytimeReward",
			{ customField01 = kind }
		)
		WinButtonPressed:FireClient(player, awardedWins, "PlaytimeReward")
		return
	end

	if kind == "Level" then
		PlayerHandler.AddLevels(player, amount)
		return
	end

	if kind == "Rebirth" then
		for _ = 1, amount do
			LevelingService.PerformRebirth(player, true)
		end
		return
	end

	DebugModule.debugWarn(
		string.format("Unsupported playtime reward kind '%s' for %s", tostring(kind), player.Name),
		MODULE_NAME
	)
end

local function getTierIndexById(tierId: string): number?
	for index, tier in ipairs(PlaytimeRewardsConfig.TIERS) do
		if tier.id == tierId then
			return index
		end
	end
	return nil
end

local function getFirstUnclaimedTierIndex(claimed: { [string]: boolean }): number?
	for index, tier in ipairs(PlaytimeRewardsConfig.TIERS) do
		if claimed[tier.id] ~= true then
			return index
		end
	end
	return nil
end

local function getTierFields(tierId: string)
	return {
		customField01 = tierId,
	}
end

local function getReadySession(player: Player, tierId: string): string?
	local playerSessions = readyFunnelSessions[player]
	return playerSessions and playerSessions[tierId] or nil
end

local function setReadySession(player: Player, tierId: string, sessionId: string)
	local playerSessions = readyFunnelSessions[player]
	if not playerSessions then
		playerSessions = {}
		readyFunnelSessions[player] = playerSessions
	end

	playerSessions[tierId] = sessionId
end

local function recordRewardReady(player: Player, tierId: string)
	if getReadySession(player, tierId) then
		return
	end

	local sessionId = FunnelAnalytics.OpenRecurringFunnel(
		player,
		PLAYTIME_REWARD_FUNNEL_NAME,
		"Playtime Reward Ready",
		getTierFields(tierId)
	)
	if sessionId then
		setReadySession(player, tierId, sessionId)
	end
end

local function recordReadyRewards(player: Player)
	local claimed = parseClaimedTiers(player:GetAttribute(PLAYTIME_CLAIMED_ATTRIBUTE))
	local elapsedSeconds = player:GetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE)
	if typeof(elapsedSeconds) ~= "number" then
		elapsedSeconds = 0
	end

	for _, tier in ipairs(PlaytimeRewardsConfig.TIERS) do
		if claimed[tier.id] ~= true and elapsedSeconds >= tier.unlockSeconds then
			recordRewardReady(player, tier.id)
		end
	end
end

function PlaytimeRewardsService.OnRewardAction(player: Player, action: string, tierId: string)
	if typeof(action) ~= "string" or typeof(tierId) ~= "string" then
		return
	end

	if action ~= "Claim" then
		return
	end

	local now = os.clock()
	local lastRequest = lastRequestAt[player] or 0
	if now - lastRequest < REQUEST_COOLDOWN_SECONDS then
		return
	end
	lastRequestAt[player] = now

	if player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	if claimInFlight[player] == true then
		return
	end

	local tier = PlaytimeRewardsConfig.GetTierById(tierId)
	if not tier then
		return
	end

	local tierIndex = getTierIndexById(tierId)
	if not tierIndex then
		return
	end

	local claimed = parseClaimedTiers(player:GetAttribute(PLAYTIME_CLAIMED_ATTRIBUTE))
	if claimed[tierId] == true then
		return
	end

	local isReady = false

	local elapsedSeconds = player:GetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE)
	if typeof(elapsedSeconds) ~= "number" then
		elapsedSeconds = 0
	end

	if DEBUG_SEQUENTIAL_CLAIM_MODE then
		local expectedTierIndex = getFirstUnclaimedTierIndex(claimed)
		if not expectedTierIndex then
			return
		end

		if tierIndex ~= expectedTierIndex then
			ShowNotification:FireClient(player, "CLAIM THE PREVIOUS GIFT FIRST!", "Red")
			return
		end

		-- Debug mode: current unclaimed tier is always claimable.
		isReady = true
	else
		isReady = elapsedSeconds >= tier.unlockSeconds
	end

	if not isReady then
		ShowNotification:FireClient(player, "REWARD NOT READY!", "Red")
		return
	end

	local claimSessionId = getReadySession(player, tierId)
	if claimSessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			PLAYTIME_REWARD_FUNNEL_NAME,
			claimSessionId,
			2,
			"Playtime Reward Claim Clicked",
			getTierFields(tierId)
		)
	else
		claimSessionId = FunnelAnalytics.OpenRecurringFunnel(
			player,
			PLAYTIME_REWARD_FUNNEL_NAME,
			"Playtime Reward Claim Clicked",
			getTierFields(tierId)
		)
	end
	if claimSessionId then
		claimFunnelSessions[player] = claimSessionId
	end

	claimInFlight[player] = true
	local grantSuccess, grantError = pcall(function()
		for _, reward in ipairs(tier.rewards) do
			applyRewardGrant(player, reward.kind, reward.amount)
		end
	end)
	claimInFlight[player] = nil

	if not grantSuccess then
		claimFunnelSessions[player] = nil
		DebugModule.debugWarn(
			string.format(
				"Playtime reward claim failed | player=%s tier=%s err=%s",
				player.Name,
				tierId,
				tostring(grantError)
			),
			MODULE_NAME
		)
		ShowNotification:FireClient(player, "REWARD CLAIM FAILED!", "Red")
		return
	end

	claimed[tierId] = true
	local cycleComplete = getFirstUnclaimedTierIndex(claimed) == nil
	if cycleComplete then
		-- Start a new reward cycle only after every gift has been claimed.
		-- This also protects lower gifts when the final gift is claimed early.
		player:SetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE, 0)
		player:SetAttribute(PLAYTIME_CLAIMED_ATTRIBUTE, "")
	else
		player:SetAttribute(PLAYTIME_CLAIMED_ATTRIBUTE, serializeClaimedTiers(claimed))
	end

	if DEBUG_SEQUENTIAL_CLAIM_MODE and not cycleComplete then
		local nextTier = PlaytimeRewardsConfig.GetTier(tierIndex + 1)
		if nextTier then
			local currentElapsed = player:GetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE)
			local elapsed = if typeof(currentElapsed) == "number" then currentElapsed else 0
			local debugElapsed = math.max(elapsed, nextTier.unlockSeconds)
			player:SetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE, math.clamp(debugElapsed, 0, TOTAL_DURATION_SECONDS))
		else
			player:SetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE, TOTAL_DURATION_SECONDS)
		end
	end

	if claimSessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			PLAYTIME_REWARD_FUNNEL_NAME,
			claimSessionId,
			if getReadySession(player, tierId) then 3 else 2,
			"Playtime Reward Claimed",
			getTierFields(tierId)
		)
	end
	local playerReadySessions = readyFunnelSessions[player]
	if playerReadySessions then
		if cycleComplete then
			table.clear(playerReadySessions)
		else
			playerReadySessions[tierId] = nil
		end
	end
	claimFunnelSessions[player] = nil

	ShowNotification:FireClient(player, "REWARD CLAIMED!", "Green")
end

function PlaytimeRewardsService.OnPlayerAdded(player: Player)
	PlaytimeRewardsService.CleanupPlayer(player)

	local playerMaid = Maid.new()
	playerMaids[player] = playerMaid

	local existingElapsed = player:GetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE)
	local elapsedValue = if typeof(existingElapsed) == "number"
		then math.clamp(math.floor(existingElapsed), 0, TOTAL_DURATION_SECONDS)
		else 0
	local existingTotalPlaytime = player:GetAttribute(TOTAL_PLAYTIME_ATTRIBUTE)
	local totalPlaytimeValue = if typeof(existingTotalPlaytime) == "number"
		then math.max(0, math.floor(existingTotalPlaytime))
		else 0
	local existingClaimed = player:GetAttribute(PLAYTIME_CLAIMED_ATTRIBUTE)
	local claimedValue = if typeof(existingClaimed) == "string" then existingClaimed else ""

	player:SetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE, elapsedValue)
	player:SetAttribute(TOTAL_PLAYTIME_ATTRIBUTE, totalPlaytimeValue)
	player:SetAttribute(PLAYTIME_CLAIMED_ATTRIBUTE, claimedValue)
	recordReadyRewards(player)

	playerMaid.TimerThread = task.spawn(function()
		while player.Parent do
			task.wait(1)
			if not player.Parent then
				break
			end

			local currentElapsed = player:GetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE)
			if typeof(currentElapsed) ~= "number" then
				currentElapsed = 0
			end

			local clampedElapsed = math.clamp(math.floor(currentElapsed), 0, TOTAL_DURATION_SECONDS)
			local currentTotalPlaytime = player:GetAttribute(TOTAL_PLAYTIME_ATTRIBUTE)
			if typeof(currentTotalPlaytime) ~= "number" then
				currentTotalPlaytime = 0
			end

			player:SetAttribute(TOTAL_PLAYTIME_ATTRIBUTE, math.max(0, math.floor(currentTotalPlaytime)) + 1)

			if clampedElapsed < TOTAL_DURATION_SECONDS then
				player:SetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE, clampedElapsed + 1)
				recordReadyRewards(player)
			elseif currentElapsed ~= TOTAL_DURATION_SECONDS then
				player:SetAttribute(PLAYTIME_ELAPSED_ATTRIBUTE, TOTAL_DURATION_SECONDS)
			end
		end
	end)
end

function PlaytimeRewardsService.CleanupPlayer(player: Player)
	local playerMaid = playerMaids[player]
	if playerMaid then
		playerMaid:DoCleaning()
		playerMaids[player] = nil
	end
	claimFunnelSessions[player] = nil
	readyFunnelSessions[player] = nil
	claimInFlight[player] = nil
	lastRequestAt[player] = nil
end

function PlaytimeRewardsService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	serviceMaid.RewardAction = PlaytimeRewardAction.OnServerEvent:Connect(PlaytimeRewardsService.OnRewardAction)
	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(PlaytimeRewardsService.CleanupPlayer)
	DebugModule.debugInfo("PlaytimeRewardsService initialized", MODULE_NAME)
end

function PlaytimeRewardsService.Shutdown()
	for player in pairs(table.clone(playerMaids)) do
		PlaytimeRewardsService.CleanupPlayer(player)
	end
	serviceMaid:DoCleaning()
	table.clear(claimInFlight)
	table.clear(lastRequestAt)
	isInitialized = false
end

return PlaytimeRewardsService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3755">
        <Properties>
          <string name="Name">ProductServerService</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local ProductService = require(script.Parent.Shared:WaitForChild("ProductService_Server"))
local DebugModule = require(game:GetService("ReplicatedStorage").Modules:WaitForChild("DebugModule"))
local SystemChatService =
	require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("SystemChatService_Server"))
local Maid = require(Modules:WaitForChild("Maid"))
local DataStoreRequestGate = require(script.Parent:WaitForChild("DataStoreRequestGate"))
local SharedFolder = game:GetService("ServerScriptService").Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Server"))

local ProductServerService = {}

-- CONFIG
local MODULE_NAME = "ProductServerService"
local isInitialized = false
local PLAYER_STORE_NAME = ProductService.DataStores["PlayerStats"]
local playerStore = DataStoreService:GetDataStore(PLAYER_STORE_NAME)
local receiptStore = DataStoreService:GetDataStore("ProcessedDevProductReceipts_v1")
local RECEIPT_RESERVATION_LEASE_SECONDS = 120
local serverLockIdentity = game.JobId ~= "" and game.JobId or ("studio-" .. HttpService:GenerateGUID(false))
local receiptJobId = serverLockIdentity
local SESSION_LOCK_ID_METADATA_KEY = "SessionLockId"
local SESSION_LOCK_UPDATED_AT_METADATA_KEY = "SessionLockUpdatedAt"
local PROCESSED_RECEIPTS_FIELD = "ProcessedDevProductReceipts"
local PROFILE_INITIALIZED_FIELD = "ProfileInitialized"
local PROFILE_PLACEHOLDER_FIELD = "ProfilePlaceholder"
local PROFILE_PLACEHOLDER_CREATED_AT_FIELD = "ProfilePlaceholderCreatedAt"
local persistenceConfig = CoreConfig.persistence
local SAVE_DEBOUNCE_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.saveDebounceSeconds) == "number"
	then math.max(0, persistenceConfig.saveDebounceSeconds)
	else 10
local LOAD_RETRY_ATTEMPTS = if persistenceConfig and typeof(persistenceConfig.loadRetryAttempts) == "number"
	then math.max(1, math.floor(persistenceConfig.loadRetryAttempts))
	else 3
local LOAD_RETRY_DELAY_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.loadRetryDelaySeconds) == "number"
	then math.max(0, persistenceConfig.loadRetryDelaySeconds)
	else 1
local FINAL_SAVE_RETRY_ATTEMPTS = if persistenceConfig
		and typeof(persistenceConfig.finalSaveRetryAttempts) == "number"
	then math.max(1, math.floor(persistenceConfig.finalSaveRetryAttempts))
	else 3
local FINAL_SAVE_RETRY_DELAY_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.finalSaveRetryDelaySeconds) == "number"
	then math.max(0, persistenceConfig.finalSaveRetryDelaySeconds)
	else 1
local REGULAR_SAVE_RETRY_INITIAL_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.regularSaveRetryInitialSeconds) == "number"
	then math.max(0.25, persistenceConfig.regularSaveRetryInitialSeconds)
	else 2
local REGULAR_SAVE_RETRY_ATTEMPTS = if persistenceConfig
		and typeof(persistenceConfig.regularSaveRetryAttempts) == "number"
	then math.max(1, math.floor(persistenceConfig.regularSaveRetryAttempts))
	else 6
local REGULAR_SAVE_RETRY_MAX_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.regularSaveRetryMaxSeconds) == "number"
	then math.max(REGULAR_SAVE_RETRY_INITIAL_SECONDS, persistenceConfig.regularSaveRetryMaxSeconds)
	else 30
local DATASTORE_BUDGET_WAIT_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.datastoreBudgetWaitSeconds) == "number"
	then math.max(0.25, persistenceConfig.datastoreBudgetWaitSeconds)
	else 5
local GRANTED_RECEIPT_CACHE_LIMIT = if persistenceConfig
		and typeof(persistenceConfig.grantedReceiptCacheLimit) == "number"
	then math.max(0, math.floor(persistenceConfig.grantedReceiptCacheLimit))
	else 256
local SESSION_LOCK_RECOVERY_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.sessionLockRecoverySeconds) == "number"
	then math.max(15, math.floor(persistenceConfig.sessionLockRecoverySeconds))
	else 60
local SESSION_LOCK_RETRY_DELAY_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.sessionLockRetryDelaySeconds) == "number"
	then math.max(0.1, persistenceConfig.sessionLockRetryDelaySeconds)
	else 1
local SESSION_LOCK_RETRY_MAX_DELAY_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.sessionLockRetryMaxDelaySeconds) == "number"
	then math.max(SESSION_LOCK_RETRY_DELAY_SECONDS, persistenceConfig.sessionLockRetryMaxDelaySeconds)
	else 5
local SESSION_LOCK_WAIT_GRACE_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.sessionLockWaitGraceSeconds) == "number"
	then math.max(1, persistenceConfig.sessionLockWaitGraceSeconds)
	else 10
local SESSION_LOCK_HEARTBEAT_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.sessionLockHeartbeatSeconds) == "number"
	then math.max(5, math.floor(persistenceConfig.sessionLockHeartbeatSeconds))
	else 15
local DURABLE_RECEIPT_HISTORY_LIMIT = if persistenceConfig
		and typeof(persistenceConfig.durableReceiptHistoryLimit) == "number"
	then math.max(1, math.floor(persistenceConfig.durableReceiptHistoryLimit))
	else 128
local DEBUG_VERBOSE = persistenceConfig and persistenceConfig.debugVerbose == true

-- STATE
type StoredPlayerData = { [string]: any }
type StoredDataMutator = (data: StoredPlayerData) -> StoredPlayerData
type LoadResult = "Loaded" | "New" | "LegacyMigration" | "Failed" | "RecoveryRequired"
type LoadState = "Loading" | LoadResult
type SessionAcquireResult = "Acquired" | "Locked" | "Malformed" | "Failed"
type Metadata = { [string]: any }
type PlayerStoreQueue = {
	busy: boolean,
	waiters: { thread },
}
local lastSaveTimes: { [Player]: number } = {}
local pendingSaveTasks: { [Player]: boolean } = {}
local pendingSaveThreads: { [Player]: thread } = {}
local activeSaveLocks: { [Player]: boolean } = {}
local saveGenerations: { [Player]: number } = {}
local loadStates: { [Player]: LoadState } = {}
local sessionLockIds: { [Player]: string } = {}
local invalidatedSessions: { [Player]: boolean } = {}
local blockedSaveWarnings: { [Player]: boolean } = {}
local blockedSaveWarningTimes: { [Player]: number } = {}
local BLOCKED_SAVE_WARNING_INTERVAL_SECONDS = 30
local devProductCallbacks: { [number]: (...any) -> () } = {}
local gamePassCallbacks: { [number]: (...any) -> () } = {}
local marketplaceInfoCache: { [string]: any } = {}
local processingReceipts: { [string]: boolean } = {}
local grantedReceipts: { [string]: boolean } = {}
local grantedReceiptOrder: { string } = {}
local processedProfileReceipts: { [Player]: { [string]: boolean } } = {}
local processedProfileReceiptOrder: { [Player]: { string } } = {}
local announcedGamePasses: { [Player]: { [number]: boolean } } = {}
local creatorGrantLocks: { [Player]: boolean } = {}
local playerStoreQueues: { [number]: PlayerStoreQueue } = {}
local heartbeatTokens: { [Player]: number } = {}
local heartbeatInFlight: { [Player]: boolean } = {}
local heartbeatFailureCounts: { [Player]: number } = {}
local activePlayerSessions: { [number]: Player } = {}
local persistedAttributeConnections: { [Player]: { RBXScriptConnection } } = {}
local creatorUserId: number? = nil
local serviceMaid = Maid.new()
local serviceShuttingDown = false
local sessionLockHeartbeatGeneration = 0

local function runStandardUpdate(
	operationName: string,
	operation: () -> any,
	shouldContinue: (() -> boolean)?
): (boolean, any, any, any)
	return DataStoreRequestGate.Run("StandardUpdate", operationName, operation, {
		maxWaitSeconds = DATASTORE_BUDGET_WAIT_SECONDS,
		shouldContinue = shouldContinue,
	})
end

local function dataKeyForUserId(userId: number): string
	return "player_" .. tostring(userId)
end

local function dataKey(player: Player): string
	return dataKeyForUserId(player.UserId)
end

local function debugVerbose(message: string)
	if DEBUG_VERBOSE then
		DebugModule.debugPrint(message, MODULE_NAME)
	end
end

local function acquirePlayerStoreQueue(userId: number, operationName: string): PlayerStoreQueue
	local queue = playerStoreQueues[userId]
	if queue == nil then
		queue = {
			busy = false,
			waiters = {},
		}
		playerStoreQueues[userId] = queue
	end

	if queue.busy then
		local waitStartedAt = os.clock()
		local currentThread = coroutine.running()
		assert(currentThread ~= nil, "Player datastore operations must run in a yielding thread")
		table.insert(queue.waiters, currentThread)
		debugVerbose(
			"Datastore operation queued | userId="
				.. tostring(userId)
				.. " | operation="
				.. operationName
				.. " | position="
				.. tostring(#queue.waiters)
		)
		coroutine.yield()
		debugVerbose(
			"Datastore queue resumed | userId="
				.. tostring(userId)
				.. " | operation="
				.. operationName
				.. " | waitedSeconds="
				.. string.format("%.2f", os.clock() - waitStartedAt)
		)
	end

	queue.busy = true
	return queue
end

local function releasePlayerStoreQueue(userId: number, queue: PlayerStoreQueue)
	while #queue.waiters > 0 do
		local nextThread = table.remove(queue.waiters, 1)
		if nextThread and coroutine.status(nextThread) == "suspended" then
			task.defer(function()
				local ok, err = coroutine.resume(nextThread)
				if not ok then
					DebugModule.debugError(
						"Player datastore queue waiter failed | userId=" .. tostring(userId),
						err,
						MODULE_NAME
					)
				end
			end)
			return
		end
	end

	queue.busy = false
	if playerStoreQueues[userId] == queue then
		playerStoreQueues[userId] = nil
	end
end

local function runQueuedPlayerStoreOperation(
	userId: number,
	operationName: string,
	operation: () -> any
): (boolean, any)
	local operationStartedAt = os.clock()
	local queue = acquirePlayerStoreQueue(userId, operationName)
	debugVerbose("Datastore operation started | userId=" .. tostring(userId) .. " | operation=" .. operationName)
	local ok, result = pcall(operation)
	releasePlayerStoreQueue(userId, queue)
	debugVerbose(
		"Datastore operation finished | userId="
			.. tostring(userId)
			.. " | operation="
			.. operationName
			.. " | success="
			.. tostring(ok)
			.. " | elapsedSeconds="
			.. string.format("%.2f", os.clock() - operationStartedAt)
	)
	return ok, result
end

local function cloneMetadata(keyInfo: any): Metadata
	if keyInfo == nil then
		return {}
	end

	local ok, metadata = pcall(function()
		return keyInfo:GetMetadata()
	end)
	if not ok or typeof(metadata) ~= "table" then
		return {}
	end
	return table.clone(metadata)
end

local function cloneUserIds(keyInfo: any): { any }
	if keyInfo == nil then
		return {}
	end

	local ok, userIds = pcall(function()
		return keyInfo:GetUserIds()
	end)
	if not ok or typeof(userIds) ~= "table" then
		return {}
	end
	return table.clone(userIds)
end

local function isSessionLockActive(metadata: Metadata, expectedLockId: string?): boolean
	local lockId = metadata[SESSION_LOCK_ID_METADATA_KEY]
	if typeof(lockId) ~= "string" or lockId == "" or lockId == expectedLockId then
		return false
	end

	local updatedAt = metadata[SESSION_LOCK_UPDATED_AT_METADATA_KEY]
	if typeof(updatedAt) ~= "number" then
		return false
	end
	return os.time() - math.floor(updatedAt) < SESSION_LOCK_RECOVERY_SECONDS
end

local function setSessionLockMetadata(metadata: Metadata, lockId: string?)
	if lockId == nil then
		metadata[SESSION_LOCK_ID_METADATA_KEY] = nil
		metadata[SESSION_LOCK_UPDATED_AT_METADATA_KEY] = nil
		return
	end

	metadata[SESSION_LOCK_ID_METADATA_KEY] = lockId
	metadata[SESSION_LOCK_UPDATED_AT_METADATA_KEY] = os.time()
end

local function sessionLockIdForPlayer(player: Player): string
	return serverLockIdentity .. ":" .. tostring(player.UserId) .. ":" .. HttpService:GenerateGUID(false)
end

local function loadProcessedReceiptHistory(player: Player, data: StoredPlayerData?)
	local receiptSet: { [string]: boolean } = {}
	local receiptOrder: { string } = {}
	local storedReceipts = if data then data[PROCESSED_RECEIPTS_FIELD] else nil
	if typeof(storedReceipts) == "table" then
		for _, receiptId in ipairs(storedReceipts) do
			if typeof(receiptId) == "string" and receiptId ~= "" and not receiptSet[receiptId] then
				receiptSet[receiptId] = true
				table.insert(receiptOrder, receiptId)
				if #receiptOrder >= DURABLE_RECEIPT_HISTORY_LIMIT then
					break
				end
			end
		end
	end
	processedProfileReceipts[player] = receiptSet
	processedProfileReceiptOrder[player] = receiptOrder
end

local function hasProcessedProfileReceipt(player: Player, receiptId: string): boolean
	local receiptSet = processedProfileReceipts[player]
	return receiptSet ~= nil and receiptSet[receiptId] == true
end

local function markProcessedProfileReceipt(player: Player, receiptId: string)
	local receiptSet = processedProfileReceipts[player]
	local receiptOrder = processedProfileReceiptOrder[player]
	if receiptSet == nil or receiptOrder == nil then
		receiptSet = {}
		receiptOrder = {}
		processedProfileReceipts[player] = receiptSet
		processedProfileReceiptOrder[player] = receiptOrder
	end
	if receiptSet[receiptId] then
		return
	end

	receiptSet[receiptId] = true
	table.insert(receiptOrder, receiptId)
	while #receiptOrder > DURABLE_RECEIPT_HISTORY_LIMIT do
		local oldestReceiptId = table.remove(receiptOrder, 1)
		if oldestReceiptId then
			receiptSet[oldestReceiptId] = nil
		end
	end
end

local function createStoredDataSnapshot(player: Player): (StoredPlayerData?, string?)
	local data: StoredPlayerData = {}
	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		local value = player:GetAttribute(entry.name)
		if value == nil then
			return nil, entry.name
		end
		data[entry.name] = value
	end

	local receiptOrder = processedProfileReceiptOrder[player] or {}
	data[PROCESSED_RECEIPTS_FIELD] = table.clone(receiptOrder)
	data[PROFILE_INITIALIZED_FIELD] = true
	data[PROFILE_PLACEHOLDER_FIELD] = nil
	data[PROFILE_PLACEHOLDER_CREATED_AT_FIELD] = nil
	return data, nil
end

local function hasSavedProfileValues(data: StoredPlayerData): boolean
	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		if data[entry.name] ~= nil then
			return true
		end
	end

	return false
end

local PROFILE_ANCHOR_FIELDS: { string } = {
	"CurrentLevel",
	"MaxLevel",
	"AllXPSpeed",
	"MaxXPSpeed",
	"CurrentXPSpeed",
	"WinCount",
	"OwnedKarts",
	"Kart_Equipped",
	"Trail_Equipped",
	"OwnedTrails",
	"Current_World",
	"CurrentStage",
}

local savedAttributeDefaults: { [string]: any } = {}
for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
	savedAttributeDefaults[entry.name] = entry.default
end

local function isFiniteNumber(value: any): boolean
	return typeof(value) == "number" and value == value and value > -math.huge and value < math.huge
end

local function validateProfilePlaceholder(data: StoredPlayerData): (boolean, string?)
	if data[PROFILE_PLACEHOLDER_FIELD] ~= true then
		return false, "profile is not a new-profile placeholder"
	end
	if data[PROFILE_INITIALIZED_FIELD] ~= false then
		return false, PROFILE_INITIALIZED_FIELD .. " must be false for a placeholder"
	end
	if not isFiniteNumber(data[PROFILE_PLACEHOLDER_CREATED_AT_FIELD]) then
		return false, PROFILE_PLACEHOLDER_CREATED_AT_FIELD .. " is missing or invalid"
	end
	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		if data[entry.name] ~= nil then
			return false, "placeholder contains saved profile field " .. entry.name
		end
	end
	return true, nil
end

local function validateStoredProfileData(data: StoredPlayerData): (boolean, string?)
	if data[PROFILE_INITIALIZED_FIELD] ~= nil and typeof(data[PROFILE_INITIALIZED_FIELD]) ~= "boolean" then
		return false, PROFILE_INITIALIZED_FIELD .. " has an invalid type"
	end
	if data[PROFILE_PLACEHOLDER_FIELD] ~= nil and typeof(data[PROFILE_PLACEHOLDER_FIELD]) ~= "boolean" then
		return false, PROFILE_PLACEHOLDER_FIELD .. " has an invalid type"
	end
	if data[PROFILE_PLACEHOLDER_CREATED_AT_FIELD] ~= nil
		and not isFiniteNumber(data[PROFILE_PLACEHOLDER_CREATED_AT_FIELD])
	then
		return false, PROFILE_PLACEHOLDER_CREATED_AT_FIELD .. " is invalid"
	end

	for _, fieldName in ipairs(PROFILE_ANCHOR_FIELDS) do
		local value = data[fieldName]
		if value == nil then
			return false, "missing required profile field " .. fieldName
		end

		local defaultValue = savedAttributeDefaults[fieldName]
		if defaultValue == nil then
			return false, "required profile field is not persisted " .. fieldName
		end
		if typeof(value) ~= typeof(defaultValue) then
			return false, fieldName .. " has type " .. typeof(value) .. ", expected " .. typeof(defaultValue)
		end
		if typeof(value) == "number" and not isFiniteNumber(value) then
			return false, fieldName .. " is not finite"
		end
	end

	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		local value = data[entry.name]
		if value ~= nil then
			if typeof(value) ~= typeof(entry.default) then
				return false, entry.name .. " has an invalid type"
			end
			if typeof(value) == "number" and not isFiniteNumber(value) then
				return false, entry.name .. " is not finite"
			end
		end
	end

	local storedReceipts = data[PROCESSED_RECEIPTS_FIELD]
	if storedReceipts ~= nil and typeof(storedReceipts) ~= "table" then
		return false, PROCESSED_RECEIPTS_FIELD .. " has an invalid type"
	end

	return true, nil
end

local function classifyProfileData(data: StoredPlayerData, createdNew: boolean): (LoadResult, string?)
	if createdNew then
		return "New", nil
	end

	if data[PROFILE_PLACEHOLDER_FIELD] == true and data[PROFILE_INITIALIZED_FIELD] ~= true then
		local placeholderValid, placeholderReason = validateProfilePlaceholder(data)
		if placeholderValid then
			return "New", nil
		end
		return "RecoveryRequired", placeholderReason
	end

	local valid, validationReason = validateStoredProfileData(data)
	if not valid then
		return "RecoveryRequired", validationReason
	end
	if data[PROFILE_INITIALIZED_FIELD] == true then
		return "Loaded", nil
	end
	if hasSavedProfileValues(data) then
		-- Legacy profiles predate ProfileInitialized. Their stored values are
		-- authoritative and will be migrated through the active session lock.
		return "LegacyMigration", nil
	end

	-- This shape is only produced by an interrupted first-profile placeholder.
	-- Never turn it into defaults without a durable source profile.
	return "RecoveryRequired", "profile has no durable saved attributes"
end

local function cancelPendingSaveThread(player: Player)
	-- In-flight UpdateAsync calls must finish; generation invalidation cancels delayed work safely.
	pendingSaveThreads[player] = nil
	pendingSaveTasks[player] = nil
	saveGenerations[player] = (saveGenerations[player] or 0) + 1
end

local function invalidateSession(player: Player, reason: string)
	local userId = player.UserId
	if invalidatedSessions[player] or player.Parent == nil then
		return
	end

	invalidatedSessions[player] = true
	player:SetAttribute("Data_Loaded", false)
	player:SetAttribute("Data_LoadState", "Unavailable")
	DebugModule.debugWarn(
		"Persistence session invalidated | player="
			.. player.Name
			.. " | userId="
			.. tostring(userId)
			.. " | reason="
			.. reason,
		MODULE_NAME
	)
end

local function releaseSessionLock(player: Player, reason: string): boolean
	local userId = player.UserId
	local lockId = sessionLockIds[player]
	if lockId == nil then
		return true
	end

	debugVerbose("Session lock release requested | player=" .. player.Name .. " | reason=" .. reason)
	local queuedOk, outcome = runQueuedPlayerStoreOperation(userId, "ReleaseSessionLock", function()
		local released = false
		local ok, err = pcall(function()
			local gateOk, gateResult = runStandardUpdate("ReleaseSessionLock", function()
				return playerStore:UpdateAsync(dataKey(player), function(existingData, keyInfo)
					local metadata = cloneMetadata(keyInfo)
					if metadata[SESSION_LOCK_ID_METADATA_KEY] ~= lockId then
						return nil
					end
					setSessionLockMetadata(metadata, nil)
					released = true
					return existingData, cloneUserIds(keyInfo), metadata
				end)
			end)
			if not gateOk then
				error(gateResult)
			end
		end)
		return {
			ok = ok,
			err = err,
			released = released,
		}
	end)
	if not queuedOk or typeof(outcome) ~= "table" or outcome.ok ~= true then
		DebugModule.debugWarn(
			"Session lock release failed | player="
				.. player.Name
				.. " | reason="
				.. reason
				.. " | err="
				.. tostring(if typeof(outcome) == "table" then outcome.err else outcome),
			MODULE_NAME
		)
		return false
	end
	if outcome.released ~= true then
		DebugModule.debugWarn(
			"Session lock release skipped because ownership changed | player=" .. player.Name .. " | reason=" .. reason,
			MODULE_NAME
		)
		return false
	end

	sessionLockIds[player] = nil
	debugVerbose("Session lock released | player=" .. player.Name .. " | reason=" .. reason)
	return true
end

local function acquireSessionLock(player: Player): (SessionAcquireResult, StoredPlayerData?, any?, boolean, string?)
	local userId = player.UserId
	local desiredLockId = sessionLockIdForPlayer(player)
	local result: SessionAcquireResult = "Failed"
	local createdNew = false
	local storedData: any = nil
	local storedKeyInfo: any = nil
	local lockContext: string? = nil

	debugVerbose("Session lock acquisition requested | player=" .. player.Name .. " | userId=" .. tostring(userId))
	local queuedOk, outcome = runQueuedPlayerStoreOperation(userId, "AcquireSessionLock", function()
		local ok, err = pcall(function()
			local gateOk, gateResult, gateKeyInfo = runStandardUpdate("AcquireSessionLock", function()
				return playerStore:UpdateAsync(dataKey(player), function(existingData, keyInfo)
					local metadata = cloneMetadata(keyInfo)
					if isSessionLockActive(metadata, desiredLockId) then
						local updatedAt = metadata[SESSION_LOCK_UPDATED_AT_METADATA_KEY]
						local lockAge = if typeof(updatedAt) == "number"
							then math.max(0, os.time() - math.floor(updatedAt))
							else -1
						lockContext = "activeLockAge=" .. tostring(lockAge)
						result = "Locked"
						return nil
					end
					if existingData ~= nil and typeof(existingData) ~= "table" then
						result = "Malformed"
						return nil
					end

					createdNew = existingData == nil
					local nextData: StoredPlayerData = if typeof(existingData) == "table"
						then table.clone(existingData)
						else {
							[PROFILE_INITIALIZED_FIELD] = false,
							[PROFILE_PLACEHOLDER_FIELD] = true,
							[PROFILE_PLACEHOLDER_CREATED_AT_FIELD] = os.time(),
						}
					setSessionLockMetadata(metadata, desiredLockId)
					result = "Acquired"
					return nextData, cloneUserIds(keyInfo), metadata
				end)
			end)
			if not gateOk then
				error(gateResult)
			end
			storedData = gateResult
			storedKeyInfo = gateKeyInfo
		end)
		return {
			ok = ok,
			err = err,
		}
	end)
	if not queuedOk or typeof(outcome) ~= "table" or outcome.ok ~= true then
		return "Failed", nil, nil, false, tostring(if typeof(outcome) == "table" then outcome.err else outcome)
	end
	if result ~= "Acquired" or typeof(storedData) ~= "table" then
		return result, nil, storedKeyInfo, false, lockContext
	end

	sessionLockIds[player] = desiredLockId
	debugVerbose(
		"Session lock acquired | player="
			.. player.Name
			.. " | userId="
			.. tostring(userId)
			.. " | newProfile="
			.. tostring(createdNew)
	)
	return "Acquired", storedData, storedKeyInfo, createdNew, nil
end

local function isDataLoaded(player: Player): boolean
	if player:GetAttribute("Data_Loaded") ~= true then
		return false
	end

	local state = loadStates[player]
	return state == nil or state == "Loaded" or state == "New" or state == "LegacyMigration"
end

local function isExperienceCreator(player: Player): boolean
	return creatorUserId ~= nil and player.UserId == creatorUserId
end

local function isCanonicalDeveloperProduct(productId: number): boolean
	for _, configuredProductId in pairs(ProductService.DevProducts) do
		if configuredProductId == productId then
			return true
		end
	end
	return false
end

local function canPersistPlayerData(player: Player, allowPendingInitialization: boolean): boolean
	if isDataLoaded(player) then
		return true
	end

	if not allowPendingInitialization or player.Parent == nil then
		return false
	end

	local state = loadStates[player]
	return state == "New" or state == "LegacyMigration"
end

local function disconnectPersistedAttributeListeners(player: Player)
	local connections = persistedAttributeConnections[player]
	if not connections then
		return
	end

	for _, connection in ipairs(connections) do
		connection:Disconnect()
	end
	persistedAttributeConnections[player] = nil
end

local function bindPersistedAttributeListeners(player: Player)
	if persistedAttributeConnections[player] then
		return
	end

	local connections: { RBXScriptConnection } = {}
	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		table.insert(
			connections,
			player:GetAttributeChangedSignal(entry.name):Connect(function()
				if player.Parent ~= nil and isDataLoaded(player) and not serviceShuttingDown then
					ProductServerService.SavePlayerData(player)
				end
			end)
		)
	end
	persistedAttributeConnections[player] = connections
end

local function cacheGrantedReceipt(receiptId: string)
	if grantedReceipts[receiptId] or GRANTED_RECEIPT_CACHE_LIMIT <= 0 then
		return
	end

	grantedReceipts[receiptId] = true
	table.insert(grantedReceiptOrder, receiptId)
	while #grantedReceiptOrder > GRANTED_RECEIPT_CACHE_LIMIT do
		local oldestReceiptId = table.remove(grantedReceiptOrder, 1)
		if oldestReceiptId then
			grantedReceipts[oldestReceiptId] = nil
		end
	end
end

local function getMarketplaceInfoCached(itemId: number, infoType: Enum.InfoType)
	local key = infoType.Name .. ":" .. tostring(itemId)
	if marketplaceInfoCache[key] then
		return marketplaceInfoCache[key]
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(itemId, infoType)
	end)
	if ok then
		marketplaceInfoCache[key] = info
		return info
	end
	return nil
end

local function savePlayerData(
	player: Player,
	forceSave: boolean?,
	releaseLock: boolean?,
	allowPendingInitialization: boolean
): boolean
	local userId = player.UserId
	local isForcedSave = forceSave == true
	local shouldReleaseLock = releaseLock == true
	local dataLoaded = canPersistPlayerData(player, allowPendingInitialization)
	local isPlayerParented = player.Parent ~= nil
	debugVerbose(
		"Save requested | player="
			.. player.Name
			.. " | userId="
			.. tostring(userId)
			.. " | level="
			.. tostring(player:GetAttribute("CurrentLevel"))
			.. " | kart="
			.. tostring(player:GetAttribute("Kart_Equipped"))
			.. " | force="
			.. tostring(isForcedSave)
			.. " | releaseLock="
			.. tostring(shouldReleaseLock)
			.. " | dataLoaded="
			.. tostring(dataLoaded)
			.. " | parented="
			.. tostring(isPlayerParented)
	)
	if (not isPlayerParented and not isForcedSave) or not dataLoaded then
		local warningNow = os.clock()
		local lastWarningAt = blockedSaveWarningTimes[player]
		if
			not blockedSaveWarnings[player]
			or lastWarningAt == nil
			or warningNow - lastWarningAt >= BLOCKED_SAVE_WARNING_INTERVAL_SECONDS
		then
			blockedSaveWarnings[player] = true
			blockedSaveWarningTimes[player] = warningNow
			local reason = if not dataLoaded
				then "data load has not succeeded"
				else "player is no longer parented for a non-forced save"
			DebugModule.debugWarn(
				"Save blocked | reason="
					.. reason
					.. " | player="
					.. player.Name
					.. " | force="
					.. tostring(forceSave == true),
				MODULE_NAME
			)
		end
		return false
	end
	if sessionLockIds[player] == nil then
		DebugModule.debugWarn(
			"Save blocked because session lock is missing | player="
				.. player.Name
				.. " | force="
				.. tostring(isForcedSave),
			MODULE_NAME
		)
		return false
	end
	if shouldReleaseLock and not isForcedSave then
		DebugModule.debugWarn(
			"Save blocked because lock release requires force save | player=" .. player.Name,
			MODULE_NAME
		)
		return false
	end

	local now = os.clock()
	local lastSave = lastSaveTimes[player] or 0
	local hardSessionFailure = false

	local function perform(expectedGeneration: number?): boolean
		if
			(player.Parent == nil and not isForcedSave) or not canPersistPlayerData(player, allowPendingInitialization)
		then
			return false
		end
		if expectedGeneration ~= nil and saveGenerations[player] ~= expectedGeneration then
			return false
		end
		if activeSaveLocks[player] then
			return false
		end
		activeSaveLocks[player] = true

		local data, snapshotFailure = createStoredDataSnapshot(player)
		if data == nil then
			activeSaveLocks[player] = nil
			DebugModule.debugWarn(
				"Save blocked because a persisted attribute is missing | player="
					.. player.Name
					.. " | attribute="
					.. tostring(snapshotFailure),
				MODULE_NAME
			)
			return false
		end
		local snapshotValid, snapshotValidationReason = validateStoredProfileData(data)
		if not snapshotValid then
			activeSaveLocks[player] = nil
			DebugModule.debugWarn(
				"Save blocked because the in-memory profile snapshot is invalid | player="
					.. player.Name
					.. " | reason="
					.. tostring(snapshotValidationReason),
				MODULE_NAME
			)
			return false
		end
		debugVerbose(
			"Save snapshot created | player="
				.. player.Name
				.. " | level="
				.. tostring(data.CurrentLevel)
				.. " | kart="
				.. tostring(data.Kart_Equipped)
				.. " | allXPSpeed="
				.. tostring(data.AllXPSpeed)
				.. " | wins="
				.. tostring(data.WinCount)
		)
		local sessionLockLost = false
		local recoveredLegacyLock = false
		local staleGeneration = false
		local gateShouldContinue: (() -> boolean)? = if expectedGeneration ~= nil then function()
			return player.Parent ~= nil
				and not serviceShuttingDown
				and saveGenerations[player] == expectedGeneration
		end else nil
		local ok, err = pcall(function()
			local gateOk, gateResult = runStandardUpdate(
				"PlayerStatsUpdate",
				function()
					return playerStore:UpdateAsync(dataKey(player), function(existingData, keyInfo)
						if expectedGeneration ~= nil and saveGenerations[player] ~= expectedGeneration then
							staleGeneration = true
							return nil
						end
						if typeof(existingData) ~= "table" then
							sessionLockLost = true
							return nil
						end

						local metadata = cloneMetadata(keyInfo)
						local storedLockId = metadata[SESSION_LOCK_ID_METADATA_KEY]
						if storedLockId ~= sessionLockIds[player] and storedLockId ~= nil and storedLockId ~= "" then
							sessionLockLost = true
							return nil
						end
						if storedLockId ~= sessionLockIds[player] then
							recoveredLegacyLock = true
						end
						local nextData: StoredPlayerData = table.clone(existingData)
						for name, value in pairs(data) do
							nextData[name] = value
						end
						if shouldReleaseLock then
							setSessionLockMetadata(metadata, nil)
						else
							setSessionLockMetadata(metadata, sessionLockIds[player])
						end
						return nextData, cloneUserIds(keyInfo), metadata
					end)
				end,
				gateShouldContinue
			)
			if not gateOk then
				error(gateResult)
			end
		end)
		activeSaveLocks[player] = nil
		if staleGeneration then
			return false
		end
		if sessionLockLost then
			hardSessionFailure = true
			DebugModule.debugWarn(
				"Save rejected because session lock ownership changed | player=" .. player.Name,
				MODULE_NAME
			)
			invalidateSession(player, "SessionLockLost")
			return false
		end
		if recoveredLegacyLock then
			DebugModule.debugWarn("Recovered session lock metadata during save | player=" .. player.Name, MODULE_NAME)
		end
		if not ok then
			DebugModule.debugWarn("Save failed | player=" .. player.Name .. " | err=" .. tostring(err), MODULE_NAME)
			return false
		end

		blockedSaveWarnings[player] = nil
		blockedSaveWarningTimes[player] = nil
		lastSaveTimes[player] = os.clock()
		if shouldReleaseLock then
			sessionLockIds[player] = nil
		end
		local saveMessage = "Saved player data | player="
			.. player.Name
			.. " | level="
			.. tostring(data.CurrentLevel)
			.. " | force="
			.. tostring(isForcedSave)
			.. " | released="
			.. tostring(shouldReleaseLock)
		if isForcedSave or shouldReleaseLock then
			DebugModule.debugInfo(saveMessage, MODULE_NAME)
		else
			debugVerbose(saveMessage)
		end
		return true
	end

	if forceSave then
		cancelPendingSaveThread(player)
		for attempt = 1, FINAL_SAVE_RETRY_ATTEMPTS do
			debugVerbose(
				"Forced save attempt | player="
					.. player.Name
					.. " | attempt="
					.. tostring(attempt)
					.. "/"
					.. tostring(FINAL_SAVE_RETRY_ATTEMPTS)
			)
			local queuedOk, saveResult = runQueuedPlayerStoreOperation(userId, "ForcedSave", function()
				-- Forced saves own their lifetime. Do not let shutdown cancellation
				-- invalidate an in-flight final UpdateAsync callback.
				return perform(nil)
			end)
			if queuedOk and saveResult == true then
				return true
			end
			if hardSessionFailure then
				return false
			end
			if attempt < FINAL_SAVE_RETRY_ATTEMPTS and FINAL_SAVE_RETRY_DELAY_SECONDS > 0 then
				task.wait(FINAL_SAVE_RETRY_DELAY_SECONDS * attempt)
			end
		end
		return false
	end

	if pendingSaveTasks[player] or pendingSaveThreads[player] then
		return true
	end
	local waitTime = math.max(0, SAVE_DEBOUNCE_SECONDS - (now - lastSave))
	pendingSaveTasks[player] = true
	local generation = saveGenerations[player] or 0
	debugVerbose(
		"Regular save scheduled | player="
			.. player.Name
			.. " | delaySeconds="
			.. string.format("%.2f", waitTime)
			.. " | generation="
			.. tostring(generation)
	)
	pendingSaveThreads[player] = task.spawn(function()
		local function finish()
			if pendingSaveThreads[player] == coroutine.running() then
				pendingSaveThreads[player] = nil
			end
		end

		if waitTime > 0 then
			task.wait(waitTime)
		end
		if saveGenerations[player] ~= generation then
			finish()
			return
		end
		pendingSaveTasks[player] = nil

		local retryDelay = REGULAR_SAVE_RETRY_INITIAL_SECONDS
		for attempt = 1, REGULAR_SAVE_RETRY_ATTEMPTS do
			if player.Parent == nil or serviceShuttingDown or saveGenerations[player] ~= generation then
				break
			end
			local queuedOk, saveResult = runQueuedPlayerStoreOperation(userId, "RegularSave", function()
				return perform(generation)
			end)
			if queuedOk and saveResult == true then
				finish()
				return
			end
			if hardSessionFailure or not isDataLoaded(player) then
				finish()
				return
			end

			debugVerbose(
				"Regular save retry scheduled | player="
					.. player.Name
					.. " | attempt="
					.. tostring(attempt)
					.. "/"
					.. tostring(REGULAR_SAVE_RETRY_ATTEMPTS)
					.. " | delaySeconds="
					.. string.format("%.2f", retryDelay)
			)
			if attempt < REGULAR_SAVE_RETRY_ATTEMPTS then
				task.wait(retryDelay)
				retryDelay = math.min(REGULAR_SAVE_RETRY_MAX_SECONDS, retryDelay * 2)
			end
		end
		if player.Parent ~= nil and not serviceShuttingDown and saveGenerations[player] == generation then
			DebugModule.debugWarn(
				"Regular save retries exhausted; later saves will retry | player="
					.. player.Name
					.. " | attempts="
					.. tostring(REGULAR_SAVE_RETRY_ATTEMPTS),
				MODULE_NAME
			)
		end
		finish()
	end)
	return true
end

function ProductServerService.SavePlayerData(player: Player, forceSave: boolean?, releaseLock: boolean?): boolean
	local state = loadStates[player]
	local allowsPendingInitialization = forceSave == true
		and releaseLock ~= true
		and (state == "New" or state == "LegacyMigration")
	local saved = savePlayerData(player, forceSave, releaseLock, allowsPendingInitialization)
	if saved and allowsPendingInitialization then
		loadStates[player] = "Loaded"
	end
	return saved
end

local function renewSessionLock(player: Player): boolean
	local userId = player.UserId
	local lockId = sessionLockIds[player]
	if lockId == nil or serviceShuttingDown or player.Parent == nil or not isDataLoaded(player) then
		return false
	end

	local queuedOk, outcome = runQueuedPlayerStoreOperation(userId, "RenewSessionLock", function()
		if
			serviceShuttingDown
			or player.Parent == nil
			or sessionLockIds[player] ~= lockId
			or not isDataLoaded(player)
		then
			return {
				status = "Skipped",
			}
		end

		local renewed = false
		local lockLost = false
		local recoveredLegacyLock = false
		local ok, err = pcall(function()
			local gateOk, gateResult = runStandardUpdate(
				"RenewSessionLock",
				function()
					return playerStore:UpdateAsync(dataKey(player), function(existingData, keyInfo)
						if typeof(existingData) ~= "table" then
							lockLost = true
							return nil
						end

						local metadata = cloneMetadata(keyInfo)
						local storedLockId = metadata[SESSION_LOCK_ID_METADATA_KEY]
						if storedLockId ~= lockId and storedLockId ~= nil and storedLockId ~= "" then
							lockLost = true
							return nil
						end
						if storedLockId ~= lockId then
							recoveredLegacyLock = true
						end

						setSessionLockMetadata(metadata, lockId)
						renewed = true
						return existingData, cloneUserIds(keyInfo), metadata
					end)
				end,
				function()
					return not serviceShuttingDown
						and player.Parent ~= nil
						and sessionLockIds[player] == lockId
						and isDataLoaded(player)
				end
			)
			if not gateOk then
				error(gateResult)
			end
		end)

		return {
			status = if lockLost then "Lost" elseif renewed then "Renewed" else "Skipped",
			err = err,
			ok = ok,
			recoveredLegacyLock = recoveredLegacyLock,
		}
	end)

	if not queuedOk or typeof(outcome) ~= "table" then
		return false
	end
	if outcome.status == "Lost" then
		invalidateSession(player, "SessionLockLostDuringHeartbeat")
		return false
	end
	if outcome.ok ~= true then
		local failureCount = (heartbeatFailureCounts[player] or 0) + 1
		heartbeatFailureCounts[player] = failureCount
		if failureCount == 1 or failureCount % 3 == 0 then
			DebugModule.debugWarn(
				"Session lock heartbeat failed | player="
					.. player.Name
					.. " | failureCount="
					.. tostring(failureCount)
					.. " | err="
					.. tostring(outcome.err),
				MODULE_NAME
			)
		end
		return false
	end
	if outcome.recoveredLegacyLock == true then
		DebugModule.debugWarn("Session lock metadata recovered during heartbeat | player=" .. player.Name, MODULE_NAME)
	end

	heartbeatFailureCounts[player] = nil
	return outcome.status == "Renewed"
end

local function scheduleSessionLockHeartbeat(player: Player)
	if heartbeatInFlight[player] or sessionLockHeartbeatGeneration <= 0 then
		return
	end

	local token = (heartbeatTokens[player] or 0) + 1
	heartbeatTokens[player] = token
	heartbeatInFlight[player] = true
	task.spawn(function()
		if heartbeatTokens[player] == token then
			renewSessionLock(player)
		end
		if heartbeatTokens[player] == token then
			heartbeatInFlight[player] = nil
		end
	end)
end

local function startSessionLockHeartbeat()
	sessionLockHeartbeatGeneration += 1
	local generation = sessionLockHeartbeatGeneration
	task.spawn(function()
		while generation == sessionLockHeartbeatGeneration and not serviceShuttingDown do
			task.wait(SESSION_LOCK_HEARTBEAT_SECONDS)
			if generation ~= sessionLockHeartbeatGeneration or serviceShuttingDown then
				break
			end
			for _, player in ipairs(Players:GetPlayers()) do
				scheduleSessionLockHeartbeat(player)
			end
		end
	end)
end

function ProductServerService.LoadPlayerData(player: Player): LoadResult
	local userId = player.UserId
	local previousPlayer = activePlayerSessions[userId]
	activePlayerSessions[userId] = player
	loadStates[player] = "Loading"
	if previousPlayer ~= nil and previousPlayer ~= player then
		DebugModule.debugInfo(
			"Profile lifecycle queued behind previous player instance | userId=" .. tostring(userId),
			MODULE_NAME
		)
	end
	local data: StoredPlayerData? = nil
	local dataKeyInfo: any = nil
	local createdNew = false
	local loadFailures = 0
	local lockAttempts = 0
	local lockWaitLogged = false
	local lockWaitStartedAt: number? = nil
	local lockWaitDeadline: number? = nil
	DebugModule.debugInfo(
		"Load started | player=" .. player.Name .. " | userId=" .. tostring(userId) .. " | key=" .. dataKey(player),
		MODULE_NAME
	)

	while player.Parent and not serviceShuttingDown do
		debugVerbose(
			"Session lock acquisition attempt | player="
				.. player.Name
				.. " | attempt="
				.. tostring(lockAttempts + loadFailures + 1)
		)
		local acquireResult, acquiredData, acquiredKeyInfo, acquiredNew, acquireError = acquireSessionLock(player)
		if acquireResult == "Acquired" then
			data = acquiredData
			dataKeyInfo = acquiredKeyInfo
			createdNew = acquiredNew
			if lockWaitStartedAt ~= nil then
				DebugModule.debugInfo(
					"Session lock acquired after waiting | player="
						.. player.Name
						.. " | waitedSeconds="
						.. string.format("%.1f", os.clock() - lockWaitStartedAt),
					MODULE_NAME
				)
			end
			break
		end
		if acquireResult == "Malformed" then
			loadStates[player] = "Failed"
			DebugModule.debugWarn("Load returned malformed data | player=" .. player.Name, MODULE_NAME)
			return "Failed"
		end
		if acquireResult == "Locked" then
			lockAttempts += 1
			if not lockWaitLogged then
				lockWaitLogged = true
				lockWaitStartedAt = os.clock()
				lockWaitDeadline = lockWaitStartedAt + SESSION_LOCK_RECOVERY_SECONDS + SESSION_LOCK_WAIT_GRACE_SECONDS
				DebugModule.debugWarn(
					"Session lock busy; queued retry started | player="
						.. player.Name
						.. " | recoverySeconds="
						.. tostring(SESSION_LOCK_RECOVERY_SECONDS)
						.. " | maxWaitSeconds="
						.. tostring(SESSION_LOCK_RECOVERY_SECONDS + SESSION_LOCK_WAIT_GRACE_SECONDS)
						.. " | context="
						.. tostring(acquireError),
					MODULE_NAME
				)
			end
			if lockWaitDeadline ~= nil and os.clock() >= lockWaitDeadline then
				break
			end
		else
			loadFailures += 1
			DebugModule.debugWarn(
				"Load attempt failed | player="
					.. player.Name
					.. " | attempt="
					.. tostring(loadFailures)
					.. "/"
					.. tostring(LOAD_RETRY_ATTEMPTS)
					.. " | err="
					.. tostring(acquireError),
				MODULE_NAME
			)
			if loadFailures >= LOAD_RETRY_ATTEMPTS then
				break
			end
		end

		if acquireResult == "Locked" then
			local retryExponent = math.min(lockAttempts - 1, 8)
			local retryDelay =
				math.min(SESSION_LOCK_RETRY_MAX_DELAY_SECONDS, SESSION_LOCK_RETRY_DELAY_SECONDS * (2 ^ retryExponent))
			local remainingWait = if lockWaitDeadline ~= nil then lockWaitDeadline - os.clock() else retryDelay
			if remainingWait <= 0 then
				break
			end
			task.wait(math.min(retryDelay, remainingWait))
		else
			task.wait(LOAD_RETRY_DELAY_SECONDS)
		end
	end

	if data == nil then
		loadStates[player] = "Failed"
		DebugModule.debugWarn(
			"Load failed before session lock acquisition | player="
				.. player.Name
				.. " | lockWaited="
				.. tostring(lockWaitLogged)
				.. " | lockAttempts="
				.. tostring(lockAttempts)
				.. " | recoverySeconds="
				.. tostring(SESSION_LOCK_RECOVERY_SECONDS)
				.. " | waitedSeconds="
				.. string.format("%.1f", if lockWaitStartedAt ~= nil then os.clock() - lockWaitStartedAt else 0)
				.. " | shuttingDown="
				.. tostring(serviceShuttingDown),
			MODULE_NAME
		)
		return "Failed"
	end
	if player.Parent == nil then
		releaseSessionLock(player, "PlayerLeftDuringLoad")
		loadStates[player] = "Failed"
		return "Failed"
	end

	local loadResult, validationReason = classifyProfileData(data, createdNew)
	debugVerbose(
		"Load profile classified | player="
			.. player.Name
			.. " | createdNew="
			.. tostring(createdNew)
			.. " | classification="
			.. loadResult
	)
	if loadResult == "RecoveryRequired" then
		releaseSessionLock(player, "ProfileRecoveryRequired")
		loadStates[player] = "RecoveryRequired"
		DebugModule.debugWarn(
			"Profile validation failed; refusing default overwrite | player="
				.. player.Name
				.. " | reason="
				.. tostring(validationReason),
			MODULE_NAME
		)
		return "RecoveryRequired"
	end

	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		local saved = data[entry.name]
		if saved == nil then
			continue
		end

		if typeof(entry.default) == "number" and typeof(saved) ~= "number" then
			DebugModule.debugWarn(
				"Saved numeric attribute rejected due to type mismatch | player="
					.. player.Name
					.. " | attribute="
					.. entry.name
					.. " | savedType="
					.. typeof(saved),
				MODULE_NAME
			)
			continue
		end
		player:SetAttribute(entry.name, saved)
	end

	loadProcessedReceiptHistory(player, data)
	loadStates[player] = loadResult
	blockedSaveWarnings[player] = nil
	blockedSaveWarningTimes[player] = nil
	local loadedVersion = "none"
	if dataKeyInfo ~= nil then
		local versionOk, version = pcall(function()
			return dataKeyInfo.Version
		end)
		if versionOk and version ~= nil then
			loadedVersion = tostring(version)
		end
	end
	DebugModule.debugInfo(
		"Load succeeded | player="
			.. player.Name
			.. " | level="
			.. tostring(player:GetAttribute("CurrentLevel"))
			.. " | allXPSpeed="
			.. tostring(player:GetAttribute("AllXPSpeed"))
			.. " | kart="
			.. tostring(player:GetAttribute("Kart_Equipped"))
			.. " | wins="
			.. tostring(player:GetAttribute("WinCount"))
			.. " | version="
			.. loadedVersion
			.. " | status="
			.. loadResult
	)
	return loadResult
end

function ProductServerService.UpdateStoredPlayerData(userId: number, mutator: StoredDataMutator): boolean
	if typeof(userId) ~= "number" or userId <= 0 then
		return false
	end
	if Players:GetPlayerByUserId(userId) then
		DebugModule.debugWarn(
			"Offline update rejected because player is online | userId=" .. tostring(userId),
			MODULE_NAME
		)
		return false
	end

	local queuedOk, outcome = runQueuedPlayerStoreOperation(userId, "OfflineUpdate", function()
		if Players:GetPlayerByUserId(userId) then
			return {
				status = "Online",
			}
		end

		local blockedBySessionLock = false
		local missingProfile = false
		local malformedProfile = false
		local ok, err = pcall(function()
			local gateOk, gateResult = runStandardUpdate("OfflineUpdate", function()
				return playerStore:UpdateAsync(dataKeyForUserId(userId), function(existingData, keyInfo)
					local metadata = cloneMetadata(keyInfo)
					if isSessionLockActive(metadata, nil) then
						blockedBySessionLock = true
						return nil
					end
					if existingData == nil then
						missingProfile = true
						return nil
					end
					if typeof(existingData) ~= "table" then
						malformedProfile = true
						return nil
					end
					local existingValid, existingValidationReason = validateStoredProfileData(existingData)
					if not existingValid then
						malformedProfile = true
						DebugModule.debugWarn(
							"Offline update rejected invalid profile | userId="
								.. tostring(userId)
								.. " | reason="
								.. tostring(existingValidationReason),
							MODULE_NAME
						)
						return nil
					end
					setSessionLockMetadata(metadata, nil)
					local nextData: StoredPlayerData = table.clone(existingData)
					local updatedData = mutator(nextData)
					if typeof(updatedData) ~= "table" then
						assert(false, "Stored data mutator must return a table")
					end
					local updatedValid, updatedValidationReason = validateStoredProfileData(updatedData)
					if not updatedValid then
						malformedProfile = true
						DebugModule.debugWarn(
							"Offline update rejected invalid mutation | userId="
								.. tostring(userId)
								.. " | reason="
								.. tostring(updatedValidationReason),
							MODULE_NAME
						)
						return nil
					end
					return updatedData, cloneUserIds(keyInfo), metadata
				end)
			end)
			if not gateOk then
				error(gateResult)
			end
		end)
		return {
			status = if blockedBySessionLock
				then "Locked"
				elseif missingProfile
					then "Missing"
				elseif malformedProfile
					then "Malformed"
				elseif ok then "Succeeded"
				else "Failed",
			err = err,
		}
	end)
	if not queuedOk or typeof(outcome) ~= "table" then
		DebugModule.debugWarn(
			"Stored player update failed before operation | userId="
				.. tostring(userId)
				.. " | err="
				.. tostring(outcome),
			MODULE_NAME
		)
		return false
	end
	if outcome.status == "Online" then
		DebugModule.debugWarn(
			"Offline update rejected because player joined while queued | userId=" .. tostring(userId),
			MODULE_NAME
		)
		return false
	end
	if outcome.status == "Locked" then
		DebugModule.debugWarn(
			"Offline update blocked by active session lock | userId=" .. tostring(userId),
			MODULE_NAME
		)
		return false
	end
	if outcome.status == "Missing" or outcome.status == "Malformed" then
		DebugModule.debugWarn(
			"Offline update rejected because the profile is not recoverable | userId="
				.. tostring(userId)
				.. " | status="
				.. outcome.status,
			MODULE_NAME
		)
		return false
	end
	if outcome.status ~= "Succeeded" then
		DebugModule.debugWarn(
			"Stored player update failed | userId=" .. tostring(userId) .. " | err=" .. tostring(outcome.err),
			MODULE_NAME
		)
		return false
	end

	debugVerbose("Stored player update succeeded | userId=" .. tostring(userId))
	return true
end

function ProductServerService.ResetRecoveryProfile(player: Player): boolean
	if player.Parent == nil
		or player:GetAttribute("Data_LoadState") ~= "RecoveryRequired"
		or loadStates[player] ~= "RecoveryRequired"
	then
		DebugModule.debugWarn(
			"Recovery reset rejected because player is not in RecoveryRequired state | player=" .. player.Name,
			MODULE_NAME
		)
		return false
	end

	if sessionLockIds[player] ~= nil then
		DebugModule.debugWarn(
			"Recovery reset rejected because session lock already exists | player=" .. player.Name,
			MODULE_NAME
		)
		return false
	end

	cancelPendingSaveThread(player)
	local acquireResult, _, _, _, acquireError = acquireSessionLock(player)
	if acquireResult ~= "Acquired" then
		DebugModule.debugWarn(
			"Recovery reset could not reacquire profile lock | player="
				.. player.Name
				.. " | result="
				.. tostring(acquireResult)
				.. " | err="
				.. tostring(acquireError),
			MODULE_NAME
		)
		return false
	end

	-- PlayerAttributeManager initialized missing attributes from canonical defaults
	-- before loading. Save those defaults only after the profile lock is reacquired.
	loadStates[player] = "New"
	player:SetAttribute("Data_Loaded", true)
	player:SetAttribute("Data_LoadState", "Saving")
	local saved = ProductServerService.SavePlayerData(player, true, true)
	if not saved then
		if sessionLockIds[player] ~= nil then
			releaseSessionLock(player, "RecoveryResetFailed")
		end
		if invalidatedSessions[player] ~= true then
			loadStates[player] = "RecoveryRequired"
			player:SetAttribute("Data_LoadState", "RecoveryRequired")
		end
		player:SetAttribute("Data_Loaded", false)
		return false
	end

	loadStates[player] = "New"
	player:SetAttribute("Data_Loaded", false)
	player:SetAttribute("Data_LoadState", "ResetComplete")
	DebugModule.debugWarn(
		"Recovery profile reset completed; player must rejoin | player=" .. player.Name .. " | userId=" .. tostring(player.UserId),
		MODULE_NAME
	)
	return true
end

function ProductServerService.CleanupPlayerState(player: Player)
	local userId = player.UserId
	local ownsActiveSession = activePlayerSessions[userId] == player

	disconnectPersistedAttributeListeners(player)
	cancelPendingSaveThread(player)
	heartbeatTokens[player] = nil
	heartbeatInFlight[player] = nil
	heartbeatFailureCounts[player] = nil
	lastSaveTimes[player] = nil
	loadStates[player] = nil
	sessionLockIds[player] = nil
	invalidatedSessions[player] = nil
	blockedSaveWarnings[player] = nil
	blockedSaveWarningTimes[player] = nil
	processedProfileReceipts[player] = nil
	processedProfileReceiptOrder[player] = nil
	announcedGamePasses[player] = nil
	creatorGrantLocks[player] = nil
	saveGenerations[player] = nil
	if ownsActiveSession then
		activePlayerSessions[userId] = nil
	else
		debugVerbose("Cleaned stale player instance state | player=" .. player.Name .. " | userId=" .. tostring(userId))
	end
	debugVerbose("Persistence state cleaned | player=" .. player.Name .. " | userId=" .. tostring(userId))
end

function ProductServerService.ReleaseSessionLock(player: Player, reason: string?): boolean
	return releaseSessionLock(player, reason or "ExplicitRelease")
end

function ProductServerService.PrepareForShutdown()
	if serviceShuttingDown then
		return
	end

	serviceShuttingDown = true
	DebugModule.debugInfo("Persistence shutdown preparation started | activeSessions=" .. tostring((function(): number
		local count = 0
		for _ in pairs(activePlayerSessions) do
			count += 1
		end
		return count
	end)()), MODULE_NAME)
	sessionLockHeartbeatGeneration += 1
	for player in pairs(pendingSaveThreads) do
		cancelPendingSaveThread(player)
	end
end

function ProductServerService.IsShuttingDown(): boolean
	return serviceShuttingDown
end

function ProductServerService.SetCreatorUserId(userId: number?)
	creatorUserId = if typeof(userId) == "number" and userId > 0 then userId else nil
	DebugModule.debugInfo("Creator identity configured | creatorUserId=" .. tostring(creatorUserId), MODULE_NAME)
end

function ProductServerService.SetProductCallback(id: number, cb: (...any) -> ())
	devProductCallbacks[id] = cb
end

function ProductServerService.SetGamePassCallback(id: number, cb: (...any) -> ())
	gamePassCallbacks[id] = cb
end

local function getReceiptId(info: any): string?
	local purchaseId = info.PurchaseId
	if purchaseId == nil then
		return nil
	end

	local receiptId = tostring(purchaseId)
	return if receiptId ~= "" then receiptId else nil
end

local function reserveReceipt(
	receiptId: string,
	player: Player,
	productId: number
): "Granted" | "Reserved" | "Busy" | nil
	if grantedReceipts[receiptId] then
		return "Granted"
	end

	local ok, record = runStandardUpdate("ReserveReceipt", function()
		return receiptStore:UpdateAsync("receipt_" .. receiptId, function(previous)
			if typeof(previous) == "table" then
				if previous.Status == "Granted" then
					return previous
				end

				local updatedAt = previous.UpdatedAt
				if
					previous.Status == "Processing"
					and typeof(updatedAt) == "number"
					and os.time() - updatedAt < RECEIPT_RESERVATION_LEASE_SECONDS
				then
					return previous
				end
			end

			return {
				Status = "Processing",
				JobId = receiptJobId,
				PlayerId = player.UserId,
				ProductId = productId,
				UpdatedAt = os.time(),
			}
		end)
	end)
	if not ok then
		DebugModule.debugWarn(
			"Receipt reservation failed for purchaseId=" .. receiptId .. ": " .. tostring(record),
			MODULE_NAME
		)
		return nil
	end

	if typeof(record) ~= "table" then
		return nil
	elseif record.Status == "Granted" then
		cacheGrantedReceipt(receiptId)
		return "Granted"
	elseif record.Status == "Processing" and record.JobId == receiptJobId then
		return "Reserved"
	end

	return "Busy"
end

local function releaseReceipt(receiptId: string)
	local ok, err = runStandardUpdate("ReleaseReceipt", function()
		return receiptStore:UpdateAsync("receipt_" .. receiptId, function(previous)
			if typeof(previous) == "table" and previous.Status == "Processing" and previous.JobId == receiptJobId then
				return {
					Status = "Retry",
					UpdatedAt = os.time(),
				}
			end
			return previous
		end)
	end)
	if not ok then
		DebugModule.debugWarn(
			"Receipt reservation release failed for purchaseId=" .. receiptId .. ": " .. tostring(err),
			MODULE_NAME
		)
	end
end

local function rememberGrantedReceipt(receiptId: string, player: Player, productId: number): boolean
	local ok, err = runStandardUpdate("RememberGrantedReceipt", function()
		return receiptStore:UpdateAsync("receipt_" .. receiptId, function(previous)
			if typeof(previous) == "table" and previous.Status == "Granted" then
				return previous
			end

			return {
				Status = "Granted",
				PlayerId = player.UserId,
				ProductId = productId,
				GrantedAt = os.time(),
			}
		end)
	end)

	if not ok then
		DebugModule.debugWarn(
			"Receipt history save failed for purchaseId=" .. receiptId .. ": " .. tostring(err),
			MODULE_NAME
		)
		return false
	end

	cacheGrantedReceipt(receiptId)
	return true
end

local function snapshotSavedAttributes(player: Player): { [string]: any }
	local snapshot: { [string]: any } = {}
	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		snapshot[entry.name] = player:GetAttribute(entry.name)
	end
	return snapshot
end

local function restoreSavedAttributes(player: Player, snapshot: { [string]: any })
	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		player:SetAttribute(entry.name, snapshot[entry.name])
	end
end

function ProductServerService.GrantCreatorDeveloperProduct(player: Player, productId: number): (boolean, string)
	if typeof(productId) ~= "number" or productId <= 0 or productId ~= math.floor(productId) then
		return false, "InvalidProductId"
	end
	if not isExperienceCreator(player) then
		return false, "NotCreator"
	end
	if player.Parent == nil then
		return false, "PlayerUnavailable"
	end
	if serviceShuttingDown then
		return false, "ServiceShuttingDown"
	end
	if not isDataLoaded(player) then
		return false, "DataNotLoaded"
	end
	if creatorGrantLocks[player] then
		return false, "GrantInFlight"
	end
	if not isCanonicalDeveloperProduct(productId) then
		return false, "UnknownProduct"
	end

	local callback = devProductCallbacks[productId]
	if not callback then
		return false, "ProductNotRegistered"
	end

	creatorGrantLocks[player] = true
	local attributeSnapshot = snapshotSavedAttributes(player)
	local callbackOk, callbackResult, callbackReason =
		pcall(callback, player, productId, true, nil, nil, "CreatorGrant")
	if not callbackOk then
		restoreSavedAttributes(player, attributeSnapshot)
		creatorGrantLocks[player] = nil
		DebugModule.debugWarn(
			"Creator developer product callback failed | player="
				.. player.Name
				.. " | productId="
				.. tostring(productId)
				.. " | err="
				.. tostring(callbackResult),
			MODULE_NAME
		)
		return false, "CallbackFailed"
	end
	if callbackResult == false then
		restoreSavedAttributes(player, attributeSnapshot)
		creatorGrantLocks[player] = nil
		local rejectionReason = if typeof(callbackReason) == "string" then callbackReason else "CallbackRejected"
		DebugModule.debugWarn(
			"Creator developer product callback rejected | player="
				.. player.Name
				.. " | productId="
				.. tostring(productId)
				.. " | reason="
				.. rejectionReason,
			MODULE_NAME
		)
		return false, rejectionReason
	end

	local saved = ProductServerService.SavePlayerData(player, true)
	if not saved then
		restoreSavedAttributes(player, attributeSnapshot)
		creatorGrantLocks[player] = nil
		DebugModule.debugWarn(
			"Creator developer product grant rolled back because save failed | player="
				.. player.Name
				.. " | productId="
				.. tostring(productId),
			MODULE_NAME
		)
		return false, "SaveFailed"
	end

	creatorGrantLocks[player] = nil
	DebugModule.debugInfo(
		"Creator developer product granted | player=" .. player.Name .. " | productId=" .. tostring(productId),
		MODULE_NAME
	)
	return true, "Granted"
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if not isDataLoaded(player) then
		DebugModule.debugWarn(
			"Receipt deferred until player data loads | player="
				.. player.Name
				.. " | productId="
				.. tostring(info.ProductId),
			MODULE_NAME
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receiptId = getReceiptId(info)
	if not receiptId then
		DebugModule.debugWarn("Developer product receipt had no PurchaseId", MODULE_NAME)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if info.ProductPurchaseChannel == Enum.ProductPurchaseChannel.AdReward then
		DebugModule.debugInfo(
			"Processing rewarded-video product receipt | playerId="
				.. tostring(info.PlayerId)
				.. " | productId="
				.. tostring(info.ProductId),
			MODULE_NAME
		)
	end

	if processingReceipts[receiptId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receiptState = reserveReceipt(receiptId, player, info.ProductId)
	if receiptState == nil or receiptState == "Busy" then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	elseif receiptState == "Granted" then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	processingReceipts[receiptId] = true

	local cb = devProductCallbacks[info.ProductId]
	if not cb then
		DebugModule.debugWarn(
			"No dev product callback registered for productId=" .. tostring(info.ProductId),
			MODULE_NAME
		)
		processingReceipts[receiptId] = nil
		releaseReceipt(receiptId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local alreadyPersisted = hasProcessedProfileReceipt(player, receiptId)
	if not alreadyPersisted then
		local attributeSnapshot = snapshotSavedAttributes(player)
		local callbackOk, callbackResult, callbackReason =
			pcall(cb, player, info.ProductId, true, receiptId, info.ProductPurchaseChannel)
		if not callbackOk then
			restoreSavedAttributes(player, attributeSnapshot)
			processingReceipts[receiptId] = nil
			releaseReceipt(receiptId)
			DebugModule.debugWarn(
				"Dev product callback failed for player "
					.. player.Name
					.. " productId="
					.. tostring(info.ProductId)
					.. " err="
					.. tostring(callbackResult),
				MODULE_NAME
			)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		if callbackResult == false then
			restoreSavedAttributes(player, attributeSnapshot)
			processingReceipts[receiptId] = nil
			releaseReceipt(receiptId)
			DebugModule.debugWarn(
				"Dev product callback rejected; receipt will retry | player="
					.. player.Name
					.. " | productId="
					.. tostring(info.ProductId)
					.. " | reason="
					.. tostring(callbackReason),
				MODULE_NAME
			)
			return Enum.ProductPurchaseDecision.NotProcessedYet
		end
		markProcessedProfileReceipt(player, receiptId)
	end

	if not ProductServerService.SavePlayerData(player, true) then
		processingReceipts[receiptId] = nil
		releaseReceipt(receiptId)
		DebugModule.debugWarn(
			"Receipt reward awaiting durable profile save | player="
				.. player.Name
				.. " | productId="
				.. tostring(info.ProductId)
				.. " | purchaseId="
				.. receiptId,
			MODULE_NAME
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if not rememberGrantedReceipt(receiptId, player, info.ProductId) then
		processingReceipts[receiptId] = nil
		releaseReceipt(receiptId)
		DebugModule.debugWarn(
			"Receipt reward saved but receipt finalization is pending | player="
				.. player.Name
				.. " | purchaseId="
				.. receiptId,
			MODULE_NAME
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	processingReceipts[receiptId] = nil

	local itemInfo = getMarketplaceInfoCached(info.ProductId, Enum.InfoType.Product)
	if itemInfo and not alreadyPersisted then
		SystemChatService.BroadcastPurchase(
			player,
			itemInfo.Name,
			itemInfo.PriceInRobux or 0,
			nil,
			"Product:" .. receiptId
		)
	end

	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ProductServerService.Init()
	if isInitialized then
		return
	end
	isInitialized = true
	serviceShuttingDown = false

	MarketplaceService.ProcessReceipt = processReceipt

	serviceMaid.GamePassPurchaseFinished = MarketplaceService.PromptGamePassPurchaseFinished:Connect(
		function(player, id, bought)
			local purchaseCompleted = bought == true
			local resolvedBought = purchaseCompleted
			if purchaseCompleted then
				ProductService.SetGamePassOwnershipCache(player, id, true)
			else
				ProductService.ClearOwnershipCache(player)
				resolvedBought = ProductService.userOwnsGamePass(player, id)
				if resolvedBought then
					ProductService.SetGamePassOwnershipCache(player, id, true)
				end
			end

			local cb = gamePassCallbacks[id]
			if cb then
				pcall(cb, player, id, resolvedBought)
			end
			if purchaseCompleted then
				local itemInfo = getMarketplaceInfoCached(id, Enum.InfoType.GamePass)
				local playerAnnouncements = announcedGamePasses[player]
				if not playerAnnouncements then
					playerAnnouncements = {}
					announcedGamePasses[player] = playerAnnouncements
				end
				if itemInfo and not playerAnnouncements[id] then
					SystemChatService.BroadcastPurchase(
						player,
						itemInfo.Name,
						itemInfo.PriceInRobux or 0,
						nil,
						"GamePass:" .. tostring(player.UserId) .. ":" .. tostring(id)
					)
					playerAnnouncements[id] = true
				end
				ProductServerService.SavePlayerData(player)
			end
		end
	)

	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(function(player)
		disconnectPersistedAttributeListeners(player)
		heartbeatTokens[player] = nil
		heartbeatInFlight[player] = nil
		cancelPendingSaveThread(player)
		lastSaveTimes[player] = nil
		creatorGrantLocks[player] = nil
	end)
	serviceMaid.PersistencePlayerAdded = Players.PlayerAdded:Connect(bindPersistedAttributeListeners)
	for _, player in ipairs(Players:GetPlayers()) do
		bindPersistedAttributeListeners(player)
	end
	startSessionLockHeartbeat()
end

function ProductServerService.Shutdown()
	if not isInitialized then
		return
	end

	ProductServerService.PrepareForShutdown()
	for player in pairs(persistedAttributeConnections) do
		disconnectPersistedAttributeListeners(player)
	end
	serviceMaid:DoCleaning()
	isInitialized = false
	DebugModule.debugPrint("ProductServerService shutdown", MODULE_NAME)
end

return ProductServerService
]]></string>
        </Properties>
