      <Item class="ModuleScript" referent="3510">
        <Properties>
          <string name="Name">DebugModule</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local CoreConfig = if RunService:IsServer()
	then require(game:GetService("ServerScriptService").Modules.Shared:WaitForChild("CoreConfig_Server"))
	else require(ReplicatedStorage.Modules.Shared:WaitForChild("CoreConfig_Client"))
local DebugModuleCore = require(ReplicatedStorage.Modules:WaitForChild("DebugModuleCore"))

return DebugModuleCore.new(function()
	return CoreConfig.debugSystem
end)
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3511">
        <Properties>
          <string name="Name">DebugModuleCore</string>
          <string name="Source"><![CDATA[local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

type SettingsProvider = () -> any

local DebugModuleCore = {}

function DebugModuleCore.new(getSettings: SettingsProvider): { [string]: any }
	local DebugModule: { [string]: any } = {}
	local runtimeModuleOverrides: { [string]: boolean } = {}
	local defaultSettings = {
		enabled = true,
		showPrints = true,
		showWarns = true,
		validationWarns = false,
		showErrors = true,
		timestamp = true,
		studioOnly = true,
	}

	local function resolveSettings(): any
		local settings = getSettings()
		return if typeof(settings) == "table" then settings else defaultSettings
	end

	local function normalizeModuleName(moduleName: string?): string?
		if typeof(moduleName) ~= "string" or moduleName == "" then
			return nil
		end
		return moduleName
	end

	local function listContainsModule(moduleList: { any }?, moduleName: string): boolean
		if typeof(moduleList) ~= "table" then
			return false
		end

		for _, entry in ipairs(moduleList) do
			if entry == moduleName then
				return true
			end
		end

		return false
	end

	local function shouldLogModule(settings: any, moduleName: string?, bypassStudioOnly: boolean?): boolean
		if not bypassStudioOnly and settings.studioOnly == true and not RunService:IsStudio() then
			return false
		end

		local normalizedModuleName = normalizeModuleName(moduleName)
		if not normalizedModuleName then
			return true
		end

		local runtimeOverride = runtimeModuleOverrides[normalizedModuleName]
		if runtimeOverride ~= nil then
			return runtimeOverride
		end

		if typeof(settings.moduleOverrides) == "table" then
			local configuredOverride = settings.moduleOverrides[normalizedModuleName]
			if typeof(configuredOverride) == "boolean" then
				return configuredOverride
			end
		end

		if listContainsModule(settings.disabledModules, normalizedModuleName) then
			return false
		end

		local hasTargetedModules = typeof(settings.enabledModules) == "table" and #settings.enabledModules > 0
		return if hasTargetedModules then listContainsModule(settings.enabledModules, normalizedModuleName) else true
	end

	local function getTimestamp(): string
		if resolveSettings().timestamp ~= true then
			return ""
		end

		local time = os.date("*t")
		return string.format("%02d:%02d:%02d   ▶ ", time.hour, time.min, time.sec)
	end

	local function getPrefix(moduleName: string?): string
		return if moduleName then "[" .. moduleName .. "] " else "[Debug] "
	end

	function DebugModule.debugPrint(message: any, moduleName: string?)
		local settings = resolveSettings()
		if not settings.enabled or not settings.showPrints or not shouldLogModule(settings, moduleName) then
			return
		end
		print(getTimestamp() .. getPrefix(moduleName) .. tostring(message))
	end

	function DebugModule.debugWarn(message: any, moduleName: string?)
		local settings = resolveSettings()
		if not settings.enabled or not settings.showWarns or not shouldLogModule(settings, moduleName) then
			return
		end
		warn(getTimestamp() .. getPrefix(moduleName) .. tostring(message))
	end

	function DebugModule.validationWarn(message: any, moduleName: string?)
		local settings = resolveSettings()
		if
			not settings.enabled
			or settings.validationWarns ~= true
			or not settings.showWarns
			or not shouldLogModule(settings, moduleName, true)
		then
			return
		end

		local prefix = if moduleName then "[Validation:" .. moduleName .. "] " else "[Validation] "
		warn(getTimestamp() .. prefix .. tostring(message))
	end

	function DebugModule.debugError(message: any, errorDetails: any, moduleName: string?)
		local settings = resolveSettings()
		if not settings.enabled or not settings.showErrors or not shouldLogModule(settings, moduleName) then
			return
		end

		local fullMessage = getPrefix(moduleName) .. tostring(message)
		if errorDetails ~= nil then
			fullMessage ..= " - Details: " .. tostring(errorDetails)
		end
		-- Keep diagnostics from aborting the gameplay path that reported them.
		warn(getTimestamp() .. "[Error] " .. fullMessage)
	end

	function DebugModule.debugInfo(message: any, moduleName: string?)
		DebugModule.debugPrint(message, moduleName)
	end

	function DebugModule.debugTrace(message: any, data: any, moduleName: string?)
		local settings = resolveSettings()
		if not settings.enabled or not settings.showPrints or not shouldLogModule(settings, moduleName) then
			return
		end

		local traceMessage = getTimestamp() .. getPrefix(moduleName) .. "TRACE: " .. tostring(message)
		if data ~= nil then
			local serialized = if typeof(data) == "table" then HttpService:JSONEncode(data) else tostring(data)
			traceMessage ..= " | Data: " .. serialized
		end
		print(traceMessage)
	end

	function DebugModule.isEnabled(): boolean
		local settings = resolveSettings()
		return settings.enabled == true and (settings.studioOnly ~= true or RunService:IsStudio())
	end

	function DebugModule.getSettings(): any
		return resolveSettings()
	end

	function DebugModule.setModuleEnabled(moduleName: string, isEnabled: boolean)
		local normalizedModuleName = normalizeModuleName(moduleName)
		if normalizedModuleName then
			runtimeModuleOverrides[normalizedModuleName] = isEnabled
		end
	end

	function DebugModule.clearModuleOverride(moduleName: string)
		runtimeModuleOverrides[normalizeModuleName(moduleName) or ""] = nil
	end

	function DebugModule.clearAllModuleOverrides()
		table.clear(runtimeModuleOverrides)
	end

	function DebugModule.getModuleOverrides(): { [string]: boolean }
		return table.clone(runtimeModuleOverrides)
	end

	return DebugModule
end

return DebugModuleCore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3512">
        <Properties>
          <string name="Name">EnvironmentService</string>
          <string name="Source"><![CDATA[local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local DebugModule = require(ReplicatedStorage.Modules:WaitForChild("DebugModule"))
local Maid = require(ReplicatedStorage.Modules:WaitForChild("Maid"))
local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local TweenConfig = require(ReplicatedStorage.Modules.UI.TweenConfig)

local EnvironmentService = {}

local MODULE_NAME = "EnvironmentService"
local OWNED_EFFECT_ATTRIBUTE = "EnvironmentServiceOwned"
local TRANSITION_COMPLETE_ATTRIBUTE = "EnvironmentTransitionComplete"
local environmentConfig = CoreConfig.environment
local transitionDurationSeconds = if typeof(environmentConfig) == "table"
		and typeof(environmentConfig.transitionDurationSeconds) == "number"
	then math.max(0, environmentConfig.transitionDurationSeconds)
	else 2
local atmosphereLeadSeconds = if typeof(environmentConfig) == "table"
		and typeof(environmentConfig.atmosphereLeadSeconds) == "number"
	then math.max(0, environmentConfig.atmosphereLeadSeconds)
	else 0.5
local transitionTweenInfo = TweenConfig.WithDuration(transitionDurationSeconds, TweenConfig.EnvironmentTransition)
local atmosphereLeadTweenInfo = TweenConfig.WithDuration(atmosphereLeadSeconds, TweenConfig.EnvironmentTransition)

local LIGHTING_PROPERTIES = {
	"Ambient",
	"Brightness",
	"ClockTime",
	"ColorShift_Bottom",
	"ColorShift_Top",
	"EnvironmentDiffuseScale",
	"EnvironmentSpecularScale",
	"GeographicLatitude",
	"GlobalShadows",
	"OutdoorAmbient",
}

local EFFECT_PROPERTIES: { [string]: { string } } = {
	Atmosphere = { "Color", "Decay", "Density", "Glare", "Haze", "Offset" },
	ColorCorrectionEffect = { "Brightness", "Contrast", "Enabled", "Saturation", "TintColor" },
	DepthOfFieldEffect = { "Enabled", "FarIntensity", "FocusDistance", "InFocusRadius", "NearIntensity" },
	Sky = {
		"CelestialBodiesShown",
		"MoonAngularSize",
		"MoonTextureId",
		"SkyboxBk",
		"SkyboxDn",
		"SkyboxFt",
		"SkyboxLf",
		"SkyboxRt",
		"SkyboxUp",
		"StarCount",
		"SunAngularSize",
		"SunTextureId",
	},
}

local maid = Maid.new()
local initialized = false
local stateFolder: Folder? = nil
local currentEnvironmentName = ""
local globalShadowsOverride: boolean? = nil
local ownedEffects: { [string]: Instance } = {}
local transitionMaid = Maid.new()

local function getEnvironmentProfile(environmentName: string): Folder?
	local environments = ReplicatedStorage:FindFirstChild("Environments")
	if not environments or not environments:IsA("Folder") then
		DebugModule.debugWarn("ReplicatedStorage.Environments is missing", MODULE_NAME)
		return nil
	end

	local profile = environments:FindFirstChild(environmentName)
	if profile and profile:IsA("Folder") then
		return profile
	end

	if environmentName ~= "Default" then
		DebugModule.debugWarn(
			"Environment profile missing: " .. environmentName .. "; falling back to Default",
			MODULE_NAME
		)
		local defaultProfile = environments:FindFirstChild("Default")
		if defaultProfile and defaultProfile:IsA("Folder") then
			return defaultProfile
		end
	end

	DebugModule.debugWarn("Default environment profile is missing", MODULE_NAME)
	return nil
end

local function setLightingProperty(propertyName: string, value: any)
	if propertyName == "GlobalShadows" and globalShadowsOverride ~= nil then
		return
	end

	local ok, errorMessage = pcall(function()
		(Lighting :: any)[propertyName] = value
	end)
	if not ok then
		DebugModule.debugWarn(
			"Failed to apply lighting property | property=" .. propertyName .. " | error=" .. tostring(errorMessage),
			MODULE_NAME
		)
	end
end

local function setTransitionComplete(value: boolean)
	if stateFolder then
		stateFolder:SetAttribute(TRANSITION_COMPLETE_ATTRIBUTE, value)
	end
end

local function scheduleTransitionComplete()
	local totalDuration = atmosphereLeadSeconds + transitionDurationSeconds
	if totalDuration <= 0 then
		setTransitionComplete(true)
		return
	end

	local completionAnchor = Instance.new("NumberValue")
	completionAnchor.Value = 0
	local completionTween =
		TweenService:Create(completionAnchor, TweenConfig.WithDuration(totalDuration, TweenConfig.EnvironmentLinear), { Value = 1 })
	transitionMaid:GiveTask(completionAnchor)
	transitionMaid:GiveTask(completionTween)
	transitionMaid:GiveTask(completionTween.Completed:Connect(function(playbackState: Enum.PlaybackState)
		if playbackState == Enum.PlaybackState.Completed then
			setTransitionComplete(true)
		end
	end))
	completionTween:Play()
end

local function isTweenableValue(value: any): boolean
	local valueType = typeof(value)
	return valueType == "number" or valueType == "Color3"
end

local function applyClockTimeProperty(value: number, context: string, animate: boolean): boolean
	if not animate or transitionDurationSeconds <= 0 then
		setLightingProperty("ClockTime", value)
		return true
	end

	local currentClockTime = Lighting.ClockTime
	local tweenTarget = value
	if tweenTarget < currentClockTime then
		tweenTarget += 24
	end

	local clockTimeAnchor = Instance.new("NumberValue")
	clockTimeAnchor.Value = currentClockTime
	local ok, tweenOrError = pcall(function()
		return TweenService:Create(clockTimeAnchor, transitionTweenInfo, { Value = tweenTarget })
	end)
	if not ok then
		clockTimeAnchor:Destroy()
		DebugModule.debugWarn(
			"Failed to create ClockTime tween | target=" .. context .. " | error=" .. tostring(tweenOrError),
			MODULE_NAME
		)
		return false
	end

	local tween = tweenOrError :: Tween
	transitionMaid:GiveTask(clockTimeAnchor)
	transitionMaid:GiveTask(tween)
	transitionMaid:GiveTask(clockTimeAnchor:GetPropertyChangedSignal("Value"):Connect(function()
		setLightingProperty("ClockTime", clockTimeAnchor.Value % 24)
	end))
	transitionMaid:GiveTask(tween.Completed:Connect(function(playbackState: Enum.PlaybackState)
		if playbackState == Enum.PlaybackState.Completed then
			setLightingProperty("ClockTime", value)
		end
	end))
	tween:Play()
	return true
end

local function applyEnvironmentProperty(
	target: Instance,
	propertyName: string,
	value: any,
	context: string,
	animate: boolean
)
	if target == Lighting and propertyName == "ClockTime" and typeof(value) == "number" then
		applyClockTimeProperty(value, context, animate)
		return
	end

	if not animate or not isTweenableValue(value) or transitionDurationSeconds <= 0 then
		local ok, errorMessage = pcall(function()
			(target :: any)[propertyName] = value
		end)
		if not ok then
			DebugModule.debugWarn(
				"Failed to apply environment property | target="
					.. context
					.. " | property="
					.. propertyName
					.. " | error="
					.. tostring(errorMessage),
				MODULE_NAME
			)
		end
		return
	end

	local ok, tweenOrError = pcall(function()
		return TweenService:Create(target, transitionTweenInfo, { [propertyName] = value })
	end)
	if not ok then
		DebugModule.debugWarn(
			"Failed to create environment tween | target="
				.. context
				.. " | property="
				.. propertyName
				.. " | error="
				.. tostring(tweenOrError),
			MODULE_NAME
		)
		return
	end

	local tween = tweenOrError :: Tween
	transitionMaid:GiveTask(tween)
	tween:Play()
end

local function applyLightingAttributes(profile: Folder, animate: boolean)
	for _, propertyName in ipairs(LIGHTING_PROPERTIES) do
		local value = profile:GetAttribute(propertyName)
		if value ~= nil then
			if propertyName == "GlobalShadows" or globalShadowsOverride ~= nil then
				setLightingProperty(propertyName, value)
			else
				applyEnvironmentProperty(Lighting, propertyName, value, "Lighting", animate)
			end
		end
	end

	if globalShadowsOverride ~= nil then
		Lighting.GlobalShadows = globalShadowsOverride
	end
end

local function copyEffectProperties(source: Instance, target: Instance, properties: { string }, animate: boolean)
	local sourceAny = source :: any
	for _, propertyName in ipairs(properties) do
		local ok, value = pcall(function()
			return sourceAny[propertyName]
		end)
		if ok and value ~= nil then
			applyEnvironmentProperty(target, propertyName, value, source.Name, animate)
		end
	end
end

local function reconcileEffects(profile: Folder, animate: boolean, phase: "Atmosphere" | "Other" | "All")
	local previousOwnedEffects = ownedEffects
	local nextOwnedEffects: { [string]: Instance } = table.clone(previousOwnedEffects)
	local desiredEffectNames: { [string]: boolean } = {}
	local profileHasSky = false

	for _, source in ipairs(profile:GetChildren()) do
		local properties = EFFECT_PROPERTIES[source.ClassName]
		local isSky = source.ClassName == "Sky"
		if properties then
			desiredEffectNames[source.Name] = true
			if isSky then
				profileHasSky = true
			end
		end
	end

	for _, source in ipairs(profile:GetChildren()) do
		local properties = EFFECT_PROPERTIES[source.ClassName]
		local isAtmosphere = source.ClassName == "Atmosphere"
		local shouldProcess = phase == "All"
			or phase == "Atmosphere" and isAtmosphere
			or phase == "Other" and not isAtmosphere
		if properties and shouldProcess then
			local target = Lighting:FindFirstChild(source.Name)

			if target and target.ClassName ~= source.ClassName then
				if target:GetAttribute(OWNED_EFFECT_ATTRIBUTE) == true then
					target:Destroy()
					target = nil
				else
					DebugModule.debugWarn(
						"Environment effect name is used by another class | name=" .. source.Name,
						MODULE_NAME
					)
					continue
				end
			end

			if not target then
				local clone = source:Clone()
				clone:SetAttribute(OWNED_EFFECT_ATTRIBUTE, true)
				clone.Parent = Lighting
				target = clone
			end

			copyEffectProperties(source, target, properties, animate)
			if target:GetAttribute(OWNED_EFFECT_ATTRIBUTE) == true then
				nextOwnedEffects[source.Name] = target
			end
		end
	end

	if phase ~= "All" or not profileHasSky then
		for effectName, previousEffect in pairs(previousOwnedEffects) do
			if previousEffect:IsA("Sky") then
				desiredEffectNames[effectName] = true
			end
		end
	end

	for effectName, previousEffect in pairs(previousOwnedEffects) do
		if not desiredEffectNames[effectName] and previousEffect.Parent ~= nil then
			previousEffect:Destroy()
		end
	end

	ownedEffects = nextOwnedEffects
end

local function applyEnvironment(environmentName: string, animate: boolean?)
	transitionMaid:DoCleaning()

	local requestedName = if environmentName == "" then "Default" else environmentName
	local profile = getEnvironmentProfile(requestedName)
	if not profile then
		return
	end

	local resolvedName = if profile.Name == "Default" then "Default" else requestedName
	local shouldAnimate = animate ~= false and currentEnvironmentName ~= resolvedName
	if not shouldAnimate or transitionDurationSeconds <= 0 then
		reconcileEffects(profile, false, "All")
		applyLightingAttributes(profile, false)
		setTransitionComplete(true)
	else
		setTransitionComplete(false)
		reconcileEffects(profile, true, "Atmosphere")
		if atmosphereLeadSeconds <= 0 then
			applyLightingAttributes(profile, true)
			reconcileEffects(profile, true, "Other")
		else
			local atmosphereLeadAnchor = Instance.new("NumberValue")
			atmosphereLeadAnchor.Value = 0
			local atmosphereLeadTween =
				TweenService:Create(atmosphereLeadAnchor, atmosphereLeadTweenInfo, { Value = 1 })
			transitionMaid:GiveTask(atmosphereLeadAnchor)
			transitionMaid:GiveTask(atmosphereLeadTween)
			transitionMaid:GiveTask(atmosphereLeadTween.Completed:Connect(function(playbackState: Enum.PlaybackState)
				if playbackState == Enum.PlaybackState.Completed then
					applyLightingAttributes(profile, true)
					reconcileEffects(profile, true, "Other")
				end
			end))
			atmosphereLeadTween:Play()
		end
		scheduleTransitionComplete()
	end

	if currentEnvironmentName ~= resolvedName then
		currentEnvironmentName = resolvedName
		DebugModule.debugInfo("Applied environment | name=" .. resolvedName, MODULE_NAME)
	end
end

local function refreshFromState(animate: boolean)
	if not stateFolder then
		return
	end

	local environmentName = stateFolder:GetAttribute("EnvironmentName")
	applyEnvironment(if typeof(environmentName) == "string" then environmentName else "Default", animate)
end

local function bindStateFolder(folder: Folder)
	stateFolder = folder
	maid.EnvironmentName = folder:GetAttributeChangedSignal("EnvironmentName"):Connect(function()
		refreshFromState(true)
	end)
	refreshFromState(false)
end

function EnvironmentService.Start()
	if initialized then
		return
	end
	initialized = true
	applyEnvironment("Default", false)

	local existingState = ReplicatedStorage:FindFirstChild("LiveEventState")
	if existingState and existingState:IsA("Folder") then
		bindStateFolder(existingState)
	else
		maid.StateAdded = ReplicatedStorage.ChildAdded:Connect(function(child: Instance)
			if child.Name == "LiveEventState" and child:IsA("Folder") then
				maid.StateAdded = nil
				bindStateFolder(child)
			end
		end)
	end
end

function EnvironmentService.SetGlobalShadowsOverride(value: boolean?)
	globalShadowsOverride = value
	if value ~= nil then
		Lighting.GlobalShadows = value
	elseif initialized then
		applyEnvironment(currentEnvironmentName)
	end
end

function EnvironmentService.ApplyForStudio(environmentName: string)
	if typeof(environmentName) ~= "string" or environmentName == "" then
		DebugModule.debugWarn("Studio environment request was empty", MODULE_NAME)
		return
	end

	applyEnvironment(environmentName, false)
end

function EnvironmentService.Stop()
	if not initialized then
		return
	end

	initialized = false
	maid:DoCleaning()
	stateFolder = nil
	globalShadowsOverride = nil
	applyEnvironment("Default", false)
	transitionMaid:DoCleaning()
	currentEnvironmentName = ""
	ownedEffects = {}
end

return EnvironmentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3513">
        <Properties>
          <string name="Name">FavoriteGamePrompt</string>
          <string name="Source"><![CDATA[--!strict

local AvatarEditorService = game:GetService("AvatarEditorService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local LobbyRegionUtils = require(ReplicatedStorage.Modules.LobbyRegionUtils)

local FavoriteGamePrompt = {}

local FAVORITE_ITEM_TYPE = Enum.AvatarItemType.Asset
local DEFERRED_PROMPT_DELAY_SECONDS = 90

type CleanupFunction = () -> ()

local function cancelThread(threadValue: thread?)
	if threadValue and threadValue ~= coroutine.running() and coroutine.status(threadValue) ~= "dead" then
		pcall(task.cancel, threadValue)
	end
end

function FavoriteGamePrompt.PromptAfterLoadingIfEligible(player: Player): boolean
	if not LobbyRegionUtils.IsPlayerInsideCurrentWorldLobby(player) then
		return false
	end

	local placeId = game.PlaceId
	if placeId <= 0 then
		return false
	end

	local favoriteCheckSucceeded, isFavorite = pcall(function(): boolean
		return AvatarEditorService:GetFavoriteAsync(placeId, FAVORITE_ITEM_TYPE)
	end)
	if not favoriteCheckSucceeded or typeof(isFavorite) ~= "boolean" then
		DebugModule.debugWarn(
			string.format(
				"Failed favorite status check for placeId %d: %s",
				placeId,
				tostring(isFavorite)
			),
			"FavoriteGamePrompt"
		)
		return false
	end

	if isFavorite then
		DebugModule.debugInfo(
			string.format("Favorite prompt skipped; player already favorited placeId %d", placeId),
			"FavoriteGamePrompt"
		)
		return false
	end

	local successPrompt, promptError = pcall(function()
		AvatarEditorService:PromptSetFavorite(placeId, FAVORITE_ITEM_TYPE, true)
	end)
	if not successPrompt then
		DebugModule.debugWarn(
			string.format("Failed PromptSetFavorite for placeId %d: %s", placeId, tostring(promptError)),
			"FavoriteGamePrompt"
		)
		return false
	end

	return true
end

function FavoriteGamePrompt.StartDeferredPrompt(player: Player, isAlive: (() -> boolean)?): CleanupFunction
	local alive = true
	local didAttempt = false
	local completionConnection: RBXScriptConnection? = nil
	local delayThread: thread? = nil

	local function cleanup()
		if not alive then
			return
		end

		alive = false
		if completionConnection then
			completionConnection:Disconnect()
			completionConnection = nil
		end
		cancelThread(delayThread)
		delayThread = nil
	end

	local function canContinue(): boolean
		return alive
			and player.Parent ~= nil
			and (isAlive == nil or isAlive())
			and player:GetAttribute("Data_Loaded") == true
	end

	local function tryPrompt()
		if delayThread == coroutine.running() then
			delayThread = nil
		end

		if didAttempt or not canContinue() then
			return
		end

		-- Wait until action tutorial ends so native prompt cannot interrupt it.
		if player:GetAttribute("TutorialCompleted") ~= true then
			return
		end

		didAttempt = true
		cleanup()
		FavoriteGamePrompt.PromptAfterLoadingIfEligible(player)
	end

	completionConnection = player:GetAttributeChangedSignal("TutorialCompleted"):Connect(tryPrompt)
	delayThread = task.delay(DEFERRED_PROMPT_DELAY_SECONDS, tryPrompt)

	return cleanup
end

return FavoriteGamePrompt
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3514">
        <Properties>
          <string name="Name">FramerateManager</string>
          <string name="Source"><![CDATA[--[=[
	Enhanced Frame Rate Manager Module
	Provides dual-mode frame rate management for optimal game performance.

	This module offers:
	- FixedStep: Consistent 60 FPS game logic updates
	- RealTime: Frame-rate independent input processing
	- Hybrid: Systems can use both for optimal performance

	Usage:
	```lua
	local FrameRateManager = require(path.to.FrameRateManager)
	FrameRateManager:Start()

	-- Fixed-step game logic (60 FPS)
	FrameRateManager:BindToUpdate(function(deltaTime)
		-- Your 60 FPS game logic here
	end)

	-- Real-time input processing (actual FPS)
	FrameRateManager:BindToRealTimeInput(function(deltaTime, fpsMultiplier)
		-- Your frame-rate independent input processing here
	end)
	```
	@class FrameRateManager
]=]

local FrameRateManager = {}

-- Dependencies
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CoreConfig = require(script.Parent.Shared.CoreConfig_Client)
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)

-- Module state
local isRunning = false
local fixedStepConnection: RBXScriptConnection?
local realTimeConnection: RBXScriptConnection?
local fixedStepCallbacks: { (deltaTime: number) -> () } = {}
local realTimeInputCallbacks: { (deltaTime: number, fpsMultiplier: number) -> () } = {}
local lastUpdateTime = 0
local accumulatedTime = 0
local targetFPS = 60
local targetFrameTime = 1 / targetFPS
local lastRealTimeUpdate = 0
local DEFAULT_TARGET_FRAME_TIME = 1 / 60
local MAX_FIXED_STEPS_PER_HEARTBEAT = 4

--[=[
	Starts the enhanced frame rate manager with dual-mode processing.
	This creates both fixed-step and real-time update loops.

	@return ()
]=]
function FrameRateManager:Start()
	if isRunning then
		DebugModule.debugPrint("Already running", "FrameRateManager")
		return
	end

	local configuredFrameTime = CoreConfig.performance.maxFrameTime
	targetFrameTime = if typeof(configuredFrameTime) == "number" and configuredFrameTime > 0
		then configuredFrameTime
		else DEFAULT_TARGET_FRAME_TIME
	targetFPS = 1 / targetFrameTime

	-- Fixed-step update loop (60 FPS game logic)
	fixedStepConnection = RunService.Heartbeat:Connect(function(deltaTime: number)
		-- Drop stale time after a stall instead of replaying unlimited updates in one frame.
		local maxCatchUpTime = targetFrameTime * MAX_FIXED_STEPS_PER_HEARTBEAT
		local safeDeltaTime = math.clamp(deltaTime, 0, maxCatchUpTime)
		accumulatedTime = math.min(accumulatedTime + safeDeltaTime, maxCatchUpTime)

		local fixedStepCount = 0
		while accumulatedTime >= targetFrameTime and fixedStepCount < MAX_FIXED_STEPS_PER_HEARTBEAT do
			accumulatedTime -= targetFrameTime
			fixedStepCount += 1

			-- Call all fixed-step update functions
			for _, callback in ipairs(fixedStepCallbacks) do
				callback(targetFrameTime)
			end
		end

		if fixedStepCount >= MAX_FIXED_STEPS_PER_HEARTBEAT then
			accumulatedTime = 0
		end
	end)

	-- Real-time input processing loop (actual FPS) - Only on client
	if RunService:IsClient() then
		realTimeConnection = RunService.RenderStepped:Connect(function(deltaTime: number)
			local currentTime = os.clock()
			local realDeltaTime = currentTime - lastRealTimeUpdate
			lastRealTimeUpdate = currentTime

			-- Calculate FPS multiplier for frame-rate independent processing
			local actualFPS = 1 / math.max(realDeltaTime, 0.001)
			local fpsMultiplier = actualFPS / targetFPS

			-- Call all real-time input functions
			for _, callback in ipairs(realTimeInputCallbacks) do
				callback(realDeltaTime, fpsMultiplier)
			end
		end)
	end

	isRunning = true
	lastUpdateTime = os.clock()
	lastRealTimeUpdate = os.clock()
end

--[=[
	Stops the frame rate manager, halting all updates.

	@return ()
]=]
function FrameRateManager:Stop()
	if not isRunning then
		DebugModule.debugPrint("Not currently running", "FrameRateManager")
		return
	end

	if fixedStepConnection then
		fixedStepConnection:Disconnect()
		fixedStepConnection = nil
	end

	if realTimeConnection then
		realTimeConnection:Disconnect()
		realTimeConnection = nil
	end

	isRunning = false
	accumulatedTime = 0
	fixedStepCallbacks = {}
	realTimeInputCallbacks = {}
end

--[=[
	Binds a callback function to be called at 60 FPS intervals.
	The callback will receive the fixed delta time (1/60 seconds).

	@param callback (deltaTime: number) -> () -- The function to call on each update
	@return ()
]=]
function FrameRateManager:BindToUpdate(callback: (deltaTime: number) -> ())
	if typeof(callback) ~= "function" then
		DebugModule.debugWarn("Callback must be a function", "FrameRateManager")
		return
	end

	table.insert(fixedStepCallbacks, callback)
end

--[=[
	Unbinds a specific callback function from updates.

	@param callback (deltaTime: number) -> () -- The function to remove
	@return ()
]=]
function FrameRateManager:UnbindFromUpdate(callback: (deltaTime: number) -> ())
	for i, boundCallback in ipairs(fixedStepCallbacks) do
		if boundCallback == callback then
			table.remove(fixedStepCallbacks, i)
			break
		end
	end
end

--[=[
	Binds a callback function for real-time input processing at actual frame rate.
	The callback receives real delta time and FPS multiplier for frame-rate independent processing.

	@param callback (deltaTime: number, fpsMultiplier: number) -> () -- The function to call on each frame
	@return ()
]=]
function FrameRateManager:BindToRealTimeInput(callback: (deltaTime: number, fpsMultiplier: number) -> ())
	if typeof(callback) ~= "function" then
		DebugModule.debugWarn("Real-time callback must be a function", "FrameRateManager")
		return
	end

	table.insert(realTimeInputCallbacks, callback)
end

--[=[
	Unbinds a specific real-time input callback function.

	@param callback (deltaTime: number, fpsMultiplier: number) -> () -- The function to remove
	@return ()
]=]
function FrameRateManager:UnbindFromRealTimeInput(callback: (deltaTime: number, fpsMultiplier: number) -> ())
	for i, boundCallback in ipairs(realTimeInputCallbacks) do
		if boundCallback == callback then
			table.remove(realTimeInputCallbacks, i)
			break
		end
	end
end

--[=[
	Returns whether the frame rate manager is currently running.

	@return boolean -- True if manager is active, false otherwise
]=]
function FrameRateManager:IsRunning(): boolean
	return isRunning
end

--[=[
	Gets the current target frame time from CoreConfig.

	@return number -- The target frame time in seconds (1/60 for 60 FPS)
]=]
function FrameRateManager:GetTargetFrameTime(): number
	return targetFrameTime
end

--[=[
	Gets the current target FPS based on CoreConfig settings.

	@return number -- The target FPS (60)
]=]
function FrameRateManager:GetTargetFPS(): number
	return targetFPS
end

--[=[
	Gets the number of currently bound update callbacks.

	@return number -- Number of bound callbacks
]=]
function FrameRateManager:GetCallbackCount(): number
	return #fixedStepCallbacks
end

--[=[
	Gets the number of currently bound real-time input callbacks.

	@return number -- Number of real-time callbacks
]=]
function FrameRateManager:GetRealTimeCallbackCount(): number
	return #realTimeInputCallbacks
end

--[=[
	Gets the current FPS multiplier for frame-rate compensation.

	@return number -- FPS multiplier (actual FPS / target FPS)
]=]
function FrameRateManager:GetCurrentFPSMultiplier(): number
	local currentTime = os.clock()
	local deltaTime = currentTime - lastRealTimeUpdate
	local actualFPS = 1 / math.max(deltaTime, 0.001)
	return actualFPS / targetFPS
end

return FrameRateManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3515">
        <Properties>
          <string name="Name">KartCatalog</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KartCatalog = {}

local function getKartModelsFolder(): Instance?
	return ReplicatedStorage:FindFirstChild("KartModels")
end

local function findModelInFolder(folder: Instance?, kartName: string): Model?
	if not folder then
		return nil
	end

	local directMatch = folder:FindFirstChild(kartName)
	if directMatch and directMatch:IsA("Model") then
		return directMatch
	end

	return nil
end

function KartCatalog.FindModel(kartName: string, sourceFolderName: string?, sourceSubfolderName: string?): Model?
	local kartModelsFolder = getKartModelsFolder()
	if not kartModelsFolder then
		return nil
	end

	local sourceFolder = kartModelsFolder:FindFirstChild(sourceFolderName or "Gamepasses")
	if sourceSubfolderName and sourceFolder then
		sourceFolder = sourceFolder:FindFirstChild(sourceSubfolderName)
	end

	return findModelInFolder(sourceFolder, kartName)
end

function KartCatalog.FindSpecialsFolder(): Instance?
	local kartModelsFolder = getKartModelsFolder()
	return kartModelsFolder and kartModelsFolder:FindFirstChild("Specials")
end

function KartCatalog.FindEventModel(eventName: string, kartName: string): Model?
	local specialsFolder = KartCatalog.FindSpecialsFolder()
	local eventFolder = specialsFolder and specialsFolder:FindFirstChild(eventName)
	return findModelInFolder(eventFolder, kartName)
end

function KartCatalog.FindSpecialModel(kartName: string): Model?
	local specialsFolder = KartCatalog.FindSpecialsFolder()
	local directMatch = findModelInFolder(specialsFolder, kartName)
	if directMatch then
		return directMatch
	end

	if specialsFolder then
		for _, child in ipairs(specialsFolder:GetChildren()) do
			local nestedMatch = findModelInFolder(child, kartName)
			if nestedMatch then
				return nestedMatch
			end
		end
	end

	return nil
end

return KartCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3516">
        <Properties>
          <string name="Name">LiveEventWorldVisualService</string>
          <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)

type FrostbiteVisualConfig = {
	enabled: boolean,
	eventId: string,
	targetColor: Color3,
}

local LiveEventWorldVisualService = {}

local MODULE_NAME = "LiveEventWorldVisualService"
local FROSTBITE_EVENT_ID = "FrostbiteRally"
local WORLD_NAME = "World1"
local TREE_LEAF_SOURCE_COLOR = Color3.fromRGB(44, 101, 29)
local GRASS_SOURCE_COLOR = Color3.fromRGB(58, 125, 21)

local DEFAULT_FROSTBITE_CONFIG: FrostbiteVisualConfig = {
	enabled = true,
	eventId = FROSTBITE_EVENT_ID,
	targetColor = Color3.fromRGB(202, 203, 209),
}

local serviceMaid = Maid.new()
local stateMaid = Maid.new()
local worldMaid = Maid.new()
local originalColors: { [BasePart]: Color3 } = {}
local stateFolder: Folder? = nil
local initialized = false
local frostbiteActive = false

local function getConfig(): FrostbiteVisualConfig
	local rawConfig = CoreConfig.eventWorldVisuals
	local rawFrostbiteConfig = if typeof(rawConfig) == "table" then rawConfig.frostbiteRally else nil
	if typeof(rawFrostbiteConfig) ~= "table" then
		return DEFAULT_FROSTBITE_CONFIG
	end

	return {
		enabled = if typeof(rawFrostbiteConfig.enabled) == "boolean"
			then rawFrostbiteConfig.enabled
			else DEFAULT_FROSTBITE_CONFIG.enabled,
		eventId = if typeof(rawFrostbiteConfig.eventId) == "string"
			then rawFrostbiteConfig.eventId
			else DEFAULT_FROSTBITE_CONFIG.eventId,
		targetColor = if typeof(rawFrostbiteConfig.targetColor) == "Color3"
			then rawFrostbiteConfig.targetColor
			else DEFAULT_FROSTBITE_CONFIG.targetColor,
	}
end

local function isDescendantOf(instance: Instance, root: Instance): boolean
	return instance ~= root and instance:IsDescendantOf(root)
end

local function matchesColor(actual: Color3, expected: Color3): boolean
	local channelTolerance = 1 / 255
	return math.abs(actual.R - expected.R) <= channelTolerance
		and math.abs(actual.G - expected.G) <= channelTolerance
		and math.abs(actual.B - expected.B) <= channelTolerance
end

local function isUnderVipRooms(part: BasePart, world: Instance): boolean
	local vipRooms = world:FindFirstChild("VIPRooms")
	if vipRooms == nil then
		return false
	end

	return isDescendantOf(part, vipRooms)
end

local function isFrostbiteTarget(part: BasePart, world: Instance): boolean
	local terrain = world:FindFirstChild("Terrain")
	if terrain == nil or not isDescendantOf(part, terrain) then
		return isUnderVipRooms(part, world) and matchesColor(part.Color, GRASS_SOURCE_COLOR)
	end

	if part.Name == "TreeLeaves" and matchesColor(part.Color, TREE_LEAF_SOURCE_COLOR) then
		return true
	end

	return matchesColor(part.Color, GRASS_SOURCE_COLOR)
end

local function setFrostbiteColor(part: BasePart, targetColor: Color3)
	if originalColors[part] == nil then
		originalColors[part] = part.Color
	end

	if part.Color ~= targetColor then
		part.Color = targetColor
	end
end

local function restoreOriginalColors()
	for part, originalColor in pairs(originalColors) do
		if part.Parent ~= nil then
			part.Color = originalColor
		end
		originalColors[part] = nil
	end
end

local function applyToWorld(world: Instance)
	local config = getConfig()
	if not config.enabled then
		return
	end

	local changedCount = 0
	for _, descendant in ipairs(world:GetDescendants()) do
		if descendant:IsA("BasePart") and isFrostbiteTarget(descendant, world) then
			setFrostbiteColor(descendant, config.targetColor)
			changedCount += 1
		end
	end

	if changedCount > 0 then
		DebugModule.debugInfo(
			"Frostbite world visuals applied | world=" .. world:GetFullName() .. " | parts=" .. tostring(changedCount),
			MODULE_NAME
		)
	end
end

local function refreshWorldVisuals()
	local config = getConfig()
	local shouldBeActive = frostbiteActive and config.enabled and config.eventId == FROSTBITE_EVENT_ID
	if not shouldBeActive then
		restoreOriginalColors()
		return
	end

	local worlds = Workspace:FindFirstChild("Worlds")
	local world = worlds and worlds:FindFirstChild(WORLD_NAME)
	if world == nil then
		return
	end

	applyToWorld(world)
end

local function bindWorldFolder(worlds: Instance)
	worldMaid:DoCleaning()

	local world = worlds:FindFirstChild(WORLD_NAME)
	if world then
		worldMaid.DescendantAdded = world.DescendantAdded:Connect(function(descendant: Instance)
			if not frostbiteActive or not descendant:IsA("BasePart") then
				return
			end

			local config = getConfig()
			if config.enabled and isFrostbiteTarget(descendant, world) then
				setFrostbiteColor(descendant, config.targetColor)
			end
		end)
		worldMaid.DescendantRemoving = world.DescendantRemoving:Connect(function(descendant: Instance)
			if descendant:IsA("BasePart") then
				originalColors[descendant] = nil
			end
		end)
	end

	worldMaid.WorldAdded = worlds.ChildAdded:Connect(function(child: Instance)
		if child.Name == WORLD_NAME then
			bindWorldFolder(worlds)
			refreshWorldVisuals()
		end
	end)
	worldMaid.WorldRemoved = worlds.ChildRemoved:Connect(function(child: Instance)
		if child.Name == WORLD_NAME then
			restoreOriginalColors()
		end
	end)

	refreshWorldVisuals()
end

local function hasActiveEvent(activeEventIds: string, eventId: string): boolean
	for activeEventId in string.gmatch(activeEventIds, "[^,]+") do
		if activeEventId == eventId then
			return true
		end
	end
	return false
end

local function refreshFromState()
	if stateFolder == nil then
		return
	end

	frostbiteActive = hasActiveEvent(stateFolder:GetAttribute("ActiveEventIds") or "", FROSTBITE_EVENT_ID)
	refreshWorldVisuals()
end

local function bindStateFolder(folder: Folder)
	stateMaid:DoCleaning()
	stateFolder = folder
	stateMaid.ActiveEventIds = folder:GetAttributeChangedSignal("ActiveEventIds"):Connect(refreshFromState)
	refreshFromState()
end

function LiveEventWorldVisualService.Start()
	if initialized then
		return
	end
	initialized = true

	local worlds = Workspace:FindFirstChild("Worlds")
	if worlds then
		bindWorldFolder(worlds)
	else
		serviceMaid.WorldsAdded = Workspace.ChildAdded:Connect(function(child: Instance)
			if child.Name == "Worlds" then
				serviceMaid.WorldsAdded = nil
				bindWorldFolder(child)
			end
		end)
	end

	local existingState = ReplicatedStorage:FindFirstChild("LiveEventState")
	if existingState and existingState:IsA("Folder") then
		bindStateFolder(existingState)
	else
		serviceMaid.StateAdded = ReplicatedStorage.ChildAdded:Connect(function(child: Instance)
			if child.Name == "LiveEventState" and child:IsA("Folder") then
				serviceMaid.StateAdded = nil
				bindStateFolder(child)
			end
		end)
	end
end

function LiveEventWorldVisualService.Stop()
	if not initialized then
		return
	end

	initialized = false
	frostbiteActive = false
	stateMaid:DoCleaning()
	worldMaid:DoCleaning()
	serviceMaid:DoCleaning()
	stateFolder = nil
	restoreOriginalColors()
end

return LiveEventWorldVisualService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3517">
        <Properties>
          <string name="Name">LobbyRegionUtils</string>
          <string name="Source"><![CDATA[local Workspace = game:GetService("Workspace")

local LobbyRegionUtils = {}

function LobbyRegionUtils.IsPointInsidePart(part: BasePart, point: Vector3): boolean
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local halfSize = part.Size * 0.5

	return math.abs(localPoint.X) <= halfSize.X
		and math.abs(localPoint.Y) <= halfSize.Y
		and math.abs(localPoint.Z) <= halfSize.Z
end

function LobbyRegionUtils.GetWorldFolder(worldName: string?): Instance?
	if typeof(worldName) ~= "string" or worldName == "" then
		return nil
	end

	local worldsFolder = Workspace:FindFirstChild("Worlds")
	return worldsFolder and worldsFolder:FindFirstChild(worldName) or nil
end

function LobbyRegionUtils.FindLobbyRegionPart(world: Instance?): BasePart?
	if not world then
		return nil
	end

	local lobbyRegionContainer = world:FindFirstChild("LobbyRegion_Model")
	if not lobbyRegionContainer then
		return nil
	end

	local nestedLobbyRegion = lobbyRegionContainer:FindFirstChild("LobbyRegion", true)
	if nestedLobbyRegion and nestedLobbyRegion:IsA("BasePart") then
		return nestedLobbyRegion
	end

	return nil
end

function LobbyRegionUtils.IsCharacterInsideLobbyRegion(character: Model?, worldName: string?): boolean
	if not character then
		return false
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return false
	end

	local world = LobbyRegionUtils.GetWorldFolder(worldName)
	local lobbyRegion = LobbyRegionUtils.FindLobbyRegionPart(world)
	if not lobbyRegion then
		return false
	end

	return LobbyRegionUtils.IsPointInsidePart(lobbyRegion, rootPart.Position)
end

function LobbyRegionUtils.IsPlayerInsideCurrentWorldLobby(player: Player): boolean
	local currentWorld = player:GetAttribute("Current_World")
	if typeof(currentWorld) ~= "string" then
		return false
	end

	return LobbyRegionUtils.IsCharacterInsideLobbyRegion(player.Character, currentWorld)
end

return LobbyRegionUtils
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3518">
        <Properties>
          <string name="Name">Maid</string>
          <string name="Source"><![CDATA[--[=[
	Manages the cleaning of events and other things. Useful for
	encapsulating state and make deconstructors easy.

	See the [Five Powerful Code Patterns talk](https://developer.roblox.com/en-us/videos/5-powerful-code-patterns-behind-top-roblox-games)
	for a more in-depth look at Maids in top games.

	```lua
	local maid = Maid.new()

	maid:GiveTask(function()
		print("Cleaning up")
	end)

	maid:GiveTask(workspace.ChildAdded:Connect(print))

	-- Disconnects all events, and executes all functions
	maid:DoCleaning()
	```

	@class Maid
]=]
-- luacheck: pop

local Maid = {}
Maid.ClassName = "Maid"

-- Debug
local DebugModule = require(game.ReplicatedStorage.Modules.DebugModule)

--[=[
	Constructs a new Maid object

	```lua
	local maid = Maid.new()
	```

	@return Maid
]=]
function Maid.new()
	return setmetatable({
		_tasks = {},
	}, Maid)
end

local function cancelThread(thread)
	if coroutine.status(thread) == "dead" then
		return
	end

	pcall(task.cancel, thread)
end

--[=[
	Returns true if the class is a maid, and false otherwise.

	```lua
	print(Maid.isMaid(Maid.new())) --> true
	print(Maid.isMaid(nil)) --> false
	```

	@param value any
	@return boolean
]=]
function Maid.isMaid(value)
	return type(value) == "table" and value.ClassName == "Maid"
end

--[=[
	Returns Maid[key] if not part of Maid metatable

	```lua
	local maid = Maid.new()
	maid._current = Instance.new("Part")
	print(maid._current) --> Part

	maid._current = nil
	print(maid._current) --> nil
	```

	@param index any
	@return MaidTask
]=]
function Maid:__index(index)
	if Maid[index] then
		return Maid[index]
	else
		return self._tasks[index]
	end
end

--[=[
	Add a task to clean up. Tasks given to a maid will be cleaned when
	maid[index] is set to a different value.

	Task cleanup is such that if the task is an event, it is disconnected.
	If it is an object, it is destroyed.

	```
	Maid[key] = (function)         Adds a task to perform
	Maid[key] = (event connection) Manages an event connection
	Maid[key] = (thread)           Manages a thread
	Maid[key] = (Maid)             Maids can act as an event connection, allowing a Maid to have other maids to clean up.
	Maid[key] = (Object)           Maids can cleanup objects with a `Destroy` method
	Maid[key] = nil                Removes a named task.
	```

	@param index any
	@param newTask MaidTask
]=]
function Maid:__newindex(index, newTask)
	if Maid[index] ~= nil then
		DebugModule.debugError(("Cannot use '%s' as a Maid key"):format(tostring(index)), nil, "Maid")
	end

	local tasks = self._tasks
	local oldTask = tasks[index]

	if oldTask == newTask then
		return
	end

	tasks[index] = newTask

	if oldTask then
		if type(oldTask) == "function" then
			oldTask()
		elseif type(oldTask) == "thread" then
			cancelThread(oldTask)
		elseif typeof(oldTask) == "RBXScriptConnection" then
			oldTask:Disconnect()
		elseif oldTask.Destroy then
			oldTask:Destroy()
		end
	end
end

--[=[
	Gives a task to the maid for cleanup, but uses an incremented number as a key.

	@param task MaidTask -- An item to clean
	@return number -- taskId
]=]
function Maid:GiveTask(task)
	if not task then
		DebugModule.debugError("Task cannot be false or nil", nil, "Maid")
	end

	local taskId = #self._tasks + 1
	self[taskId] = task

	if type(task) == "table" and not task.Destroy then
		DebugModule.debugWarn("[Maid.GiveTask] - Gave table task without .Destroy\n\n" .. debug.traceback(), "Maid")
	end

	return taskId
end

--[=[
	OPTIMIZATION: Enhanced task tracking for task.spawn threads
	Provides explicit tracking of task.spawn threads to prevent leaks

	@param thread thread -- The task.spawn thread to track
	@return number -- taskId
]=]
function Maid:GiveSpawnTask(thread)
	if type(thread) ~= "thread" then
		DebugModule.debugError("GiveSpawnTask requires a thread", nil, "Maid")
		return
	end

	local taskId = #self._tasks + 1
	self[taskId] = thread

	return taskId
end

--[=[
	Gives a promise to the maid for clean.

	@param promise Promise<T>
	@return Promise<T>
]=]
function Maid:GivePromise(promise)
	if not promise:IsPending() then
		return promise
	end

	local newPromise = promise.resolved(promise)
	local id = self:GiveTask(newPromise)

	-- Ensure GC
	newPromise:Finally(function()
		self[id] = nil
	end)

	return newPromise
end

--[=[
	Cleans up all tasks and removes them as entries from the Maid.

	:::note
	Signals that are already connected are always disconnected first. After that
	any signals added during a cleaning phase will be disconnected at random times.
	:::

	:::tip
	DoCleaning() may be recursively invoked. This allows the you to ensure that
	tasks or other tasks. Each task will be executed once.

	However, adding tasks while cleaning is not generally a good idea, as if you add a
	function that adds itself, this will loop indefinitely.
	:::
]=]
function Maid:DoCleaning()
	local tasks = self._tasks

	-- Disconnect all events first as we know this is safe
	for index, job in pairs(tasks) do
		if typeof(job) == "RBXScriptConnection" then
			tasks[index] = nil
			job:Disconnect()
		end
	end

	-- Clear out tasks table completely, even if clean up tasks add more tasks to the maid
	local index, job = next(tasks)
	while job ~= nil do
		tasks[index] = nil
		if type(job) == "function" then
			job()
		elseif type(job) == "thread" then
			cancelThread(job)
		elseif typeof(job) == "RBXScriptConnection" then
			job:Disconnect()
		elseif job.Destroy then
			job:Destroy()
		end
		index, job = next(tasks)
	end
end

--[=[
	Alias for [Maid.DoCleaning()](/api/Maid#DoCleaning)

	@function Destroy
	@within Maid
]=]
Maid.Destroy = Maid.DoCleaning

return Maid
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3519">
        <Properties>
          <string name="Name">ProductService</string>
          <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local PlayerHandler = require(Modules:WaitForChild("PlayerHandler"))
local SoundService = require(Modules:WaitForChild("SoundService"))
local FunnelAnalytics = require(Modules:WaitForChild("Shared"):WaitForChild("FunnelAnalytics_Client"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))

local ProductService = {}

type CreatorPurchaseFinishedCallback = (purchaseKind: string, productId: number, success: boolean, reason: string) -> ()

local creatorPurchaseFinishedCallbacks: { CreatorPurchaseFinishedCallback } = {}
local CreatorPurchaseRequest = Remotes:WaitForChild("CreatorPurchaseRequest") :: RemoteEvent
local CreatorPurchaseResult = Remotes:WaitForChild("CreatorPurchaseResult") :: RemoteEvent

-------------------------------------------------------------------------------
-- Configurations (Shared Source of Truth)
-------------------------------------------------------------------------------

ProductService.Gamepasses = {
	["2xWins"] = 1760592086,
	["VIP"] = 1761600143,
	["3xTreadmill"] = 1767574117,
	["15xTreadmill"] = 1766286297,
	["35xTreadmill"] = 1767831974,
	["100xTreadmill"] = 1768431922,
	["AdvancedTank"] = 1791998927,
	["ShoppingKart"] = 1790815513,
	["FormulaCar"] = 1792060852,
	["StarterPack"] = 1832483110,
}

ProductService.DevProducts = {
	["SkipRebirth"] = 3559805591,
	["DisableWaves"] = 3559813364,
	["ReturnToStage"] = 3564307894,
	["TrollPlayer"] = 3573199025,
	["+100K"] = 3559807390,
	["+1M"] = 3559807486,
	["+10M"] = 3559807556,
	["+1000"] = 3573866224,
	["+5000"] = 3573865316,
	["+10000"] = 3573900618,
	["2x"] = 3560793026,
	["4x"] = 3560793704,
	["8x"] = 3560793814,
	["16x"] = 3560795074,
	["32x"] = 3560795353,
	["64x"] = 3560795487,
	["100x"] = 3560795766,
	["GalaxyTrail"] = 3572176684,
	["DemonTrail"] = 3572176018,
	["GoldTrail"] = 3572176138,
	["PurpleTrail"] = 3572175420,
	["BlueTrail"] = 3572175233,
	["GreenTrail"] = 3572175108,
	["ClaimAllDaily"] = 3589872144,
	["Spin1"] = 3612605889,
	["Spin3"] = 3612605970,
	["Spin5"] = 3612606198,
	["Spin10"] = 3612606233,
	["TempSpeedBoost"] = 3707042010,
	["TempWinBoost"] = 3707052002,
	["CrimsonCell"] = 3710412649,
	["BloodDragon"] = 3710413009,
	["SiegeTank"] = 3710413231,
}

ProductService.BloodmoonKartProducts = {
	CrimsonCell = {
		KartName = "4_CrimsonCell",
		EventName = "Bloodmoon",
	},
	BloodDragon = {
		KartName = "5_BloodDragon",
		EventName = "Bloodmoon",
	},
	SiegeTank = {
		KartName = "6_SiegeTank",
		EventName = "Bloodmoon",
	},
}

ProductService.MULTIPLIER_TO_PRODUCT = {
	[1] = "2x",
	[2] = "4x",
	[4] = "8x",
	[8] = "16x",
	[16] = "32x",
	[32] = "64x",
	[64] = "100x",
}

ProductService.DataStores = {
	["PlayerStats"] = "PlayerStats_v1",
	["ProfileRegistry"] = "PlayerProfileRegistry_v1",
	["FriendReferralClaims"] = "FriendReferralClaims_v1",
}

-------------------------------------------------------------------------------
-- SAVED_ATTRIBUTES Setup
-------------------------------------------------------------------------------

local NON_PERSISTED = {
	WinMultiplier = true,
	Treadmill_Active = true,
	Treadmill_XPMultiplier = true,
	Friend_XPMultiplier = true,
	Movement_XPGainRate = true,
	Movement_XPGainInterval = true,
	Data_Loaded = true, -- Never persist the loading flag
	PlaytimeRewardElapsed = true, -- Session-only timer
	PlaytimeRewardsClaimed = true, -- Session-only claimed reward tracking
}

local SAVED_ATTRIBUTES = {}
for name, defaultValue in pairs(PlayerHandler.DEFAULT_ATTRIBUTES) do
	if not NON_PERSISTED[name] then
		table.insert(SAVED_ATTRIBUTES, { name = name, default = defaultValue })
	end
end
ProductService.SAVED_ATTRIBUTES = SAVED_ATTRIBUTES

-------------------------------------------------------------------------------
-- Shared Methods
-------------------------------------------------------------------------------

local cache: { [number]: { [number]: boolean } } = {}

local function resolveUserId(playerOrUserId: Player | number): number
	if typeof(playerOrUserId) == "Instance" then
		return (playerOrUserId :: Player).UserId
	end

	return playerOrUserId
end

function ProductService.SetGamePassOwnershipCache(playerOrUserId: Player | number, id: number, owned: boolean)
	local uid = resolveUserId(playerOrUserId)
	if not cache[uid] then
		cache[uid] = {}
	end

	cache[uid][id] = owned
end

function ProductService.ClearOwnershipCache(playerOrUserId: Player | number)
	local uid = resolveUserId(playerOrUserId)
	cache[uid] = nil
end

function ProductService.userOwnsGamePass(player: Player, id: number): boolean
	local uid = player.UserId
	if not cache[uid] then
		cache[uid] = {}
	end
	if cache[uid][id] ~= nil then
		return cache[uid][id]
	end

	local ok, owned = pcall(function()
		return MarketplaceService:UserOwnsGamePassAsync(uid, id)
	end)
	if ok then
		ProductService.SetGamePassOwnershipCache(uid, id, owned)
		return owned
	end
	return false
end

function ProductService.IsLocalExperienceCreator(player: Player): boolean
	local creatorUserId = Remotes:GetAttribute("CreatorPurchaseUserId")
	return RunService:IsClient()
		and player == Players.LocalPlayer
		and typeof(creatorUserId) == "number"
		and player.UserId == creatorUserId
end

function ProductService.ConnectCreatorPurchaseFinished(callback: CreatorPurchaseFinishedCallback): () -> ()
	table.insert(creatorPurchaseFinishedCallbacks, callback)
	local connected = true
	return function()
		if not connected then
			return
		end
		connected = false
		local callbackIndex = table.find(creatorPurchaseFinishedCallbacks, callback)
		if callbackIndex then
			table.remove(creatorPurchaseFinishedCallbacks, callbackIndex)
		end
	end
end

-------------------------------------------------------------------------------
-- Client-Only Prompting
-------------------------------------------------------------------------------

function ProductService.promptGamePassPurchase(player: Player, id: number)
	if not RunService:IsClient() then
		return
	end
	local ok, err = pcall(function()
		MarketplaceService:PromptGamePassPurchase(player, id)
	end)
	if ok then
		if id == ProductService.Gamepasses["StarterPack"] then
			FunnelAnalytics.FireClientAction("StarterPackPromptOpened", {
				source = "GamePassPrompt",
			})
		end
		SoundService.PlayGuiSound("BellRing")
	end
end

function ProductService.promptProductPurchase(player: Player, id: number)
	if not RunService:IsClient() then
		return
	end
	if typeof(id) ~= "number" or id <= 0 then
		DebugModule.debugWarn("Invalid developer product ID: " .. tostring(id), "ProductService")
		return
	end

	local isCreatorProduct = ProductService.IsLocalExperienceCreator(player)
	local creatorIdentityPending = game.CreatorType == Enum.CreatorType.Group
		and Remotes:GetAttribute("CreatorPurchaseIdentityReady") ~= true
	if creatorIdentityPending then
		DebugModule.debugWarn(
			"Developer product request blocked until creator identity is resolved | productId=" .. tostring(id),
			"ProductService"
		)
		return
	end
	DebugModule.debugInfo(
		"Developer product route | productId="
			.. tostring(id)
			.. " | creator="
			.. tostring(isCreatorProduct)
			.. " | serviceReady="
			.. tostring(Remotes:GetAttribute("CreatorPurchaseServiceReady")),
		"ProductService"
	)
	if isCreatorProduct then
		if Remotes:GetAttribute("CreatorPurchaseServiceReady") ~= true then
			DebugModule.debugWarn(
				"Creator developer product request blocked until server service is ready | productId=" .. tostring(id),
				"ProductService"
			)
			return
		end

		local requestOk, requestError = pcall(function()
			CreatorPurchaseRequest:FireServer("Product", id)
		end)
		if requestOk then
			SoundService.PlayGuiSound("BellRing")
		else
			DebugModule.debugWarn(
				"Creator developer product request failed for productId="
					.. tostring(id)
					.. ": "
					.. tostring(requestError),
				"ProductService"
			)
		end
		return
	end

	local ok, err = pcall(function()
		MarketplaceService:PromptProductPurchase(player, id)
	end)
	if ok then
		SoundService.PlayGuiSound("BellRing")
	else
		DebugModule.debugWarn(
			"PromptProductPurchase failed for productId=" .. tostring(id) .. ": " .. tostring(err),
			"ProductService"
		)
	end
end

if RunService:IsClient() then
	CreatorPurchaseResult.OnClientEvent:Connect(function(rawPurchaseKind, rawProductId, rawSuccess, rawReason)
		if
			typeof(rawPurchaseKind) ~= "string"
			or rawPurchaseKind ~= "Product"
			or typeof(rawProductId) ~= "number"
			or typeof(rawSuccess) ~= "boolean"
			or typeof(rawReason) ~= "string"
		then
			DebugModule.debugWarn("Received malformed creator purchase result", "ProductService")
			return
		end

		for _, callback in ipairs(table.clone(creatorPurchaseFinishedCallbacks)) do
			local callbackOk, callbackError = pcall(callback, rawPurchaseKind, rawProductId, rawSuccess, rawReason)
			if not callbackOk then
				DebugModule.debugWarn(
					"Creator purchase result callback failed: " .. tostring(callbackError),
					"ProductService"
				)
			end
		end
		SoundService.PlayGuiSound(if rawSuccess then "Success" else "Close")
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, bought)
		if player == Players.LocalPlayer and bought then
			ProductService.SetGamePassOwnershipCache(player, id, true)
		end
		SoundService.PlayGuiSound(if bought then "Success" else "Close")
	end)

	MarketplaceService.PromptProductPurchaseFinished:Connect(function(_, _, bought)
		SoundService.PlayGuiSound(if bought then "Success" else "Close")
	end)
else
	Players.PlayerRemoving:Connect(function(player)
		ProductService.ClearOwnershipCache(player)
	end)
end

return ProductService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="3520">
        <Properties>
          <string name="Name">RewardedVideoClient</string>
          <string name="Source"><![CDATA[local AdService = game:GetService("AdService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)

local RewardedVideoClient = {}

local MODULE_NAME = "RewardedVideoClient"
local rewardedVideoConfig: any = CoreConfig.rewardedVideo or {}
local ENABLED = rewardedVideoConfig.enabled ~= false
local remotes = ReplicatedStorage:WaitForChild("Remotes")

export type ResultCallback = (
	placementName: string,
	completed: boolean,
	resultName: string,
	remainingUses: number?,
	nextAvailableUnix: number?,
	resetUnix: number?
) -> ()

local function getRemote(name: string): RemoteEvent
	local remote = remotes:WaitForChild(name)
	assert(remote:IsA("RemoteEvent"), string.format("%s must be a RemoteEvent", name))
	return remote
end

function RewardedVideoClient.IsAvailable(): boolean
	if not ENABLED or RunService:IsStudio() then
		return false
	end

	local success, result = pcall(function()
		return AdService:GetAdAvailabilityNowAsync(Enum.AdFormat.RewardedVideo)
	end)
	if not success or typeof(result) ~= "table" then
		DebugModule.debugWarn("Rewarded video availability check failed: " .. tostring(result), MODULE_NAME)
		return false
	end

	return (result :: any).AdAvailabilityResult == Enum.AdAvailabilityResult.IsAvailable
end

function RewardedVideoClient.Request(placementName: string): boolean
	if not ENABLED or typeof(placementName) ~= "string" or placementName == "" then
		return false
	end

	if not RewardedVideoClient.IsAvailable() then
		DebugModule.debugInfo("Rewarded video unavailable | placement=" .. placementName, MODULE_NAME)
		return false
	end

	local success, err = pcall(function()
		getRemote("RewardedVideoRequest"):FireServer(placementName)
	end)
	if not success then
		DebugModule.debugWarn(
			"Rewarded video request failed | placement=" .. placementName .. " | error=" .. tostring(err),
			MODULE_NAME
		)
		return false
	end

	return true
end

function RewardedVideoClient.ConnectResult(callback: ResultCallback): RBXScriptConnection
	return getRemote("RewardedVideoResult").OnClientEvent:Connect(callback)
end

return RewardedVideoClient
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="3521">
