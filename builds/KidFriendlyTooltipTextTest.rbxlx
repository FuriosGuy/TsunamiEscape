          <Item class="ModuleScript" referent="3543">
            <Properties>
              <string name="Name">DailyRewardsUI</string>
              <string name="Source"><![CDATA[local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Maid = require(Modules:WaitForChild("Maid"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local ProductService = require(Modules:WaitForChild("Shared"):WaitForChild("ProductService_Client"))
local FunnelAnalytics = require(Modules:WaitForChild("Shared"):WaitForChild("FunnelAnalytics_Client"))
local SharedFolder = Modules:WaitForChild("Shared")
local CoreConfig = require(SharedFolder:WaitForChild("CoreConfig_Client"))
local UIFolder = Modules:WaitForChild("UI")
local VisualFunctions = require(UIFolder:WaitForChild("VisualFunctions"))
local TweenConfig = require(UIFolder:WaitForChild("TweenConfig"))
local DailyRewardsConfig = require(Modules:WaitForChild("Shared"):WaitForChild("DailyRewardsConfig"))

local DailyRewardsUI = {}
DailyRewardsUI.__index = DailyRewardsUI

local MODULE_NAME = "DailyRewardsUI"
local COUNTDOWN_UPDATE_INTERVAL = 0.2
local DISABLED_CARD_MULTIPLIER = 0.5
local CLAIMABLE_CARD_SCALE = 1.075
local CURRENT_DAY_ATTRIBUTE = DailyRewardsConfig.CURRENT_DAY_ATTRIBUTE
local NEXT_CLAIM_ATTRIBUTE = DailyRewardsConfig.NEXT_CLAIM_ATTRIBUTE
local CYCLE_COUNT_ATTRIBUTE = DailyRewardsConfig.CYCLE_COUNT_ATTRIBUTE
local TIMEZONE_INITIALIZED_ATTRIBUTE = "DailyRewardTimezoneInitialized"
local CLAIM_ALL_PRODUCT_ID = ProductService.DevProducts["ClaimAllDaily"]
local dailyRewardsConfig = if CoreConfig.clientDebug and CoreConfig.clientDebug.dailyRewards
	then CoreConfig.clientDebug.dailyRewards
	else nil
local DEBUG_SEQUENTIAL_CLAIM_MODE = RunService:IsStudio()
	and dailyRewardsConfig
	and typeof(dailyRewardsConfig.debugSequentialClaimMode) == "boolean"
	and dailyRewardsConfig.debugSequentialClaimMode == true

type DailyRewardDefinition = DailyRewardsConfig.DailyRewardDefinition

type ControllerOptions = {
	player: Player,
	root: Instance,
	onClaimableChanged: ((boolean) -> ())?,
}

type RewardEntry = {
	day: number,
	root: Frame,
	rewardAmountLabel: TextLabel,
	rewardTypeImage: ImageLabel,
	dayCounterLabel: TextLabel?,
	gradient: UIGradient,
	uiscale: UIScale,
	lastStyleKey: string?,
}

local function cacheOriginalColorAttributes(target: Instance)
	local targetProps = {}

	if target:IsA("Frame") or target:IsA("ScrollingFrame") then
		table.insert(targetProps, "BackgroundColor3")
	elseif target:IsA("TextLabel") then
		table.insert(targetProps, "TextColor3")
		table.insert(targetProps, "BackgroundColor3")
	elseif target:IsA("TextButton") or target:IsA("TextBox") then
		table.insert(targetProps, "BackgroundColor3")
		table.insert(targetProps, "TextColor3")
	elseif target:IsA("ImageLabel") then
		table.insert(targetProps, "ImageColor3")
		table.insert(targetProps, "BackgroundColor3")
	elseif target:IsA("ImageButton") then
		table.insert(targetProps, "BackgroundColor3")
		table.insert(targetProps, "ImageColor3")
	elseif target:IsA("UIStroke") then
		table.insert(targetProps, "Color")
	end

	for _, targetProp in ipairs(targetProps) do
		local attributeName = "OriginalColor_" .. targetProp
		if target:GetAttribute(attributeName) == nil then
			target:SetAttribute(attributeName, (target :: any)[targetProp])
		end
	end
end

local function cacheEntryOriginalColors(root: Frame)
	if root:GetAttribute("OriginalDisabledBaseColor") == nil then
		root:SetAttribute("OriginalDisabledBaseColor", root.BackgroundColor3)
	end

	cacheOriginalColorAttributes(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		cacheOriginalColorAttributes(descendant)
	end
end

local function formatRewardNumber(value: number): string
	return VisualFunctions.FormatNumber(value)
end

local function formatClockDuration(totalSeconds: number): string
	local clamped = math.max(0, math.floor(totalSeconds))
	local hours = math.floor(clamped / 3600)
	local minutes = math.floor((clamped % 3600) / 60)
	local seconds = clamped % 60
	return string.format("%02d:%02d:%02d", hours, minutes, seconds)
end

local function sanitizeCurrentDay(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 1
	end

	return math.clamp(math.floor(rawValue), 1, DailyRewardsConfig.DAY_COUNT)
end

local function sanitizeCycleCount(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 0
	end

	return math.max(0, math.floor(rawValue))
end

local function sanitizeNextClaimUnix(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 0
	end

	return math.max(0, math.floor(rawValue))
end

local function getLocalTimezoneOffsetMinutes(): number
	local now = DateTime.now()
	local localTime = now:ToLocalTime()
	local localTimeAsUniversal = DateTime.fromUniversalTime(
		localTime.Year,
		localTime.Month,
		localTime.Day,
		localTime.Hour,
		localTime.Minute,
		localTime.Second,
		localTime.Millisecond
	)
	local offsetMinutes = math.round((localTimeAsUniversal.UnixTimestamp - now.UnixTimestamp) / 60)
	return math.clamp(
		offsetMinutes,
		DailyRewardsConfig.MIN_TIMEZONE_OFFSET_MINUTES,
		DailyRewardsConfig.MAX_TIMEZONE_OFFSET_MINUTES
	)
end

local function getRewardPreviewAmount(player: Player, reward: DailyRewardDefinition, cycleCount: number): number
	local maxXPSpeed = player:GetAttribute("MaxXPSpeed")
	local currentWins = player:GetAttribute("WinCount")
	return DailyRewardsConfig.GetRewardAmount(reward, cycleCount, maxXPSpeed, currentWins)
end

local function getRewardAmountText(player: Player, reward: DailyRewardDefinition, cycleCount: number): string
	local previewAmount = getRewardPreviewAmount(player, reward, cycleCount)
	return string.format(
		"%s %s",
		formatRewardNumber(previewAmount),
		DailyRewardsConfig.GetRewardLabel(reward.kind, previewAmount)
	)
end

local function getIconLabel(dayFrame: Frame): ImageLabel?
	local rewardType = dayFrame:FindFirstChild("RewardType")
	if rewardType and rewardType:IsA("ImageLabel") then
		return rewardType
	end

	local kartType = dayFrame:FindFirstChild("KartType")
	if kartType and kartType:IsA("ImageLabel") then
		return kartType
	end

	return dayFrame:FindFirstChildWhichIsA("ImageLabel")
end

local function getOrCreateGradient(dayFrame: Frame): UIGradient
	local existingGradient = dayFrame:FindFirstChildOfClass("UIGradient")
	if existingGradient then
		return existingGradient
	end

	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Parent = dayFrame
	return gradient
end

local function getOrCreateUIScale(dayFrame: Frame): UIScale
	local existingScale = dayFrame:FindFirstChildOfClass("UIScale")
	if existingScale then
		return existingScale
	end

	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1
	uiScale.Parent = dayFrame
	return uiScale
end

function DailyRewardsUI.new(options: ControllerOptions)
	local self = setmetatable({}, DailyRewardsUI)

	self.player = options.player
	self.root = options.root
	self.maid = Maid.new()
	self.buttonMaid = Maid.new()
	self.entries = {} :: { [number]: RewardEntry }
	self.destroyed = false
	self.updateAccumulator = 0
	self.lastClaimButtonClaimable = nil :: boolean?
	self.lastClaimableState = nil :: boolean?
	self.onClaimableChanged = if typeof(options.onClaimableChanged) == "function"
		then options.onClaimableChanged
		else nil
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	self.dailyRewardAction = remotes:WaitForChild("DailyRewardAction") :: RemoteEvent
	self.dailyRewardTimeSync = remotes:WaitForChild("DailyRewardTimeSync") :: RemoteEvent
	self.frame = nil :: Frame?
	self.claimDailyButton = nil :: TextButton?
	self.claimDailyButtonFrame = nil :: Frame?
	self.claimAllButton = nil :: TextButton?
	self.claimAllButtonFrame = nil :: Frame?
	self.claimAllPriceLabel = nil :: TextLabel?
	self.dailyCountdownLabel = nil :: TextLabel?

	self:Rebuild()
	self:Bind()
	self:SyncLocalTime()
	self:Refresh()

	return self
end

function DailyRewardsUI:SyncLocalTime()
	if self.destroyed or self.player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	self.dailyRewardTimeSync:FireServer(getLocalTimezoneOffsetMinutes())
end

function DailyRewardsUI:FindDailyRewardFrame(): Frame?
	local frame = self.root:FindFirstChild("DailyRewardFrame", true)
	if frame and frame:IsA("Frame") then
		return frame
	end

	return nil
end

function DailyRewardsUI:Rebuild()
	table.clear(self.entries)
	self.buttonMaid:DoCleaning()

	self.frame = self:FindDailyRewardFrame()
	if not self.frame then
		return
	end

	local bodyFrame = self.frame:FindFirstChild("BodyFrame")
	if not bodyFrame or not bodyFrame:IsA("Frame") then
		return
	end

	self.dailyCountdownLabel = bodyFrame:FindFirstChild("DailyCountdown") :: TextLabel?
	self.claimDailyButtonFrame = self.frame:FindFirstChild("ClaimDailyButton") :: Frame?
	self.claimAllButtonFrame = self.frame:FindFirstChild("ClaimAllDailyButton") :: Frame?
	self.claimDailyButton = self.claimDailyButtonFrame
			and self.claimDailyButtonFrame:FindFirstChildWhichIsA("TextButton", true)
		or nil
	self.claimAllButton = self.claimAllButtonFrame
			and self.claimAllButtonFrame:FindFirstChildWhichIsA("TextButton", true)
		or nil
	self.claimAllPriceLabel = self.claimAllButtonFrame
			and self.claimAllButtonFrame:FindFirstChild("PriceLabel", true) :: TextLabel?
		or nil

	if self.claimDailyButtonFrame then
		cacheEntryOriginalColors(self.claimDailyButtonFrame)
	end
	if self.claimAllButtonFrame then
		cacheEntryOriginalColors(self.claimAllButtonFrame)
	end

	for day = 1, DailyRewardsConfig.DAY_COUNT do
		local dayFrame = bodyFrame:FindFirstChild(string.format("Day%dInfo", day))
		if not dayFrame or not dayFrame:IsA("Frame") then
			continue
		end

		local rewardAmountLabel = dayFrame:FindFirstChild("RewardAmount") :: TextLabel?
		local rewardTypeImage = getIconLabel(dayFrame)
		if not rewardAmountLabel or not rewardTypeImage then
			DebugModule.debugWarn(
				string.format(
					"Daily reward entry missing UI refs for day %d | amount=%s icon=%s",
					day,
					tostring(rewardAmountLabel ~= nil),
					tostring(rewardTypeImage ~= nil)
				),
				MODULE_NAME
			)
			continue
		end

		local dayCounterLabel = dayFrame:FindFirstChild("DayCounter") :: TextLabel?
		local gradient = getOrCreateGradient(dayFrame)
		local uiScale = getOrCreateUIScale(dayFrame)
		gradient.Rotation = 90
		cacheEntryOriginalColors(dayFrame)

		self.entries[day] = {
			day = day,
			root = dayFrame,
			rewardAmountLabel = rewardAmountLabel,
			rewardTypeImage = rewardTypeImage,
			dayCounterLabel = dayCounterLabel,
			gradient = gradient,
			uiscale = uiScale,
			lastStyleKey = nil,
		}
	end

	if self.claimAllPriceLabel and CLAIM_ALL_PRODUCT_ID then
		task.defer(function()
			if self.destroyed then
				return
			end

			local ok, productInfo = pcall(function()
				return MarketplaceService:GetProductInfo(CLAIM_ALL_PRODUCT_ID, Enum.InfoType.Product)
			end)
			if ok and typeof(productInfo) == "table" and self.claimAllPriceLabel and self.claimAllPriceLabel.Parent then
				self.claimAllPriceLabel.Text = tostring(productInfo.PriceInRobux or 0)
			end
		end)
	end

	if self.claimDailyButton then
		self.buttonMaid:GiveTask(self.claimDailyButton.Activated:Connect(function()
			if self.destroyed then
				return
			end

			if self.player:GetAttribute(TIMEZONE_INITIALIZED_ATTRIBUTE) ~= true then
				self:SyncLocalTime()
				return
			end

			local nextClaimUnix = sanitizeNextClaimUnix(self.player:GetAttribute(NEXT_CLAIM_ATTRIBUTE))
			local isClaimable = if DEBUG_SEQUENTIAL_CLAIM_MODE then true else os.time() >= nextClaimUnix
			if not isClaimable then
				return
			end

			self.dailyRewardAction:FireServer("ClaimCurrent")
		end))
	end

	if self.claimAllButton and CLAIM_ALL_PRODUCT_ID then
		self.buttonMaid:GiveTask(self.claimAllButton.Activated:Connect(function()
			if self.destroyed then
				return
			end

			FunnelAnalytics.FireClientAction("DailyRewardClaimAllPromptOpened", {
				source = "DailyRewardsUI",
			})
			ProductService.promptProductPurchase(self.player, CLAIM_ALL_PRODUCT_ID)
		end))
	end
end

function DailyRewardsUI:ApplyFrameStyle(
	entry: RewardEntry,
	isClaimed: boolean,
	isCurrentDay: boolean,
	isClaimable: boolean
)
	local styleKey = table.concat({
		tostring(isClaimed),
		tostring(isCurrentDay),
		tostring(isClaimable),
	}, ":")
	if entry.lastStyleKey == styleKey then
		return
	end
	entry.lastStyleKey = styleKey

	local reward = DailyRewardsConfig.GetReward(entry.day)
	if not reward then
		return
	end

	local topColor = reward.topColor
	local bottomColor = reward.bottomColor
	local shouldDisable = isClaimed or not isCurrentDay
	local targetScale = if isCurrentDay then CLAIMABLE_CARD_SCALE else 1

	entry.root.BackgroundColor3 = topColor
	entry.root:SetAttribute("OriginalDisabledBaseColor", topColor)
	entry.root:SetAttribute("OriginalColor_BackgroundColor3", topColor)
	entry.gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, topColor),
		ColorSequenceKeypoint.new(1, bottomColor),
	})
	VisualFunctions.SetFrameDisabledState(entry.root, shouldDisable, DISABLED_CARD_MULTIPLIER)
	TweenService:Create(
		entry.uiscale,
		TweenConfig.DailyRewardCard,
		{ Scale = targetScale }
	):Play()
end

function DailyRewardsUI:ApplyClaimButtonState(isClaimable: boolean)
	if self.lastClaimButtonClaimable == isClaimable then
		return
	end
	self.lastClaimButtonClaimable = isClaimable

	local button = self.claimDailyButton
	local buttonFrame = self.claimDailyButtonFrame

	if buttonFrame then
		VisualFunctions.SetFrameDisabledState(buttonFrame, not isClaimable, 0.65)
	end

	if not button then
		return
	end

	button.AutoButtonColor = false
	button.Active = isClaimable
	button.Selectable = isClaimable
	button.Text = "CLAIM"
end

function DailyRewardsUI:NotifyClaimableChanged(isClaimable: boolean)
	if self.lastClaimableState == isClaimable then
		return
	end
	self.lastClaimableState = isClaimable

	local callback = self.onClaimableChanged
	if not callback then
		return
	end

	local ok, err = pcall(callback, isClaimable)
	if not ok then
		DebugModule.debugWarn(string.format("onClaimableChanged callback failed: %s", tostring(err)), MODULE_NAME)
	end
end

function DailyRewardsUI:Refresh()
	if self.destroyed then
		return
	end

	if next(self.entries) == nil then
		self:Rebuild()
	end

	local currentDay = sanitizeCurrentDay(self.player:GetAttribute(CURRENT_DAY_ATTRIBUTE))
	local cycleCount = sanitizeCycleCount(self.player:GetAttribute(CYCLE_COUNT_ATTRIBUTE))
	local nextClaimUnix = sanitizeNextClaimUnix(self.player:GetAttribute(NEXT_CLAIM_ATTRIBUTE))
	local nowUnix = os.time()
	local timezoneInitialized = self.player:GetAttribute(TIMEZONE_INITIALIZED_ATTRIBUTE) == true
	local claimable = if DEBUG_SEQUENTIAL_CLAIM_MODE
		then true
		else timezoneInitialized and nowUnix >= nextClaimUnix
	local remainingSeconds = if timezoneInitialized then math.max(0, nextClaimUnix - nowUnix) else 0

	for day, entry in pairs(self.entries) do
		local reward = DailyRewardsConfig.GetReward(day)
		if not reward then
			continue
		end

		entry.rewardAmountLabel.Text = getRewardAmountText(self.player, reward, cycleCount)
		entry.rewardTypeImage.Image = reward.image
		if entry.dayCounterLabel then
			entry.dayCounterLabel.Text = string.format("DAY %d", day)
		end

		local isClaimed = day < currentDay
		self:ApplyFrameStyle(entry, isClaimed, day == currentDay, claimable)
	end

	if self.dailyCountdownLabel then
		self.dailyCountdownLabel.Visible = true
		self.dailyCountdownLabel.Text = if not timezoneInitialized and not DEBUG_SEQUENTIAL_CLAIM_MODE
			then "SYNCING LOCAL TIME..."
			elseif claimable
			then "REWARD READY!"
			else string.format("DAY %d REWARD AVAILABLE IN %s", currentDay, formatClockDuration(remainingSeconds))
	end

	self:ApplyClaimButtonState(claimable)
	self:NotifyClaimableChanged(claimable)
end

function DailyRewardsUI:Bind()
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(CURRENT_DAY_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(NEXT_CLAIM_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(TIMEZONE_INITIALIZED_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("Data_Loaded"):Connect(function()
		self:SyncLocalTime()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(CYCLE_COUNT_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("MaxXPSpeed"):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("WinCount"):Connect(function()
		self:Refresh()
	end))

	self.maid:GiveTask(self.root.DescendantAdded:Connect(function(descendant)
		if
			descendant.Name == "DailyRewardFrame"
			or descendant.Name == "ClaimDailyButton"
			or descendant.Name == "ClaimAllDailyButton"
			or string.match(descendant.Name, "^Day%dInfo$")
		then
			task.defer(function()
				if self.destroyed then
					return
				end
				self:Rebuild()
				self:Refresh()
			end)
		end
	end))

	self.maid:GiveTask(RunService.Heartbeat:Connect(function(dt)
		self.updateAccumulator += dt
		if self.updateAccumulator < COUNTDOWN_UPDATE_INTERVAL then
			return
		end
		self.updateAccumulator = 0
		self:Refresh()
	end))
end

function DailyRewardsUI:Destroy()
	if self.destroyed then
		return
	end

	self.destroyed = true
	self:NotifyClaimableChanged(false)
	self.maid:DoCleaning()
	self.buttonMaid:DoCleaning()
	table.clear(self.entries)
end

return DailyRewardsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3544">
            <Properties>
              <string name="Name">DisplayRefreshBindings</string>
              <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlayerHandler = require(ReplicatedStorage.Modules.Shared:WaitForChild("PlayerHandler_Client"))
local VisualFunctions = require(ReplicatedStorage.Modules.UI.VisualFunctions)

local DisplayRefreshBindings = {}

local DEFAULT_PLAYER_SPEED = if typeof(PlayerHandler.DEFAULT_ATTRIBUTES.Player_Speed) == "number"
	then PlayerHandler.DEFAULT_ATTRIBUTES.Player_Speed
	else 16

type MaidLike = {
	GiveTask: (self: MaidLike, task: any) -> any,
}

type BindOptions = {
	player: Player,
	sessionMaid: MaidLike,
	updateUI: () -> (),
	updateXPProductLabels: () -> (),
	updateVerifyRewardValueLabels: () -> (),
	updateMultiplierShop: () -> (),
	updateX2WinShop: () -> (),
	updateShopButtons: () -> (),
	updateKartShop: () -> (),
	updateTrailMultiplierDisplay: () -> (),
}

function DisplayRefreshBindings.Bind(options: BindOptions)
	local function bind(attributeName: string, callback: () -> ())
		options.sessionMaid:GiveTask(options.player:GetAttributeChangedSignal(attributeName):Connect(callback))
	end

	local function updateRebirthAndProductDisplay()
		options.updateUI()
		options.updateXPProductLabels()
		options.updateVerifyRewardValueLabels()
	end

	local function updateDevProductDisplay()
		options.updateMultiplierShop()
		options.updateXPProductLabels()
		options.updateVerifyRewardValueLabels()
	end

	local function updateMiscMultiplierDisplay()
		options.updateXPProductLabels()
		options.updateTrailMultiplierDisplay()
		options.updateVerifyRewardValueLabels()
	end

	local function updateFriendMultiplierDisplay()
		local friendMultiplier = options.player:GetAttribute("Friend_XPMultiplier") or 1
		VisualFunctions.UpdateFriendMultiplierLabel(friendMultiplier)
		options.updateVerifyRewardValueLabels()
	end

	local function updateWinMultiplierDisplay()
		options.updateX2WinShop()
		options.updateXPProductLabels()
		options.updateShopButtons()
		options.updateKartShop()
		options.updateVerifyRewardValueLabels()
	end

	local function updatePlayerSpeedDisplay()
		local speedTextBox = VisualFunctions.HUD.CustomSpeedTextBox
		if speedTextBox then
			speedTextBox.PlaceholderText = tostring(PlayerHandler.GetEffectiveMaxPlayerSpeed(options.player))
			if not speedTextBox:IsFocused() then
				speedTextBox.Text = tostring(PlayerHandler.GetEffectiveWalkSpeed(options.player))
			end
		end
	end

	bind("MaxLevel", updateRebirthAndProductDisplay)
	bind("Rebirth_XPMultiplier", updateRebirthAndProductDisplay)
	bind("DevProduct_XPSpeedMultiplier", updateDevProductDisplay)
	bind("Misc_XPSpeedMultiplier", updateMiscMultiplierDisplay)
	bind("Friend_XPMultiplier", updateFriendMultiplierDisplay)
	bind("WinMultiplier", updateWinMultiplierDisplay)
	bind("Player_Speed", updatePlayerSpeedDisplay)
	bind("LiveEvent_WalkSpeedMultiplier", options.updateUI)
end

return DisplayRefreshBindings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="3545">
            <Properties>
              <string name="Name">EventProgressUI</string>
              <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

local TweenService = game:GetService("TweenService")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)
local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local PlayerHandler = require(ReplicatedStorage.Modules.Shared:WaitForChild("PlayerHandler_Client"))
local SpinWheelConfig = require(ReplicatedStorage.Modules.Config.SpinWheelConfig)
local TweenConfig = require(ReplicatedStorage.Modules.UI.TweenConfig)
local NotificationLayoutController = require(ReplicatedStorage.Modules.UI.MainGUI.NotificationLayoutController)

local MODULE_NAME = "EventProgressUI"
local DEFAULT_MAX_WINS = 100
local MARKER_PREFIX = "BloodmoonUnlock_"
local TRAIL_MARKER_IMAGE_SCALE = 1.25
local KART_MARKER_IMAGE_SCALE = 2.5
local FINAL_MARKER_END_INSET_SCALE = 0.02

type UnlockKind = "Trail" | "Kart"

type UnlockDefinition = {
	id: string,
	displayName: string,
	winsRequired: number,
	kind: UnlockKind,
	imageAssetId: string?,
}

type MaidLike = {
	GiveTask: (self: MaidLike, task: any) -> number,
	DoCleaning: (self: MaidLike) -> (),
}

type ProgressFrameVisibilityControllerLike = {
	SetEventActive: (self: ProgressFrameVisibilityControllerLike, isActive: boolean) -> (),
}

type EventProgressTheme = {
	id: string,
	backgroundColor: Color3,
	gradientColor: Color3,
	infoText: string,
	winsAttribute: string,
	maxWins: number,
	showUnlocks: boolean,
	unlockDefinitions: { UnlockDefinition },
}

type EventProgressUIObject = {
	screenGui: ScreenGui,
	root: Frame?,
	currentWinsLabel: TextLabel?,
	currentStageLabel: TextLabel?,
	nextUnlockLabel: TextLabel?,
	infoLabel: TextLabel?,
	trackFrame: Frame?,
	progressFrame: Frame?,
	markersFrame: Frame?,
	markerTemplate: GuiObject?,
	stageProgressFrame: GuiObject?,
	progressHeightScale: number,
	progressHeightOffset: number,
	maxWins: number,
	defaultUnlockDefinitions: { UnlockDefinition },
	unlockDefinitions: { UnlockDefinition },
	originalRootVisible: boolean?,
	visibilityController: ProgressFrameVisibilityControllerLike?,
	stateFolder: Folder?,
	maid: MaidLike,
	stateMaid: MaidLike,
	progressTween: Tween?,
	initialized: boolean,
	eventActive: boolean,
	activeTheme: EventProgressTheme?,
	activeWinsAttribute: string,
	activeMaxWins: number,
	showUnlocks: boolean,
	themeMaid: MaidLike,
}

local EventProgressUI = {}
EventProgressUI.__index = EventProgressUI

local function isFiniteNumber(value: unknown): boolean
	return typeof(value) == "number" and value == value and value < math.huge and value > -math.huge
end

local function getTextLabel(parent: Instance?, name: string): TextLabel?
	if not parent then
		return nil
	end

	local child = parent:FindFirstChild(name)
	return if child and child:IsA("TextLabel") then child else nil
end

local function getGuiObject(parent: Instance?, name: string): GuiObject?
	if not parent then
		return nil
	end

	local child = parent:FindFirstChild(name)
	return if child and child:IsA("GuiObject") then child else nil
end

local function parseUnlockDefinitions(rawUnlocks: unknown, maxWins: number): { UnlockDefinition }
	local unlockDefinitions: { UnlockDefinition } = {}
	if typeof(rawUnlocks) ~= "table" then
		return unlockDefinitions
	end

	for _, rawUnlock in ipairs(rawUnlocks) do
		if
			typeof(rawUnlock) == "table"
			and typeof(rawUnlock.id) == "string"
			and typeof(rawUnlock.displayName) == "string"
			and isFiniteNumber(rawUnlock.winsRequired)
			and (rawUnlock.kind == "Trail" or rawUnlock.kind == "Kart")
		then
			local winsRequired = math.clamp(math.floor(rawUnlock.winsRequired), 1, maxWins)
			table.insert(unlockDefinitions, {
				id = rawUnlock.id,
				displayName = rawUnlock.displayName,
				winsRequired = winsRequired,
				kind = rawUnlock.kind,
				imageAssetId = if typeof(rawUnlock.imageAssetId) == "string" and rawUnlock.imageAssetId ~= ""
					then rawUnlock.imageAssetId
					else nil,
			})
		end
	end

	table.sort(unlockDefinitions, function(left: UnlockDefinition, right: UnlockDefinition): boolean
		if left.winsRequired == right.winsRequired then
			return left.id < right.id
		end
		return left.winsRequired < right.winsRequired
	end)

	return unlockDefinitions
end

local function loadUnlockDefinitions(): ({ UnlockDefinition }, number)
	local rawConfig = CoreConfig.bloodmoonProgress
	if typeof(rawConfig) ~= "table" or rawConfig.enabled == false then
		return {}, DEFAULT_MAX_WINS
	end

	local maxWins = if isFiniteNumber(rawConfig.maxWins)
		then math.max(1, math.floor(rawConfig.maxWins))
		else DEFAULT_MAX_WINS
	return parseUnlockDefinitions(rawConfig.unlocks, maxWins), maxWins
end

local function getMarkerImage(unlockDefinition: UnlockDefinition): string
	if typeof(unlockDefinition.imageAssetId) == "string" and unlockDefinition.imageAssetId ~= "" then
		return unlockDefinition.imageAssetId
	end

	if unlockDefinition.kind == "Trail" then
		local trailConfig = PlayerHandler.GetTrailConfig(unlockDefinition.id)
		local trailImage = trailConfig and trailConfig.ImageAssetId
		if typeof(trailImage) == "string" and trailImage ~= "" then
			return trailImage
		end
	end

	local rewardId: SpinWheelConfig.RewardId = if unlockDefinition.kind == "Trail" then "FlameTrail" else "FlameKart"
	local reward = SpinWheelConfig.GetReward(rewardId)
	return if reward then reward.imageAssetId else ""
end

local function parseHexColor(value: unknown): Color3?
	if typeof(value) ~= "string" then
		return nil
	end

	local redHex, greenHex, blueHex = string.match(value, "^#?(%x%x)(%x%x)(%x%x)$")
	if not redHex or not greenHex or not blueHex then
		return nil
	end

	local red = tonumber(redHex, 16)
	local green = tonumber(greenHex, 16)
	local blue = tonumber(blueHex, 16)
	if red == nil or green == nil or blue == nil then
		return nil
	end

	return Color3.fromRGB(red, green, blue)
end

local function formatStageWinAwards(rawAwards: unknown): string?
	if typeof(rawAwards) ~= "table" then
		return nil
	end

	local awards: { { stage: number, amount: number } } = {}
	for _, rawAward in ipairs(rawAwards) do
		if
			type(rawAward) == "table"
			and isFiniteNumber(rawAward.minimumStage)
			and isFiniteNumber(rawAward.amount)
			and rawAward.minimumStage >= 0
			and rawAward.amount > 0
		then
			table.insert(awards, {
				stage = math.floor(rawAward.minimumStage),
				amount = math.floor(rawAward.amount),
			})
		end
	end

	if #awards == 0 then
		return nil
	end

	table.sort(awards, function(left, right)
		return left.stage < right.stage
	end)

	local phrases: { string } = {}
	for _, award in ipairs(awards) do
		local winWord = if award.amount == 1 then "WIN" else "WINS"
		table.insert(phrases, string.format("STAGE %d: %d %s", award.stage, award.amount, winWord))
	end

	return table.concat(phrases, " | ") .. "!"
end

local function getActiveEventTheme(stateFolder: Folder): EventProgressTheme?
	local activeEvents = stateFolder:GetAttribute("ActiveEvents")
	if typeof(activeEvents) ~= "string" or activeEvents == "" then
		return nil
	end

	local ok, decoded = pcall(function()
		return HttpService:JSONDecode(activeEvents)
	end)
	if not ok or typeof(decoded) ~= "table" then
		return nil
	end

	for _, eventEntry in ipairs(decoded) do
		if typeof(eventEntry) == "table" and typeof(eventEntry.id) == "string" then
			local progressUi = eventEntry.progressUi
			if typeof(progressUi) == "table" then
				local backgroundColor = parseHexColor(progressUi.backgroundColor)
				local gradientColor = parseHexColor(progressUi.gradientColor)
				local infoText = if typeof(progressUi.infoText) == "string" and progressUi.infoText ~= ""
					then progressUi.infoText
					else formatStageWinAwards(eventEntry.stageWinAwards)
				if
					backgroundColor
					and gradientColor
					and typeof(infoText) == "string"
					and infoText ~= ""
				then
					local winsAttribute = if typeof(progressUi.winsAttribute) == "string"
						and progressUi.winsAttribute ~= ""
						then progressUi.winsAttribute
						elseif typeof(eventEntry.kartWinsAttribute) == "string"
						and eventEntry.kartWinsAttribute ~= ""
						then eventEntry.kartWinsAttribute
						else "BloodmoonWins"
					local maxWins = if isFiniteNumber(progressUi.maxWins)
						then math.max(1, math.floor(progressUi.maxWins))
						else DEFAULT_MAX_WINS
					local unlockDefinitions = parseUnlockDefinitions(progressUi.unlocks, maxWins)
					return {
						id = eventEntry.id,
						backgroundColor = backgroundColor,
						gradientColor = gradientColor,
						infoText = string.upper(infoText),
						winsAttribute = winsAttribute,
						maxWins = maxWins,
						showUnlocks = progressUi.showUnlocks ~= false,
						unlockDefinitions = unlockDefinitions,
					}
				end
			end
		end
	end

	return nil
end

local function setGradientEndColor(parent: GuiObject?, color: Color3)
	if not parent then
		return
	end

	local gradient = parent:FindFirstChildWhichIsA("UIGradient", true)
	if not gradient then
		return
	end

	local keypoints = gradient.Color.Keypoints
	if #keypoints == 0 then
		return
	end

	local updatedKeypoints = table.clone(keypoints)
	local finalKeypoint = updatedKeypoints[#updatedKeypoints]
	updatedKeypoints[#updatedKeypoints] = ColorSequenceKeypoint.new(finalKeypoint.Time, color)
	gradient.Color = ColorSequence.new(updatedKeypoints)
end

local function applyEventTheme(object: EventProgressUIObject, theme: EventProgressTheme)
	if object.progressFrame then
		object.progressFrame.BackgroundColor3 = theme.backgroundColor
		setGradientEndColor(object.progressFrame, theme.gradientColor)
	end
	if object.infoLabel then
		object.infoLabel.Text = theme.infoText
		object.infoLabel.TextColor3 = theme.backgroundColor
		setGradientEndColor(object.infoLabel, theme.gradientColor)
	end
end

local function configureMarker(marker: GuiObject, unlockDefinition: UnlockDefinition)
	marker.Name = MARKER_PREFIX .. unlockDefinition.id
	marker.AnchorPoint = Vector2.new(0.5, 0.5)
	marker.Visible = true

	local imageLabel = marker:FindFirstChild("ImageLabel", true)
	if imageLabel and imageLabel:IsA("ImageLabel") then
		imageLabel.Image = getMarkerImage(unlockDefinition)
		local imageScale = if unlockDefinition.kind == "Kart" then KART_MARKER_IMAGE_SCALE else TRAIL_MARKER_IMAGE_SCALE
		imageLabel.Size = UDim2.fromScale(imageScale, imageScale)
	end

	local winRequiredLabel = marker:FindFirstChild("WinRequired", true)
	if winRequiredLabel and winRequiredLabel:IsA("TextLabel") then
		winRequiredLabel.Text = string.format("%d Wins", unlockDefinition.winsRequired)
	end
end

local function getMarkerPosition(trackFrame: Frame, markersFrame: Frame, progress: number): UDim2
	local trackSize = trackFrame.AbsoluteSize
	local markersSize = markersFrame.AbsoluteSize
	if trackSize.X <= 0 or trackSize.Y <= 0 or markersSize.X <= 0 or markersSize.Y <= 0 then
		return UDim2.new(progress, 0, 0.5, 0)
	end

	local trackPoint = trackFrame.AbsolutePosition + Vector2.new(trackSize.X * progress, trackSize.Y * 0.5)
	local markersPoint = trackPoint - markersFrame.AbsolutePosition
	return UDim2.fromOffset(markersPoint.X, markersPoint.Y)
end

function EventProgressUI.new(
	screenGui: ScreenGui,
	visibilityController: ProgressFrameVisibilityControllerLike?
): EventProgressUIObject
	local rootInstance = screenGui:FindFirstChild("EventProgress")
	local root = if rootInstance and rootInstance:IsA("Frame") then rootInstance else nil
	local currentWinsLabel = getTextLabel(root, "CurrentWins")
	local currentStageLabel = getTextLabel(root, "CurrentStage")
	local nextUnlockLabel = getTextLabel(root, "NextUnlock")
	local infoLabel = getTextLabel(root, "Info")
	local trackFrameInstance = getGuiObject(root, "TrackFrame")
	local trackFrame = if trackFrameInstance and trackFrameInstance:IsA("Frame") then trackFrameInstance else nil
	local progressFrameInstance = getGuiObject(trackFrame, "ProgressFrame")
	local progressFrame = if progressFrameInstance and progressFrameInstance:IsA("Frame")
		then progressFrameInstance
		else nil
	local markersFrameInstance = getGuiObject(trackFrame, "Markers")
	local markersFrame = if markersFrameInstance and markersFrameInstance:IsA("Frame")
		then markersFrameInstance
		else nil
	local markerTemplate = getGuiObject(trackFrame, "StageMarkerTemplate")
	local stageProgressFrame = getGuiObject(screenGui, "StageProgressFrame")
	local unlockDefinitions, maxWins = loadUnlockDefinitions()

	return setmetatable({
		screenGui = screenGui,
		root = root,
		currentWinsLabel = currentWinsLabel,
		currentStageLabel = currentStageLabel,
		nextUnlockLabel = nextUnlockLabel,
		infoLabel = infoLabel,
		trackFrame = trackFrame,
		progressFrame = progressFrame,
		markersFrame = markersFrame,
		markerTemplate = markerTemplate,
		stageProgressFrame = stageProgressFrame,
		progressHeightScale = if progressFrame then progressFrame.Size.Y.Scale else 1,
		progressHeightOffset = if progressFrame then progressFrame.Size.Y.Offset else 0,
		maxWins = maxWins,
		defaultUnlockDefinitions = unlockDefinitions,
		unlockDefinitions = unlockDefinitions,
		originalRootVisible = if root then root.Visible else nil,
		visibilityController = visibilityController,
		stateFolder = nil,
		maid = Maid.new() :: MaidLike,
		stateMaid = Maid.new() :: MaidLike,
		progressTween = nil,
		initialized = false,
		eventActive = false,
		activeTheme = nil,
		activeWinsAttribute = "BloodmoonWins",
		activeMaxWins = maxWins,
		showUnlocks = true,
		themeMaid = Maid.new() :: MaidLike,
	}, EventProgressUI)
end

function EventProgressUI:refreshProgress()
	local currentStage = 0
	local currentWins = 0
	local localPlayer = Players.LocalPlayer
	if localPlayer then
		local stageAttribute = localPlayer:GetAttribute("CurrentStage")
		if isFiniteNumber(stageAttribute) then
			currentStage = math.max(0, math.floor(stageAttribute))
		end

		local eventWins = localPlayer:GetAttribute(self.activeWinsAttribute)
		if isFiniteNumber(eventWins) then
			currentWins = math.max(0, math.floor(eventWins))
		end
	end

	if self.currentStageLabel then
		self.currentStageLabel.Text = string.format("STAGE %d", currentStage)
	end

	if self.currentWinsLabel then
		self.currentWinsLabel.Text = string.format("%d Wins", currentWins)
	end

	if self.progressFrame then
		local progress = math.clamp(currentWins / self.activeMaxWins, 0, 1)
		local targetSize = UDim2.new(progress, 0, self.progressHeightScale, self.progressHeightOffset)
		if self.progressTween then
			self.progressTween:Cancel()
			self.progressTween:Destroy()
			self.progressTween = nil
		end

		if currentWins <= 0 then
			self.progressFrame.Visible = false
			self.progressFrame.Size = targetSize
		else
			self.progressFrame.Visible = true
			self.progressTween = TweenService:Create(self.progressFrame, TweenConfig.ProgressBar, {
				Size = targetSize,
			})
			self.progressTween:Play()
		end
	end

	if self.nextUnlockLabel then
		if not self.showUnlocks then
			self.nextUnlockLabel.Text = ""
			return
		end

		local nextUnlock: UnlockDefinition? = nil
		for _, unlockDefinition in ipairs(self.unlockDefinitions) do
			if unlockDefinition.winsRequired > currentWins then
				nextUnlock = unlockDefinition
				break
			end
		end
		self.nextUnlockLabel.Text = if nextUnlock then nextUnlock.displayName else "ALL REWARDS UNLOCKED"
	end
end

function EventProgressUI:buildMarkers()
	if not self.markersFrame or not self.markerTemplate then
		return
	end

	self.markersFrame.ClipsDescendants = false
	local desiredNames: { [string]: boolean } = {}
	for _, unlockDefinition in ipairs(self.unlockDefinitions) do
		local markerName = MARKER_PREFIX .. unlockDefinition.id
		desiredNames[markerName] = true
		local markerInstance = self.markersFrame:FindFirstChild(markerName)
		local marker = if markerInstance and markerInstance:IsA("GuiObject")
			then markerInstance
			else self.markerTemplate:Clone()

		configureMarker(marker, unlockDefinition)
		if marker.Parent ~= self.markersFrame then
			marker.Parent = self.markersFrame
		end
	end

	for _, child in ipairs(self.markersFrame:GetChildren()) do
		if string.sub(child.Name, 1, #MARKER_PREFIX) == MARKER_PREFIX and not desiredNames[child.Name] then
			child:Destroy()
		end
	end
	self.markerTemplate.Visible = false
	self:positionMarkers()
end

function EventProgressUI:positionMarkers()
	if not self.trackFrame or not self.markersFrame then
		return
	end

	for _, unlockDefinition in ipairs(self.unlockDefinitions) do
		local marker = self.markersFrame:FindFirstChild(MARKER_PREFIX .. unlockDefinition.id)
		if marker and marker:IsA("GuiObject") then
			local progress = unlockDefinition.winsRequired / self.activeMaxWins
			if unlockDefinition.winsRequired >= self.activeMaxWins then
				progress = math.max(0, progress - FINAL_MARKER_END_INSET_SCALE)
			end
			marker.Position = getMarkerPosition(self.trackFrame, self.markersFrame, progress)
		end
	end
end

function EventProgressUI:setEventTheme(theme: EventProgressTheme?)
	self.themeMaid:DoCleaning()
	self.themeMaid = Maid.new() :: MaidLike
	self.activeWinsAttribute = if theme then theme.winsAttribute else "BloodmoonWins"
	self.activeMaxWins = if theme then theme.maxWins else self.maxWins
	self.unlockDefinitions = if theme then theme.unlockDefinitions else self.defaultUnlockDefinitions
	self.showUnlocks = if theme then theme.showUnlocks else true
	if self.markersFrame then
		self.markersFrame.Visible = self.showUnlocks
	end
	if self.nextUnlockLabel then
		self.nextUnlockLabel.Visible = theme ~= nil and self.showUnlocks
	end
	if theme then
		self.themeMaid:GiveTask(
			Players.LocalPlayer:GetAttributeChangedSignal(self.activeWinsAttribute):Connect(function()
				if self.eventActive then
					self:refreshProgress()
				end
			end)
		)
	end

	local isActive = theme ~= nil
	local previousEventId = if self.activeTheme then self.activeTheme.id else nil
	local currentEventId = if theme then theme.id else nil
	local eventChanged = self.eventActive ~= isActive or previousEventId ~= currentEventId
	self.eventActive = isActive
	self.activeTheme = theme

	if eventChanged then
		self:buildMarkers()
	end

	if self.visibilityController then
		self.visibilityController:SetEventActive(isActive)
	elseif self.root then
		self.root.Visible = isActive
		if self.stageProgressFrame then
			self.stageProgressFrame.Visible = not isActive
		end
	end

	if theme then
		applyEventTheme(self, theme)
		self:refreshProgress()
	end

	if eventChanged then
		DebugModule.debugInfo(
			"Event progress layout state changed | active="
				.. tostring(isActive)
				.. " | event="
				.. tostring(currentEventId or "none"),
			MODULE_NAME
		)
		NotificationLayoutController.Refresh()
	end
end

function EventProgressUI:bindStateFolder(stateFolder: Folder)
	self.stateMaid:DoCleaning()
	self.stateMaid = Maid.new() :: MaidLike
	self.stateFolder = stateFolder
	self.stateMaid:GiveTask(stateFolder:GetAttributeChangedSignal("ActiveEvents"):Connect(function()
		self:setEventTheme(getActiveEventTheme(stateFolder))
	end))
	self.stateMaid:GiveTask(stateFolder.AncestryChanged:Connect(function(_, parent: Instance?)
		if parent == nil and self.stateFolder == stateFolder then
			self.stateFolder = nil
			self:setEventTheme(nil)
		end
	end))
	self:setEventTheme(getActiveEventTheme(stateFolder))
end

function EventProgressUI:Init()
	if self.initialized then
		return
	end
	self.initialized = true

	if
		not self.root
		or not self.trackFrame
		or not self.progressFrame
		or not self.markersFrame
		or not self.markerTemplate
	then
		if self.visibilityController then
			self.visibilityController:SetEventActive(false)
		end
		DebugModule.debugWarn("EventProgress UI hierarchy is incomplete", MODULE_NAME)
		return
	end

	self.root.Visible = false
	self:buildMarkers()
	self.maid:GiveTask(self.trackFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		self:positionMarkers()
	end))
	self.maid:GiveTask(self.trackFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:positionMarkers()
	end))
	self.maid:GiveTask(self.markersFrame:GetPropertyChangedSignal("AbsolutePosition"):Connect(function()
		self:positionMarkers()
	end))
	self.maid:GiveTask(self.markersFrame:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
		self:positionMarkers()
	end))
	self.maid:GiveTask(Players.LocalPlayer:GetAttributeChangedSignal("CurrentStage"):Connect(function()
		if self.eventActive then
			self:refreshProgress()
		end
	end))
	self.maid:GiveTask(ReplicatedStorage.ChildAdded:Connect(function(child: Instance)
		if child.Name == "LiveEventState" and child:IsA("Folder") then
			self:bindStateFolder(child)
		end
	end))

	local stateFolder = ReplicatedStorage:FindFirstChild("LiveEventState")
	if stateFolder and stateFolder:IsA("Folder") then
		self:bindStateFolder(stateFolder)
	else
		self:setEventTheme(nil)
	end
end

function EventProgressUI:Destroy()
	if not self.initialized then
		return
	end
	self.initialized = false
	self.stateMaid:DoCleaning()
	self.maid:DoCleaning()
	self.themeMaid:DoCleaning()
	if self.progressTween then
		self.progressTween:Cancel()
		self.progressTween:Destroy()
		self.progressTween = nil
	end
	self.stateFolder = nil
	self:setEventTheme(nil)
	if self.root and self.originalRootVisible ~= nil then
		self.root.Visible = self.originalRootVisible
	end
end

return EventProgressUI
]]></string>
