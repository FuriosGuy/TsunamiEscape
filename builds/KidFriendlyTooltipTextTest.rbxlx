local isCleaningUp = false

local function deferTopLevel(callback: () -> ())
	local thread = task.defer(function()
		if isCleaningUp then
			return
		end
		callback()
	end)
	topLevelMaid:GiveTask(thread)
end

topLevelMaid:GiveTask(function()
	for root, rootMaid in pairs(observedKartVisualSourceRoots) do
		rootMaid:DoCleaning()
		observedKartVisualSourceRoots[root] = nil
	end
	for root, rootMaid in pairs(observedWorldSourceRoots) do
		rootMaid:DoCleaning()
		observedWorldSourceRoots[root] = nil
	end
end)

local function countTrackedEquippedKartStates(): number
	local count = 0
	for _ in pairs(observedEquippedKarts) do
		count += 1
	end

	return count
end

local function listContainsModule(moduleList: { any }?, moduleName: string): boolean
	if typeof(moduleList) ~= "table" then
		return false
	end

	for _, entry in ipairs(moduleList) do
		if entry == moduleName then
			return true
		end
	end

	return false
end

local function isModuleDebugEnabled(moduleName: string): boolean
	local settings = DebugModule.getSettings()
	if not settings.enabled then
		return false
	end

	local moduleOverrides = settings.moduleOverrides
	if typeof(moduleOverrides) == "table" then
		local overrideValue = moduleOverrides[moduleName]
		if typeof(overrideValue) == "boolean" then
			return overrideValue
		end
	end

	if listContainsModule(settings.disabledModules, moduleName) then
		return false
	end

	local enabledModules = settings.enabledModules
	if typeof(enabledModules) == "table" and #enabledModules > 0 then
		return listContainsModule(enabledModules, moduleName)
	end

	return true
end

local function isKartRespawnProbeEnabled(): boolean
	return isModuleDebugEnabled("PlayerClientHandler")
end

local function logKartRespawnProbe(reason: string)
	if not isKartRespawnProbeEnabled() then
		return
	end

	local equippedKartCount = 0
	local motorCount = 0
	local clientKartEngineSoundCount = 0
	local motorNames = {}
	local equippedKartName = player:GetAttribute("Kart_Equipped")

	for _, descendant in ipairs(Workspace:GetDescendants()) do
		if descendant:IsA("Model") and descendant.Name == "EquippedKart" then
			local ownerUserId = descendant:GetAttribute("OwnerUserId")
			if typeof(ownerUserId) == "number" and ownerUserId == player.UserId then
				equippedKartCount += 1
			end
		elseif descendant:IsA("Motor6D") and string.match(descendant.Name, "_Motor$") then
			local equippedKartModel = descendant:FindFirstAncestor(EQUIPPED_KART_MODEL_NAME)
			if equippedKartModel and equippedKartModel:IsA("Model") then
				local ownerUserId = equippedKartModel:GetAttribute("OwnerUserId")
				if typeof(ownerUserId) == "number" and ownerUserId == player.UserId then
					motorCount += 1
					table.insert(motorNames, descendant.Name)
				end
			end
		elseif descendant:IsA("Sound") and descendant.Name == CLIENT_KART_ENGINE_SOUND_NAME then
			local equippedKartModel = descendant:FindFirstAncestor("EquippedKart")
			local ownerUserId = equippedKartModel and equippedKartModel:GetAttribute("OwnerUserId")
			if typeof(ownerUserId) == "number" and ownerUserId == player.UserId then
				clientKartEngineSoundCount += 1
			end
		end
	end

	DebugModule.debugInfo(
		string.format(
			"Kart respawn probe | reason=%s | equippedKart=%s | equippedKarts=%d | rootMotors=%d | clientKartEngineSounds=%d | trackedEquippedKartStates=%d | motorNames=%s",
			reason,
			tostring(equippedKartName),
			equippedKartCount,
			motorCount,
			clientKartEngineSoundCount,
			countTrackedEquippedKartStates(),
			table.concat(motorNames, ",")
		),
		"PlayerClientHandler"
	)
end

local function scheduleKartRespawnProbe(reason: string, delaySeconds: number)
	if not isKartRespawnProbeEnabled() then
		return
	end

	topLevelMaid:GiveTask(task.delay(delaySeconds, function()
		if isCleaningUp or not player.Parent or not isKartRespawnProbeEnabled() then
			return
		end

		logKartRespawnProbe(reason)
	end))
end

local function normalizeTrackId(trackId: string | number): string
	if typeof(trackId) == "number" then
		return "rbxassetid://" .. tostring(trackId)
	end

	if string.find(trackId, "rbxassetid://") == 1 then
		return trackId
	end

	return "rbxassetid://" .. trackId
end

local function normalizeSoundId(soundId: string | number): string
	if typeof(soundId) == "number" then
		return "rbxassetid://" .. tostring(soundId)
	end

	if string.find(soundId, "rbxassetid://") == 1 then
		return soundId
	end

	return "rbxassetid://" .. soundId
end

local function findBasePartByName(root: Instance, partName: string): BasePart?
	local part = root:FindFirstChild(partName, true)
	if part and part:IsA("BasePart") then
		return part
	end

	return nil
end

local function getEngineParent(model: Model): BasePart?
	local seatBase = model:FindFirstChild("SeatBase", true)
	if seatBase and seatBase:IsA("BasePart") then
		return seatBase
	end

	return nil
end

local function destroyClientKartSmokeEmitters(rootPart: BasePart)
	for _, child in ipairs(rootPart:GetChildren()) do
		if child:IsA("ParticleEmitter") and string.find(child.Name, CLIENT_KART_SMOKE_NAME_PREFIX, 1, true) == 1 then
			child:Destroy()
		end
	end
end

local function createClientKartSmokeEmitters(
	rootPart: BasePart
): ({ ParticleEmitter }, { [ParticleEmitter]: NumberRange })
	destroyClientKartSmokeEmitters(rootPart)

	local particlesFolder = ReplicatedStorage:FindFirstChild("Particles")
	local smokeTrailFolder = particlesFolder and particlesFolder:FindFirstChild("SmokeTrail")
	if not smokeTrailFolder then
		return {}, {}
	end

	local smokeEmitters = {}
	local emitterSpeeds: { [ParticleEmitter]: NumberRange } = {}
	local emitterIndex = 0

	for _, descendant in ipairs(smokeTrailFolder:GetDescendants()) do
		if descendant:IsA("ParticleEmitter") then
			emitterIndex += 1
			local clone = descendant:Clone()
			clone.Name = CLIENT_KART_SMOKE_NAME_PREFIX .. tostring(emitterIndex)
			clone.Enabled = false
			clone.Parent = rootPart
			table.insert(smokeEmitters, clone)
			emitterSpeeds[clone] = clone.Speed
		end
	end

	return smokeEmitters, emitterSpeeds
end

local function createOrUpdateClientKartEngineSound(parent: BasePart, soundIdValue: string): Sound?
	local existing = parent:FindFirstChild(CLIENT_KART_ENGINE_SOUND_NAME)
	local sound = if existing and existing:IsA("Sound") then existing else nil
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = CLIENT_KART_ENGINE_SOUND_NAME
		sound.Parent = parent
	end

	local kartEngineConfig = (SoundService.Sounds :: any).KartEngine
	if not kartEngineConfig then
		return sound
	end

	sound.SoundId = normalizeSoundId(soundIdValue)
	sound.Volume = kartEngineConfig.Volume or 1
	sound.PlaybackSpeed = kartEngineConfig.PlaybackSpeed or kartEngineConfig.Pitch or 1
	sound.Looped = kartEngineConfig.Looped == true

	if kartEngineConfig.RollOffMode then
		sound.RollOffMode = kartEngineConfig.RollOffMode
	end

	if kartEngineConfig.RollOffMinDistance then
		sound.RollOffMinDistance = kartEngineConfig.RollOffMinDistance
	end

	if kartEngineConfig.RollOffMaxDistance then
		sound.RollOffMaxDistance = kartEngineConfig.RollOffMaxDistance
	end

	if not sound.IsPlaying then
		sound:Play()
	end

	return sound
end

local function applyPoliceKartVisuals(
	phaseTime: number,
	lightBarBlue: BasePart?,
	lightBarRed: BasePart?,
	spotlightLensL: BasePart?,
	spotlightLensR: BasePart?
)
	local alternatePhase = math.floor(phaseTime / POLICE_LIGHT_PHASE_DURATION) % 2
	local blueOn = alternatePhase == 0
	local redOn = not blueOn

	if lightBarBlue then
		lightBarBlue.Color = if blueOn then POLICE_BLUE_COLOR else POLICE_RED_COLOR
		lightBarBlue.Transparency = 0
	end

	if lightBarRed then
		lightBarRed.Color = if redOn then POLICE_BLUE_COLOR else POLICE_RED_COLOR
		lightBarRed.Transparency = 0
	end

	local strobeCycle = phaseTime % POLICE_SPOTLIGHT_STROBE_CYCLE
	local spotlightOn = strobeCycle < POLICE_SPOTLIGHT_ON_DURATION

	if spotlightLensL then
		spotlightLensL.Transparency = if spotlightOn then 0 else 1
	end

	if spotlightLensR then
		spotlightLensR.Transparency = if spotlightOn then 0 else 1
	end
end

local function applyCurrentPoliceKartVisuals(
	visualOffset: number,
	lightBarBlue: BasePart?,
	lightBarRed: BasePart?,
	spotlightLensL: BasePart?,
	spotlightLensR: BasePart?
)
	applyPoliceKartVisuals(
		Workspace:GetServerTimeNow() + visualOffset,
		lightBarBlue,
		lightBarRed,
		spotlightLensL,
		spotlightLensR
	)
end

local function getClientWheelMotors(seatBase: BasePart?): { { motor: Motor6D, baseC0: CFrame, radius: number } }
	if not seatBase then
		return {}
	end

	local wheelMotors = {}
	for _, child in ipairs(seatBase:GetChildren()) do
		if child:IsA("Motor6D") and string.match(child.Name, "_Motor$") then
			local wheelPart = child.Part1
			local radius = 1
			if wheelPart and wheelPart:IsA("BasePart") then
				radius = math.max(0.05, math.max(wheelPart.Size.Y, wheelPart.Size.Z) * 0.5)
			end

			table.insert(wheelMotors, {
				motor = child,
				baseC0 = child.C0,
				radius = radius,
			})
		end
	end

	return wheelMotors
end

local function registerTreadmillTexture(instance: Instance)
	if not instance:IsA("Texture") then
		return
	end

	local movementPart = instance:FindFirstAncestor("MovementPart")
	if not movementPart or not movementPart:IsA("BasePart") then
		return
	end

	observedTreadmillTextures[instance] = {
		scrollSpeed = TREADMILL_TEXTURE_SCROLL_SPEED,
		updateAccumulator = 0,
		worldPosition = movementPart.Position,
	}
end

local function registerTreadmillTouchPart(instance: Instance)
	if not instance:IsA("BasePart") then
		return
	end

	local isTouchPart = instance.Name == "TouchPart"
	local isStandaloneTreadmill = typeof(instance:GetAttribute("XP_Multiplier")) == "number"
		and typeof(instance:GetAttribute("XPGainInterval")) == "number"
	if not isTouchPart and not isStandaloneTreadmill then
		return
	end

	local treadmillRoot = instance:FindFirstAncestorOfClass("Model")
	if treadmillRoot then
		observedTreadmillTouchParts[instance] = treadmillRoot
		return
	end

	observedTreadmillTouchParts[instance] = instance
end

local function distanceFromPointToPartBounds(part: BasePart, point: Vector3): number
	local localPoint = part.CFrame:PointToObjectSpace(point)
	local halfSize = part.Size * 0.5
	local dx = math.max(math.abs(localPoint.X) - halfSize.X, 0)
	local dy = math.max(math.abs(localPoint.Y) - halfSize.Y, 0)
	local dz = math.max(math.abs(localPoint.Z) - halfSize.Z, 0)
	return Vector3.new(dx, dy, dz).Magnitude
end

local function setActiveTreadmillHighlightAdornee(adornee: Instance?)
	if not activeTreadmillHighlight then
		local highlight = Instance.new("Highlight")
		highlight.Name = "ClientActiveTreadmillHighlight"
		highlight.DepthMode = Enum.HighlightDepthMode.Occluded
		highlight.FillColor = TREADMILL_HIGHLIGHT_FILL_COLOR
		highlight.FillTransparency = 1
		highlight.OutlineColor = TREADMILL_HIGHLIGHT_OUTLINE_COLOR
		highlight.OutlineTransparency = 0
		highlight.Enabled = false
		highlight.Parent = Workspace
		activeTreadmillHighlight = highlight
	end

	if not adornee then
		activeTreadmillHighlightAdornee = nil
		activeTreadmillHighlight.Adornee = nil
		activeTreadmillHighlight.Enabled = false
		return
	end

	if activeTreadmillHighlightAdornee == adornee and activeTreadmillHighlight.Enabled then
		return
	end

	activeTreadmillHighlightAdornee = adornee
	activeTreadmillHighlight.Adornee = adornee
	activeTreadmillHighlight.Enabled = true
end

local function getCurrentTreadmillHighlightAdornee(): Instance?
	if player:GetAttribute("Treadmill_Active") ~= true then
		return nil
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart")
	if not rootPart or not rootPart:IsA("BasePart") then
		return nil
	end

	local currentWorld = player:GetAttribute("Current_World")
	if typeof(currentWorld) ~= "string" or currentWorld == "" then
		return nil
	end

	local worldsFolder = Workspace:FindFirstChild("Worlds")
	local world = worldsFolder and worldsFolder:FindFirstChild(currentWorld)
	if not world then
		return nil
	end

	local closestDistance = math.huge
	local closestAdornee: Instance? = nil
	for touchPart, adornee in pairs(observedTreadmillTouchParts) do
		if not touchPart.Parent then
			observedTreadmillTouchParts[touchPart] = nil
			continue
		end

		if not touchPart:IsDescendantOf(world) then
			continue
		end

		local distance = distanceFromPointToPartBounds(touchPart, rootPart.Position)
		if distance <= TREADMILL_HIGHLIGHT_MAX_DISTANCE and distance < closestDistance then
			closestDistance = distance
			closestAdornee = adornee
		end
	end

	return closestAdornee
end

local function updateTreadmillHighlight(dt: number)
	treadmillHighlightUpdateAccumulator += dt
	if treadmillHighlightUpdateAccumulator < TREADMILL_HIGHLIGHT_UPDATE_INTERVAL then
		return
	end

	treadmillHighlightUpdateAccumulator = 0
	setActiveTreadmillHighlightAdornee(getCurrentTreadmillHighlightAdornee())
end

local function onBlockRobloxFreecamAction(
	_: string,
	inputState: Enum.UserInputState,
	inputObject: InputObject
): Enum.ContextActionResult
	if inputState ~= Enum.UserInputState.Begin then
		return Enum.ContextActionResult.Pass
	end

	if inputObject.KeyCode ~= Enum.KeyCode.P then
		return Enum.ContextActionResult.Pass
	end

	local shiftHeld = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
		or UserInputService:IsKeyDown(Enum.KeyCode.RightShift)
	if shiftHeld then
		return Enum.ContextActionResult.Pass
	end

	return Enum.ContextActionResult.Sink
end

local function cleanupObservedEquippedKart(state: EquippedKartVisualState)
	if state.engineSound and state.engineSound.Parent then
		state.engineSound:Destroy()
	end

	for _, emitter in ipairs(state.smokeEmitters) do
		if emitter.Parent then
			emitter:Destroy()
		end
	end
end

local function setKartSmokeEmittersActive(state: EquippedKartVisualState, enabled: boolean, moving: boolean)
	for _, emitter in ipairs(state.smokeEmitters) do
		if emitter.Parent then
			local shouldEmit = enabled and moving
			emitter.Enabled = shouldEmit
			emitter.Speed = if shouldEmit
				then (state.emitterSpeeds[emitter] or NumberRange.new(0))
				else NumberRange.new(0)
		end
	end
end

local function cleanupObservedTrailVisual(playerToCleanup: Player)
	local trailState = observedTrailVisuals[playerToCleanup]
	if not trailState then
		return
	end

	observedTrailVisuals[playerToCleanup] = nil

	for _, trail in ipairs(trailState.trails) do
		if trail.Parent then
			trail:Destroy()
		end
	end

	for _, emitter in ipairs(trailState.emitters) do
		if emitter.Parent then
			emitter:Destroy()
		end
	end

	if trailState.attachment0 and trailState.attachment0.Parent then
		trailState.attachment0:Destroy()
	end

	if trailState.attachment1 and trailState.attachment1.Parent then
		trailState.attachment1:Destroy()
	end
end

local function cleanupObservedTrailPlayerBindings(playerToCleanup: Player)
	local playerMaid = observedTrailPlayerMaids[playerToCleanup]
	if not playerMaid then
		return
	end

	playerMaid:DoCleaning()
	observedTrailPlayerMaids[playerToCleanup] = nil
end

local function getRemoteTrailBudgetConfig(): RemoteTrailBudgetConfig
	local rawConfig = CoreConfig.clientCulling
	if typeof(rawConfig) ~= "table" then
		return {
			enabled = true,
			updateInterval = 0.25,
			mobileDistanceMultiplier = 0.65,
			fullDistance = 120,
			disableDistance = 360,
			reducedRateMultiplier = 0.5,
			maxVisiblePlayers = 6,
		}
	end

	local function readNumber(value: any, fallback: number): number
		return if typeof(value) == "number" then value else fallback
	end

	return {
		enabled = rawConfig.remoteTrailEnabled ~= false,
		updateInterval = math.max(0.1, readNumber(rawConfig.remoteTrailUpdateInterval, 0.25)),
		mobileDistanceMultiplier = math.clamp(
			readNumber(rawConfig.remoteTrailMobileDistanceMultiplier, 0.65),
			0.1,
			1
		),
		fullDistance = math.max(0, readNumber(rawConfig.remoteTrailFullDistance, 120)),
		disableDistance = math.max(
			readNumber(rawConfig.remoteTrailDisableDistance, 360),
			readNumber(rawConfig.remoteTrailFullDistance, 120)
		),
		reducedRateMultiplier = math.clamp(
			readNumber(rawConfig.remoteTrailReducedRateMultiplier, 0.5),
			0.1,
			1
		),
		maxVisiblePlayers = math.max(0, math.floor(readNumber(rawConfig.remoteTrailMaxVisiblePlayers, 6))),
	}
end

local function setObservedTrailQuality(
	state: ObservedTrailVisualState,
	quality: RemoteTrailQuality,
	reducedRateMultiplier: number
)
	if state.quality == quality then
		return
	end

	local isEnabled = quality ~= "disabled"
	for _, trail in ipairs(state.trails) do
		if trail.Parent then
			trail.Enabled = isEnabled
		end
	end

	for _, emitter in ipairs(state.emitters) do
		if emitter.Parent then
			emitter.Enabled = isEnabled
			local baseRate = state.emitterRates[emitter] or emitter.Rate
			emitter.Rate = if quality == "reduced"
				then baseRate * reducedRateMultiplier
				else baseRate
		end
	end

	state.quality = quality
end

local function syncObservedTrailVisual(playerToSync: Player)
	local equippedTrail = playerToSync:GetAttribute("Trail_Equipped")
	local characterToSync = playerToSync.Character
	local rootPart = characterToSync and (characterToSync:FindFirstChild("HumanoidRootPart") :: BasePart?) or nil
	if typeof(equippedTrail) ~= "string" or equippedTrail == "" or equippedTrail == "None" then
		cleanupObservedTrailVisual(playerToSync)
		return
	end

	if not rootPart then
		local existingState = observedTrailVisuals[playerToSync]
		if existingState then
			existingState.missingUntil = existingState.missingUntil or (os.clock() + TRAIL_VISUAL_MISSING_GRACE)
		end
		return
	end

	local existingState = observedTrailVisuals[playerToSync]
	if
		existingState
		and existingState.character == characterToSync
		and existingState.rootPart == rootPart
		and existingState.equippedTrail == equippedTrail
	then
		existingState.missingUntil = nil
		return
	end

	cleanupObservedTrailVisual(playerToSync)

	local particlesFolder = ReplicatedStorage:FindFirstChild("Particles")
	local trailFolder = particlesFolder and particlesFolder:FindFirstChild(equippedTrail)
	if not trailFolder then
		return
	end

	local attachment0 = Instance.new("Attachment")
	attachment0.Name = CLIENT_TRAIL_ATTACHMENT0_NAME
	attachment0.Position = Vector3.new(0, rootPart.Size.Y * 0.5, 0)
	attachment0.Parent = rootPart

	local attachment1 = Instance.new("Attachment")
	attachment1.Name = CLIENT_TRAIL_ATTACHMENT1_NAME
	attachment1.Position = Vector3.new(0, -rootPart.Size.Y * 0.5, 0)
	attachment1.Parent = rootPart

	local clonedTrails = {}
	local clonedEmitters = {}
	local emitterRates: { [ParticleEmitter]: number } = {}
	local emitterSpeeds: { [ParticleEmitter]: NumberRange } = {}

	for _, descendant in ipairs(trailFolder:GetDescendants()) do
		if descendant:IsA("Trail") then
			local clone = descendant:Clone()
			clone.Name = CLIENT_TRAIL_VISUAL_PREFIX .. descendant.Name
			clone.Attachment0 = attachment0
			clone.Attachment1 = attachment1
			clone.Enabled = true
			clone.Parent = rootPart
			table.insert(clonedTrails, clone)
		elseif descendant:IsA("ParticleEmitter") then
			local clone = descendant:Clone()
			clone.Name = CLIENT_TRAIL_VISUAL_PREFIX .. descendant.Name
			clone.Enabled = true
			clone.Parent = rootPart
			table.insert(clonedEmitters, clone)
			emitterRates[clone] = clone.Rate
			emitterSpeeds[clone] = clone.Speed
		end
	end

	observedTrailVisuals[playerToSync] = {
		player = playerToSync,
		character = characterToSync,
		rootPart = rootPart,
		equippedTrail = equippedTrail,
		attachment0 = attachment0,
		attachment1 = attachment1,
		trails = clonedTrails,
		emitters = clonedEmitters,
		emitterRates = emitterRates,
		emitterSpeeds = emitterSpeeds,
		lastMoving = nil,
		missingUntil = nil,
		quality = nil,
	}
end

local function reconcileObservedTrailVisual(playerToSync: Player)
	local equippedTrail = playerToSync:GetAttribute("Trail_Equipped")
	if typeof(equippedTrail) == "string" and equippedTrail ~= "" and equippedTrail ~= "None" then
		syncObservedTrailVisual(playerToSync)
	else
		cleanupObservedTrailVisual(playerToSync)
	end
end

local function bindObservedTrailPlayer(playerToBind: Player)
	if observedTrailPlayerMaids[playerToBind] then
		return
	end

	local playerMaid = Maid.new()
	observedTrailPlayerMaids[playerToBind] = playerMaid
	local rootWatchConnection: RBXScriptConnection? = nil

	local function refreshRootWatch()
		if rootWatchConnection then
			rootWatchConnection:Disconnect()
			rootWatchConnection = nil
		end

		local currentCharacter = playerToBind.Character
		if not currentCharacter then
			return
		end

		if currentCharacter:FindFirstChild("HumanoidRootPart") then
			return
		end

		rootWatchConnection = currentCharacter.ChildAdded:Connect(function(child)
			if child:IsA("BasePart") and child.Name == "HumanoidRootPart" then
				if rootWatchConnection then
					rootWatchConnection:Disconnect()
					rootWatchConnection = nil
				end
				if playerToBind.Parent then
					reconcileObservedTrailVisual(playerToBind)
				end
			end
		end)
	end

	playerMaid:GiveTask(playerToBind:GetAttributeChangedSignal("Trail_Equipped"):Connect(function()
		reconcileObservedTrailVisual(playerToBind)
	end))

	playerMaid:GiveTask(playerToBind.CharacterAdded:Connect(function()
		refreshRootWatch()
		deferTopLevel(function()
			if playerToBind.Parent then
				reconcileObservedTrailVisual(playerToBind)
			end
		end)
	end))

	playerMaid:GiveTask(playerToBind.CharacterRemoving:Connect(function()
		local existingState = observedTrailVisuals[playerToBind]
		if existingState then
			existingState.missingUntil = os.clock() + TRAIL_VISUAL_MISSING_GRACE
		end
	end))

	playerMaid:GiveTask(function()
		if rootWatchConnection then
			rootWatchConnection:Disconnect()
			rootWatchConnection = nil
		end
		cleanupObservedTrailVisual(playerToBind)
	end)

	refreshRootWatch()
	deferTopLevel(function()
		if playerToBind.Parent then
			reconcileObservedTrailVisual(playerToBind)
		end
	end)
end

local function registerKartShowcase(model: Model)
	if observedKartShowcases[model] then
		return
	end

	local basePivot = if typeof(model:GetAttribute("ShowcaseBasePivot")) == "CFrame"
		then model:GetAttribute("ShowcaseBasePivot") :: CFrame
		else model:GetPivot()
	local usePartCFrameAnimation = model:GetAttribute("UsePartCFrameAnimation") == true
	local parts: { ShowcasePartState } = {}
	if usePartCFrameAnimation then
		for _, descendant in ipairs(model:GetDescendants()) do
			if descendant:IsA("BasePart") then
				local relativeCFrame = descendant:GetAttribute("ShowcaseRelativeCFrame")
				table.insert(parts, {
					part = descendant,
					relativeCFrame = if typeof(relativeCFrame) == "CFrame"
						then relativeCFrame :: CFrame
						else basePivot:ToObjectSpace(descendant.CFrame),
				})
			end
		end
	end

	local configuredRotationDuration = model:GetAttribute("ShowcaseRotationDuration")
	local rotationDuration = if typeof(configuredRotationDuration) == "number"
		then math.max(0, configuredRotationDuration)
		else 0

	observedKartShowcases[model] = {
		model = model,
		basePivot = basePivot,
		visualOffset = model:GetAttribute("VisualOffset") or 0,
		rotationDuration = rotationDuration,
		parts = parts,
		usePartCFrameAnimation = usePartCFrameAnimation,
		visualUpdateAccumulator = 0,
		cameraBucket = nil,
		cameraBucketDistance = nil,
		cameraBucketOnScreen = nil,
		cameraBucketAccumulator = KART_CAMERA_BUCKET_REFRESH_INTERVAL,
		isPoliceKart = model:GetAttribute("IsPoliceKart") == true,
		lightBarBlue = findBasePartByName(model, "LightBarBlue"),
		lightBarRed = findBasePartByName(model, "LightBarRed"),
		spotlightLensL = findBasePartByName(model, "SpotlightLensL"),
		spotlightLensR = findBasePartByName(model, "SpotlightLensR"),
	}
end

local function getKartOwner(model: Model): Player?
	local ownerUserId = model:GetAttribute("OwnerUserId")
	if typeof(ownerUserId) == "number" then
		return Players:GetPlayerByUserId(ownerUserId)
	end

	local taggedOwnerUserId = model:GetAttribute("KartOwnerUserId")
	if typeof(taggedOwnerUserId) == "number" then
		return Players:GetPlayerByUserId(taggedOwnerUserId)
	end

	-- Fallback to legacy character parenting
	return Players:GetPlayerFromCharacter(model.Parent)
end

local function registerEquippedKart(model: Model)
	if observedEquippedKarts[model] then
		return
	end

	local owner = getKartOwner(model)
	local ownerCharacter = owner and owner.Character or nil
	local ownerHumanoid = ownerCharacter and (ownerCharacter:FindFirstChildOfClass("Humanoid") :: Humanoid?) or nil
	local rootPart = ownerCharacter and (ownerCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?) or nil
	local engineParent = getEngineParent(model)
	local engineSoundId = model:GetAttribute("EngineSoundId")
	local smokeEmitters = {}
	local emitterSpeeds: { [ParticleEmitter]: NumberRange } = {}
	if rootPart then
		smokeEmitters, emitterSpeeds = createClientKartSmokeEmitters(rootPart)
	end

	observedEquippedKarts[model] = {
		model = model,
		owner = owner,
		ownerCharacter = ownerCharacter,
		ownerHumanoid = ownerHumanoid,
		rootPart = rootPart,
		engineParent = engineParent,
		engineSound = if engineParent
				and typeof(engineSoundId) == "string"
				and engineSoundId ~= ""
			then createOrUpdateClientKartEngineSound(engineParent, engineSoundId)
			else nil,
		engineSoundId = if typeof(engineSoundId) == "string" then engineSoundId else nil,
		smokeEmitters = smokeEmitters,
		emitterSpeeds = emitterSpeeds,
		visualOffset = model:GetAttribute("VisualOffset") or 0,
		isPoliceKart = model:GetAttribute("IsPoliceKart") == true,
		lightBarBlue = findBasePartByName(model, "LightBarBlue"),
		lightBarRed = findBasePartByName(model, "LightBarRed"),
		spotlightLensL = findBasePartByName(model, "SpotlightLensL"),
		spotlightLensR = findBasePartByName(model, "SpotlightLensR"),
		wheelMotors = getClientWheelMotors(engineParent),
		spinAngle = 0,
		visualUpdateAccumulator = 0,
		wheelUpdateAccumulator = 0,
		idleEffectsAccumulator = 0,
		stateRefreshAccumulator = 0,
		cameraBucket = nil,
		cameraBucketDistance = nil,
		cameraBucketOnScreen = nil,
		cameraBucketAccumulator = KART_CAMERA_BUCKET_REFRESH_INTERVAL,
		lastMoving = nil,
		lastPlaybackSpeed = nil,
		offscreenEffectsDisabled = false,
	}

	local registeredState = observedEquippedKarts[model]
	if registeredState.isPoliceKart then
		applyCurrentPoliceKartVisuals(
			registeredState.visualOffset,
			registeredState.lightBarBlue,
			registeredState.lightBarRed,
			registeredState.spotlightLensL,
			registeredState.spotlightLensR
		)
	end

	DebugModule.debugInfo(
		string.format(
			"registerEquippedKart | equippedKart=%s | model=%s | owner=%s | rootPart=%s | engineParent=%s | engineSound=%s | smokeEmitters=%d | wheelMotors=%d",
			tostring(player:GetAttribute("Kart_Equipped")),
			model:GetFullName(),
			if owner then owner.Name else "nil",
			tostring(rootPart ~= nil),
			tostring(engineParent ~= nil),
			tostring(engineSoundId ~= nil and engineParent ~= nil),
			#smokeEmitters,
			#observedEquippedKarts[model].wheelMotors
		),
		"PlayerClientHandler"
	)
end

local function registerObservedKartVisual(instance: Instance)
	local showcaseModel = if instance:IsA("Model") and instance.Name == KART_SHOWCASE_MODEL_NAME
		then instance
		else instance:FindFirstAncestor(KART_SHOWCASE_MODEL_NAME)
	if showcaseModel and showcaseModel:IsA("Model") then
		registerKartShowcase(showcaseModel)
	end

	local equippedKartModel = if instance:IsA("Model") and instance.Name == EQUIPPED_KART_MODEL_NAME
		then instance
		else instance:FindFirstAncestor(EQUIPPED_KART_MODEL_NAME)
	if equippedKartModel and equippedKartModel:IsA("Model") then
		registerEquippedKart(equippedKartModel)
	end
end

local function isKartVisualModel(instance: Instance): boolean
	return instance:IsA("Model")
		and (instance.Name == KART_SHOWCASE_MODEL_NAME or instance.Name == EQUIPPED_KART_MODEL_NAME)
end

local function beginSourceRootBinding(root: Instance, bindings: { [Instance]: Maid }): Maid
	local rootMaid = Maid.new()
	local cleanedRoot = false
	bindings[root] = rootMaid

	local function cleanupRootBinding()
		if cleanedRoot then
			return
		end
		cleanedRoot = true
		if bindings[root] == rootMaid then
			bindings[root] = nil
		end
		rootMaid:DoCleaning()
	end

	rootMaid:GiveTask(root.AncestryChanged:Connect(function()
		if not root:IsDescendantOf(Workspace) then
			cleanupRootBinding()
		end
	end))

	return rootMaid
end

local function bindKartVisualSourceRoot(root: Instance)
	if observedKartVisualSourceRoots[root] or not root:IsDescendantOf(Workspace) then
		return
	end

	local rootMaid = beginSourceRootBinding(root, observedKartVisualSourceRoots)
	rootMaid:GiveTask(root.DescendantAdded:Connect(function(descendant)
		if isKartVisualModel(descendant) then
			registerObservedKartVisual(descendant)
		end
	end))
	rootMaid:GiveTask(root.DescendantRemoving:Connect(function(descendant)
		if descendant:IsA("Model") and descendant.Name == KART_SHOWCASE_MODEL_NAME then
			observedKartShowcases[descendant] = nil
		end
	end))

	for _, descendant in ipairs(root:GetDescendants()) do
		if isKartVisualModel(descendant) then
			registerObservedKartVisual(descendant)
		end
	end
end

local function refreshKartVisualSourceBindings()
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	if worldsFolder then
		for _, world in ipairs(worldsFolder:GetChildren()) do
			local kartButtonsFolder = world:FindFirstChild("KartButtons")
			if kartButtonsFolder then
				bindKartVisualSourceRoot(kartButtonsFolder)
			end

			local eventKartButtonsFolder = world:FindFirstChild("EventKartButtons")
			if eventKartButtonsFolder then
				bindKartVisualSourceRoot(eventKartButtonsFolder)
			end
		end
	end

	local kartHolderFolder = Workspace:FindFirstChild(KART_VISUAL_HOLDER_NAME)
	if kartHolderFolder then
		bindKartVisualSourceRoot(kartHolderFolder)
	end
end

local function findLocalEquippedKartModel(): Model?
	local kartHolder = Workspace:FindFirstChild(KART_VISUAL_HOLDER_NAME)
	if not kartHolder then
		return nil
	end

	for _, child in ipairs(kartHolder:GetChildren()) do
		if child:IsA("Model") and child.Name == EQUIPPED_KART_MODEL_NAME then
			local ownerUserId = child:GetAttribute("OwnerUserId")
			local taggedOwnerUserId = child:GetAttribute("KartOwnerUserId")
			if ownerUserId == player.UserId or taggedOwnerUserId == player.UserId then
				return child
			end
		end
	end

	return nil
end

local function isClientKartVisualHealthy(model: Model?): boolean
	if not model or not model:IsDescendantOf(Workspace) then
		return false
	end

	local seatBase = model:FindFirstChild("SeatBase", true)
	return seatBase ~= nil
		and seatBase:IsA("BasePart")
		and model:FindFirstChildWhichIsA("BasePart", true) ~= nil
end

local function reconcileLocalKartVisual()
	if isCleaningUp or player:GetAttribute("Data_Loaded") ~= true or humanoid.Health <= 0 then
		localKartVisualMissingSince = nil
		return
	end

	local model = findLocalEquippedKartModel()
	if model then
		registerObservedKartVisual(model)
	end

	if isClientKartVisualHealthy(model) then
		localKartVisualMissingSince = nil
		return
	end

	local now = os.clock()
	local missingSince = localKartVisualMissingSince
	if missingSince == nil then
		localKartVisualMissingSince = now
		return
	end

	if now - missingSince < KART_CLIENT_VISUAL_MISSING_GRACE then
		return
	end
	if now - lastKartVisualResyncAt < KART_CLIENT_VISUAL_RESYNC_COOLDOWN then
		return
	end

	lastKartVisualResyncAt = now
	KartVisualResync:FireServer()
	DebugModule.debugWarn(
		"Client equipped kart visual incomplete; requested server resync | model=" .. tostring(model ~= nil),
		"PlayerClientHandler"
	)
end

local function refreshEquippedKartState(state: EquippedKartVisualState)
	local owner = getKartOwner(state.model)
	state.owner = owner

	local nextOwnerCharacter = owner and owner.Character or nil
	if nextOwnerCharacter ~= state.ownerCharacter then
		state.ownerCharacter = nextOwnerCharacter
		state.ownerHumanoid = if nextOwnerCharacter
			then nextOwnerCharacter:FindFirstChildOfClass("Humanoid") :: Humanoid?
			else nil
	elseif state.ownerHumanoid and state.ownerHumanoid.Parent == nil then
		state.ownerHumanoid = nil
	end

	local nextRootPart = nextOwnerCharacter and (nextOwnerCharacter:FindFirstChild("HumanoidRootPart") :: BasePart?)
		or nil
	local nextEngineParent = getEngineParent(state.model)
	local nextEngineSoundId = state.model:GetAttribute("EngineSoundId")

	-- If rootPart changed OR if we previously had no motors but the engineParent (seatBase) just appeared
	if nextRootPart ~= state.rootPart or (#state.wheelMotors == 0 and nextEngineParent ~= nil) then
		for _, emitter in ipairs(state.smokeEmitters) do
			if emitter.Parent then
				emitter:Destroy()
			end
		end

		state.rootPart = nextRootPart
		state.smokeEmitters = {}
		state.emitterSpeeds = {}
		state.wheelMotors = getClientWheelMotors(nextEngineParent)
		state.spinAngle = 0
		state.wheelUpdateAccumulator = 0
		state.idleEffectsAccumulator = 0
		state.lastMoving = nil
		state.offscreenEffectsDisabled = false
		if nextOwnerCharacter then
			state.ownerHumanoid = nextOwnerCharacter:FindFirstChildOfClass("Humanoid") :: Humanoid?
		end
		if nextRootPart then
			state.smokeEmitters, state.emitterSpeeds = createClientKartSmokeEmitters(nextRootPart)
		end

		if nextRootPart ~= state.rootPart then
			DebugModule.debugInfo(
				string.format(
					"refreshEquippedKartState root/motor refresh | equippedKart=%s | model=%s | owner=%s | rootPart=%s | smokeEmitters=%d | wheelMotors=%d",
					tostring(player:GetAttribute("Kart_Equipped")),
					state.model:GetFullName(),
					if owner then owner.Name else "nil",
					tostring(nextRootPart ~= nil),
					#state.smokeEmitters,
					#state.wheelMotors
				),
				"PlayerClientHandler"
			)
		end
	end

	if nextEngineParent ~= state.engineParent then
		if state.engineSound and state.engineSound.Parent then
			state.engineSound:Destroy()
		end
		state.engineSound = nil
		state.engineParent = nextEngineParent
		state.lastPlaybackSpeed = nil

		DebugModule.debugInfo(
			string.format(
				"refreshEquippedKartState engine parent swap | equippedKart=%s | model=%s | engineParent=%s",
				tostring(player:GetAttribute("Kart_Equipped")),
				state.model:GetFullName(),
				tostring(nextEngineParent ~= nil)
			),
			"PlayerClientHandler"
		)
	end

	if typeof(nextEngineSoundId) == "string" and nextEngineSoundId ~= "" and nextEngineParent then
		if
			state.engineSoundId ~= nextEngineSoundId
			or not state.engineSound
			or state.engineSound.Parent ~= nextEngineParent
		then
			if state.engineSound and state.engineSound.Parent then
				state.engineSound:Destroy()
			end
			state.engineSound = createOrUpdateClientKartEngineSound(nextEngineParent, nextEngineSoundId)
			state.engineSoundId = nextEngineSoundId

			DebugModule.debugInfo(
				string.format(
					"refreshEquippedKartState engine sound recreate | equippedKart=%s | model=%s | soundId=%s | parent=%s",
					tostring(player:GetAttribute("Kart_Equipped")),
					state.model:GetFullName(),
					nextEngineSoundId,
					nextEngineParent:GetFullName()
				),
				"PlayerClientHandler"
			)
		end
	elseif state.engineSound and state.engineSound.Parent then
		state.engineSound:Destroy()
		state.engineSound = nil
		state.engineSoundId = nil
		state.lastPlaybackSpeed = nil
	end

	state.visualOffset = state.model:GetAttribute("VisualOffset") or state.visualOffset
	state.isPoliceKart = state.model:GetAttribute("IsPoliceKart") == true
	state.lightBarBlue = findBasePartByName(state.model, "LightBarBlue")
	state.lightBarRed = findBasePartByName(state.model, "LightBarRed")
	state.spotlightLensL = findBasePartByName(state.model, "SpotlightLensL")
	state.spotlightLensR = findBasePartByName(state.model, "SpotlightLensR")
	if state.isPoliceKart then
		applyCurrentPoliceKartVisuals(
			state.visualOffset,
			state.lightBarBlue,
			state.lightBarRed,
			state.spotlightLensL,
			state.spotlightLensR
		)
	end
end

local function resolveVisualDistanceBucket(
	distance: number,
	onScreen: boolean,
	nearDistance: number,
	farDistance: number
): VisualDistanceBucket
	if distance <= nearDistance then
		return "near"
	end

	if onScreen and distance <= farDistance then
		return "mid"
	end

	if onScreen then
		return "far"
	end

	return "offscreen"
end

local function getKartVisualUpdateIntervalForBucket(bucket: VisualDistanceBucket, owner: Player?): number
	if owner == player then
		return 0
	end

	if bucket == "near" then
		return 0
	end
	if bucket == "mid" then
		return KART_VISUAL_MID_INTERVAL
	end
	if bucket == "far" then
		return KART_VISUAL_FAR_INTERVAL
	end

	return KART_VISUAL_OFFSCREEN_INTERVAL
end

local function getKartStateRefreshIntervalForBucket(bucket: VisualDistanceBucket): number
	if bucket == "near" then
		return KART_STATE_REFRESH_INTERVAL
	end
	if bucket == "mid" then
		return KART_STATE_REFRESH_MID_INTERVAL
	end

	return KART_STATE_REFRESH_FAR_INTERVAL
end

local function getShowcaseVisualUpdateInterval(distance: number, onScreen: boolean): number
	if not onScreen then
		return math.huge
	end

	if distance <= KART_SHOWCASE_FULL_RATE_DISTANCE then
		return 1 / KART_SHOWCASE_TARGET_FPS_FULL
	end

	local targetFps: number
	if distance <= KART_SHOWCASE_NEAR_DISTANCE then
		local nearSpan = math.max(KART_SHOWCASE_NEAR_DISTANCE - KART_SHOWCASE_FULL_RATE_DISTANCE, 1)
		local nearAlpha = math.clamp((distance - KART_SHOWCASE_FULL_RATE_DISTANCE) / nearSpan, 0, 1)
		targetFps = KART_SHOWCASE_TARGET_FPS_FULL
			+ ((KART_SHOWCASE_TARGET_FPS_FAR - KART_SHOWCASE_TARGET_FPS_FULL) * nearAlpha)
	elseif distance <= KART_SHOWCASE_FAR_DISTANCE then
		local farSpan = math.max(KART_SHOWCASE_FAR_DISTANCE - KART_SHOWCASE_NEAR_DISTANCE, 1)
		local farAlpha = math.clamp((distance - KART_SHOWCASE_NEAR_DISTANCE) / farSpan, 0, 1)
		targetFps = KART_SHOWCASE_TARGET_FPS_FAR
			+ ((KART_SHOWCASE_TARGET_FPS_VERY_FAR - KART_SHOWCASE_TARGET_FPS_FAR) * farAlpha)
	elseif distance <= KART_SHOWCASE_PAUSE_DISTANCE then
		targetFps = KART_SHOWCASE_TARGET_FPS_VERY_FAR
	else
		return math.huge
	end

	local clampedTargetFps = math.clamp(targetFps, KART_SHOWCASE_TARGET_FPS_VERY_FAR, KART_SHOWCASE_TARGET_FPS_FULL)
	return 1 / clampedTargetFps
end

local function computeEquippedKartCameraBucket(
	kartState: EquippedKartVisualState
): (VisualDistanceBucket, number, boolean)
	if kartState.owner == player then
		return "near", 0, true
	end

	local currentCamera = Workspace.CurrentCamera
	local rootPart = kartState.rootPart
	if not currentCamera or not rootPart then
		return "offscreen", math.huge, false
	end

	local distance = (rootPart.Position - currentCamera.CFrame.Position).Magnitude
	local _, onScreen = currentCamera:WorldToViewportPoint(rootPart.Position)
	local bucket = resolveVisualDistanceBucket(distance, onScreen, KART_VISUAL_NEAR_DISTANCE, KART_VISUAL_FAR_DISTANCE)
	return bucket, distance, onScreen
end

local function getCachedEquippedKartCameraBucket(
	kartState: EquippedKartVisualState,
	dt: number
): (VisualDistanceBucket, number, boolean)
	kartState.cameraBucketAccumulator += dt
	if
		kartState.cameraBucket ~= nil
		and kartState.cameraBucketAccumulator < KART_CAMERA_BUCKET_REFRESH_INTERVAL
		and kartState.cameraBucketDistance ~= nil
		and kartState.cameraBucketOnScreen ~= nil
	then
		return kartState.cameraBucket, kartState.cameraBucketDistance, kartState.cameraBucketOnScreen
	end

	local bucket, distance, onScreen = computeEquippedKartCameraBucket(kartState)
	kartState.cameraBucket = bucket
	kartState.cameraBucketDistance = distance
	kartState.cameraBucketOnScreen = onScreen
	kartState.cameraBucketAccumulator = 0
	return bucket, distance, onScreen
end

local function computeShowcaseCameraBucket(showcaseState: ShowcaseVisualState): (VisualDistanceBucket, number, boolean)
	local currentCamera = Workspace.CurrentCamera
	if not currentCamera then
		return "offscreen", math.huge, false
	end

	local showcasePosition = showcaseState.basePivot.Position
	local distance = (showcasePosition - currentCamera.CFrame.Position).Magnitude
	local _, onScreen = currentCamera:WorldToViewportPoint(showcasePosition)
	local bucket =
		resolveVisualDistanceBucket(distance, onScreen, KART_SHOWCASE_NEAR_DISTANCE, KART_SHOWCASE_FAR_DISTANCE)
	return bucket, distance, onScreen
end

local function getCachedShowcaseCameraBucket(
	showcaseState: ShowcaseVisualState,
	dt: number
): (VisualDistanceBucket, number, boolean)
	showcaseState.cameraBucketAccumulator += dt
	if
		showcaseState.cameraBucket ~= nil
		and showcaseState.cameraBucketAccumulator < KART_CAMERA_BUCKET_REFRESH_INTERVAL
		and showcaseState.cameraBucketDistance ~= nil
		and showcaseState.cameraBucketOnScreen ~= nil
	then
		return showcaseState.cameraBucket, showcaseState.cameraBucketDistance, showcaseState.cameraBucketOnScreen
	end

	local bucket, distance, onScreen = computeShowcaseCameraBucket(showcaseState)
	showcaseState.cameraBucket = bucket
	showcaseState.cameraBucketDistance = distance
	showcaseState.cameraBucketOnScreen = onScreen
	showcaseState.cameraBucketAccumulator = 0
	return bucket, distance, onScreen
end

local function getWheelMotorUpdateInterval(kartState: EquippedKartVisualState, visualUpdateInterval: number): number
	if kartState.owner == player then
		return 0
	end

	local effectiveVisualInterval = if visualUpdateInterval > 0
		then visualUpdateInterval
		else KART_VISUAL_FRAMELOCK_INTERVAL
	return math.max(REMOTE_KART_WHEEL_UPDATE_INTERVAL, effectiveVisualInterval)
end

local function updateObservedKartShowcases(dt: number)
	if next(observedKartShowcases) == nil then
		return
	end

	local syncedTime = Workspace:GetServerTimeNow()

	for model, showcaseState in pairs(observedKartShowcases) do
		if not model.Parent then
			observedKartShowcases[model] = nil
			continue
		end

		local showcaseBucket, showcaseDistance, showcaseOnScreen = getCachedShowcaseCameraBucket(showcaseState, dt)
		local showcaseUpdateInterval = getShowcaseVisualUpdateInterval(showcaseDistance, showcaseOnScreen)
		showcaseState.visualUpdateAccumulator += dt
		if showcaseState.visualUpdateAccumulator < showcaseUpdateInterval then
			continue
		end
		showcaseState.visualUpdateAccumulator = 0

		local bobOffset = math.sin((syncedTime + showcaseState.visualOffset) * 2) * KART_SHOWCASE_BOB_AMPLITUDE
		local showcasePivot = showcaseState.basePivot * CFrame.new(0, bobOffset, 0)
		if showcaseState.rotationDuration > 0 then
			local rotationAlpha = ((syncedTime + showcaseState.visualOffset) % showcaseState.rotationDuration)
				/ showcaseState.rotationDuration
			showcasePivot *= CFrame.Angles(0, math.rad(rotationAlpha * 360), 0)
		end

		if showcaseState.usePartCFrameAnimation then
			for _, partState in ipairs(showcaseState.parts) do
				if partState.part.Parent then
					partState.part.CFrame = showcasePivot * partState.relativeCFrame
				end
			end
		else
			showcaseState.model:PivotTo(showcasePivot)
		end

		if showcaseState.isPoliceKart and showcaseOnScreen then
			applyPoliceKartVisuals(
				syncedTime + showcaseState.visualOffset,
				showcaseState.lightBarBlue,
				showcaseState.lightBarRed,
				showcaseState.spotlightLensL,
				showcaseState.spotlightLensR
			)
		end
	end
end

local function updateObservedEquippedKartVisuals(dt: number)
	local syncedTime = Workspace:GetServerTimeNow()

	for model, kartState in pairs(observedEquippedKarts) do
		if not model.Parent then
			cleanupObservedEquippedKart(kartState)
			observedEquippedKarts[model] = nil
			continue
		end

		local cameraBucket, cameraDistance, _ = getCachedEquippedKartCameraBucket(kartState, dt)
		local stateRefreshInterval = getKartStateRefreshIntervalForBucket(cameraBucket)
		kartState.stateRefreshAccumulator += dt
		local shouldRefreshState = kartState.stateRefreshAccumulator >= stateRefreshInterval
		if not kartState.owner or not kartState.owner.Parent then
			shouldRefreshState = true
		end
		if not kartState.rootPart or not kartState.rootPart.Parent then
			shouldRefreshState = true
		end
		if not kartState.engineParent or not kartState.engineParent.Parent then
			shouldRefreshState = true
		end
		if shouldRefreshState then
			refreshEquippedKartState(kartState)
			kartState.stateRefreshAccumulator = 0
			local refreshedOnScreen = false
			cameraBucket, cameraDistance, refreshedOnScreen = computeEquippedKartCameraBucket(kartState)
			kartState.cameraBucket = cameraBucket
			kartState.cameraBucketDistance = cameraDistance
			kartState.cameraBucketOnScreen = refreshedOnScreen
			kartState.cameraBucketAccumulator = 0
		end

		local isRemoteOffscreen = kartState.owner ~= player and cameraBucket == "offscreen"
		if isRemoteOffscreen then
			if not kartState.offscreenEffectsDisabled then
				setKartSmokeEmittersActive(kartState, false, false)
				kartState.offscreenEffectsDisabled = true
				kartState.lastMoving = nil
			end

			kartState.visualUpdateAccumulator = 0
			kartState.wheelUpdateAccumulator = 0
			kartState.idleEffectsAccumulator = 0
			continue
		elseif kartState.offscreenEffectsDisabled then
			kartState.offscreenEffectsDisabled = false
			kartState.lastMoving = nil
		end

		kartState.visualUpdateAccumulator += dt

		local updateInterval = getKartVisualUpdateIntervalForBucket(cameraBucket, kartState.owner)
		if updateInterval > 0 and kartState.visualUpdateAccumulator < updateInterval then
			continue
		end

		local effectiveDt = if updateInterval > 0 then kartState.visualUpdateAccumulator else dt
		kartState.visualUpdateAccumulator = 0

		local horizontalVelocity = 0
		local treadmillActive = false
		local humanoidForSpeed = kartState.ownerHumanoid
		if humanoidForSpeed and humanoidForSpeed.Parent == nil then
			humanoidForSpeed = nil
			kartState.ownerHumanoid = nil
		end
		if kartState.owner and kartState.rootPart then
			treadmillActive = kartState.owner:GetAttribute("Treadmill_Active") == true
			horizontalVelocity = Vector3.new(
				kartState.rootPart.AssemblyLinearVelocity.X,
				0,
				kartState.rootPart.AssemblyLinearVelocity.Z
			).Magnitude
		end

		local moving = horizontalVelocity > 0.05 or treadmillActive
		local wheelSpeed = horizontalVelocity
		if treadmillActive and wheelSpeed < 0.05 and humanoidForSpeed then
			wheelSpeed = humanoidForSpeed.WalkSpeed
		end

		kartState.wheelUpdateAccumulator += effectiveDt
		local wheelUpdateInterval = getWheelMotorUpdateInterval(kartState, updateInterval)
		if wheelUpdateInterval <= 0 or kartState.wheelUpdateAccumulator >= wheelUpdateInterval then
			local wheelDt = if wheelUpdateInterval <= 0 then effectiveDt else kartState.wheelUpdateAccumulator
			kartState.wheelUpdateAccumulator = 0

			if moving then
				local referenceRadius = kartState.wheelMotors[1] and kartState.wheelMotors[1].radius or 1
				kartState.spinAngle += (wheelSpeed / math.max(referenceRadius, 0.05)) * wheelDt
			end

			for _, wheelState in ipairs(kartState.wheelMotors) do
				if wheelState.motor.Parent then
					wheelState.motor.C0 = wheelState.baseC0 * CFrame.Angles(-kartState.spinAngle, 0, 0)
				end
			end
		end

		local movingStateChanged = kartState.lastMoving ~= moving
		local shouldRunEffectsUpdate = movingStateChanged
		if not shouldRunEffectsUpdate then
			if kartState.owner ~= player and not moving and not treadmillActive then
				kartState.idleEffectsAccumulator += effectiveDt
				if kartState.idleEffectsAccumulator >= REMOTE_KART_IDLE_EFFECT_INTERVAL then
					kartState.idleEffectsAccumulator = 0
					shouldRunEffectsUpdate = true
				end
			else
				kartState.idleEffectsAccumulator = 0
				shouldRunEffectsUpdate = true
			end
		else
			kartState.idleEffectsAccumulator = 0
		end

		if shouldRunEffectsUpdate and kartState.engineSound and kartState.engineSound.Parent then
			local normalizedSpeed = math.clamp(horizontalVelocity / KART_ENGINE_REFERENCE_SPEED, 0, 1)
			local playbackSpeed = 0.5 + (normalizedSpeed * 1.5)
			if treadmillActive then
				playbackSpeed = 2.0
			end
			if humanoidForSpeed and treadmillActive and horizontalVelocity < 0.05 then
				local walkSpeedNormalized = math.clamp(humanoidForSpeed.WalkSpeed / KART_ENGINE_REFERENCE_SPEED, 0, 1)
				playbackSpeed = 0.5 + (walkSpeedNormalized * 1.5)
				playbackSpeed = math.max(playbackSpeed, 2.0)
			end
			local clampedPlaybackSpeed = math.clamp(playbackSpeed, 0.5, 2.0)
			if
				kartState.lastPlaybackSpeed == nil
				or math.abs(kartState.lastPlaybackSpeed - clampedPlaybackSpeed) > 0.01
			then
				kartState.engineSound.PlaybackSpeed = clampedPlaybackSpeed
				kartState.lastPlaybackSpeed = clampedPlaybackSpeed
			end
		end

		if shouldRunEffectsUpdate and movingStateChanged then
			setKartSmokeEmittersActive(kartState, true, moving)
			kartState.lastMoving = moving
		end

		local shouldUpdatePoliceLights = kartState.owner == player
			or cameraBucket ~= "offscreen"
			or cameraDistance <= KART_VISUAL_FAR_DISTANCE
		if kartState.isPoliceKart and shouldUpdatePoliceLights then
			applyPoliceKartVisuals(
				syncedTime + kartState.visualOffset,
				kartState.lightBarBlue,
				kartState.lightBarRed,
				kartState.spotlightLensL,
				kartState.spotlightLensR
			)
		end
	end
end

local function getCurrentCharacterRootPart(): BasePart?
	if cachedCharacterRootPart and cachedCharacterRootPart.Parent == character then
		return cachedCharacterRootPart
	end

	local rootCandidate = character:FindFirstChild("HumanoidRootPart")
	if rootCandidate and rootCandidate:IsA("BasePart") then
		cachedCharacterRootPart = rootCandidate
		return rootCandidate
	end

	cachedCharacterRootPart = nil
	return nil
end

local function getTreadmillTextureUpdateInterval(rootPart: BasePart?, texturePosition: Vector3?): number
	if not rootPart or not texturePosition then
		return math.huge
	end

	local distance = (rootPart.Position - texturePosition).Magnitude
	if distance > TREADMILL_TEXTURE_PAUSE_DISTANCE then
		return math.huge
	end

	local currentCamera = Workspace.CurrentCamera
	if currentCamera and distance > TREADMILL_TEXTURE_NEAR_DISTANCE then
		local _, onScreen = currentCamera:WorldToViewportPoint(texturePosition)
		if not onScreen then
			return math.huge
		end
	end

	if distance <= TREADMILL_TEXTURE_NEAR_DISTANCE then
		return TREADMILL_TEXTURE_UPDATE_INTERVAL
	end

	if distance <= TREADMILL_TEXTURE_FAR_DISTANCE then
		return TREADMILL_TEXTURE_FAR_UPDATE_INTERVAL
	end

	return TREADMILL_TEXTURE_FAR_UPDATE_INTERVAL * 2
end

local function updateTreadmillTextureVisuals(dt: number)
	local rootPart = getCurrentCharacterRootPart()
	for texture, state in pairs(observedTreadmillTextures) do
		if not texture.Parent then
			observedTreadmillTextures[texture] = nil
			continue
		end

		local updateInterval = getTreadmillTextureUpdateInterval(rootPart, state.worldPosition)
		if updateInterval == math.huge then
			state.updateAccumulator = 0
			continue
		end

		state.updateAccumulator = math.min(state.updateAccumulator + dt, updateInterval * 3)
		if state.updateAccumulator < updateInterval then
			continue
		end

		local elapsed = state.updateAccumulator
		state.updateAccumulator = 0

		local nextOffset = texture.OffsetStudsV + (state.scrollSpeed * elapsed)
		if nextOffset >= 64 then
			nextOffset = 0
		end
		texture.OffsetStudsV = nextOffset
	end
end

local function updateObservedTrailVisuals()
	local budget = getRemoteTrailBudgetConfig()
	local localRootPart = getCurrentCharacterRootPart()
	local distanceMultiplier = if ClientDeviceProfile.IsMobile() then budget.mobileDistanceMultiplier else 1
	local fullDistance = budget.fullDistance * distanceMultiplier
	local disableDistance = math.max(budget.disableDistance * distanceMultiplier, fullDistance)
	local candidates: { RemoteTrailCandidate } = {}

	for targetPlayer, trailState in pairs(observedTrailVisuals) do
		local equippedTrail = targetPlayer:GetAttribute("Trail_Equipped")
		if typeof(equippedTrail) ~= "string" or equippedTrail == "" or equippedTrail == "None" then
			cleanupObservedTrailVisual(targetPlayer)
			continue
		end

		local characterToSync = targetPlayer.Character
		local rootPart = characterToSync and (characterToSync:FindFirstChild("HumanoidRootPart") :: BasePart?) or nil
		if not targetPlayer.Parent or not characterToSync or not rootPart then
			trailState.missingUntil = trailState.missingUntil or (os.clock() + TRAIL_VISUAL_MISSING_GRACE)
			if os.clock() > trailState.missingUntil then
				cleanupObservedTrailVisual(targetPlayer)
			end
			continue
		end

		trailState.missingUntil = nil

		if characterToSync ~= trailState.character or rootPart ~= trailState.rootPart then
			syncObservedTrailVisual(targetPlayer)
			continue
		end

		if targetPlayer ~= player and budget.enabled and localRootPart then
			table.insert(candidates, {
				state = trailState,
				distance = (rootPart.Position - localRootPart.Position).Magnitude,
			})
		elseif targetPlayer == player or not budget.enabled or not localRootPart then
			setObservedTrailQuality(trailState, "full", budget.reducedRateMultiplier)
		end

		local horizontalVelocity =
			Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z).Magnitude
		local moving = horizontalVelocity > 0.05 or targetPlayer:GetAttribute("Treadmill_Active") == true
		if trailState.lastMoving == moving then
			continue
		end

		trailState.lastMoving = moving
		for _, emitter in ipairs(trailState.emitters) do
			if emitter.Parent then
				emitter.Speed = if moving
					then (trailState.emitterSpeeds[emitter] or NumberRange.new(0))
					else NumberRange.new(0)
			end
		end
	end

	table.sort(candidates, function(left, right)
		return left.distance < right.distance
	end)

	for index, candidate in ipairs(candidates) do
		local quality: RemoteTrailQuality
		if index > budget.maxVisiblePlayers or candidate.distance > disableDistance then
			quality = "disabled"
		elseif candidate.distance <= fullDistance then
			quality = "full"
		elseif candidate.distance <= disableDistance then
			quality = "reduced"
		else
			quality = "disabled"
		end

		setObservedTrailQuality(candidate.state, quality, budget.reducedRateMultiplier)
	end
end

local function clonePlaylist(playlist: { string | number }): { string | number }
	local cloned = table.clone(playlist)
	for index = #cloned, 2, -1 do
		local swapIndex = math.random(index)
		cloned[index], cloned[swapIndex] = cloned[swapIndex], cloned[index]
	end
	return cloned
end

local function stopLobbyMusic()
	currentMusicToken += 1
	currentMusicTracks = {}
	currentMusicIndex = 0
	currentMusicPlaylistKey = nil

	if lobbyMusicSound then
		if activeMusicTween then
			activeMusicTween:Cancel()
			activeMusicTween = nil
		end
		lobbyMusicSound:Stop()
		lobbyMusicSound.TimePosition = 0
	end
end

local function playNextLobbyTrack(token: number)
	if token ~= currentMusicToken or not lobbyMusicSound then
		return
	end

	if #currentMusicTracks == 0 then
		lobbyMusicSound:Stop()
		return
	end

	currentMusicIndex += 1
	if currentMusicIndex > #currentMusicTracks then
		currentMusicTracks = clonePlaylist(currentMusicTracks)
		currentMusicIndex = 1
	end

	local trackId = currentMusicTracks[currentMusicIndex]
	lobbyMusicSound.SoundId = normalizeTrackId(trackId)
	lobbyMusicSound.Volume = 0
	lobbyMusicSound.TimePosition = 0
	lobbyMusicSound:Play()

	if activeMusicTween then
		activeMusicTween:Cancel()
	end

	activeMusicTween = TweenService:Create(lobbyMusicSound, TweenConfig.WithDuration(MUSIC_FADE_TIME, TweenConfig.MusicFade), {
		Volume = LOBBY_MUSIC_VOLUME,
	})
	activeMusicTween:Play()

	lobbyMusicSound.Ended:Once(function()
		playNextLobbyTrack(token)
	end)
end

local function isPointInsidePart(part: BasePart, point: Vector3): boolean
	local localPosition = part.CFrame:PointToObjectSpace(point)
	local halfSize = part.Size * 0.5
	return math.abs(localPosition.X) <= halfSize.X
		and math.abs(localPosition.Y) <= halfSize.Y
		and math.abs(localPosition.Z) <= halfSize.Z
end

local function findLobbyRegionPart(world: Instance?): BasePart?
	if not world then
		return nil
	end

	local lobbyRegionContainer = world:FindFirstChild("LobbyRegion_Model")
	if lobbyRegionContainer then
		local nestedLobbyRegion = lobbyRegionContainer:FindFirstChild("LobbyRegion", true)
		if nestedLobbyRegion and nestedLobbyRegion:IsA("BasePart") then
			return nestedLobbyRegion
		end
	end

	return nil
end

local function getCurrentMusicType(currentWorld: string): string
	if player:GetAttribute("MinigameParticipant") == true then
		return if player:GetAttribute("MinigameState") == "Racing" then "ActionMusicList" else "LobbyMusicList"
	end

	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	local currentStage = player:GetAttribute("CurrentStage") or 0
	if not rootPart then
		return if currentStage > 0 then "ActionMusicList" else "LobbyMusicList"
	end

	local worldsFolder = Workspace:FindFirstChild("Worlds")
	local world = worldsFolder and worldsFolder:FindFirstChild(currentWorld)
	local lobbyRegion = findLobbyRegionPart(world)
	if lobbyRegion then
		if isPointInsidePart(lobbyRegion, rootPart.Position) then
			return "LobbyMusicList"
		end
		return "ActionMusicList"
	end

	return if currentStage > 0 then "ActionMusicList" else "LobbyMusicList"
end

local function updateWorldMusic()
	local currentWorld = player:GetAttribute("Current_World")
	if typeof(currentWorld) ~= "string" then
		stopLobbyMusic()
		return
	end

	local musicType = getCurrentMusicType(currentWorld)
	local selectedPlaylist = SoundService.GetWorldMusicPlaylist(currentWorld, musicType)
	local worldConfig = SoundService.WorldMusicPlaylists[currentWorld]
	local playlistKey = if worldConfig
			and worldConfig[musicType]
			and #worldConfig[musicType] > 0
		then currentWorld .. ":" .. musicType
		else "Fallback:" .. musicType

	if playlistKey == currentMusicPlaylistKey and lobbyMusicSound and lobbyMusicSound.IsPlaying then
		return
	end

	currentMusicToken += 1
	currentMusicPlaylistKey = playlistKey
	currentMusicTracks = clonePlaylist(selectedPlaylist)
	currentMusicIndex = 0

	if not lobbyMusicSound or #currentMusicTracks == 0 then
		if lobbyMusicSound then
			if activeMusicTween then
				activeMusicTween:Cancel()
				activeMusicTween = nil
			end
			lobbyMusicSound:Stop()
		end
		return
	end

	local nextToken = currentMusicToken
	if activeMusicTween then
		activeMusicTween:Cancel()
	end

	if lobbyMusicSound.IsPlaying and lobbyMusicSound.Volume > 0 then
		activeMusicTween = TweenService:Create(lobbyMusicSound, TweenConfig.WithDuration(MUSIC_FADE_TIME, TweenConfig.MusicFade), {
			Volume = 0,
		})
		activeMusicTween:Play()
		activeMusicTween.Completed:Once(function()
			if nextToken ~= currentMusicToken then
				return
			end

			lobbyMusicSound:Stop()
			lobbyMusicSound.TimePosition = 0
			playNextLobbyTrack(nextToken)
		end)
	else
		lobbyMusicSound:Stop()
		lobbyMusicSound.TimePosition = 0
		playNextLobbyTrack(nextToken)
	end
end

local stopMovementDetection = MainFunctions.StartMovementDetection(humanoid)

local function teardownPlayerClientHandler(reason: string)
	if isCleaningUp then
		return
	end
	isCleaningUp = true

	if activeFovTween then
		activeFovTween:Cancel()
		activeFovTween = nil
	end
	lastTargetFov = nil
	local currentCamera = Workspace.CurrentCamera
	if currentCamera then
		currentCamera.FieldOfView = DEFAULT_FOV
	end

	stopMovementDetection()
	movementLifecycleMaid:DoCleaning()
	topLevelMaid:DoCleaning()

	for model, kartState in pairs(observedEquippedKarts) do
		cleanupObservedEquippedKart(kartState)
		observedEquippedKarts[model] = nil
	end

	for trackedPlayer in pairs(observedTrailPlayerMaids) do
		cleanupObservedTrailPlayerBindings(trackedPlayer)
	end

	for trackedPlayer in pairs(observedTrailVisuals) do
		cleanupObservedTrailVisual(trackedPlayer)
	end

	for gradientInstance, gradientMaid in pairs(registeredRainbowGradientMaids) do
		registeredRainbowGradients[gradientInstance] = nil
		registeredRainbowGradientMaids[gradientInstance] = nil
		gradientMaid:DoCleaning()
	end

	table.clear(observedKartShowcases)
	table.clear(observedTreadmillTextures)
	table.clear(observedTreadmillTouchParts)
	table.clear(observedKartVisualSourceRoots)
	cachedCharacterRootPart = nil
	kartVisualFrameAccumulator = 0
	kartVisualHealthAccumulator = 0
	localKartVisualMissingSince = nil
	lastKartVisualResyncAt = 0
	setActiveTreadmillHighlightAdornee(nil)
	if activeTreadmillHighlight then
		activeTreadmillHighlight:Destroy()
		activeTreadmillHighlight = nil
	end

	if singletonState and singletonState.ownerToken == handlerToken then
		singletonState.cleanup = nil
		singletonState.ownerToken = nil
	end
end

singletonState.cleanup = teardownPlayerClientHandler
if previousHandlerCleanup then
	previousHandlerCleanup("ReplacedByNewCharacterScript")
end

movementLifecycleMaid:GiveTask(stopMovementDetection)
movementLifecycleMaid:GiveTask(humanoid.Died:Connect(function()
	stopMovementDetection()
	teardownPlayerClientHandler("Humanoid.Died")
end))
movementLifecycleMaid:GiveTask(humanoid.AncestryChanged:Connect(function(_, parent)
	if parent ~= nil then
		return
	end

	stopMovementDetection()
	teardownPlayerClientHandler("HumanoidRemoved")
end))
movementLifecycleMaid:GiveTask(character.AncestryChanged:Connect(function(_, parent)
	if parent == nil then
		DebugModule.debugWarn("Character.AncestryChanged removed character, forcing cleanup", "PlayerClientHandler")
		stopMovementDetection()
		teardownPlayerClientHandler("CharacterRemoved")
	end
end))

local function scheduleHumanoidRecovery()
	recoveryUntil = tick() + RECOVERY_FORCE_UPRIGHT_WINDOW
	deferTopLevel(function()
		if humanoid.Health <= 0 then
			return
		end

		humanoid.PlatformStand = false
		humanoid.Sit = false
		humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
	end)
end

local function setupRecoveryStates()
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)

	movementLifecycleMaid:GiveTask(humanoid.StateChanged:Connect(function(_, newState)
		if humanoid.Health <= 0 then
			return
		end

		if
			newState == Enum.HumanoidStateType.FallingDown
			or newState == Enum.HumanoidStateType.Ragdoll
			or newState == Enum.HumanoidStateType.PlatformStanding
		then
			scheduleHumanoidRecovery()
		end
	end))
end

setupRecoveryStates()

local function updateVIPDoorCollision()
	PlayerHandler.UpdateVIPRoomCollision(player)
end

local function tweenCameraFov(targetFov: number)
	local currentCamera = Workspace.CurrentCamera
	if not currentCamera then
		return
	end

	if lastTargetFov and math.abs(lastTargetFov - targetFov) < 0.25 then
		return
	end

	lastTargetFov = targetFov
	if activeFovTween then
		activeFovTween:Cancel()
	end

	activeFovTween = TweenService:Create(
		currentCamera,
		TweenConfig.WithDuration(FOV_TWEEN_TIME, TweenConfig.CameraFov),
		{ FieldOfView = targetFov }
	)
	activeFovTween:Play()
end

local function updateDynamicFov()
	local currentCamera = Workspace.CurrentCamera
	local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not currentCamera or not rootPart then
		return
	end

	if player:GetAttribute("Ui_TrollFrameOpen") == true then
		tweenCameraFov(DEFAULT_FOV)
		return
	end

	if player:GetAttribute("Treadmill_Active") == true then
		tweenCameraFov(TREADMILL_FOV)
		return
	end

	local horizontalVelocity =
		Vector3.new(rootPart.AssemblyLinearVelocity.X, 0, rootPart.AssemblyLinearVelocity.Z).Magnitude
	local maxSpeed = math.max(player:GetAttribute("Max_Player_Speed") or humanoid.WalkSpeed, 1)
	local normalizedSpeed = math.clamp(horizontalVelocity / maxSpeed, 0, 1)
	local targetFov = DEFAULT_FOV + ((SPEED_FOV_MAX - DEFAULT_FOV) * normalizedSpeed)
	tweenCameraFov(targetFov)
end

local function isVIPRoomDescendant(instance: Instance): boolean
	local vipRooms = instance:FindFirstAncestor("VIPRooms")
	return vipRooms ~= nil
end

local function registerRainbowGradient(instance: Instance)
	if not instance:IsA("UIGradient") or instance.Name ~= "RainbowGradient" then
		return
	end

	if registeredRainbowGradients[instance] then
		return
	end

	registeredRainbowGradients[instance] = true
	local gradientMaid = Maid.new()
	registeredRainbowGradientMaids[instance] = gradientMaid

	local function cleanupGradientRegistration()
		registeredRainbowGradients[instance] = nil
		local existingMaid = registeredRainbowGradientMaids[instance]
		if existingMaid == gradientMaid then
			registeredRainbowGradientMaids[instance] = nil
			gradientMaid:DoCleaning()
		end
	end

	gradientMaid:GiveTask(instance.Destroying:Connect(cleanupGradientRegistration))
	gradientMaid:GiveTask(instance.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			cleanupGradientRegistration()
		end
	end))

	VisualFunctions.SetupRainbowGradient(instance)
end

local function bindWorldSourceRoot(root: Instance)
	if observedWorldSourceRoots[root] or not root:IsDescendantOf(Workspace) then
		return
	end

	local rootMaid = beginSourceRootBinding(root, observedWorldSourceRoots)
	rootMaid:GiveTask(root.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") and descendant.Name == "VIPDoor" and isVIPRoomDescendant(descendant) then
			local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local distanceText = "unknown distance"
			if rootPart then
				distanceText = string.format("%.0f studs away", (descendant.Position - rootPart.Position).Magnitude)
			end

			DebugModule.debugPrint(
				string.format(
					"New VIPDoor detected at %s, updating collision (%s)",
					tostring(descendant.Position),
					distanceText
				),
				"PlayerClientHandler"
			)
			deferTopLevel(updateVIPDoorCollision)
		end

		registerRainbowGradient(descendant)
		registerTreadmillTexture(descendant)
		registerTreadmillTouchPart(descendant)
	end))

	for _, descendant in ipairs(root:GetDescendants()) do
		registerRainbowGradient(descendant)
		registerTreadmillTexture(descendant)
		registerTreadmillTouchPart(descendant)
	end
end

local function refreshWorldSourceBindings()
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	if worldsFolder then
		bindWorldSourceRoot(worldsFolder)
	end
end

if not RunService:IsStudio() then
	ContextActionService:UnbindAction(FREECAM_BLOCK_ACTION)
	ContextActionService:BindActionAtPriority(
		FREECAM_BLOCK_ACTION,
		onBlockRobloxFreecamAction,
		false,
		Enum.ContextActionPriority.High.Value,
		Enum.KeyCode.P
	)
	topLevelMaid:GiveTask(function()
		ContextActionService:UnbindAction(FREECAM_BLOCK_ACTION)
	end)
else
	ContextActionService:UnbindAction(FREECAM_BLOCK_ACTION)
end

topLevelMaid:GiveTask(player:GetAttributeChangedSignal("HasVIPPass"):Connect(updateVIPDoorCollision))
topLevelMaid:GiveTask(player:GetAttributeChangedSignal("Treadmill_Active"):Connect(updateDynamicFov))
topLevelMaid:GiveTask(player:GetAttributeChangedSignal("Treadmill_Active"):Connect(function()
	treadmillHighlightUpdateAccumulator = TREADMILL_HIGHLIGHT_UPDATE_INTERVAL
	setActiveTreadmillHighlightAdornee(getCurrentTreadmillHighlightAdornee())
end))
topLevelMaid:GiveTask(player:GetAttributeChangedSignal("Current_World"):Connect(updateWorldMusic))
topLevelMaid:GiveTask(player:GetAttributeChangedSignal("CurrentStage"):Connect(updateWorldMusic))
topLevelMaid:GiveTask(player:GetAttributeChangedSignal("MinigameParticipant"):Connect(updateWorldMusic))
topLevelMaid:GiveTask(player:GetAttributeChangedSignal("MinigameState"):Connect(updateWorldMusic))

topLevelMaid:GiveTask(Players.PlayerAdded:Connect(function(addedPlayer)
	bindObservedTrailPlayer(addedPlayer)
end))

topLevelMaid:GiveTask(Players.PlayerRemoving:Connect(function(removingPlayer)
	cleanupObservedTrailPlayerBindings(removingPlayer)
end))

deferTopLevel(function()
	for _, targetPlayer in ipairs(Players:GetPlayers()) do
		bindObservedTrailPlayer(targetPlayer)
	end
end)

topLevelMaid:GiveTask(Workspace.ChildAdded:Connect(function(child)
	if child.Name == "Worlds" then
		deferTopLevel(updateVIPDoorCollision)
		deferTopLevel(refreshWorldSourceBindings)
	end
	if child.Name == "Worlds" or child.Name == KART_VISUAL_HOLDER_NAME then
		deferTopLevel(refreshKartVisualSourceBindings)
	end
end))

deferTopLevel(updateVIPDoorCollision)
deferTopLevel(updateDynamicFov)
deferTopLevel(updateWorldMusic)
deferTopLevel(refreshKartVisualSourceBindings)
deferTopLevel(refreshWorldSourceBindings)

scheduleKartRespawnProbe("postSpawn.0.25s", 0.25)
scheduleKartRespawnProbe("postSpawn.1.5s", 1.5)

topLevelMaid:GiveTask(RunService.Heartbeat:Connect(function(dt)
	kartVisualHealthAccumulator += dt
	if kartVisualHealthAccumulator >= KART_CLIENT_VISUAL_HEALTH_INTERVAL then
		kartVisualHealthAccumulator = 0
		reconcileLocalKartVisual()
	end

	fovUpdateAccumulator = math.min(fovUpdateAccumulator + dt, FOV_UPDATE_INTERVAL * 2)
	if fovUpdateAccumulator >= FOV_UPDATE_INTERVAL then
		updateDynamicFov()
		fovUpdateAccumulator = 0
	end

	kartShowcaseFrameAccumulator = math.min(kartShowcaseFrameAccumulator + dt, KART_SHOWCASE_FRAMELOCK_INTERVAL * 2)
	if kartShowcaseFrameAccumulator >= KART_SHOWCASE_FRAMELOCK_INTERVAL then
		local showcaseDt = kartShowcaseFrameAccumulator
		kartShowcaseFrameAccumulator = 0
		updateObservedKartShowcases(showcaseDt)
	end

	kartVisualFrameAccumulator = math.min(kartVisualFrameAccumulator + dt, KART_VISUAL_FRAMELOCK_INTERVAL * 3)
	local kartVisualSteps = 0
	while kartVisualFrameAccumulator >= KART_VISUAL_FRAMELOCK_INTERVAL and kartVisualSteps < 2 do
		kartVisualFrameAccumulator -= KART_VISUAL_FRAMELOCK_INTERVAL
		updateObservedEquippedKartVisuals(KART_VISUAL_FRAMELOCK_INTERVAL)
		kartVisualSteps += 1
	end
	if kartVisualSteps >= 2 and kartVisualFrameAccumulator >= KART_VISUAL_FRAMELOCK_INTERVAL then
		kartVisualFrameAccumulator = 0
	end

	treadmillTextureUpdateAccumulator =
		math.min(treadmillTextureUpdateAccumulator + dt, TREADMILL_TEXTURE_UPDATE_INTERVAL * 3)
	local treadmillTextureSteps = 0
	while treadmillTextureUpdateAccumulator >= TREADMILL_TEXTURE_UPDATE_INTERVAL and treadmillTextureSteps < 2 do
		treadmillTextureUpdateAccumulator -= TREADMILL_TEXTURE_UPDATE_INTERVAL
		updateTreadmillTextureVisuals(TREADMILL_TEXTURE_UPDATE_INTERVAL)
		treadmillTextureSteps += 1
	end
	if treadmillTextureSteps >= 2 and treadmillTextureUpdateAccumulator >= TREADMILL_TEXTURE_UPDATE_INTERVAL then
		treadmillTextureUpdateAccumulator = 0
	end

	updateTreadmillHighlight(dt)

	trailVisualUpdateAccumulator += dt
	local remoteTrailUpdateInterval = getRemoteTrailBudgetConfig().updateInterval
	if trailVisualUpdateAccumulator >= remoteTrailUpdateInterval then
		trailVisualUpdateAccumulator = 0
		updateObservedTrailVisuals()
	end

	worldMusicUpdateAccumulator += dt
	if worldMusicUpdateAccumulator >= WORLD_MUSIC_UPDATE_INTERVAL then
		worldMusicUpdateAccumulator = 0
		updateWorldMusic()
	end

	if recoveryUntil > tick() then
		if humanoid.Health > 0 then
			humanoid.PlatformStand = false
			humanoid.Sit = false
			if humanoid:GetState() == Enum.HumanoidStateType.PlatformStanding then
				humanoid:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
		end
	end
end))

script.AncestryChanged:Connect(function(_, parent)
	if parent ~= nil then
		return
	end

	DebugModule.debugInfo("PlayerClientHandler ancestry removed", "PlayerClientHandler")
	setActiveTreadmillHighlightAdornee(nil)
	teardownPlayerClientHandler("ScriptRemoved")
end)

script.Destroying:Connect(function()
	DebugModule.debugInfo("PlayerClientHandler destroying", "PlayerClientHandler")
	setActiveTreadmillHighlightAdornee(nil)
	teardownPlayerClientHandler("ScriptDestroying")
end)
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="5674">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="5675">
        <Properties>
          <string name="Name">BloodmoonParticle</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local BloodmoonParticleService = require(ReplicatedStorage.Modules.BloodmoonParticleService)
local Maid = require(ReplicatedStorage.Modules.Maid)

local controller = BloodmoonParticleService.new(Players.LocalPlayer)
controller:Start()

local lifecycleMaid = Maid.new()
local cleaned = false
local function cleanup()
	if cleaned then
		return
	end
	cleaned = true
	lifecycleMaid:DoCleaning()
end

lifecycleMaid:GiveTask(function()
	controller:Destroy()
end)
lifecycleMaid:GiveTask(script.AncestryChanged:Connect(function(_, parent: Instance?)
	if parent == nil then
		cleanup()
	end
end))
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="5676">
        <Properties>
          <string name="Name">ClientGraphics</string>
          <string name="Source"><![CDATA[local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ClientGraphicsService = require(ReplicatedStorage.Modules.ClientGraphicsService)

ClientGraphicsService.Init()

local function shutdown()
	ClientGraphicsService.Shutdown()
end

script.Destroying:Connect(shutdown)
script.AncestryChanged:Connect(function(_, parent)
	if parent == nil then
		shutdown()
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="5677">
        <Properties>
          <string name="Name">EventBoard</string>
          <string name="Source"><![CDATA[local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CoreConfig = require(ReplicatedStorage.Modules.Shared.CoreConfig_Client)
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local Maid = require(ReplicatedStorage.Modules.Maid)
local VisualFunctions = require(ReplicatedStorage.Modules.UI.VisualFunctions)

local localPlayer = Players.LocalPlayer

local EVENT_FETCH_INTERVAL = 30
local EVENT_EMPTY_RETRY_INTERVAL = 3
local EVENT_ERROR_RETRY_INTERVAL = 5
local EVENT_STARTUP_RETRY_INTERVAL = 2
local EVENT_STARTUP_RETRY_COUNT = 15
local EVENT_TOUCH_DEBOUNCE = 3
local BOARD_STARTUP_RETRY_INTERVAL = 0.5
local BOARD_STARTUP_RETRY_COUNT = 20
local EVENT_STATUS_NOW = "NOW HAPPENING!"
local EVENT_STATUS_NONE = "NO EVENT YET"
local EVENT_STATUS_LOADING = "LOADING EVENT..."
local EVENT_COUNTDOWN_NONE = "CHECK BACK SOON"
local EVENT_COUNTDOWN_FINISHED = "EVENT FINISHED!"
local EVENT_COUNTDOWN_PREFIX = "LIVE IN: "
local EVENT_PLACEHOLDER_IMAGE = "rbxassetid://81072563465880"
local EVENT_RSVP_PROMPT_NAME = "ProximityPrompt"
local LEGACY_EVENT_RSVP_PROMPT_NAME = "EventBoardRSVPPrompt"

type EventDictionary = {
	Id: string?,
	Title: string?,
	DisplayTitle: string?,
	Description: string?,
	HasStarted: boolean?,
	HasEnded: boolean?,
	PreviewAssetId: number?,
	ThumbnailId: number?,
	ThumbnailIds: { number }?,
	thumbnails: { [string]: any }?,
	Thumbnails: { [string]: any }?,
	thumbnail: { [string]: any }?,
	Thumbnail: { [string]: any }?,
	UserRsvpStatus: any?,
	Status: any?,
	StartTime: any?,
	EndTime: any?,
}

type EventLifecycleState = "Upcoming" | "Active" | "Ended"

type EventBoardGuiState = {
	model: Model,
	touchPart: BasePart?,
	touchConnected: boolean,
	eventLabel: TextLabel?,
	countdownLabel: TextLabel?,
	imageLabel: ImageLabel?,
	rsvpPrompt: ProximityPrompt?,
	lastTouchTime: number,
	lastAppliedImageContent: string?,
}

local eventBoards: { EventBoardGuiState } = {}
local registeredBoards: { [Instance]: boolean } = {}
local pendingBoards: { [Model]: boolean } = {}
local boardMaids: { [Model]: any } = {}
local unregisteringBoards: { [Model]: boolean } = {}
local selectedEvent: EventDictionary? = nil
local nextFetchTime = 0
local fetchInProgress = false
local hasFetchedEvents = false
local startupFetchAttemptCount = 0
local scriptMaid = Maid.new()
local isRunning = true
local isCleanedUp = false
local rsvpInProgress = false
local eventBoardConfig = if typeof(CoreConfig.eventBoard) == "table" then CoreConfig.eventBoard else {}
local scheduleSelectedEventBoundaryRefresh: ((EventDictionary?) -> ())? = nil
local lastThumbnailDiagnosticKey = ""

local function getCharacterRootPart(): BasePart?
	local character = localPlayer.Character
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function isLocalPlayerTouch(hit: BasePart): boolean
	local character = localPlayer.Character
	if not character then
		return false
	end

	return hit:IsDescendantOf(character)
end

local function getDateTableUnixTimestamp(dateValue: any): number?
	if dateValue == nil then
		return nil
	end

	local directTimestampSuccess, directTimestamp = pcall(function()
		return (dateValue :: any).UnixTimestampMillis
	end)
	if directTimestampSuccess and typeof(directTimestamp) == "number" then
		return directTimestamp
	end

	if typeof(dateValue) ~= "table" then
		return nil
	end

	local dateTable = dateValue :: { [string]: any }
	local requiredFields = {
		dateTable.Year,
		dateTable.Month,
		dateTable.Day,
		dateTable.Hour,
		dateTable.Minute,
		dateTable.Second,
	}
	for _, value in ipairs(requiredFields) do
		if typeof(value) ~= "number" then
			return nil
		end
	end

	local success, dateTime = pcall(function()
		return DateTime.fromUniversalTime(
			dateTable.Year,
			dateTable.Month,
			dateTable.Day,
			dateTable.Hour,
			dateTable.Minute,
			dateTable.Second,
			dateTable.Millisecond or 0
		)
	end)

	if success and dateTime then
		return dateTime.UnixTimestampMillis
	end

	return nil
end

local function getEventStartUnixTimestamp(eventData: EventDictionary): number?
	return getDateTableUnixTimestamp(eventData.StartTime)
end

local function getEventEndUnixTimestamp(eventData: EventDictionary): number?
	return getDateTableUnixTimestamp(eventData.EndTime)
end

local function getEventLifecycleState(eventData: EventDictionary): EventLifecycleState
	local nowTimestamp = DateTime.now().UnixTimestampMillis
	local startTimestamp = getEventStartUnixTimestamp(eventData)
	local endTimestamp = getEventEndUnixTimestamp(eventData)

	-- Timestamps are authoritative during event handoff. SocialService status fields can
	-- briefly describe the previously active event after the next event is selected.
	if endTimestamp and nowTimestamp >= endTimestamp then
		return "Ended"
	end
	if startTimestamp then
		if nowTimestamp < startTimestamp then
			return "Upcoming"
		end
		return "Active"
	end

	local status = eventData.Status
	if typeof(status) == "EnumItem" then
		if status.Name == "Active" or status.Name == "Started" or status.Name == "Live" then
			return "Active"
		end
		if status.Name == "Ended" or status.Name == "Completed" then
			return "Ended"
		end
	end

	if eventData.HasEnded == true then
		return "Ended"
	end

	if eventData.HasStarted == true then
		return "Active"
	end

	if eventData.HasStarted == false then
		return "Upcoming"
	end

	return "Upcoming"
end

local function formatCountdown(eventData: EventDictionary): string
	local lifecycleState = getEventLifecycleState(eventData)
	if lifecycleState == "Active" then
		return EVENT_STATUS_NOW
	end

	if lifecycleState == "Ended" then
		return EVENT_COUNTDOWN_FINISHED
	end

	local startTimestamp = getEventStartUnixTimestamp(eventData)
	if not startTimestamp then
		return EVENT_COUNTDOWN_NONE
	end

	local remainingSeconds = math.max(0, math.floor((startTimestamp - DateTime.now().UnixTimestampMillis) / 1000))
	local days = math.floor(remainingSeconds / 86400)
	local hours = math.floor((remainingSeconds % 86400) / 3600)
	local minutes = math.floor((remainingSeconds % 3600) / 60)
	local seconds = remainingSeconds % 60

	if days > 0 then
		return string.format("%s%dd %dh", EVENT_COUNTDOWN_PREFIX, days, hours)
	end

	if hours > 0 then
		return string.format("%s%dh %dm", EVENT_COUNTDOWN_PREFIX, hours, minutes)
	end

	if minutes > 0 then
		return string.format("%s%dm %ds", EVENT_COUNTDOWN_PREFIX, minutes, seconds)
	end

	return string.format("%s%ds", EVENT_COUNTDOWN_PREFIX, seconds)
end

local function isRsvpEligibleEvent(eventData: EventDictionary?): boolean
	if eventData == nil then
		return false
	end

	-- Roblox only allows RSVP prompts for events that have not yet started.
	return getEventLifecycleState(eventData) == "Upcoming"
end

local function getEventId(eventData: EventDictionary?): string
	if eventData == nil then
		return ""
	end

	local idValue = eventData.Id
	if typeof(idValue) == "string" then
		return idValue
	end

	if typeof(idValue) == "number" then
		return tostring(idValue)
	end

	return ""
end

local function getPositiveAssetId(value: any): number?
	if typeof(value) == "number" and value > 0 then
		return value
	end

	if typeof(value) == "string" then
		local parsedValue = tonumber(value)
		if parsedValue and parsedValue > 0 then
			return parsedValue
		end

		local assetId = tonumber(string.match(value, "(%d+)$"))
		if assetId and assetId > 0 then
			return assetId
		end
	end

	return nil
end

local function getNestedThumbnailId(value: any): number?
	local directId = getPositiveAssetId(value)
	if directId then
		return directId
	end

	if typeof(value) ~= "table" then
		return nil
	end

	local thumbnailData = value :: { [any]: any }
	local thumbnailKeys = {
		"mediaId",
		"MediaId",
		"id",
		"Id",
		"assetId",
		"AssetId",
		"thumbnailId",
		"ThumbnailId",
		"thumbnailAssetId",
		"ThumbnailAssetId",
		"imageId",
		"ImageId",
		"imageAssetId",
		"ImageAssetId",
	}
	for _, key in ipairs(thumbnailKeys) do
		local nestedId = getPositiveAssetId(thumbnailData[key])
		if nestedId then
			return nestedId
		end
	end

	-- Event metadata may wrap mediaId inside an array of ranked thumbnails.
	for _, nestedValue in pairs(thumbnailData) do
		local nestedId = getNestedThumbnailId(nestedValue)
		if nestedId then
			return nestedId
		end
	end

	return nil
end

local function getConfiguredEventThumbnailId(eventId: string): number?
	local configuredIds = eventBoardConfig.eventThumbnailIdsByEvent
	if typeof(configuredIds) ~= "table" then
		return nil
	end

	return getPositiveAssetId(configuredIds[eventId])
end

local function resolveEventThumbnail(
	eventData: EventDictionary?,
	includeConfiguredFallback: boolean?
): (number?, string)
	if not eventData then
		return nil, "NoEvent"
	end

	local rawEventData = eventData :: any
	local thumbnailLists = {
		eventData.ThumbnailIds,
		rawEventData.thumbnailIds,
		rawEventData.thumbnailIDs,
		rawEventData.mediaIds,
		rawEventData.MediaIds,
	}
	local thumbnailListNames = {
		"ThumbnailIds",
		"thumbnailIds",
		"thumbnailIDs",
		"mediaIds",
		"MediaIds",
	}
	for index, thumbnailList in ipairs(thumbnailLists) do
		if typeof(thumbnailList) == "table" then
			for _, thumbnailId in pairs(thumbnailList) do
				local positiveThumbnailId = getPositiveAssetId(thumbnailId)
				if positiveThumbnailId then
					return positiveThumbnailId, thumbnailListNames[index]
				end
			end
		end
	end

	local directThumbnailIds = {
		eventData.ThumbnailId,
		eventData.PreviewAssetId,
		rawEventData.ThumbnailAssetId,
		rawEventData.ImageId,
		rawEventData.ImageAssetId,
		rawEventData.MediaAssetId,
	}
	local directThumbnailNames = {
		"ThumbnailId",
		"PreviewAssetId",
		"ThumbnailAssetId",
		"ImageId",
		"ImageAssetId",
		"MediaAssetId",
	}
	for index, thumbnailId in ipairs(directThumbnailIds) do
		local positiveThumbnailId = getPositiveAssetId(thumbnailId)
		if positiveThumbnailId then
			return positiveThumbnailId, directThumbnailNames[index]
		end
	end

	local nestedThumbnailData = {
		eventData.thumbnails,
		eventData.Thumbnails,
		eventData.thumbnail,
		eventData.Thumbnail,
	}
	local nestedThumbnailNames = {
		"thumbnails",
		"Thumbnails",
		"thumbnail",
		"Thumbnail",
	}
	for index, thumbnailData in ipairs(nestedThumbnailData) do
		local nestedThumbnailId = getNestedThumbnailId(thumbnailData)
		if nestedThumbnailId then
			return nestedThumbnailId, nestedThumbnailNames[index]
		end
	end

	if includeConfiguredFallback ~= false then
		local configuredThumbnailId = getConfiguredEventThumbnailId(getEventId(eventData))
		if configuredThumbnailId then
			return configuredThumbnailId, "ConfiguredEventThumbnail"
		end
	end

	return nil, "None"
end

local function getEventThumbnailId(eventData: EventDictionary?, includeConfiguredFallback: boolean?): number?
	local thumbnailId = resolveEventThumbnail(eventData, includeConfiguredFallback)
	return thumbnailId
end

local function getEventImageContent(eventData: EventDictionary?): (string, string)
	local thumbnailId, thumbnailSource = resolveEventThumbnail(eventData, true)
	if thumbnailId then
		return "rbxassetid://" .. tostring(thumbnailId), thumbnailSource
	end

	return EVENT_PLACEHOLDER_IMAGE, "Placeholder"
end

local function getEventTopLevelKeys(eventData: EventDictionary): string
	local keys: { string } = {}
	for key in pairs(eventData :: any) do
		table.insert(keys, tostring(key))
	end
	table.sort(keys)
	return if #keys > 0 then table.concat(keys, ",") else "none"
end

local THUMBNAIL_DIAGNOSTIC_KEYS = {
	"ThumbnailIds",
	"thumbnailIds",
	"thumbnailIDs",
	"mediaIds",
	"MediaIds",
	"ThumbnailId",
	"PreviewAssetId",
	"ThumbnailAssetId",
	"ImageId",
	"ImageAssetId",
	"MediaAssetId",
	"thumbnails",
	"Thumbnails",
	"thumbnail",
	"Thumbnail",
	"metadata",
	"Metadata",
	"eventMetadata",
	"EventMetadata",
}

local function getMetadataValueSummary(value: any): string
	if value == nil then
		return "nil"
	end

	local valueType = typeof(value)
	if valueType ~= "table" then
		return valueType .. "|value=" .. tostring(value)
	end

	local entries: { string } = {}
	local entryCount = 0
	for key, nestedValue in pairs(value :: { [any]: any }) do
		entryCount += 1
		if #entries < 8 then
			local nestedType = typeof(nestedValue)
			local nestedSummary = if nestedType == "table"
				then "table"
				else nestedType .. "(" .. tostring(nestedValue) .. ")"
			table.insert(entries, tostring(key) .. "=" .. nestedSummary)
		end
	end

	local suffix = if entryCount > #entries then ",..." else ""
	return "table|entries=" .. tostring(entryCount) .. "|sample=" .. table.concat(entries, ",") .. suffix
end

local function getThumbnailFieldDiagnostics(eventData: any): string
	if typeof(eventData) ~= "table" then
		return "eventType=" .. typeof(eventData)
	end

	local summaries: { string } = {}
	for _, key in ipairs(THUMBNAIL_DIAGNOSTIC_KEYS) do
		local value = eventData[key]
		if value ~= nil then
			local nestedId = getNestedThumbnailId(value)
			local summary = key .. "=" .. getMetadataValueSummary(value)
			if nestedId then
				summary ..= "|resolvedId=" .. tostring(nestedId)
			end
			table.insert(summaries, summary)
		end
	end

	return if #summaries > 0 then table.concat(summaries, ";") else "none"
end

local function getThumbnailMetadataSummary(eventData: EventDictionary): string
	local rawEventData = eventData :: any
	local metadataKeys = {
		"ThumbnailIds",
		"thumbnailIds",
		"thumbnailIDs",
		"mediaIds",
		"MediaIds",
		"ThumbnailId",
		"PreviewAssetId",
		"ThumbnailAssetId",
		"ImageId",
		"ImageAssetId",
		"MediaAssetId",
		"thumbnails",
		"Thumbnails",
		"thumbnail",
		"Thumbnail",
	}
	local summaries: { string } = {}
	for _, key in ipairs(metadataKeys) do
		local value = rawEventData[key]
		if value ~= nil then
			local summary = key .. "=" .. typeof(value)
			if typeof(value) == "table" then
				local nestedId = getNestedThumbnailId(value)
				summary ..= "|count=" .. tostring(#value)
				if nestedId then
					summary ..= "|resolvedId=" .. tostring(nestedId)
				end
			else
				summary ..= "|value=" .. tostring(value)
			end
			table.insert(summaries, summary)
		end
	end

	return if #summaries > 0 then table.concat(summaries, ";") else "none"
end

local function logThumbnailDiagnostics(eventData: EventDictionary)
	local eventId = getEventId(eventData)
	local apiThumbnailId, apiThumbnailSource = resolveEventThumbnail(eventData, false)
	local configuredThumbnailId = getConfiguredEventThumbnailId(eventId)
	local resolvedThumbnailId, resolvedThumbnailSource = resolveEventThumbnail(eventData, true)
	local diagnosticKey = table.concat({
		eventId,
		tostring(apiThumbnailId),
		apiThumbnailSource,
		tostring(configuredThumbnailId),
		tostring(resolvedThumbnailId),
		resolvedThumbnailSource,
		getThumbnailMetadataSummary(eventData),
	}, "|")
	if diagnosticKey == lastThumbnailDiagnosticKey then
		return
	end
	lastThumbnailDiagnosticKey = diagnosticKey

	DebugModule.debugInfo(
		"Thumbnail resolution | eventId="
			.. eventId
			.. " | apiId="
			.. tostring(apiThumbnailId)
			.. " | apiSource="
			.. apiThumbnailSource
			.. " | configuredId="
			.. tostring(configuredThumbnailId)
			.. " | resolvedId="
			.. tostring(resolvedThumbnailId)
			.. " | resolvedSource="
			.. resolvedThumbnailSource
			.. " | metadata="
			.. getThumbnailMetadataSummary(eventData),
		"EventBoard"
	)
	DebugModule.debugInfo(
		"Event metadata keys | eventId=" .. eventId .. " | keys=" .. getEventTopLevelKeys(eventData),
		"EventBoard"
	)
	DebugModule.debugInfo(
		"Event thumbnail field shapes | eventId=" .. eventId .. " | fields=" .. getThumbnailFieldDiagnostics(eventData),
		"EventBoard"
	)

	if not apiThumbnailId then
		DebugModule.debugWarn(
			"Event API returned no usable thumbnail ID | eventId="
				.. eventId
				.. " | expected=ThumbnailIds | resolvedSource="
				.. resolvedThumbnailSource,
			"EventBoard"
		)
	end
	if resolvedThumbnailSource == "ConfiguredEventThumbnail" then
		DebugModule.debugWarn(
			"Using configured event thumbnail fallback | eventId="
				.. eventId
				.. " | thumbnailId="
				.. tostring(resolvedThumbnailId),
			"EventBoard"
		)
	elseif resolvedThumbnailSource == "None" then
		DebugModule.debugWarn(
			"No event thumbnail resolved; board will use placeholder | eventId=" .. eventId,
			"EventBoard"
		)
	end
end

local function getConfiguredEventId(): string
	local activeEventIdsByUniverse = eventBoardConfig.activeEventIdsByUniverse
	if typeof(activeEventIdsByUniverse) == "table" then
		local universeEventId = activeEventIdsByUniverse[game.GameId]
		if typeof(universeEventId) == "string" and universeEventId ~= "" then
			return universeEventId
		end
	end

	local configuredEventId = eventBoardConfig.activeEventId
	if typeof(configuredEventId) == "string" and configuredEventId ~= "" then
		return configuredEventId
	end

	for _, boardState in ipairs(eventBoards) do
		for _, attributeName in ipairs({ "EventId", "EventID", "ExperienceEventId" }) do
			local attributeValue = boardState.model:GetAttribute(attributeName)
			if typeof(attributeValue) == "string" and attributeValue ~= "" then
				return attributeValue
			elseif typeof(attributeValue) == "number" and attributeValue > 0 then
				return tostring(attributeValue)
			end
		end
	end

	return ""
end

local function fetchEventById(eventId: string): (EventDictionary?, boolean)
	local success, result = pcall(function()
		return SocialService:GetExperienceEventAsync(eventId)
	end)
	if not success then
		DebugModule.debugWarn("Failed to load event details for " .. eventId .. ": " .. tostring(result), "EventBoard")
		return nil, false
	end

	if typeof(result) ~= "table" then
		DebugModule.debugWarn("GetExperienceEventAsync returned no event table | eventId=" .. eventId, "EventBoard")
		return nil, true
	end

	return result :: EventDictionary, true
end

local function applyBoardState(boardState: EventBoardGuiState)
	if selectedEvent then
		if boardState.eventLabel then
			local title = selectedEvent.DisplayTitle or selectedEvent.Title
			boardState.eventLabel.Text = tostring(title or EVENT_STATUS_NONE)
		end
		if boardState.countdownLabel then
			boardState.countdownLabel.Text = formatCountdown(selectedEvent)
		end
	else
		if boardState.eventLabel then
			boardState.eventLabel.Text = if hasFetchedEvents then EVENT_STATUS_NONE else EVENT_STATUS_LOADING
		end
		if boardState.countdownLabel then
			boardState.countdownLabel.Text = EVENT_COUNTDOWN_NONE
		end
	end

	if boardState.imageLabel then
		local imageContent, imageSource = getEventImageContent(selectedEvent)
		local imageChanged = boardState.lastAppliedImageContent ~= imageContent
			or boardState.imageLabel.Image ~= imageContent
		if imageChanged then
			boardState.lastAppliedImageContent = imageContent
			boardState.imageLabel.Image = imageContent
			DebugModule.debugInfo(
				"Event image applied | board="
					.. boardState.model:GetFullName()
					.. " | eventId="
					.. getEventId(selectedEvent)
					.. " | source="
					.. imageSource
					.. " | content="
					.. imageContent,
				"EventBoard"
			)
			if imageSource == "Placeholder" then
				DebugModule.debugWarn(
					"Board image is placeholder | board=" .. boardState.model:GetFullName(),
					"EventBoard"
				)
			end
		end
	end
	if boardState.rsvpPrompt then
		-- Keep the interaction discoverable permanently; promptSelectedEvent still
		-- validates that a current event can accept RSVPs before opening the prompt.
		boardState.rsvpPrompt.Enabled = true
	end
end

local function applyAllBoards()
	for _, boardState in ipairs(eventBoards) do
		applyBoardState(boardState)
	end
end

local function normalizeEventTitle(value: any): string
	if typeof(value) ~= "string" then
		return ""
	end

	local normalized = string.upper(value)
	normalized = string.gsub(normalized, "[^%w]+", " ")
	normalized = string.gsub(normalized, "^%s+", "")
	normalized = string.gsub(normalized, "%s+$", "")
	return normalized
end

local function isSecondaryEvent(eventData: EventDictionary): boolean
	local title = eventData.DisplayTitle or eventData.Title
	local normalizedTitle = normalizeEventTitle(title)
	if normalizedTitle == "" then
		return false
	end

	local secondaryTitles = eventBoardConfig.secondaryEventTitles
	if typeof(secondaryTitles) ~= "table" then
		return false
	end

	for _, secondaryTitle in ipairs(secondaryTitles) do
		if normalizedTitle == normalizeEventTitle(secondaryTitle) then
			return true
		end
	end

	return false
end

local function pickBestEvent(events: { any }): EventDictionary?
	local normalizedEvents: { EventDictionary } = {}
	for _, eventData in ipairs(events) do
		if typeof(eventData) == "table" then
			table.insert(normalizedEvents, eventData :: EventDictionary)
		end
	end

	table.sort(normalizedEvents, function(a, b)
		local aTimestamp = getEventStartUnixTimestamp(a) or math.huge
		local bTimestamp = getEventStartUnixTimestamp(b) or math.huge
		return aTimestamp < bTimestamp
	end)

	local function findFirstByState(state: EventLifecycleState, secondary: boolean): EventDictionary?
		for _, eventData in ipairs(normalizedEvents) do
			if getEventLifecycleState(eventData) == state and isSecondaryEvent(eventData) == secondary then
				return eventData
			end
		end
		return nil
	end

	local function findFirstNotEnded(secondary: boolean): EventDictionary?
		for _, eventData in ipairs(normalizedEvents) do
			if eventData.HasEnded ~= true and isSecondaryEvent(eventData) == secondary then
				return eventData
			end
		end
		return nil
	end

	return findFirstByState("Active", false)
		or findFirstByState("Upcoming", false)
		or findFirstByState("Active", true)
		or findFirstByState("Upcoming", true)
		or findFirstNotEnded(false)
		or findFirstNotEnded(true)
end

local function extractEventsFromResult(result: any): { any }
	if typeof(result) == "table" and #result > 0 then
		return result :: { any }
	end

	if typeof(result) == "table" then
		local dictionaryResult = result :: { [any]: any }
		if dictionaryResult.Id ~= nil then
			return { result }
		end

		for _, key in ipairs({ "Events", "events", "Data", "data", "Items", "items" }) do
			local nestedEvents = dictionaryResult[key]
			if typeof(nestedEvents) == "table" then
				if nestedEvents.Id ~= nil then
					return { nestedEvents }
				end
				return nestedEvents :: { any }
			end
		end

		if #result == 0 then
			return result :: { any }
		end
	end

	-- Some runtimes expose a pages-like object. Handle that shape too.
	local pageSuccess, pageResult = pcall(function()
		return (result :: any):GetCurrentPage()
	end)
	if pageSuccess and typeof(pageResult) == "table" then
		return pageResult :: { any }
	end

	return {}
end

local function enrichEventDetails(eventData: EventDictionary): EventDictionary
	-- Upcoming-event results sometimes omit ThumbnailIds while the detail endpoint
	-- includes them. Do not let a manual fallback prevent that richer lookup.
	if getEventThumbnailId(eventData, false) then
		return eventData
	end

	local eventId = getEventId(eventData)
	if eventId == "" then
		return eventData
	end

	local success, result = pcall(function()
		return SocialService:GetExperienceEventAsync(eventId)
	end)
	if not success or typeof(result) ~= "table" then
		if not success then
			DebugModule.debugWarn(
				"Failed to load event details for " .. eventId .. ": " .. tostring(result),
				"EventBoard"
			)
		else
			DebugModule.debugWarn("Event detail response was nil or malformed | eventId=" .. eventId, "EventBoard")
		end
		return eventData
	end

	local detailThumbnailId, detailThumbnailSource = resolveEventThumbnail(result :: EventDictionary, false)
	DebugModule.debugInfo(
		"Event detail response | eventId="
			.. eventId
			.. " | thumbnailId="
			.. tostring(detailThumbnailId)
			.. " | thumbnailSource="
			.. detailThumbnailSource
			.. " | metadata="
			.. getThumbnailMetadataSummary(result :: EventDictionary),
		"EventBoard"
	)
	DebugModule.debugInfo(
		"Event detail raw shape | eventId="
			.. eventId
			.. " | resultType="
			.. typeof(result)
			.. " | keys="
			.. getEventTopLevelKeys(result :: EventDictionary)
			.. " | fields="
			.. getThumbnailFieldDiagnostics(result),
		"EventBoard"
	)
	if not detailThumbnailId then
		DebugModule.debugWarn(
			"Event detail has no recognized thumbnail field | eventId="
				.. eventId
				.. " | expected=ThumbnailIds or thumbnails.mediaId",
			"EventBoard"
		)
	end

	local detailedEvent = table.clone(eventData) :: any
	for key, value in pairs(result :: { [string]: any }) do
		detailedEvent[key] = value
	end

	return detailedEvent :: EventDictionary
end

local function setSelectedEvent(eventData: EventDictionary?)
	selectedEvent = eventData
	if eventData then
		logThumbnailDiagnostics(eventData)
	else
		lastThumbnailDiagnosticKey = ""
	end
	if scheduleSelectedEventBoundaryRefresh then
		scheduleSelectedEventBoundaryRefresh(eventData)
	end
end

local function tryConfiguredEventFallback(now: number): (boolean, boolean)
	local fallbackEventId = getConfiguredEventId()
	if fallbackEventId == "" then
		fallbackEventId = getEventId(selectedEvent)
	end

	if fallbackEventId == "" then
		return false, true
	end

	local fallbackEvent, lookupSucceeded = fetchEventById(fallbackEventId)
	if fallbackEvent and getEventLifecycleState(fallbackEvent) ~= "Ended" then
		setSelectedEvent(enrichEventDetails(fallbackEvent))
		DebugModule.debugInfo(
			"Configured event fallback selected | placeId="
				.. tostring(game.PlaceId)
				.. " | universeId="
				.. tostring(game.GameId)
				.. " | eventId="
				.. fallbackEventId,
			"EventBoard"
		)
		startupFetchAttemptCount = 0
		nextFetchTime = now + EVENT_FETCH_INTERVAL
		return true, true
	end

	return false, lookupSucceeded
end

local function refreshCurrentEvent(force: boolean?)
	local now = os.clock()
	if not force and now < nextFetchTime then
		applyAllBoards()
		return
	end

	if fetchInProgress then
		applyAllBoards()
		return
	end

	fetchInProgress = true

	local success, result = pcall(function()
		return SocialService:GetUpcomingExperienceEventsAsync()
	end)

	fetchInProgress = false

	if not success then
		DebugModule.debugWarn("Failed to load upcoming experience events: " .. tostring(result), "EventBoard")
		local fallbackApplied, fallbackLookupSucceeded = tryConfiguredEventFallback(now)
		if not fallbackApplied then
			if not fallbackLookupSucceeded and selectedEvent and getEventLifecycleState(selectedEvent) ~= "Ended" then
				startupFetchAttemptCount += 1
				nextFetchTime = now + EVENT_ERROR_RETRY_INTERVAL
			else
				setSelectedEvent(nil)
				startupFetchAttemptCount += 1
				nextFetchTime = now
					+ (
						if startupFetchAttemptCount <= EVENT_STARTUP_RETRY_COUNT
							then EVENT_STARTUP_RETRY_INTERVAL
							else EVENT_ERROR_RETRY_INTERVAL
					)
			end
		end
		applyAllBoards()
		return
	end

	hasFetchedEvents = true
	local processingSuccess, bestEventOrError = pcall(function()
		local events = extractEventsFromResult(result)
		DebugModule.debugInfo("Automatic event fetch succeeded | eventCount=" .. tostring(#events), "EventBoard")
		return pickBestEvent(events)
	end)
	if not processingSuccess then
		DebugModule.debugWarn(
			"Failed to process upcoming experience events: " .. tostring(bestEventOrError),
			"EventBoard"
		)
		startupFetchAttemptCount += 1
		nextFetchTime = now + EVENT_STARTUP_RETRY_INTERVAL
		applyAllBoards()
		return
	end

	local bestEvent = bestEventOrError :: EventDictionary?
	if bestEvent then
		setSelectedEvent(enrichEventDetails(bestEvent))
		local selectedEventData = selectedEvent :: any
		DebugModule.debugInfo(
			"Selected event | eventId="
				.. getEventId(selectedEvent)
				.. " | idType="
				.. typeof(selectedEventData.Id)
				.. " | title="
				.. tostring(selectedEventData.DisplayTitle or selectedEventData.Title)
				.. " | lifecycle="
				.. getEventLifecycleState(selectedEvent),
			"EventBoard"
		)
		startupFetchAttemptCount = 0
		nextFetchTime = now + EVENT_FETCH_INTERVAL
	else
		local fallbackApplied, fallbackLookupSucceeded = tryConfiguredEventFallback(now)
		if fallbackApplied then
			-- The configured event is used when the API only returns future events.
		elseif not fallbackLookupSucceeded and selectedEvent and getEventLifecycleState(selectedEvent) ~= "Ended" then
			-- Keep the last valid event visible during a temporary SocialService failure.
			startupFetchAttemptCount += 1
			nextFetchTime = now + EVENT_ERROR_RETRY_INTERVAL
		else
			setSelectedEvent(nil)
			startupFetchAttemptCount += 1
			nextFetchTime = now
				+ (
					if startupFetchAttemptCount <= EVENT_STARTUP_RETRY_COUNT
						then EVENT_STARTUP_RETRY_INTERVAL
						else EVENT_EMPTY_RETRY_INTERVAL
				)
		end
	end

	applyAllBoards()
end

local function scheduleForcedEventRefresh(delaySeconds: number)
	local refreshThread = task.delay(delaySeconds, function()
		if isCleanedUp or not isRunning then
			return
		end

		refreshCurrentEvent(true)
	end)
	scriptMaid:GiveTask(refreshThread)
end

scheduleSelectedEventBoundaryRefresh = function(eventData: EventDictionary?)
	scriptMaid.EventBoundaryRefresh = nil
	if not eventData then
		return
	end

	local nowTimestamp = DateTime.now().UnixTimestampMillis
	local startTimestamp = getEventStartUnixTimestamp(eventData)
	local endTimestamp = getEventEndUnixTimestamp(eventData)
	local nextBoundary = if startTimestamp and startTimestamp > nowTimestamp
		then startTimestamp
		elseif endTimestamp and endTimestamp > nowTimestamp then endTimestamp
		else nil
	if not nextBoundary then
		return
	end

	local delaySeconds = math.max(0.1, (nextBoundary - nowTimestamp) / 1000 + 0.05)
	local boundaryThread = task.delay(delaySeconds, function()
		if not isCleanedUp and isRunning then
			refreshCurrentEvent(true)
		end
	end)
	scriptMaid.EventBoundaryRefresh = function()
		pcall(task.cancel, boundaryThread)
	end
end

local function getRsvpNotificationTheme(rsvpStatus: any): (string, Color3, Color3)
	if rsvpStatus == Enum.RsvpStatus.Going then
		return "RSVP REGISTERED!", Color3.fromRGB(0, 255, 0), Color3.fromRGB(0, 130, 15)
	end

	if rsvpStatus == Enum.RsvpStatus.NotGoing or rsvpStatus == Enum.RsvpStatus.None then
		return "RSVP CANCELLED!", Color3.fromRGB(255, 78, 78), Color3.fromRGB(130, 0, 0)
	end

	return "RSVP STATUS UPDATED!", Color3.fromRGB(255, 255, 255), Color3.fromRGB(100, 100, 100)
end

local function showRsvpNotification(eventId: string, rsvpStatus: any)
	local message, textColor, gradientBottomColor = getRsvpNotificationTheme(rsvpStatus)

	-- GuiHandler can initialize after EventBoard. Wait only for a bounded time so a
	-- successful RSVP is not lost just because the notification HUD is still loading.
	for _ = 1, 50 do
		if isCleanedUp or not isRunning then
			return
		end

		local notificationFrame = VisualFunctions.HUD.NotificationFrame
		local notificationLabel = VisualFunctions.Labels.NotificationTextLabel

		if
			notificationFrame
			and notificationFrame.Parent
			and notificationLabel
			and notificationLabel.Parent
			and notificationLabel:IsDescendantOf(notificationFrame)
		then
			local notificationSuccess, notificationError = pcall(function()
				VisualFunctions.ShowNotification(message, textColor, gradientBottomColor)
			end)
			if notificationSuccess then
				DebugModule.debugInfo("RSVP notification shown | eventId=" .. eventId, "EventBoard")
			else
				DebugModule.debugWarn(
					"RSVP succeeded but notification failed | eventId="
						.. eventId
						.. " | error="
						.. tostring(notificationError),
					"EventBoard"
				)
			end
			return
		end

		task.wait(0.1)
	end

	DebugModule.debugWarn("RSVP succeeded but NotificationFrame was not ready | eventId=" .. eventId, "EventBoard")
end

local function promptSelectedEvent(boardState: EventBoardGuiState)
	if rsvpInProgress then
		DebugModule.debugInfo("RSVP ignored because another prompt is in progress", "EventBoard")
		return
	end

	refreshCurrentEvent(true)

	if not selectedEvent then
		DebugModule.debugWarn("RSVP ignored because no event is selected", "EventBoard")
		return
	end

	if not isRsvpEligibleEvent(selectedEvent) then
		DebugModule.debugWarn(
			"RSVP ignored because selected event is not upcoming | eventId=" .. getEventId(selectedEvent),
			"EventBoard"
		)
		return
	end

	local eventId = getEventId(selectedEvent)
	if eventId == "" then
		DebugModule.debugWarn("RSVP ignored because selected event has no ID", "EventBoard")
		return
	end

	local now = os.clock()
	if now - boardState.lastTouchTime < EVENT_TOUCH_DEBOUNCE then
		DebugModule.debugInfo("RSVP ignored by debounce | board=" .. boardState.model:GetFullName(), "EventBoard")
		return
	end

	boardState.lastTouchTime = now
	rsvpInProgress = true
	local selectedEventData = selectedEvent :: any
	DebugModule.debugInfo(
		"RSVP prompt requested | eventId="
			.. eventId
			.. " | idType="
			.. typeof(selectedEventData.Id)
			.. " | lifecycle="
			.. getEventLifecycleState(selectedEvent)
			.. " | board="
			.. boardState.model:GetFullName(),
		"EventBoard"
	)

	scriptMaid:GiveSpawnTask(task.spawn(function()
		local success, rsvpStatus = pcall(function()
			return SocialService:PromptRsvpToEventAsync(eventId)
		end)
		DebugModule.debugInfo(
			"PromptRsvpToEventAsync returned | eventId="
				.. eventId
				.. " | success="
				.. tostring(success)
				.. " | status="
				.. tostring(rsvpStatus)
				.. " | statusType="
				.. typeof(rsvpStatus),
			"EventBoard"
		)

		if success then
			DebugModule.debugInfo(
				"RSVP status updated | eventId=" .. eventId .. " | status=" .. tostring(rsvpStatus),
				"EventBoard"
			)
			showRsvpNotification(eventId, rsvpStatus)
		elseif not success then
			DebugModule.debugWarn(
				"Failed to prompt event RSVP for " .. eventId .. ": " .. tostring(rsvpStatus),
				"EventBoard"
			)
		else
			DebugModule.debugInfo(
				"RSVP prompt closed without Going status | eventId=" .. eventId .. " | status=" .. tostring(rsvpStatus),
				"EventBoard"
			)
		end

		rsvpInProgress = false

		task.wait(1)
		if isCleanedUp or not isRunning then
			return
		end
		if not registeredBoards[boardState.model] then
			return
		end
		refreshCurrentEvent(true)
	end))
end

local function unregisterBoard(boardModel: Model)
	if unregisteringBoards[boardModel] then
		return
	end
	unregisteringBoards[boardModel] = true

	pendingBoards[boardModel] = nil
	registeredBoards[boardModel] = nil

	local boardMaid = boardMaids[boardModel]
	if boardMaid then
		boardMaids[boardModel] = nil
		boardMaid:DoCleaning()
	end

	for index = #eventBoards, 1, -1 do
		if eventBoards[index].model == boardModel then
			table.remove(eventBoards, index)
			break
		end
	end

	unregisteringBoards[boardModel] = nil
end

local function refreshBoardVisualReferences(boardState: EventBoardGuiState)
	local billboardGui = boardState.model:FindFirstChild("BillboardGui", true)
	local eventLabel = if billboardGui then billboardGui:FindFirstChild("EventLabel", true) else nil
	local countdownLabel = if billboardGui then billboardGui:FindFirstChild("CountdownLabel", true) else nil
	local thumbnail = boardState.model:FindFirstChild("Thumbnail", true)
	local surfaceGui = if thumbnail then thumbnail:FindFirstChild("SurfaceGui", true) else nil
	local imageLabel = if surfaceGui then surfaceGui:FindFirstChild("ImageLabel", true) else nil

	boardState.eventLabel = if eventLabel and eventLabel:IsA("TextLabel") then eventLabel else nil
	boardState.countdownLabel = if countdownLabel and countdownLabel:IsA("TextLabel") then countdownLabel else nil
	boardState.imageLabel = if imageLabel and imageLabel:IsA("ImageLabel") then imageLabel else nil
end

local function connectBoardTouch(boardState: EventBoardGuiState, touchPart: BasePart, boardMaid: any)
	if boardState.touchConnected then
		return
	end

	boardState.touchPart = touchPart
	boardState.touchConnected = true
	boardMaid:GiveTask(touchPart.Touched:Connect(function(hit)
		if not hit:IsA("BasePart") then
			return
		end

		if not isLocalPlayerTouch(hit) then
			return
		end

		if not getCharacterRootPart() then
			return
		end

		promptSelectedEvent(boardState)
	end))

	-- Prefer the authored prompt. Keep the legacy lookup for already-streamed copies.
	local existingPrompt = touchPart:FindFirstChild(EVENT_RSVP_PROMPT_NAME)
		or touchPart:FindFirstChild(LEGACY_EVENT_RSVP_PROMPT_NAME)
	local rsvpPrompt = if existingPrompt and existingPrompt:IsA("ProximityPrompt") then existingPrompt else nil
	local promptSource = if existingPrompt then existingPrompt:GetFullName() else "runtime-created"
	if not rsvpPrompt then
		rsvpPrompt = Instance.new("ProximityPrompt")
		rsvpPrompt.Name = EVENT_RSVP_PROMPT_NAME
		rsvpPrompt.ActionText = "NOTIFY ME"
		rsvpPrompt.ObjectText = "UPCOMING EVENT"
		rsvpPrompt.HoldDuration = 0
		rsvpPrompt.MaxActivationDistance = 14
		rsvpPrompt.RequiresLineOfSight = false
		rsvpPrompt.Parent = touchPart
		boardMaid:GiveTask(rsvpPrompt)
	end
	boardState.rsvpPrompt = rsvpPrompt
	rsvpPrompt.Enabled = true
	DebugModule.debugInfo(
		"RSVP prompt bound | source="
			.. promptSource
			.. " | resolved="
			.. rsvpPrompt:GetFullName()
			.. " | enabled="
			.. tostring(rsvpPrompt.Enabled)
			.. " | maxDistance="
			.. tostring(rsvpPrompt.MaxActivationDistance)
			.. " | actionText="
			.. rsvpPrompt.ActionText
			.. " | objectText="
			.. rsvpPrompt.ObjectText,
		"EventBoard"
	)
	boardMaid:GiveTask(rsvpPrompt.PromptShown:Connect(function(inputType: Enum.ProximityPromptInputType)
		DebugModule.debugInfo(
			"RSVP prompt shown | inputType=" .. tostring(inputType) .. " | eventId=" .. getEventId(selectedEvent),
			"EventBoard"
		)
	end))
	boardMaid:GiveTask(rsvpPrompt.PromptHidden:Connect(function()
		DebugModule.debugInfo("RSVP prompt hidden | path=" .. rsvpPrompt:GetFullName(), "EventBoard")
	end))
	boardMaid:GiveTask(rsvpPrompt.Triggered:Connect(function()
		-- This is a LocalScript, so the prompt event is already local to this client.
		-- Do not reject the trigger when a runtime omits the Player argument.
		DebugModule.debugInfo(
			"RSVP prompt triggered | path=" .. rsvpPrompt:GetFullName() .. " | eventId=" .. getEventId(selectedEvent),
			"EventBoard"
		)
		promptSelectedEvent(boardState)
	end))
end

local function findBoardInteractionPart(boardModel: Model): BasePart?
	for _, name in ipairs({ "TouchPart", "InteractionPart", "Thumbnail" }) do
		local candidate = boardModel:FindFirstChild(name, true)
		if candidate and candidate:IsA("BasePart") then
			return candidate
		end
	end

	if boardModel.PrimaryPart then
		return boardModel.PrimaryPart
	end

	return nil
end

local function createBoardState(boardModel: Model): EventBoardGuiState?
	local billboardGui = boardModel:FindFirstChild("BillboardGui", true)
	if not billboardGui then
		return nil
	end

	local validTouchPart = findBoardInteractionPart(boardModel)

	local boardState: EventBoardGuiState = {
		model = boardModel,
		touchPart = validTouchPart,
		touchConnected = false,
		eventLabel = nil,
		countdownLabel = nil,
		imageLabel = nil,
		rsvpPrompt = nil,
		lastTouchTime = 0,
		lastAppliedImageContent = nil,
	}
	refreshBoardVisualReferences(boardState)

	return boardState
end

local function registerBoard(boardModel: Model)
	if registeredBoards[boardModel] then
		return
	end

	local boardMaid = Maid.new()
	local boardState = createBoardState(boardModel)
	if not boardState then
		boardMaid:DoCleaning()
		pendingBoards[boardModel] = true
		DebugModule.debugWarn(
			"Board registration deferred | path="
				.. boardModel:GetFullName()
				.. " | billboardGui="
				.. tostring(boardModel:FindFirstChild("BillboardGui", true) ~= nil)
				.. " | touchPart="
				.. tostring(boardModel:FindFirstChild("TouchPart", true) ~= nil),
			"EventBoard"
		)
		return
	end

	boardMaids[boardModel] = boardMaid
	boardMaid:GiveTask(boardModel.Destroying:Connect(function()
		unregisterBoard(boardModel)
	end))
	boardMaid:GiveTask(boardModel.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			unregisterBoard(boardModel)
		end
	end))
	if boardState.touchPart then
		connectBoardTouch(boardState, boardState.touchPart, boardMaid)
	end
	boardMaid:GiveTask(boardModel.DescendantAdded:Connect(function(descendant)
		if boardState.touchPart == nil and descendant.Name == "TouchPart" and descendant:IsA("BasePart") then
			connectBoardTouch(boardState, descendant, boardMaid)
		end
		if
			boardState.touchPart == nil
			and (descendant.Name == "InteractionPart" or descendant.Name == "Thumbnail")
			and descendant:IsA("BasePart")
		then
			connectBoardTouch(boardState, descendant, boardMaid)
		end

		refreshBoardVisualReferences(boardState)
		applyBoardState(boardState)
	end))

	registeredBoards[boardModel] = true
	pendingBoards[boardModel] = nil
	table.insert(eventBoards, boardState)
	DebugModule.debugInfo(
		"Registered board | count="
			.. tostring(#eventBoards)
			.. " | eventLabel="
			.. tostring(boardState.eventLabel ~= nil)
			.. " | countdownLabel="
			.. tostring(boardState.countdownLabel ~= nil),
		"EventBoard"
	)
	applyBoardState(boardState)
end

local function findAncestorEventBoard(descendant: Instance): Model?
	local ancestorBoard = descendant:FindFirstAncestorWhichIsA("Model")
	while ancestorBoard do
		if string.lower(ancestorBoard.Name) == "eventboard" then
			return ancestorBoard
		end
		ancestorBoard = ancestorBoard.Parent and ancestorBoard.Parent:FindFirstAncestorWhichIsA("Model") or nil
	end

	return nil
end

local function scanForBoards()
	local worlds = Workspace:FindFirstChild("Worlds")
	if not worlds then
		DebugModule.debugWarn("Board scan skipped: Workspace.Worlds is missing", "EventBoard")
		return
	end

	local candidateCount = 0
	local guiCandidateCount = 0
	for _, descendant in ipairs(worlds:GetDescendants()) do
		if string.lower(descendant.Name) == "eventboard" and descendant:IsA("Model") then
			candidateCount += 1
			DebugModule.debugWarn("Board candidate found | path=" .. descendant:GetFullName(), "EventBoard")
			registerBoard(descendant)
		elseif string.lower(descendant.Name) == "eventboard" then
			DebugModule.debugWarn(
				"Board candidate has unsupported class | class="
					.. descendant.ClassName
					.. " | path="
					.. descendant:GetFullName(),
				"EventBoard"
			)
		end

		if descendant:IsA("BillboardGui") then
			local eventLabel = descendant:FindFirstChild("EventLabel", true)
			local countdownLabel = descendant:FindFirstChild("CountdownLabel", true)
			if eventLabel or countdownLabel then
				guiCandidateCount += 1
				DebugModule.debugWarn(
					"Board GUI candidate found | path="
						.. descendant:GetFullName()
						.. " | eventLabel="
						.. tostring(eventLabel ~= nil)
						.. " | countdownLabel="
						.. tostring(countdownLabel ~= nil),
					"EventBoard"
				)
			end
		end
	end

	DebugModule.debugWarn(
		"Board scan complete | candidates="
			.. tostring(candidateCount)
			.. " | guiCandidates="
			.. tostring(guiCandidateCount)
			.. " | registered="
			.. tostring(#eventBoards),
		"EventBoard"
	)
end

local function scheduleBoardStartupScan()
	scriptMaid:GiveSpawnTask(task.spawn(function()
		for attempt = 1, BOARD_STARTUP_RETRY_COUNT do
			if isCleanedUp or not isRunning then
				return
			end

			if #eventBoards > 0 then
				return
			end

			task.wait(BOARD_STARTUP_RETRY_INTERVAL)
			if isCleanedUp or not isRunning then
				return
			end

			DebugModule.debugInfo("Board startup rescan | attempt=" .. tostring(attempt), "EventBoard")
			scanForBoards()
		end
	end))
end

scanForBoards()
DebugModule.debugInfo(
	"EventBoard runtime | placeId="
		.. tostring(game.PlaceId)
		.. " | universeId="
		.. tostring(game.GameId)
		.. " | configuredEventId="
		.. getConfiguredEventId(),
	"EventBoard"
)
refreshCurrentEvent(true)
scheduleForcedEventRefresh(0.5)
scheduleForcedEventRefresh(2)
scheduleForcedEventRefresh(5)
scheduleForcedEventRefresh(10)

scriptMaid:GiveTask(Workspace.DescendantAdded:Connect(function(descendant)
	if descendant.Name == "Worlds" or descendant.Name == "World1" then
		scanForBoards()
	end

	if string.lower(descendant.Name) == "eventboard" and descendant:IsA("Model") then
		DebugModule.debugWarn("Board candidate streamed | path=" .. descendant:GetFullName(), "EventBoard")
		registerBoard(descendant)
		refreshCurrentEvent(true)
		return
	elseif string.lower(descendant.Name) == "eventboard" then
		DebugModule.debugWarn(
			"Board candidate streamed with unsupported class | class="
				.. descendant.ClassName
				.. " | path="
				.. descendant:GetFullName(),
			"EventBoard"
		)
	end

	local ancestorBoard = findAncestorEventBoard(descendant)
	if ancestorBoard and pendingBoards[ancestorBoard] then
		registerBoard(ancestorBoard)
		refreshCurrentEvent(true)
	end
end))

scheduleBoardStartupScan()

scriptMaid:GiveTask(Workspace.DescendantRemoving:Connect(function(descendant)
	if descendant:IsA("Model") and string.lower(descendant.Name) == "eventboard" then
		unregisterBoard(descendant)
	end
end))

scriptMaid:GiveTask(task.spawn(function()
	while isRunning and script.Parent ~= nil do
		refreshCurrentEvent(false)
		task.wait(1)
	end
end))

local function cleanupScript()
	if isCleanedUp then
		return
	end

	isCleanedUp = true
	isRunning = false

	for boardModel in pairs(boardMaids) do
		unregisterBoard(boardModel)
	end

	table.clear(eventBoards)
	table.clear(registeredBoards)
	table.clear(pendingBoards)
	table.clear(unregisteringBoards)

	scriptMaid:DoCleaning()
end

scriptMaid:GiveTask(script.Destroying:Connect(cleanupScript))
scriptMaid:GiveTask(script.AncestryChanged:Connect(function(_, parent)
	if parent == nil then
		cleanupScript()
	end
end))
]]></string>
        </Properties>
      </Item>
