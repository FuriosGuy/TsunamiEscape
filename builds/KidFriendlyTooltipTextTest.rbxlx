        <Item class="ModuleScript" referent="3528">
          <Properties>
            <string name="Name">PlayerHandler_Client</string>
            <string name="Source"><![CDATA[--!strict

-- Client-safe read-only player helpers. Rewards and attribute mutations stay server-side.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local SharedFolder = ReplicatedStorage.Modules:WaitForChild("Shared")
local PlayerDataConfig = require(SharedFolder:WaitForChild("PlayerDataConfig"))

local PlayerHandler: { [string]: any } = {}
PlayerHandler.DEFAULT_ATTRIBUTES = PlayerDataConfig.DEFAULT_ATTRIBUTES
PlayerHandler.FRIEND_INVITE_MULTIPLIER_STEP = PlayerDataConfig.FRIEND_INVITE_MULTIPLIER_STEP
PlayerHandler.TRAIL_ORDER = PlayerDataConfig.TRAIL_ORDER
PlayerHandler.TRAIL_CONFIGS = PlayerDataConfig.TRAIL_CONFIGS
PlayerHandler.MOVEMENT_CONFIG = PlayerDataConfig.MOVEMENT_CONFIG

local DEFAULT_PLAYER_SPEED = PlayerDataConfig.DEFAULT_PLAYER_SPEED
local DEFAULT_MAX_PLAYER_SPEED = PlayerDataConfig.DEFAULT_MAX_PLAYER_SPEED
local PREMIUM_MULTIPLIER = if typeof(PlayerDataConfig.PREMIUM_MULTIPLIER) == "number"
	then math.max(1, PlayerDataConfig.PREMIUM_MULTIPLIER)
	else 1.25

local function getNumericAttribute(player: Player, attributeName: string, fallback: number): number
	local value = player:GetAttribute(attributeName)
	if typeof(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge then
		return value
	end

	return fallback
end

local function getPremiumMultiplier(player: Player): number
	return if player.MembershipType == Enum.MembershipType.Premium then PREMIUM_MULTIPLIER else 1
end

local function combineWinMultipliers(winMultiplier: number, premiumMultiplier: number): number
	return 1 + math.max(0, winMultiplier - 1) + math.max(0, premiumMultiplier - 1)
end

local function parseOwned(value: any): { [string]: boolean }
	local owned: { [string]: boolean } = {}
	if typeof(value) ~= "string" or value == "" then
		return owned
	end

	for token in string.gmatch(value, "([^,]+)") do
		if token ~= "" then
			owned[token] = true
		end
	end

	return owned
end

function PlayerHandler.GetOwnedKarts(player: Player): { [string]: boolean }
	return parseOwned(player:GetAttribute("OwnedKarts"))
end

function PlayerHandler.GetOwnedTrails(player: Player): { [string]: boolean }
	return parseOwned(player:GetAttribute("OwnedTrails"))
end

function PlayerHandler.OwnsKart(player: Player, kartName: string): boolean
	return PlayerHandler.GetOwnedKarts(player)[kartName] == true
end

function PlayerHandler.OwnsTrail(player: Player, trailName: string): boolean
	return PlayerHandler.GetOwnedTrails(player)[trailName] == true
end

function PlayerHandler.GetTrailConfig(trailName: string): { [string]: any }?
	return PlayerHandler.TRAIL_CONFIGS[trailName]
end

function PlayerHandler.GetEffectiveMaxPlayerSpeed(player: Player): number
	local maxSpeed = math.max(0, getNumericAttribute(player, "Max_Player_Speed", DEFAULT_MAX_PLAYER_SPEED))
	local eventMultiplier = math.max(0, getNumericAttribute(player, "LiveEvent_WalkSpeedMultiplier", 1))
	return maxSpeed * eventMultiplier
end

function PlayerHandler.GetEffectiveWalkSpeed(player: Player): number
	local playerSpeed = math.max(0, getNumericAttribute(player, "Player_Speed", DEFAULT_PLAYER_SPEED))
	local maxSpeed = math.max(0, getNumericAttribute(player, "Max_Player_Speed", DEFAULT_MAX_PLAYER_SPEED))
	local eventMultiplier = math.max(0, getNumericAttribute(player, "LiveEvent_WalkSpeedMultiplier", 1))
	return math.min(playerSpeed, maxSpeed) * eventMultiplier
end

function PlayerHandler.GetMovementInterval(player: Player?): number
	local minInterval = 0.2
	local maxInterval = 5
	if player then
		local value = player:GetAttribute("Movement_XPGainInterval")
		if typeof(value) == "number" then
			return math.clamp(value, minInterval, maxInterval)
		end
	end

	return math.clamp(PlayerHandler.MOVEMENT_CONFIG.XP_GAIN_INTERVAL, minInterval, maxInterval)
end

local function getStandardXPSpeedMultiplier(player: Player): number
	return getNumericAttribute(player, "Rebirth_XPMultiplier", 1)
		* getNumericAttribute(player, "DevProduct_XPSpeedMultiplier", 1)
		* getNumericAttribute(player, "Misc_XPSpeedMultiplier", 1)
		* getNumericAttribute(player, "Friend_XPMultiplier", 1)
		* getNumericAttribute(player, "Treadmill_XPMultiplier", 1)
end

function PlayerHandler.CalculateRewardXPSpeed(player: Player, amount: number): number
	return amount * getStandardXPSpeedMultiplier(player)
end

function PlayerHandler.CalculateDailyWinsAward(player: Player, amount: number): number
	local rebirthMultiplier = getNumericAttribute(player, "Rebirth_XPMultiplier", 1)
	local winMultiplier = getNumericAttribute(player, "WinMultiplier", 1)
	local combinedMultiplier = rebirthMultiplier * winMultiplier
	local dailyMultiplier = 1 + math.max(0, combinedMultiplier - 1) * 0.5
	return math.max(0, math.round(amount * dailyMultiplier))
end

function PlayerHandler.CalculatePlaytimeWinsAward(player: Player, amount: number): number
	local rebirthMultiplier = getNumericAttribute(player, "Rebirth_XPMultiplier", 1)
	local winMultiplier = getNumericAttribute(player, "WinMultiplier", 1)
	local miscMultiplier = getNumericAttribute(player, "Misc_XPSpeedMultiplier", 1)
	local devMultiplier = getNumericAttribute(player, "DevProduct_XPSpeedMultiplier", 1)
	local reducedDevMultiplier = 1 + math.max(0, devMultiplier - 1) * 0.1
	local combinedWinMultiplier = combineWinMultipliers(winMultiplier, getPremiumMultiplier(player))
	return math.max(0, math.round(amount * rebirthMultiplier * combinedWinMultiplier * miscMultiplier * reducedDevMultiplier))
end

function PlayerHandler.GetNextRebirthStats(player: Player): { NextMaxLevel: number, NextMultiplier: number }
	local maxLevel = getNumericAttribute(player, "MaxLevel", 25)
	local multiplier = getNumericAttribute(player, "Rebirth_XPMultiplier", 1)
	local rebirthConfig = PlayerHandler.MOVEMENT_CONFIG.REBIRTH_CONFIG

	return {
		NextMaxLevel = maxLevel + rebirthConfig.MAX_LEVEL_INCREMENT,
		NextMultiplier = multiplier + rebirthConfig.MULTIPLIER_INCREMENT,
	}
end

function PlayerHandler.UpdateVIPRoomCollision(player: Player?)
	if not player then
		return
	end

	local worldsFolder = Workspace:FindFirstChild("Worlds")
	local world1 = worldsFolder and worldsFolder:FindFirstChild("World1")
	local vipRooms = world1 and world1:FindFirstChild("VIPRooms")
	if not vipRooms then
		return
	end

	local hasVIPPass = player:GetAttribute("HasVIPPass") == true
	for _, descendant in ipairs(vipRooms:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Name == "VIPDoor" then
			descendant.CanCollide = not hasVIPPass
		end
	end
end

return PlayerHandler
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3529">
          <Properties>
            <string name="Name">PlaytimeRewardsConfig</string>
            <string name="Source"><![CDATA[export type RewardKind = "Level" | "XPSpeed" | "Wins" | "Rebirth"

export type RewardGrant = {
	kind: RewardKind,
	amount: number,
}

export type RewardTier = {
	id: string,
	unlockSeconds: number,
	rewards: { RewardGrant },
}

local PlaytimeRewardsConfig = {}

PlaytimeRewardsConfig.TOTAL_DURATION_SECONDS = 60 * 60
PlaytimeRewardsConfig.TIER_COUNT = 12
PlaytimeRewardsConfig.PLACEHOLDER_ICON_IMAGE = "rbxassetid://70776298167875"
PlaytimeRewardsConfig.ICON_IMAGE_BY_KIND = table.freeze({
	XPSpeed = "rbxassetid://113466904095935", -- Gift icon XP
	Wins = "rbxassetid://102626472172663", -- Gift icon Wins
	Level = "rbxassetid://113342943009305", -- Gift icon Levels
	Rebirth = "rbxassetid://102895420789840", -- Gift icon Rebirth
})
PlaytimeRewardsConfig.ICON_IMAGE_BY_TIER_ID = table.freeze({
	Gift12 = "rbxassetid://102895420789840", -- Final mixed-reward gift (purple)
})
PlaytimeRewardsConfig.CLAIMED_ICON_IMAGE_BY_KIND = table.freeze({
	XPSpeed = "rbxassetid://125552789489073",
	Wins = "rbxassetid://104709782370430",
	Level = "rbxassetid://106046877471425",
	Rebirth = "rbxassetid://138330067069857",
})
PlaytimeRewardsConfig.CLAIMED_ICON_IMAGE_BY_TIER_ID = table.freeze({
	Gift12 = "rbxassetid://76077537030305", -- Final mixed reward claimed icon
})

local REWARD_TIERS: { RewardTier } = {
	{
		id = "Gift01",
		unlockSeconds = 3 * 60,
		rewards = { { kind = "XPSpeed", amount = 5000 } },
	},
	{
		id = "Gift02",
		unlockSeconds = 5 * 60,
		rewards = { { kind = "Wins", amount = 25 } },
	},
	{
		id = "Gift03",
		unlockSeconds = 10 * 60,
		rewards = { { kind = "Level", amount = 1 } },
	},
	{
		id = "Gift04",
		unlockSeconds = 15 * 60,
		rewards = { { kind = "XPSpeed", amount = 15000 } },
	},
	{
		id = "Gift05",
		unlockSeconds = 20 * 60,
		rewards = { { kind = "Wins", amount = 100 } },
	},
	{
		id = "Gift06",
		unlockSeconds = 25 * 60,
		rewards = { { kind = "Level", amount = 3 } },
	},
	{
		id = "Gift07",
		unlockSeconds = 30 * 60,
		rewards = { { kind = "XPSpeed", amount = 30000 } },
	},
	{
		id = "Gift08",
		unlockSeconds = 35 * 60,
		rewards = { { kind = "Wins", amount = 250 } },
	},
	{
		id = "Gift09",
		unlockSeconds = 40 * 60,
		rewards = { { kind = "Level", amount = 5 } },
	},
	{
		id = "Gift10",
		unlockSeconds = 45 * 60,
		rewards = { { kind = "XPSpeed", amount = 60000 } },
	},
	{
		id = "Gift11",
		unlockSeconds = 50 * 60,
		rewards = { { kind = "Wins", amount = 500 } },
	},
	{
		id = "Gift12",
		unlockSeconds = 60 * 60,
		rewards = {
			{ kind = "XPSpeed", amount = 100000 },
			{ kind = "Wins", amount = 1000 },
			{ kind = "Level", amount = 5 },
		},
	},
}

local tierById: { [string]: RewardTier } = {}

local function validateTiers()
	assert(#REWARD_TIERS == PlaytimeRewardsConfig.TIER_COUNT, "Playtime tier count mismatch")

	local lastUnlock = 0
	for _, tier in ipairs(REWARD_TIERS) do
		assert(tier.id ~= "", "Playtime reward tier id is required")
		assert(tier.unlockSeconds > lastUnlock, "Playtime reward tiers must be strictly increasing by time")
		assert(#tier.rewards > 0, "Each playtime tier must contain at least one reward")

		for _, reward in ipairs(tier.rewards) do
			assert(reward.amount > 0, "Reward amount must be positive")
			if reward.kind == "Level" then
				assert(reward.amount <= 5, "Level reward amount must be <= 5 per tier")
			end
		end

		tierById[tier.id] = tier
		lastUnlock = tier.unlockSeconds
	end

	assert(
		REWARD_TIERS[#REWARD_TIERS].unlockSeconds == PlaytimeRewardsConfig.TOTAL_DURATION_SECONDS,
		"Final playtime tier must land on total duration"
	)
end

validateTiers()

PlaytimeRewardsConfig.TIERS = table.freeze(REWARD_TIERS)

function PlaytimeRewardsConfig.GetTier(index: number): RewardTier?
	return PlaytimeRewardsConfig.TIERS[index]
end

function PlaytimeRewardsConfig.GetTierById(tierId: string): RewardTier?
	return tierById[tierId]
end

function PlaytimeRewardsConfig.GetIconForRewardKind(kind: RewardKind): string
	local iconByKind = PlaytimeRewardsConfig.ICON_IMAGE_BY_KIND
	local icon = iconByKind[kind]
	if typeof(icon) == "string" and icon ~= "" then
		return icon
	end
	return PlaytimeRewardsConfig.PLACEHOLDER_ICON_IMAGE
end

function PlaytimeRewardsConfig.GetIconForTier(tierId: string, fallbackKind: RewardKind): string
	local tierIcon = PlaytimeRewardsConfig.ICON_IMAGE_BY_TIER_ID[tierId]
	if typeof(tierIcon) == "string" and tierIcon ~= "" then
		return tierIcon
	end

	return PlaytimeRewardsConfig.GetIconForRewardKind(fallbackKind)
end

function PlaytimeRewardsConfig.GetClaimedIconForRewardKind(kind: RewardKind): string
	local iconByKind = PlaytimeRewardsConfig.CLAIMED_ICON_IMAGE_BY_KIND
	local icon = iconByKind[kind]
	if typeof(icon) == "string" and icon ~= "" then
		return icon
	end
	return PlaytimeRewardsConfig.PLACEHOLDER_ICON_IMAGE
end

function PlaytimeRewardsConfig.GetClaimedIconForTier(tierId: string, fallbackKind: RewardKind): string
	local tierIcon = PlaytimeRewardsConfig.CLAIMED_ICON_IMAGE_BY_TIER_ID[tierId]
	if typeof(tierIcon) == "string" and tierIcon ~= "" then
		return tierIcon
	end

	return PlaytimeRewardsConfig.GetClaimedIconForRewardKind(fallbackKind)
end

function PlaytimeRewardsConfig.GetNextTierIndex(elapsedSeconds: number): number?
	for index, tier in ipairs(PlaytimeRewardsConfig.TIERS) do
		if elapsedSeconds < tier.unlockSeconds then
			return index
		end
	end

	return nil
end

function PlaytimeRewardsConfig.GetClaimableTierCount(elapsedSeconds: number): number
	local count = 0
	for _, tier in ipairs(PlaytimeRewardsConfig.TIERS) do
		if elapsedSeconds >= tier.unlockSeconds then
			count += 1
		end
	end
	return count
end

return PlaytimeRewardsConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="3530">
