        <Item class="ModuleScript" referent="2491">
          <Properties>
            <string name="Name">MainFunctions</string>
            <string name="Source"><![CDATA[--!strict
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local PlayerHandler = require(ReplicatedStorage.Modules.PlayerHandler)
local VisualFunctions = require(ReplicatedStorage.Modules.UI.VisualFunctions)

local MainFunctions = {}
local FRAME_TOGGLE_DEBOUNCE = 0.15
local MOVEMENT_CHECK_INTERVAL = 0.1
local lastFrameToggleTimes: { [string]: number } = {}
local TROLL_HUD_HIDE_KEYS = {
	"LevelsBarFrame",
	"SpeedMultiFrame",
	"SpeedBuyFrame",
	"RightSideButtonsFrame",
}

local MOVEMENT_KEYS = {
	[Enum.KeyCode.W] = true,
	[Enum.KeyCode.A] = true,
	[Enum.KeyCode.S] = true,
	[Enum.KeyCode.D] = true,
	[Enum.KeyCode.Up] = true,
	[Enum.KeyCode.Down] = true,
	[Enum.KeyCode.Left] = true,
	[Enum.KeyCode.Right] = true,
}

local function setTrollHudVisibility(isVisible: boolean)
	local hud = VisualFunctions.HUD
	for _, hudKey in ipairs(TROLL_HUD_HIDE_KEYS) do
		local guiObject = (hud :: any)[hudKey]
		if guiObject and guiObject:IsA("GuiObject") then
			if isVisible then
				guiObject:SetAttribute("TrollPrevVisible", guiObject.Visible)
				guiObject.Visible = false
			else
				local previousVisible = guiObject:GetAttribute("TrollPrevVisible")
				if typeof(previousVisible) == "boolean" then
					guiObject.Visible = previousVisible
				else
					guiObject.Visible = true
				end
				guiObject:SetAttribute("TrollPrevVisible", nil)
			end
		end
	end
end

function MainFunctions.SetFrameVisibleSimple(frameName: string, isVisible: boolean)
	local targetFrame = VisualFunctions.ActiveFrameGroup[frameName]
	if not targetFrame then
		return
	end

	targetFrame.Visible = isVisible
	targetFrame.Interactable = isVisible

	if frameName == "TrollFrame" then
		setTrollHudVisibility(isVisible)
	end
end

--[[
	Closes all managed frames except the one provided.
]]
function MainFunctions.CloseOtherFrames(except: Frame?)
	local frames = VisualFunctions.ActiveFrameGroup
	if not frames then
		return
	end

	local closeTasks = {}
	for _, frame in pairs(frames) do
		if frame and frame ~= except and frame.Visible then
			if frame.Name == "TrollFrame" then
				MainFunctions.SetFrameVisibleSimple("TrollFrame", false)
			else
				table.insert(closeTasks, VisualFunctions.CloseWindow(frame))
			end
		end
	end

	-- Wait for all close animations to finish (Yielding)
	if #closeTasks > 0 then
		for _, task in ipairs(closeTasks) do
			if typeof(task) == "RBXScriptSignal" then
				task:Wait()
			end
		end
	end
end

--[[
	Toggles a specific managed frame.
]]
function MainFunctions.ToggleFrame(frameName: string)
	local targetFrame = VisualFunctions.ActiveFrameGroup[frameName]
	if not targetFrame then
		return
	end

	local now = tick()
	local lastToggleTime = lastFrameToggleTimes[frameName] or 0
	if now - lastToggleTime < FRAME_TOGGLE_DEBOUNCE then
		return
	end
	lastFrameToggleTimes[frameName] = now

	if frameName == "TrollFrame" then
		if targetFrame.Visible then
			MainFunctions.SetFrameVisibleSimple("TrollFrame", false)
		else
			task.spawn(function()
				MainFunctions.CloseOtherFrames(targetFrame)
				MainFunctions.SetFrameVisibleSimple("TrollFrame", true)
			end)
		end
		return
	end

	if targetFrame.Visible then
		VisualFunctions.CloseWindow(targetFrame)
	else
		task.spawn(function()
			MainFunctions.CloseOtherFrames(targetFrame)
			VisualFunctions.OpenWindow(targetFrame)
		end)
	end
end

--[[
	Starts the movement gain detection.
	Fires a RemoteEvent to the server when movement keys are held.
]]
function MainFunctions.StartMovementDetection(humanoid: Humanoid): () -> ()
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		return function() end
	end

	local MovementAction = remotes:FindFirstChild("MovementAction") :: RemoteEvent
	if not MovementAction then
		return function() end
	end

	local player = Players.LocalPlayer
	local stopped = false
	local lastMovementSignal = 0
	local lastMovementCheck = 0
	local movementConnection = RunService.Heartbeat:Connect(function()
		local now = tick()
		if stopped then
			return
		end
		if player:GetAttribute("SpinWheelModalOpen") == true then
			return
		end

		if now - lastMovementCheck < MOVEMENT_CHECK_INTERVAL then
			return
		end
		lastMovementCheck = now

		local interval = PlayerHandler.GetMovementInterval(player)
		if not interval then
			interval = 0.25
		end

		if now - lastMovementSignal < interval then
			return
		end

		if not humanoid or humanoid.Parent == nil or humanoid.Health <= 0 then
			return
		end

		local isMoving = humanoid.MoveDirection.Magnitude > 0.05
		for key in pairs(MOVEMENT_KEYS) do
			if UserInputService:IsKeyDown(key) then
				isMoving = true
				break
			end
		end

		if isMoving then
			lastMovementSignal = now
			MovementAction:FireServer()
		end
	end)

	local function stopMovement()
		if stopped then
			return
		end

		stopped = true
		movementConnection:Disconnect()
	end

	return stopMovement
end

--[[
	Stops the movement gain detection.
]]
function MainFunctions.StopMovementDetection(movementStopper: (() -> ())?)
	if movementStopper then
		movementStopper()
	end
end

return MainFunctions
]]></string>
          </Properties>
        </Item>
        <Item class="Folder" referent="2492">
          <Properties>
            <string name="Name">MainGUI</string>
          </Properties>
          <Item class="ModuleScript" referent="2493">
            <Properties>
              <string name="Name">DailyRewardPromptController</string>
              <string name="Source"><![CDATA[--!strict
local DailyRewardPromptController = {}
DailyRewardPromptController.__index = DailyRewardPromptController

type ControllerOptions = {
	player: Player,
	badgeState: {
		buttonFrame: GuiObject?,
		template: GuiObject?,
		badge: GuiObject?,
		refresh: (() -> ())?,
	},
	updateButtonNotificationBadge: (any, boolean, string, string) -> (),
	getDailyRewardFrame: () -> Frame?,
	closeOtherFrames: (Frame?) -> (),
	openWindow: (Frame) -> (),
}

function DailyRewardPromptController.new(options: ControllerOptions)
	local self = setmetatable({}, DailyRewardPromptController)

	self.player = options.player
	self.badgeState = options.badgeState
	self.updateButtonNotificationBadge = options.updateButtonNotificationBadge
	self.getDailyRewardFrame = options.getDailyRewardFrame
	self.closeOtherFrames = options.closeOtherFrames
	self.openWindow = options.openWindow
	self.isClaimable = false
	self.didAutoOpen = false

	return self
end

function DailyRewardPromptController:RefreshBadge()
	if self.player:GetAttribute("Data_Loaded") ~= true then
		self.updateButtonNotificationBadge(self.badgeState, false, "DailyClaimableNotification", "0")
		return
	end

	self.updateButtonNotificationBadge(
		self.badgeState,
		self.isClaimable,
		"DailyClaimableNotification",
		if self.isClaimable then "1" else "0"
	)
end

function DailyRewardPromptController:TryAutoOpen()
	if self.didAutoOpen then
		return
	end

	if self.player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	if not self.isClaimable then
		return
	end

	if self.player:GetAttribute("TutorialCompleted") ~= true then
		return
	end

	local dailyRewardFrame = self.getDailyRewardFrame()
	if not dailyRewardFrame then
		return
	end

	self.didAutoOpen = true
	task.spawn(function()
		self.closeOtherFrames(dailyRewardFrame)
		if not dailyRewardFrame.Visible then
			self.openWindow(dailyRewardFrame)
		end
	end)
end

function DailyRewardPromptController:HandleClaimableChanged(isClaimable: boolean)
	self.isClaimable = isClaimable
	self:RefreshBadge()
	self:TryAutoOpen()
end

function DailyRewardPromptController:OnTutorialCompletedChanged()
	self:TryAutoOpen()
end

function DailyRewardPromptController:Reset()
	self.badgeState.refresh = nil
	self.isClaimable = false
	self.didAutoOpen = false
	self.updateButtonNotificationBadge(self.badgeState, false, "DailyClaimableNotification", "0")
end

return DailyRewardPromptController
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2494">
            <Properties>
              <string name="Name">DailyRewardsConfig</string>
              <string name="Source"><![CDATA[--!strict

local DailyRewardsConfig = {}

export type RewardKind = "XPSpeed" | "Wins" | "Level" | "Rebirth"

export type DailyRewardDefinition = {
	day: number,
	kind: RewardKind,
	amount: number,
	topColor: Color3,
	bottomColor: Color3,
	image: string,
}

DailyRewardsConfig.DAY_COUNT = 7
DailyRewardsConfig.CLAIM_COOLDOWN_SECONDS = 24 * 60 * 60
DailyRewardsConfig.CYCLE_SCALE_MULTIPLIER = 1.1
DailyRewardsConfig.CURRENT_DAY_ATTRIBUTE = "DailyRewardCurrentDay"
DailyRewardsConfig.NEXT_CLAIM_ATTRIBUTE = "DailyRewardNextClaimUnix"
DailyRewardsConfig.CYCLE_COUNT_ATTRIBUTE = "DailyRewardCycleCount"

local REWARDS: { DailyRewardDefinition } = table.freeze({
	{
		day = 1,
		kind = "XPSpeed",
		amount = 5000,
		topColor = Color3.fromRGB(255, 78, 78),
		bottomColor = Color3.fromRGB(206, 0, 3),
		image = "rbxassetid://125552789489073",
	},
	{
		day = 2,
		kind = "Wins",
		amount = 100,
		topColor = Color3.fromRGB(254, 199, 41),
		bottomColor = Color3.fromRGB(255, 85, 0),
		image = "rbxassetid://104709782370430",
	},
	{
		day = 3,
		kind = "XPSpeed",
		amount = 10000,
		topColor = Color3.fromRGB(255, 78, 78),
		bottomColor = Color3.fromRGB(206, 0, 3),
		image = "rbxassetid://125552789489073",
	},
	{
		day = 4,
		kind = "Wins",
		amount = 250,
		topColor = Color3.fromRGB(254, 199, 41),
		bottomColor = Color3.fromRGB(255, 85, 0),
		image = "rbxassetid://104709782370430",
	},
	{
		day = 5,
		kind = "Level",
		amount = 5,
		topColor = Color3.fromRGB(88, 216, 255),
		bottomColor = Color3.fromRGB(0, 81, 255),
		image = "rbxassetid://106046877471425",
	},
	{
		day = 6,
		kind = "XPSpeed",
		amount = 25000,
		topColor = Color3.fromRGB(255, 78, 78),
		bottomColor = Color3.fromRGB(206, 0, 3),
		image = "rbxassetid://125552789489073",
	},
	{
		day = 7,
		kind = "Rebirth",
		amount = 1,
		topColor = Color3.fromRGB(227, 74, 255),
		bottomColor = Color3.fromRGB(74, 3, 255),
		image = "rbxassetid://138330067069857",
	},
})

DailyRewardsConfig.REWARDS = REWARDS

function DailyRewardsConfig.GetReward(day: number): DailyRewardDefinition?
	return REWARDS[day]
end

function DailyRewardsConfig.GetScaledAmount(reward: DailyRewardDefinition, cycleCount: number): number
	if reward.kind ~= "XPSpeed" and reward.kind ~= "Wins" then
		return reward.amount
	end

	local safeCycleCount = math.max(0, math.floor(cycleCount))
	return math.round(reward.amount * (DailyRewardsConfig.CYCLE_SCALE_MULTIPLIER ^ safeCycleCount))
end

function DailyRewardsConfig.GetRewardLabel(kind: RewardKind, amount: number): string
	if kind == "XPSpeed" then
		return "SPEED"
	end
	if kind == "Wins" then
		return "WINS"
	end
	if kind == "Level" then
		return if amount == 1 then "LEVEL" else "LEVELS"
	end

	return if amount == 1 then "REBIRTH" else "REBIRTHS"
end

return DailyRewardsConfig
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2495">
            <Properties>
              <string name="Name">DailyRewardsUI</string>
              <string name="Source"><![CDATA[--!strict
local MarketplaceService = game:GetService("MarketplaceService")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Maid = require(Modules:WaitForChild("Maid"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local ProductService = require(Modules:WaitForChild("ProductService"))
local PlayerHandler = require(Modules:WaitForChild("PlayerHandler"))
local FunnelAnalytics = require(Modules:WaitForChild("FunnelAnalytics"))
local ConfigFolder = Modules:WaitForChild("Config")
local CoreConfig = require(ConfigFolder:WaitForChild("CoreConfig"))
local UIFolder = Modules:WaitForChild("UI")
local VisualFunctions = require(UIFolder:WaitForChild("VisualFunctions"))
local DailyRewardsConfig = require(script.Parent:WaitForChild("DailyRewardsConfig"))

local DailyRewardsUI = {}
DailyRewardsUI.__index = DailyRewardsUI

local MODULE_NAME = "DailyRewardsUI"
local COUNTDOWN_UPDATE_INTERVAL = 0.2
local DISABLED_CARD_MULTIPLIER = 0.5
local CLAIMABLE_CARD_SCALE = 1.075
local CURRENT_DAY_ATTRIBUTE = DailyRewardsConfig.CURRENT_DAY_ATTRIBUTE
local NEXT_CLAIM_ATTRIBUTE = DailyRewardsConfig.NEXT_CLAIM_ATTRIBUTE
local CYCLE_COUNT_ATTRIBUTE = DailyRewardsConfig.CYCLE_COUNT_ATTRIBUTE
local CLAIM_ALL_PRODUCT_ID = ProductService.DevProducts["ClaimAllDaily"]
local dailyRewardsConfig = if CoreConfig.server and CoreConfig.server.dailyRewards
	then CoreConfig.server.dailyRewards
	else nil
local DEBUG_SEQUENTIAL_CLAIM_MODE = RunService:IsStudio()
	and dailyRewardsConfig
	and typeof(dailyRewardsConfig.debugSequentialClaimMode) == "boolean"
	and dailyRewardsConfig.debugSequentialClaimMode == true

type DailyRewardDefinition = DailyRewardsConfig.DailyRewardDefinition

type ControllerOptions = {
	player: Player,
	root: Instance,
	onClaimableChanged: ((boolean) -> ())?,
}

type RewardEntry = {
	day: number,
	root: Frame,
	rewardAmountLabel: TextLabel,
	rewardTypeImage: ImageLabel,
	dayCounterLabel: TextLabel?,
	gradient: UIGradient,
	uiscale: UIScale,
	lastStyleKey: string?,
}

local function cacheOriginalColorAttributes(target: Instance)
	local targetProps = {}

	if target:IsA("Frame") or target:IsA("ScrollingFrame") then
		table.insert(targetProps, "BackgroundColor3")
	elseif target:IsA("TextLabel") then
		table.insert(targetProps, "TextColor3")
		table.insert(targetProps, "BackgroundColor3")
	elseif target:IsA("TextButton") or target:IsA("TextBox") then
		table.insert(targetProps, "BackgroundColor3")
		table.insert(targetProps, "TextColor3")
	elseif target:IsA("ImageLabel") then
		table.insert(targetProps, "ImageColor3")
		table.insert(targetProps, "BackgroundColor3")
	elseif target:IsA("ImageButton") then
		table.insert(targetProps, "BackgroundColor3")
		table.insert(targetProps, "ImageColor3")
	elseif target:IsA("UIStroke") then
		table.insert(targetProps, "Color")
	end

	for _, targetProp in ipairs(targetProps) do
		local attributeName = "OriginalColor_" .. targetProp
		if target:GetAttribute(attributeName) == nil then
			target:SetAttribute(attributeName, (target :: any)[targetProp])
		end
	end
end

local function cacheEntryOriginalColors(root: Frame)
	if root:GetAttribute("OriginalDisabledBaseColor") == nil then
		root:SetAttribute("OriginalDisabledBaseColor", root.BackgroundColor3)
	end

	cacheOriginalColorAttributes(root)
	for _, descendant in ipairs(root:GetDescendants()) do
		cacheOriginalColorAttributes(descendant)
	end
end

local function formatRewardNumber(value: number): string
	return VisualFunctions.FormatNumber(value)
end

local function formatClockDuration(totalSeconds: number): string
	local clamped = math.max(0, math.floor(totalSeconds))
	local hours = math.floor(clamped / 3600)
	local minutes = math.floor((clamped % 3600) / 60)
	local seconds = clamped % 60
	return string.format("%02d:%02d:%02d", hours, minutes, seconds)
end

local function sanitizeCurrentDay(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 1
	end

	return math.clamp(math.floor(rawValue), 1, DailyRewardsConfig.DAY_COUNT)
end

local function sanitizeCycleCount(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 0
	end

	return math.max(0, math.floor(rawValue))
end

local function sanitizeNextClaimUnix(rawValue: any): number
	if typeof(rawValue) ~= "number" then
		return 0
	end

	return math.max(0, math.floor(rawValue))
end

local function getRewardPreviewAmount(player: Player, reward: DailyRewardDefinition, cycleCount: number): number
	local scaledAmount = DailyRewardsConfig.GetScaledAmount(reward, cycleCount)

	if reward.kind == "XPSpeed" then
		return math.round(PlayerHandler.CalculateAwardedXPSpeed(player, scaledAmount))
	end

	if reward.kind == "Wins" then
		return PlayerHandler.CalculateDailyWinsAward(player, scaledAmount)
	end

	return scaledAmount
end

local function getRewardAmountText(player: Player, reward: DailyRewardDefinition, cycleCount: number): string
	local previewAmount = getRewardPreviewAmount(player, reward, cycleCount)
	return string.format(
		"%s %s",
		formatRewardNumber(previewAmount),
		DailyRewardsConfig.GetRewardLabel(reward.kind, previewAmount)
	)
end

local function getIconLabel(dayFrame: Frame): ImageLabel?
	local rewardType = dayFrame:FindFirstChild("RewardType")
	if rewardType and rewardType:IsA("ImageLabel") then
		return rewardType
	end

	local kartType = dayFrame:FindFirstChild("KartType")
	if kartType and kartType:IsA("ImageLabel") then
		return kartType
	end

	return dayFrame:FindFirstChildWhichIsA("ImageLabel")
end

local function getOrCreateGradient(dayFrame: Frame): UIGradient
	local existingGradient = dayFrame:FindFirstChildOfClass("UIGradient")
	if existingGradient then
		return existingGradient
	end

	local gradient = Instance.new("UIGradient")
	gradient.Rotation = 90
	gradient.Parent = dayFrame
	return gradient
end

local function getOrCreateUIScale(dayFrame: Frame): UIScale
	local existingScale = dayFrame:FindFirstChildOfClass("UIScale")
	if existingScale then
		return existingScale
	end

	local uiScale = Instance.new("UIScale")
	uiScale.Scale = 1
	uiScale.Parent = dayFrame
	return uiScale
end

function DailyRewardsUI.new(options: ControllerOptions)
	local self = setmetatable({}, DailyRewardsUI)

	self.player = options.player
	self.root = options.root
	self.maid = Maid.new()
	self.buttonMaid = Maid.new()
	self.entries = {} :: { [number]: RewardEntry }
	self.destroyed = false
	self.updateAccumulator = 0
	self.lastClaimButtonClaimable = nil :: boolean?
	self.lastClaimableState = nil :: boolean?
	self.onClaimableChanged = if typeof(options.onClaimableChanged) == "function"
		then options.onClaimableChanged
		else nil
	self.dailyRewardAction = ReplicatedStorage:WaitForChild("Remotes"):WaitForChild("DailyRewardAction") :: RemoteEvent
	self.frame = nil :: Frame?
	self.claimDailyButton = nil :: TextButton?
	self.claimDailyButtonFrame = nil :: Frame?
	self.claimAllButton = nil :: TextButton?
	self.claimAllButtonFrame = nil :: Frame?
	self.claimAllPriceLabel = nil :: TextLabel?
	self.dailyCountdownLabel = nil :: TextLabel?

	self:Rebuild()
	self:Bind()
	self:Refresh()

	return self
end

function DailyRewardsUI:FindDailyRewardFrame(): Frame?
	local frame = self.root:FindFirstChild("DailyRewardFrame", true)
	if frame and frame:IsA("Frame") then
		return frame
	end

	return nil
end

function DailyRewardsUI:Rebuild()
	table.clear(self.entries)
	self.buttonMaid:DoCleaning()

	self.frame = self:FindDailyRewardFrame()
	if not self.frame then
		return
	end

	local bodyFrame = self.frame:FindFirstChild("BodyFrame")
	if not bodyFrame or not bodyFrame:IsA("Frame") then
		return
	end

	self.dailyCountdownLabel = bodyFrame:FindFirstChild("DailyCountdown") :: TextLabel?
	self.claimDailyButtonFrame = self.frame:FindFirstChild("ClaimDailyButton") :: Frame?
	self.claimAllButtonFrame = self.frame:FindFirstChild("ClaimAllDailyButton") :: Frame?
	self.claimDailyButton = self.claimDailyButtonFrame
			and self.claimDailyButtonFrame:FindFirstChildWhichIsA("TextButton", true)
		or nil
	self.claimAllButton = self.claimAllButtonFrame
			and self.claimAllButtonFrame:FindFirstChildWhichIsA("TextButton", true)
		or nil
	self.claimAllPriceLabel = self.claimAllButtonFrame
			and self.claimAllButtonFrame:FindFirstChild("PriceLabel", true) :: TextLabel?
		or nil

	if self.claimDailyButtonFrame then
		cacheEntryOriginalColors(self.claimDailyButtonFrame)
	end
	if self.claimAllButtonFrame then
		cacheEntryOriginalColors(self.claimAllButtonFrame)
	end

	for day = 1, DailyRewardsConfig.DAY_COUNT do
		local dayFrame = bodyFrame:FindFirstChild(string.format("Day%dInfo", day))
		if not dayFrame or not dayFrame:IsA("Frame") then
			continue
		end

		local rewardAmountLabel = dayFrame:FindFirstChild("RewardAmount") :: TextLabel?
		local rewardTypeImage = getIconLabel(dayFrame)
		if not rewardAmountLabel or not rewardTypeImage then
			DebugModule.debugWarn(
				string.format(
					"Daily reward entry missing UI refs for day %d | amount=%s icon=%s",
					day,
					tostring(rewardAmountLabel ~= nil),
					tostring(rewardTypeImage ~= nil)
				),
				MODULE_NAME
			)
			continue
		end

		local dayCounterLabel = dayFrame:FindFirstChild("DayCounter") :: TextLabel?
		local gradient = getOrCreateGradient(dayFrame)
		local uiScale = getOrCreateUIScale(dayFrame)
		gradient.Rotation = 90
		cacheEntryOriginalColors(dayFrame)

		self.entries[day] = {
			day = day,
			root = dayFrame,
			rewardAmountLabel = rewardAmountLabel,
			rewardTypeImage = rewardTypeImage,
			dayCounterLabel = dayCounterLabel,
			gradient = gradient,
			uiscale = uiScale,
			lastStyleKey = nil,
		}
	end

	if self.claimAllPriceLabel and CLAIM_ALL_PRODUCT_ID then
		task.defer(function()
			if self.destroyed then
				return
			end

			local ok, productInfo = pcall(function()
				return MarketplaceService:GetProductInfo(CLAIM_ALL_PRODUCT_ID, Enum.InfoType.Product)
			end)
			if ok and typeof(productInfo) == "table" and self.claimAllPriceLabel and self.claimAllPriceLabel.Parent then
				self.claimAllPriceLabel.Text = tostring(productInfo.PriceInRobux or 0)
			end
		end)
	end

	if self.claimDailyButton then
		self.buttonMaid:GiveTask(self.claimDailyButton.MouseButton1Click:Connect(function()
			if self.destroyed then
				return
			end

			local nextClaimUnix = sanitizeNextClaimUnix(self.player:GetAttribute(NEXT_CLAIM_ATTRIBUTE))
			local isClaimable = if DEBUG_SEQUENTIAL_CLAIM_MODE then true else os.time() >= nextClaimUnix
			if not isClaimable then
				return
			end

			self.dailyRewardAction:FireServer("ClaimCurrent")
		end))
	end

	if self.claimAllButton and CLAIM_ALL_PRODUCT_ID then
		self.buttonMaid:GiveTask(self.claimAllButton.MouseButton1Click:Connect(function()
			if self.destroyed then
				return
			end

			FunnelAnalytics.FireClientAction("DailyRewardClaimAllPromptOpened", {
				source = "DailyRewardsUI",
			})
			ProductService.promptProductPurchase(self.player, CLAIM_ALL_PRODUCT_ID)
		end))
	end
end

function DailyRewardsUI:ApplyFrameStyle(
	entry: RewardEntry,
	isClaimed: boolean,
	isCurrentDay: boolean,
	isClaimable: boolean
)
	local styleKey = table.concat({
		tostring(isClaimed),
		tostring(isCurrentDay),
		tostring(isClaimable),
	}, ":")
	if entry.lastStyleKey == styleKey then
		return
	end
	entry.lastStyleKey = styleKey

	local reward = DailyRewardsConfig.GetReward(entry.day)
	if not reward then
		return
	end

	local topColor = reward.topColor
	local bottomColor = reward.bottomColor
	local shouldDisable = isClaimed or not isCurrentDay
	local targetScale = if isCurrentDay then CLAIMABLE_CARD_SCALE else 1

	entry.root.BackgroundColor3 = topColor
	entry.root:SetAttribute("OriginalDisabledBaseColor", topColor)
	entry.root:SetAttribute("OriginalColor_BackgroundColor3", topColor)
	entry.gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, topColor),
		ColorSequenceKeypoint.new(1, bottomColor),
	})
	VisualFunctions.SetFrameDisabledState(entry.root, shouldDisable, DISABLED_CARD_MULTIPLIER)
	TweenService:Create(
		entry.uiscale,
		TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ Scale = targetScale }
	):Play()
end

function DailyRewardsUI:ApplyClaimButtonState(isClaimable: boolean)
	if self.lastClaimButtonClaimable == isClaimable then
		return
	end
	self.lastClaimButtonClaimable = isClaimable

	local button = self.claimDailyButton
	local buttonFrame = self.claimDailyButtonFrame

	if buttonFrame then
		VisualFunctions.SetFrameDisabledState(buttonFrame, not isClaimable, 0.65)
	end

	if not button then
		return
	end

	button.AutoButtonColor = false
	button.Active = isClaimable
	button.Selectable = isClaimable
	button.Text = "CLAIM"
end

function DailyRewardsUI:NotifyClaimableChanged(isClaimable: boolean)
	if self.lastClaimableState == isClaimable then
		return
	end
	self.lastClaimableState = isClaimable

	local callback = self.onClaimableChanged
	if not callback then
		return
	end

	local ok, err = pcall(callback, isClaimable)
	if not ok then
		DebugModule.debugWarn(string.format("onClaimableChanged callback failed: %s", tostring(err)), MODULE_NAME)
	end
end

function DailyRewardsUI:Refresh()
	if self.destroyed then
		return
	end

	if next(self.entries) == nil then
		self:Rebuild()
	end

	local currentDay = sanitizeCurrentDay(self.player:GetAttribute(CURRENT_DAY_ATTRIBUTE))
	local cycleCount = sanitizeCycleCount(self.player:GetAttribute(CYCLE_COUNT_ATTRIBUTE))
	local nextClaimUnix = sanitizeNextClaimUnix(self.player:GetAttribute(NEXT_CLAIM_ATTRIBUTE))
	local nowUnix = os.time()
	local claimable = if DEBUG_SEQUENTIAL_CLAIM_MODE then true else nowUnix >= nextClaimUnix
	local remainingSeconds = math.max(0, nextClaimUnix - nowUnix)

	for day, entry in pairs(self.entries) do
		local reward = DailyRewardsConfig.GetReward(day)
		if not reward then
			continue
		end

		entry.rewardAmountLabel.Text = getRewardAmountText(self.player, reward, cycleCount)
		entry.rewardTypeImage.Image = reward.image
		if entry.dayCounterLabel then
			entry.dayCounterLabel.Text = string.format("DAY %d", day)
		end

		local isClaimed = day < currentDay
		self:ApplyFrameStyle(entry, isClaimed, day == currentDay, claimable)
	end

	if self.dailyCountdownLabel then
		self.dailyCountdownLabel.Visible = true
		self.dailyCountdownLabel.Text = if claimable
			then "REWARD READY!"
			else string.format("DAY %d REWARD AVAILABLE IN %s", currentDay, formatClockDuration(remainingSeconds))
	end

	self:ApplyClaimButtonState(claimable)
	self:NotifyClaimableChanged(claimable)
end

function DailyRewardsUI:Bind()
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(CURRENT_DAY_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(NEXT_CLAIM_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal(CYCLE_COUNT_ATTRIBUTE):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("Rebirth_XPMultiplier"):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("DevProduct_XPSpeedMultiplier"):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("Misc_XPSpeedMultiplier"):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("Friend_XPMultiplier"):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("Treadmill_XPMultiplier"):Connect(function()
		self:Refresh()
	end))
	self.maid:GiveTask(self.player:GetAttributeChangedSignal("WinMultiplier"):Connect(function()
		self:Refresh()
	end))

	self.maid:GiveTask(self.root.DescendantAdded:Connect(function(descendant)
		if
			descendant.Name == "DailyRewardFrame"
			or descendant.Name == "ClaimDailyButton"
			or descendant.Name == "ClaimAllDailyButton"
			or string.match(descendant.Name, "^Day%dInfo$")
		then
			task.defer(function()
				if self.destroyed then
					return
				end
				self:Rebuild()
				self:Refresh()
			end)
		end
	end))

	self.maid:GiveTask(RunService.Heartbeat:Connect(function(dt)
		self.updateAccumulator += dt
		if self.updateAccumulator < COUNTDOWN_UPDATE_INTERVAL then
			return
		end
		self.updateAccumulator = 0
		self:Refresh()
	end))
end

function DailyRewardsUI:Destroy()
	if self.destroyed then
		return
	end

	self.destroyed = true
	self:NotifyClaimableChanged(false)
	self.maid:DoCleaning()
	self.buttonMaid:DoCleaning()
	table.clear(self.entries)
end

return DailyRewardsUI
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2496">
            <Properties>
              <string name="Name">DisplayRefreshBindings</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local VisualFunctions = require(ReplicatedStorage.Modules.UI.VisualFunctions)

local DisplayRefreshBindings = {}

type MaidLike = {
	GiveTask: (self: MaidLike, task: any) -> any,
}

type BindOptions = {
	player: Player,
	sessionMaid: MaidLike,
	updateUI: () -> (),
	updateXPProductLabels: () -> (),
	updateVerifyRewardValueLabels: () -> (),
	updateMultiplierShop: () -> (),
	updateX2WinShop: () -> (),
	updateShopButtons: () -> (),
	updateKartShop: () -> (),
	updateTrailMultiplierDisplay: () -> (),
}

function DisplayRefreshBindings.Bind(options: BindOptions)
	local function bind(attributeName: string, callback: () -> ())
		options.sessionMaid:GiveTask(options.player:GetAttributeChangedSignal(attributeName):Connect(callback))
	end

	local function updateRebirthAndProductDisplay()
		options.updateUI()
		options.updateXPProductLabels()
		options.updateVerifyRewardValueLabels()
	end

	local function updateDevProductDisplay()
		options.updateMultiplierShop()
		options.updateXPProductLabels()
		options.updateVerifyRewardValueLabels()
	end

	local function updateMiscMultiplierDisplay()
		options.updateXPProductLabels()
		options.updateTrailMultiplierDisplay()
		options.updateVerifyRewardValueLabels()
	end

	local function updateFriendMultiplierDisplay()
		local friendMultiplier = options.player:GetAttribute("Friend_XPMultiplier") or 1
		VisualFunctions.UpdateFriendMultiplierLabel(friendMultiplier)
		options.updateVerifyRewardValueLabels()
	end

	local function updateWinMultiplierDisplay()
		options.updateX2WinShop()
		options.updateXPProductLabels()
		options.updateShopButtons()
		options.updateKartShop()
		options.updateVerifyRewardValueLabels()
	end

	bind("MaxLevel", updateRebirthAndProductDisplay)
	bind("Rebirth_XPMultiplier", updateRebirthAndProductDisplay)
	bind("DevProduct_XPSpeedMultiplier", updateDevProductDisplay)
	bind("Misc_XPSpeedMultiplier", updateMiscMultiplierDisplay)
	bind("Friend_XPMultiplier", updateFriendMultiplierDisplay)
	bind("WinMultiplier", updateWinMultiplierDisplay)
end

return DisplayRefreshBindings
]]></string>
            </Properties>
          </Item>
          <Item class="ModuleScript" referent="2497">
            <Properties>
              <string name="Name">LiveEventBannerUI</string>
              <string name="Source"><![CDATA[--!strict

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Maid = require(ReplicatedStorage.Modules.Maid)

local LiveEventBannerUI = {}
LiveEventBannerUI.__index = LiveEventBannerUI

type LiveEventBannerUIObject = {
	frame: Frame?,
	label: TextLabel?,
	stateFolder: Folder?,
	originalFrameVisible: boolean?,
	originalLabelText: string?,
	maid: any,
	initialized: boolean,
}

function LiveEventBannerUI.new(screenGui: ScreenGui): LiveEventBannerUIObject
	local frame = screenGui:FindFirstChild("IngameEventFrame")
	local bannerFrame = if frame and frame:IsA("Frame") then frame else nil
	local label = bannerFrame and bannerFrame:FindFirstChild("TextLabel")
	local textLabel = if label and label:IsA("TextLabel") then label else nil

	return setmetatable({
		frame = bannerFrame,
		label = textLabel,
		stateFolder = nil,
		originalFrameVisible = if bannerFrame then bannerFrame.Visible else nil,
		originalLabelText = if textLabel then textLabel.Text else nil,
		maid = Maid.new(),
		initialized = false,
	}, LiveEventBannerUI)
end

function LiveEventBannerUI:refresh()
	if not self.frame or not self.label or not self.stateFolder then
		return
	end

	local active = self.stateFolder:GetAttribute("BannerActive") == true
	local text = self.stateFolder:GetAttribute("BannerText")
	local bannerText = if typeof(text) == "string" then string.upper(text) else ""
	self.frame.Visible = active and bannerText ~= ""
	if bannerText ~= "" then
		self.label.Text = bannerText
	end
end

function LiveEventBannerUI:Init()
	if self.initialized then
		return
	end
	self.initialized = true

	local stateFolder = ReplicatedStorage:FindFirstChild("LiveEventState")
	if not stateFolder or not stateFolder:IsA("Folder") then
		if self.frame then
			self.frame.Visible = false
		end
		self.maid.StateAdded = ReplicatedStorage.ChildAdded:Connect(function(child: Instance)
			if child.Name == "LiveEventState" and child:IsA("Folder") then
				self.stateFolder = child
				self.maid.StateAdded = nil
				self.maid.BannerActive = child:GetAttributeChangedSignal("BannerActive"):Connect(function()
					self:refresh()
				end)
				self.maid.BannerText = child:GetAttributeChangedSignal("BannerText"):Connect(function()
					self:refresh()
				end)
				self:refresh()
			end
		end)
		return
	end

	self.stateFolder = stateFolder
	self.maid.BannerActive = stateFolder:GetAttributeChangedSignal("BannerActive"):Connect(function()
		self:refresh()
	end)
	self.maid.BannerText = stateFolder:GetAttributeChangedSignal("BannerText"):Connect(function()
		self:refresh()
	end)
	self:refresh()
end

function LiveEventBannerUI:Destroy()
	if not self.initialized then
		return
	end
	self.initialized = false
	self.maid:DoCleaning()
	if self.frame and self.originalFrameVisible ~= nil then
		self.frame.Visible = self.originalFrameVisible
	end
	if self.label and self.originalLabelText then
		self.label.Text = self.originalLabelText
	end
	self.stateFolder = nil
end

return LiveEventBannerUI
]]></string>
            </Properties>
          </Item>
