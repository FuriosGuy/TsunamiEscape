        <Properties>
          <string name="Name">SoundService</string>
          <string name="Source"><![CDATA[--!strict
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RobloxSoundService = game:GetService("SoundService")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)

local SoundService = {}
local guiSoundFolder = Instance.new("Folder")
guiSoundFolder.Name = "GuiSounds"
guiSoundFolder.Parent = RobloxSoundService

SoundService.WorldMusicPlaylists = {
	Fallback = {
		LobbyMusicList = { 138197655562277 },
		ActionMusicList = { 72666159391603 },
	},
}

export type SoundSettings = {
	SoundId: string | number,
	Volume: number?,
	Pitch: number?,
	PlaybackSpeed: number?,
	Looped: boolean?,
	AllowOverlap: boolean?,
	RollOffMode: Enum.RollOffMode?,
	RollOffMinDistance: number?,
	RollOffMaxDistance: number?,
	TimePosition: number?,
}

SoundService.Sounds = {
	["Click"] = {
		SoundId = 124637583082916,
		Volume = 0.4,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = false,
	},
	["Pop"] = {
		SoundId = 109359226723492,
		Volume = 0.8,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["Close"] = {
		SoundId = 92389629512441,
		Volume = 0.4,
		Pitch = 1,
		PlaybackSpeed = 0.75,
		Looped = false,
		AllowOverlap = false,
	},
	["BellRing"] = {
		SoundId = 128714357287984,
		Volume = 0.4,
		Pitch = 1,
		PlaybackSpeed = 0.75,
		Looped = false,
		AllowOverlap = false,
	},
	["Success"] = {
		SoundId = 128044073486125,
		Volume = 0.4,
		Pitch = 1,
		PlaybackSpeed = 0.75,
		Looped = false,
		AllowOverlap = false,
	},
	["Hover"] = {
		SoundId = 139800881181209,
		Volume = 0.3,
		Pitch = 1,
		PlaybackSpeed = 1.5,
		Looped = false,
		AllowOverlap = false,
	},
	["LevelUp"] = {
		SoundId = 3120909354,
		Volume = 0.7,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["Rebirth"] = {
		SoundId = 100288208393628,
		Volume = 0.7,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["WinReward"] = {
		SoundId = 136993031050456,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["Confetti"] = {
		SoundId = 1631688574,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["Swish"] = {
		SoundId = 91252825775281,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = false,
		AllowOverlap = true,
	},
	["AmbientLoop"] = {
		SoundId = 0,
		Volume = 0.35,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = true,
		RollOffMode = Enum.RollOffMode.InverseTapered,
		RollOffMinDistance = 10,
		RollOffMaxDistance = 80,
	},
	["Wave Crash"] = {
		SoundId = 79068891226084,
		Volume = 1,
		Pitch = 1,
		PlaybackSpeed = 1,
		Looped = true,
		RollOffMode = Enum.RollOffMode.InverseTapered,
		RollOffMinDistance = 64,
		RollOffMaxDistance = 256,
	},
	["KartEngine"] = {
		SoundId = 9112787430,
		Volume = 2,
		Pitch = 1,
		PlaybackSpeed = 0.5,
		Looped = true,
		RollOffMode = Enum.RollOffMode.InverseTapered,
		RollOffMinDistance = 32,
		RollOffMaxDistance = 96,
	},
}

local function normalizeSoundId(soundId: string | number): string
	if typeof(soundId) == "number" then
		return "rbxassetid://" .. tostring(soundId)
	end

	if string.find(soundId, "rbxassetid://") == 1 then
		return soundId
	end

	return "rbxassetid://" .. soundId
end

local function getConfig(soundName: string): SoundSettings?
	local config = SoundService.Sounds[soundName]
	if not config then
		DebugModule.debugWarn("Missing sound config for " .. soundName, "SoundService")
		return nil
	end

	return config
end

local function applyProperties(sound: Sound, soundName: string, config: SoundSettings)
	sound.SoundId = normalizeSoundId(config.SoundId)
	sound.Volume = config.Volume or 1
	sound.PlaybackSpeed = config.PlaybackSpeed or config.Pitch or 1
	sound.Looped = config.Looped == true
	sound.Name = soundName

	if config.TimePosition then
		sound.TimePosition = config.TimePosition
	end

	if config.RollOffMode then
		sound.RollOffMode = config.RollOffMode
	end

	if config.RollOffMinDistance then
		sound.RollOffMinDistance = config.RollOffMinDistance
	end

	if config.RollOffMaxDistance then
		sound.RollOffMaxDistance = config.RollOffMaxDistance
	end
end

local function createSound(parent: Instance, soundName: string, overrideSettings: SoundSettings?): Sound?
	local baseConfig = getConfig(soundName)
	if not baseConfig then
		return nil
	end

	local mergedConfig = table.clone(baseConfig)
	if overrideSettings then
		for key, value in pairs(overrideSettings) do
			(mergedConfig :: any)[key] = value
		end
	end

	local sound = Instance.new("Sound")
	applyProperties(sound, soundName, mergedConfig)
	sound.Parent = parent

	return sound
end

local function getOrCreateCachedGuiSound(soundName: string): Sound?
	local existing = guiSoundFolder:FindFirstChild(soundName)
	if existing and existing:IsA("Sound") then
		return existing
	end

	local sound = createSound(guiSoundFolder, soundName)
	if not sound then
		return nil
	end

	return sound
end

function SoundService.RegisterSound(soundName: string, config: SoundSettings)
	SoundService.Sounds[soundName] = config
	DebugModule.debugPrint("Registered sound config for " .. soundName, "SoundService")
end

function SoundService.GetWorldMusicPlaylist(worldName: string?, playlistName: string?): { string | number }
	local selectedPlaylistName = playlistName or "LobbyMusicList"
	local worldConfig = if worldName then SoundService.WorldMusicPlaylists[worldName] else nil
	local playlist = worldConfig and worldConfig[selectedPlaylistName]
	if playlist and #playlist > 0 then
		return playlist
	end

	local fallbackConfig = SoundService.WorldMusicPlaylists.Fallback
	local fallbackPlaylist = fallbackConfig and fallbackConfig[selectedPlaylistName]
	if fallbackPlaylist and #fallbackPlaylist > 0 then
		return fallbackPlaylist
	end

	return {}
end

function SoundService.CreateSound(parent: Instance, soundName: string, overrideSettings: SoundSettings?): Sound?
	return createSound(parent, soundName, overrideSettings)
end

function SoundService.PlayGuiSound(soundName: string, parent: Instance?, overrideSettings: SoundSettings?): Sound?
	local baseConfig = getConfig(soundName)
	if not baseConfig then
		return nil
	end

	if parent == nil and overrideSettings == nil and not baseConfig.AllowOverlap then
		local cachedSound = getOrCreateCachedGuiSound(soundName)
		if not cachedSound then
			return nil
		end

		cachedSound:Stop()
		cachedSound.TimePosition = 0
		cachedSound:Play()
		return cachedSound
	end

	local targetParent = parent or RobloxSoundService
	local sound = createSound(targetParent, soundName, overrideSettings)
	if not sound then
		return nil
	end

	sound:Play()
	if not sound.Looped then
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	end

	return sound
end

function SoundService.PlayWorkspaceSound(soundName: string, parent: Instance, overrideSettings: SoundSettings?): Sound?
	local sound = createSound(parent, soundName, overrideSettings)
	if not sound then
		return nil
	end

	sound:Play()
	if not sound.Looped then
		sound.Ended:Once(function()
			sound:Destroy()
		end)
	end

	return sound
end

function SoundService.StopSound(sound: Sound)
	sound:Stop()
end

function SoundService.FadeOutAndDestroy(sound: Sound, fadeTime: number)
	local tween = TweenService:Create(sound, TweenInfo.new(fadeTime), { Volume = 0 })
	tween:Play()
	tween.Completed:Once(function()
		sound:Stop()
		sound:Destroy()
	end)
end

return SoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2486">
        <Properties>
          <string name="Name">SystemChatService</string>
          <string name="Source"><![CDATA[--!strict
local MessagingService = game:GetService("MessagingService")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local StarterGui = game:GetService("StarterGui")
local TextChatService = game:GetService("TextChatService")

local Maid = require(ReplicatedStorage.Modules.Maid)
local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local CoreConfig = require(ReplicatedStorage.Modules.Config.CoreConfig)
local ProductService = require(ReplicatedStorage.Modules.ProductService)

local SystemChatService = {}
local REMOTE_NAME = "GlobalSystemChat"
local TOPIC_NAME = "GlobalSystemChat_v1"
local MODULE_NAME = "SystemChatService"
local serverSubscription: RBXScriptConnection? = nil
local serverInstanceId = game.JobId ~= "" and game.JobId or ("studio-" .. tostring(os.clock()))
local promotionalLoopStarted = false
local playerAnnouncementsStarted = false
local promotionalLoopAlive = false
local serverMaid = Maid.new()
local clientMaid = Maid.new()
local serverShutdownBound = false
local clientInitialized = false
local systemChatConfig = CoreConfig.systemChat

local DEFAULT_LIKE_FAVORITE_EMOJIS = { "👍", "⭐", "🔥", "🎉", "💛", "💬", "📌", "🌟" }
local DEFAULT_GROUP_EMOJIS = { "👥", "🎁", "✨", "🚀", "🏆", "🤝", "📣", "🎊" }
local DEFAULT_SHOP_EMOJIS = { "🛒", "💎", "⚡", "🚗", "🔥", "🧪", "💥", "🎯" }
local DEFAULT_SHOP_PROMOTIONAL_TEMPLATES = {
	"Boost your run with {ITEM}!",
	"Try {ITEM} from the shop!",
	"Power up now with {ITEM}!",
	"Upgrade your progress using {ITEM}!",
	"Check out {ITEM} in the shop!",
}
local DEFAULT_SHOP_PROMOTION_OFFER_KEYS = {
	"VIP",
	"2xWins",
	"3xTreadmill",
	"15xTreadmill",
	"35xTreadmill",
	"100xTreadmill",
	"AdvancedTank",
	"ShoppingKart",
	"FormulaCar",
	"+1000",
	"+5000",
	"+10000",
	"+100K",
	"+1M",
	"+10M",
	"2x",
	"4x",
	"8x",
	"16x",
	"32x",
	"64x",
	"100x",
}

SystemChatService.Config = {
	DefaultColor = Color3.fromRGB(254, 200, 42),
	RebirthColor = Color3.fromRGB(227, 74, 255),
	PromoColor = Color3.fromRGB(255, 255, 255),
	PlayerJoinColor = Color3.fromRGB(70, 255, 120),
	PlayerLeaveColor = Color3.fromRGB(255, 70, 70),
	PromoMinDelay = if systemChatConfig and typeof(systemChatConfig.promoMinDelay) == "number"
		then math.max(1, systemChatConfig.promoMinDelay)
		else 120,
	PromoMaxDelay = if systemChatConfig and typeof(systemChatConfig.promoMaxDelay) == "number"
		then math.max(1, systemChatConfig.promoMaxDelay)
		else 300,
}

SystemChatService.LikeFavoriteEmojis = if systemChatConfig
		and typeof(systemChatConfig.likeFavoriteEmojis) == "table"
		and #systemChatConfig.likeFavoriteEmojis > 0
	then
		systemChatConfig.likeFavoriteEmojis
	else
		DEFAULT_LIKE_FAVORITE_EMOJIS

SystemChatService.GroupEmojis = if systemChatConfig
		and typeof(systemChatConfig.groupEmojis) == "table"
		and #systemChatConfig.groupEmojis > 0
	then
		systemChatConfig.groupEmojis
	else
		DEFAULT_GROUP_EMOJIS

SystemChatService.ShopEmojis = if systemChatConfig and typeof(systemChatConfig.shopEmojis) == "table" and #systemChatConfig.shopEmojis > 0
	then
		systemChatConfig.shopEmojis
	else
		DEFAULT_SHOP_EMOJIS

SystemChatService.LikeFavoritePromotionalMessages = if systemChatConfig
		and typeof(systemChatConfig.likeFavoritePromotionalMessages) == "table"
		and #systemChatConfig.likeFavoritePromotionalMessages > 0
	then
		systemChatConfig.likeFavoritePromotionalMessages
	else
		{
			"Favorite the game and leave a Like for more updates!",
			"Enjoying the game? Favorite it and drop a Like!",
			"Like + Favorite the game to support future content!",
			"Show some support by Liking and Favoriting the game!",
			"Like and Favorite the game if you want more awesome updates!",
		}

SystemChatService.GroupPromotionalMessages = if systemChatConfig
		and typeof(systemChatConfig.groupPromotionalMessages) == "table"
		and #systemChatConfig.groupPromotionalMessages > 0
	then
		systemChatConfig.groupPromotionalMessages
	else
		{
			"Join our group for exclusive rewards!",
			"Join our group to claim exclusive rewards!",
			"Group members get exclusive rewards, join us now!",
			"Join our group and grab your exclusive rewards!",
			"Want exclusive rewards? Join our group today!",
		}

SystemChatService.ShopPromotionalTemplates = if systemChatConfig
		and typeof(systemChatConfig.shopPromotionalTemplates) == "table"
		and #systemChatConfig.shopPromotionalTemplates > 0
	then
		systemChatConfig.shopPromotionalTemplates
	else
		DEFAULT_SHOP_PROMOTIONAL_TEMPLATES

SystemChatService.ShopPromotionOfferKeys = if systemChatConfig
		and typeof(systemChatConfig.shopPromotionOfferKeys) == "table"
		and #systemChatConfig.shopPromotionOfferKeys > 0
	then
		systemChatConfig.shopPromotionOfferKeys
	else
		DEFAULT_SHOP_PROMOTION_OFFER_KEYS

local OFFER_LABELS: { [string]: string } = {
	VIP = "VIP Pass",
	["2xWins"] = "2x Wins",
	["3xTreadmill"] = "3x Treadmill Pass",
	["15xTreadmill"] = "15x Treadmill Pass",
	["35xTreadmill"] = "35x Treadmill Pass",
	["100xTreadmill"] = "100x Treadmill Pass",
	AdvancedTank = "Advanced Tank Kart",
	ShoppingKart = "Shopping Kart",
	FormulaCar = "Formula Car",
	["+1000"] = "+1,000 Wins",
	["+5000"] = "+5,000 Wins",
	["+10000"] = "+10,000 Wins",
	["+100K"] = "+100K XP Speed",
	["+1M"] = "+1M XP Speed",
	["+10M"] = "+10M XP Speed",
	["2x"] = "2x XP Multiplier",
	["4x"] = "4x XP Multiplier",
	["8x"] = "8x XP Multiplier",
	["16x"] = "16x XP Multiplier",
	["32x"] = "32x XP Multiplier",
	["64x"] = "64x XP Multiplier",
	["100x"] = "100x XP Multiplier",
}
local marketplaceNameCache: { [string]: string | false } = {}

local function getRandomFromPool(pool: { string }): string?
	local count = #pool
	if count <= 0 then
		return nil
	end

	return pool[math.random(1, count)]
end

local function getMarketplaceItemName(itemId: number, infoType: Enum.InfoType): string?
	local cacheKey = string.format("%s:%d", infoType.Name, itemId)
	local cached = marketplaceNameCache[cacheKey]
	if cached == false then
		return nil
	end
	if typeof(cached) == "string" then
		return cached
	end

	local ok, result = pcall(function()
		return MarketplaceService:GetProductInfo(itemId, infoType)
	end)
	if not ok or typeof(result) ~= "table" then
		marketplaceNameCache[cacheKey] = false
		return nil
	end

	local name = result.Name
	if typeof(name) == "string" and name ~= "" then
		marketplaceNameCache[cacheKey] = name
		return name
	end

	marketplaceNameCache[cacheKey] = false
	return nil
end

local function resolveOfferDisplayName(offerKey: string): string
	local gamePassId = ProductService.Gamepasses[offerKey]
	if typeof(gamePassId) == "number" and gamePassId > 0 then
		local liveName = getMarketplaceItemName(gamePassId, Enum.InfoType.GamePass)
		if liveName then
			return liveName
		end
	end

	local devProductId = ProductService.DevProducts[offerKey]
	if typeof(devProductId) == "number" and devProductId > 0 then
		local liveName = getMarketplaceItemName(devProductId, Enum.InfoType.Product)
		if liveName then
			return liveName
		end
	end

	return OFFER_LABELS[offerKey] or offerKey
end

local function buildShopPromotionOffers(): { string }
	local offers: { string } = {}
	for _, offerKey in ipairs(SystemChatService.ShopPromotionOfferKeys) do
		local gamePassId = ProductService.Gamepasses[offerKey]
		local devProductId = ProductService.DevProducts[offerKey]
		local hasCatalogEntry = (typeof(gamePassId) == "number" and gamePassId > 0)
			or (typeof(devProductId) == "number" and devProductId > 0)
		if hasCatalogEntry then
			table.insert(offers, resolveOfferDisplayName(offerKey))
		end
	end

	return offers
end

local shopPromotionOffers: { string }? = nil

local function buildPromotionalMessage(): string?
	local promoMode = math.random(1, 3)

	if promoMode == 1 then
		local message = getRandomFromPool(SystemChatService.LikeFavoritePromotionalMessages)
		if not message then
			return nil
		end
		local emoji = getRandomFromPool(SystemChatService.LikeFavoriteEmojis)
		return if emoji then string.format("%s %s", emoji, message) else message
	elseif promoMode == 2 then
		local message = getRandomFromPool(SystemChatService.GroupPromotionalMessages)
		if not message then
			return nil
		end
		local emoji = getRandomFromPool(SystemChatService.GroupEmojis)
		return if emoji then string.format("%s %s", emoji, message) else message
	end

	local template = getRandomFromPool(SystemChatService.ShopPromotionalTemplates)
	if not shopPromotionOffers then
		shopPromotionOffers = buildShopPromotionOffers()
	end
	local offer = getRandomFromPool(shopPromotionOffers)
	if not template or not offer then
		return nil
	end
	local emoji = getRandomFromPool(SystemChatService.ShopEmojis)
	local message = string.gsub(template, "{ITEM}", offer)
	return if emoji then string.format("%s %s", emoji, message) else message
end

local function getRemotesFolder(): Instance
	local remotes = ReplicatedStorage:FindFirstChild("Remotes")
	if not remotes then
		remotes = Instance.new("Folder")
		remotes.Name = "Remotes"
		remotes.Parent = ReplicatedStorage
	end

	return remotes
end

local function getRemote(): RemoteEvent
	local remotes = getRemotesFolder()
	local remote = remotes:FindFirstChild(REMOTE_NAME) :: RemoteEvent?
	if not remote then
		remote = Instance.new("RemoteEvent")
		remote.Name = REMOTE_NAME
		remote.Parent = remotes
	end

	return remote
end

local function colorToHex(color: Color3): string
	return string.format("#%02X%02X%02X", color.R * 255, color.G * 255, color.B * 255)
end

local function randomSteppedInteger(minValue: number, maxValue: number): number
	local resolvedMin = math.floor(math.min(minValue, maxValue))
	local resolvedMax = math.floor(math.max(minValue, maxValue))
	local step = if resolvedMax - resolvedMin >= 10 then 10 else 1

	if resolvedMin == resolvedMax then
		return resolvedMin
	end

	local stepCount = math.floor((resolvedMax - resolvedMin) / step)
	return resolvedMin + (math.random(0, stepCount) * step)
end

function SystemChatService.FormatMessage(message: string, color: Color3?): string
	local resolvedColor = color or SystemChatService.Config.DefaultColor
	return string.format('<font color="%s"><b>%s</b></font>', colorToHex(resolvedColor), message)
end

function SystemChatService.FormatPurchaseMessage(playerName: string, itemName: string, price: number, color: Color3?): string
	local message = string.format("[SYSTEM]: %s just bought '%s' for %d Robux!", playerName, itemName, price)
	return SystemChatService.FormatMessage(message, color)
end

local function formatOrdinal(value: number): string
	local mod100 = value % 100
	if mod100 >= 11 and mod100 <= 13 then
		return tostring(value) .. "th"
	end

	local mod10 = value % 10
	if mod10 == 1 then
		return tostring(value) .. "st"
	elseif mod10 == 2 then
		return tostring(value) .. "nd"
	elseif mod10 == 3 then
		return tostring(value) .. "rd"
	end

	return tostring(value) .. "th"
end

function SystemChatService.FormatRebirthMessage(playerName: string, rebirthCount: number, color: Color3?): string
	local message = string.format("[SYSTEM]: %s just rebirthed for the %s time!", playerName, formatOrdinal(rebirthCount))
	return SystemChatService.FormatMessage(message, color or SystemChatService.Config.RebirthColor)
end

function SystemChatService.FormatPlayerJoinMessage(playerName: string, color: Color3?): string
	local message = string.format("[SYSTEM]: %s joined the server!", playerName)
	return SystemChatService.FormatMessage(message, color or SystemChatService.Config.PlayerJoinColor)
end

function SystemChatService.FormatPlayerLeaveMessage(playerName: string, color: Color3?): string
	local message = string.format("[SYSTEM]: %s left the server!", playerName)
	return SystemChatService.FormatMessage(message, color or SystemChatService.Config.PlayerLeaveColor)
end

function SystemChatService.BroadcastMessage(message: string, color: Color3?)
	assert(RunService:IsServer(), "BroadcastMessage must be called on the server")
	local formattedMessage = SystemChatService.FormatMessage(message, color)
	getRemote():FireAllClients(formattedMessage)
	local publishSuccess, publishError = pcall(function()
		MessagingService:PublishAsync(TOPIC_NAME, {
			ServerInstanceId = serverInstanceId,
			FormattedMessage = formattedMessage,
		})
	end)

	if not publishSuccess then
		DebugModule.debugWarn("Failed to publish global system chat: " .. tostring(publishError), MODULE_NAME)
	end
end

function SystemChatService.BroadcastPurchase(player: Player, itemName: string, price: number, color: Color3?)
	assert(RunService:IsServer(), "BroadcastPurchase must be called on the server")
	local formattedMessage = SystemChatService.FormatPurchaseMessage(player.Name, itemName, price, color)
	getRemote():FireAllClients(formattedMessage)
	local publishSuccess, publishError = pcall(function()
		MessagingService:PublishAsync(TOPIC_NAME, {
			ServerInstanceId = serverInstanceId,
			FormattedMessage = formattedMessage,
		})
	end)

	if not publishSuccess then
		DebugModule.debugWarn("Failed to publish global purchase chat: " .. tostring(publishError), MODULE_NAME)
	end
end

function SystemChatService.BroadcastLocalMessage(message: string, color: Color3?)
	assert(RunService:IsServer(), "BroadcastLocalMessage must be called on the server")
	getRemote():FireAllClients(SystemChatService.FormatMessage(message, color))
end

function SystemChatService.BroadcastLocalRebirth(player: Player, rebirthCount: number, color: Color3?)
	assert(RunService:IsServer(), "BroadcastLocalRebirth must be called on the server")
	getRemote():FireAllClients(SystemChatService.FormatRebirthMessage(player.Name, rebirthCount, color))
end

function SystemChatService.BroadcastLocalPlayerJoin(player: Player, color: Color3?)
	assert(RunService:IsServer(), "BroadcastLocalPlayerJoin must be called on the server")
	getRemote():FireAllClients(SystemChatService.FormatPlayerJoinMessage(player.Name, color))
end

function SystemChatService.BroadcastLocalPlayerLeave(playerName: string, color: Color3?)
	assert(RunService:IsServer(), "BroadcastLocalPlayerLeave must be called on the server")
	getRemote():FireAllClients(SystemChatService.FormatPlayerLeaveMessage(playerName, color))
end

function SystemChatService.StartPromotionalLoop()
	assert(RunService:IsServer(), "StartPromotionalLoop must be called on the server")
	if promotionalLoopStarted then
		return
	end

	promotionalLoopStarted = true
	promotionalLoopAlive = true
	serverMaid.PromotionalLoopCleanup = function()
		promotionalLoopAlive = false
	end
	serverMaid.PromotionalLoopThread = task.spawn(function()
		while promotionalLoopAlive do
			local delayTime = randomSteppedInteger(
				SystemChatService.Config.PromoMinDelay,
				SystemChatService.Config.PromoMaxDelay
			)
			task.wait(delayTime)
			if not promotionalLoopAlive then
				break
			end

			local message = buildPromotionalMessage()
			if not message then
				continue
			end
			SystemChatService.BroadcastLocalMessage("[SYSTEM]: " .. message, SystemChatService.Config.PromoColor)
		end
	end)
end

function SystemChatService.StartPlayerAnnouncementLoop()
	assert(RunService:IsServer(), "StartPlayerAnnouncementLoop must be called on the server")
	if playerAnnouncementsStarted then
		return
	end

	playerAnnouncementsStarted = true

	local function announcePlayerJoin(player: Player)
		serverMaid["JoinAnnouncement:" .. player.UserId] = task.spawn(function()
			task.wait(1)
			if player.Parent == Players then
				SystemChatService.BroadcastLocalPlayerJoin(player)
			end
		end)
	end

	serverMaid.PlayerAddedConnection = Players.PlayerAdded:Connect(function(player)
		announcePlayerJoin(player)
	end)

	serverMaid.PlayerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
		serverMaid["JoinAnnouncement:" .. player.UserId] = nil
		SystemChatService.BroadcastLocalPlayerLeave(player.Name)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		announcePlayerJoin(player)
	end
end

function SystemChatService.ShutdownServer()
	assert(RunService:IsServer(), "ShutdownServer must be called on the server")
	promotionalLoopStarted = false
	playerAnnouncementsStarted = false
	promotionalLoopAlive = false
	serverSubscription = nil
	serverMaid:DoCleaning()
end

function SystemChatService.InitServer()
	assert(RunService:IsServer(), "InitServer must be called on the server")
	if not serverSubscription then
		local subscribeSuccess, subscribeResult = pcall(function()
			return MessagingService:SubscribeAsync(TOPIC_NAME, function(message)
				local data = message.Data
				if typeof(data) ~= "table" then
					return
				end

				if data.ServerInstanceId == serverInstanceId then
					return
				end

				local formattedMessage = data.FormattedMessage
				if typeof(formattedMessage) ~= "string" then
					return
				end

				getRemote():FireAllClients(formattedMessage)
			end)
		end)

		if subscribeSuccess then
			serverSubscription = subscribeResult
			serverMaid.ServerSubscription = subscribeResult
		else
			DebugModule.debugWarn("Failed to subscribe to global system chat topic: " .. tostring(subscribeResult), MODULE_NAME)
		end
	end

	if not serverShutdownBound then
		serverShutdownBound = true
		game:BindToClose(function()
			SystemChatService.ShutdownServer()
		end)
	end

	SystemChatService.StartPromotionalLoop()
	SystemChatService.StartPlayerAnnouncementLoop()
end

function SystemChatService.InitClient()
	assert(RunService:IsClient(), "InitClient must be called on the client")
	if clientInitialized then
		return
	end
	clientInitialized = true

	local function displayMessage(formattedMessage: string)
		local textChannels = TextChatService:FindFirstChild("TextChannels")
			or TextChatService:WaitForChild("TextChannels", 10)
		local generalChannel = textChannels and textChannels:FindFirstChild("RBXGeneral")
			or (textChannels and textChannels:WaitForChild("RBXGeneral", 10))

		if generalChannel and generalChannel:IsA("TextChannel") then
			generalChannel:DisplaySystemMessage(formattedMessage)
			return
		end

		local success, err = pcall(function()
			StarterGui:SetCore("ChatMakeSystemMessage", {
				Text = formattedMessage:gsub("<[^>]->", ""),
				Color = SystemChatService.Config.DefaultColor,
			})
		end)

		if not success then
			DebugModule.debugWarn("No available chat channel for system chat: " .. tostring(err), MODULE_NAME)
		end
	end

	local remote = getRemote()
	clientMaid.RemoteConnection = remote.OnClientEvent:Connect(function(formattedMessage: string)
		displayMessage(formattedMessage)
	end)
end

function SystemChatService.ShutdownClient()
	assert(RunService:IsClient(), "ShutdownClient must be called on the client")
	clientInitialized = false
	clientMaid:DoCleaning()
end

return SystemChatService
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="2487">
        <Properties>
          <string name="Name">UI</string>
        </Properties>
        <Item class="ModuleScript" referent="2488">
          <Properties>
            <string name="Name">ConfettiBurstPlayer</string>
            <string name="Source"><![CDATA[--!strict

local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ConfettiController = require(ReplicatedStorage.Modules.UI:WaitForChild("ConfettiController"))

export type ConfettiBurstPlayer = {
	PlayBurst: (
		self: ConfettiBurstPlayer,
		colors: { Color3 }?,
		duration: number?,
		totalCount: number?,
		batchSize: number?,
		batchDelay: number?
	) -> (),
	Reset: (self: ConfettiBurstPlayer) -> (),
	Destroy: (self: ConfettiBurstPlayer) -> (),
}

type ConfettiBurstPlayerInternal = ConfettiBurstPlayer & {
	_container: GuiObject,
	_emitter: any,
	_renderConnection: RBXScriptConnection?,
	_destroyed: boolean,
}

local ConfettiBurstPlayer = {}
ConfettiBurstPlayer.__index = ConfettiBurstPlayer

local singleton: ConfettiBurstPlayerInternal? = nil

local function startLoop(self: ConfettiBurstPlayerInternal)
	if self._renderConnection then
		return
	end

	self._renderConnection = RunService.RenderStepped:Connect(function(deltaTime)
		self._emitter:Update(deltaTime)
		if not self._emitter:IsActive() and self._renderConnection then
			self._renderConnection:Disconnect()
			self._renderConnection = nil
		end
	end)
end

function ConfettiBurstPlayer.new(container: GuiObject): ConfettiBurstPlayer
	local self = setmetatable({
		_container = container,
		_emitter = ConfettiController.new(container, 40),
		_renderConnection = nil,
		_destroyed = false,
	}, ConfettiBurstPlayer) :: ConfettiBurstPlayerInternal

	return self
end

function ConfettiBurstPlayer.GetOrCreateSingleton(container: GuiObject?): ConfettiBurstPlayer?
	if not container then
		return nil
	end

	if singleton and singleton._destroyed then
		singleton = nil
	end

	if singleton and singleton._container == container and container.Parent ~= nil then
		return singleton
	end

	if singleton then
		singleton:Destroy()
		singleton = nil
	end

	singleton = ConfettiBurstPlayer.new(container) :: ConfettiBurstPlayerInternal
	return singleton
end

function ConfettiBurstPlayer:PlayBurst(
	colors: { Color3 }?,
	duration: number?,
	totalCount: number?,
	batchSize: number?,
	batchDelay: number?
)
	local selfInternal = self :: ConfettiBurstPlayerInternal
	if selfInternal._destroyed then
		return
	end

	selfInternal._emitter:Reset()
	selfInternal._emitter:PlayBurst(colors, duration, totalCount, batchSize, batchDelay)
	startLoop(selfInternal)
end

function ConfettiBurstPlayer:Reset()
	local selfInternal = self :: ConfettiBurstPlayerInternal
	if selfInternal._destroyed then
		return
	end

	selfInternal._emitter:Reset()
	if selfInternal._renderConnection then
		selfInternal._renderConnection:Disconnect()
		selfInternal._renderConnection = nil
	end
end

function ConfettiBurstPlayer:Destroy()
	local selfInternal = self :: ConfettiBurstPlayerInternal
	if selfInternal._destroyed then
		return
	end

	selfInternal._destroyed = true

	if selfInternal._renderConnection then
		selfInternal._renderConnection:Disconnect()
		selfInternal._renderConnection = nil
	end

	selfInternal._emitter:Destroy()

	if singleton == selfInternal then
		singleton = nil
	end
end

return ConfettiBurstPlayer
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2489">
          <Properties>
            <string name="Name">ConfettiController</string>
            <string name="Source"><![CDATA[--!strict

local Workspace = game:GetService("Workspace")

export type ConfettiController = {
	PlayBurst: (
		self: ConfettiController,
		colors: { Color3 }?,
		duration: number?,
		totalCount: number?,
		batchSize: number?,
		batchDelay: number?
	) -> (),
	Stop: (self: ConfettiController) -> (),
	Reset: (self: ConfettiController) -> (),
	Destroy: (self: ConfettiController) -> (),
	Update: (self: ConfettiController, deltaTime: number) -> (),
	IsActive: (self: ConfettiController) -> boolean,
	SetColors: (self: ConfettiController, colors: { Color3 }) -> (),
}

type ConfettiParticle = {
	label: ImageLabel,
	defaultSize: Vector2,
	color: Color3,
	emitterPosition: Vector2,
	emitterPower: Vector2,
	position: Vector2,
	power: Vector2,
	heightScale: number,
	rotation: number,
	rotationSpeed: number,
	enabled: boolean,
	outOfBounds: boolean,
}

type ConfettiControllerInternal = ConfettiController & {
	_particles: { ConfettiParticle },
	_parent: GuiObject,
	_colors: { Color3 },
	_gravity: Vector2,
	_burstEndTime: number,
	_destroyed: boolean,
	_nextBatchTime: number,
	_remainingBurstCount: number,
	_batchSize: number,
	_batchDelay: number,
}

local ConfettiController = {}
ConfettiController.__index = ConfettiController

local camera = Workspace.CurrentCamera

local TEMPLATE_IMAGES = {
	"rbxassetid://2695001063",
	"rbxassetid://910256717",
}

local DEFAULT_COLORS = {
	Color3.fromRGB(168, 100, 253),
	Color3.fromRGB(41, 205, 255),
	Color3.fromRGB(120, 255, 68),
	Color3.fromRGB(255, 113, 141),
	Color3.fromRGB(253, 255, 106),
}

local DEFAULT_GRAVITY = Vector2.new(0, 400)
local DEFAULT_COUNT = 35
local DEFAULT_DURATION = 1.4
local DEFAULT_BATCH_DELAY = 0
local DEFAULT_SIZE = Vector2.new(30, 30)
local EMITTER_POSITION_Y = 0
local MIN_EMITTER_X = 0
local MAX_EMITTER_X = 1
local MIN_FORCE_X = -150
local MAX_FORCE_X = 150
local MIN_FORCE_Y = 200
local MAX_FORCE_Y = 500

local function getViewportSize(): Vector2
	local currentCamera = Workspace.CurrentCamera
	if currentCamera then
		camera = currentCamera
	end

	if camera then
		return camera.ViewportSize
	end

	return Vector2.new(1920, 1080)
end

local function copyColors(colors: { Color3 }?): { Color3 }
	if not colors or #colors == 0 then
		return table.clone(DEFAULT_COLORS)
	end

	return table.clone(colors)
end

local function randomForce(): Vector2
	return Vector2.new(math.random(MIN_FORCE_X, MAX_FORCE_X), math.random(MIN_FORCE_Y, MAX_FORCE_Y))
end

local function randomEmitterPosition(): Vector2
	return Vector2.new(MIN_EMITTER_X + math.random() * (MAX_EMITTER_X - MIN_EMITTER_X), EMITTER_POSITION_Y)
end

local function createParticleLabel(parent: GuiObject): ImageLabel
	local label = Instance.new("ImageLabel")
	label.Name = "ConfettiParticle"
	label.AnchorPoint = Vector2.new(0.5, 0.5)
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Image = TEMPLATE_IMAGES[math.random(1, #TEMPLATE_IMAGES)]
	label.Size = UDim2.fromOffset(DEFAULT_SIZE.X, DEFAULT_SIZE.Y)
	label.Visible = false
	label.ZIndex = 20
	label.Parent = parent
	return label
end

local function resetParticle(particle: ConfettiParticle, colors: { Color3 }, keepVisible: boolean)
	particle.color = colors[math.random(1, #colors)]
	particle.position = Vector2.zero
	particle.power = particle.emitterPower + Vector2.new(math.random(-50, 50), math.random(-60, 60))
	particle.heightScale = 1
	particle.rotation = math.random(0, 359)
	particle.rotationSpeed = math.random(-540, 540)
	particle.outOfBounds = not keepVisible
	particle.label.Visible = keepVisible
	particle.label.ImageColor3 = particle.color
	particle.label.Rotation = particle.rotation
	particle.label.Size = UDim2.fromOffset(particle.defaultSize.X, particle.defaultSize.Y)
end

local function createParticle(parent: GuiObject, colors: { Color3 }): ConfettiParticle
	local label = createParticleLabel(parent)
	local particle: ConfettiParticle = {
		label = label,
		defaultSize = DEFAULT_SIZE,
		color = colors[1],
		emitterPosition = randomEmitterPosition(),
		emitterPower = randomForce(),
		position = Vector2.zero,
		power = Vector2.zero,
		heightScale = 1,
		rotation = 0,
		rotationSpeed = 0,
		enabled = false,
		outOfBounds = true,
	}

	resetParticle(particle, colors, false)
	return particle
end

function ConfettiController.new(parent: GuiObject, count: number?): ConfettiController
	local colors = copyColors(nil)
	local self = setmetatable({
		_particles = {},
		_parent = parent,
		_colors = colors,
		_gravity = DEFAULT_GRAVITY,
		_burstEndTime = 0,
		_destroyed = false,
		_nextBatchTime = 0,
		_remainingBurstCount = 0,
		_batchSize = 0,
		_batchDelay = DEFAULT_BATCH_DELAY,
	}, ConfettiController) :: ConfettiControllerInternal

	for _ = 1, count or DEFAULT_COUNT do
		table.insert(self._particles, createParticle(parent, colors))
	end

	return self
end

function ConfettiController:_ensureParticleCount(targetCount: number)
	while #self._particles < targetCount do
		table.insert(self._particles, createParticle(self._parent, self._colors))
	end
end

function ConfettiController:_activateParticles(count: number)
	local activated = 0
	for _, particle in ipairs(self._particles) do
		if not particle.enabled then
			particle.enabled = true
			particle.emitterPosition = randomEmitterPosition()
			particle.emitterPower = randomForce()
			resetParticle(particle, self._colors, true)
			activated += 1
			if activated >= count then
				break
			end
		end
	end
end

function ConfettiController:SetColors(colors: { Color3 })
	self._colors = copyColors(colors)
end

function ConfettiController:PlayBurst(
	colors: { Color3 }?,
	duration: number?,
	totalCount: number?,
	batchSize: number?,
	batchDelay: number?
)
	self._colors = copyColors(colors)
	local finalTotalCount = math.max(1, math.floor(totalCount or #self._particles))
	local finalBatchSize = math.max(1, math.floor(batchSize or finalTotalCount))
	self:_ensureParticleCount(finalTotalCount)

	self._burstEndTime = os.clock() + (duration or DEFAULT_DURATION)
	self._remainingBurstCount = finalTotalCount
	self._batchSize = finalBatchSize
	self._batchDelay = math.max(0, batchDelay or DEFAULT_BATCH_DELAY)
	self._nextBatchTime = os.clock()
end

function ConfettiController:Stop()
	self._burstEndTime = 0
	self._nextBatchTime = 0
	self._remainingBurstCount = 0
	for _, particle in ipairs(self._particles) do
		particle.enabled = false
	end
end

function ConfettiController:Reset()
	self:Stop()
	for _, particle in ipairs(self._particles) do
		resetParticle(particle, self._colors, false)
	end
end

function ConfettiController:IsActive(): boolean
	if self._destroyed then
		return false
	end

	if self._burstEndTime > 0 or self._remainingBurstCount > 0 then
		return true
	end

	for _, particle in ipairs(self._particles) do
		if particle.enabled or not particle.outOfBounds or particle.label.Visible then
			return true
		end
	end

	return false
end

function ConfettiController:Update(deltaTime: number)
	if not self:IsActive() then
		return
	end

	local now = os.clock()
	if self._burstEndTime > 0 and now >= self._burstEndTime then
		self._burstEndTime = 0
		self._nextBatchTime = 0
		self._remainingBurstCount = 0
		for _, particle in ipairs(self._particles) do
			particle.enabled = false
		end
	end

	if self._remainingBurstCount > 0 and now >= self._nextBatchTime then
		local countToActivate = math.min(self._batchSize, self._remainingBurstCount)
		self:_activateParticles(countToActivate)
		self._remainingBurstCount -= countToActivate
		self._nextBatchTime = now + self._batchDelay
	end

	local viewportSize = getViewportSize()
	local gravityStep = self._gravity * deltaTime

	for _, particle in ipairs(self._particles) do
		if not particle.enabled and particle.outOfBounds then
			particle.label.Visible = false
			continue
		end

		particle.position += particle.power * deltaTime
		particle.power += gravityStep
		particle.rotation += particle.rotationSpeed * deltaTime

		local screenX = viewportSize.X * particle.emitterPosition.X + particle.position.X
		local screenY = viewportSize.Y * particle.emitterPosition.Y + particle.position.Y
		particle.label.Position = UDim2.fromOffset(screenX, screenY)
		particle.label.Rotation = particle.rotation

		if particle.power.Y < 0 then
			particle.heightScale = math.abs(math.cos(now * 10 + particle.rotation))
		else
			particle.heightScale = 1
		end

		local height = math.max(2, particle.defaultSize.Y * particle.heightScale)
		particle.label.Size = UDim2.fromOffset(particle.defaultSize.X, height)
		particle.label.ImageColor3 = if particle.heightScale < 0.35
			then particle.color:Lerp(Color3.new(0, 0, 0), 0.35)
			else particle.color
		particle.label.Visible = true

		local isOutOfBounds = screenX > viewportSize.X + particle.defaultSize.X
			or screenX < -particle.defaultSize.X
			or screenY > viewportSize.Y + particle.defaultSize.Y
			or screenY < -particle.defaultSize.Y

		if isOutOfBounds then
			particle.outOfBounds = true
			if particle.enabled and self._burstEndTime > 0 then
				particle.emitterPower = randomForce()
				resetParticle(particle, self._colors, true)
			else
				particle.label.Visible = false
			end
		else
			particle.outOfBounds = false
		end
	end
end

function ConfettiController:Destroy()
	if self._destroyed then
		return
	end

	self._destroyed = true
	self._burstEndTime = 0

	for _, particle in ipairs(self._particles) do
		particle.label:Destroy()
	end

	table.clear(self._particles)
end

return ConfettiController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2490">
          <Properties>
            <string name="Name">InviteFriendsTopbar</string>
            <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SocialService = game:GetService("SocialService")
local StarterGui = game:GetService("StarterGui")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local FunnelAnalytics = require(Modules:WaitForChild("FunnelAnalytics"))
local ConfigFolder = Modules:WaitForChild("Config")
local CoreConfig = require(ConfigFolder:WaitForChild("CoreConfig"))

local TopbarFolder = ReplicatedStorage:WaitForChild("Topbar")
local Icon = require(TopbarFolder:WaitForChild("Icon"))

local InviteFriendsTopbar = {}

local MODULE_NAME = "InviteFriendsTopbar"
local localPlayer = Players.LocalPlayer
local socialConfig = CoreConfig.social
local iconImage = if socialConfig and typeof(socialConfig.friendInviteTopbarIconImage) == "string"
	then socialConfig.friendInviteTopbarIconImage
	else "rbxassetid://112009101194397"
local iconLabel = if socialConfig and typeof(socialConfig.friendInviteTopbarLabel) == "string"
	then socialConfig.friendInviteTopbarLabel
	else "Invite"
local promptMessage = if socialConfig and typeof(socialConfig.friendInvitePromptMessage) == "string"
	then socialConfig.friendInvitePromptMessage
	else "Invite friends to join and earn +0.10x multiplier per unique friend!"
local iconName = "InviteFriendsTopbar"

local started = false

local function showClientNotification(message: string)
	local success, err = pcall(function()
		StarterGui:SetCore("SendNotification", {
			Title = "Invite Friends",
			Text = message,
			Duration = 4,
		})
	end)

	if not success then
		DebugModule.debugWarn("Failed to show invite notification: " .. tostring(err), MODULE_NAME)
	end
end

local function canSendInvite(): boolean
	local success, canSend = pcall(function()
		return SocialService:CanSendGameInviteAsync(localPlayer)
	end)

	if not success then
		DebugModule.debugWarn("CanSendGameInviteAsync failed: " .. tostring(canSend), MODULE_NAME)
		return false
	end

	return canSend == true
end

local function promptInvite()
	if not canSendInvite() then
		showClientNotification("Invites are unavailable right now on this platform or account.")
		return
	end

	local inviteOptions = Instance.new("ExperienceInviteOptions")
	inviteOptions.PromptMessage = promptMessage

	local success, err = pcall(function()
		SocialService:PromptGameInvite(localPlayer, inviteOptions)
	end)

	if not success then
		DebugModule.debugWarn("PromptGameInvite failed: " .. tostring(err), MODULE_NAME)
		showClientNotification("Failed to open the invite prompt.")
		return
	end

	FunnelAnalytics.FireClientAction("FriendInvitePromptOpened", {
		source = "Topbar",
	})
end

function InviteFriendsTopbar.Start()
	if started then
		return
	end
	started = true

	local existingIcon = Icon.getIcon(iconName)
	if existingIcon then
		existingIcon:destroy()
	end

	Icon.setTopbarEnabled(true)

	local inviteIcon = Icon.new()
		:setName(iconName)
		:setLeft()
		:setImage(iconImage)
		:setLabel(iconLabel)
		:oneClick()

	inviteIcon.selected:Connect(function()
		promptInvite()
	end)

	DebugModule.debugInfo("Invite friends topbar icon started", MODULE_NAME)
end

return InviteFriendsTopbar
]]></string>
          </Properties>
