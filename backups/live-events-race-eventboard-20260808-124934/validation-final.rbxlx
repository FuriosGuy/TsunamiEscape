	}

	sessionMaid:GiveTask(function()
		for trackedPlayer, trackedPlayerMaid in pairs(stageProgressTrackedPlayerMaids) do
			trackedPlayerMaid:DoCleaning()
			stageProgressTrackedPlayerMaids[trackedPlayer] = nil
