      <Item class="ModuleScript" referent="2512">
        <Properties>
          <string name="Name">ValidationService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local DebugModule = require(ReplicatedStorage.Modules.DebugModule)
local PlayerHandler = require(ReplicatedStorage.Modules.PlayerHandler)

local ValidationService = {}
local DEFAULT_MAX_PLAYER_SPEED = if typeof(PlayerHandler.DEFAULT_ATTRIBUTES.Max_Player_Speed) == "number"
	then PlayerHandler.DEFAULT_ATTRIBUTES.Max_Player_Speed
	else 16

local function resetPlayerToWorldSpawn(player: Player)
	local currentWorld = player:GetAttribute("Current_World")
	if typeof(currentWorld) ~= "string" or currentWorld == "" then
		currentWorld = "World1"
	end

	player:SetAttribute("CurrentStage", 0)

	local character = player.Character
	if not character then
		return
	end

	local worldsFolder = Workspace:FindFirstChild("Worlds")
	local worldFolder = worldsFolder and worldsFolder:FindFirstChild(currentWorld)
	local spawnLocation = worldFolder and worldFolder:FindFirstChild("SpawnLocation")
	if spawnLocation and spawnLocation:IsA("BasePart") then
		character:PivotTo(spawnLocation:GetPivot() * CFrame.new(0, 3, 0))
	end
end

function ValidationService.GetAliveHumanoid(character: Model?): Humanoid?
	if not character then
		return nil
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end

	return humanoid
end

function ValidationService.IsCharacterAlive(character: Model?): boolean
	return ValidationService.GetAliveHumanoid(character) ~= nil
end

function ValidationService.IsPlayerAlive(player: Player?): boolean
	if not player then
		return false
	end

	return ValidationService.IsCharacterAlive(player.Character)
end

function ValidationService.GetAlivePlayerFromTouch(hit: BasePart): Player?
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end

	local player = Players:GetPlayerFromCharacter(character)
	if not player or not ValidationService.IsPlayerAlive(player) then
		return nil
	end

	return player
end

--[[
    Verifies if a player is authorized to be in a specific world.
    Kicks player if mismatch is detected.
]]
function ValidationService.ValidateWorldAccess(player: Player, expectedWorld: string): boolean
	local currentWorld = player:GetAttribute("Current_World")

	if currentWorld ~= expectedWorld then
		DebugModule.debugWarn(
			string.format(
				"Player %s attempted to interact with %s but is in %s",
				player.Name,
				expectedWorld,
				tostring(currentWorld)
			),
			"ValidationService"
		)
		player:Kick("Invalid world interaction detected")
		return false
	end

	return true
end

--[[
    Centralized check for suspicious movement speed.
]]
function ValidationService.ValidateSpeed(player: Player, reportedSpeed: number): boolean
	local maxAllowed = player:GetAttribute("Max_Player_Speed") or DEFAULT_MAX_PLAYER_SPEED
	local buffer = 5 -- Allow for slight network/physics variation

	if reportedSpeed > (maxAllowed + buffer) then
		DebugModule.debugWarn(
			string.format("Player %s reported speed %d (Max allowed: %d)", player.Name, reportedSpeed, maxAllowed),
			"ValidationService"
		)
		player:Kick("Speed modification detected")
		return false
	end

	return true
end

function ValidationService.ValidateWinButtonStage(player: Player, requiredStage: number): boolean
	local currentStage = player:GetAttribute("CurrentStage")
	if typeof(currentStage) ~= "number" then
		currentStage = 0
	end

	if requiredStage > currentStage then
		DebugModule.debugWarn(
			string.format(
				"Player %s tried to skip ahead to WinButton stage %d while on stage %d",
				player.Name,
				requiredStage,
				currentStage
			),
			"ValidationService"
		)
		resetPlayerToWorldSpawn(player)
		return false
	end

	return true
end

return ValidationService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2513">
        <Properties>
          <string name="Name">VerifyRewardCalculator</string>
          <string name="Source"><![CDATA[--!strict
local VerifyRewardCalculator = {}

export type VerifyRewardConfig = {
	baseXP: number,
	baseWins: number,
	growthMultiplier: number,
	roundStep: number,
	claimCountAttribute: string,
}

export type VerifyRewardPreview = {
	claimCount: number,
	growthFactor: number,
	baseXP: number,
	baseWins: number,
	xpAward: number,
	winsAward: number,
}

local DEFAULT_BASE_XP = 5000
local DEFAULT_BASE_WINS = 50
local DEFAULT_GROWTH_MULTIPLIER = 1.1
local DEFAULT_ROUND_STEP = 5
local DEFAULT_CLAIM_COUNT_ATTRIBUTE = "VerifyRewardClaimCount"

local function sanitizePositiveNumber(value: any, fallback: number): number
	if typeof(value) ~= "number" then
		return fallback
	end

	if value <= 0 then
		return fallback
	end

	return value
end

local function getNumericAttribute(player: Player, attributeName: string, fallback: number): number
	local rawValue = player:GetAttribute(attributeName)
	if typeof(rawValue) == "number" then
		return rawValue
	end

	return fallback
end

local function roundUpToStep(value: number, step: number): number
	if value <= 0 then
		return 0
	end

	return math.ceil(value / step) * step
end

function VerifyRewardCalculator.GetConfig(coreConfig: any): VerifyRewardConfig
	local levelingConfig = if coreConfig then coreConfig.leveling else nil
	local baseXP = sanitizePositiveNumber(
		if levelingConfig then levelingConfig.verifyRewardXP else nil,
		DEFAULT_BASE_XP
	)
	local baseWins = sanitizePositiveNumber(
		if levelingConfig then levelingConfig.verifyRewardWins else nil,
		DEFAULT_BASE_WINS
	)
	local growthMultiplier = sanitizePositiveNumber(
		if levelingConfig then levelingConfig.verifyRewardDailyGrowthMultiplier else nil,
		DEFAULT_GROWTH_MULTIPLIER
	)
	local roundStep = math.max(
		1,
		math.floor(
			sanitizePositiveNumber(
				if levelingConfig then levelingConfig.verifyRewardRoundStep else nil,
				DEFAULT_ROUND_STEP
			)
		)
	)
	local claimCountAttribute = if levelingConfig and typeof(levelingConfig.verifyRewardClaimCountAttribute) == "string"
			and levelingConfig.verifyRewardClaimCountAttribute ~= ""
		then levelingConfig.verifyRewardClaimCountAttribute
		else DEFAULT_CLAIM_COUNT_ATTRIBUTE

	return {
		baseXP = baseXP,
		baseWins = baseWins,
		growthMultiplier = growthMultiplier,
		roundStep = roundStep,
		claimCountAttribute = claimCountAttribute,
	}
end

function VerifyRewardCalculator.GetClaimCount(player: Player, config: VerifyRewardConfig): number
	local rawValue = player:GetAttribute(config.claimCountAttribute)
	if typeof(rawValue) == "number" then
		return math.max(0, math.floor(rawValue))
	end

	return 0
end

function VerifyRewardCalculator.AdvanceClaimCount(player: Player, config: VerifyRewardConfig): number
	local nextClaimCount = VerifyRewardCalculator.GetClaimCount(player, config) + 1
	player:SetAttribute(config.claimCountAttribute, nextClaimCount)
	return nextClaimCount
end

function VerifyRewardCalculator.ComputeRewardsForNextClaim(
	player: Player,
	config: VerifyRewardConfig
): VerifyRewardPreview
	local claimCount = VerifyRewardCalculator.GetClaimCount(player, config)
	local growthFactor = math.pow(config.growthMultiplier, claimCount + 1)
	local baseXP = config.baseXP * growthFactor
	local baseWins = config.baseWins * growthFactor

	local rebirthMultiplier = getNumericAttribute(player, "Rebirth_XPMultiplier", 1)
	local devMultiplier = getNumericAttribute(player, "DevProduct_XPSpeedMultiplier", 1)
	local miscMultiplier = getNumericAttribute(player, "Misc_XPSpeedMultiplier", 1)
	local friendMultiplier = getNumericAttribute(player, "Friend_XPMultiplier", 1)
	local treadmillMultiplier = getNumericAttribute(player, "Treadmill_XPMultiplier", 1)
	local winMultiplier = getNumericAttribute(player, "WinMultiplier", 1)

	local effectiveXP = baseXP * rebirthMultiplier * devMultiplier * miscMultiplier * friendMultiplier * treadmillMultiplier
	local effectiveWins = baseWins * winMultiplier

	return {
		claimCount = claimCount,
		growthFactor = growthFactor,
		baseXP = baseXP,
		baseWins = baseWins,
		xpAward = roundUpToStep(effectiveXP, config.roundStep),
		winsAward = roundUpToStep(effectiveWins, config.roundStep),
	}
end

return VerifyRewardCalculator
]]></string>
        </Properties>
      </Item>
