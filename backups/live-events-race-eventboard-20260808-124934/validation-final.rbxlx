function MainOrchestrator.Init(root: Instance)
	if root:GetAttribute("MainOrchestratorInitialized") == true then
		DebugModule.debugWarn(
			"MainOrchestrator.Init called more than once for " .. root:GetFullName(),
			"MainOrchestrator"
