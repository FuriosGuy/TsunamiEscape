	}
	local loadingRemoteNames = {
		"MovementAction",
		"RebirthAction",
		"SpeedAction",
		"ShowNotification",
		"ReturnToStageOffer",
		"ReturnToStageDeclined",
		"ReturnToStagePromptOpened",
		"RequestReturnToStageOffer",
		"PlayConfettiBurst",
		"RebirthResult",
		"VerifyRewardRequest",
		"VerifyRewardResult",
		"TrailAction",
		"KartAction",
		"TrollActionRequest",
		"TriggerJumpscare",
		"PlaytimeRewardAction",
		"XPGainAwarded",
		"WinButtonPressed",
