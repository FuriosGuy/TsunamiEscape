		preCountdownGraceSeconds = 3, -- Short transition before the audible race countdown.
		countdownFallbackSeconds = 4, -- Total countdown duration: 3, 2, 1, then START.
		raceTimeoutSeconds = 180, -- Maximum time allowed for racers to reach the finish line.
		cooldownSeconds = 5 * 60, -- Delay before another race can open.
		returnFreezeSeconds = 1, -- Freeze returned racers briefly at the World 1 spawn.
		countdownSoundId = 100324658979992, -- Countdown audio that releases both starting barriers.
		debugAllowSinglePlayerInStudio = true, -- Studio-only: allow one player to start a race.
		debugSkipCooldownInStudio = true, -- Studio-only: reopen race immediately after it ends or is cancelled.
	},
}

-- Get debug settings (for backward compatibility)
function CoreConfig.getDebugSettings()
	return CoreConfig.debugSystem
end

-- Check if debug is enabled
function CoreConfig.isDebugEnabled()
	return CoreConfig.debugSystem.enabled
end

-- Update debug settings at runtime
function CoreConfig.setDebugSettings(settings)
	for key, value in pairs(settings) do
		if CoreConfig.debugSystem[key] ~= nil then
			CoreConfig.debugSystem[key] = value
		end
	end
end

-- Get performance settings
function CoreConfig.getPerformanceSettings()
	return CoreConfig.performance
end

return CoreConfig
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="2476">
          <Properties>
            <string name="Name">SpinWheelConfig</string>
            <string name="Source"><![CDATA[--!strict

local SpinWheelConfig = {}

export type RewardId = "SpeedSmall" | "SpeedLarge" | "Wins" | "Rebirth" | "FlameTrail" | "FlameKart"

export type RewardDefinition = {
	id: RewardId,
	frameName: string,
	chance: number,
	displayName: string,
	imageAssetId: string,
}

export type PurchasePack = {
	buttonName: string,
	productKey: string,
	spins: number,
}

SpinWheelConfig.Rewards = {
	{
		id = "SpeedSmall",
		frameName = "Reward_SpeedSmall",
		chance = 35,
		displayName = "+SPEED",
		imageAssetId = "rbxassetid://136641422450900",
	},
	{
		id = "SpeedLarge",
		frameName = "Reward_SpeedLarge",
		chance = 20,
		displayName = "+BIG SPEED",
		imageAssetId = "rbxassetid://125552789489073",
	},
	{
		id = "Wins",
		frameName = "Reward_Wins",
		chance = 20,
		displayName = "+WINS",
		imageAssetId = "rbxassetid://96037386601568",
	},
	{
		id = "Rebirth",
		frameName = "Reward_Rebirth",
		chance = 15,
		displayName = "+1 REBIRTH",
		imageAssetId = "rbxassetid://138330067069857",
	},
	{
		id = "FlameTrail",
		frameName = "Reward_FlameTrail",
		chance = 7,
		displayName = "FLAME TRAIL",
		imageAssetId = "rbxassetid://78900671225138",
	},
	{
		id = "FlameKart",
		frameName = "Reward_FlameKart",
		chance = 3,
		displayName = "FLAME KART",
		imageAssetId = "rbxassetid://106675781950508",
	},
} :: { RewardDefinition }

SpinWheelConfig.PurchasePacks = {
	{ buttonName = "Buy1SpinButtonFrame", productKey = "Spin1", spins = 1 },
	{ buttonName = "Buy3SpinButtonFrame", productKey = "Spin3", spins = 3 },
	{ buttonName = "Buy5SpinButtonFrame", productKey = "Spin5", spins = 5 },
	{ buttonName = "Buy10SpinButtonFrame", productKey = "Spin10", spins = 10 },
} :: { PurchasePack }

function SpinWheelConfig.GetReward(rewardId: string): RewardDefinition?
	for _, reward in ipairs(SpinWheelConfig.Rewards) do
		if reward.id == rewardId then
			return reward
		end
	end
	return nil
end

function SpinWheelConfig.GetWheelWinsBase(totalWins: number): number
	local wins = math.max(0, totalWins)
	local multiplier = 1
	if wins >= 100000 then
		multiplier = 0.1
	elseif wins >= 10000 then
		multiplier = 0.25
	elseif wins >= 1000 then
		multiplier = 0.5
	end

	return math.max(100, math.round(wins * multiplier))
end

function SpinWheelConfig.GetSmallSpeedBase(maxXPSpeed: number): number
	return math.max(1, math.round(math.max(0, maxXPSpeed) * 0.25))
end

function SpinWheelConfig.GetLargeSpeedBase(maxXPSpeed: number): number
	return math.max(1, math.round(math.max(0, maxXPSpeed)))
end

return SpinWheelConfig
]]></string>
          </Properties>
