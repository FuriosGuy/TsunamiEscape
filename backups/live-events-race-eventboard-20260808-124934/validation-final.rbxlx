      <Item class="ModuleScript" referent="2655">
        <Properties>
          <string name="Name">ProductServerService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local MarketplaceService = game:GetService("MarketplaceService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local ProductService = require(Modules:WaitForChild("ProductService"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local SystemChatService = require(Modules:WaitForChild("SystemChatService"))
local Maid = require(Modules:WaitForChild("Maid"))
local ConfigFolder = Modules:WaitForChild("Config")
local CoreConfig = require(ConfigFolder:WaitForChild("CoreConfig"))

local ProductServerService = {}

-- CONFIG
local MODULE_NAME = "ProductServerService"
local isInitialized = false
local shutdownBound = false
local playerStore = DataStoreService:GetDataStore(ProductService.DataStores["PlayerStats"])
local receiptStore = DataStoreService:GetDataStore("ProcessedDevProductReceipts_v1")
local RECEIPT_RESERVATION_LEASE_SECONDS = 120
local receiptJobId = game.JobId ~= "" and game.JobId or ("studio-" .. tostring(os.clock()))
local persistenceConfig = CoreConfig.persistence
local SAVE_DEBOUNCE_SECONDS = if persistenceConfig and typeof(persistenceConfig.saveDebounceSeconds) == "number"
	then math.max(0, persistenceConfig.saveDebounceSeconds)
	else 10
local FINAL_SAVE_DEBOUNCE_SECONDS = if persistenceConfig
		and typeof(persistenceConfig.finalSaveDebounceSeconds) == "number"
	then
		math.max(0, persistenceConfig.finalSaveDebounceSeconds)
	else
		2

-- STATE
local lastSaveTimes: { [number]: number } = {}
local pendingSaveTasks: { [number]: boolean } = {}
local pendingSaveThreads: { [number]: thread } = {}
local devProductCallbacks: { [number]: (...any) -> () } = {}
local gamePassCallbacks: { [number]: (...any) -> () } = {}
local marketplaceInfoCache: { [string]: any } = {}
local processingReceipts: { [string]: boolean } = {}
local grantedReceipts: { [string]: boolean } = {}
local serviceMaid = Maid.new()

local function dataKey(player: Player): string
	return "player_" .. tostring(player.UserId)
end

local function cancelPendingSaveThread(userId: number)
	local thread = pendingSaveThreads[userId]
	if thread then
		task.cancel(thread)
		pendingSaveThreads[userId] = nil
	end
	pendingSaveTasks[userId] = nil
end

local function getMarketplaceInfoCached(itemId: number, infoType: Enum.InfoType)
	local key = infoType.Name .. ":" .. tostring(itemId)
	if marketplaceInfoCache[key] then
		return marketplaceInfoCache[key]
	end
	local ok, info = pcall(function()
		return MarketplaceService:GetProductInfo(itemId, infoType)
	end)
	if ok then
		marketplaceInfoCache[key] = info
		return info
	end
	return nil
end

function ProductServerService.SavePlayerData(player: Player, forceSave: boolean?)
	local userId = player.UserId
	local now = os.clock()
	local lastSave = lastSaveTimes[userId] or 0

	local function perform()
		local data = {}
		for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
			local val = player:GetAttribute(entry.name)
			data[entry.name] = if val ~= nil then val else entry.default
		end
		local ok, err = pcall(function()
			playerStore:SetAsync(dataKey(player), data)
		end)
		if ok then
			lastSaveTimes[userId] = os.clock()
			DebugModule.debugPrint("Saved " .. player.Name, MODULE_NAME)
		else
			DebugModule.debugWarn("Save failed: " .. tostring(err), MODULE_NAME)
		end
	end

	if forceSave then
		if now - lastSave < FINAL_SAVE_DEBOUNCE_SECONDS then
			return
		end
		cancelPendingSaveThread(userId)
		perform()
		return
	end

	if pendingSaveTasks[userId] then
		return
	end
	local waitTime = math.max(0, SAVE_DEBOUNCE_SECONDS - (now - lastSave))
	pendingSaveTasks[userId] = true
	pendingSaveThreads[userId] = task.spawn(function()
		if waitTime > 0 then
			task.wait(waitTime)
		end
		pendingSaveTasks[userId] = nil
		pendingSaveThreads[userId] = nil
		if player.Parent then
			perform()
		end
	end)
end

function ProductServerService.LoadPlayerData(player: Player)
	local ok, data = pcall(function()
		return playerStore:GetAsync(dataKey(player))
	end)
	if not ok or typeof(data) ~= "table" then
		return
	end

	for _, entry in ipairs(ProductService.SAVED_ATTRIBUTES) do
		local saved = data[entry.name]
		if saved == nil then
			continue
		end

		if typeof(entry.default) == "number" and typeof(saved) == "number" then
			local cur = player:GetAttribute(entry.name)
			if typeof(cur) ~= "number" or saved > cur then
				player:SetAttribute(entry.name, saved)
			end
		else
			player:SetAttribute(entry.name, saved)
		end
	end
end

function ProductServerService.SetProductCallback(id: number, cb: (...any) -> ())
	devProductCallbacks[id] = cb
end

function ProductServerService.SetGamePassCallback(id: number, cb: (...any) -> ())
	gamePassCallbacks[id] = cb
end

local function getReceiptId(info: any): string?
	local purchaseId = info.PurchaseId
	if purchaseId == nil then
		return nil
	end

	local receiptId = tostring(purchaseId)
	return if receiptId ~= "" then receiptId else nil
end

local function reserveReceipt(receiptId: string, player: Player, productId: number): "Granted" | "Reserved" | "Busy" | nil
	if grantedReceipts[receiptId] then
		return "Granted"
	end

	local ok, record = pcall(function()
		return receiptStore:UpdateAsync("receipt_" .. receiptId, function(previous)
			if typeof(previous) == "table" then
				if previous.Status == "Granted" then
					return previous
				end

				local updatedAt = previous.UpdatedAt
				if
					previous.Status == "Processing"
					and typeof(updatedAt) == "number"
					and os.time() - updatedAt < RECEIPT_RESERVATION_LEASE_SECONDS
				then
					return previous
				end
			end

			return {
				Status = "Processing",
				JobId = receiptJobId,
				PlayerId = player.UserId,
				ProductId = productId,
				UpdatedAt = os.time(),
			}
		end)
	end)
	if not ok then
		DebugModule.debugWarn(
			"Receipt reservation failed for purchaseId=" .. receiptId .. ": " .. tostring(record),
			MODULE_NAME
		)
		return nil
	end

	if typeof(record) ~= "table" then
		return nil
	elseif record.Status == "Granted" then
		grantedReceipts[receiptId] = true
		return "Granted"
	elseif record.Status == "Processing" and record.JobId == receiptJobId then
		return "Reserved"
	end

	return "Busy"
end

local function releaseReceipt(receiptId: string)
	local ok, err = pcall(function()
		receiptStore:UpdateAsync("receipt_" .. receiptId, function(previous)
			if typeof(previous) == "table" and previous.Status == "Processing" and previous.JobId == receiptJobId then
				return {
					Status = "Retry",
					UpdatedAt = os.time(),
				}
			end
			return previous
		end)
	end)
	if not ok then
		DebugModule.debugWarn(
			"Receipt reservation release failed for purchaseId=" .. receiptId .. ": " .. tostring(err),
			MODULE_NAME
		)
	end
end

local function rememberGrantedReceipt(receiptId: string, player: Player, productId: number): boolean
	local ok, err = pcall(function()
		receiptStore:UpdateAsync("receipt_" .. receiptId, function(previous)
			if typeof(previous) == "table" and previous.Status == "Granted" then
				return previous
			end

			return {
				Status = "Granted",
				PlayerId = player.UserId,
				ProductId = productId,
				GrantedAt = os.time(),
			}
		end)
	end)

	if not ok then
		DebugModule.debugWarn(
			"Receipt history save failed for purchaseId=" .. receiptId .. ": " .. tostring(err),
			MODULE_NAME
		)
	end

	grantedReceipts[receiptId] = true
	return ok
end

local function processReceipt(info: any): Enum.ProductPurchaseDecision
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receiptId = getReceiptId(info)
	if not receiptId then
		DebugModule.debugWarn("Developer product receipt had no PurchaseId", MODULE_NAME)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	if processingReceipts[receiptId] then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local receiptState = reserveReceipt(receiptId, player, info.ProductId)
	if receiptState == nil or receiptState == "Busy" then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	elseif receiptState == "Granted" then
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end

	processingReceipts[receiptId] = true

	local cb = devProductCallbacks[info.ProductId]
	if not cb then
		DebugModule.debugWarn(
			"No dev product callback registered for productId=" .. tostring(info.ProductId),
			MODULE_NAME
		)
		processingReceipts[receiptId] = nil
		releaseReceipt(receiptId)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local callbackOk, callbackErr = pcall(cb, player, info.ProductId, true, receiptId)
	if not callbackOk then
		processingReceipts[receiptId] = nil
		releaseReceipt(receiptId)
		DebugModule.debugWarn(
			"Dev product callback failed for player "
				.. player.Name
				.. " productId="
				.. tostring(info.ProductId)
				.. " err="
				.. tostring(callbackErr),
			MODULE_NAME
		)
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	rememberGrantedReceipt(receiptId, player, info.ProductId)
	processingReceipts[receiptId] = nil

	local itemInfo = getMarketplaceInfoCached(info.ProductId, Enum.InfoType.Product)
	if itemInfo then
		SystemChatService.BroadcastPurchase(player, itemInfo.Name, itemInfo.PriceInRobux or 0)
	end

	ProductServerService.SavePlayerData(player)
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ProductServerService.Init()
	if isInitialized then
		return
	end
	isInitialized = true

	MarketplaceService.ProcessReceipt = processReceipt

	serviceMaid.GamePassPurchaseFinished = MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, id, bought)
		local resolvedBought = bought == true
		if resolvedBought then
			ProductService.SetGamePassOwnershipCache(player, id, true)
		else
			ProductService.ClearOwnershipCache(player)
			resolvedBought = ProductService.userOwnsGamePass(player, id)
			if resolvedBought then
				ProductService.SetGamePassOwnershipCache(player, id, true)
			end
		end

		local cb = gamePassCallbacks[id]
		if cb then
			pcall(cb, player, id, resolvedBought)
		end
		if resolvedBought then
			local itemInfo = getMarketplaceInfoCached(id, Enum.InfoType.GamePass)
			if itemInfo then
				SystemChatService.BroadcastPurchase(player, itemInfo.Name, itemInfo.PriceInRobux or 0)
			end
			ProductServerService.SavePlayerData(player)
		end
	end)

	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(function(player)
		cancelPendingSaveThread(player.UserId)
		lastSaveTimes[player.UserId] = nil
	end)

	if not shutdownBound then
		shutdownBound = true
		game:BindToClose(function()
			ProductServerService.Shutdown()
		end)
	end
end

function ProductServerService.Shutdown()
	if not isInitialized then
		return
	end

	for userId in pairs(pendingSaveThreads) do
		cancelPendingSaveThread(userId)
	end
	serviceMaid:DoCleaning()
	isInitialized = false
	DebugModule.debugPrint("ProductServerService shutdown", MODULE_NAME)
end

return ProductServerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2656">
        <Properties>
          <string name="Name">ReferralService</string>
          <string name="Source"><![CDATA[--!strict
local Players = game:GetService("Players")
local DataStoreService = game:GetService("DataStoreService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local PlayerHandler = require(Modules:WaitForChild("PlayerHandler"))
local ProductService = require(Modules:WaitForChild("ProductService"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local FunnelAnalytics = require(Modules:WaitForChild("FunnelAnalytics"))
local ConfigFolder = Modules:WaitForChild("Config")
local CoreConfig = require(ConfigFolder:WaitForChild("CoreConfig"))

local ProductServerService = require(script.Parent:WaitForChild("ProductServerService"))

local ReferralService = {}

local MODULE_NAME = "ReferralService"
local socialConfig = CoreConfig.social
local FRIEND_INVITE_MULTIPLIER_STEP = if socialConfig and typeof(socialConfig.friendInviteMultiplierStep) == "number"
	then math.max(0, socialConfig.friendInviteMultiplierStep)
	else 0.1
local analyticsConfig = if CoreConfig.analytics then CoreConfig.analytics else nil
local analyticsFunnels = if analyticsConfig and typeof(analyticsConfig.funnels) == "table"
	then analyticsConfig.funnels
	else nil
local REFERRAL_FUNNEL_NAME = if analyticsFunnels and typeof(analyticsFunnels.referral) == "string"
	then analyticsFunnels.referral
	else "FriendInviteConversion"
local FRIEND_INVITE_PROMPT_FUNNEL_NAME = if analyticsFunnels and typeof(analyticsFunnels.friendInvitePrompt) == "string"
	then analyticsFunnels.friendInvitePrompt
	else "FriendInvitePrompt"

local playerStore = DataStoreService:GetDataStore(ProductService.DataStores["PlayerStats"])
local friendReferralClaimsStore = DataStoreService:GetDataStore(ProductService.DataStores["FriendReferralClaims"])
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ShowNotification = Remotes:WaitForChild("ShowNotification") :: RemoteEvent

local function getPlayerDataKey(userId: number): string
	return "player_" .. tostring(userId)
end

local function normalizeUserId(value: any): number?
	if typeof(value) ~= "number" then
		return nil
	end

	local userId = math.floor(value)
	if userId <= 0 then
		return nil
	end

	return userId
end

local function tryClaimReferralReward(inviteeUserId: number, referrerUserId: number): boolean
	local claimedReferral = false
	local success, err = pcall(function()
		friendReferralClaimsStore:UpdateAsync(tostring(inviteeUserId), function(existingValue)
			if existingValue ~= nil then
				return existingValue
			end

			claimedReferral = true
			return referrerUserId
		end)
	end)

	if not success then
		DebugModule.debugWarn(
			string.format(
				"Failed to claim referral reward | invitee=%d | referrer=%d | err=%s",
				inviteeUserId,
				referrerUserId,
				tostring(err)
			),
			MODULE_NAME
		)
		return false
	end

	return claimedReferral
end

local function incrementOfflineReferrerCount(referrerUserId: number): boolean
	local success, err = pcall(function()
		playerStore:UpdateAsync(getPlayerDataKey(referrerUserId), function(existingData)
			local nextData = if typeof(existingData) == "table" then table.clone(existingData) else {}
			local currentCount = nextData.FriendInviteCount
			if typeof(currentCount) ~= "number" then
				currentCount = 0
			end
			nextData.FriendInviteCount = math.max(0, math.floor(currentCount)) + 1
			return nextData
		end)
	end)

	if not success then
		DebugModule.debugWarn(
			string.format(
				"Failed to increment offline referral reward | referrer=%d | err=%s",
				referrerUserId,
				tostring(err)
			),
			MODULE_NAME
		)
		return false
	end

	return true
end

local function grantReferralReward(referrerUserId: number): boolean
	local referrerPlayer = Players:GetPlayerByUserId(referrerUserId)
	if referrerPlayer then
		PlayerHandler.AddFriendInviteCount(referrerPlayer, 1)
		ShowNotification:FireClient(
			referrerPlayer,
			string.format("FRIEND JOINED! +%.2fx FRIENDS MULTIPLIER", FRIEND_INVITE_MULTIPLIER_STEP),
			"Green"
		)
		ProductServerService.SavePlayerData(referrerPlayer)
		return true
	end

	return incrementOfflineReferrerCount(referrerUserId)
end

local function grantInviteeReward(inviteePlayer: Player)
	PlayerHandler.AddFriendInviteCount(inviteePlayer, 1)
	ShowNotification:FireClient(
		inviteePlayer,
		string.format("FRIEND INVITE BONUS! +%.2fx FRIENDS MULTIPLIER", FRIEND_INVITE_MULTIPLIER_STEP),
		"Green"
	)
	ProductServerService.SavePlayerData(inviteePlayer)
end

function ReferralService.OnPlayerAdded(player: Player)
	local joinData = player:GetJoinData()
	local referrerUserId = normalizeUserId(joinData.ReferredByPlayerId)
	if referrerUserId == nil or referrerUserId == player.UserId then
		return
	end

	if not tryClaimReferralReward(player.UserId, referrerUserId) then
		return
	end

	local referralSessionId = FunnelAnalytics.OpenRecurringFunnel(
		player,
		REFERRAL_FUNNEL_NAME,
		"Referral Join Detected",
		{
			customField01 = "InviteeJoined",
		}
	)

	grantInviteeReward(player)
	if referralSessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			REFERRAL_FUNNEL_NAME,
			referralSessionId,
			2,
			"Invitee Reward Granted",
			{
				customField01 = "InviteeReward",
			}
		)
	end

	if grantReferralReward(referrerUserId) then
		if referralSessionId then
			FunnelAnalytics.LogRecurringStep(
				player,
				REFERRAL_FUNNEL_NAME,
				referralSessionId,
				3,
				"Referrer Reward Granted",
				{
					customField01 = "ReferrerReward",
				}
			)
		end
		DebugModule.debugInfo(
			string.format(
				"Referral rewards granted | invitee=%s(%d) | referrer=%d | step=%.2f",
				player.Name,
				player.UserId,
				referrerUserId,
				FRIEND_INVITE_MULTIPLIER_STEP
			),
			MODULE_NAME
		)
	end
end

local function handleInvitePromptOpened(player: Player, payload: { [string]: any })
	local sessionId = FunnelAnalytics.OpenRecurringFunnel(
		player,
		FRIEND_INVITE_PROMPT_FUNNEL_NAME,
		"Invite Prompt Opened",
		{
			customField01 = tostring(payload.source or "Topbar"),
		}
	)
	if sessionId then
		FunnelAnalytics.LogRecurringStep(
			player,
			FRIEND_INVITE_PROMPT_FUNNEL_NAME,
			sessionId,
			2,
			"Invite Prompt Displayed",
			{
				customField01 = tostring(payload.source or "Topbar"),
			}
		)
	end
end

function ReferralService.Init()
	FunnelAnalytics.RegisterClientAction("FriendInvitePromptOpened", handleInvitePromptOpened)
	DebugModule.debugInfo("ReferralService initialized", MODULE_NAME)
end

return ReferralService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2657">
        <Properties>
          <string name="Name">ReturnToStageService</string>
          <string name="Source"><![CDATA[--!strict
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local Maid = require(Modules:WaitForChild("Maid"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local ConfigFolder = Modules:WaitForChild("Config")
local CoreConfig = require(ConfigFolder:WaitForChild("CoreConfig"))

local ReturnToStageService = {}

-- CONFIG
local returnToStageConfig = CoreConfig.returnToStage
local RETURN_TO_STAGE_DURATION = if returnToStageConfig and typeof(returnToStageConfig.duration) == "number"
	then math.max(1, returnToStageConfig.duration)
	else 10
local RETURN_TO_STAGE_ENABLED = if returnToStageConfig and typeof(returnToStageConfig.enabled) == "boolean"
	then returnToStageConfig.enabled
	else true
local MODULE_NAME = "ReturnToStageService"
local isInitialized = false
local serviceMaid = Maid.new()

-- REMOTES
local Remotes = ReplicatedStorage:WaitForChild("Remotes")
local ReturnToStageOffer = Remotes:WaitForChild("ReturnToStageOffer") :: RemoteEvent
local ReturnToStageDeclined = Remotes:WaitForChild("ReturnToStageDeclined") :: RemoteEvent
local ReturnToStagePromptOpened = Remotes:WaitForChild("ReturnToStagePromptOpened") :: RemoteEvent
local RequestReturnToStageOffer = Remotes:WaitForChild("RequestReturnToStageOffer") :: RemoteEvent

-- STATE
local pendingReturnToStage: {
	[Player]: {
		stage: number,
		worldName: string,
		expiresAt: number,
		promptLocked: boolean?,
		maid: any, -- Rule #3.10: Handle expiration thread
	},
} =
	{}

local pendingReturnOfferRequest: { [Player]: boolean } = {}

local function findReturnStageDestination(worldName: string, stageNumber: number): BasePart?
	local worldsFolder = workspace:FindFirstChild("Worlds")
	local world = worldsFolder and worldsFolder:FindFirstChild(worldName)
	if not world then
		return nil
	end

	local stagesFolder = world:FindFirstChild("Stages")
	local stageInstance = stagesFolder and stagesFolder:FindFirstChild("Stage_" .. tostring(stageNumber))
	if not stageInstance then
		return nil
	end

	local stagePart = if stageInstance:IsA("BasePart")
		then stageInstance
		else stageInstance:FindFirstChildWhichIsA("BasePart", true)
	if not stagePart then
		return nil
	end

	local nearestCover: BasePart? = nil
	local nearestDistance = math.huge
	local roadsFolder = world:FindFirstChild("Roads")
	if not roadsFolder then
		return nil
	end

	for _, descendant in ipairs(roadsFolder:GetDescendants()) do
		if descendant:IsA("BasePart") and descendant.Name == "TsunamiCover" then
			local distance = (descendant.Position - stagePart.Position).Magnitude
			if distance < nearestDistance then
				nearestDistance = distance
				nearestCover = descendant
			end
		end
	end

	return nearestCover
end

function ReturnToStageService.OfferReturnToStage(player: Player)
	if not RETURN_TO_STAGE_ENABLED then
		pendingReturnToStage[player] = nil
		ReturnToStageOffer:FireClient(player, false)
		return
	end

	local state = pendingReturnToStage[player]
	if not state or state.stage <= 0 or state.worldName == "" then
		pendingReturnToStage[player] = nil
		ReturnToStageOffer:FireClient(player, false)
		return
	end

	local expiresAt = os.clock() + RETURN_TO_STAGE_DURATION
	state.expiresAt = expiresAt

	-- Rule #3.10: Resource bounding/cleanup
	if not state.maid then
		state.maid = Maid.new()
	end
	state.maid.ExpireThread = nil

	ReturnToStageOffer:FireClient(player, true, state.stage, RETURN_TO_STAGE_DURATION)

	state.maid.ExpireThread = task.spawn(function()
		task.wait(RETURN_TO_STAGE_DURATION)
		local currentState = pendingReturnToStage[player]
		if not player.Parent or not currentState then
			return
		end

		if currentState.expiresAt == expiresAt and os.clock() >= currentState.expiresAt then
			if currentState.promptLocked == true then
				return
			end

			DebugModule.debugPrint(string.format("ReturnToStage offer expired for %s", player.Name), MODULE_NAME)
			pendingReturnToStage[player] = nil
			player:SetAttribute("CurrentStage", 0)
			ReturnToStageOffer:FireClient(player, false)
		end
	end)
end

function ReturnToStageService.HandlePurchase(player: Player, productId: number, isPurchased: boolean)
	if not isPurchased then
		return
	end
	if not RETURN_TO_STAGE_ENABLED then
		pendingReturnToStage[player] = nil
		ReturnToStageOffer:FireClient(player, false)
		return
	end

	local state = pendingReturnToStage[player]
	if not state or (os.clock() > state.expiresAt and state.promptLocked ~= true) then
		pendingReturnToStage[player] = nil
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local destination = findReturnStageDestination(state.worldName, state.stage)

	if not character or not humanoid or humanoid.Health <= 0 or not destination then
		pendingReturnToStage[player] = nil
		return
	end

	character:PivotTo(destination.CFrame * CFrame.new(0, 3, 0))
	ReturnToStageService.CleanupPlayer(player) -- Full cleanup after success
	ReturnToStageOffer:FireClient(player, false)
end

function ReturnToStageService.OnDeclined(player: Player)
	local state = pendingReturnToStage[player]
	if not state then
		return
	end

	ReturnToStageService.CleanupPlayer(player)
	player:SetAttribute("CurrentStage", 0)
	ReturnToStageOffer:FireClient(player, false)
end

function ReturnToStageService.OnPromptOpened(player: Player)
	local state = pendingReturnToStage[player]
	if not state then
		return
	end

	if state.expiresAt > 0 and os.clock() > state.expiresAt then
		return
	end

	state.promptLocked = true
end

function ReturnToStageService.OnRequestOffer(player: Player)
	if not RETURN_TO_STAGE_ENABLED then
		return
	end

	if player:GetAttribute("Data_Loaded") ~= true then
		pendingReturnOfferRequest[player] = true
		return
	end

	local stage = player:GetAttribute("CurrentStage")
	local worldName = player:GetAttribute("Current_World")

	if typeof(stage) == "number" and stage > 0 and typeof(worldName) == "string" and worldName ~= "" then
		if not pendingReturnToStage[player] then
			pendingReturnToStage[player] = {
				stage = stage,
				worldName = worldName,
				expiresAt = 0,
				promptLocked = false,
				maid = Maid.new(),
			}
		end
		ReturnToStageService.OfferReturnToStage(player)
	else
		pendingReturnToStage[player] = nil
		ReturnToStageOffer:FireClient(player, false)
	end
end

function ReturnToStageService.SetPendingState(player: Player, stage: number, worldName: string)
	if not RETURN_TO_STAGE_ENABLED then
		return
	end
	pendingReturnToStage[player] = {
		stage = stage,
		worldName = worldName,
		expiresAt = 0,
		promptLocked = false,
		maid = Maid.new(),
	}
end

function ReturnToStageService.CheckQueuedRequest(player: Player)
	if pendingReturnOfferRequest[player] then
		pendingReturnOfferRequest[player] = nil
		ReturnToStageService.OnRequestOffer(player)
	end
end

function ReturnToStageService.CleanupPlayer(player: Player)
	local state = pendingReturnToStage[player]
	if state and state.maid then
		state.maid:DoCleaning()
	end
	pendingReturnToStage[player] = nil
	pendingReturnOfferRequest[player] = nil
end

function ReturnToStageService.Init()
	if isInitialized then
		return
	end
	isInitialized = true
	serviceMaid.ReturnToStageDeclined = ReturnToStageDeclined.OnServerEvent:Connect(ReturnToStageService.OnDeclined)
	serviceMaid.ReturnToStagePromptOpened = ReturnToStagePromptOpened.OnServerEvent:Connect(ReturnToStageService.OnPromptOpened)
	serviceMaid.RequestReturnToStageOffer = RequestReturnToStageOffer.OnServerEvent:Connect(ReturnToStageService.OnRequestOffer)
	DebugModule.debugInfo("ReturnToStageService Initialized", MODULE_NAME)
end

function ReturnToStageService.Shutdown()
	for player in pairs(table.clone(pendingReturnToStage)) do
		ReturnToStageService.CleanupPlayer(player)
	end
	serviceMaid:DoCleaning()
	table.clear(pendingReturnOfferRequest)
	isInitialized = false
end

return ReturnToStageService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="2658">
        <Properties>
          <string name="Name">SpinWheelService</string>
          <string name="Source"><![CDATA[--!strict

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")

local Modules = ReplicatedStorage:WaitForChild("Modules")
local ConfigFolder = Modules:WaitForChild("Config")
local CoreConfig = require(ConfigFolder:WaitForChild("CoreConfig"))
local SpinWheelConfig = require(ConfigFolder:WaitForChild("SpinWheelConfig"))
local DebugModule = require(Modules:WaitForChild("DebugModule"))
local Maid = require(Modules:WaitForChild("Maid"))
local PlayerHandler = require(Modules:WaitForChild("PlayerHandler"))
local ProductService = require(Modules:WaitForChild("ProductService"))
local ProductServerService = require(script.Parent:WaitForChild("ProductServerService"))
local LevelingService = require(script.Parent:WaitForChild("LevelingService"))
local EconomyAnalytics = require(script.Parent:WaitForChild("EconomyAnalytics"))

local SpinWheelService = {}

local MODULE_NAME = "SpinWheelService"
local SPINS_ATTRIBUTE = "SpinWheelSpins"
local NEXT_FREE_SPIN_ATTRIBUTE = "SpinWheelNextFreeSpinUnix"
local INITIALIZED_ATTRIBUTE = "SpinWheelFreeSpinInitialized"
local PROCESSED_RECEIPTS_ATTRIBUTE = "SpinWheelProcessedReceiptIds"
local REQUEST_COOLDOWN_SECONDS = 0.15
local MAX_STORED_RECEIPTS = 40
local spinWheelConfig = if CoreConfig.spinWheel then CoreConfig.spinWheel else {}
local SPIN_ANIMATION_DURATION_SECONDS = if typeof(spinWheelConfig.spinRotationDuration) == "number"
	then math.max(0.5, spinWheelConfig.spinRotationDuration)
	else 4
local PENDING_SPIN_TIMEOUT_SECONDS = SPIN_ANIMATION_DURATION_SECONDS + 10

local FREE_SPIN_COOLDOWN_SECONDS = if typeof(spinWheelConfig.freeSpinCooldownSeconds) == "number"
	then math.max(1, math.floor(spinWheelConfig.freeSpinCooldownSeconds))
	else 24 * 60 * 60
local DEBUG_FREE_SPIN_READY_IN_STUDIO = spinWheelConfig.debugFreeSpinReadyInStudio == true

local requestInFlight: { [Player]: boolean } = {}
local lastRequestTimes: { [Player]: number } = {}
local processedReceipts: { [Player]: { [string]: boolean } } = {}
local serviceMaid = Maid.new()

type PendingSpin = {
	token: string,
	reward: SpinWheelConfig.RewardDefinition,
	previousSpinCount: number,
	previousNextFreeSpinUnix: number,
	startedAt: number,
	expiresAt: number,
	status: "Started" | "Ready",
	preparedResult: { [string]: any }?,
}

local pendingSpins: { [Player]: PendingSpin } = {}
local initialized = false

local function getOrCreateRemote(name: string): RemoteEvent
	local remotes = ReplicatedStorage:WaitForChild("Remotes")
	local existing = remotes:FindFirstChild(name)
	if existing and existing:IsA("RemoteEvent") then
		return existing
	end

	local remote = Instance.new("RemoteEvent")
	remote.Name = name
	remote.Parent = remotes
	return remote
end

local spinRequestRemote = getOrCreateRemote("SpinWheelRequest")
local spinResultRemote = getOrCreateRemote("SpinWheelResult")
local spinClaimRemote = getOrCreateRemote("SpinWheelClaim")
local spinGrantRemote = getOrCreateRemote("SpinWheelGrant")

local function getNumberAttribute(player: Player, name: string, defaultValue: number): number
	local value = player:GetAttribute(name)
	return if typeof(value) == "number" then value else defaultValue
end

local function getSpinCount(player: Player): number
	return math.max(0, math.floor(getNumberAttribute(player, SPINS_ATTRIBUTE, 0)))
end

local function setSpinCount(player: Player, count: number)
	player:SetAttribute(SPINS_ATTRIBUTE, math.max(0, math.floor(count)))
end

local function addSpins(player: Player, amount: number)
	setSpinCount(player, getSpinCount(player) + math.max(0, math.floor(amount)))
end

local function isStudioFreeSpinDebugEnabled(): boolean
	return RunService:IsStudio() and DEBUG_FREE_SPIN_READY_IN_STUDIO
end

local function readReceiptHistory(player: Player): { [string]: boolean }
	local history = processedReceipts[player]
	if history then
		return history
	end

	history = {}
	local serialized = player:GetAttribute(PROCESSED_RECEIPTS_ATTRIBUTE)
	if typeof(serialized) == "string" then
		for receiptId in string.gmatch(serialized, "[^,]+") do
			history[receiptId] = true
		end
	end
	processedReceipts[player] = history
	return history
end

local function rememberReceipt(player: Player, receiptId: string): boolean
	if receiptId == "" then
		return true
	end

	local history = readReceiptHistory(player)
	if history[receiptId] then
		return false
	end
	history[receiptId] = true

	local receiptIds = {}
	for storedReceiptId in pairs(history) do
		table.insert(receiptIds, storedReceiptId)
	end
	table.sort(receiptIds)
	while #receiptIds > MAX_STORED_RECEIPTS do
		history[table.remove(receiptIds, 1) :: string] = nil
	end
	player:SetAttribute(PROCESSED_RECEIPTS_ATTRIBUTE, table.concat(receiptIds, ","))
	return true
end

local function getNextFreeSpinUnix(player: Player): number
	return math.max(0, math.floor(getNumberAttribute(player, NEXT_FREE_SPIN_ATTRIBUTE, 0)))
end

local function makeFreeSpinReadyIfDue(player: Player): boolean
	local spins = getSpinCount(player)
	if spins > 0 then
		return true
	end

	if isStudioFreeSpinDebugEnabled() then
		addSpins(player, 1)
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, 0)
		return true
	end

	local now = os.time()
	local nextFreeSpinUnix = getNextFreeSpinUnix(player)
	local hasInitialized = player:GetAttribute(INITIALIZED_ATTRIBUTE) == true
	if not hasInitialized then
		player:SetAttribute(INITIALIZED_ATTRIBUTE, true)
		addSpins(player, 1)
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, 0)
		return true
	end

	if nextFreeSpinUnix > 0 and now >= nextFreeSpinUnix then
		addSpins(player, 1)
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, now + FREE_SPIN_COOLDOWN_SECONDS)
		return true
	end

	return false
end

local function chooseReward(): SpinWheelConfig.RewardDefinition
	local totalChance = 0
	for _, reward in ipairs(SpinWheelConfig.Rewards) do
		totalChance += reward.chance
	end

	local roll = Random.new():NextNumber(0, totalChance)
	local cumulativeChance = 0
	for _, reward in ipairs(SpinWheelConfig.Rewards) do
		cumulativeChance += reward.chance
		if roll <= cumulativeChance then
			return reward
		end
	end

	return SpinWheelConfig.Rewards[#SpinWheelConfig.Rewards]
end

local function getSmallSpeedBase(player: Player): number
	return SpinWheelConfig.GetSmallSpeedBase(getNumberAttribute(player, "MaxXPSpeed", 1))
end

local function getLargeSpeedBase(player: Player): number
	return SpinWheelConfig.GetLargeSpeedBase(getNumberAttribute(player, "MaxXPSpeed", 1))
end

local function calculateReward(player: Player, reward: SpinWheelConfig.RewardDefinition): { [string]: any }
	local result: { [string]: any } = {
		rewardId = reward.id,
		duplicate = false,
		awardedSpeed = 0,
		awardedWins = 0,
		awardedRebirth = 0,
	}

	if reward.id == "SpeedSmall" then
		result.awardedSpeed = getSmallSpeedBase(player)
	elseif reward.id == "SpeedLarge" then
		result.awardedSpeed = getLargeSpeedBase(player)
	elseif reward.id == "Wins" then
		result.awardedWins = SpinWheelConfig.GetWheelWinsBase(getNumberAttribute(player, "WinCount", 0))
	elseif reward.id == "Rebirth" then
		-- Wheel rewards grant the rebirth directly, like Daily/Playtime rewards.
		result.awardedRebirth = 1
	elseif reward.id == "FlameTrail" then
		if PlayerHandler.OwnsTrail(player, "FlameTrail") then
			result.duplicate = true
			result.awardedSpeed = getSmallSpeedBase(player)
			result.awardedWins = SpinWheelConfig.GetWheelWinsBase(getNumberAttribute(player, "WinCount", 0))
		else
		end
	elseif reward.id == "FlameKart" then
		if PlayerHandler.OwnsKart(player, "1_FlameKart") then
			result.duplicate = true
			result.awardedSpeed = getLargeSpeedBase(player)
			result.awardedWins = SpinWheelConfig.GetWheelWinsBase(getNumberAttribute(player, "WinCount", 0))
		else
		end
	end

	return result
end

local function logReward(player: Player, result: { [string]: any })
	local rewardId = tostring(result.rewardId)

	if result.awardedSpeed > 0 then
		EconomyAnalytics.LogSource(
			player,
			"XPSpeed",
			result.awardedSpeed,
			Enum.AnalyticsEconomyTransactionType.TimedReward.Name,
			"SpinWheel_" .. rewardId
		)
	end
	if result.awardedWins > 0 then
		EconomyAnalytics.LogSource(
			player,
			"Wins",
			result.awardedWins,
			Enum.AnalyticsEconomyTransactionType.TimedReward.Name,
			"SpinWheel_" .. rewardId
		)
	end
end

local function processReward(player: Player, reward: SpinWheelConfig.RewardDefinition, result: { [string]: any })
	if result.awardedSpeed > 0 then
		PlayerHandler.AddExactXPSpeed(player, result.awardedSpeed)
	end
	if result.awardedWins > 0 then
		PlayerHandler.AddExactWins(player, result.awardedWins)
	end

	if reward.id == "Rebirth" and result.awardedRebirth > 0 then
		if not LevelingService.PerformRebirth(player, true) then
			error("rebirth could not be completed")
		end
	elseif reward.id == "FlameTrail" and not result.duplicate then
		PlayerHandler.AddOwnedTrail(player, "FlameTrail")
	elseif reward.id == "FlameKart" and not result.duplicate then
		PlayerHandler.AddOwnedKart(player, "1_FlameKart")
	end

	logReward(player, result)
end

local function restorePendingSpin(player: Player): boolean
	local pending = pendingSpins[player]
	if not pending then
		return false
	end

	setSpinCount(player, pending.previousSpinCount)
	player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, pending.previousNextFreeSpinUnix)
	pendingSpins[player] = nil
	return true
end

local function expirePendingSpin(player: Player)
	local pending = pendingSpins[player]
	if pending and os.clock() >= pending.expiresAt then
		restorePendingSpin(player)
	end
end

local function handleSpinRequest(player: Player)
	if player.Parent == nil or player:GetAttribute("Data_Loaded") ~= true then
		return
	end

	local now = os.clock()
	if requestInFlight[player] or now < (lastRequestTimes[player] or 0) + REQUEST_COOLDOWN_SECONDS then
		return
	end
	requestInFlight[player] = true
	lastRequestTimes[player] = now
	expirePendingSpin(player)
	if pendingSpins[player] then
		requestInFlight[player] = nil
		return
	end

	local ready = makeFreeSpinReadyIfDue(player)
	if not ready or getSpinCount(player) <= 0 then
		requestInFlight[player] = nil
		return
	end

	local previousSpinCount = getSpinCount(player)
	local previousNextFreeSpinUnix = getNextFreeSpinUnix(player)
	setSpinCount(player, previousSpinCount - 1)
	local nextFreeSpinUnix = getNextFreeSpinUnix(player)
	if isStudioFreeSpinDebugEnabled() and getSpinCount(player) <= 0 then
		addSpins(player, 1)
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, 0)
	elseif nextFreeSpinUnix <= os.time() then
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, os.time() + FREE_SPIN_COOLDOWN_SECONDS)
	end

	local reward = chooseReward()
	local token = HttpService:GenerateGUID(false)
	pendingSpins[player] = {
		token = token,
		reward = reward,
		previousSpinCount = previousSpinCount,
		previousNextFreeSpinUnix = previousNextFreeSpinUnix,
		startedAt = os.clock(),
		expiresAt = os.clock() + PENDING_SPIN_TIMEOUT_SECONDS,
		status = "Started",
	}
	spinResultRemote:FireClient(player, {
		phase = "Started",
		token = token,
		rewardId = reward.id,
		remainingSpins = getSpinCount(player),
	})
	requestInFlight[player] = nil
end

local function handleSpinClaim(player: Player, token: any)
	if typeof(token) ~= "string" or token == "" then
		return
	end

	expirePendingSpin(player)
	local pending = pendingSpins[player]
	if not pending or pending.token ~= token or pending.status ~= "Started" then
		return
	end
	if os.clock() < pending.startedAt + SPIN_ANIMATION_DURATION_SECONDS then
		DebugModule.debugWarn("Spin claim arrived before animation finished for " .. player.Name, MODULE_NAME)
		return
	end

	local ok, resultOrError = pcall(calculateReward, player, pending.reward)
	if not ok then
		restorePendingSpin(player)
		DebugModule.debugWarn(
			"Spin calculation failed for " .. player.Name .. ": " .. tostring(resultOrError),
			MODULE_NAME
		)
		return
	end

	local result = resultOrError :: { [string]: any }
	pending.status = "Ready"
	pending.preparedResult = result
	result.phase = "RewardReady"
	result.token = token
	result.remainingSpins = getSpinCount(player)
	spinResultRemote:FireClient(player, result)
end

local function handleSpinGrant(player: Player, token: any)
	if typeof(token) ~= "string" or token == "" then
		return
	end

	expirePendingSpin(player)
	local pending = pendingSpins[player]
	if not pending or pending.token ~= token or pending.status ~= "Ready" or not pending.preparedResult then
		return
	end

	local result = pending.preparedResult
	local ok, grantError = pcall(processReward, player, pending.reward, result)
	if not ok then
		restorePendingSpin(player)
		DebugModule.debugWarn("Spin reward failed for " .. player.Name .. ": " .. tostring(grantError), MODULE_NAME)
		return
	end

	pendingSpins[player] = nil
	result.phase = "Granted"
	result.token = token
	result.remainingSpins = getSpinCount(player)
	spinResultRemote:FireClient(player, result)
	ProductServerService.SavePlayerData(player)
end

local function registerPurchaseCallbacks()
	for _, pack in ipairs(SpinWheelConfig.PurchasePacks) do
		local productId = ProductService.DevProducts[pack.productKey]
		if productId then
			DebugModule.debugPrint(
				"Registered spin product "
					.. pack.productKey
					.. " ("
					.. tostring(productId)
					.. ") for "
					.. tostring(pack.spins)
					.. " spins",
				MODULE_NAME
			)
			ProductServerService.SetProductCallback(
				productId,
				function(player: Player, _: number, bought: boolean, purchaseId: string?)
					if not bought then
						return
					end
					if purchaseId and not rememberReceipt(player, purchaseId) then
						return
					end
					addSpins(player, pack.spins)
					ProductServerService.SavePlayerData(player)
				end
			)
		end
	end
end

function SpinWheelService.OnPlayerAdded(player: Player)
	if player:GetAttribute(INITIALIZED_ATTRIBUTE) ~= true then
		player:SetAttribute(INITIALIZED_ATTRIBUTE, true)
		if getSpinCount(player) <= 0 then
			addSpins(player, 1)
		end
		player:SetAttribute(NEXT_FREE_SPIN_ATTRIBUTE, 0)
	end
	readReceiptHistory(player)
end

function SpinWheelService.CleanupPlayer(player: Player)
	if pendingSpins[player] then
		restorePendingSpin(player)
	end
	requestInFlight[player] = nil
	lastRequestTimes[player] = nil
	processedReceipts[player] = nil
end

function SpinWheelService.Init()
	if initialized then
		return
	end
	initialized = true
	serviceMaid.SpinRequest = spinRequestRemote.OnServerEvent:Connect(handleSpinRequest)
	serviceMaid.SpinClaim = spinClaimRemote.OnServerEvent:Connect(handleSpinClaim)
	serviceMaid.SpinGrant = spinGrantRemote.OnServerEvent:Connect(handleSpinGrant)
	registerPurchaseCallbacks()
	serviceMaid.PlayerRemoving = Players.PlayerRemoving:Connect(SpinWheelService.CleanupPlayer)
	DebugModule.debugPrint("Spin wheel service initialized", MODULE_NAME)
end

function SpinWheelService.Shutdown()
	for player in pairs(table.clone(pendingSpins)) do
		restorePendingSpin(player)
	end
	serviceMaid:DoCleaning()
	table.clear(requestInFlight)
	table.clear(lastRequestTimes)
	table.clear(processedReceipts)
	table.clear(pendingSpins)
	initialized = false
end

return SpinWheelService
]]></string>
        </Properties>
