local function updateKartButtonVisuals()
	local currentWorld = player:GetAttribute("Current_World")
	if typeof(currentWorld) ~= "string" then
		return
	end

	local dataLoaded = player:GetAttribute("Data_Loaded") == true
	local worldsFolder = Workspace:FindFirstChild("Worlds")
	local world = worldsFolder and worldsFolder:FindFirstChild(currentWorld)
	local kartButtonsFolder = world and world:FindFirstChild("KartButtons")
	if not kartButtonsFolder then
		return
	end

	local ownedKarts = PlayerHandler.GetOwnedKarts(player)
	local equippedKart = player:GetAttribute("Kart_Equipped")
	local currentWins = player:GetAttribute("WinCount") or 0

	for _, kartButton in ipairs(kartButtonsFolder:GetChildren()) do
		local kartNumber = kartButton:GetAttribute("KartNumber")
		local winsRequired = kartButton:GetAttribute("WinsRequired")
		local isGamepassKart = kartNumber == nil -- no KartNumber = gamepass kart
		local kartModelName = if typeof(kartNumber) == "number"
			then getKartModelNameByNumber(currentWorld, kartNumber)
			else getGamepassKartModelName(kartButton)
		if not kartModelName then
			applyKartButtonColor(kartButton, KART_CANT_AFFORD_COLOR)
			continue
		end

		if isGamepassKart then
			continue -- skip color changes for gamepass karts
		end

		local color = KART_CANT_AFFORD_COLOR
		if equippedKart == kartModelName then
			color = KART_EQUIPPED_COLOR
		elseif dataLoaded then
			color = KART_AVAILABLE_COLOR
			if typeof(winsRequired) == "number" and not ownedKarts[kartModelName] and currentWins < winsRequired then
				color = KART_CANT_AFFORD_COLOR
			end
		end

		applyKartButtonColor(kartButton, color)
	end
end

local function registerRainbowGradient(instance: Instance)
	if not instance:IsA("UIGradient") or instance.Name ~= "RainbowGradient" then
		return
	end

	if registeredRainbowGradients[instance] then
		return
	end

	registeredRainbowGradients[instance] = true
	local gradientMaid = Maid.new()
	registeredRainbowGradientMaids[instance] = gradientMaid

	local function cleanupGradientRegistration()
		registeredRainbowGradients[instance] = nil
		local existingMaid = registeredRainbowGradientMaids[instance]
		if existingMaid == gradientMaid then
			registeredRainbowGradientMaids[instance] = nil
			gradientMaid:DoCleaning()
		end
	end

	gradientMaid:GiveTask(instance.Destroying:Connect(cleanupGradientRegistration))
	gradientMaid:GiveTask(instance.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			cleanupGradientRegistration()
		end
	end))

	VisualFunctions.SetupRainbowGradient(instance)
end

local function bindWorldSourceRoot(root: Instance)
	if observedWorldSourceRoots[root] then
		return
	end
	observedWorldSourceRoots[root] = true

	local cleanedRoot = false
	local function cleanupRootBinding()
		if cleanedRoot then
			return
		end
		cleanedRoot = true
		observedWorldSourceRoots[root] = nil
	end

	topLevelMaid:GiveTask(root.AncestryChanged:Connect(function(_, parent)
		if parent == nil then
			cleanupRootBinding()
		end
	end))

	topLevelMaid:GiveTask(root.DescendantAdded:Connect(function(descendant)
		if descendant:IsA("BasePart") and descendant.Name == "VIPDoor" and isVIPRoomDescendant(descendant) then
			local rootPart = character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local distanceText = "unknown distance"
			if rootPart then
				distanceText = string.format("%.0f studs away", (descendant.Position - rootPart.Position).Magnitude)
			end

			DebugModule.debugPrint(
				string.format(
					"New VIPDoor detected at %s, updating collision (%s)",
					tostring(descendant.Position),
					distanceText
				),
				"PlayerClientHandler"
			)
			task.defer(updateVIPDoorCollision)
		end

		local kartButton = descendant:FindFirstAncestor("KartButton")
		if kartButton then
			task.defer(updateKartButtonVisuals)
		end

		registerRainbowGradient(descendant)
		registerTreadmillTexture(descendant)
		registerTreadmillTouchPart(descendant)
	end))

	for _, descendant in ipairs(root:GetDescendants()) do
		registerRainbowGradient(descendant)
		registerTreadmillTexture(descendant)
		registerTreadmillTouchPart(descendant)
	end
end

